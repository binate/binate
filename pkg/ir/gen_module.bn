package "pkg/ir"

import "pkg/ast"
import "pkg/buf"
import "pkg/mangle"
import "pkg/types"

// InitModule creates a new module and resets all IR generation global state.
func InitModule(name @[]char) @Module {
	var emptyConsts @[]ModuleConst
	moduleConsts = emptyConsts
	var emptyStructs @[]ModuleStruct
	moduleStructs = emptyStructs
	var emptyGlobals @[]ModuleGlobal
	moduleGlobals = emptyGlobals
	var emptyFuncs @[]FuncSig
	moduleFuncs = emptyFuncs
	var emptyAliases @[]ModuleTypeAlias
	moduleTypeAliases = emptyAliases
	var emptyPendingMs @[]@types.Type
	pendingMsDtors = emptyPendingMs
	var emptyPendingStructs @[]@types.Type
	pendingStructDtors = emptyPendingStructs
	anonStructCounter = 0
	currentModulePkgShort = ""
	return NewModule(name)
}

// RegisterStructTypes registers struct type names and populates fields from
// the given packages, without registering function signatures. Used to make
// transitive dependency struct types available for field type resolution.
func RegisterStructTypes(aliases @[]@[]char, files *[]@ast.File) {
	// Pass 1: register all struct type names
	for k := 0; k < len(aliases); k++ {
		var alias @[]char = aliases[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
				var qualName @[]char = buildQualName(alias, d.Name)
				if lookupStructIdx(qualName) < 0 {
					var ms ModuleStruct
					ms.Name = qualName
					var noFields @[]@types.Field
					ms.Typ = types.MakeStructType(qualName, noFields)
					moduleStructs = appendModuleStruct(moduleStructs, ms)
				}
			}
		}
	}

	// Register type aliases from all packages
	for k := 0; k < len(aliases); k++ {
		var alias @[]char = aliases[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			if d.Kind == ast.DECL_TYPE && d.IsAlias && d.TypeRef != nil {
				var qualName @[]char = buildQualName(alias, d.Name)
				if lookupTypeAlias(qualName) == nil {
					var ta ModuleTypeAlias
					ta.Name = qualName
					ta.Typ = resolveTypeExpr(d.TypeRef)
					moduleTypeAliases = appendModuleTypeAlias(moduleTypeAliases, ta)
				}
			}
		}
	}

	// Pass 2: populate struct fields only
	for k := 0; k < len(aliases); k++ {
		var alias @[]char = aliases[k]
		var file @ast.File = files[k]
		if file == nil || len(file.Decls) == 0 { continue }
		currentImportAlias = alias
		for i := 0; i < len(file.Decls); i++ {
			var d @ast.Decl = file.Decls[i]
			if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
				var qualName @[]char = buildQualName(alias, d.Name)
				var si int = lookupStructIdx(qualName)
				if si >= 0 {
					var existTyp @types.Type = moduleStructs[si].Typ
					if len(existTyp.Fields) == 0 {
						var fields @[]@types.Field
						for j := 0; j < len(d.TypeRef.Fields); j++ {
							var fd @ast.FieldDecl = d.TypeRef.Fields[j]
							var f @types.Field = make(types.Field)
							f.Name = fd.Name
							f.Type = resolveTypeExpr(fd.Type)
							fields = appendFieldPtr(fields, f)
						}
						existTyp.Fields = fields
					}
				}
			}
		}
	}
	var emptyAlias @[]char
	currentImportAlias = emptyAlias
}

// RegisterImports registers multiple imported packages with proper cross-package type resolution.
// It does struct name registration across ALL packages first, then populates fields and functions.
// This ensures that types referenced across packages (e.g., ir.Instr referencing types.Type)
// are resolved correctly regardless of import order.
func GeneratePackage(file @ast.File, m @Module) {
	// Source the package short-name from the IR Module's name, not
	// file.PkgName. They usually agree, but for cmd/* packages they
	// don't: file.PkgName is "main" (the source declaration), while
	// m.Name carries the import path "cmd/bni" / "cmd/bnc" / etc.
	// Backends (codegen, vm, native) all use the module identity
	// for linker symbols, so IR-gen must qualify with the same name
	// or the auto-emitted helpers (__copy_X, __dtor_X) end up with
	// "bn_main____copy_X" definitions but "bn_bni____copy_X"
	// callers — link error.
	currentModulePkgShort = mangle.PkgShortNameFromModule(m.Name)
	resetFuncLitState(m)
	// First pass: collect constants, globals, and type declarations (local)
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_CONST {
			genConst(d)
		}
		if d.Kind == ast.DECL_GROUP {
			genConstGroup(d)
		}
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			var ms ModuleStruct
			ms.Name = buf.CopyStr(d.Name)
			var noFields2 @[]@types.Field
			ms.Typ = types.MakeStructType(d.Name, noFields2)
			moduleStructs = appendModuleStruct(moduleStructs, ms)
		}
		if d.Kind == ast.DECL_TYPE && d.IsAlias && d.TypeRef != nil {
			var ta ModuleTypeAlias
			ta.Name = buf.CopyStr(d.Name)
			ta.Typ = resolveTypeExpr(d.TypeRef)
			moduleTypeAliases = appendModuleTypeAlias(moduleTypeAliases, ta)
		}
		if d.Kind == ast.DECL_VAR {
			var mg ModuleGlobal
			mg.Name = buf.CopyStr(d.Name)
			mg.Typ = resolveTypeExpr(d.TypeRef)
			if d.Value != nil && d.Value.Kind == ast.EXPR_INT_LIT {
				mg.Init = parseIntLit(d.Value.Name)
			}
			moduleGlobals = appendModuleGlobal(moduleGlobals, mg)
		}
	}

	// Second pass: populate struct fields on the existing type objects
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			var si int = lookupStructIdx(d.Name)
			if si >= 0 {
				var fields @[]@types.Field
				for j := 0; j < len(d.TypeRef.Fields); j++ {
					var fd @ast.FieldDecl = d.TypeRef.Fields[j]
					var f @types.Field = make(types.Field)
					f.Name = fd.Name
					f.Type = resolveTypeExpr(fd.Type)
					fields = appendFieldPtr(fields, f)
				}
				var typ @types.Type = moduleStructs[si].Typ
				typ.Fields = fields
				moduleStructs[si].Fields = fields
			}
		}
	}

	// Third pass: register function and method signatures.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if d.Recv != nil {
			moduleFuncs = appendFuncSig(moduleFuncs, methodSig(currentModulePkgShort, d))
			continue
		}
		var sig FuncSig
		sig.Name = qualifyForCurrentModule(buf.CopyStr(d.Name))
		var sigParams @[]@types.Type
		for j := 0; j < len(d.Params); j++ {
			sigParams = appendTypePtr(sigParams, resolveTypeExpr(d.Params[j].Type))
		}
		sig.Params = sigParams
		var sigResults @[]@types.Type
		for j := 0; j < len(d.Results); j++ {
			sigResults = appendTypePtr(sigResults, resolveTypeExpr(d.Results[j]))
		}
		sig.Results = sigResults
		if len(sigResults) > 1 {
			sig.MultiReturnType = makeMultiReturnStructType(sigResults)
		}
		moduleFuncs = appendFuncSig(moduleFuncs, sig)
	}

	// Add globals to module
	for i := 0; i < len(moduleGlobals); i++ {
		var g @Global = make(Global)
		g.Name = moduleGlobals[i].Name
		g.Typ = moduleGlobals[i].Typ
		AddGlobal(m, g)
	}

	// Generate function and method bodies.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if d.Recv != nil {
			AddFunc(m, genMethod(d, currentModulePkgShort))
		} else {
			AddFunc(m, genFunc(d))
		}
	}

	// Generate destructor functions (after user functions, so we know all
	// managed-slice types that need dtors from scope cleanup sites)
	generateDtors(m)

	// Generate copy functions (symmetric to dtors — RefInc on struct copy)
	generateCopies(m)
}

// GenDecl IR-gens a single top-level declaration against the
// existing module `m` and registers it for subsequent IR
// references.  REPL entry point for Tier 2.
//
// Returns "" on success or a diagnostic message on a kind not yet
// supported (caller surfaces the message and skips lowering).
//
// Currently supported: DECL_FUNC (no methods, no receiver),
// DECL_CONST (single), DECL_GROUP composed entirely of DECL_CONST
// (grouped consts with iota), and DECL_VAR (a single top-level
// var; caller is responsible for VM-side materialization of the
// new entry in m.Globals).  Type decls remain out of scope —
// they touch separate machinery (struct registration + dtor /
// copy regen).  Bodies introduced via GenDecl can call into
// existing module funcs and use already-known managed types;
// introducing a brand-new managed-type dtor requirement isn't
// yet handled (would need dedup-aware regeneration of dtors /
// copies).
//
// Caller must have already initialized the surrounding module
// state (currentModulePkgShort, moduleStructs, moduleConsts,
// moduleGlobals, moduleFuncs) via a prior GenModule /
// GeneratePackage call on the REPL session module.
func GenDecl(d @ast.Decl, m @Module) @[]char {
	if d == nil {
		return "GenDecl: nil decl"
	}
	if d.Kind == ast.DECL_CONST {
		genConst(d)
		return ""
	}
	if d.Kind == ast.DECL_GROUP {
		// Accept const-only groups; reject anything else.
		for i := 0; i < len(d.Decls); i++ {
			if d.Decls[i].Kind != ast.DECL_CONST {
				return "only const groups are supported at the prompt"
			}
		}
		genConstGroup(d)
		return ""
	}
	if d.Kind == ast.DECL_VAR {
		if d.TypeRef == nil {
			return "var decl at the prompt requires an explicit type"
		}
		var mg ModuleGlobal
		mg.Name = buf.CopyStr(d.Name)
		mg.Typ = resolveTypeExpr(d.TypeRef)
		moduleGlobals = appendModuleGlobal(moduleGlobals, mg)
		var g @Global = make(Global)
		g.Name = mg.Name
		g.Typ = mg.Typ
		AddGlobal(m, g)
		return ""
	}
	if d.Kind != ast.DECL_FUNC {
		return "only func, const, and var declarations are supported at the prompt (Tier 2)"
	}
	if d.Recv != nil {
		return "method declarations are not yet supported at the prompt"
	}
	// Register signature in moduleFuncs so that subsequent IR
	// gen of other code can resolve calls to this func.
	var sig FuncSig
	sig.Name = buf.CopyStr(d.Name)
	var sigParams @[]@types.Type
	for j := 0; j < len(d.Params); j++ {
		sigParams = appendTypePtr(sigParams,
			resolveTypeExpr(d.Params[j].Type))
	}
	sig.Params = sigParams
	var sigResults @[]@types.Type
	for j := 0; j < len(d.Results); j++ {
		sigResults = appendTypePtr(sigResults,
			resolveTypeExpr(d.Results[j]))
	}
	sig.Results = sigResults
	if len(sigResults) > 1 {
		sig.MultiReturnType = makeMultiReturnStructType(sigResults)
	}
	moduleFuncs = appendFuncSig(moduleFuncs, sig)

	// Generate body and add to the module.
	AddFunc(m, genFunc(d))
	return ""
}

// GenSyntheticFunc wraps a stmt list as a no-arg, no-result IR
// function and returns it.  REPL entry point: a stmt list typed at
// the prompt is wrapped as `func <name>() { <stmts> }` and IR-gen'd
// via the existing genFunc path, ready to be appended to a module
// (with AddFunc) and lowered.
//
// Caller must have already initialized the surrounding module
// state (currentModulePkgShort, moduleStructs, moduleConsts,
// moduleGlobals) via a prior GenModule / GeneratePackage on the
// REPL session module — the synthetic function is generated in
// that module's context so it can refer to its decls.
func GenSyntheticFunc(name @[]char, body @[]@ast.Stmt) @Func {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = name
	var bodyBlock @ast.Stmt = make(ast.Stmt)
	bodyBlock.Kind = ast.STMT_BLOCK
	bodyBlock.Stmts = body
	d.Body = bodyBlock
	return genFunc(d)
}

// GenModule generates an IR module from a single file (backward-compatible API).
func GenModule(file @ast.File) @Module {
	var m @Module = InitModule(file.PkgName)
	// In this single-file path m.Name and file.PkgName agree (the
	// caller is testing or REPL-ish, where the file IS the module),
	// so it's safe to source the short name from file.PkgName here.
	// GeneratePackage sources from m.Name to handle the cmd/* case
	// where they disagree. Set after InitModule, which clears
	// currentModulePkgShort for test isolation.
	currentModulePkgShort = mangle.PkgShortNameFromModule(file.PkgName)
	resetFuncLitState(m)
	var emptyConsts2 @[]ModuleConst
	moduleConsts = emptyConsts2
	var emptyStructs2 @[]ModuleStruct
	moduleStructs = emptyStructs2
	var emptyGlobals2 @[]ModuleGlobal
	moduleGlobals = emptyGlobals2

	// First pass: collect constants, globals, and type declarations
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_CONST {
			genConst(d)
		}
		// DECL_GROUP contains grouped const declarations
		if d.Kind == ast.DECL_GROUP {
			genConstGroup(d)
		}
		// Struct type declarations — register name first (for self-referential types)
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			var ms ModuleStruct
			ms.Name = buf.CopyStr(d.Name)
			// Register with empty fields first so self-references resolve
			var noFields3 @[]@types.Field
			ms.Typ = types.MakeStructType(d.Name, noFields3)
			moduleStructs = appendModuleStruct(moduleStructs, ms)
		}
		// Global variable declarations
		if d.Kind == ast.DECL_VAR {
			var mg ModuleGlobal
			mg.Name = buf.CopyStr(d.Name)
			mg.Typ = resolveTypeExpr(d.TypeRef)
			if d.Value != nil && d.Value.Kind == ast.EXPR_INT_LIT {
				mg.Init = parseIntLit(d.Value.Name)
			}
			moduleGlobals = appendModuleGlobal(moduleGlobals, mg)
		}
	}

	// Second pass: populate struct fields on existing type objects
	// (must update in-place so self-referential types stay connected)
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind == ast.DECL_TYPE && d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
			var si int = lookupStructIdx(d.Name)
			if si >= 0 {
				var fields @[]@types.Field
				for j := 0; j < len(d.TypeRef.Fields); j++ {
					var fd @ast.FieldDecl = d.TypeRef.Fields[j]
					var f @types.Field = make(types.Field)
					f.Name = fd.Name
					f.Type = resolveTypeExpr(fd.Type)
					fields = appendFieldPtr(fields, f)
				}
				var typ @types.Type = moduleStructs[si].Typ
				typ.Fields = fields
				moduleStructs[si].Fields = fields
			}
		}
	}

	// Third pass: register function and method signatures (append to
	// existing, preserving imports).
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if d.Recv != nil {
			moduleFuncs = appendFuncSig(moduleFuncs, methodSig(currentModulePkgShort, d))
			continue
		}
		var sig FuncSig
		sig.Name = qualifyForCurrentModule(buf.CopyStr(d.Name))
		var sigParams @[]@types.Type
		for j := 0; j < len(d.Params); j++ {
			sigParams = appendTypePtr(sigParams, resolveTypeExpr(d.Params[j].Type))
		}
		sig.Params = sigParams
		var sigResults @[]@types.Type
		for j := 0; j < len(d.Results); j++ {
			sigResults = appendTypePtr(sigResults, resolveTypeExpr(d.Results[j]))
		}
		sig.Results = sigResults
		if len(sigResults) > 1 {
			sig.MultiReturnType = makeMultiReturnStructType(sigResults)
		}
		moduleFuncs = appendFuncSig(moduleFuncs, sig)
	}

	// Add globals to module
	for i := 0; i < len(moduleGlobals); i++ {
		var g @Global = make(Global)
		g.Name = moduleGlobals[i].Name
		g.Typ = moduleGlobals[i].Typ
		AddGlobal(m, g)
	}

	// Third pass: generate function and method bodies.
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d.Kind != ast.DECL_FUNC {
			continue
		}
		if d.Recv != nil {
			AddFunc(m, genMethod(d, currentModulePkgShort))
		} else {
			AddFunc(m, genFunc(d))
		}
	}

	// Generate destructor functions (after user functions)
	generateDtors(m)

	// Generate copy functions (symmetric to dtors)
	generateCopies(m)

	return m
}

// genConst registers a single constant declaration in moduleConsts.
func genConst(d @ast.Decl) {
	if d.Value != nil && d.Value.Kind == ast.EXPR_INT_LIT {
		var mc ModuleConst
		mc.Name = buf.CopyStr(d.Name)
		mc.Val = parseIntLit(d.Value.Name)
		if d.TypeRef != nil {
			mc.Typ = resolveTypeExpr(d.TypeRef)
		}
		moduleConsts = appendModuleConst(moduleConsts, mc)
	}
}

// genConstGroup registers a group of iota constants in moduleConsts.
func genConstGroup(d @ast.Decl) {
	if len(d.Decls) == 0 { return }
	var iotaVal int = 0
	// Resolve the group's type (if any) — applies to all members
	var groupTyp @types.Type = nil
	if len(d.Decls) > 0 && d.Decls[0].TypeRef != nil {
		groupTyp = resolveTypeExpr(d.Decls[0].TypeRef)
	}
	for i := 0; i < len(d.Decls); i++ {
		var cd @ast.Decl = d.Decls[i]
		if cd.Kind == ast.DECL_CONST {
			var mc ModuleConst
			mc.Name = buf.CopyStr(cd.Name)
			if cd.Value != nil && cd.Value.Kind == ast.EXPR_INT_LIT {
				mc.Val = parseIntLit(cd.Value.Name)
			} else {
				// iota or inherited iota
				mc.Val = iotaVal
			}
			// Use the member's type if present, otherwise the group type
			if cd.TypeRef != nil {
				mc.Typ = resolveTypeExpr(cd.TypeRef)
			} else {
				mc.Typ = groupTyp
			}
			moduleConsts = appendModuleConst(moduleConsts, mc)
			iotaVal = iotaVal + 1
		}
	}
}

