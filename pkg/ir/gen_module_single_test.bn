package "pkg/ir"

import "pkg/ast"
import "pkg/builtins/testing"
import "pkg/parser"

// GenModule is the single-file IR-gen entry — most pkg/ir tests
// reach it via the genFromSource helper in ir_test.bn.  This file
// pins the direct invariants: the returned Module's name matches
// the file's package declaration, and main-package functions get
// recorded.

func TestGenModuleNameMatchesPkg() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc main() {}\n"
	var p @parser.Parser = parser.New(strToBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var m @Module = GenModule(file)
	if !seq(m.Name, "\"test\"") {
		return fail("Module.Name should mirror file.PkgName")
	}
	return ""
}

func TestGenModuleRegistersFuncs() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc foo() {}\nfunc bar() {}\n"
	var p @parser.Parser = parser.New(strToBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var m @Module = GenModule(file)
	// Builder always adds at least __init_all + __entry; the two
	// user funcs land in addition to that scaffolding.
	if len(m.Funcs) < 2 {
		return fail("expected foo + bar to land in m.Funcs")
	}
	var foundFoo bool = false
	var foundBar bool = false
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.foo") { foundFoo = true }
		if seq(m.Funcs[i].Name, "test.bar") { foundBar = true }
	}
	if !foundFoo { return fail("test.foo missing from m.Funcs") }
	if !foundBar { return fail("test.bar missing from m.Funcs") }
	return ""
}
