package "pkg/ir"

import "pkg/ast"
import "pkg/bootstrap"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/parser"
import "pkg/types"

func TestInitModule() testing.TestResult {
	var m @Module = InitModule("\"pkg/helper\"")
	if m == nil { return fail("InitModule returned nil") }
	if !seq(m.Name, "\"pkg/helper\"") { return fail("wrong module name") }
	return ""
}

func TestGeneratePackage() testing.TestResult {
	var m @Module = InitModule("\"pkg/helper\"")

	var src *[]const char = "package \"pkg/helper\"\nfunc Double(x int) int {\n\treturn x + x\n}\n"
	var p @parser.Parser = parser.New(strToBytes(src), "test.bn")
	var file @ast.File = parser.ParseFile(p)

	GeneratePackage(file, m)

	if len(m.Funcs) == 0 {
		return fail("expected function in module")
	}
	var f @Func = m.Funcs[0]
	if !seq(f.Name, "Double") { return fail("expected function named Double") }
	if f.IsExtern { return fail("should not be extern") }
	if len(f.Blocks) == 0 { return fail("expected blocks") }
	return ""
}

func TestGeneratePackageWithImport() testing.TestResult {
	var m @Module = InitModule("\"main\"")

	// Register an import first
	var bniSrc *[]const char = "package \"pkg/helper\"\nfunc Double(x int) int\n"
	var bp @parser.Parser = parser.NewInterface(strToBytes(bniSrc), "helper.bni")
	var bniFile @ast.File = parser.ParseFile(bp)
	RegisterImport("helper", bniFile, m)

	// Generate main package that calls imported function
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"main\"\n")
	cb = cb.WriteStr("import \"pkg/helper\"\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar x int = helper.Double(21)\n")
	cb = cb.WriteStr("\tprintln(x)\n}\n")
	var mainSrc @[]char = cb.Bytes()
	var mp @parser.Parser = parser.New(strToBytes(mainSrc), "main.bn")
	var mainFile @ast.File = parser.ParseFile(mp)
	GeneratePackage(mainFile, m)

	// Should have extern func + main func
	if len(m.Funcs) < 2 { return fail("expected at least 2 funcs (1 extern + 1 main)") }

	// Find main function
	var mainFn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "main") {
			mainFn = m.Funcs[i]
		}
	}
	if mainFn == nil { return fail("expected main function") }

	// Check for a call instruction with qualified name
	var foundCall bool = false
	for i := 0; i < len(mainFn.Blocks); i++ {
		for j := 0; j < len(mainFn.Blocks[i].Instrs); j++ {
			var instr @Instr = mainFn.Blocks[i].Instrs[j]
			if instr.Op == OP_CALL && seq(instr.StrVal, "helper.Double") {
				foundCall = true
			}
		}
	}
	if !foundCall { return fail("expected call to helper.Double") }
	return ""
}

func TestTypeAliasLocal() testing.TestResult {
	// A type alias in the package should resolve correctly
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Result = @[]char\n")
	cb = cb.WriteStr("func check() Result {\n")
	cb = cb.WriteStr("\tvar r @[]char = make_slice(char, 3)\n")
	cb = cb.WriteStr("\treturn r\n}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSourcePkg(src)
	if len(m.Funcs) == 0 { return fail("expected at least 1 func") }
	var f @Func = m.Funcs[0]
	if len(f.Results) == 0 {
		return fail("expected return type")
	}
	if f.Results[0].Kind != types.TYP_MANAGED_SLICE {
		return fail("expected managed-slice return type")
	}
	return ""
}

func TestTypeAliasImported() testing.TestResult {
	// A type alias from an imported package should resolve via qualified name
	var m @Module = InitModule("\"main\"")

	var bniSrc *[]const char =
		"package \"pkg/mylib\"\ntype Result = @[]char\nfunc MakeResult() Result\n"
	var bp @parser.Parser = parser.NewInterface(strToBytes(bniSrc), "mylib.bni")
	var bniFile @ast.File = parser.ParseFile(bp)
	RegisterImport("mylib", bniFile, m)

	// Check that the function sig has the right return type
	var results @[]@types.Type = lookupFuncResults("mylib.MakeResult")
	if len(results) == 0 {
		return fail("expected return type in func sig")
	}
	if results[0].Kind != types.TYP_MANAGED_SLICE {
		return fail("expected managed-slice return type in func sig")
	}
	return ""
}

func TestGeneratePackageStructLitInit() testing.TestResult {
	// GeneratePackage must populate ModuleStruct.Fields so that
	// genCompositeLit can initialize struct literal field values.
	// Regression: only Typ.Fields was set, so composites were zeroinitializer.
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Pt struct {\n\tx int\n\ty int\n}\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar p Pt = Pt{x: 10, y: 20}\n")
	cb = cb.WriteStr("\tprintln(p.x)\n}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSourcePkg(src)
	if len(m.Funcs) == 0 { return fail("expected at least 1 func") }
	var mainFn @Func = m.Funcs[0]
	// Look for OP_STORE instructions that store non-zero values (the field inits)
	var foundFieldStore bool = false
	for i := 0; i < len(mainFn.Blocks); i++ {
		var blk @Block = mainFn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @Instr = blk.Instrs[j]
			if instr.Op == OP_STORE && len(instr.Args) >= 2 {
				// Check if the stored value (Args[1]) is a constant 10 or 20
				if instr.Args[1].Op == OP_CONST_INT {
					if instr.Args[1].IntVal == 10 || instr.Args[1].IntVal == 20 {
						foundFieldStore = true
					}
				}
			}
		}
	}
	if !foundFieldStore {
		return fail("no store of field values 10 or 20 found — struct literal init missing")
	}
	return ""
}

// ============================================================
// REPL: GenSyntheticFunc
// ============================================================

// TestGenDeclFunc verifies that a single func decl lowered via
// GenDecl appends a function with the expected name to the
// existing module's Funcs slice and returns no error message.
func TestGenDeclFunc() testing.TestResult {
	// Establish module state with a normal pass first.
	var src *[]const char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	var initialFuncs int = len(m.Funcs)

	// Parse and lower a new func decl as if it came from the prompt.
	var declSrc *[]const char = "func double(x int) int { return x * 2 }"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = parser.ParseTopLevelDecl(p)
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var msg @[]char = GenDecl(d, m)
	if len(msg) > 0 { return fail("GenDecl returned error message") }
	if len(m.Funcs) != initialFuncs + 1 {
		return fail("module Funcs did not grow by exactly one")
	}
	// Find the new func by Name suffix (qualifier may be added by lowering).
	var found bool = false
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "double") { found = true }
	}
	if !found { return fail("new func 'double' not in module Funcs") }
	return ""
}

// TestGenDeclTypeRejected verifies that a non-FUNC decl returns
// the documented "not yet supported" diagnostic, not a crash.
func TestGenDeclTypeRejected() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc main() {}\n"
	var m @Module = genFromSource(src)
	var declSrc *[]const char = "type T struct { X int }"
	var p @parser.Parser = parser.New(strToBytes(declSrc), "<repl>")
	var d @ast.Decl = parser.ParseTopLevelDecl(p)
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var msg @[]char = GenDecl(d, m)
	if len(msg) == 0 {
		return fail("expected diagnostic for non-FUNC decl")
	}
	return ""
}

// TestGenSyntheticFunc verifies that a stmt list lowered through
// GenSyntheticFunc produces a callable IR function with the
// expected name and a non-empty entry block.  The surrounding
// module state is established by genFromSource on a tiny program
// first, mirroring the REPL pattern (load module, then evaluate
// prompt entries against it).
func TestGenSyntheticFunc() testing.TestResult {
	// Establish module state via a normal GenModule pass.
	var src *[]const char = "package \"test\"\nfunc main() {}\n"
	genFromSource(src)
	// Parse a tiny stmt list and lower it as a synthetic func.
	var stmtSrc *[]const char = "var x int = 5; x = x + 1"
	var p @parser.Parser = parser.New(strToBytes(stmtSrc), "repl")
	var ss @[]@ast.Stmt = parser.ParseStmtList(p)
	if len(parser.Errors(p)) != 0 {
		return fail("parse error in stmt list")
	}
	var f @Func = GenSyntheticFunc("__repl_0", ss)
	if f == nil { return fail("GenSyntheticFunc returned nil") }
	if !seq(f.Name, "__repl_0") { return fail("wrong synthetic name") }
	if len(f.Blocks) == 0 { return fail("expected at least entry block") }
	if len(f.Blocks[0].Instrs) == 0 {
		return fail("entry block has no instructions")
	}
	return ""
}
