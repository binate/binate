package "pkg/ir"

import "pkg/ast"
import "pkg/types"

// IR-gen for the print/println builtin. Decoupled from any
// dedicated C runtime function: format steps run as pure Binate
// (bootstrap.formatInt, bootstrap.formatBool, bootstrap.formatFloat)
// and the I/O sink is always bootstrap.Write. See
// explorations/plan-print-builtin-runtime-decoupling.md.

// genPrintCall expands println/print into per-arg format + write
// sequences.
//
// All output goes through bootstrap.Write (the single I/O sink),
// preceded by a per-type format step where needed:
//   - int   → bootstrap.formatInt + bootstrap.Write
//   - bool  → bootstrap.formatBool + bootstrap.Write
//   - float → bootstrap.formatFloat + bootstrap.Write
//   - string/chars → bootstrap.Write directly (already bytes)
//   - inter-arg space and trailing newline → bootstrap.Write of a
//     1-byte constant slice
func genPrintCall(ctx @GenContext, b @Block, e @ast.Expr, newline bool) @Instr {
	for i := 0; i < len(e.Args); i++ {
		if i > 0 {
			emitWriteConstBytes(ctx, b, " ", 1)
		}

		var arg @ast.Expr = e.Args[i]
		var val @Instr = genExpr(ctx, b, arg)
		b = ctx.CurBlock

		if val.Typ != nil && val.Typ.IsFloat() {
			// formatFloat takes float64. Widen float32 and
			// untyped-float values to float64.
			if val.Typ.Kind == types.TYP_FLOAT && val.Typ.Width == 32 {
				val = b.EmitCast(val, types.TypFloat64())
			} else if val.Typ.Kind == types.TYP_UNTYPED_FLOAT {
				val = b.EmitCast(val, types.TypFloat64())
			}
			emitPrintFloat(ctx, b, val)
		} else if val.Op == OP_CONST_STRING {
			var strLen int = 0
			if len(val.StrVal) > 0 { strLen = len(val.StrVal) }
			emitWriteRawSlice(ctx, b, val,
				b.EmitConstInt(strLen, types.TypInt()))
		} else if isCharSliceType(val.Typ) {
			if val.Typ.Kind == types.TYP_MANAGED_SLICE {
				val = b.EmitManagedToRaw(val)
			}
			emitWriteSlice(ctx, b, val)
		} else if val.Typ != nil &&
			(val.Typ.Kind == types.TYP_BOOL || val.Typ.Kind == types.TYP_UNTYPED_BOOL) {
			emitPrintBool(ctx, b, val)
		} else if arg.Kind == ast.EXPR_STRING_LIT {
			var strLen int = 0
			if len(val.StrVal) > 0 { strLen = len(val.StrVal) }
			emitWriteRawSlice(ctx, b, val,
				b.EmitConstInt(strLen, types.TypInt()))
		} else if arg.Kind == ast.EXPR_BOOL_LIT {
			emitPrintBool(ctx, b, val)
		} else {
			emitPrintInt(ctx, b, val)
		}
	}

	if newline {
		emitWriteConstBytes(ctx, b, "\n", 1)
	}

	return b.EmitConstNil(types.TypNil())
}

// emitPrintInt lowers `print(intExpr)` into a stack-buffer +
// formatInt-or-formatUint + bootstrap.Write sequence. Signed
// types route to bootstrap.formatInt (with sign byte for
// negatives); unsigned types route to bootstrap.formatUint
// (no sign byte, full uint64 range — required so e.g. `var x
// uint64 = 1 << 63; println(x)` prints `9223372036854775808`
// rather than the signed interpretation).
func emitPrintInt(ctx @GenContext, b @Block, val @Instr) {
	// Stack-alloc [20]uint8 buffer (uint64-max is 20 digits;
	// int64 is 19 digits + sign).
	var u8 @types.Type = types.TypUint8()
	var bufType @types.Type = types.MakeArrayType(u8, 20)
	var bufPtr @Instr = b.EmitAlloc(bufType)

	// Construct *[]uint8 slice {data: bufPtr, len: 20} for the
	// format helper.
	var sliceTyp @types.Type = types.MakeSliceType(u8)
	var fmtSlice @Instr = emitMakeRawSlice(ctx, b, sliceTyp, bufPtr,
		b.EmitConstInt(20, types.TypInt()))

	// Format-helper signatures (see pkg/bootstrap.bni):
	//   formatInt(v int, ...) int       — for signed ints, val widened/narrowed to target int width
	//   formatUint(v uint64, ...) int   — for unsigned ints, val widened to uint64
	// Without an explicit cast, calls like `formatUint(<i32-uint32>, ...)`
	// emit a mismatched call signature (declared as i64 but invoked
	// with i32), which lld won't tolerate.  emit_call.bn's width
	// adjustment doesn't catch this because it compares the arg's
	// type to itself, not to the callee's param type.
	var fmtFn @[]char = "bootstrap.formatInt"
	var castedVal @Instr = val
	if val.Typ != nil && val.Typ.Kind == types.TYP_INT && !val.Typ.Signed {
		fmtFn = "bootstrap.formatUint"
		// Widen the unsigned arg to uint64 explicitly.  No-op
		// when val is already uint64.
		castedVal = b.EmitCast(val, types.TypUint64())
	} else if val.Typ != nil && val.Typ.Kind == types.TYP_INT {
		// Signed: widen / narrow to target's `int` width so the
		// formatInt(int, ...) declared param matches.
		castedVal = b.EmitCast(val, types.TypInt())
	}
	var fmtArgs @[]@Instr = makeArgs2(castedVal, fmtSlice)
	var n @Instr = b.EmitCall(fmtFn, fmtArgs, types.TypInt())

	emitWriteRawSlice(ctx, b, bufPtr, n)
}

// emitPrintBool lowers `print(boolExpr)` into formatBool + Write.
// "false" is the longer of the two outputs, so the buffer is 5 bytes.
func emitPrintBool(ctx @GenContext, b @Block, val @Instr) {
	var u8 @types.Type = types.TypUint8()
	var bufType @types.Type = types.MakeArrayType(u8, 5)
	var bufPtr @Instr = b.EmitAlloc(bufType)

	var sliceTyp @types.Type = types.MakeSliceType(u8)
	var fmtSlice @Instr = emitMakeRawSlice(ctx, b, sliceTyp, bufPtr,
		b.EmitConstInt(5, types.TypInt()))

	var fmtArgs @[]@Instr = makeArgs2(val, fmtSlice)
	var n @Instr = b.EmitCall("bootstrap.formatBool", fmtArgs, types.TypInt())

	emitWriteRawSlice(ctx, b, bufPtr, n)
}

// emitPrintFloat lowers `print(floatExpr)` into formatFloat + Write.
// 32-byte buffer accommodates the worst case (mantissa*2^exponent
// fallback can be up to ~25 bytes; round up).
func emitPrintFloat(ctx @GenContext, b @Block, val @Instr) {
	var u8 @types.Type = types.TypUint8()
	var bufType @types.Type = types.MakeArrayType(u8, 32)
	var bufPtr @Instr = b.EmitAlloc(bufType)

	var sliceTyp @types.Type = types.MakeSliceType(u8)
	var fmtSlice @Instr = emitMakeRawSlice(ctx, b, sliceTyp, bufPtr,
		b.EmitConstInt(32, types.TypInt()))

	var fmtArgs @[]@Instr = makeArgs2(val, fmtSlice)
	var n @Instr = b.EmitCall("bootstrap.formatFloat", fmtArgs, types.TypInt())

	emitWriteRawSlice(ctx, b, bufPtr, n)
}

// emitWriteConstBytes constructs a slice for a constant byte
// sequence (e.g. " " or "\n") and writes it to STDOUT via
// bootstrap.Write. Used for inter-arg spaces and trailing newlines
// in the print/println builtin.
func emitWriteConstBytes(ctx @GenContext, b @Block, s @[]char, length int) {
	var ptr @Instr = b.EmitConstString(s)
	var lenArg @Instr = b.EmitConstInt(length, types.TypInt())
	emitWriteRawSlice(ctx, b, ptr, lenArg)
}

// emitWriteRawSlice constructs a *[]uint8 slice header from
// (dataPtr, length) and calls bootstrap.Write(STDOUT, slice).
func emitWriteRawSlice(ctx @GenContext, b @Block, dataPtr @Instr, length @Instr) {
	var sliceTyp @types.Type = types.MakeSliceType(types.TypUint8())
	var slice @Instr = emitMakeRawSlice(ctx, b, sliceTyp, dataPtr, length)
	emitWriteSlice(ctx, b, slice)
}

// emitWriteSlice writes an existing slice value to STDOUT via
// bootstrap.Write. The slice's element type is treated as bytes at
// the LLVM level (BnSlice is ABI-identical regardless of T) — no
// bit-cast needed.
func emitWriteSlice(ctx @GenContext, b @Block, slice @Instr) {
	var stdout @Instr = b.EmitConstInt(1, types.TypInt())
	var args @[]@Instr = makeArgs2(stdout, slice)
	b.EmitCall("bootstrap.Write", args, types.TypInt())
}

// emitMakeRawSlice allocates a `*[]T` slice header on the stack and
// initializes its data and len fields, returning the loaded slice
// value. Used by the print/println builtin to construct slices for
// bootstrap.Write without going through make_slice (no heap alloc).
func emitMakeRawSlice(ctx @GenContext, b @Block, sliceTyp @types.Type,
		dataPtr @Instr, length @Instr) @Instr {
	var ptrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var sliceAlloca @Instr = b.EmitAlloc(sliceTyp)
	var ptrField @Instr = b.EmitGetFieldPtr(sliceAlloca, 0, ptrTyp)
	b.EmitStore(ptrField, dataPtr)
	var lenField @Instr = b.EmitGetFieldPtr(sliceAlloca, 1, types.TypInt())
	b.EmitStore(lenField, length)
	return b.EmitLoad(sliceAlloca, sliceTyp)
}
