package "pkg/ir"

import "pkg/builtin/testing"

// Smoke tests for the print/println builtin's IR-gen lowering.
// (Coarser-grained behavioral coverage lives in gen_expr_test.bn /
// gen_stmt_test.bn; the conformance suite validates end-to-end
// output across all execution modes.)

func TestGenPrintIntCallsFormatInt() testing.TestResult {
	// println(42) should dispatch through bootstrap.formatInt
	// (NOT through any bn_print_int — that shim is gone).
	var m @Module = genFromSource("package \"test\"\nfunc main() { println(42) }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundFormatInt bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == OP_CALL &&
			seq(entry.Instrs[i].StrVal, "bootstrap.formatInt") {
			foundFormatInt = true
		}
	}
	if !foundFormatInt {
		return fail("println(int) should call bootstrap.formatInt")
	}
	return ""
}

func TestGenPrintStringCallsWriteDirectly() testing.TestResult {
	// println("hi") should call bootstrap.Write directly with no
	// format step — strings are already byte sequences.
	var m @Module = genFromSource("package \"test\"\nfunc main() { println(\"hi\") }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundWrite bool = false
	var foundFormatInt bool = false
	var foundFormatBool bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == OP_CALL {
			if seq(entry.Instrs[i].StrVal, "bootstrap.Write") {
				foundWrite = true
			}
			if seq(entry.Instrs[i].StrVal, "bootstrap.formatInt") {
				foundFormatInt = true
			}
			if seq(entry.Instrs[i].StrVal, "bootstrap.formatBool") {
				foundFormatBool = true
			}
		}
	}
	if !foundWrite { return fail("println(string) should call bootstrap.Write") }
	if foundFormatInt { return fail("string path should not call formatInt") }
	if foundFormatBool { return fail("string path should not call formatBool") }
	return ""
}
