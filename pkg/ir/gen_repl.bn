package "pkg/ir"

import "pkg/ast"
import "pkg/buf"
import "pkg/slices"
import "pkg/types"

// REPL / incremental IR-gen entry points, split out of
// gen_module.bn for file-length hygiene.  Two entries live here:
//
//   - GenDecl: lower a single top-level declaration against an
//     already-initialized module (a func / const / var typed at
//     the prompt persists across subsequent prompt entries).
//   - GenSyntheticFunc: wrap a bare statement list as a no-arg
//     no-result function for the prompt's immediate-mode path
//     (`__repl_<n>()`).
//
// Both rely on the surrounding module-gen state
// (currentModulePkgPath, moduleStructs, moduleConsts,
// moduleGlobals, moduleFuncs) being pre-initialized by a prior
// GenModule / GeneratePackage call.

// GenDecl IR-gens a single top-level declaration against the
// existing module `m` and registers it for subsequent IR
// references.  REPL entry point for Tier 2.
//
// Returns "" on success or a diagnostic message on a kind not yet
// supported (caller surfaces the message and skips lowering).
//
// Currently supported: DECL_FUNC (no methods, no receiver),
// DECL_CONST (single), DECL_GROUP composed entirely of DECL_CONST
// (grouped consts with iota), and DECL_VAR (a single top-level
// var; caller is responsible for VM-side materialization of the
// new entry in m.Globals).  Type decls remain out of scope —
// they touch separate machinery (struct registration + dtor /
// copy regen).  Bodies introduced via GenDecl can call into
// existing module funcs and use already-known managed types;
// introducing a brand-new managed-type dtor requirement isn't
// yet handled (would need dedup-aware regeneration of dtors /
// copies).
//
// Caller must have already initialized the surrounding module
// state (currentModulePkgPath, moduleStructs, moduleConsts,
// moduleGlobals, moduleFuncs) via a prior GenModule /
// GeneratePackage call on the REPL session module.
func GenDecl(d @ast.Decl, m @Module) @[]char {
	if d == nil {
		return "GenDecl: nil decl"
	}
	if d.Kind == ast.DECL_CONST {
		genConst(d)
		return ""
	}
	if d.Kind == ast.DECL_GROUP {
		// Accept const-only groups; reject anything else.
		for i := 0; i < len(d.Decls); i++ {
			if d.Decls[i].Kind != ast.DECL_CONST {
				return "only const groups are supported at the prompt"
			}
		}
		genConstGroup(d)
		return ""
	}
	if d.Kind == ast.DECL_VAR {
		var typ @types.Type = resolveGlobalVarType(d)
		if typ == nil {
			return "var decl at the prompt requires an explicit type or a literal initializer"
		}
		var mg ModuleGlobal
		mg.Name = buf.CopyStr(d.Name)
		mg.Typ = typ
		moduleGlobals = appendModuleGlobal(moduleGlobals, mg)
		var g @Global = make(Global)
		g.Name = mg.Name
		g.Typ = mg.Typ
		m.AddGlobal(g)
		return ""
	}
	if d.Kind == ast.DECL_TYPE {
		return genReplTypeDecl(d, m)
	}
	if d.Kind != ast.DECL_FUNC {
		return "only func / const / var / type declarations are supported at the prompt (Tier 2)"
	}
	if d.Recv != nil {
		// Method declaration.  Mirror the file-load path's pass-3
		// (sig registration via methodSig) and pass-4 (body via
		// genMethod) — collapsed into one pass since GenDecl
		// processes one decl at a time.  The type checker has
		// already registered the method on the receiver type's
		// method set via collectMethodDecl (which uses
		// SetOrAppendMethod under c.AllowRedef so re-typing a
		// method replaces its method-set entry instead of
		// erroring).
		//
		// setOrAppendFuncSig keys on the method's fully-qualified
		// name (`pkg.Type.M`), which is unique per method, so it
		// replaces the moduleFuncs sig in place on redefinition
		// and appends on first definition — matching the
		// free-func path.  AddFunc unconditionally appends; on
		// redef the stale @Func in m.Funcs is harmless (only the
		// @Func passed to LowerOneFunc gets re-lowered, and
		// vm.Funcs is rebound in place by name for replace, or
		// shadow-appended via LowerOneFuncShadow for incompatible
		// sig — both keyed on the qualified name too).
		setOrAppendFuncSig(methodSig(currentModulePkgPath, d))
		m.AddFunc(genMethod(d, currentModulePkgPath))
		return ""
	}
	// Register signature in moduleFuncs so that subsequent IR
	// gen of other code can resolve calls to this func.  Qualify
	// the name (matching GeneratePackage's storage convention) so
	// FIRST-match `lookupFunc*` paths find this entry, and so that
	// re-typing the same func updates an existing entry in place
	// rather than appending a duplicate.
	var sig FuncSig
	sig.Name = qualifyForCurrentModule(buf.CopyStr(d.Name))
	var sigParams @[]@types.Type
	for j := 0; j < len(d.Params); j++ {
		sigParams = slices.Append[@types.Type](sigParams,
			resolveTypeExpr(d.Params[j].Type))
	}
	sig.Params = sigParams
	var sigResults @[]@types.Type
	for j := 0; j < len(d.Results); j++ {
		sigResults = slices.Append[@types.Type](sigResults,
			resolveTypeExpr(d.Results[j]))
	}
	sig.Results = sigResults
	if len(sigResults) > 1 {
		sig.MultiReturnType = makeMultiReturnStructType(sigResults)
	}
	setOrAppendFuncSig(sig)

	// Generate body and add to the module.  AddFunc unconditionally
	// appends; on redefinition this leaves a stale @Func in m.Funcs
	// (harmless — only the @Func passed to LowerOneFunc gets
	// re-lowered, and `vm.Funcs` is rebound in place by name).
	m.AddFunc(genFunc(d))
	return ""
}

// genReplTypeDecl handles a `type` declaration typed at the
// prompt.  Supported forms:
//
//   type Result = @[]char            (alias)
//   type Celsius int                  (named non-struct)
//   type Point struct { X int; Y int } (struct, no managed fields)
//
// Rejected (deferred): struct types containing managed fields.
// Those would require dedup-aware regeneration of `__dtor_<T>` /
// `__copy_<T>` helpers — substantial machinery that interacts
// with the existing `m.Funcs` redefinition / shadow paths.
//
// The type checker has already registered the symbol in
// `c.Scope` via collectTypeDecl; here we only have to mirror
// what GeneratePackage's pass-1/pass-2 do on the IR side
// (register in `moduleStructs` for structs / `moduleTypeAliases`
// for aliases; named non-structs need no IR-side state).
func genReplTypeDecl(d @ast.Decl, m @Module) @[]char {
	if d.IsAlias && d.TypeRef != nil {
		var ta ModuleTypeAlias
		ta.Name = buf.CopyStr(d.Name)
		ta.Typ = resolveTypeExpr(d.TypeRef)
		moduleTypeAliases = appendModuleTypeAlias(
			moduleTypeAliases, ta)
		return ""
	}
	if d.TypeRef != nil && d.TypeRef.Kind == ast.TEXPR_STRUCT {
		// Build the field list eagerly (single-pass at the
		// prompt — no forward-referenced types within the same
		// decl, since we're processing one DECL at a time).
		var fields @[]@types.Field
		for j := 0; j < len(d.TypeRef.Fields); j++ {
			var fd @ast.FieldDecl = d.TypeRef.Fields[j]
			var f @types.Field = make(types.Field)
			f.Name = fd.Name
			f.Type = resolveTypeExpr(fd.Type)
			fields = slices.Append[@types.Field](fields, f)
		}
		var ms ModuleStruct
		ms.Name = buf.CopyStr(d.Name)
		ms.Typ = types.MakeStructType(d.Name, fields)
		ms.Fields = fields
		moduleStructs = appendModuleStruct(moduleStructs, ms)
		// If the struct contains any managed field, emit its
		// dtor + copy (and any field-type helpers it needs)
		// into m.Funcs, dedup'd against helpers that already
		// landed for previously-loaded types.  Caller
		// (cmd/bni/repl.bn evalReplDecl) lowers everything
		// added during this GenDecl call.
		if structTypeNeedsHelpers(ms.Typ) {
			ensureReplStructHelpers(m, ms.Typ)
		}
		return ""
	}
	// Named non-struct (`type Celsius int`): the type checker
	// owns the symbol; IR-gen has no per-decl state for these.
	// Methods on the type would be a separate Tier 2 follow-up.
	return ""
}

// structTypeNeedsHelpers reports whether `t` (a TYP_STRUCT)
// requires `__dtor_<T>` / `__copy_<T>` emission.  True iff the
// struct or any of its fields contains a managed pointer or
// managed slice that requires cleanup.
func structTypeNeedsHelpers(t @types.Type) bool {
	return t.NeedsDestruction()
}

// ensureReplStructHelpers emits `__dtor_<T>` and `__copy_<T>`
// for a freshly-registered prompt-defined struct, plus any
// field-type helpers (managed-slice / array dtors+copies).
// Dedup'd against m.Funcs: pre-populates the per-call
// `generated` slice with names of helper-shaped functions
// already present, so previously-emitted helpers from earlier
// `type` decls or the loaded module aren't re-emitted.
//
// The substrate (genStructDtorWithName, ensureMsDtor, etc.)
// is reused from gen_dtor_emit.bn / gen_copy_emit.bn — same
// helpers the file-load passes call.  Difference is just the
// scope: we target one struct at a time and skip work already
// done.
func ensureReplStructHelpers(m @Module, structTyp @types.Type) {
	var generated @[]@[]char = collectExistingHelperNames(m)

	// Struct dtor.
	var dname @[]char = dtorNameForType(structTyp)
	if !hasName(generated, dname) {
		m.AddFunc(genStructDtorWithName(dname, structTyp))
		generated = appendCharSlicePtr(generated, dname)
	}
	// Struct copy.
	var cname @[]char = copyNameForType(structTyp)
	if !hasName(generated, cname) {
		m.AddFunc(genStructCopyWithName(cname, structTyp))
		generated = appendCharSlicePtr(generated, cname)
	}
	// Field-type helpers (managed-slice + array-with-destructible
	// element).  Mirrors the file-load generateNonStructDtors /
	// generateCopies pass-3 logic, scoped to this struct.
	for j := 0; j < len(structTyp.Fields); j++ {
		var ft @types.Type = structTyp.Fields[j].Type.ResolveAlias()
		if ft.Kind == types.TYP_MANAGED_SLICE {
			generated = ensureMsDtor(m, ft, generated)
		}
		if ft.Kind == types.TYP_ARRAY &&
				ft.Elem.NeedsDestruction() {
			generated = ensureArrayDtor(m, ft, generated)
			generated = ensureArrayCopy(m, ft, generated)
		}
	}
}

// collectExistingHelperNames returns the UNQUALIFIED names of
// every __dtor_/__copy_-shaped function already present in
// m.Funcs.  NewFunc qualifies names with currentModulePkgPath
// (so "__dtor_Bag" lands as "test.__dtor_Bag" in m.Funcs);
// this strips the qualifier so dedup compares unqualified-to-
// unqualified — matching what dtorNameForType / copyNameForType
// produce for the about-to-be-emitted helper.
func collectExistingHelperNames(m @Module) @[]@[]char {
	var names @[]@[]char
	for i := 0; i < len(m.Funcs); i++ {
		var u @[]char = unqualifiedHelperName(m.Funcs[i].Name)
		if len(u) > 0 {
			names = appendCharSlicePtr(names, u)
		}
	}
	return names
}

// unqualifiedHelperName returns the `__dtor_<...>` /
// `__copy_<...>` suffix of `n` (stripping any `pkg.` prefix
// before it), or empty if `n` isn't a helper-shaped name.
func unqualifiedHelperName(n @[]char) @[]char {
	// Find the start of the helper prefix: either at index 0
	// or immediately after the last '.'.
	var start int = 0
	for i := 0; i < len(n); i++ {
		if n[i] == '.' { start = i + 1 }
	}
	var rest @[]char = n[start:]
	if startsWithChars(rest, "__dtor_") ||
			startsWithChars(rest, "__copy_") {
		return rest
	}
	var empty @[]char
	return empty
}

// startsWithChars returns true if n begins with prefix.
func startsWithChars(n @[]char, prefix *[]const char) bool {
	if len(n) < len(prefix) { return false }
	for i := 0; i < len(prefix); i++ {
		if n[i] != prefix[i] { return false }
	}
	return true
}

// GenSyntheticFunc wraps a stmt list as a no-arg, no-result IR
// function and returns it.  REPL entry point: a stmt list typed at
// the prompt is wrapped as `func <name>() { <stmts> }` and IR-gen'd
// via the existing genFunc path, ready to be appended to a module
// (with AddFunc) and lowered.
//
// Caller must have already initialized the surrounding module
// state (currentModulePkgPath, moduleStructs, moduleConsts,
// moduleGlobals) via a prior GenModule / GeneratePackage on the
// REPL session module — the synthetic function is generated in
// that module's context so it can refer to its decls.
func GenSyntheticFunc(name @[]char, body @[]@ast.Stmt) @Func {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = name
	var bodyBlock @ast.Stmt = make(ast.Stmt)
	bodyBlock.Kind = ast.STMT_BLOCK
	bodyBlock.Stmts = body
	d.Body = bodyBlock
	return genFunc(d)
}
