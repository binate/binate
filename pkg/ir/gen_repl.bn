package "pkg/ir"

import "pkg/ast"
import "pkg/buf"
import "pkg/types"

// REPL / incremental IR-gen entry points, split out of
// gen_module.bn for file-length hygiene.  Two entries live here:
//
//   - GenDecl: lower a single top-level declaration against an
//     already-initialized module (a func / const / var typed at
//     the prompt persists across subsequent prompt entries).
//   - GenSyntheticFunc: wrap a bare statement list as a no-arg
//     no-result function for the prompt's immediate-mode path
//     (`__repl_<n>()`).
//
// Both rely on the surrounding module-gen state
// (currentModulePkgShort, moduleStructs, moduleConsts,
// moduleGlobals, moduleFuncs) being pre-initialized by a prior
// GenModule / GeneratePackage call.

// GenDecl IR-gens a single top-level declaration against the
// existing module `m` and registers it for subsequent IR
// references.  REPL entry point for Tier 2.
//
// Returns "" on success or a diagnostic message on a kind not yet
// supported (caller surfaces the message and skips lowering).
//
// Currently supported: DECL_FUNC (no methods, no receiver),
// DECL_CONST (single), DECL_GROUP composed entirely of DECL_CONST
// (grouped consts with iota), and DECL_VAR (a single top-level
// var; caller is responsible for VM-side materialization of the
// new entry in m.Globals).  Type decls remain out of scope —
// they touch separate machinery (struct registration + dtor /
// copy regen).  Bodies introduced via GenDecl can call into
// existing module funcs and use already-known managed types;
// introducing a brand-new managed-type dtor requirement isn't
// yet handled (would need dedup-aware regeneration of dtors /
// copies).
//
// Caller must have already initialized the surrounding module
// state (currentModulePkgShort, moduleStructs, moduleConsts,
// moduleGlobals, moduleFuncs) via a prior GenModule /
// GeneratePackage call on the REPL session module.
func GenDecl(d @ast.Decl, m @Module) @[]char {
	if d == nil {
		return "GenDecl: nil decl"
	}
	if d.Kind == ast.DECL_CONST {
		genConst(d)
		return ""
	}
	if d.Kind == ast.DECL_GROUP {
		// Accept const-only groups; reject anything else.
		for i := 0; i < len(d.Decls); i++ {
			if d.Decls[i].Kind != ast.DECL_CONST {
				return "only const groups are supported at the prompt"
			}
		}
		genConstGroup(d)
		return ""
	}
	if d.Kind == ast.DECL_VAR {
		var typ @types.Type = resolveGlobalVarType(d)
		if typ == nil {
			return "var decl at the prompt requires an explicit type or a literal initializer"
		}
		var mg ModuleGlobal
		mg.Name = buf.CopyStr(d.Name)
		mg.Typ = typ
		moduleGlobals = appendModuleGlobal(moduleGlobals, mg)
		var g @Global = make(Global)
		g.Name = mg.Name
		g.Typ = mg.Typ
		AddGlobal(m, g)
		return ""
	}
	if d.Kind != ast.DECL_FUNC {
		return "only func, const, and var declarations are supported at the prompt (Tier 2)"
	}
	if d.Recv != nil {
		return "method declarations are not yet supported at the prompt"
	}
	// Register signature in moduleFuncs so that subsequent IR
	// gen of other code can resolve calls to this func.  Qualify
	// the name (matching GeneratePackage's storage convention) so
	// FIRST-match `lookupFunc*` paths find this entry, and so that
	// re-typing the same func updates an existing entry in place
	// rather than appending a duplicate.
	var sig FuncSig
	sig.Name = qualifyForCurrentModule(buf.CopyStr(d.Name))
	var sigParams @[]@types.Type
	for j := 0; j < len(d.Params); j++ {
		sigParams = appendTypePtr(sigParams,
			resolveTypeExpr(d.Params[j].Type))
	}
	sig.Params = sigParams
	var sigResults @[]@types.Type
	for j := 0; j < len(d.Results); j++ {
		sigResults = appendTypePtr(sigResults,
			resolveTypeExpr(d.Results[j]))
	}
	sig.Results = sigResults
	if len(sigResults) > 1 {
		sig.MultiReturnType = makeMultiReturnStructType(sigResults)
	}
	setOrAppendFuncSig(sig)

	// Generate body and add to the module.  AddFunc unconditionally
	// appends; on redefinition this leaves a stale @Func in m.Funcs
	// (harmless — only the @Func passed to LowerOneFunc gets
	// re-lowered, and `vm.Funcs` is rebound in place by name).
	AddFunc(m, genFunc(d))
	return ""
}

// GenSyntheticFunc wraps a stmt list as a no-arg, no-result IR
// function and returns it.  REPL entry point: a stmt list typed at
// the prompt is wrapped as `func <name>() { <stmts> }` and IR-gen'd
// via the existing genFunc path, ready to be appended to a module
// (with AddFunc) and lowered.
//
// Caller must have already initialized the surrounding module
// state (currentModulePkgShort, moduleStructs, moduleConsts,
// moduleGlobals) via a prior GenModule / GeneratePackage on the
// REPL session module — the synthetic function is generated in
// that module's context so it can refer to its decls.
func GenSyntheticFunc(name @[]char, body @[]@ast.Stmt) @Func {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Name = name
	var bodyBlock @ast.Stmt = make(ast.Stmt)
	bodyBlock.Kind = ast.STMT_BLOCK
	bodyBlock.Stmts = body
	d.Body = bodyBlock
	return genFunc(d)
}
