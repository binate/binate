package "pkg/ir"

import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/types"

// Tests for STMT_RETURN lowering (gen_return.bn).
// Uses helpers (genFromSource, findFunc, fail) from ir_test.bn.

func TestReturnStringAsManagedSlice() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc greet() @[]char {\n\treturn \"hello\"\n}\n"
	var m @Module = genFromSource(src)
	if len(m.Funcs) < 1 { return fail("expected at least 1 func") }
	var f @Func = m.Funcs[0]
	if len(f.Results) == 0 {
		return fail("expected return type")
	}
	if f.Results[0].Kind != types.TYP_MANAGED_SLICE {
		return fail("expected managed-slice return type")
	}
	var found bool = false
	for i := 0; i < len(f.Blocks); i++ {
		for j := 0; j < len(f.Blocks[i].Instrs); j++ {
			if f.Blocks[i].Instrs[j].Op == OP_RODATA_MSLICE_COPY {
				found = true
			}
		}
	}
	if !found { return fail("expected OP_RODATA_MSLICE_COPY instruction") }
	return ""
}

// `return f()` for a multi-return outer should lower to one OP_CALL
// + one OP_EXTRACT per result + one OP_RETURN. The existing per-expr
// path emits one expression-evaluation per result, so the EmitExtract
// shape is the witness that the multi-return-call branch was taken.
func TestGenReturnMultiCallEmitsExtracts() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("package \"test\"\n")
	b = b.WriteStr("func f() (int, bool) { return 1, true }\n")
	b = b.WriteStr("func g() (int, bool) { return f() }\n")
	var src @[]char = b.Bytes()
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "g")
	if fn == nil { return fail("expected g func") }
	var nCalls int = 0
	var nExtracts int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op == OP_CALL { nCalls = nCalls + 1 }
			if ins.Op == OP_EXTRACT { nExtracts = nExtracts + 1 }
		}
	}
	if nCalls != 1 { return fail("expected exactly 1 OP_CALL") }
	if nExtracts != 2 { return fail("expected exactly 2 OP_EXTRACT") }
	return ""
}
