package "pkg/ir"

import "pkg/buf"
import "pkg/builtins/testing"

// genShortVar coverage.  The function is also exercised end-to-end
// by gen_control_test.bn and the conformance suite — these unit
// tests pin the IR-shape decisions that the function makes on its
// own.

// TestGenShortVarSingleAllocates verifies the single-binding form
// (x := <expr>) lowers to OP_ALLOC + OP_STORE for the new local.
func TestGenShortVarSingleAllocates() testing.TestResult {
	var m @Module = genFromSource(
		"package \"test\"\nfunc main() { x := 42; _ = x }\n")
	if len(m.Funcs) < 1 { return fail("no funcs") }
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundAlloc bool = false
	var foundStore bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == OP_ALLOC { foundAlloc = true }
		if entry.Instrs[i].Op == OP_STORE { foundStore = true }
	}
	if !foundAlloc { return fail("x := 42 should allocate a slot") }
	if !foundStore { return fail("x := 42 should store the RHS") }
	return ""
}

// TestGenShortVarBlankSkipsAlloc verifies the blank-LHS form
// (`_ := <expr>`) evaluates the RHS for side effects but doesn't
// allocate a name slot.
func TestGenShortVarBlankSkipsAlloc() testing.TestResult {
	var m @Module = genFromSource(
		"package \"test\"\nfunc f() int { return 7 }\nfunc main() { _ := f() }\n")
	if len(m.Funcs) < 2 { return fail("missing funcs") }
	// main is the second func (f is the first).
	var entry @Block = m.Funcs[1].Blocks[0]
	var foundCall bool = false
	var allocCount int = 0
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == OP_CALL { foundCall = true }
		if entry.Instrs[i].Op == OP_ALLOC { allocCount = allocCount + 1 }
	}
	if !foundCall { return fail("blank := RHS should still be called") }
	if allocCount != 0 {
		return fail("blank LHS should not allocate a slot")
	}
	return ""
}

// TestGenShortVarMultiExtracts verifies the multi-binding form
// (q, r := call(...)) emits OP_EXTRACT for each component of the
// callee's anonymous return struct.
func TestGenShortVarMultiExtracts() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f() (int, int) { return 1, 2 }\n")
	cb = cb.WriteStr("func main() { q, r := f(); _ = q; _ = r }\n")
	var m @Module = genFromSource(cb.Bytes())
	if len(m.Funcs) < 2 { return fail("missing funcs") }
	var entry @Block = m.Funcs[1].Blocks[0]
	var extractCount int = 0
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == OP_EXTRACT { extractCount = extractCount + 1 }
	}
	if extractCount < 2 {
		return fail("q, r := f() should emit 2 OP_EXTRACT instrs")
	}
	return ""
}
