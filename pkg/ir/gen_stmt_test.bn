package "pkg/ir"

import "pkg/ast"
import "pkg/bootstrap"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/parser"
import "pkg/types"

func TestBuildAddFunc() testing.TestResult {
	// Build: func add(a int, b int) int { return a + b }
	var f @Func = NewFunc("add", noParams, noResults)
	var pa @Param = NewParam(f, "a", types.TypInt())
	var pb @Param = NewParam(f, "b", types.TypInt())
	var params @[]@Param = make_slice(@Param, 2)
	params[0] = pa
	params[1] = pb
	f.Params = params
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	f.Results = results

	var entry @Block = AddBlock(f, "entry")

	// Alloca approach: allocate slots for params, store, then load
	var aPtr @Instr = entry.EmitAlloc(types.TypInt())
	var bPtr @Instr = entry.EmitAlloc(types.TypInt())

	// Store params (using const as stand-in since we can't reference params as Instr)
	var aVal @Instr = entry.EmitConstInt(0, types.TypInt()) // placeholder
	var bVal @Instr = entry.EmitConstInt(0, types.TypInt()) // placeholder
	entry.EmitStore(aPtr, aVal)
	entry.EmitStore(bPtr, bVal)

	// Load and add
	var a @Instr = entry.EmitLoad(aPtr, types.TypInt())
	var b_ @Instr = entry.EmitLoad(bPtr, types.TypInt())
	var sum @Instr = entry.EmitBinop(OP_ADD, a, b_, types.TypInt())

	// Return
	var retArgs @[]@Instr = make_slice(@Instr, 1)
	retArgs[0] = sum
	entry.EmitReturn(retArgs)

	// Verify structure
	if len(f.Blocks) != 1 { return fail("expected 1 block") }
	// 2 allocs + 2 consts + 2 stores + 2 loads + 1 add + 1 return = 10
	var nInstrs int = len(entry.Instrs)
	if nInstrs != 10 {
		return fail(bootstrap.Concat(
			"expected 10 instrs, got ",
			bootstrap.Itoa(nInstrs)))
	}
	// Last instr should be return (terminator)
	var lastInstr @Instr = entry.Instrs[len(entry.Instrs)-1]
	if !lastInstr.IsTerminator() {
		return fail("last instr should be terminator")
	}

	return ""
}

func TestBuildIfElse() testing.TestResult {
	// Build: func f(x int) int { if x > 0 { return 1 } else { return 0 } }
	var f @Func = NewFunc("f", noParams, noResults)

	var entry @Block = AddBlock(f, "entry")
	var thenBlk @Block = AddBlock(f, "if.then")
	var elseBlk @Block = AddBlock(f, "if.else")

	// Condition
	var x @Instr = entry.EmitConstInt(5, types.TypInt())
	var zero @Instr = entry.EmitConstInt(0, types.TypInt())
	var cond @Instr = entry.EmitBinop(OP_GT, x, zero, types.TypBool())
	entry.EmitBranch(cond, thenBlk, elseBlk)

	// Then
	var one @Instr = thenBlk.EmitConstInt(1, types.TypInt())
	var retOne @[]@Instr = make_slice(@Instr, 1)
	retOne[0] = one
	thenBlk.EmitReturn(retOne)

	// Else
	var z @Instr = elseBlk.EmitConstInt(0, types.TypInt())
	var retZ @[]@Instr = make_slice(@Instr, 1)
	retZ[0] = z
	elseBlk.EmitReturn(retZ)

	if len(f.Blocks) != 3 { return fail("expected 3 blocks") }
	if !entry.Instrs[len(entry.Instrs)-1].IsTerminator() { return fail("entry not terminated") }
	if !thenBlk.Instrs[len(thenBlk.Instrs)-1].IsTerminator() { return fail("then not terminated") }
	if !elseBlk.Instrs[len(elseBlk.Instrs)-1].IsTerminator() { return fail("else not terminated") }
	return ""
}

func TestGenHelloWorld() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("package \"test\"\n")
	b = b.WriteStr("func main() { println(\"hello\") }\n")
	var src @[]char = b.Bytes()
	var m @Module = genFromSource(src)
	if len(m.Funcs) != 1 {
		return fail(bootstrap.Concat(
			"expected 1 func, got ",
			bootstrap.Itoa(len(m.Funcs))))
	}
	if !seq(m.Funcs[0].Name, "test.main") {
		return fail("func name wrong")
	}
	if len(m.Funcs[0].Blocks) == 0 { return fail("no blocks") }
	// Should have instructions: const_string + scaffolding for
	// the bootstrap.Write call (alloc/store/load) for the string
	// literal, then again for the newline, then const_nil, return.
	// We only check that const_string fires; the surrounding shape
	// is validated by the conformance suite's println tests.
	var entry @Block = m.Funcs[0].Blocks[0]
	if len(entry.Instrs) < 4 {
		return fail(bootstrap.Concat(
			"too few instrs: ",
			bootstrap.Itoa(len(entry.Instrs))))
	}
	if entry.Instrs[0].Op != OP_CONST_STRING {
		return fail("first instr should be const_string")
	}
	return ""
}

func TestGenVariable() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func main() { var x int = 42; println(x) }\n")
	var m @Module = genFromSource(cb.Bytes())
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundAlloc bool = false
	var foundStore bool = false
	var foundLoad bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == OP_ALLOC { foundAlloc = true }
		if entry.Instrs[i].Op == OP_STORE { foundStore = true }
		if entry.Instrs[i].Op == OP_LOAD { foundLoad = true }
	}
	if !foundAlloc { return fail("no alloc") }
	if !foundStore { return fail("no store") }
	if !foundLoad { return fail("no load") }
	return ""
}

func TestGenPrintBoolExpr() testing.TestResult {
	// println(3 > 2) should dispatch through the bool path:
	// bootstrap.formatBool + bootstrap.Write (NOT formatInt). The
	// old bn_print_bool runtime shim is gone.
	var m @Module = genFromSource("package \"test\"\nfunc main() { println(3 > 2) }\n")
	var entry @Block = m.Funcs[0].Blocks[0]
	var foundFormatBool bool = false
	var foundFormatInt bool = false
	for i := 0; i < len(entry.Instrs); i++ {
		if entry.Instrs[i].Op == OP_CALL {
			if seq(entry.Instrs[i].StrVal, "bootstrap.formatBool") {
				foundFormatBool = true
			}
			if seq(entry.Instrs[i].StrVal, "bootstrap.formatInt") {
				foundFormatInt = true
			}
		}
	}
	if !foundFormatBool { return fail("comparison result should go through bootstrap.formatBool") }
	if foundFormatInt { return fail("bool result should NOT go through bootstrap.formatInt") }
	return ""
}

func TestGenRefcountOnManagedParam() testing.TestResult {
	// Function taking a managed pointer should inc on entry,
	// dec on exit
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Node struct { val int }\n")
	cb = cb.WriteStr("func use(n @Node) int {\n")
	cb = cb.WriteStr("\treturn n.val\n}\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar n @Node = make(Node)\n")
	cb = cb.WriteStr("\tprintln(use(n))\n}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	// Find the 'use' function
	var useFn @Func = nil
	for i := 0; i < len(m.Funcs); i++ {
		if seq(m.Funcs[i].Name, "test.use") {
			useFn = m.Funcs[i]
		}
	}
	if useFn == nil { return fail("expected 'use' function") }
	// Should have REFCOUNT_INC (param entry) and REFCOUNT_DEC (before return)
	var incCount int = countOp(useFn, OP_REFINC)
	var decCount int = countOp(useFn, OP_REFDEC)
	if incCount < 1 { return fail("expected REFCOUNT_INC for managed ptr param") }
	if decCount < 1 { return fail("expected REFCOUNT_DEC before return") }
	return ""
}

// `var p *T = &localStruct` must NOT reuse the struct's alloca as
// p's storage, since p's declared type (TYP_POINTER) differs from
// the alloca's TypeArg (TYP_STRUCT). Otherwise p aliases it, and
// reading p loads the first word of it rather than a pointer.
// Asserts that a distinct OP_ALLOC exists with TypeArg = TYP_POINTER.
func TestVarDeclRawPtrFromAddrOfDoesNotReuseAlloca() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Item struct { Val int }\n")
	cb = cb.WriteStr("func build() {\n")
	cb = cb.WriteStr("\tvar it Item\n")
	cb = cb.WriteStr("\tvar p *Item = &it\n")
	cb = cb.WriteStr("}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "build")
	if fn == nil { return fail("expected build func") }
	// There must be a pointer-typed alloca (for p) distinct from the
	// struct alloca (for it).
	var foundStructAlloc bool = false
	var foundPtrAlloc bool = false
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op != OP_ALLOC { continue }
			if ins.TypeArg == nil { continue }
			if ins.TypeArg.Kind == types.TYP_STRUCT {
				foundStructAlloc = true
			}
			if ins.TypeArg.Kind == types.TYP_POINTER {
				foundPtrAlloc = true
			}
		}
	}
	if !foundStructAlloc { return fail("expected struct alloca for it") }
	if !foundPtrAlloc { return fail("expected pointer alloca for p (not reused from it)") }
	return ""
}

// Sanity: the composite-literal reuse optimization still fires for
// `var x Foo = Foo{...}` — both kinds match (TYP_STRUCT == TYP_STRUCT)
// so the alloca is reused and there should be only one struct alloca.
func TestVarDeclStructCompositeLitReusesAlloca() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Item struct { Val int }\n")
	cb = cb.WriteStr("func build() {\n")
	cb = cb.WriteStr("\tvar x Item = Item{Val: 7}\n")
	cb = cb.WriteStr("}\n")
	var src @[]char = cb.Bytes()
	var m @Module = genFromSource(src)
	var fn @Func = findFunc(m, "build")
	if fn == nil { return fail("expected build func") }
	var structAllocCount int = 0
	for i := 0; i < len(fn.Blocks); i++ {
		var blk @Block = fn.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @Instr = blk.Instrs[j]
			if ins.Op != OP_ALLOC { continue }
			if ins.TypeArg == nil { continue }
			if ins.TypeArg.Kind == types.TYP_STRUCT {
				structAllocCount = structAllocCount + 1
			}
		}
	}
	if structAllocCount != 1 {
		return fail(bootstrap.Concat(
			"expected exactly 1 struct alloca (reused), got ",
			bootstrap.Itoa(structAllocCount)))
	}
	return ""
}
