package "pkg/ir"

import "pkg/ast"
import "pkg/buf"
import "pkg/types"

// ============================================================
// String/int literal helpers (duplicated from interp since
// ir cannot import interp)
// ============================================================

// isBlank reports whether name is the blank identifier ("_").
func isBlank(name *[]const char) bool {
	return len(name) == 1 && name[0] == '_'
}

// streq compares two char slices for equality.
func streq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// buildQualName builds a qualified name "prefix.suffix" (e.g., "ast.File").
func buildQualName(prefix *[]const char, suffix *[]const char) @[]char {
	var qn buf.CharBuf = buf.New()
	qn = qn.WriteStr(prefix)
	qn = qn.WriteByte('.')
	qn = qn.WriteStr(suffix)
	return qn.Freeze()
}

// ============================================================
// Append helpers for module-level value types
// ============================================================

// appendModuleTypeAlias appends a type alias to the module-level alias list (O(n) copy).
func appendModuleTypeAlias(s @[]ModuleTypeAlias, v ModuleTypeAlias) @[]ModuleTypeAlias {
	var n int = len(s)
	var ns @[]ModuleTypeAlias = make_slice(ModuleTypeAlias, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendModuleConst appends a constant to the module-level constant list (O(n) copy).
func appendModuleConst(s @[]ModuleConst, v ModuleConst) @[]ModuleConst {
	var n int = len(s)
	var ns @[]ModuleConst = make_slice(ModuleConst, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendFuncSig appends a function signature to the module-level function list (O(n) copy).
func appendFuncSig(s @[]FuncSig, v FuncSig) @[]FuncSig {
	var n int = len(s)
	var ns @[]FuncSig = make_slice(FuncSig, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendModuleStruct appends a struct definition to the module-level struct list (O(n) copy).
func appendModuleStruct(s @[]ModuleStruct, v ModuleStruct) @[]ModuleStruct {
	var n int = len(s)
	var ns @[]ModuleStruct = make_slice(ModuleStruct, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendModuleGlobal appends a global variable to the module-level global list (O(n) copy).
func appendModuleGlobal(s @[]ModuleGlobal, v ModuleGlobal) @[]ModuleGlobal {
	var n int = len(s)
	var ns @[]ModuleGlobal = make_slice(ModuleGlobal, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendVarSlot appends a variable slot to the function's variable list (O(n) copy).
func appendVarSlot(s @[]VarSlot, v VarSlot) @[]VarSlot {
	var n int = len(s)
	var ns @[]VarSlot = make_slice(VarSlot, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// charEq compares two char slices for equality (same as streq).
func charEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// ============================================================
// Numeric and character literal parsing
// ============================================================

// parseIntLit parses an integer literal string (decimal, hex, octal, binary).
func parseIntLit(s *[]const char) int {
	if len(s) == 0 { return 0 }
	// Hex
	if len(s) > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X') {
		var val int = 0
		for i := 2; i < len(s); i++ {
			val = val * 16 + hexVal(s[i])
		}
		return val
	}
	// Octal: 0o17
	if len(s) > 2 && s[0] == '0' && (s[1] == 'o' || s[1] == 'O') {
		var val int = 0
		for i := 2; i < len(s); i++ {
			val = val * 8 + cast(int, s[i]) - cast(int, '0')
		}
		return val
	}
	// Binary: 0b1010
	if len(s) > 2 && s[0] == '0' && (s[1] == 'b' || s[1] == 'B') {
		var val int = 0
		for i := 2; i < len(s); i++ {
			val = val * 2 + cast(int, s[i]) - cast(int, '0')
		}
		return val
	}
	// Decimal
	var neg bool = false
	var start int = 0
	if s[0] == '-' {
		neg = true
		start = 1
	}
	var val int = 0
	for i := start; i < len(s); i++ {
		val = val * 10 + cast(int, s[i]) - cast(int, '0')
	}
	if neg { return 0 - val }
	return val
}

// bignumToInt converts a (magnitude, sign) pair from a bignum.Num
// (carried on Type.LitMag / LitSign by the type checker) into a
// host `int` for OP_CONST_INT.IntVal.  The two's-complement wrap
// handles the int64-min boundary correctly: cast(int, 2^63) wraps
// to int64-min as i64, and `0 - int64-min` wraps back to int64-min
// — the same trick formatInt64 uses to format the magnitude.  For
// magnitudes ≥ 2^63 + 1 with sign=true, the result is out of int64
// range; the type checker should reject before we get here.
func bignumToInt(mag uint64, sign bool) int {
	if sign {
		return 0 - cast(int, mag)
	}
	return cast(int, mag)
}

// exprIntLitValue returns the integer value of an EXPR_INT_LIT
// expression.  Prefers the type-checker's bignum-folded LitMag /
// LitSign on the resolved Type (more robust at the int64 /
// uint64 boundary than parseIntLit's signed-`int` arithmetic);
// falls back to parseIntLit when the checker isn't available
// (legacy test paths that skip type-check).
func exprIntLitValue(e @ast.Expr) int {
	if currentChecker != nil && e.ResolvedTypeID != 0 {
		var t @types.Type = currentChecker.ExprType(e.ResolvedTypeID)
		if t != nil && t.HasLitVal {
			return bignumToInt(t.LitMag, t.LitSign)
		}
	}
	return parseIntLit(e.Name)
}

// hexVal returns the numeric value of a hex digit character.
func hexVal(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	if c >= 'A' && c <= 'F' { return cast(int, c) - cast(int, 'A') + 10 }
	return 0
}

// parseCharLit parses a character literal (including escape sequences) to its integer value.
func parseCharLit(s *[]const char) int {
	// Strip quotes
	if len(s) >= 2 && s[0] == '\'' && s[len(s)-1] == '\'' {
		s = s[1:len(s)-1]
	}
	if len(s) == 0 { return 0 }
	if s[0] == '\\' && len(s) > 1 {
		if s[1] == 'n' { return 10 }
		if s[1] == 'r' { return 13 }
		if s[1] == 't' { return 9 }
		if s[1] == '\\' { return 92 }
		if s[1] == '\'' { return 39 }
		if s[1] == '0' { return 0 }
		if s[1] == 'x' && len(s) >= 4 {
			return hexVal(s[2]) * 16 + hexVal(s[3])
		}
		return cast(int, s[1])
	}
	return cast(int, s[0])
}

// unescapeStr strips surrounding quotes and processes escape sequences in a string literal.
func unescapeStr(s *[]const char) @[]char {
	// Strip quotes
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		s = s[1:len(s)-1]
	}
	var cb buf.CharBuf = buf.New()
	var i int = 0
	for i < len(s) {
		if s[i] == '\\' && i+1 < len(s) {
			i = i + 1
			if s[i] == 'n' { cb = cb.WriteByte('\n'); i = i + 1; continue }
			if s[i] == 'r' { cb = cb.WriteByte('\r'); i = i + 1; continue }
			if s[i] == 't' { cb = cb.WriteByte('\t'); i = i + 1; continue }
			if s[i] == '\\' { cb = cb.WriteByte('\\'); i = i + 1; continue }
			if s[i] == '"' { cb = cb.WriteByte('"'); i = i + 1; continue }
			if s[i] == '0' {
				cb = cb.WriteByte(cast(char, 0))
				i = i + 1
				continue
			}
			if s[i] == 'x' && i+2 < len(s) {
				var hi int = hexVal(s[i+1])
				var lo int = hexVal(s[i+2])
				cb = cb.WriteByte(cast(char, hi*16 + lo))
				i = i + 3
				continue
			}
			cb = cb.WriteByte(s[i])
			i = i + 1
		} else {
			cb = cb.WriteByte(s[i])
			i = i + 1
		}
	}
	return cb.Bytes()
}
