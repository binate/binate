package "pkg/ir"

import "pkg/types"

// ============================================================
// Slices & arrays
// ============================================================

// EmitSliceLen extracts the length field from a slice value.
func EmitSliceLen(f @Func, b @Block, slice @Instr) @Instr {
	// Lower to primitive: extract len field (field 1) from slice struct.
	return EmitExtract(f, b, slice, 1, types.TypInt())
}

// EmitSliceGet loads an element from a slice at the given index.
func EmitSliceGet(f @Func, b @Block, slice @Instr, index @Instr, elemTyp @types.Type) @Instr {
	// Lower to primitives: extract data ptr (i8*), GEP by index, load.
	// The codegen's GEP handler bitcasts i8* to *elemType automatically.
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @Instr = EmitExtract(f, b, slice, 0, rawPtrTyp)
	var elemPtr @Instr = EmitGetElemPtr(f, b, dataPtr, index, elemTyp)
	return EmitLoad(f, b, elemPtr, elemTyp)
}

// EmitSliceSet stores a value into a slice element at the given index.
func EmitSliceSet(f @Func, b @Block, slice @Instr, index @Instr, val @Instr, elemTyp @types.Type) {
	// Lower to primitives: extract data ptr, GEP by index, store.
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @Instr = EmitExtract(f, b, slice, 0, rawPtrTyp)
	var elemPtr @Instr = EmitGetElemPtr(f, b, dataPtr, index, elemTyp)
	EmitStore(b, elemPtr, val)
}

// EmitSliceElemPtr returns a pointer to a slice element (no load).
func EmitSliceElemPtr(f @Func, b @Block, slice @Instr, index @Instr, elemTyp @types.Type) @Instr {
	// Lower to primitives: extract data ptr, GEP by index (returns pointer, no load).
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @Instr = EmitExtract(f, b, slice, 0, rawPtrTyp)
	return EmitGetElemPtr(f, b, dataPtr, index, elemTyp)
}

// EmitSliceExpr emits a subslice operation (s[lo:hi]) as a zero-copy view adjustment.
func EmitSliceExpr(f @Func, b @Block, slice @Instr, lo @Instr, hi @Instr, typ @types.Type) @Instr {
	// Lower to primitives: zero-copy view adjustment.
	// Raw slice result: {data + lo * elemSize, hi - lo}
	// Managed slice result: {data + lo * elemSize, hi - lo, refptr, backingLen}
	var rawPtrTyp @types.Type = types.MakePointerType(types.TypUint8())
	var dataPtr @Instr = EmitExtract(f, b, slice, 0, rawPtrTyp)

	// Compute new data pointer: data + lo * elemSize (byte-level GEP on i8*).
	// We use byte arithmetic to avoid LLVM type mismatches — the codegen's
	// GEP handler for raw pointers emits an internal bitcast that produces a
	// typed pointer (e.g., i64*), but slice field 0 expects i8*.
	var elemTyp @types.Type = typ.Elem
	var elemSize @Instr = EmitConstInt(f, b, types.SizeOf(elemTyp), types.TypInt())
	var byteOffset @Instr = EmitBinop(f, b, OP_MUL, lo, elemSize, types.TypInt())
	var newData @Instr = EmitGetElemPtr(f, b, dataPtr, byteOffset, types.TypUint8())

	// Compute new length: hi - lo
	var newLen @Instr = EmitBinop(f, b, OP_SUB, hi, lo, types.TypInt())

	// Build result slice via alloca + field stores + load
	var sliceAlloca @Instr = EmitAlloc(f, b, typ)
	var f0 @Instr = EmitGetFieldPtr(f, b, sliceAlloca, 0, rawPtrTyp)
	EmitStore(b, f0, newData)
	var f1 @Instr = EmitGetFieldPtr(f, b, sliceAlloca, 1, types.TypInt())
	EmitStore(b, f1, newLen)

	if typ.Kind == types.TYP_MANAGED_SLICE {
		// Preserve backing refptr and backingLen from original
		var refptr @Instr = EmitExtract(f, b, slice, 2, rawPtrTyp)
		var backingLen @Instr = EmitExtract(f, b, slice, 3, types.TypInt())
		var f2 @Instr = EmitGetFieldPtr(f, b, sliceAlloca, 2, rawPtrTyp)
		EmitStore(b, f2, refptr)
		var f3 @Instr = EmitGetFieldPtr(f, b, sliceAlloca, 3, types.TypInt())
		EmitStore(b, f3, backingLen)
	}

	return EmitLoad(f, b, sliceAlloca, typ)
}

// EmitBoundsCheck emits a runtime bounds check that panics if index >= length.
func EmitBoundsCheck(b @Block, index @Instr, length @Instr) {
	var instr @Instr = newVoidInstr(OP_BOUNDS_CHECK)
	instr.Args = makeArgs2(index, length)
	addInstr(b, instr)
}


// ============================================================
// Strings
// ============================================================

// EmitStringToChars converts a string constant to a char slice
// (*[]const char, @[]char, or @[]const char). Phase 3.2 dispatch:
//
//   read-only managed-slice target (`@[]const char`)
//     → OP_RODATA_MSLICE   (zero-copy alias of static global)
//   read-only raw-slice target (`*[]const char`)
//     → OP_RODATA_SLICE    (zero-copy alias of {data, len} prefix)
//   mutable managed-slice target (`@[]char`, Stage 2b)
//     → OP_RODATA_MSLICE_COPY  (alloc + memcpy from static global)
//
// All three ops are non-string-specific; the same lowering applies
// to user-written const-byte composite literals (3.1).
func EmitStringToChars(f @Func, b @Block, str @Instr, sliceTyp @types.Type) @Instr {
	if stringToCharsNeedsImplicitCopy(sliceTyp) {
		return EmitRodataMSliceCopy(f, b, str.StrVal, sliceTyp)
	}
	var resolved @types.Type = sliceTyp
	for resolved != nil && resolved.Kind == types.TYP_ALIAS {
		resolved = resolved.Target
	}
	if resolved != nil && resolved.Kind == types.TYP_CONST {
		resolved = resolved.Elem
	}
	for resolved != nil && resolved.Kind == types.TYP_ALIAS {
		resolved = resolved.Target
	}
	if resolved != nil && resolved.Kind == types.TYP_MANAGED_SLICE {
		return EmitRodataMSlice(f, b, str.StrVal, sliceTyp)
	}
	return EmitRodataSlice(f, b, str.StrVal, sliceTyp)
}

// stringToCharsNeedsImplicitCopy reports whether a string → slice
// conversion with target `sliceTyp` must allocate a fresh managed
// backing and memcpy the bytes in (Stage 2b rule for `@[]char`).
// Alias-the-static-global is correct for every other target:
//   *[]const char   : caller can only read, rodata is fine.
//   @[]char         : OWNED + MUTABLE; alias would let a write
//                     target the rodata page → copy.
//   @[]const char   : caller can only read, rodata is fine.
func stringToCharsNeedsImplicitCopy(sliceTyp @types.Type) bool {
	if sliceTyp == nil { return false }
	for sliceTyp != nil && sliceTyp.Kind == types.TYP_ALIAS {
		sliceTyp = sliceTyp.Target
	}
	if sliceTyp == nil { return false }
	// Outer const: permissive wrt capability — the holder is const.
	if sliceTyp.Kind == types.TYP_CONST {
		return stringToCharsNeedsImplicitCopy(sliceTyp.Elem)
	}
	// Only managed-slices get the implicit copy; raw slices must
	// already be *[]const char by Stage 2a (ratchet), so no copy.
	if sliceTyp.Kind != types.TYP_MANAGED_SLICE { return false }
	var elem @types.Type = sliceTyp.Elem
	for elem != nil && elem.Kind == types.TYP_ALIAS { elem = elem.Target }
	if elem == nil { return false }
	// Element const → caller can only read → alias is fine.
	if elem.Kind == types.TYP_CONST { return false }
	// @[]char with a plain char element → needs copy.
	return true
}

// EmitRodataMSlice emits a managed-slice composite literal that aliases
// a static rodata global. Used when the entire literal is compile-time
// constant bytes and the target is `@[]const T` (read-only view —
// aliasing rodata is sound). `bytes` is the byte sequence to embed.
func EmitRodataMSlice(f @Func, b @Block, bytes @[]char, sliceTyp @types.Type) @Instr {
	var instr @Instr = newInstr(f, OP_RODATA_MSLICE, sliceTyp)
	instr.StrVal = bytes
	addInstr(b, instr)
	return instr
}

// EmitRodataSlice emits a raw-slice composite literal aliasing a static
// rodata global. Same byte-sequence shape as EmitRodataMSlice; codegen
// extracts the {data, len} prefix into a `*[]const T` value.
func EmitRodataSlice(f @Func, b @Block, bytes @[]char, sliceTyp @types.Type) @Instr {
	var instr @Instr = newInstr(f, OP_RODATA_SLICE, sliceTyp)
	instr.StrVal = bytes
	addInstr(b, instr)
	return instr
}

// EmitRodataArray emits an array literal initialized from rodata
// bytes. Allocates an `[N]T` buffer (size from arrayTyp.ArrayLen),
// memcpys `min(len(bytes), N)` bytes from a static global, and
// zero-pads the tail. Result is the array value (codegen materializes
// it through an alloca + memcpy + load).
func EmitRodataArray(f @Func, b @Block, bytes @[]char, arrayTyp @types.Type) @Instr {
	var instr @Instr = newInstr(f, OP_RODATA_ARRAY, arrayTyp)
	instr.StrVal = bytes
	addInstr(b, instr)
	return instr
}

// EmitRodataMSliceCopy emits a managed-slice that owns a fresh copy
// of `bytes`: MakeManagedSlice(elemSize=1, len=N) + memcpy from the
// static rodata global. Refcount 1, independent of rodata. Used for
// `@[]char = "..."` (Stage 2b implicit copy) and any mutable
// managed-slice composite literal whose elements are compile-time
// const bytes.
func EmitRodataMSliceCopy(f @Func, b @Block, bytes @[]char, sliceTyp @types.Type) @Instr {
	var instr @Instr = newInstr(f, OP_RODATA_MSLICE_COPY, sliceTyp)
	instr.StrVal = bytes
	addInstr(b, instr)
	return instr
}

// ============================================================
// Control flow
// ============================================================

// EmitJump emits an unconditional branch to the target block.
func EmitJump(b @Block, target @Block) {
	var instr @Instr = newVoidInstr(OP_JUMP)
	instr.Block1 = target
	addInstr(b, instr)
}

// EmitBranch emits a conditional branch on cond to then/else blocks.
func EmitBranch(b @Block, cond @Instr, thenBlk @Block, elseBlk @Block) {
	var instr @Instr = newVoidInstr(OP_BRANCH)
	instr.Args = makeArgs1(cond)
	instr.Block1 = thenBlk
	instr.Block2 = elseBlk
	addInstr(b, instr)
}

// EmitReturn emits a return instruction with the given values.
func EmitReturn(b @Block, vals @[]@Instr) {
	var instr @Instr = newVoidInstr(OP_RETURN)
	instr.Args = vals
	addInstr(b, instr)
}

// EmitReturnTyped emits a return with an explicit multi-return struct type.
func EmitReturnTyped(b @Block, vals @[]@Instr, retTyp @types.Type) {
	var instr @Instr = newVoidInstr(OP_RETURN)
	instr.Args = vals
	instr.Typ = retTyp
	addInstr(b, instr)
}

// EmitPanic emits a panic instruction with a message string.
func EmitPanic(b @Block, msg @Instr) {
	var instr @Instr = newVoidInstr(OP_PANIC)
	instr.Args = makeArgs1(msg)
	addInstr(b, instr)
}

// EmitUnreachable emits an unreachable terminator (marks dead code paths).
func EmitUnreachable(b @Block) {
	var instr @Instr = newVoidInstr(OP_UNREACHABLE)
	addInstr(b, instr)
}

// ============================================================
// SSA
// ============================================================

// EmitPhi emits a phi node that merges values from different predecessor blocks.
func EmitPhi(f @Func, b @Block, typ @types.Type, entries @[]PhiEntry) @Instr {
	var instr @Instr = newInstr(f, OP_PHI, typ)
	instr.Phis = entries
	addInstr(b, instr)
	return instr
}

// ============================================================
// Calls
// ============================================================

// EmitCall emits a direct function call by name with the given arguments.
// Normalizes `name` through qualifyForCurrentModule so call sites see a
// fully-qualified name in instr.StrVal regardless of whether the caller
// passed a bare or qualified form. Backends can rely on the qualified
// form alone — no need to combine with their own modulePkgName state.
func EmitCall(f @Func, b @Block, name @[]char, args @[]@Instr, resultTyp @types.Type) @Instr {
	var instr @Instr = newInstr(f, OP_CALL, resultTyp)
	instr.StrVal = qualifyForCurrentModule(name)
	instr.Args = args
	addInstr(b, instr)
	return instr
}

// EmitCallIndirect emits an indirect function call through fnPtr.
// fnPtr must have type *uint8 (the canonical raw-function-pointer type).
// The signature is reconstructed from resultTyp (return type) and the
// argument operands' types — each arg Instr carries its Typ. The result
// Instr's Args layout is `[fnPtr, args...]`.
func EmitCallIndirect(f @Func, b @Block, fnPtr @Instr,
		args @[]@Instr, resultTyp @types.Type) @Instr {
	var instr @Instr = newInstr(f, OP_CALL_INDIRECT, resultTyp)
	var combined @[]@Instr = make_slice(@Instr, len(args) + 1)
	combined[0] = fnPtr
	for i := 0; i < len(args); i++ {
		combined[i + 1] = args[i]
	}
	instr.Args = combined
	addInstr(b, instr)
	return instr
}

// EmitFuncValue emits a function-value construction op for a named
// function. resultTyp must be TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE
// (the destination's declared type, since the construction is
// type-driven). The function name is stored on StrVal — qualified
// `pkg.name` for cross-package, bare for same-package.
func EmitFuncValue(f @Func, b @Block, name @[]char,
		resultTyp @types.Type) @Instr {
	var instr @Instr = newInstr(f, OP_FUNC_VALUE, resultTyp)
	instr.StrVal = qualifyForCurrentModule(name)
	addInstr(b, instr)
	return instr
}

// EmitCallFuncValue emits a call through a function value. fnVal must
// be of type TYP_FUNC_VALUE or TYP_MANAGED_FUNC_VALUE. The Args layout
// on the resulting Instr is `[fnVal, args...]`; resultTyp is the
// return type (from fnVal.Typ.Results).
func EmitCallFuncValue(f @Func, b @Block, fnVal @Instr,
		args @[]@Instr, resultTyp @types.Type) @Instr {
	var instr @Instr = newInstr(f, OP_CALL_FUNC_VALUE, resultTyp)
	var combined @[]@Instr = make_slice(@Instr, len(args) + 1)
	combined[0] = fnVal
	for i := 0; i < len(args); i++ {
		combined[i + 1] = args[i]
	}
	instr.Args = combined
	addInstr(b, instr)
	return instr
}

// ============================================================
// Conversions
// ============================================================

// EmitCast emits a type cast (sign/zero extend, truncate).
func EmitCast(f @Func, b @Block, val @Instr, targetTyp @types.Type) @Instr {
	targetTyp = stripConstForIR(targetTyp)
	var instr @Instr = newInstr(f, OP_CAST, targetTyp)
	instr.Args = makeArgs1(val)
	instr.TypeArg = targetTyp
	addInstr(b, instr)
	return instr
}

// EmitBitCast emits a bitwise reinterpret cast (no value change, type only).
func EmitBitCast(f @Func, b @Block, val @Instr, targetTyp @types.Type) @Instr {
	targetTyp = stripConstForIR(targetTyp)
	var instr @Instr = newInstr(f, OP_BIT_CAST, targetTyp)
	instr.Args = makeArgs1(val)
	instr.TypeArg = targetTyp
	addInstr(b, instr)
	return instr
}

// EmitFuncAddr emits the address of a named function as an i8* value.
func EmitFuncAddr(f @Func, b @Block, funcName @[]char) @Instr {
	var instr @Instr = newInstr(f, OP_FUNC_ADDR, types.MakePointerType(types.TypUint8()))
	instr.StrVal = qualifyForCurrentModule(funcName)
	addInstr(b, instr)
	return instr
}

// EmitManagedToRaw converts a managed-slice (@[]T) to a raw slice (*[]T).
func EmitManagedToRaw(f @Func, b @Block, val @Instr) @Instr {
	// @[]T → *[]T: extract {data, len} prefix
	var rawTyp @types.Type = types.MakeSliceType(val.Typ.Elem)
	var instr @Instr = newInstr(f, OP_MANAGED_TO_RAW, rawTyp)
	instr.Args = makeArgs1(val)
	addInstr(b, instr)
	return instr
}

// ============================================================
// Struct
// ============================================================

// EmitStructLit emits a struct literal value from field values.
func EmitStructLit(f @Func, b @Block, fields @[]@Instr, structTyp @types.Type) @Instr {
	structTyp = stripConstForIR(structTyp)
	var instr @Instr = newInstr(f, OP_STRUCT_LIT, structTyp)
	instr.Args = fields
	instr.TypeArg = structTyp
	addInstr(b, instr)
	return instr
}

// EmitExtract extracts a field from a struct/multi-return value by index.
func EmitExtract(f @Func, b @Block, multi @Instr, index int, typ @types.Type) @Instr {
	var instr @Instr = newInstr(f, OP_EXTRACT, typ)
	instr.Args = makeArgs1(multi)
	instr.Index = index
	addInstr(b, instr)
	return instr
}

// ============================================================
// Helpers
// ============================================================

// OpName returns the human-readable name for an IR opcode.
func OpName(op int) *[]const char {
	if op == OP_CONST_INT { return "const_int" }
	if op == OP_CONST_BOOL { return "const_bool" }
	if op == OP_CONST_STRING { return "const_string" }
	if op == OP_CONST_NIL { return "const_nil" }
	if op == OP_ADD { return "add" }
	if op == OP_SUB { return "sub" }
	if op == OP_MUL { return "mul" }
	if op == OP_DIV { return "div" }
	if op == OP_REM { return "rem" }
	if op == OP_AND { return "and" }
	if op == OP_OR { return "or" }
	if op == OP_XOR { return "xor" }
	if op == OP_SHL { return "shl" }
	if op == OP_SHR { return "shr" }
	if op == OP_EQ { return "eq" }
	if op == OP_NE { return "ne" }
	if op == OP_LT { return "lt" }
	if op == OP_LE { return "le" }
	if op == OP_GT { return "gt" }
	if op == OP_GE { return "ge" }
	if op == OP_LAND { return "land" }
	if op == OP_LOR { return "lor" }
	if op == OP_NEG { return "neg" }
	if op == OP_NOT { return "not" }
	if op == OP_BITNOT { return "bitnot" }
	if op == OP_ALLOC { return "alloc" }
	if op == OP_LOAD { return "load" }
	if op == OP_STORE { return "store" }
	if op == OP_GET_FIELD_PTR { return "get_field_ptr" }
	if op == OP_GET_ELEM_PTR { return "get_elem_ptr" }
	if op == OP_BOX { return "box" }
	if op == OP_MAKE { return "make" }
	if op == OP_MAKE_SLICE { return "make_slice" }
	if op == OP_DEREF { return "deref" }
	if op == OP_NIL_CHECK { return "nil_check" }
	if op == OP_REFINC { return "refinc" }
	if op == OP_REFDEC { return "refdec" }
	if op == OP_BOUNDS_CHECK { return "bounds_check" }
	if op == OP_RODATA_MSLICE { return "rodata_mslice" }
	if op == OP_RODATA_SLICE { return "rodata_slice" }
	if op == OP_RODATA_ARRAY { return "rodata_array" }
	if op == OP_RODATA_MSLICE_COPY { return "rodata_mslice_copy" }
	if op == OP_JUMP { return "jump" }
	if op == OP_BRANCH { return "branch" }
	if op == OP_RETURN { return "return" }
	if op == OP_PANIC { return "panic" }
	if op == OP_PHI { return "phi" }
	if op == OP_CALL { return "call" }
	if op == OP_CALL_INDIRECT { return "call_indirect" }
	if op == OP_FUNC_VALUE { return "func_value" }
	if op == OP_CALL_FUNC_VALUE { return "call_func_value" }
	if op == OP_CAST { return "cast" }
	if op == OP_BIT_CAST { return "bit_cast" }
	if op == OP_MANAGED_TO_RAW { return "managed_to_raw" }
	if op == OP_STRUCT_LIT { return "struct_lit" }
	if op == OP_EXTRACT { return "extract" }
	if op == OP_FUNC_ADDR { return "func_addr" }
	if op == OP_UNREACHABLE { return "unreachable" }
	return "unknown"
}

// IsTerminator returns true if the instruction ends a basic block (jump, branch, return, panic).
func IsTerminator(instr @Instr) bool {
	if instr.Op == OP_JUMP { return true }
	if instr.Op == OP_BRANCH { return true }
	if instr.Op == OP_RETURN { return true }
	if instr.Op == OP_PANIC { return true }
	if instr.Op == OP_UNREACHABLE { return true }
	return false
}
