package "pkg/ir"

import "pkg/types"

// ============================================================
// Interface-value ops (OP_IFACE_VALUE / OP_CALL_IFACE_METHOD /
// OP_IFACE_DTOR). Split out of ir_ops.bn alongside Slice 2.5b so
// that file stays close to its soft length limit.
// ============================================================

// EmitIfaceValue emits an interface-value construction. dataPtr is
// the source pointer being placed in the data slot (raw or managed —
// the IR layer treats it as i8*-shaped; codegen bitcasts to i8* at
// the construction site). vtableName is the mangled name of the
// `@__ivt.<...>` global selected at type-check time. resultTyp is
// TYP_INTERFACE_VALUE or TYP_INTERFACE_VALUE_MANAGED. Slice 2.3a-2
// of plan-interface-syntax-revision.md.
func (b @Block) EmitIfaceValue(dataPtr @Instr,
		vtableName @[]char, resultTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, OP_IFACE_VALUE, resultTyp)
	instr.StrVal = vtableName
	var args @[]@Instr = make_slice(@Instr, 1)
	args[0] = dataPtr
	instr.Args = args
	addInstr(b, instr)
	return instr
}

// EmitIfaceValue is the free-function shim for the @Block.EmitIfaceValue method.
func EmitIfaceValue(f @Func, b @Block, dataPtr @Instr,
		vtableName @[]char, resultTyp @types.Type) @Instr {
	return b.EmitIfaceValue(dataPtr, vtableName, resultTyp)
}

// EmitCallIfaceMethod emits an interface method dispatch. iv must be
// of type TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED.
// methodIdx is the 0-based slot in the interface's method-declaration
// order; resultTyp is the method's return type (TypVoid for void).
// Args layout on the resulting Instr: `[iv, args...]` — same shape
// as EmitCallFuncValue for symmetry. Slice 2.3a-3 of
// plan-interface-syntax-revision.md.
func (b @Block) EmitCallIfaceMethod(iv @Instr,
		args @[]@Instr, methodIdx int,
		resultTyp @types.Type) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, OP_CALL_IFACE_METHOD, resultTyp)
	instr.Index = methodIdx
	var combined @[]@Instr = make_slice(@Instr, len(args)+1)
	combined[0] = iv
	for i := 0; i < len(args); i++ {
		combined[i+1] = args[i]
	}
	instr.Args = combined
	addInstr(b, instr)
	return instr
}

// EmitCallIfaceMethod is the free-function shim for the @Block.EmitCallIfaceMethod method.
func EmitCallIfaceMethod(f @Func, b @Block, iv @Instr,
		args @[]@Instr, methodIdx int,
		resultTyp @types.Type) @Instr {
	return b.EmitCallIfaceMethod(iv, args, methodIdx, resultTyp)
}

// EmitIfaceDtor emits an OP_IFACE_DTOR that loads slot 0 of iv's
// vtable — the receiver type's struct destructor (or null / 0 if
// the type has no dtor). The result is a *uint8, matching
// EmitFuncAddr's shape, so it can be passed straight to
// EmitRefDecDtor for @Iface scope-exit cleanup. Slice 2.5b of
// plan-interface-syntax-revision.md.
func (b @Block) EmitIfaceDtor(iv @Instr) @Instr {
	var f *Func = b.Func
	var instr @Instr = newInstr(f, OP_IFACE_DTOR,
		types.MakePointerType(types.TypUint8()))
	instr.Args = makeArgs1(iv)
	addInstr(b, instr)
	return instr
}

// EmitIfaceDtor is the free-function shim for the @Block.EmitIfaceDtor method.
func EmitIfaceDtor(f @Func, b @Block, iv @Instr) @Instr {
	return b.EmitIfaceDtor(iv)
}
