package "pkg/ir"

// RuntimeFunc describes a C runtime function that generated code may call.
// These are not part of any Binate package — they're provided by the C runtime
// (binate_runtime.c) and declared in every compiled module.
//
// ParamKinds and RetKind use the RT_* constants below.

const (
	RT_VOID int = iota
	RT_INT         // target-sized int (i64 on 64-bit)
	RT_BOOL        // i1
	RT_PTR         // i8*
	RT_SLICE       // %BnSlice (2 words: ptr + len)
	RT_MSLICE      // %BnManagedSlice (4 words)
	RT_F64         // double (for printf-style float I/O)
)

// RuntimeFunc describes one C runtime function the compiler may need to
// declare or call: its symbol Name, the parameter kinds (RT_* values),
// the return kind, and whether a native backend may inline the call
// instead of going through the runtime symbol.
type RuntimeFunc struct {
	Name       @[]char
	ParamKinds @[]int
	RetKind    int
	Inlineable bool  // true if a native backend can inline this instead of calling
}

// RuntimeFuncs returns the list of all C runtime functions.
func RuntimeFuncs() @[]RuntimeFunc {
	var funcs @[]RuntimeFunc = make_slice(RuntimeFunc, 2)
	var i int = 0

	// I/O — only bn_print_float and bn_exit remain. The rest of
	// the bn_print_* shims were removed: print/println now lowers
	// at IR-gen time to bootstrap.formatX (where needed) +
	// bootstrap.Write. See pkg/ir/gen_expr.bn:genPrintCall.
	// %g float semantics are non-trivial to reproduce in pure
	// Binate, so bn_print_float is deferred.
	funcs[i] = makeRtFunc("bn_print_float", rtParams1(RT_F64), RT_VOID, false); i = i + 1
	funcs[i] = makeRtFunc("bn_exit", rtParams1(RT_INT), RT_VOID, false); i = i + 1

	return funcs
}

// makeRtFunc constructs a RuntimeFunc descriptor with the given signature.
func makeRtFunc(name @[]char, params @[]int, ret int, inlineable bool) RuntimeFunc {
	var f RuntimeFunc
	f.Name = name
	f.ParamKinds = params
	f.RetKind = ret
	f.Inlineable = inlineable
	return f
}

// rtParams0 builds an empty parameter kind list.
func rtParams0() @[]int {
	var p @[]int = make_slice(int, 0)
	return p
}

// rtParams1 builds a 1-element parameter kind list.
func rtParams1(a int) @[]int {
	var p @[]int = make_slice(int, 1)
	p[0] = a
	return p
}

// rtParams2 builds a 2-element parameter kind list.
func rtParams2(a int, b int) @[]int {
	var p @[]int = make_slice(int, 2)
	p[0] = a
	p[1] = b
	return p
}

// rtParams3 builds a 3-element parameter kind list.
func rtParams3(a int, b int, c int) @[]int {
	var p @[]int = make_slice(int, 3)
	p[0] = a
	p[1] = b
	p[2] = c
	return p
}

// rtParams4 builds a 4-element parameter kind list.
func rtParams4(a int, b int, c int, d int) @[]int {
	var p @[]int = make_slice(int, 4)
	p[0] = a
	p[1] = b
	p[2] = c
	p[3] = d
	return p
}
