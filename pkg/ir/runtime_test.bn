package "pkg/ir"

import "pkg/builtin/testing"

// ============================================================
// RuntimeFuncs tests
// ============================================================

func TestRuntimeFuncsEmpty() testing.TestResult {
	var funcs @[]RuntimeFunc = RuntimeFuncs()
	// Manifest is empty: bn_print_* migrated to bootstrap.formatX +
	// bootstrap.Write; bn_exit migrated to rt.Exit (OP_PANIC's LLVM
	// lowering). Anything pkg/rt or pkg/bootstrap exports gets its
	// own `declare` line through the import path.
	if len(funcs) != 0 {
		return fail("expected empty runtime manifest")
	}
	return ""
}
