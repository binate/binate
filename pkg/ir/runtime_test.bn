package "pkg/ir"

import "pkg/builtin/testing"

// ============================================================
// RuntimeFuncs tests
// ============================================================

func TestRuntimeFuncsCount() testing.TestResult {
	var funcs @[]RuntimeFunc = RuntimeFuncs()
	if len(funcs) != 7 {
		return fail("expected 7 runtime funcs")
	}
	return ""
}

func TestRuntimeFuncsFirstIsPrintString() testing.TestResult {
	var funcs @[]RuntimeFunc = RuntimeFuncs()
	if !charsEqual(funcs[0].Name, "bn_print_string") {
		return fail("first should be bn_print_string")
	}
	if len(funcs[0].ParamKinds) != 2 {
		return fail("expected 2 params")
	}
	if funcs[0].RetKind != RT_VOID {
		return fail("expected void return")
	}
	return ""
}

func TestRuntimeFuncsExit() testing.TestResult {
	var funcs @[]RuntimeFunc = RuntimeFuncs()
	// bn_exit is last — order is: print_string, print_int, print_bool,
	// print_float, print_newline, print_chars, exit.
	if !charsEqual(funcs[6].Name, "bn_exit") {
		return fail("expected bn_exit at index 6")
	}
	return ""
}

func TestRuntimeFuncsPrintFloat() testing.TestResult {
	var funcs @[]RuntimeFunc = RuntimeFuncs()
	// print_float is at index 3 (between print_bool and print_newline).
	if !charsEqual(funcs[3].Name, "bn_print_float") {
		return fail("expected bn_print_float at index 3")
	}
	if len(funcs[3].ParamKinds) != 1 {
		return fail("expected 1 param")
	}
	if funcs[3].ParamKinds[0] != RT_F64 {
		return fail("expected RT_F64 param kind")
	}
	if funcs[3].RetKind != RT_VOID {
		return fail("expected void return")
	}
	return ""
}
