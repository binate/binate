package "pkg/ir"

import "pkg/builtin/testing"

// ============================================================
// RuntimeFuncs tests
// ============================================================

func TestRuntimeFuncsCount() testing.TestResult {
	var funcs @[]RuntimeFunc = RuntimeFuncs()
	if len(funcs) != 1 {
		return fail("expected 1 runtime func")
	}
	return ""
}

func TestRuntimeFuncsExit() testing.TestResult {
	var funcs @[]RuntimeFunc = RuntimeFuncs()
	// Only bn_exit remains. All bn_print_* shims were removed in
	// favor of bootstrap.formatX + bootstrap.Write at IR-gen time.
	if !charsEqual(funcs[0].Name, "bn_exit") {
		return fail("expected bn_exit at index 0")
	}
	if len(funcs[0].ParamKinds) != 1 {
		return fail("expected 1 param")
	}
	if funcs[0].ParamKinds[0] != RT_INT {
		return fail("expected RT_INT param kind")
	}
	if funcs[0].RetKind != RT_VOID {
		return fail("expected void return")
	}
	return ""
}
