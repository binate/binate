package "pkg/ir"

import "pkg/builtin/testing"

// ============================================================
// RuntimeFuncs tests
// ============================================================

func TestRuntimeFuncsCount() testing.TestResult {
	var funcs @[]RuntimeFunc = RuntimeFuncs()
	if len(funcs) != 2 {
		return fail("expected 2 runtime funcs")
	}
	return ""
}

func TestRuntimeFuncsExit() testing.TestResult {
	var funcs @[]RuntimeFunc = RuntimeFuncs()
	// Only bn_print_float (index 0) and bn_exit (index 1) remain.
	// All other bn_print_* shims were removed in favor of
	// bootstrap.formatX + bootstrap.Write at IR-gen time.
	if !charsEqual(funcs[1].Name, "bn_exit") {
		return fail("expected bn_exit at index 1")
	}
	return ""
}

func TestRuntimeFuncsPrintFloat() testing.TestResult {
	var funcs @[]RuntimeFunc = RuntimeFuncs()
	// print_float is at index 0 (only bn_print_float and bn_exit
	// remain in the manifest).
	if !charsEqual(funcs[0].Name, "bn_print_float") {
		return fail("expected bn_print_float at index 0")
	}
	if len(funcs[0].ParamKinds) != 1 {
		return fail("expected 1 param")
	}
	if funcs[0].ParamKinds[0] != RT_F64 {
		return fail("expected RT_F64 param kind")
	}
	if funcs[0].RetKind != RT_VOID {
		return fail("expected void return")
	}
	return ""
}
