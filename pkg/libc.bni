// Package libc declares the host C standard library functions that
// the Binate runtime depends on, mangled to Binate's calling
// convention.
//
// pkg/libc is always libc. Pure interface package — there is no
// .bn file; implementations are direct libc forwards in
// runtime/libc_stubs.c. The declarations mirror libc's signatures,
// including its warts (e.g. implementation-defined behavior on
// size 0).
//
// On a libc-free target (e.g. ARM32 bare-metal), code does NOT
// substitute a different pkg/libc — it substitutes a different
// pkg/builtins/rt that does not import pkg/libc and instead implements the
// runtime directly (Binate-implemented allocator, pure-Binate
// memops, etc.). pkg/libc is the libc-only side of that fork.
//
// Higher-level wrappers — pkg/builtins/rt's RawAlloc / RawAllocZero /
// RawFree — enforce stricter, well-defined preconditions for general
// use. (rt's MemCopy / MemZero are pure-Binate byte loops and no
// longer route through pkg/libc.)
package "pkg/libc"

// Malloc allocates size bytes of uninitialized memory. Wraps libc
// malloc. Returns a non-null pointer on success, null on OOM.
// Behavior for size == 0 is implementation-defined.
func Malloc(size int) *uint8

// Calloc allocates count*size bytes of zero-initialized memory.
// Wraps libc calloc.
func Calloc(count int, size int) *uint8

// Free releases an allocation previously returned by Malloc or
// Calloc. Wraps libc free. ptr == nil is a no-op (matching libc).
func Free(ptr *uint8)

// Exit terminates the process with the given exit code. Wraps libc
// exit.
func Exit(code int)
