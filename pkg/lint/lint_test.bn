package "pkg/lint"

import "pkg/ast"
import "pkg/bootstrap"
import "pkg/buf"
import "pkg/builtins/testing"
import "pkg/parser"
import "pkg/types"

// ============================================================
// Test Helpers
// ============================================================

func toBytes(s *[]const char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

func fail(msg @[]char) testing.TestResult {
	return msg
}

// lintSrc parses, type-checks, and lints a source string.
// Returns the lint Result.
func lintSrc(src *[]const char) @Result {
	var p @parser.Parser = parser.New(toBytes(src), "test.bn")
	var file @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.Check(file)
	return LintFile(c, file)
}

func expectDiag(r @Result, rule *[]const char) testing.TestResult {
	for i := 0; i < r.NumDiags; i++ {
		if charEq(r.Diags[i].Rule, rule) {
			return ""
		}
	}
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("expected diagnostic '")
	cb = cb.WriteStr(rule)
	cb = cb.WriteStr("' but got ")
	cb = cb.WriteStr(bootstrap.Itoa(r.NumDiags))
	cb = cb.WriteStr(" diagnostics")
	return cb.Bytes()
}

func expectNoDiag(r @Result, rule *[]const char) testing.TestResult {
	for i := 0; i < r.NumDiags; i++ {
		if charEq(r.Diags[i].Rule, rule) {
			var cb buf.CharBuf = buf.New()
			cb = cb.WriteStr("unexpected diagnostic '")
			cb = cb.WriteStr(rule)
			cb = cb.WriteStr("': ")
			cb = cb.WriteStr(r.Diags[i].Message)
			return cb.Bytes()
		}
	}
	return ""
}

func charEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// ============================================================
// managed-to-raw-assign: var decl
// ============================================================

func TestManagedToRawVarDecl() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("package \"test\"\n")
	b = b.WriteStr("func foo() { var ms @[]int = make_slice(int, 10)")
	b = b.WriteStr("; var s *[]int = ms; _ = s }")
	var src @[]char = b.Bytes()
	var r @Result = lintSrc(src)
	return expectDiag(r, "managed-to-raw-assign")
}

func TestManagedToRawVarDeclNeg() testing.TestResult {
	// Assigning raw to raw — no warning
	var src *[]const char = "package \"test\"\nfunc foo(s *[]int) { var s2 *[]int = s; _ = s2 }"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "managed-to-raw-assign")
}

func TestManagedToRawVarDeclManagedToManaged() testing.TestResult {
	// Assigning managed to managed — no warning
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("package \"test\"\n")
	b = b.WriteStr("func foo() { var ms @[]int = make_slice(int, 10)")
	b = b.WriteStr("; var ms2 @[]int = ms; _ = ms2 }")
	var src @[]char = b.Bytes()
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "managed-to-raw-assign")
}

// ============================================================
// managed-to-raw-assign: assignment
// ============================================================

func TestManagedToRawAssign() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("package \"test\"\n")
	b = b.WriteStr("func foo() { var ms @[]int = make_slice(int, 10)")
	b = b.WriteStr("; var s *[]int; s = ms; _ = s }")
	var src @[]char = b.Bytes()
	var r @Result = lintSrc(src)
	return expectDiag(r, "managed-to-raw-assign")
}

func TestManagedToRawAssignNeg() testing.TestResult {
	// Raw to raw assignment — no warning
	var src *[]const char = "package \"test\"\nfunc foo(a *[]int) { var b *[]int; b = a; _ = b }"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "managed-to-raw-assign")
}

// ============================================================
// managed-to-raw-assign: function return value
// ============================================================

func TestManagedToRawFromCall() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("package \"test\"\n")
	b = b.WriteStr("func bar() @[]int { return make_slice(int, 5) }\n")
	b = b.WriteStr("func foo() { var s *[]int = bar(); _ = s }")
	var src @[]char = b.Bytes()
	var r @Result = lintSrc(src)
	return expectDiag(r, "managed-to-raw-assign")
}

// ============================================================
// raw-slice-return
// ============================================================

func TestRawSliceReturn() testing.TestResult {
	// Function returns *[]int but the expression is @[]int
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("package \"test\"\n")
	b = b.WriteStr("func foo() *[]int { ")
	b = b.WriteStr("var ms @[]int = make_slice(int, 5); return ms }")
	var src @[]char = b.Bytes()
	var r @Result = lintSrc(src)
	return expectDiag(r, "raw-slice-return")
}

func TestRawSliceReturnNeg() testing.TestResult {
	// Function returns @[]int and expression is @[]int — no warning
	var src *[]const char = "package \"test\"\nfunc foo() @[]int { return make_slice(int, 5) }"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "raw-slice-return")
}

func TestRawSliceReturnRawToRaw() testing.TestResult {
	// Function returns *[]int and expression is *[]int — no warning
	var src *[]const char = "package \"test\"\nfunc foo(s *[]int) *[]int { return s }"
	var r @Result = lintSrc(src)
	return expectNoDiag(r, "raw-slice-return")
}

func TestRawSliceReturnFromCall() testing.TestResult {
	// Function returns *[]int but calls a function returning @[]int
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("package \"test\"\n")
	b = b.WriteStr("func bar() @[]int { return make_slice(int, 3) }\n")
	b = b.WriteStr("func foo() *[]int { return bar() }")
	var src @[]char = b.Bytes()
	var r @Result = lintSrc(src)
	return expectDiag(r, "raw-slice-return")
}

// ============================================================
// No false positives for unrelated code
// ============================================================

func TestCleanCode() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc foo() int { var x int = 42; return x }"
	var r @Result = lintSrc(src)
	if r.NumDiags != 0 {
		return "expected no diagnostics for clean code"
	}
	return ""
}
