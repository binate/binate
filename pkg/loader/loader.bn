package "pkg/loader"

import "pkg/ast"
import "pkg/bootstrap"
import "pkg/buf"
import "pkg/parser"

// ============================================================
// Helpers
// ============================================================

// streq returns true if two char slices have identical content.
func streq(a *[]const char, b *[]const char) bool {
	if len(a) == 0 && len(b) == 0 { return true }
	if len(a) == 0 || len(b) == 0 { return false }
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// hasSuffix reports whether s ends with the given suffix.
func hasSuffix(s *[]const char, suffix *[]const char) bool {
	if len(suffix) > len(s) { return false }
	var off int = len(s) - len(suffix)
	for i := 0; i < len(suffix); i++ {
		if s[off + i] != suffix[i] { return false }
	}
	return true
}

// pathJoin concatenates two path segments with a '/' separator.
func pathJoin(a *[]const char, b *[]const char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(a)
	cb = cb.WriteByte('/')
	cb = cb.WriteStr(b)
	return cb.Bytes()
}

// unquote strips surrounding double quotes from a string, if present.
func unquote(s @[]char) @[]char {
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		return s[1:len(s) - 1]
	}
	return s
}

// readFileBytes reads an entire file into a byte slice.
func readFileBytes(path *[]const char) @[]uint8 {
	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 {
		var empty @[]uint8
		return empty
	}
	var cap int = 4096
	var result @[]uint8 = make_slice(uint8, cap)
	var total int = 0
	var tmp @[]uint8 = make_slice(uint8, 4096)
	for {
		var n int = bootstrap.Read(fd, tmp)
		if n <= 0 { break }
		// Grow geometrically if needed
		for total + n > cap {
			var newCap int = cap * 2
			var newBuf @[]uint8 = make_slice(uint8, newCap)
			for i := 0; i < total; i++ {
				newBuf[i] = result[i]
			}
			result = newBuf
			cap = newCap
		}
		for i := 0; i < n; i++ {
			result[total + i] = tmp[i]
		}
		total = total + n
	}
	bootstrap.Close(fd)
	if total == 0 {
		var empty @[]uint8
		return empty
	}
	return result[0:total]
}

// containsStr checks if a string is in a slice.
func containsStr(ss @[]@[]char, s *[]const char) bool {
	if len(ss) == 0 { return false }
	for i := 0; i < len(ss); i++ {
		if streq(ss[i], s) { return true }
	}
	return false
}

// ============================================================
// Loader
// ============================================================

// NewLoader creates a Loader with the given filesystem root as its primary search path.
func NewLoader(root @[]char) @Loader {
	var l @Loader = make(Loader)
	l.Root = root
	// Explicitly initialize slices (workaround: bootstrap may zero them as NilVal)
	var emptyPkgs @[]@Package
	l.Packages = emptyPkgs
	var emptyOrder @[]@[]char
	l.Order = emptyOrder
	var emptyErrs @[]@[]char
	l.Errors = emptyErrs
	// Seed both search paths with the primary root.
	AddRoot(l, root)
	return l
}

// AddRoot appends a search root to BOTH the interface and impl paths.
// Sugar for AddBniPath(l, root) + AddImplPath(l, root). Skips duplicates
// on each path independently.
func AddRoot(l @Loader, root @[]char) {
	AddBniPath(l, root)
	AddImplPath(l, root)
	// Keep the deprecated combined Roots slice in sync for back-compat.
	for i := 0; i < len(l.Roots); i++ {
		if streq(l.Roots[i], root) { return }
	}
	l.Roots = appendCharSlice(l.Roots, root)
}

// AddBniPath appends a directory to the interface search path,
// skipping duplicates.
func AddBniPath(l @Loader, dir @[]char) {
	for i := 0; i < len(l.BniPath); i++ {
		if streq(l.BniPath[i], dir) { return }
	}
	l.BniPath = appendCharSlice(l.BniPath, dir)
}

// AddImplPath appends a directory to the impl search path,
// skipping duplicates.
func AddImplPath(l @Loader, dir @[]char) {
	for i := 0; i < len(l.ImplPath); i++ {
		if streq(l.ImplPath[i], dir) { return }
	}
	l.ImplPath = appendCharSlice(l.ImplPath, dir)
}

// RegisterBuiltin registers a built-in package that requires no source files.
func RegisterBuiltin(l @Loader, path @[]char) {
	var pkg @Package = make(Package)
	pkg.Path = path
	pkg.Builtin = true
	l.Packages = appendPackagePtr(l.Packages, pkg)
}

// GetPackage looks up a loaded package by its import path, returning nil if not found.
func GetPackage(l @Loader, path *[]const char) @Package {
	if len(l.Packages) == 0 { return nil }
	for i := 0; i < len(l.Packages); i++ {
		if streq(l.Packages[i].Path, path) {
			return l.Packages[i]
		}
	}
	return nil
}

// loading tracks packages currently being loaded (cycle detection).
// We use a simple @[]@[]char stack since we don't have maps.
var loadingStack @[]@[]char

// isLoading checks whether a package is currently on the loading stack (cycle detection).
func isLoading(path @[]char) bool {
	if len(loadingStack) == 0 { return false }
	for i := 0; i < len(loadingStack); i++ {
		if streq(loadingStack[i], path) { return true }
	}
	return false
}

// pushLoading adds a package path to the loading stack.
func pushLoading(path @[]char) {
	loadingStack = appendCharSlice(loadingStack, path)
}

// popLoading removes the last occurrence of a package path from the loading stack.
func popLoading(path @[]char) {
	// Remove last occurrence
	if len(loadingStack) == 0 { return }
	var newStack @[]@[]char
	var found bool = false
	for i := len(loadingStack) - 1; i >= 0; i-- {
		if streq(loadingStack[i], path) && !found {
			found = true
		} else {
			newStack = appendCharSlice(newStack, loadingStack[i])
		}
	}
	// Reverse
	var reversed @[]@[]char
	for i := len(newStack) - 1; i >= 0; i-- {
		reversed = appendCharSlice(reversed, newStack[i])
	}
	loadingStack = reversed
}

// LoadImports loads all packages referenced by the given import specs, then computes load order.
func LoadImports(l @Loader, imports *[]@ast.ImportSpec) {
	if len(imports) == 0 { return }
	for i := 0; i < len(imports); i++ {
		var path @[]char = unquote(imports[i].Path)
		if GetPackage(l, path) != nil { continue }
		loadPackage(l, path)
	}
	if len(l.Errors) == 0 {
		computeOrder(l)
	}
}

// loadPackage reads, parses, and registers a single package and recursively loads its dependencies.
func loadPackage(l @Loader, path @[]char) {
	// Cycle detection
	if isLoading(path) {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("import cycle: ")
		cb = cb.WriteStr(path)
		l.Errors = appendCharSlice(l.Errors, cb.Bytes())
		return
	}
	pushLoading(path)

	// Two independent search loops: BniPath for the .bni interface,
	// ImplPath for the impl directory. First hit on each wins.
	var bniFile @ast.File
	var files @[]@ast.File

	// Interface path: <dir>/<path>.bni
	for ri := 0; ri < len(l.BniPath); ri++ {
		var dir @[]char = l.BniPath[ri]
		var bniCb buf.CharBuf = buf.New()
		bniCb = bniCb.WriteStr(pathJoin(dir, path))
		bniCb = bniCb.WriteStr(".bni")
		var bniPath @[]char = bniCb.Bytes()
		if bootstrap.Stat(bniPath) != 1 { continue }
		var bniSrc @[]uint8 = readFileBytes(bniPath)
		if len(bniSrc) == 0 { continue }
		var p @parser.Parser = parser.NewInterface(bniSrc, bniPath)
		bniFile = parser.ParseFile(p)
		var errs @[]parser.ParseError = parser.Errors(p)
		if len(errs) > 0 {
			for j := 0; j < len(errs); j++ {
				l.Errors = appendCharSlice(l.Errors, errs[j].Msg)
			}
			popLoading(path)
			return
		}
		break
	}

	// Impl path: <dir>/<path>/ containing at least one .bn file.
	for ri := 0; ri < len(l.ImplPath); ri++ {
		var dir @[]char = l.ImplPath[ri]
		var dirPath @[]char = pathJoin(dir, path)
		if bootstrap.Stat(dirPath) != 2 { continue }
		var entries @[]@[]char = bootstrap.ReadDir(dirPath)
		if len(entries) == 0 { continue }
		sortStrings(entries)
		for j := 0; j < len(entries); j++ {
			var name @[]char = entries[j]
			if !hasSuffix(name, ".bn") { continue }
			if hasSuffix(name, "_test.bn") && !containsStr(l.TestPackages, path) {
				continue
			}
			var filePath @[]char = pathJoin(dirPath, name)
			var src @[]uint8 = readFileBytes(filePath)
			if len(src) == 0 { continue }

			var p @parser.Parser = parser.New(src, filePath)
			var f @ast.File = parser.ParseFile(p)
			var errs @[]parser.ParseError = parser.Errors(p)
			if len(errs) > 0 {
				for k := 0; k < len(errs); k++ {
					l.Errors = appendCharSlice(l.Errors, errs[k].Msg)
				}
				popLoading(path)
				return
			}
			files = appendFilePtr(files, f)
		}
		if len(files) > 0 { break }
	}

	if bniFile == nil && len(files) == 0 {
		var cb2 buf.CharBuf = buf.New()
		cb2 = cb2.WriteStr("package \"")
		cb2 = cb2.WriteStr(path)
		cb2 = cb2.WriteStr("\" not found")
		l.Errors = appendCharSlice(l.Errors, cb2.Bytes())
		popLoading(path)
		return
	}

	// Merge .bn files
	var merged @ast.File
	if len(files) > 0 {
		if len(files) == 1 {
			merged = files[0]
		} else {
			merged = MergeFiles(files)
		}
	}

	// Merge .bni declarations into implementation
	if bniFile != nil && merged != nil {
		// Prepend type/const/group declarations from .bni,
		// plus function declarations that have no matching body in the .bn
		var bniDecls @[]@ast.Decl
		for j := 0; j < len(bniFile.Decls); j++ {
			var d @ast.Decl = bniFile.Decls[j]
			if d.Kind == ast.DECL_TYPE || d.Kind == ast.DECL_CONST || d.Kind == ast.DECL_GROUP {
				bniDecls = appendDeclPtr(bniDecls, d)
			}
			if d.Kind == ast.DECL_FUNC && d.Body == nil {
				// Include extern function declarations (no body in .bni)
				// unless the .bn has a matching implementation
				var hasImpl bool = false
				for k := 0; k < len(merged.Decls); k++ {
					if merged.Decls[k].Kind == ast.DECL_FUNC && streq(merged.Decls[k].Name, d.Name) {
						hasImpl = true
						break
					}
				}
				if !hasImpl {
					bniDecls = appendDeclPtr(bniDecls, d)
				}
			}
		}
		if len(bniDecls) > 0 {
			var newDecls @[]@ast.Decl
			for j := 0; j < len(bniDecls); j++ {
				newDecls = appendDeclPtr(newDecls, bniDecls[j])
			}
			for j := 0; j < len(merged.Decls); j++ {
				newDecls = appendDeclPtr(newDecls, merged.Decls[j])
			}
			merged.Decls = newDecls
		}

		// Merge .bni imports
		if len(bniFile.Imports) > 0 {
			for j := 0; j < len(bniFile.Imports); j++ {
				var bniImpPath @[]char = bniFile.Imports[j].Path
				var found bool = false
				if len(merged.Imports) > 0 {
					for k := 0; k < len(merged.Imports); k++ {
						if streq(merged.Imports[k].Path, bniImpPath) {
							found = true
							break
						}
					}
				}
				if !found {
					merged.Imports = appendImportSpec(merged.Imports, bniFile.Imports[j])
				}
			}
		}
	}

	// If we only have .bni (no impl), use it as the merged file
	if merged == nil && bniFile != nil {
		merged = bniFile
	}

	// Register package
	var pkg @Package = make(Package)
	pkg.Path = path
	pkg.BNI = bniFile
	pkg.Merged = merged

	// Extract imports
	if merged != nil && len(merged.Imports) > 0 {
		for j := 0; j < len(merged.Imports); j++ {
			var impPath @[]char = unquote(merged.Imports[j].Path)
			if !containsStr(pkg.Imports, impPath) {
				pkg.Imports = appendCharSlice(pkg.Imports, impPath)
			}
		}
	}
	l.Packages = appendPackagePtr(l.Packages, pkg)
	popLoading(path)

	// Recursively load dependencies
	if len(pkg.Imports) > 0 {
		for j := 0; j < len(pkg.Imports); j++ {
			if GetPackage(l, pkg.Imports[j]) == nil {
				loadPackage(l, pkg.Imports[j])
			}
		}
	}
}

// ============================================================
// MergeFiles
// ============================================================

// MergeFiles combines multiple parsed files into a single AST, deduplicating imports.
func MergeFiles(files *[]@ast.File) @ast.File {
	if len(files) == 0 {
		return nil
	}
	if len(files) == 1 {
		return files[0]
	}

	var merged @ast.File = make(ast.File)
	merged.PkgName = files[0].PkgName
	merged.Pos = files[0].Pos

	// Deduplicate imports
	for i := 0; i < len(files); i++ {
		if len(files[i].Imports) == 0 { continue }
		for j := 0; j < len(files[i].Imports); j++ {
			var imp @ast.ImportSpec = files[i].Imports[j]
			if !hasImport(merged.Imports, imp.Alias, imp.Path) {
				merged.Imports = appendImportSpec(merged.Imports, imp)
			}
		}
	}

	// Concatenate declarations
	for i := 0; i < len(files); i++ {
		if len(files[i].Decls) == 0 { continue }
		for j := 0; j < len(files[i].Decls); j++ {
			merged.Decls = appendDeclPtr(merged.Decls, files[i].Decls[j])
		}
	}

	return merged
}

// hasImport reports whether the import list already contains an entry
// with the given alias and path.
func hasImport(imports @[]@ast.ImportSpec, alias *[]const char, path *[]const char) bool {
	if len(imports) == 0 { return false }
	for i := 0; i < len(imports); i++ {
		if streq(imports[i].Alias, alias) && streq(imports[i].Path, path) {
			return true
		}
	}
	return false
}

// ============================================================
// Topological Sort
// ============================================================

// computeOrder performs a topological sort of loaded packages by their dependencies.
func computeOrder(l @Loader) {
	var visited @[]@[]char
	var order @[]@[]char

	if len(l.Packages) == 0 { return }
	for i := 0; i < len(l.Packages); i++ {
		visit(l, l.Packages[i].Path, &visited, &order)
	}
	l.Order = order
}

// visit is the recursive DFS helper for topological sort, appending a package after its deps.
func visit(l @Loader, path @[]char, visited *@[]@[]char, order *@[]@[]char) {
	if containsStr(*visited, path) { return }
	*visited = appendCharSlice(*visited, path)

	var pkg @Package = GetPackage(l, path)
	if pkg == nil { return }

	if len(pkg.Imports) > 0 {
		for i := 0; i < len(pkg.Imports); i++ {
			visit(l, pkg.Imports[i], visited, order)
		}
	}
	*order = appendCharSlice(*order, path)
}

// ============================================================
// Sort
// ============================================================

// sortStrings sorts a managed-slice of strings in place using insertion sort.
func sortStrings(ss @[]@[]char) {
	// Simple insertion sort
	for i := 1; i < len(ss); i++ {
		var key @[]char = ss[i]
		var j int = i - 1
		for j >= 0 && strLess(key, ss[j]) {
			ss[j+1] = ss[j]
			j--
		}
		ss[j+1] = key
	}
}

// strLess returns true if string a is lexicographically less than string b.
func strLess(a @[]char, b @[]char) bool {
	var n int = len(a)
	if len(b) < n { n = len(b) }
	for i := 0; i < n; i++ {
		if a[i] < b[i] { return true }
		if a[i] > b[i] { return false }
	}
	return len(a) < len(b)
}
