package "pkg/loader"

import "pkg/ast"

// Append helpers — O(n) copy pattern using make_slice.

// appendCharSlice returns a new slice with v appended to s.
func appendCharSlice(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendPackagePtr returns a new slice with v appended to s.
func appendPackagePtr(s @[]@Package, v @Package) @[]@Package {
	var n int = len(s)
	var ns @[]@Package = make_slice(@Package, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

