// Package mangle provides symbol name mangling for Binate.
// The mangling scheme converts Binate names to linker symbols:
//   local "foo" in pkg "parser"  → "bn_parser__foo"
//   "main" in pkg "main"         → "bn_main__main"
//   cross-pkg "parser.New"       → "bn_parser__New"
// Special case: "__entry" in pkg "main" (the synthetic entry
// wrapper that runs init + user main) → "bn_entry" — the C
// runtime's sole entry point into Binate.
//
// Migration in progress (see explorations/claude-todo.md CRITICAL):
// the mangler is being switched from last-segment short names to
// the FULL package path so that two packages with the same
// last-segment name (e.g. `pkg/asm/x64` and `pkg/native/x64`) do
// not collide on the linker side.  During the migration,
// FuncName/QualifyName/GlobalName/StructName accept either a
// short name or a full path (they short-name internally) — so
// individual callers can be flipped to pass the full path one at
// a time while the emitted symbols stay at the current short
// form.  PkgPathFromQuoted is the migration target replacing
// PkgShortNameFromModule.
package "pkg/mangle"

import "pkg/buf"

// PkgShortName returns the last component of a package path.
// SLATED FOR REMOVAL once all callers have been migrated to pass
// full paths (see package doc).
func PkgShortName(path *[]const char) *[]const char

// PkgShortNameFromModule returns the short package name from an
// ir.Module name, which may be quoted (e.g. `"pkg/asm"` → "asm").
// SLATED FOR REMOVAL — migrate to PkgPathFromQuoted.
func PkgShortNameFromModule(name *[]const char) @[]char

// PkgPathFromQuoted strips surrounding quotes from a quoted module
// name like `"pkg/foo"` → `pkg/foo`, preserving the full path.
// Replaces PkgShortNameFromModule in the migration to full-path
// mangling.
func PkgPathFromQuoted(name *[]const char) @[]char

// FuncName returns the mangled symbol name for a function.
// pkgName may be either a short name or a full package path
// (short-named internally during the migration).
func FuncName(pkgName *[]const char, name *[]const char) buf.CharBuf

// QualifyName returns a dot-qualified name (`<pkgShort>.<name>`)
// for intra-package references. Names already containing a dot
// pass through unchanged. Used by the VM to avoid cross-package
// collisions in its flat function table.
// pkgName may be short or full path; internally short-named.
func QualifyName(pkgName *[]const char, name *[]const char) @[]char

// GlobalName returns the mangled symbol name for a global variable.
// pkgName may be short or full path; internally short-named.
func GlobalName(pkgName *[]const char, name *[]const char) buf.CharBuf

// StructName returns the mangled type name for a struct.
// pkgName may be short or full path; internally short-named.
func StructName(pkgName *[]const char, name *[]const char) buf.CharBuf
