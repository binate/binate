// Package mangle provides symbol name mangling for Binate.
// The mangling scheme converts Binate names to linker symbols:
//   local "foo" in pkg "parser"  → "bn_parser__foo"
//   "main" in pkg "main"         → "bn_main"
//   cross-pkg "parser.New"       → "bn_parser__New"
package "pkg/mangle"

import "pkg/buf"

// PkgShortName returns the last component of a package path.
func PkgShortName(path *[]const char) *[]const char

// PkgShortNameFromModule returns the short package name from an
// ir.Module name, which may be quoted (e.g. `"pkg/asm"` → "asm").
func PkgShortNameFromModule(name *[]const char) @[]char

// FuncName returns the mangled symbol name for a function.
func FuncName(pkgName *[]const char, name *[]const char) buf.CharBuf

// QualifyName returns a dot-qualified name (pkgShort + "." + name)
// for intra-package references. Names already containing a dot
// pass through unchanged. Used by the VM to avoid cross-package
// collisions in its flat function table.
func QualifyName(pkgShort *[]const char, name *[]const char) @[]char

// GlobalName returns the mangled symbol name for a global variable.
func GlobalName(pkgName *[]const char, name *[]const char) buf.CharBuf

// StructName returns the mangled type name for a struct.
func StructName(pkgName *[]const char, name *[]const char) buf.CharBuf
