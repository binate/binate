package "pkg/mangle"

import "pkg/buf"

// PkgShortName extracts the last component of a package path.
// "pkg/parser" → "parser", "main" → "main"
func PkgShortName(path *[]const char) *[]const char {
	var last int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			last = i + 1
		}
	}
	return path[last:len(path)]
}

// PkgShortNameFromModule strips surrounding quotes and returns the
// short package name. ir.Module.Name is conventionally wrapped in
// double-quotes (e.g. `"pkg/asm"`); callers that operate on that
// form can use this helper instead of stripping quotes themselves.
func PkgShortNameFromModule(name *[]const char) @[]char {
	var start int = 0
	var end int = len(name)
	if end >= 2 && name[0] == '"' && name[end-1] == '"' {
		start = 1
		end = end - 1
	}
	var last int = start
	for i := start; i < end; i++ {
		if name[i] == '/' { last = i + 1 }
	}
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, name[last:end])
	return b.Bytes()
}

// QualifyName returns a dot-qualified name for intra-package
// references. Names already containing a dot (cross-package refs,
// qualified extern decls) pass through unchanged. Used by the VM
// to avoid cross-package collisions in its flat function table.
func QualifyName(pkgShort *[]const char, name *[]const char) @[]char {
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			var b buf.CharBuf = buf.New()
			b = buf.WriteStr(b, name)
			return b.Bytes()
		}
	}
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, pkgShort)
	b = b.WriteByte('.')
	b = buf.WriteStr(b, name)
	return b.Bytes()
}

// FuncName converts a Binate function name to its linker symbol.
//
// Free functions:
//   "foo" in pkg "parser"  → "bn_parser__foo"
//   "main" in pkg "main"   → "bn_main"
//   "parser.New" (qualified, any pkg arg) → "bn_parser__New"
//
// Methods (fully-qualified per plan-receivers.md Stage 4):
//   "geom.Point.M"   → "bn_geom__Point__M"
//   "Point.M" (intra-pkg "geom") → "bn_geom__Point__M"
//
// Algorithm: if `name` already contains a dot, treat it as
// pre-qualified — emit "bn_" + name with every "." converted to "__".
// Otherwise, prepend the package name.
func FuncName(pkgName *[]const char, name *[]const char) buf.CharBuf {
	var hasDot bool = false
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			hasDot = true
			break
		}
	}
	if hasDot {
		return writeBnDotted(name)
	}
	if charsEqual(name, "main") && charsEqual(pkgName, "main") {
		var b buf.CharBuf = buf.New()
		b = buf.WriteStr(b, "bn_main")
		return b
	}
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "bn_")
	b = buf.WriteStr(b, pkgName)
	b = buf.WriteStr(b, "__")
	b = buf.WriteStr(b, name)
	return b
}

// writeBnDotted writes "bn_" followed by name with every "." replaced
// by "__". Used for pre-qualified names that may contain multiple dots
// (e.g., a method name "geom.Point.M").
func writeBnDotted(name *[]const char) buf.CharBuf {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "bn_")
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			b = buf.WriteStr(b, "__")
		} else {
			b = b.WriteByte(name[i])
		}
	}
	return b
}

// GlobalName converts a Binate global variable name to its linker symbol.
func GlobalName(pkgName *[]const char, name *[]const char) buf.CharBuf {
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "bn_")
	b = buf.WriteStr(b, pkgName)
	b = buf.WriteStr(b, "__")
	b = buf.WriteStr(b, name)
	return b
}

// StructName converts a Binate struct type name to its linker symbol.
// Unqualified "Point" in pkg "main" → "bn_main__Point"
// Qualified "parser.Parser" → "bn_parser__Parser"
func StructName(pkgName *[]const char, name *[]const char) buf.CharBuf {
	var dotIdx int = -1
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			dotIdx = i
			break
		}
	}
	if dotIdx >= 0 {
		var b buf.CharBuf = buf.New()
		b = buf.WriteStr(b, "bn_")
		b = buf.WriteStr(b, name[0:dotIdx])
		b = buf.WriteStr(b, "__")
		b = buf.WriteStr(b, name[dotIdx+1:len(name)])
		return b
	}
	var b buf.CharBuf = buf.New()
	b = buf.WriteStr(b, "bn_")
	b = buf.WriteStr(b, pkgName)
	b = buf.WriteStr(b, "__")
	b = buf.WriteStr(b, name)
	return b
}

// charsEqual returns true if raw slices a and b have identical contents.
func charsEqual(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
