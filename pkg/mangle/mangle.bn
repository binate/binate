package "pkg/mangle"

import "pkg/buf"

// PkgShortName extracts the last component of a package path.
// "pkg/parser" → "parser", "main" → "main"
//
// TODO(mangler-fullpath): consumers should pass the FULL path to
// the mangling functions; short-naming should happen only when
// the short form is intrinsically what's wanted (e.g. user-facing
// display).  Once every caller has been migrated, this and the
// `PkgShortName(pkgPath)` self-strip inside FuncName/GlobalName/
// StructName/QualifyName go away and the mangler starts producing
// `bn_<full__path>__name` symbols.
func PkgShortName(path *[]const char) *[]const char {
	var last int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			last = i + 1
		}
	}
	return path[last:len(path)]
}

// PkgShortNameFromModule strips surrounding quotes and returns the
// short package name. ir.Module.Name is conventionally wrapped in
// double-quotes (e.g. `"pkg/asm"`); callers that operate on that
// form can use this helper instead of stripping quotes themselves.
//
// TODO(mangler-fullpath): see PkgShortName — slated for removal
// once consumers stop short-naming up front.
func PkgShortNameFromModule(name *[]const char) @[]char {
	var start int = 0
	var end int = len(name)
	if end >= 2 && name[0] == '"' && name[end-1] == '"' {
		start = 1
		end = end - 1
	}
	var last int = start
	for i := start; i < end; i++ {
		if name[i] == '/' { last = i + 1 }
	}
	var b buf.CharBuf = buf.New()
	b = b.WriteStr(name[last:end])
	return b.Bytes()
}

// PkgPathFromQuoted strips surrounding quotes from a quoted-module
// name (`"pkg/foo"` → `pkg/foo`) but preserves the full path.  IR
// Module names and AST PkgName entries are conventionally quoted;
// this is the replacement for PkgShortNameFromModule that callers
// should migrate to so that the mangler eventually gets full paths
// (avoiding the cross-package symbol collisions that arise when two
// packages share a last-segment short name — see
// explorations/claude-todo.md CRITICAL section).
func PkgPathFromQuoted(name *[]const char) @[]char {
	var start int = 0
	var end int = len(name)
	if end >= 2 && name[0] == '"' && name[end-1] == '"' {
		start = 1
		end = end - 1
	}
	var b buf.CharBuf = buf.New()
	b = b.WriteStr(name[start:end])
	return b.Bytes()
}

// QualifyName returns a dot-qualified name for intra-package
// references. Names already containing a dot (cross-package refs,
// qualified extern decls) pass through unchanged. Used by the VM
// to avoid cross-package collisions in its flat function table.
//
// pkgName may be either a short name (`foo`) or a full path
// (`pkg/foo`) — the latter is short-named before use so that the
// qualifier produced during the Phase-A migration is unchanged
// (`foo.bar`).  The final flip will drop the short-name step so
// the qualifier becomes `pkg/foo.bar`.
func QualifyName(pkgName *[]const char, name *[]const char) @[]char {
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			var b buf.CharBuf = buf.New()
			b = b.WriteStr(name)
			return b.Bytes()
		}
	}
	var pkgShort *[]const char = PkgShortName(pkgName)
	var b buf.CharBuf = buf.New()
	b = b.WriteStr(pkgShort)
	b = b.WriteByte('.')
	b = b.WriteStr(name)
	return b.Bytes()
}

// FuncName converts a Binate function name to its linker symbol.
//
// Free functions:
//   "foo" in pkg "parser"  → "bn_parser__foo"
//   "main" in pkg "main"   → "bn_main__main"
//   "parser.New" (qualified, any pkg arg) → "bn_parser__New"
//
// Methods (fully-qualified per plan-receivers.md Stage 4):
//   "geom.Point.M"   → "bn_geom__Point__M"
//   "Point.M" (intra-pkg "geom") → "bn_geom__Point__M"
//
// Special case: the C entry point — what the C-runtime `main`
// dispatches into — is `bn_entry`, the symbol the per-binary
// init+main wrapper emits under.  Source-level `main.__entry`
// (a synthetic function in the main package) maps to it; nothing
// else does.  This keeps entry-time semantics (var init,
// eventually panic / signal setup) inside Binate behind one
// stable symbol while leaving the user's `main.main` to mangle
// like any other function.
//
// pkgName may be passed as either a short name or a full path
// (callers are being migrated to pass the full path); the
// function short-names it internally so the emitted symbol is
// unchanged during the migration.  The final flip will drop the
// internal short-naming step.
func FuncName(pkgName *[]const char, name *[]const char) buf.CharBuf {
	if charsEqual(name, "main.__entry") {
		var b buf.CharBuf = buf.New()
		b = b.WriteStr("bn_entry")
		return b
	}
	var hasDot bool = false
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			hasDot = true
			break
		}
	}
	if hasDot {
		return writeBnDotted(name)
	}
	var pkgShort *[]const char = PkgShortName(pkgName)
	if charsEqual(name, "__entry") && charsEqual(pkgShort, "main") {
		var b buf.CharBuf = buf.New()
		b = b.WriteStr("bn_entry")
		return b
	}
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("bn_")
	b = b.WriteStr(pkgShort)
	b = b.WriteStr("__")
	b = b.WriteStr(name)
	return b
}

// writeBnDotted writes "bn_" followed by name with every "." replaced
// by "__". Used for pre-qualified names that may contain multiple dots
// (e.g., a method name "geom.Point.M").
func writeBnDotted(name *[]const char) buf.CharBuf {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("bn_")
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			b = b.WriteStr("__")
		} else {
			b = b.WriteByte(name[i])
		}
	}
	return b
}

// GlobalName converts a Binate global variable name to its linker symbol.
// pkgName may be short or full path; internally short-named (see FuncName).
func GlobalName(pkgName *[]const char, name *[]const char) buf.CharBuf {
	var pkgShort *[]const char = PkgShortName(pkgName)
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("bn_")
	b = b.WriteStr(pkgShort)
	b = b.WriteStr("__")
	b = b.WriteStr(name)
	return b
}

// StructName converts a Binate struct type name to its linker symbol.
// Unqualified "Point" in pkg "main" → "bn_main__Point"
// Qualified "parser.Parser" → "bn_parser__Parser"
// pkgName may be short or full path; internally short-named (see FuncName).
func StructName(pkgName *[]const char, name *[]const char) buf.CharBuf {
	var dotIdx int = -1
	for i := 0; i < len(name); i++ {
		if name[i] == '.' {
			dotIdx = i
			break
		}
	}
	if dotIdx >= 0 {
		var b buf.CharBuf = buf.New()
		b = b.WriteStr("bn_")
		b = b.WriteStr(name[0:dotIdx])
		b = b.WriteStr("__")
		b = b.WriteStr(name[dotIdx+1:len(name)])
		return b
	}
	var pkgShort *[]const char = PkgShortName(pkgName)
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("bn_")
	b = b.WriteStr(pkgShort)
	b = b.WriteStr("__")
	b = b.WriteStr(name)
	return b
}

// charsEqual returns true if raw slices a and b have identical contents.
func charsEqual(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
