package "pkg/mangle"

import "pkg/buf"
import "pkg/builtin/testing"

func fail(msg @[]char) testing.TestResult {
	return msg
}

func bufStr(cb buf.CharBuf) @[]char {
	return cb.Bytes()
}

func strEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// ============================================================
// PkgShortName
// ============================================================

func TestPkgShortNameSimple() testing.TestResult {
	var s *[]const char = PkgShortName("main")
	if !strEq(s, "main") { return fail("expected main") }
	return ""
}

func TestPkgShortNameSlash() testing.TestResult {
	var s *[]const char = PkgShortName("pkg/parser")
	if !strEq(s, "parser") { return fail("expected parser") }
	return ""
}

func TestPkgShortNameDeep() testing.TestResult {
	var s *[]const char = PkgShortName("pkg/asm/aarch64")
	if !strEq(s, "aarch64") { return fail("expected aarch64") }
	return ""
}

// ============================================================
// PkgPathFromQuoted
// ============================================================

func TestPkgPathFromQuotedSimple() testing.TestResult {
	var s @[]char = PkgPathFromQuoted("\"main\"")
	if !strEq(s, "main") { return fail("expected main") }
	return ""
}

func TestPkgPathFromQuotedPath() testing.TestResult {
	var s @[]char = PkgPathFromQuoted("\"pkg/parser\"")
	if !strEq(s, "pkg/parser") {
		return fail("expected pkg/parser (preserves full path)")
	}
	return ""
}

func TestPkgPathFromQuotedDeep() testing.TestResult {
	var s @[]char = PkgPathFromQuoted("\"pkg/asm/aarch64\"")
	if !strEq(s, "pkg/asm/aarch64") {
		return fail("expected pkg/asm/aarch64 (preserves full path)")
	}
	return ""
}

func TestPkgPathFromQuotedUnquoted() testing.TestResult {
	var s @[]char = PkgPathFromQuoted("main")
	if !strEq(s, "main") {
		return fail("expected main passthrough for unquoted input")
	}
	return ""
}

// ============================================================
// FuncName
// ============================================================

func TestFuncNameLocal() testing.TestResult {
	var b buf.CharBuf = FuncName("parser", "parseExpr")
	var s @[]char = bufStr(b)
	if !strEq(s, "bn_parser__parseExpr") {
		return fail("expected bn_parser__parseExpr")
	}
	return ""
}

func TestFuncNameMain() testing.TestResult {
	// `main` in package `main` no longer gets a special-cased
	// linker symbol — it mangles like any other free function.
	// The `bn_entry` symbol that the C runtime calls is reserved
	// for the synthetic `<main>.__entry` wrapper (see
	// TestFuncNameMainEntry).
	var b buf.CharBuf = FuncName("main", "main")
	var s @[]char = bufStr(b)
	if !strEq(s, "bn_main__main") {
		return fail("expected bn_main__main")
	}
	return ""
}

func TestFuncNameMainEntry() testing.TestResult {
	// `<main>.__entry` is the C runtime's sole entry into
	// Binate.  Both the bare-then-pkg form and the pre-qualified
	// dotted form must resolve to the same `bn_entry` symbol so
	// callers can use either path.
	var b1 buf.CharBuf = FuncName("main", "__entry")
	if !strEq(bufStr(b1), "bn_entry") {
		return fail("expected bn_entry from (main, __entry)")
	}
	var b2 buf.CharBuf = FuncName("main", "main.__entry")
	if !strEq(bufStr(b2), "bn_entry") {
		return fail("expected bn_entry from main.__entry")
	}
	return ""
}

func TestFuncNameCrossPkg() testing.TestResult {
	var b buf.CharBuf = FuncName("main", "parser.New")
	var s @[]char = bufStr(b)
	if !strEq(s, "bn_parser__New") {
		return fail("expected bn_parser__New")
	}
	return ""
}

// Method on a named type, fully qualified at the IR level: every dot
// becomes "__". (Stage 4 of plan-receivers.md.)
func TestFuncNameMethod() testing.TestResult {
	var b buf.CharBuf = FuncName("geom", "geom.Point.M")
	var s @[]char = bufStr(b)
	if !strEq(s, "bn_geom__Point__M") {
		return fail("expected bn_geom__Point__M")
	}
	return ""
}

// Cross-package method reference (e.g., from a .bni import) is the
// same shape as the intra-package form once qualified.
func TestFuncNameMethodCrossPkg() testing.TestResult {
	var b buf.CharBuf = FuncName("main", "geom.Point.Translate")
	var s @[]char = bufStr(b)
	if !strEq(s, "bn_geom__Point__Translate") {
		return fail("expected bn_geom__Point__Translate")
	}
	return ""
}

// More than two dots — same algorithm: every "." → "__". Useful as a
// regression test if methods on nested types are ever introduced.
func TestFuncNameMethodMultiDot() testing.TestResult {
	var b buf.CharBuf = FuncName("any", "a.b.c.d")
	var s @[]char = bufStr(b)
	if !strEq(s, "bn_a__b__c__d") {
		return fail("expected bn_a__b__c__d")
	}
	return ""
}

// During the full-path migration, the mangler must accept a full
// package path in pkgName and short-name it internally so the
// emitted symbol is identical to what the short form would have
// produced.  Callers can then be flipped to pass the full path
// one at a time without changing emitted symbols.
func TestFuncNameAcceptsFullPath() testing.TestResult {
	var bShort buf.CharBuf = FuncName("parser", "parseExpr")
	var bFull buf.CharBuf = FuncName("pkg/parser", "parseExpr")
	if !strEq(bufStr(bShort), bufStr(bFull)) {
		return fail("full path must mangle identically to short")
	}
	return ""
}

func TestFuncNameAcceptsDeepPath() testing.TestResult {
	var b buf.CharBuf = FuncName("pkg/asm/aarch64", "EncodeMov")
	if !strEq(bufStr(b), "bn_aarch64__EncodeMov") {
		return fail("deep path should still short-name to last segment")
	}
	return ""
}

// __entry special case must trigger even when pkgName is passed
// as the full path "main" (no slashes — still "main" short-named).
func TestFuncNameMainEntryFullPath() testing.TestResult {
	var b buf.CharBuf = FuncName("main", "__entry")
	if !strEq(bufStr(b), "bn_entry") {
		return fail("__entry special case must trigger for main")
	}
	return ""
}

// A method whose IR name is fully-path-qualified
// ("pkg/buf.CharBuf.WriteByte") must short-name the path prefix —
// otherwise the slash leaks into the symbol and produces invalid
// LLVM/assembler identifiers.  This is the form produced once IR
// method-qualified names carry the full currentModulePkgPath.
func TestFuncNameFullPathMethod() testing.TestResult {
	var b buf.CharBuf = FuncName("pkg/buf", "pkg/buf.CharBuf.WriteByte")
	if !strEq(bufStr(b), "bn_buf__CharBuf__WriteByte") {
		return fail("full-path method must short-name to bn_buf__CharBuf__WriteByte")
	}
	return ""
}

// Cross-package call qualified with a full path
// ("pkg/parser.New") must likewise short-name the prefix.
func TestFuncNameFullPathCrossPkg() testing.TestResult {
	var b buf.CharBuf = FuncName("main", "pkg/parser.New")
	if !strEq(bufStr(b), "bn_parser__New") {
		return fail("full-path cross-pkg must short-name to bn_parser__New")
	}
	return ""
}

// ============================================================
// GlobalName
// ============================================================

func TestGlobalName() testing.TestResult {
	var b buf.CharBuf = GlobalName("ir", "moduleStructs")
	var s @[]char = bufStr(b)
	if !strEq(s, "bn_ir__moduleStructs") {
		return fail("expected bn_ir__moduleStructs")
	}
	return ""
}

// GlobalName must also tolerate full paths during the migration.
func TestGlobalNameAcceptsFullPath() testing.TestResult {
	var bShort buf.CharBuf = GlobalName("ir", "moduleStructs")
	var bFull buf.CharBuf = GlobalName("pkg/ir", "moduleStructs")
	if !strEq(bufStr(bShort), bufStr(bFull)) {
		return fail("full path must mangle identically to short")
	}
	return ""
}

// ============================================================
// StructName
// ============================================================

func TestStructNameLocal() testing.TestResult {
	var b buf.CharBuf = StructName("ir", "Instr")
	var s @[]char = bufStr(b)
	if !strEq(s, "bn_ir__Instr") {
		return fail("expected bn_ir__Instr")
	}
	return ""
}

func TestStructNameCrossPkg() testing.TestResult {
	var b buf.CharBuf = StructName("main", "parser.Parser")
	var s @[]char = bufStr(b)
	if !strEq(s, "bn_parser__Parser") {
		return fail("expected bn_parser__Parser")
	}
	return ""
}

func TestStructNameAcceptsFullPath() testing.TestResult {
	var bShort buf.CharBuf = StructName("ir", "Instr")
	var bFull buf.CharBuf = StructName("pkg/ir", "Instr")
	if !strEq(bufStr(bShort), bufStr(bFull)) {
		return fail("full path must mangle identically to short")
	}
	return ""
}

// A qualified struct name carrying a full path prefix
// ("pkg/parser.Parser") must short-name the prefix so the slash
// doesn't leak into the symbol.
func TestStructNameFullPathQualified() testing.TestResult {
	var b buf.CharBuf = StructName("main", "pkg/parser.Parser")
	if !strEq(bufStr(b), "bn_parser__Parser") {
		return fail("full-path struct must short-name to bn_parser__Parser")
	}
	return ""
}

// ============================================================
// QualifyName
// ============================================================

func TestQualifyNameBare() testing.TestResult {
	var s @[]char = QualifyName("parser", "New")
	if !strEq(s, "parser.New") {
		return fail("expected parser.New")
	}
	return ""
}

func TestQualifyNameAcceptsFullPath() testing.TestResult {
	var sShort @[]char = QualifyName("parser", "New")
	var sFull @[]char = QualifyName("pkg/parser", "New")
	if !strEq(sShort, sFull) {
		return fail("full path must qualify identically to short")
	}
	return ""
}

func TestQualifyNameAlreadyDottedPassthrough() testing.TestResult {
	var s @[]char = QualifyName("parser", "other.Func")
	if !strEq(s, "other.Func") {
		return fail("already-qualified should pass through")
	}
	return ""
}
