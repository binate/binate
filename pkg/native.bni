// Package native is Binate's own code-generation backend (peer to pkg/codegen).
// It targets multiple architectures via per-arch sub-packages (aarch64 now;
// x64, arm32 later). See explorations/plan-multi-backend-layout.md.
package "pkg/native"

import "pkg/ir"

// EmitObject lowers an IR module to a native object file for the given arch
// and writes it to path. Returns true on success.
//
// Supported arch names: "aarch64" (alias "arm64").
func EmitObject(mod @ir.Module, arch *[]const char, path *[]const char) bool
