package "pkg/native/aarch64"

import "pkg/asm"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// Tests for the indirect-call lowering in arm64_call_indirect.bn.
// The end-to-end behavior (real OP_CALL_INDIRECT for dtor /
// _call_free_fn / cross-mode dispatch, OP_CALL_FUNC_VALUE through
// the always-shim) is covered by the conformance suite; these
// tests pin the byte-counts and the X17-target convention so a
// regression in the dispatch shape doesn't silently regress.
//
// opsMkAssembler / opsBytes / nilFuncs come from arm64_ops_test.bn
// (same package).

// emitCallIndirect with no call args emits:
//   LDR fnSrc, [SP, #...]   ; getOperand reload
//   MOV X17, fnSrc
//   BLR X17
// Three 4-byte AArch64 instructions = 12 bytes. ins.ID = -1 so
// the post-call return-handling block short-circuits.
func TestEmitCallIndirectNoArgsVoid() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Spill slot for fn_ptr (ID = 5) at offset 0.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)

	var fnPtr @ir.Instr = make(ir.Instr)
	fnPtr.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1            // void return — skip post-call spill
	ins.Op = ir.OP_CALL_INDIRECT
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fnPtr

	emitCallIndirect(a, m, nilFuncs(), ins)
	if opsBytes(a) != 12 {
		return "indirect call (no args, void) should emit 3 instrs (12 bytes)"
	}
	return ""
}

// emitCallFuncValue with no call args emits:
//   LDR fvAddr, [SP, #...]      ; getOperand reload
//   LDR X17, [fvAddr + 0]       ; vtable_ptr
//   LDR X17, [X17 + 8]          ; vtable.call
//   LDR X0, [fvAddr + 8]        ; data (always-shim convention)
//   BLR X17
// Five 4-byte AArch64 instructions = 20 bytes. Pins the always-
// shim convention — vtable.call's signature has *uint8 data
// prepended, so X0 is reserved for data and user args (none here)
// would shift to X1+.
func TestEmitCallFuncValueNoArgsVoid() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Spill slot for fv address (ID = 5) at offset 0.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)

	var fvAddr @ir.Instr = make(ir.Instr)
	fvAddr.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1            // void return
	ins.Op = ir.OP_CALL_FUNC_VALUE
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fvAddr

	emitCallFuncValue(a, m, nilFuncs(), ins)
	if opsBytes(a) != 20 {
		return "func-value call (no user args, void) should emit 5 instrs (20 bytes)"
	}
	return ""
}

// Defensive guards: both lowerings must early-out on a malformed
// instruction with no Args, never emitting any bytes. Without
// these guards a missing Args[0] would crash the encoder.
func TestEmitCallIndirectEmptyArgsIsNoOp() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_INDIRECT
	emitCallIndirect(a, m, nilFuncs(), ins)
	if opsBytes(a) != 0 {
		return "indirect call with no Args should emit nothing"
	}
	return ""
}

func TestEmitCallFuncValueEmptyArgsIsNoOp() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_FUNC_VALUE
	emitCallFuncValue(a, m, nilFuncs(), ins)
	if opsBytes(a) != 0 {
		return "func-value call with no Args should emit nothing"
	}
	return ""
}

// makeFuncValueRefModule builds a one-function module that contains
// a single OP_FUNC_VALUE pointing at `host.foo`, whose signature is
// taken from sig.  Used by the shim-shape tests below — drives
// collectFuncValueRefs / emitFuncValueShims without going through
// the full IR-gen pipeline.
func makeFuncValueRefModule(sig @types.Type) @ir.Module {
	var mod @ir.Module = ir.NewModule("\"host\"")
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("host.caller", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	b.EmitFuncValue("host.foo", sig)
	mod.AddFunc(f)
	return mod
}

// emitFuncValueShims counts REGISTER WORDS (not params) when shifting
// X1..Xn → X0..X(n-1) to drop the closure-data slot.  A slice param
// occupies two consecutive arg-words (slice.data + slice.len), so for
// `*func(*[]const char) int` the shim must emit 2 MOVs + 1 B = 12
// bytes — NOT 1 MOV + 1 B = 8 bytes (the pre-7096a94 bug that read
// `len(fvTyp.Params)` directly).
func TestEmitFuncValueShimSliceParamCountsWords() testing.TestResult {
	setTarget64()
	// Build `*func(*[]const char) int64`.
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "s"
	p.Type = types.MakeSliceType(types.TypChar())
	params[0] = p
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt64()
	var fvTyp @types.Type = types.MakeFuncValueType(params, results)

	var mod @ir.Module = makeFuncValueRefModule(fvTyp)

	var a @asm.Assembler = opsMkAssembler()
	emitFuncValueShims(a, "host", mod)
	// Expected: 2 MOVs (nUserWords=2 for the 2-word slice) + 1 B = 12 bytes.
	// Buggy expectation (count params not words): 1 MOV + 1 B = 8 bytes.
	if opsBytes(a) != 12 {
		return "slice-param shim should emit 2 MOVs + 1 B (12 bytes); "
			"8 bytes means arg-words regressed to len(Params)"
	}
	return ""
}

// Scalar-only shim: `*func(int) int`.  One int param = 1 arg-word, so
// the shim shifts a single MOV (X0←X1) + 1 B = 8 bytes.  Pins the
// "params-count == word-count" path so the slice test above doesn't
// pass for the wrong reason.
func TestEmitFuncValueShimScalarParam() testing.TestResult {
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "x"
	p.Type = types.TypInt()
	params[0] = p
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var fvTyp @types.Type = types.MakeFuncValueType(params, results)

	var mod @ir.Module = makeFuncValueRefModule(fvTyp)

	var a @asm.Assembler = opsMkAssembler()
	emitFuncValueShims(a, "host", mod)
	if opsBytes(a) != 8 {
		return "scalar-param shim should emit 1 MOV + 1 B (8 bytes)"
	}
	return ""
}

// Zero-param shim emits just a B (4 bytes) — there's no arg to shift.
// Pins the loop's lower-bound behavior (nUserWords=0 → no MOVs).
func TestEmitFuncValueShimZeroParams() testing.TestResult {
	var params @[]@types.Param
	var results @[]@types.Type
	var fvTyp @types.Type = types.MakeFuncValueType(params, results)

	var mod @ir.Module = makeFuncValueRefModule(fvTyp)

	var a @asm.Assembler = opsMkAssembler()
	emitFuncValueShims(a, "host", mod)
	if opsBytes(a) != 4 {
		return "zero-param shim should emit just 1 B (4 bytes)"
	}
	return ""
}

// Pack-return aggregate shim: function value returning a 32-byte
// struct (e.g. rt.ManagedSlice = {Data, Len, Refptr, BackingLen}).
// The shim shape under the retbuf convention (matching what
// rt._call_shim_aggregate passes):
//   stp fp, lr, [sp, #-32]!   ; prologue
//   mov fp, sp
//   str x0, [sp, #16]         ; save retbuf
//   mov x0, x2                ; shift user arg 0 (drop data X1, skip retbuf X0)
//   mov x1, x3                ; shift user arg 1
//   bl underlying             ; → packs return into X0..X3
//   ldr x9, [sp, #16]         ; reload retbuf into X9 (no overlap with X0..X3)
//   str x0, [x9]              ; copy 4 return words through retbuf
//   str x1, [x9, #8]
//   str x2, [x9, #16]
//   str x3, [x9, #24]
//   ldp fp, lr, [sp], #32     ; epilogue
//   ret
// 13 4-byte instructions = 52 bytes.  Pre-fix this returned wrong
// values (sret-via-X8 was used, but Binate packs ≤64-byte returns
// into X0..X3 not via sret).  See
// TestExternRtMakeManagedSliceViaRegistry in pkg/vm for the end-to-
// end manifestation.
func TestEmitFuncValueShimPackReturn32() testing.TestResult {
	setTarget64()
	// Build `*func(int64, int64) Slice32` where Slice32 is 32 bytes.
	// int64 (not int) so the struct size is host-independent.
	var sliceFields @[]@types.Field = make_slice(@types.Field, 4)
	for i := 0; i < 4; i++ {
		var f @types.Field = make(types.Field)
		f.Type = types.TypInt64()
		sliceFields[i] = f
	}
	var sliceTyp @types.Type =
		types.MakeStructType("Slice32", sliceFields)
	var params @[]@types.Param = make_slice(@types.Param, 2)
	var p0 @types.Param = make(types.Param)
	p0.Name = "x"; p0.Type = types.TypInt64()
	params[0] = p0
	var p1 @types.Param = make(types.Param)
	p1.Name = "y"; p1.Type = types.TypInt64()
	params[1] = p1
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = sliceTyp
	var fvTyp @types.Type = types.MakeFuncValueType(params, results)

	var mod @ir.Module = makeFuncValueRefModule(fvTyp)

	var a @asm.Assembler = opsMkAssembler()
	emitFuncValueShims(a, "host", mod)
	// Expected: STP + MOV + STR + 2 MOV + BL + LDR + 4 STR + LDP + RET
	// = 13 instructions = 52 bytes.  Sret-tail-call would be only 4
	// instructions (24 bytes); scalar shim would be 12 (3*4).  This
	// byte count distinguishes all three paths.
	if opsBytes(a) != 52 {
		return "pack-return 32-byte shim should emit 13 instrs (52 bytes); "
			"24 means sret-tail-call regression"
	}
	return ""
}

// Sret-return aggregate shim: function value returning an 80-byte
// struct (10 ints — comfortably > 64).  Binate ABI uses AAPCS sret
// (X8 = retbuf) for these.  Shim shape:
//   mov x8, x0                ; retbuf → sret
//   mov x0, x2                ; user arg 0
//   mov x1, x3                ; user arg 1
//   b underlying              ; tail call
// 4 instructions = 16 bytes.
func TestEmitFuncValueShimSretReturn80() testing.TestResult {
	setTarget64()
	var bigFields @[]@types.Field = make_slice(@types.Field, 10)
	for i := 0; i < 10; i++ {
		var f @types.Field = make(types.Field)
		f.Type = types.TypInt64()
		bigFields[i] = f
	}
	var bigTyp @types.Type =
		types.MakeStructType("Big80", bigFields)
	var params @[]@types.Param = make_slice(@types.Param, 2)
	var p0 @types.Param = make(types.Param)
	p0.Name = "x"; p0.Type = types.TypInt64()
	params[0] = p0
	var p1 @types.Param = make(types.Param)
	p1.Name = "y"; p1.Type = types.TypInt64()
	params[1] = p1
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = bigTyp
	var fvTyp @types.Type = types.MakeFuncValueType(params, results)

	var mod @ir.Module = makeFuncValueRefModule(fvTyp)

	var a @asm.Assembler = opsMkAssembler()
	emitFuncValueShims(a, "host", mod)
	if opsBytes(a) != 16 {
		return "sret-return >64-byte shim should emit 4 instrs (16 bytes)"
	}
	return ""
}

// emitCallIndirect with many scalar args used to walk len(args)
// getOperand calls without resetting the regmap between args, each
// of which advanced rm.Next; nine scalar args saturated the X9..X17
// scratch pool and tripped the regPool panic (op=50 in CI logs).
// Mirrors the OP_RETURN fix from d0e8a41 / TestEmitReturnManyValues.
// Survival is the test — pre-fix this panicked on the 8th arg.
func TestEmitCallIndirectManyArgsDoesNotSaturateRegPool() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// fn_ptr at spill 0, plus 9 int scalar args at unique spills.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var nArgs int = 9
	var args @[]@ir.Instr = make_slice(@ir.Instr, nArgs + 1)
	var fnPtr @ir.Instr = make(ir.Instr)
	fnPtr.ID = 5
	args[0] = fnPtr
	for i := 0; i < nArgs; i++ {
		rm.SpillIDs = common.AppendInt(rm.SpillIDs, 100 + i)
		rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8 + 8 * i)
		var arg @ir.Instr = make(ir.Instr)
		arg.ID = 100 + i
		arg.Typ = types.TypInt()
		args[i + 1] = arg
	}
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_INDIRECT
	ins.Args = args
	emitCallIndirect(a, rm, nilFuncs(), ins)
	if opsBytes(a) == 0 {
		return "OP_CALL_INDIRECT many-args must emit at least one instruction"
	}
	return ""
}

// findSymbolByName scans the assembler's symbol table for `name`
// (exact byte match) and returns its index, or -1 if absent.
func findSymbolByName(a @asm.Assembler, name *[]const char) int {
	for i := 0; i < a.NumSymbols; i++ {
		var s @[]char = a.Symbols[i].Name
		if len(s) != len(name) { continue }
		var match bool = true
		for j := 0; j < len(name); j++ {
			if s[j] != name[j] { match = false; break }
		}
		if match { return i }
	}
	return -1
}

// EmitObject calls emitFuncValueShims BEFORE emitFuncValueVtables,
// which in turn references the shim via EmitAddr + a SetGlobal call
// to record the relocation target.  That SetGlobal must NOT downgrade
// the WEAK binding emitFuncValueShims established — if it does, two
// .o files that both emit the same shim (cmd/bni's bni.o and pkg/vm's
// vm.o under builder-comp_native_aa64-comp_native_aa64) collide at link
// time with `duplicate symbol _bn_host__foo__shim`.
//
// Pins the post-condition by running both emitters in EmitObject's
// order, then checking the shim symbol's binding directly.  The
// pkg/asm/asm_test.bn:TestSetGlobalPreservesWeak test pins the
// generic SetGlobal rule; this one pins the rule's application to
// the specific funcvalue emit shape that triggered the bug.
func TestEmitFuncValueShimsAndVtablesKeepShimWeak() testing.TestResult {
	var params @[]@types.Param
	var results @[]@types.Type
	var fvTyp @types.Type = types.MakeFuncValueType(params, results)
	var mod @ir.Module = makeFuncValueRefModule(fvTyp)

	var a @asm.Assembler = asm.New(8)
	emitFuncValueShims(a, "host", mod)
	emitFuncValueVtables(a, "host", mod)

	var shim @[]char = "_bn_host__foo__shim"
	var idx int = findSymbolByName(a, shim)
	if idx < 0 { return fail("shim symbol not registered") }
	if a.Symbols[idx].Binding != asm.BIND_WEAK {
		return fail(
			"shim symbol should be BIND_WEAK; if BIND_GLOBAL, "
			"emitFuncValueVtables' SetGlobal demoted it (bug repro)")
	}
	var vt @[]char = "_bn_host__foo__vt"
	var vtIdx int = findSymbolByName(a, vt)
	if vtIdx < 0 { return fail("vtable symbol not registered") }
	if a.Symbols[vtIdx].Binding != asm.BIND_WEAK {
		return fail("vtable symbol should be BIND_WEAK")
	}
	return ""
}

// emitCallFuncValue counterpart of the regression test above.  Long
// arg list through a function value (which lowers to OP_CALL_FUNC_VALUE,
// the always-shim convention) used to saturate the same X9..X17 pool —
// each user arg consumes a scratch slot via getOperand and the
// pre-fix loop never reset between args.  Same op=50-class panic.
func TestEmitCallFuncValueManyArgsDoesNotSaturateRegPool() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// fv address at spill 0, plus 9 int scalar args at unique spills.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var nArgs int = 9
	var args @[]@ir.Instr = make_slice(@ir.Instr, nArgs + 1)
	var fvAddr @ir.Instr = make(ir.Instr)
	fvAddr.ID = 5
	args[0] = fvAddr
	for i := 0; i < nArgs; i++ {
		rm.SpillIDs = common.AppendInt(rm.SpillIDs, 100 + i)
		rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8 + 8 * i)
		var arg @ir.Instr = make(ir.Instr)
		arg.ID = 100 + i
		arg.Typ = types.TypInt()
		args[i + 1] = arg
	}
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_FUNC_VALUE
	ins.Args = args
	emitCallFuncValue(a, rm, nilFuncs(), ins)
	if opsBytes(a) == 0 {
		return "OP_CALL_FUNC_VALUE many-args must emit at least one instruction"
	}
	return ""
}
