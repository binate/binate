package "pkg/native/aarch64"

import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/types"

// Tests for aarch64_closure_shim.bn (B.2 of plan-function-values
// -phase-2.md).  End-to-end behavior is covered by
// conformance/501_capture_value in builder-comp_native_aa64-comp_
// native_aa64; these tests pin the helper-level behavior.

// lookupClosureFuncAA64 returns the Func when it's a closure and
// nil when it isn't or isn't in the module.
func TestLookupClosureFuncFound() testing.TestResult {
	var fields @[]@types.Field
	var closureStruct @types.Type = types.MakeStructType("__closure_x", fields)
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_0"
	f.IsClosure = true
	f.NumCaptureParams = 1
	f.ClosureStruct = closureStruct
	var mod @ir.Module = ir.NewModule("test")
	mod.AddFunc(f)
	var got @ir.Func = lookupClosureFuncAA64(mod, "main.__funclit_0")
	if got == nil { return fail("expected to find closure func") }
	if !got.IsClosure { return fail("expected IsClosure=true") }
	return ""
}

func TestLookupClosureFuncNotClosure() testing.TestResult {
	var f @ir.Func = make(ir.Func)
	f.Name = "main.Plain"
	f.IsClosure = false
	var mod @ir.Module = ir.NewModule("test")
	mod.AddFunc(f)
	var got @ir.Func = lookupClosureFuncAA64(mod, "main.Plain")
	if got != nil {
		return fail("expected nil for non-closure func")
	}
	return ""
}

func TestLookupClosureFuncMissing() testing.TestResult {
	var mod @ir.Module = ir.NewModule("test")
	var got @ir.Func = lookupClosureFuncAA64(mod, "nonexistent")
	if got != nil {
		return fail("expected nil for missing func")
	}
	return ""
}
