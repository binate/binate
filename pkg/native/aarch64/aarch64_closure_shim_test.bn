package "pkg/native/aarch64"

import "pkg/asm"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/ir"

// Byte-count constants for shim-shape pinning.  Each AArch64
// instruction is 4 bytes.

// Tests for aarch64_closure_shim.bn (B.2 of plan-function-values
// -phase-2.md).  End-to-end behavior is covered by
// conformance/501_capture_value in builder-comp_native_aa64-comp_
// native_aa64; these tests pin the helper-level behavior.

// lookupClosureFuncAA64 returns the Func when it's a closure and
// nil when it isn't or isn't in the module.
func TestLookupClosureFuncFound() testing.TestResult {
	var fields @[]@types.Field
	var closureStruct @types.Type = types.MakeStructType("__closure_x", fields)
	var f @ir.Func = make(ir.Func)
	f.Name = "main.__funclit_0"
	f.IsClosure = true
	f.NumCaptureParams = 1
	f.ClosureStruct = closureStruct
	var mod @ir.Module = ir.NewModule("test")
	mod.AddFunc(f)
	var got @ir.Func = lookupClosureFuncAA64(mod, "main.__funclit_0")
	if got == nil { return fail("expected to find closure func") }
	if !got.IsClosure { return fail("expected IsClosure=true") }
	return ""
}

func TestLookupClosureFuncNotClosure() testing.TestResult {
	var f @ir.Func = make(ir.Func)
	f.Name = "main.Plain"
	f.IsClosure = false
	var mod @ir.Module = ir.NewModule("test")
	mod.AddFunc(f)
	var got @ir.Func = lookupClosureFuncAA64(mod, "main.Plain")
	if got != nil {
		return fail("expected nil for non-closure func")
	}
	return ""
}

func TestLookupClosureFuncMissing() testing.TestResult {
	var mod @ir.Module = ir.NewModule("test")
	var got @ir.Func = lookupClosureFuncAA64(mod, "nonexistent")
	if got != nil {
		return fail("expected nil for missing func")
	}
	return ""
}

// emitClosureShim with 1 capture and 0 user args emits:
//   LDR X0, [X0, #0]        ; load capture0 from base — overwrites
//                           ; X0 last (i=0 self-load)
//   B underlying_fn         ; tail-branch
// Two 4-byte AArch64 instructions = 8 bytes.  No user-arg shifts
// because there are no user args, and N==1 means the loop covers
// only i=0 (the X0 self-load).
func TestEmitClosureShim1Cap0UserArgs() testing.TestResult {
	var f @ir.Func = closureFuncSingleIntCapture()
	var fvTyp @types.Type = funcValueTypeNoArgsRetInt()
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim(a, "underlying", fvTyp, f)
	if opsBytes(a) != 8 {
		return fail("1-cap/0-user shim should emit 2 instrs (8 bytes)")
	}
	return ""
}

// emitClosureShim with 1 capture and 1 user int arg emits:
//   <user-arg shift X1 -> X1 is skipped because src == dst when N==1>
//   LDR X0, [X0, #0]        ; load capture0 from base
//   B underlying_fn         ; tail-branch
// Still 8 bytes — the N==1 case never moves user args (shift
// amount is 0).
func TestEmitClosureShim1Cap1UserArg() testing.TestResult {
	var f @ir.Func = closureFuncSingleIntCapture1UserArg()
	var fvTyp @types.Type = funcValueType1IntArg()
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim(a, "underlying", fvTyp, f)
	if opsBytes(a) != 8 {
		return fail("1-cap/1-user shim should emit 2 instrs (8 bytes)")
	}
	return ""
}

// emitClosureShim with 2 captures and 1 user int arg emits:
//   MOV X2, X1              ; shift user arg up by N-1 = 1
//   LDR X1, [X0, #8]        ; load capture1 from base
//   LDR X0, [X0, #0]        ; load capture0 from base (X0 last)
//   B underlying_fn         ; tail-branch
// Four 4-byte AArch64 instructions = 16 bytes.  Pins the right-
// to-left ordering of both the user-arg shift (j=0 → X2 <- X1)
// and the capture loads (i=1 then i=0 so X0 stays valid as base).
func TestEmitClosureShim2Cap1UserArg() testing.TestResult {
	var f @ir.Func = closureFuncTwoIntCaptures1UserArg()
	var fvTyp @types.Type = funcValueType1IntArg()
	var a @asm.Assembler = opsMkAssembler()
	emitClosureShim(a, "underlying", fvTyp, f)
	if opsBytes(a) != 16 {
		return fail("2-cap/1-user shim should emit 4 instrs (16 bytes)")
	}
	return ""
}

// Nine int captures used to fall back to a plain `B` (4 bytes —
// the absolute minimum the assembler can emit) when the
// register-arg budget was exhausted.  Now that the shim emits a
// stack-spill prologue for the overflow word, the > 8-word case
// generates a SUB sp + Ldr/Str shuttles + BL + ADD sp + RET
// sequence — much larger than 4 bytes, but functionally correct
// instead of a silent wrong-code fallback.  Assert the new shape:
// strictly LARGER than the simplest real shim, reflecting that the
// 9th int's stack word triggers the spill path.
func TestEmitClosureShimOverBudgetStackSpill() testing.TestResult {
	var fSimple @ir.Func = closureFuncSingleIntCapture()
	var fvSimple @types.Type = funcValueTypeNoArgsRetInt()
	var aSimple @asm.Assembler = opsMkAssembler()
	emitClosureShim(aSimple, "underlying", fvSimple, fSimple)
	var bytesSimple int = opsBytes(aSimple)

	var fBig @ir.Func = closureFuncManyCaptures(9)
	var fvBig @types.Type = funcValueTypeNoArgsRetInt()
	var aBig @asm.Assembler = opsMkAssembler()
	emitClosureShim(aBig, "underlying", fvBig, fBig)
	var bytesBig int = opsBytes(aBig)

	if bytesBig <= bytesSimple {
		return fail("9-cap stack-spill shim should be larger than 1-cap fast path")
	}
	return ""
}

// ============================================================
// Helpers
// ============================================================

// closureFuncSingleIntCapture builds a minimal IsClosure Func
// with one int capture — the simplest shape for shim-shape tests.
func closureFuncSingleIntCapture() @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	var fx @types.Field = make(types.Field)
	fx.Name = "x"
	fx.Type = types.TypInt()
	fields[0] = fx
	var cs @types.Type = types.MakeStructType("__closure_1", fields)
	var f @ir.Func = ir.NewFunc("main.__funclit_0",
		make_slice(@ir.Param, 0), make_slice(@types.Type, 0))
	var p @ir.Param = ir.NewParam(f, "x", types.TypInt())
	var params @[]@ir.Param = make_slice(@ir.Param, 1)
	params[0] = p
	f.Params = params
	f.IsClosure = true
	f.NumCaptureParams = 1
	f.ClosureStruct = cs
	return f
}

// closureFuncSingleIntCapture1UserArg adds one user-int param
// to the single-capture closure.
func closureFuncSingleIntCapture1UserArg() @ir.Func {
	var f @ir.Func = closureFuncSingleIntCapture()
	var u @ir.Param = ir.NewParam(f, "y", types.TypInt())
	var params @[]@ir.Param = make_slice(@ir.Param, 2)
	params[0] = f.Params[0]
	params[1] = u
	f.Params = params
	return f
}

// closureFuncTwoIntCaptures1UserArg: two int captures + one
// user int arg.  Exercises both the user-arg shift and the
// right-to-left capture load.
func closureFuncTwoIntCaptures1UserArg() @ir.Func {
	// int64 (not int) so closure-struct field sizes are host-
	// independent and the shim's expected byte-count assertions
	// hold regardless of test runner architecture.
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	var fx @types.Field = make(types.Field)
	fx.Name = "x"
	fx.Type = types.TypInt64()
	fields[0] = fx
	var fy @types.Field = make(types.Field)
	fy.Name = "y"
	fy.Type = types.TypInt64()
	fields[1] = fy
	var cs @types.Type = types.MakeStructType("__closure_2", fields)
	var f @ir.Func = ir.NewFunc("main.__funclit_0",
		make_slice(@ir.Param, 0), make_slice(@types.Type, 0))
	var p0 @ir.Param = ir.NewParam(f, "x", types.TypInt64())
	var p1 @ir.Param = ir.NewParam(f, "y", types.TypInt64())
	var p2 @ir.Param = ir.NewParam(f, "z", types.TypInt64())
	var params @[]@ir.Param = make_slice(@ir.Param, 3)
	params[0] = p0
	params[1] = p1
	params[2] = p2
	f.Params = params
	f.IsClosure = true
	f.NumCaptureParams = 2
	f.ClosureStruct = cs
	return f
}

// closureFuncManyCaptures builds a closure with N int captures
// and no user args — exercises the over-budget fallback.
func closureFuncManyCaptures(n int) @ir.Func {
	var fields @[]@types.Field = make_slice(@types.Field, n)
	for i := 0; i < n; i++ {
		var fi @types.Field = make(types.Field)
		fi.Name = "c"
		fi.Type = types.TypInt()
		fields[i] = fi
	}
	var cs @types.Type = types.MakeStructType("__closure_many", fields)
	var f @ir.Func = ir.NewFunc("main.__funclit_0",
		make_slice(@ir.Param, 0), make_slice(@types.Type, 0))
	var params @[]@ir.Param = make_slice(@ir.Param, n)
	for i := 0; i < n; i++ {
		params[i] = ir.NewParam(f, "c", types.TypInt())
	}
	f.Params = params
	f.IsClosure = true
	f.NumCaptureParams = n
	f.ClosureStruct = cs
	return f
}

// funcValueTypeNoArgsRetInt builds *func() int — single int
// return, no user args.
func funcValueTypeNoArgsRetInt() @types.Type {
	var params @[]@types.Param
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	return types.MakeFuncValueType(params, results)
}

// funcValueType1IntArg builds *func(int) int.
func funcValueType1IntArg() @types.Type {
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "y"
	p.Type = types.TypInt()
	params[0] = p
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	return types.MakeFuncValueType(params, results)
}
