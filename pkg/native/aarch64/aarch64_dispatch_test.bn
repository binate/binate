package "pkg/native/aarch64"

import "pkg/asm"
import "pkg/binate/buf"
import "pkg/bootstrap"
import "pkg/builtins/testing"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// Coverage for arm64_dispatch.bn — emitInstr is the per-instruction
// selector that fans out to all the op-family handlers (alloc, call,
// load/store, refcount, etc.). Most coverage is end-to-end via
// EmitObject + clang round-trips like the test below; per-handler
// unit tests live in arm64_ops_test.bn / arm64_call_test.bn /
// arm64_emit_test.bn alongside their handlers.

// Build a program equivalent to `bootstrap.Exit(42)` and verify it
// links with the C runtime and that the resulting process exits 42.
// Exercises emitInstr's OP_CONST_INT + OP_CALL + OP_RETURN arms,
// plus the prologue/epilogue glue that wraps the dispatcher.
// Helpers (canLinkAndRun, findRuntimePath, findTestStubsPath, fail)
// live in arm64_test.bn — same package, shared scope.
func TestEmitCallExitsWithCode() testing.TestResult {
	if !canLinkAndRun() { return "" }

	var rt @[]char = findRuntimePath()
	if len(rt) == 0 { return "" }
	var stubs @[]char = findTestStubsPath()
	if len(stubs) == 0 { return "" }

	var m @ir.Module = ir.NewModule("\"main\"")
	// Use `__entry` as the function name: with module pkg "main"
	// it mangles to the linker symbol `bn_entry`, which the C
	// runtime's bootstrap main() calls.  Naming it `main` would
	// produce `bn_main__main` and leave bn_entry undefined.
	var f @ir.Func = ir.NewFunc("__entry", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")

	// v0 = 42 : int
	var c42 @ir.Instr = b.EmitConstInt(42, types.TypInt())
	// call bootstrap.Exit(v0) — void return
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = c42
	b.EmitCall("pkg/bootstrap.Exit", args, types.TypVoid())
	b.EmitReturn(noArgs)
	m.AddFunc(f)

	var objPath *[]const char = "/tmp/binate_native_exit42.o"
	if !EmitObject(m, "macho", objPath) { return fail("EmitObject returned false") }

	var exePath *[]const char = "/tmp/binate_native_exit42"
	var largs @[]@[]char = make_slice(@[]char, 6)
	largs[0] = buf.CopyStr("-w")
	largs[1] = buf.CopyStr("-o")
	largs[2] = buf.CopyStr(exePath)
	largs[3] = buf.CopyStr(objPath)
	largs[4] = buf.CopyStr(rt)
	largs[5] = buf.CopyStr(stubs)
	if bootstrap.Exec("clang", largs) != 0 {
		return fail("clang link failed")
	}

	var runArgs @[]@[]char = make_slice(@[]char, 0)
	var rc int = bootstrap.Exec(exePath, runArgs)
	if rc != 42 {
		return fail("expected exit 42")
	}
	return ""
}

// emitInstr's OP_SP_RESTORE arm is a deliberate no-op on the native
// backend: PlanFrame already sized this function's frame at prologue
// time and spill slots are function-scoped, so there's nothing to
// reclaim mid-function. Pin the byte count: an OP_SP_RESTORE Instr
// must produce ZERO bytes of code (otherwise we'd be silently
// corrupting the surrounding instruction stream). Helpers (mkAsm,
// bytesWritten) live in arm64_emit_test.bn — same package.
func TestEmitSPRestoreNativeNoop() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_SP_RESTORE
	var noStrings @[]ir.StringConst
	var noFuncsLocal @[]@ir.Func
	emitInstr(a, "main", "fn", rm, noStrings, noFuncsLocal, ins)
	if bytesWritten(a) != 0 {
		return fail("OP_SP_RESTORE must emit zero bytes on native arm64")
	}
	return ""
}

// OP_RETURN multi-return (pack into X0..X7) used to walk
// `len(ins.Args)` getOperand calls without resetting the regmap
// between args.  Each getOperand on a spill-mapped ID advances
// rm.Next; nine scalar return values would saturate the X9..X15
// scratch pool and trip the regPool panic.  emitCall solved the
// same issue (arm64_call.bn) by resetting between args — emitReturn
// now does too.  Pkg/asm/parse triggered this in CI:
// "regPool exhausted while emitting op=45 (OP_RETURN)".
func TestEmitReturnManyValuesDoesNotSaturateRegPool() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Build nine scalar int return values, each backed by a unique
	// spill slot so getOperand has to reload.  Without the per-arg
	// regmap reset the 8th iteration's nextReg(rm) panics; with the
	// fix the loop produces nine moves (or Ldrs into argReg) and
	// reaches the epilogue.
	var nArgs int = 9
	var args @[]@ir.Instr = make_slice(@ir.Instr, nArgs)
	for i := 0; i < nArgs; i++ {
		rm.SpillIDs = common.AppendInt(rm.SpillIDs, 100 + i)
		rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8 * i)
		var arg @ir.Instr = make(ir.Instr)
		arg.ID = 100 + i
		arg.Typ = types.TypInt()
		args[i] = arg
	}
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_RETURN
	ins.Args = args
	var noStrings @[]ir.StringConst
	var noFuncsLocal @[]@ir.Func
	emitInstr(a, "main", "fn", rm, noStrings, noFuncsLocal, ins)
	// Survival is the test — pre-fix this panicked on the 8th arg.
	// The exact byte count varies with epilogue layout; just check
	// something was emitted.
	if bytesWritten(a) == 0 {
		return fail("OP_RETURN multi-return must emit at least one instruction")
	}
	return ""
}
