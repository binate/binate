package "pkg/native/aarch64"

import "pkg/asm"
import "pkg/asm/aarch64"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// Floating-point lowering for the AArch64 backend.
//
// Strategy (see explorations/plan-native-floats.md): all values
// (including floats) live in 8-byte GP-spill slots. Float values
// briefly occupy D regs only for the duration of one arithmetic
// op, FMOV'd in from a GP scratch and back out. This avoids a
// separate FP regalloc and lets all spill traffic continue to use
// the existing X-LDR/STR.
//
// We use D16 / D17 as inline FP scratch — caller-saved per AAPCS,
// no save/restore needed.
//
// **Bootstrap-subset constraint**: this package is parsed and
// interpreted by the Go bootstrap when it runs cmd/bnc. The
// bootstrap can't lex float literals, so this file uses ONLY
// integer arithmetic; the decimal-string-to-double-bits converter
// builds IEEE 754 patterns by hand.

// FP_SCRATCH_A is the inline FP scratch register holding the LHS / first operand.
const FP_SCRATCH_A int = aarch64.D16
// FP_SCRATCH_B is the inline FP scratch register holding the RHS / second operand.
const FP_SCRATCH_B int = aarch64.D17

// IsFloatTyp reports whether t is a TYP_FLOAT or TYP_UNTYPED_FLOAT.
func isFloatTyp(t @types.Type) bool {
	if t == nil { return false }
	return t.Kind == types.TYP_FLOAT || t.Kind == types.TYP_UNTYPED_FLOAT
}

// ============================================================
// Decimal float literal → IEEE 754 double bits (integer-only)
// ============================================================

// uintBitLen returns the number of bits required to represent n
// (i.e., 1 + floor(log2(n)); 0 for n=0).
func uintBitLen(n uint64) int {
	var b int = 0
	for n > 0 {
		b = b + 1
		n = n >> 1
	}
	return b
}

// uintToDoubleBits converts a non-negative uint64 to the bit pattern
// of its IEEE 754 double-precision representation. Loses precision
// for k > 2^53; sufficient for the literal mantissas our tests use.
func uintToDoubleBits(k uint64) uint64 {
	if k == 0 { return cast(uint64, 0) }
	var bl int = uintBitLen(k)
	var e int = bl - 1
	var mantissa uint64
	if e <= 52 {
		mantissa = k << cast(uint64, 52 - e)
	} else {
		var shift int = e - 52
		var half uint64 = cast(uint64, 1) << cast(uint64, shift - 1)
		mantissa = (k + half) >> cast(uint64, shift)
		var limit uint64 = cast(uint64, 1) << 53
		if mantissa >= limit {
			mantissa = mantissa >> 1
			e = e + 1
		}
	}
	var fracMask uint64 = (cast(uint64, 1) << 52) - 1
	var frac uint64 = mantissa & fracMask
	var bexp uint64 = cast(uint64, e + 1023)
	return (bexp << 52) | frac
}

// divToDoubleBits converts n/d (d > 0, both non-negative) to the bit
// pattern of an IEEE 754 double. Same precision caveat as above.
func divToDoubleBits(n uint64, d uint64) uint64 {
	if n == 0 { return cast(uint64, 0) }
	var bitsN int = uintBitLen(n)
	var bitsD int = uintBitLen(d)
	// We want (n << k) / d in [2^52, 2^53). The exponent of the
	// quotient is bitsN + k - bitsD - 1 (approximately).
	// Set k so bitsN + k - bitsD = 53 → k = 53 - bitsN + bitsD.
	var k int = 53 - bitsN + bitsD
	var nshift uint64
	if k >= 0 {
		nshift = n << cast(uint64, k)
	} else {
		nshift = n >> cast(uint64, -k)
	}
	var mantissa uint64 = nshift / d
	var rem uint64 = nshift - mantissa * d
	// Round half-to-even (simplified to half-up — sufficient for the
	// literals our tests probe).
	if 2 * rem >= d {
		mantissa = mantissa + 1
	}
	// Normalize: mantissa should land in [2^52, 2^53). If it
	// overflowed up to 2^53 (rounding), shift back; if our k
	// estimate was off by one, adjust either way.
	var hi uint64 = cast(uint64, 1) << 53
	var lo uint64 = cast(uint64, 1) << 52
	for mantissa >= hi {
		mantissa = mantissa >> 1
		k = k - 1
	}
	for mantissa < lo && mantissa > 0 {
		mantissa = mantissa << 1
		k = k + 1
	}
	// value = mantissa * 2^(-k); since mantissa = m * 2^52 (with
	// m ∈ [1, 2)), value = m * 2^(52 - k). Biased exponent = 52 - k + 1023.
	var bexp int = 52 - k + 1023
	var fracMask uint64 = (cast(uint64, 1) << 52) - 1
	var frac uint64 = mantissa & fracMask
	return (cast(uint64, bexp) << 52) | frac
}

// pow10 returns 10^n as uint64 for n in [0, ~19]. Above that, the
// caller should chain divisions; tests don't probe that range.
func pow10(n int) uint64 {
	var r uint64 = 1
	for i := 0; i < n; i++ {
		r = r * 10
	}
	return r
}

// parseFloatLitToBits converts a decimal float literal text (no sign
// — the IR strips leading '-' into OP_NEG) to its IEEE 754 double
// bit pattern. Accepts the lexer-produced forms:
//   <digits>
//   <digits>.<digits>
//   .<digits>
//   <mantissa>[eE][+-]?<digits>
func parseFloatLitToBits(text *[]const char) uint64 {
	var n int = len(text)
	if n == 0 { return cast(uint64, 0) }

	var mantInt uint64 = 0
	var i int = 0
	for i < n && text[i] >= '0' && text[i] <= '9' {
		mantInt = mantInt * 10 +
			cast(uint64, cast(int, text[i]) - cast(int, '0'))
		i = i + 1
	}
	var fracDigits int = 0
	if i < n && text[i] == '.' {
		i = i + 1
		for i < n && text[i] >= '0' && text[i] <= '9' {
			mantInt = mantInt * 10 +
				cast(uint64, cast(int, text[i]) - cast(int, '0'))
			fracDigits = fracDigits + 1
			i = i + 1
		}
	}
	var expSign int = 1
	var expVal int = 0
	if i < n && (text[i] == 'e' || text[i] == 'E') {
		i = i + 1
		if i < n && text[i] == '-' {
			expSign = -1
			i = i + 1
		} else if i < n && text[i] == '+' {
			i = i + 1
		}
		for i < n && text[i] >= '0' && text[i] <= '9' {
			expVal = expVal * 10 +
				(cast(int, text[i]) - cast(int, '0'))
			i = i + 1
		}
	}
	if expSign < 0 { expVal = -expVal }
	// Net decimal shift: value = mantInt * 10^(expVal - fracDigits).
	var netExp int = expVal - fracDigits
	if netExp >= 0 {
		// Integer value: mantInt * 10^netExp.
		var k uint64 = mantInt
		for j := 0; j < netExp; j++ {
			k = k * 10
		}
		return uintToDoubleBits(k)
	}
	// Fractional: mantInt / 10^(-netExp).
	var d uint64 = pow10(-netExp)
	return divToDoubleBits(mantInt, d)
}

// ============================================================
// FP op emitters
// ============================================================

// emitConstFloat: OP_CONST_FLOAT — convert the literal to IEEE 754
// bits and load via the standard MOVZ+MOVK chain. The bits live in
// the GP scratch / spill slot like any other 64-bit value.
func emitConstFloat(a @asm.Assembler, rd int, ins @ir.Instr) {
	var bits uint64 = parseFloatLitToBits(ins.StrVal)
	// cast(int64, …) reinterprets the full 64-bit IEEE pattern;
	// cast(int, …) would drop the high 32 bits on a 32-bit host.
	emitConstInt64(a, rd, cast(int64, bits))
}

// emitFloatBinop: OP_ADD/SUB/MUL/DIV when the result is float. Operands
// are spilled GP regs; we FMOV them into D scratches, run the FP
// instruction, and FMOV the result back. Returns true if the op was
// handled (i.e. ins.Typ was a float).
func emitFloatBinop(a @asm.Assembler, rm @common.RegMap,
		ins @ir.Instr) bool {
	if !isFloatTyp(ins.Typ) { return false }
	if len(ins.Args) < 2 { return false }
	var ra int = getOperand(a, rm, ins.Args[0].ID)
	var rb int = getOperand(a, rm, ins.Args[1].ID)
	if ra < 0 || rb < 0 { return false }
	aarch64.Fmov_gp_to_fp(a, FP_SCRATCH_A, ra)
	aarch64.Fmov_gp_to_fp(a, FP_SCRATCH_B, rb)
	if ins.Op == ir.OP_ADD {
		aarch64.Fadd(a, FP_SCRATCH_A, FP_SCRATCH_A, FP_SCRATCH_B)
	} else if ins.Op == ir.OP_SUB {
		aarch64.Fsub(a, FP_SCRATCH_A, FP_SCRATCH_A, FP_SCRATCH_B)
	} else if ins.Op == ir.OP_MUL {
		aarch64.Fmul(a, FP_SCRATCH_A, FP_SCRATCH_A, FP_SCRATCH_B)
	} else if ins.Op == ir.OP_DIV {
		aarch64.Fdiv(a, FP_SCRATCH_A, FP_SCRATCH_A, FP_SCRATCH_B)
	} else {
		return false
	}
	var rd int = nextReg(rm, ins.ID)
	aarch64.Fmov_fp_to_gp(a, rd, FP_SCRATCH_A)
	return true
}

// emitFloatNeg: OP_NEG on a float. FNEG via D scratch.
func emitFloatNeg(a @asm.Assembler, rm @common.RegMap,
		ins @ir.Instr) bool {
	if !isFloatTyp(ins.Typ) { return false }
	if len(ins.Args) < 1 { return false }
	var ra int = getOperand(a, rm, ins.Args[0].ID)
	if ra < 0 { return false }
	aarch64.Fmov_gp_to_fp(a, FP_SCRATCH_A, ra)
	aarch64.Fneg(a, FP_SCRATCH_A, FP_SCRATCH_A)
	var rd int = nextReg(rm, ins.ID)
	aarch64.Fmov_fp_to_gp(a, rd, FP_SCRATCH_A)
	return true
}

// floatBitWidth returns 32 for float32, 64 for float64 / untyped-float.
func floatBitWidth(t @types.Type) int {
	if t == nil { return 64 }
	if t.Kind == types.TYP_UNTYPED_FLOAT { return 64 }
	if t.Kind == types.TYP_FLOAT && t.Width == 32 { return 32 }
	return 64
}

// emitFloatCast: OP_CAST when source or target is a float. Returns
// true if handled. Cases:
//   int → float64    : SCVTF (D, X)
//   int → float32    : SCVTF (D, X), FCVT (S, D), FMOV (W, S)
//   float64 → int    : FCVTZS (X, D), round-toward-zero
//   float32 → int    : FMOV (S, W), FCVT (D, S), FCVTZS (X, D)
//   float32 → float64: FMOV (S, W), FCVT (D, S), FMOV (X, D)
//   float64 → float32: FMOV (D, X), FCVT (S, D), FMOV (W, S)
//   same-width float→float: plain Mov.
//
// Spill slot for float32 holds the 32-bit pattern in the low half
// (STR W). float64 fills all 8 bytes.
func emitFloatCast(a @asm.Assembler, rd int, src int,
		srcTyp @types.Type, dstTyp @types.Type) bool {
	var srcF bool = isFloatTyp(srcTyp)
	var dstF bool = isFloatTyp(dstTyp)
	if !srcF && !dstF { return false }
	var srcW int = 64
	var dstW int = 64
	if srcF { srcW = floatBitWidth(srcTyp) }
	if dstF { dstW = floatBitWidth(dstTyp) }

	if srcF && dstF {
		if srcW == dstW {
			aarch64.Mov(a, true, rd, aarch64.Reg(src))
			return true
		}
		if srcW == 32 && dstW == 64 {
			// f32 → f64: load low 32 bits into S, widen, dump back to GP.
			aarch64.Fmov_w_to_s(a, FP_SCRATCH_A, src)
			aarch64.Fcvt_s_to_d(a, FP_SCRATCH_A, FP_SCRATCH_A)
			aarch64.Fmov_fp_to_gp(a, rd, FP_SCRATCH_A)
			return true
		}
		// f64 → f32.
		aarch64.Fmov_gp_to_fp(a, FP_SCRATCH_A, src)
		aarch64.Fcvt_d_to_s(a, FP_SCRATCH_A, FP_SCRATCH_A)
		aarch64.Fmov_s_to_w(a, rd, FP_SCRATCH_A)
		return true
	}
	if !srcF && dstF {
		// Int → float. Always go via D first, then narrow if dst is f32.
		aarch64.Scvtf(a, FP_SCRATCH_A, src)
		if dstW == 32 {
			aarch64.Fcvt_d_to_s(a, FP_SCRATCH_A, FP_SCRATCH_A)
			aarch64.Fmov_s_to_w(a, rd, FP_SCRATCH_A)
		} else {
			aarch64.Fmov_fp_to_gp(a, rd, FP_SCRATCH_A)
		}
		return true
	}
	// Float → int. If src is f32, widen to D first; FCVTZS works on D.
	if srcW == 32 {
		aarch64.Fmov_w_to_s(a, FP_SCRATCH_A, src)
		aarch64.Fcvt_s_to_d(a, FP_SCRATCH_A, FP_SCRATCH_A)
	} else {
		aarch64.Fmov_gp_to_fp(a, FP_SCRATCH_A, src)
	}
	aarch64.Fcvtzs(a, rd, FP_SCRATCH_A)
	return true
}
