package "pkg/native/aarch64"

import "pkg/asm"
import "pkg/asm/aarch64"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// floatMkAssembler / floatBytes — local shorthand mirroring the ones
// in arm64_ops_test.bn so this file can stand alone.
func floatMkAssembler() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func floatBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// ============================================================
// parseFloatLitToBits — integer-only IEEE 754 builder
// ============================================================
//
// This function is the riskiest piece of the float subsystem: pure
// integer arithmetic emulating decimal-to-binary float conversion,
// with no float ops to fall back on. The expected bit patterns are
// hard-coded IEEE 754 doubles cross-checked against `printf "%a"`
// and Go's strconv.

func TestParseFloatZero() testing.TestResult {
	var bits uint64 = parseFloatLitToBits("0")
	if bits != cast(uint64, 0) { return "0 should be all-zero bits" }
	return ""
}

func TestParseFloatOne() testing.TestResult {
	// 1.0 = sign=0, exp=1023, frac=0 → 0x3FF0000000000000
	var bits uint64 = parseFloatLitToBits("1")
	var expected uint64 = (cast(uint64, 0x3FF) << 52)
	if bits != expected { return "1 should be 0x3FF0000000000000" }
	return ""
}

func TestParseFloatThree() testing.TestResult {
	// 3.0 = 1.5 * 2^1 → biased exp 1024, frac 0x8000000000000
	// = 0x4008000000000000
	var bits uint64 = parseFloatLitToBits("3")
	var expected uint64 = (cast(uint64, 0x4008) << 48)
	if bits != expected { return "3 should be 0x4008000000000000" }
	return ""
}

func TestParseFloatOnePointFive() testing.TestResult {
	// 1.5 = 1.5 * 2^0 → biased exp 1023, frac 0x8000000000000
	// = 0x3FF8000000000000
	var bits uint64 = parseFloatLitToBits("1.5")
	var expected uint64 = (cast(uint64, 0x3FF8) << 48)
	if bits != expected { return "1.5 should be 0x3FF8000000000000" }
	return ""
}

func TestParseFloatThreePointSevenFive() testing.TestResult {
	// 3.75 = 1.875 * 2^1 → biased 1024, frac (0.875 * 2^52) = 0xE0...0
	// = 0x400E000000000000  (used by test 279)
	var bits uint64 = parseFloatLitToBits("3.75")
	var expected uint64 = (cast(uint64, 0x400E) << 48)
	if bits != expected { return "3.75 should be 0x400E000000000000" }
	return ""
}

func TestParseFloatQuarter() testing.TestResult {
	// 0.25 = 1.0 * 2^-2 → biased 1021, frac 0
	// = 0x3FD0000000000000
	var bits uint64 = parseFloatLitToBits("0.25")
	var expected uint64 = (cast(uint64, 0x3FD) << 52)
	if bits != expected { return "0.25 should be 0x3FD0000000000000" }
	return ""
}

func TestParseFloatExponent() testing.TestResult {
	// 1e3 = 1000 = 1.953125 * 2^9 → biased 1032, frac 0xF400000000000
	// = 0x408F400000000000  (used by tests 283 / 287)
	var bits uint64 = parseFloatLitToBits("1e3")
	var expected uint64 = (cast(uint64, 0x408F4) << 44)
	if bits != expected { return "1e3 should be 0x408F400000000000" }
	return ""
}

func TestParseFloatLeadingDot() testing.TestResult {
	// .5 = 1.0 * 2^-1 → 0x3FE0000000000000
	var bits uint64 = parseFloatLitToBits(".5")
	var expected uint64 = (cast(uint64, 0x3FE) << 52)
	if bits != expected { return ".5 should be 0x3FE0000000000000" }
	return ""
}

// ============================================================
// emitFloat* byte-count tests
// ============================================================
//
// These guard against silent regressions in the FP-op pattern length
// (e.g. forgetting one of the FMOV gp↔fp moves around an arithmetic
// op, which would still encode a valid instruction but produce
// wrong values).

// emitFloatBinop on two spilled operands produces:
//   2× LDR (operand reload) + 2× FMOV gp→fp + 1× FADD + 1× FMOV fp→gp
//   = 6 instrs = 24 bytes.
func TestEmitFloatBinopByteCount() testing.TestResult {
	var a @asm.Assembler = floatMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypFloat64()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypFloat64()
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_ADD
	ins.Typ = types.TypFloat64()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitFloatBinop(a, m, ins) {
		return "emitFloatBinop should match float OP_ADD"
	}
	if floatBytes(a) != 24 {
		return "float OP_ADD should emit 6 instrs (24 bytes)"
	}
	return ""
}

// emitFloatBinop bails on integer types so the integer path can run.
func TestEmitFloatBinopRejectsIntType() testing.TestResult {
	var a @asm.Assembler = floatMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_ADD
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	if emitFloatBinop(a, m, ins) {
		return "emitFloatBinop should reject int OP_ADD"
	}
	if floatBytes(a) != 0 {
		return "rejected op should emit nothing"
	}
	return ""
}

// emitFloatNeg: LDR + FMOV gp→fp + FNEG + FMOV fp→gp = 16 bytes.
func TestEmitFloatNegByteCount() testing.TestResult {
	var a @asm.Assembler = floatMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypFloat64()
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_NEG
	ins.Typ = types.TypFloat64()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	if !emitFloatNeg(a, m, ins) {
		return "emitFloatNeg should match float OP_NEG"
	}
	if floatBytes(a) != 16 {
		return "float OP_NEG should emit 4 instrs (16 bytes)"
	}
	return ""
}

// emitFloatCast int→float64: SCVTF + FMOV fp→gp = 2 instrs / 8 bytes.
// (getOperand/nextReg are upstream — emitFloatCast doesn't reload.)
func TestEmitFloatCastIntToFloat64() testing.TestResult {
	var a @asm.Assembler = floatMkAssembler()
	if !emitFloatCast(a, aarch64.X9, aarch64.X10,
			types.TypInt(), types.TypFloat64()) {
		return "int → float64 cast should be handled"
	}
	if floatBytes(a) != 8 {
		return "int → float64 should emit SCVTF + FMOV (8 bytes)"
	}
	return ""
}

// emitFloatCast float64→int: FMOV gp→fp + FCVTZS = 2 instrs / 8 bytes.
func TestEmitFloatCastFloat64ToInt() testing.TestResult {
	var a @asm.Assembler = floatMkAssembler()
	if !emitFloatCast(a, aarch64.X9, aarch64.X10,
			types.TypFloat64(), types.TypInt()) {
		return "float64 → int cast should be handled"
	}
	if floatBytes(a) != 8 {
		return "float64 → int should emit FMOV + FCVTZS (8 bytes)"
	}
	return ""
}

// emitFloatCast float32→int: FMOV W→S + FCVT S→D + FCVTZS = 12 bytes.
// Width-aware path — guards against the regression where f32 bits
// (held in low 32 of GP after LDR W) get treated as a float64 pattern.
func TestEmitFloatCastFloat32ToInt() testing.TestResult {
	var a @asm.Assembler = floatMkAssembler()
	if !emitFloatCast(a, aarch64.X9, aarch64.X10,
			types.TypFloat32(), types.TypInt()) {
		return "float32 → int cast should be handled"
	}
	if floatBytes(a) != 12 {
		return "float32 → int should emit 3 instrs (12 bytes)"
	}
	return ""
}

// emitFloatCast int→float32: SCVTF + FCVT D→S + FMOV S→W = 12 bytes.
func TestEmitFloatCastIntToFloat32() testing.TestResult {
	var a @asm.Assembler = floatMkAssembler()
	if !emitFloatCast(a, aarch64.X9, aarch64.X10,
			types.TypInt(), types.TypFloat32()) {
		return "int → float32 cast should be handled"
	}
	if floatBytes(a) != 12 {
		return "int → float32 should emit 3 instrs (12 bytes)"
	}
	return ""
}

// emitFloatCast same-width float→float is a plain Mov (4 bytes).
func TestEmitFloatCastFloat64ToFloat64() testing.TestResult {
	var a @asm.Assembler = floatMkAssembler()
	if !emitFloatCast(a, aarch64.X9, aarch64.X10,
			types.TypFloat64(), types.TypFloat64()) {
		return "f64 → f64 cast should be handled"
	}
	if floatBytes(a) != 4 {
		return "same-width float cast should emit a plain Mov"
	}
	return ""
}

// emitFloatCast on int→int returns false so the integer cast path
// (LSL/ASR/Mov) takes over.
func TestEmitFloatCastRejectsIntToInt() testing.TestResult {
	var a @asm.Assembler = floatMkAssembler()
	if emitFloatCast(a, aarch64.X9, aarch64.X10,
			types.TypInt(), types.TypInt()) {
		return "int → int cast must NOT be claimed by emitFloatCast"
	}
	if floatBytes(a) != 0 {
		return "rejected cast should emit nothing"
	}
	return ""
}
