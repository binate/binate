package "pkg/native/aarch64"

import "pkg/asm"
import "pkg/ast"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/native/common"
import "pkg/parser"
import "pkg/types"

// Tests for the interface-vtable / call helpers in arm64_iface.bn.
// End-to-end emission is exercised by the conformance suite under
// builder-comp_native_aa64-comp_native_aa64; these unit tests pin the pure helpers
// (name mangling + the common.AppendStr slice append) so a regression
// in the names doesn't slip through silently.

// TestImplVtableNameNative pins the underscore-prefixed Mach-O
// symbol for an (R, I) impl vtable: matches the LLVM
// `__ivt.bn_<recv_pkg>__<recv_name>__<iface_pkg>__<iface_name>`
// mangling from pkg/codegen/emit_impls.bn:implVtableName, with the
// Mach-O `_` C-linkage prefix prepended.
func TestImplVtableNameNative() testing.TestResult {
	var info @ir.ImplInfo = make(ir.ImplInfo)
	info.RecvPkg = "main"
	info.RecvTypeName = "T"
	info.IfacePkg = "main"
	info.IfaceName = "I"
	var got @[]char = implVtableNameNative(info)
	if !charEq(got, "___ivt.bn_main__T__main__I") {
		return fail("expected ___ivt.bn_main__T__main__I")
	}
	return ""
}

// TestImplVtableNameNativeCrossPkg covers the cross-package shape
// (Slice 2.6 of plan-cross-package-interfaces.md): the iface's
// own package name appears between RecvName and IfaceName even
// when impl and iface live in different packages.
func TestImplVtableNameNativeCrossPkg() testing.TestResult {
	var info @ir.ImplInfo = make(ir.ImplInfo)
	info.RecvPkg = "geom"
	info.RecvTypeName = "Point"
	info.IfacePkg = "fmt"
	info.IfaceName = "Stringer"
	var got @[]char = implVtableNameNative(info)
	if !charEq(got, "___ivt.bn_geom__Point__fmt__Stringer") {
		return fail("expected ___ivt.bn_geom__Point__fmt__Stringer")
	}
	return ""
}

// TestBuildMethodFuncNameNative pins the dotted-name format used
// when looking up a method's mangled function symbol from a
// vtable slot.  Format: `<recvPkg>.<recvName>.<methodName>` —
// matches pkg/codegen/emit_impls.bn:buildMethodFuncName.
func TestBuildMethodFuncNameNative() testing.TestResult {
	var got @[]char = buildMethodFuncNameNative(
		"geom", "Point", "String")
	if !charEq(got, "geom.Point.String") {
		return fail("expected geom.Point.String")
	}
	return ""
}

// emitCallIfaceMethod with no user args + void return emits:
//   LDR ivAddr, [SP, #...]      ; getOperand reload
//   LDR X17, [ivAddr + 8]       ; iv.vtable
//   LDR X17, [X17 + 8*Index]    ; vtable[Index]
//   LDR X0, [ivAddr + 0]        ; iv.data → arg 0
//   BLR X17
// Five 4-byte AArch64 instructions = 20 bytes. Pins the call-site
// shape (matches emitCallFuncValue's 20-byte shape on the same args).
func TestEmitCallIfaceMethodNoArgsVoid() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)

	var ivAddr @ir.Instr = make(ir.Instr)
	ivAddr.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_IFACE_METHOD
	ins.Index = 1
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = ivAddr

	emitCallIfaceMethod(a, m, nilFuncs(), ins)
	if opsBytes(a) != 20 {
		return fail("iface-method call (no user args, void) should emit 5 instrs (20 bytes)")
	}
	return ""
}

// emitCallIfaceMethod must use `ins.Index` raw as the vtable slot —
// not `ins.Index + 1`.  Earlier draft of arm64_iface.bn added a `+1`
// to "skip the dtor", but findInterfaceMethodFromBase in
// pkg/ir/gen_iface.bn already returns the ABSOLUTE slot (it walks
// `cursor = base + 1` to skip the dtor before adding the method
// offset).  The buggy `+1` dispatched one slot past the real method
// on every iface call, producing SIGBUS on every iface conformance.
//
// LDR (immediate, unsigned offset, 64-bit) encoding:
//   bits 31-24 = 0xF9, bits 22-23 = 01 (LDR), bits 21-10 = imm12,
//   bits 9-5 = Rn (5 bits), bits 4-0 = Rt (5 bits).
// For LDR X17, [X17, #8] (Index=1 → byte offset 8 / scale 8 → 1):
//   word = 0xF9_4006_31 (little-endian: 31 06 40 F9).
// For LDR X17, [X17, #16] (the buggy Index+1 path with Index=1):
//   word = 0xF9_400A_31 (little-endian: 31 0A 40 F9).
// Byte 9 of emitCallIfaceMethod's output (= byte 1 of the 3rd
// instruction, which is the vtable-slot LDR) distinguishes the two:
//   0x06 = correct (matches the post-7096a94 fix),
//   0x0A = the off-by-one regression.
func TestEmitCallIfaceMethodSlotOffsetIsRaw() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)

	var ivAddr @ir.Instr = make(ir.Instr)
	ivAddr.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_IFACE_METHOD
	ins.Index = 1
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = ivAddr

	emitCallIfaceMethod(a, m, nilFuncs(), ins)
	if opsBytes(a) != 20 {
		return fail("slot-offset test needs 5-instr emission")
	}
	// 3rd instruction = vtable-slot LDR (bytes 8..11).
	var byteSlotLow uint8 = a.Sections[0].Data[8]
	var byteSlotImm uint8 = a.Sections[0].Data[9]
	var byteSlotHi1 uint8 = a.Sections[0].Data[10]
	var byteSlotHi2 uint8 = a.Sections[0].Data[11]
	if byteSlotLow != cast(uint8, 0x31) {
		return fail("slot LDR low byte should be 0x31 (Rt/Rn=X17)")
	}
	if byteSlotImm != cast(uint8, 0x06) {
		return fail(
			"slot LDR imm byte should be 0x06 (offset 8 = Index*8); "
			"0x0A means the off-by-one regression is back")
	}
	if byteSlotHi1 != cast(uint8, 0x40) {
		return fail("slot LDR byte 2 should be 0x40 (LDR opc)")
	}
	if byteSlotHi2 != cast(uint8, 0xF9) {
		return fail("slot LDR byte 3 should be 0xF9 (64-bit LDR)")
	}
	return ""
}

// emitCallIfaceMethod with Index=2 widens the slot LDR offset to 16
// (imm12 = 2 → byte 9 = 0x0A).  Pairs with the Index=1 test above to
// pin the linear dependence — i.e. slot = 8*Index, not 8*(Index+1)
// nor 8*Index + constant.
func TestEmitCallIfaceMethodSlotOffsetIndex2() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)

	var ivAddr @ir.Instr = make(ir.Instr)
	ivAddr.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_IFACE_METHOD
	ins.Index = 2
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = ivAddr

	emitCallIfaceMethod(a, m, nilFuncs(), ins)
	if opsBytes(a) != 20 { return fail("Index=2 should still emit 20 bytes") }
	if a.Sections[0].Data[9] != cast(uint8, 0x0A) {
		return fail("Index=2 slot LDR imm byte should be 0x0A (offset 16)")
	}
	return ""
}

// Defensive guard: emitCallIfaceMethod must early-out on a malformed
// instruction with no Args, never emitting any bytes.  Without the
// guard a missing Args[0] would crash the encoder.
func TestEmitCallIfaceMethodEmptyArgsIsNoOp() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_IFACE_METHOD
	emitCallIfaceMethod(a, m, nilFuncs(), ins)
	if opsBytes(a) != 0 {
		return fail("iface-method call with no Args should emit nothing")
	}
	return ""
}

// emitCallIfaceMethod with many scalar user args walks len(args)
// getOperand calls.  Pre-fix, each consumed a fresh scratch slot
// without per-arg ResetRegs, so an iface dispatch with 8+ scalar
// args would saturate the X9..X17 pool.  Same op=50-class panic
// that hit emitCallIndirect / emitCallFuncValue.  Mirrors
// TestEmitReturnManyValues / TestEmitCallIndirectManyArgs.
// Survival is the test.
func TestEmitCallIfaceMethodManyArgsDoesNotSaturateRegPool() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// iv at spill 0, plus 9 int scalar args at unique spills.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var nArgs int = 9
	var args @[]@ir.Instr = make_slice(@ir.Instr, nArgs + 1)
	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 5
	args[0] = iv
	for i := 0; i < nArgs; i++ {
		rm.SpillIDs = common.AppendInt(rm.SpillIDs, 100 + i)
		rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8 + 8 * i)
		var arg @ir.Instr = make(ir.Instr)
		arg.ID = 100 + i
		arg.Typ = types.TypInt()
		args[i + 1] = arg
	}
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_IFACE_METHOD
	ins.Index = 1
	ins.Args = args
	emitCallIfaceMethod(a, rm, nilFuncs(), ins)
	if opsBytes(a) == 0 {
		return fail("OP_CALL_IFACE_METHOD many-args must emit at least one instruction")
	}
	return ""
}

// genFromSrc parses Binate source through the standard
// parser → ir.GenModule pipeline, which populates the
// per-module iface/impl registries (moduleInterfaces /
// ImplInfo entries) — required for emitImplVtables to walk
// parents / own methods.  Lighter-weight alternative to going
// through EmitObject + a full link.
func genFromSrc(src *[]const char) @ir.Module {
	var buf @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		buf[i] = cast(uint8, src[i])
	}
	var p @parser.Parser = parser.New(buf, "test")
	var file @ast.File = p.ParseFile()
	return ir.GenModule(file)
}

// dataSectionBytes returns the byte count of the assembler's
// "data" section (where impl vtables land).  Helper for the
// vtable-shape tests below.  Returns 0 if no data section was
// emitted (the module had no impls).  Iterates `NumSections`
// (not `len(Sections)`) because the Sections slice is over-
// allocated by SetSection's growth strategy.
func dataSectionBytes(a @asm.Assembler) int {
	for i := 0; i < a.NumSections; i++ {
		var n *[]const char = a.Sections[i].Name
		if len(n) == 4 &&
			n[0] == 'd' && n[1] == 'a' &&
			n[2] == 't' && n[3] == 'a' {
			return a.Sections[i].Len
		}
	}
	return 0
}

// emitImplVtables writes one __ivt.<...> global per (R, I) impl
// pair in the module.  For a non-extending interface, the layout
// collapses to [dtor, m1, m2, ...] (= 1 + N slots × 8 bytes).
// `interface I { foo() }; impl *T : I` for a struct T with no
// managed fields → 2 slots × 8 = 16 bytes.
func TestEmitImplVtablesNonExtendingShape() testing.TestResult {
	var src *[]const char =
		"package \"main\"\n"
		"interface I { foo() }\n"
		"type T struct { x int }\n"
		"func (t *T) foo() { }\n"
		"impl *T : I\n"
		"func main() { }\n"
	var mod @ir.Module = genFromSrc(src)

	var a @asm.Assembler = opsMkAssembler()
	emitImplVtables(a, "main", mod)
	// 1 slot (dtor=null) + 1 method = 2 slots = 16 bytes.
	if dataSectionBytes(a) != 16 {
		return fail("non-extending (T,I) vtable should be 16 bytes (2 slots × 8)")
	}
	return ""
}

// plan-interface-embedding.md Slice E.3: for an extended interface
// `RC : Closer { Read() int }`, the (T, RC) vtable uses the concat
// layout — dtor + Closer's full sub-vtable inlined + RC's own
// methods — for 1 + 2 + 1 = 4 slots × 8 = 32 bytes.  The pre-fix
// flat layout would have produced 1 + 2 = 3 slots × 8 = 24 bytes
// (dtor + both methods, no parent any-block).
//
// `impl *T : RC` also registers (T, Closer) transitively, so the
// data section contains BOTH vtables: RC (32 bytes) + Closer
// (2 slots × 8 = 16 bytes) = 48 bytes total.
func TestEmitImplVtablesExtendedConcatShape() testing.TestResult {
	var src *[]const char =
		"package \"main\"\n"
		"interface Closer { Close() }\n"
		"interface RC : Closer { Read() int }\n"
		"type T struct { x int }\n"
		"func (t *T) Close() { }\n"
		"func (t *T) Read() int { return 0 }\n"
		"impl *T : RC\n"
		"func main() { }\n"
	var mod @ir.Module = genFromSrc(src)

	var a @asm.Assembler = opsMkAssembler()
	emitImplVtables(a, "main", mod)
	// (T,RC) = 4 slots (dtor + Closer's 2-slot sub-block + Read) = 32 bytes
	// (T,Closer) = 2 slots (dtor + Close) = 16 bytes
	// Total = 48 bytes.  Pre-fix flat would be 24 + 16 = 40.
	if dataSectionBytes(a) != 48 {
		return fail("(T,RC)+(T,Closer) vtables should total 48 bytes; 40 means flat layout regressed")
	}
	return ""
}

// A module with no impls emits no impl vtables — the data section
// is either empty or never created.  Pins emitImplVtables's early-
// out path.
func TestEmitImplVtablesNoImpls() testing.TestResult {
	var src *[]const char =
		"package \"main\"\n"
		"func main() { }\n"
	var mod @ir.Module = genFromSrc(src)

	var a @asm.Assembler = opsMkAssembler()
	emitImplVtables(a, "main", mod)
	if dataSectionBytes(a) != 0 {
		return fail("module with no impls should emit no vtable bytes")
	}
	return ""
}

// emitInstr's OP_IFACE_UPCAST arm rebuilds an interface value with
// the source's data ptr and a vtable adjusted by `IfaceParentSlotOffset
// * 8` bytes to land at the target's nested sub-vtable.  When the
// offset is 0 (or types aren't fully populated for the lookup), the
// ADD-by-byte-offset step is skipped and the handler emits:
//   LDR srcPtr, [SP, #...]      ; getOperand reload of the iv pointer
//   LDR dataTmp, [srcPtr, #0]   ; iv.data
//   STR dataTmp, [SP, #dataOff]
//   LDR vtTmp,   [srcPtr, #8]   ; iv.vtable
//   STR vtTmp,   [SP, #dataOff+8]
//   ADD rd, SP, #dataOff        ; result = address of the new iv region
// Six 4-byte AArch64 instructions = 24 bytes.  Pins the handler's
// presence — a regression that drops the OP_IFACE_UPCAST arm would
// emit 0 bytes for this instr and produce broken iface upcast
// dispatch (conformance 387 / 388 catch this but slowly).
func TestEmitOpIfaceUpcastNoOffset() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Source iv pointer: spill slot at offset 0 (ID=5).
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	// Destination iv data region: 16 bytes at offset 16 (ID=7).
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)

	var src @ir.Instr = make(ir.Instr)
	src.ID = 5
	// Typ left nil — the offsetSlots lookup short-circuits and stays
	// at 0, so no ADD is emitted.  Pins the 6-instruction base case.

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = ir.OP_IFACE_UPCAST
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src

	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, nilFuncs(), ins)
	if opsBytes(a) != 24 {
		return fail(
			"OP_IFACE_UPCAST (no offset) should emit 6 instrs (24 bytes); "
			"0 means the handler regressed")
	}
	return ""
}

// emitInstr's OP_IFACE_UPCAST arm must early-out on a malformed
// instruction with no Args, never emitting any bytes.  Pins the
// `len(ins.Args) < 1` guard.
func TestEmitOpIfaceUpcastEmptyArgsIsNoOp() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_IFACE_UPCAST
	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, nilFuncs(), ins)
	if opsBytes(a) != 0 {
		return fail("OP_IFACE_UPCAST with no Args should emit nothing")
	}
	return ""
}

// emitInstr's OP_IFACE_DTOR arm loads slot 0 of an iv's vtable —
// the receiver's any-block dtor — into a fresh result register.
// Shape:
//   LDR ivPtr, [SP, #...]      ; getOperand reload
//   LDR rd, [ivPtr, #8]        ; iv.vtable
//   LDR rd, [rd, #0]           ; *(vtable + 0) = dtor
// Three 4-byte AArch64 instructions = 12 bytes.  Pins the handler
// (the OP_REFDEC scope-exit path for @Iface depends on it).
func TestEmitOpIfaceDtorShape() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 7)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)

	var iv @ir.Instr = make(ir.Instr)
	iv.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = ir.OP_IFACE_DTOR
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = iv

	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, nilFuncs(), ins)
	if opsBytes(a) != 12 {
		return fail("OP_IFACE_DTOR should emit 3 instrs (12 bytes)")
	}
	return ""
}

// emitInstr's OP_IFACE_VALUE arm builds a 16-byte {data, vtable} aggregate
// in the IR-instruction's pre-allocated data region.  Shape:
//   LDR dataReg, [SP, #...]    ; getOperand reload of data ptr arg
//   STR dataReg, [SP, #dataOff]
//   ADRP vtTmp, __ivt....
//   ADD  vtTmp, vtTmp, #lo12   ; ADRP+ADD pair → absolute vtable addr
//   STR vtTmp, [SP, #dataOff+8]
//   ADD rd, SP, #dataOff       ; result = data region pointer
// Six 4-byte AArch64 instructions = 24 bytes.  Pins the handler;
// without it OP_IFACE_VALUE would emit 0 bytes and break iface
// construction.
func TestEmitOpIfaceValueShape() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)

	var dataArg @ir.Instr = make(ir.Instr)
	dataArg.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = ir.OP_IFACE_VALUE
	ins.StrVal = "__ivt.bn_main__T__main__I"
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = dataArg

	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, nilFuncs(), ins)
	if opsBytes(a) != 24 {
		return fail("OP_IFACE_VALUE should emit 6 instrs (24 bytes)")
	}
	return ""
}

// OP_IFACE_VALUE whose data ptr is a package global (`&g`) must
// materialize the global's address via ADRP+ADD rather than a
// register reload — the global pseudo-instr has ID -1 and no spill
// slot, so the pre-fix getOperand path returned < 0 and dropped the
// entire construction (0 bytes → empty program output, conformance
// 495 on native_aa64).  Shape:
//   ADRP dataTmp, _bn_main__g
//   ADD  dataTmp, dataTmp, #lo12   ; emitGlobalAddr → data addr
//   STR  dataTmp, [SP, #dataOff]
//   ADRP vtTmp, __ivt....
//   ADD  vtTmp, vtTmp, #lo12
//   STR  vtTmp, [SP, #dataOff+8]
//   ADD  rd, SP, #dataOff
// Seven 4-byte AArch64 instructions = 28 bytes — one more than the
// local-data case (24) because the data ptr is ADRP+ADD, not a
// single LDR.
func TestEmitOpIfaceValueFromGlobalShape() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 16)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)

	// Global-ref data ptr: ID -1, no spill/alloc slot, IsGlobalRef.
	var dataArg @ir.Instr = make(ir.Instr)
	dataArg.ID = -1
	dataArg.IsGlobalRef = true
	dataArg.StrVal = "g"

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = ir.OP_IFACE_VALUE
	ins.StrVal = "__ivt.bn_main__T__main__I"
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = dataArg

	var noStrings @[]ir.StringConst
	emitInstr(a, "main", "fn", rm, noStrings, nilFuncs(), ins)
	if opsBytes(a) != 28 {
		return fail(
			"OP_IFACE_VALUE from a global should emit 7 instrs (28 bytes); "
			"24 means the global-ref data ptr wasn't materialized via ADRP+ADD")
	}
	return ""
}
