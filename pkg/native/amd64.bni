// Package amd64 is the native SysV-AMD64 backend (sibling of
// pkg/native/arm64).  Named amd64 rather than x64 to avoid the
// mangled-symbol-prefix collision with pkg/asm/x64 — both would
// otherwise produce `bn_x64__*` symbols.
//
// See explorations/plan-native-x64.md.
package "pkg/native/amd64"

import "pkg/ir"

// EmitObject lowers mod to an x86_64-linux ELF object at path.
// Phase 3a: every function gets a SysV-AMD64 prologue / epilogue
// and a `ret`; other IR ops are silently dropped (filled in by
// Phases 3b–3h).  Returns true on success.
func EmitObject(mod @ir.Module, path *[]const char) bool
