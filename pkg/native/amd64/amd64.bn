package "pkg/native/amd64"

import "pkg/asm"
import "pkg/asm/elf"
import "pkg/asm/x64"
import "pkg/ir"
import "pkg/mangle"

// ============================================================
// EmitObject — module entry (Phase 3a)
// ============================================================
//
// Phase 3a scope: every function gets a SysV-AMD64 prologue /
// epilogue and a `ret`; every other IR op is silently dropped.
// EmitObject returns true, producing a valid x86_64-linux ELF
// object file that links and runs.  Programs exit cleanly with
// empty output — conformance tests show "wrong output" rather
// than COMPILE_ERROR, which is the measurable Phase 3a
// milestone.  Subsequent sub-slices (3b–3h, see
// explorations/plan-native-x64.md) fill in real per-op lowering.
func EmitObject(mod @ir.Module, path *[]const char) bool {
	mod.FinalizeStrings()

	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	var pkgName *[]const char = mangle.PkgShortName(stripQuotes(mod.Name))

	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		emitFunc(a, pkgName, f)
	}

	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return false }

	return elf.WriteX86_64(a, path)
}
