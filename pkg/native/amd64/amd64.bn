package "pkg/native/amd64"

import "pkg/asm"
import "pkg/asm/elf"
import "pkg/asm/x64"
import "pkg/ir"

// ============================================================
// EmitObject — module entry
// ============================================================
//
// Walks the IR module, emits each function's text via emitFunc,
// then the string-constant table and any package-level globals.
// ResolveFixups patches same-section RIP-relative LEA / JMP / Jcc /
// CALL fixups; cross-section / extern targets stay as
// R_X86_64_PC32 (or R_X86_64_PLT32) relocations the linker resolves.
func EmitObject(mod @ir.Module, path *[]const char) bool {
	mod.FinalizeStrings()

	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	// Full package path; the mangler short-names it internally for
	// now (full-path migration — see pkg/mangle).
	var pkgName *[]const char = stripQuotes(mod.Name)

	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		emitFunc(a, pkgName, f, mod.Strings, mod.Funcs)
	}

	emitStringTable(a, mod.Strings)
	emitGlobals(a, pkgName, mod.Globals)

	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return false }

	return elf.WriteX86_64(a, path)
}

// emitStringTable emits every collected string literal with a local
// label `Lstr_<id>` pointing at its bytes.  Strings live in the
// text section alongside code; LEA reaches resolve same-section via
// FIX_REL32.  Same convention as arm64's emitStringTable.
func emitStringTable(a @asm.Assembler, strings @[]ir.StringConst) {
	if len(strings) == 0 { return }
	for i := 0; i < len(strings); i++ {
		var sc ir.StringConst = strings[i]
		a.DefineLabel(stringLabel(sc.ID))
		a.EmitAsciz(sc.Data)
	}
}

// emitGlobals emits package-level variable storage in a `data`
// section.  Each global gets a mangled `bn_<pkg>__<name>` symbol
// followed by g.Typ.SizeOf() zero bytes.  pkg/asm/elf maps the
// assembler "data" section to ELF .data so use-site RIP-relative
// LEAs (via emitGlobalAddr) reach the runtime address through an
// R_X86_64_PC32 cross-section relocation.
func emitGlobals(a @asm.Assembler, pkgName *[]const char,
		globals @[]@ir.Global) {
	if len(globals) == 0 { return }
	a.SetSection("data", -1)
	for i := 0; i < len(globals); i++ {
		var g @ir.Global = globals[i]
		if g == nil { continue }
		var label @[]char = globalSymFor(pkgName, g.Name)
		a.DefineLabel(label)
		a.SetGlobal(label)
		var sz int = 8
		if g.Typ != nil { sz = g.Typ.SizeOf() }
		if sz < 8 { sz = 8 }
		if sz % 8 != 0 { sz = sz + (8 - sz % 8) }
		for b := 0; b < sz; b = b + 1 {
			a.EmitUint8(cast(uint8, 0))
		}
	}
}
