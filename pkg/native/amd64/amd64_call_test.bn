package "pkg/native/amd64"

import "pkg/asm"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// callMkAsm: minimal assembler for emitCall tests.
func callMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func callBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// emitCall void / no-args / no-result: just `call <symbol>` =
// 5 bytes (0xE8 + 4-byte rel32 placeholder).
func TestEmitCallNoArgsVoid() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL
	ins.StrVal = "bootstrap.Exit"
	emitCall(a, "main", m, nilFuncs(), ins)
	if callBytes(a) != 5 {
		return "void no-args call should emit 5-byte CALL"
	}
	if a.Sections[0].Data[0] != cast(uint8, 0xE8) {
		return "CALL first byte should be 0xE8"
	}
	return ""
}

// emitCall with a single scalar arg: the arg is moved into RDI
// (SysV-AMD64 first arg reg), then CALL.  Pin that the MOV opcode
// to RDI register appears in the stream.
func TestEmitCallOneScalarArgUsesRdi() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL
	ins.StrVal = "bootstrap.Exit"
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg0
	emitCall(a, "main", m, nilFuncs(), ins)
	// Verify CALL was emitted (0xE8 near the end).
	var n int = a.Sections[0].Len
	var data *[]uint8 = a.Sections[0].Data
	if n < 5 || data[n-5] != cast(uint8, 0xE8) {
		return "CALL should be the last 5-byte instruction"
	}
	// Verify a MOV-to-RDI shape appears before the CALL.  RDI is
	// reg 7; MOV r/m64, r64 with dst=RDI has ModRM byte ending in
	// 111 (rm=RDI low 3).  Look for any 0x89 (MOV r/m,r) opcode in
	// the pre-CALL stream — that's the operand-into-RDI move.
	var foundMov bool = false
	for i := 0; i < n - 5; i++ {
		if data[i] == cast(uint8, 0x89) { foundMov = true }
	}
	if !foundMov {
		return "single-arg call should MOV scalar into RDI before CALL"
	}
	return ""
}

// emitCall with a scalar return: after CALL, MOV rd, RAX.  Verify
// the CALL is emitted AND a register-move sequence trailing it
// captures RAX into rd.  RAX is reg 0.
func TestEmitCallScalarReturnSpillsRax() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_CALL
	ins.StrVal = "bootstrap.Open"
	ins.Typ = types.TypInt()
	emitCall(a, "main", m, nilFuncs(), ins)
	// CALL is 5 bytes; a trailing MOV is at least 3 bytes (REX +
	// opcode + ModRM).  Total ≥ 8 bytes.
	if callBytes(a) < 8 {
		return "scalar-return call should emit CALL + trailing MOV"
	}
	// Verify rd was registered in the regmap.
	if m.LookupReg(1) < 0 {
		return "scalar-return call should register rd in regmap"
	}
	return ""
}

// Args 7+ overflow to stack — pin that at least 6 args go in regs
// (no MOV to stack) and the 7th triggers a MOV to [rsp + 0].
func TestEmitCallSeventhArgOnStack() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	for i := 0; i < 7; i++ {
		m.SpillIDs = common.AppendInt(m.SpillIDs, i + 1)
		m.SpillOffsets = common.AppendInt(m.SpillOffsets, i * 8)
	}
	m.OutgoingArgsSize = 16
	var args @[]@ir.Instr = make_slice(@ir.Instr, 7)
	for i := 0; i < 7; i++ {
		args[i] = make(ir.Instr)
		args[i].ID = i + 1
		args[i].Typ = types.TypInt()
	}
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL
	ins.StrVal = "foo"
	ins.Args = args
	emitCall(a, "main", m, nilFuncs(), ins)
	// Verify a CALL was emitted (0xE8 near the end).
	var n int = a.Sections[0].Len
	if n < 5 { return "should emit at least the CALL" }
	if a.Sections[0].Data[n-5] != cast(uint8, 0xE8) {
		return "CALL (0xE8) should be the last 5 bytes"
	}
	return ""
}
