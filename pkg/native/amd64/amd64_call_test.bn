package "pkg/native/amd64"

import "pkg/asm"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// callMkAsm: minimal assembler for emitCall tests.
func callMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func callBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// emitCall void / no-args / no-result: just `call <symbol>` =
// 5 bytes (0xE8 + 4-byte rel32 placeholder).
func TestEmitCallNoArgsVoid() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL
	ins.StrVal = "pkg/bootstrap.Exit"
	emitCall(a, "main", m, nilFuncs(), ins)
	if callBytes(a) != 5 {
		return "void no-args call should emit 5-byte CALL"
	}
	if a.Sections[0].Data[0] != cast(uint8, 0xE8) {
		return "CALL first byte should be 0xE8"
	}
	return ""
}

// emitCall with a single scalar arg: the arg is moved into RDI
// (SysV-AMD64 first arg reg), then CALL.  Pin that the MOV opcode
// to RDI register appears in the stream.
func TestEmitCallOneScalarArgUsesRdi() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL
	ins.StrVal = "pkg/bootstrap.Exit"
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg0
	emitCall(a, "main", m, nilFuncs(), ins)
	// Verify CALL was emitted (0xE8 near the end).
	var n int = a.Sections[0].Len
	var data *[]uint8 = a.Sections[0].Data
	if n < 5 || data[n-5] != cast(uint8, 0xE8) {
		return "CALL should be the last 5-byte instruction"
	}
	// Verify a MOV-to-RDI shape appears before the CALL.  RDI is
	// reg 7; MOV r/m64, r64 with dst=RDI has ModRM byte ending in
	// 111 (rm=RDI low 3).  Look for any 0x89 (MOV r/m,r) opcode in
	// the pre-CALL stream — that's the operand-into-RDI move.
	var foundMov bool = false
	for i := 0; i < n - 5; i++ {
		if data[i] == cast(uint8, 0x89) { foundMov = true }
	}
	if !foundMov {
		return "single-arg call should MOV scalar into RDI before CALL"
	}
	return ""
}

// emitCall with a scalar return: after CALL, MOV rd, RAX.  Verify
// the CALL is emitted AND a register-move sequence trailing it
// captures RAX into rd.  RAX is reg 0.
func TestEmitCallScalarReturnSpillsRax() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_CALL
	ins.StrVal = "pkg/bootstrap.Open"
	ins.Typ = types.TypInt()
	emitCall(a, "main", m, nilFuncs(), ins)
	// CALL is 5 bytes; a trailing MOV is at least 3 bytes (REX +
	// opcode + ModRM).  Total ≥ 8 bytes.
	if callBytes(a) < 8 {
		return "scalar-return call should emit CALL + trailing MOV"
	}
	// Verify rd was registered in the regmap.
	if m.LookupReg(1) < 0 {
		return "scalar-return call should register rd in regmap"
	}
	return ""
}

// Multi-return ≤ 16 bytes: SysV-AMD64 packs the first 8-byte word
// into RAX and the second into RDX.  emitCall must store both
// into the spill slot at FieldOffset(0) and FieldOffset(1) so a
// downstream OP_EXTRACT can read them.  Without this, the RAX
// store would land at the right offset but RDX's value would be
// lost.  Pin: 2 stores (RAX → [SP+spill+0], RDX → [SP+spill+8]).
func TestEmitCallMultiReturnTwoIntsSplitsRaxRdx() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// Spill slot for the multi-return tuple — sized to 16 bytes.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	// Build (int, int) tuple type (anonymous TYP_STRUCT —
	// IsMultiReturnCall recognises Name=="").
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	var tuple @types.Type = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_CALL
	ins.StrVal = "twoInts"
	ins.Typ = tuple
	emitCall(a, "main", m, nilFuncs(), ins)
	// Verify the CALL was emitted AND two MOV-to-mem stores follow.
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var callOff int = -1
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { callOff = i }
	}
	if callOff < 0 {
		return "CALL (0xE8) should appear in stream"
	}
	// After the CALL (callOff + 5 bytes for the call instruction),
	// at least two MOV-to-mem stores (0x89 opcode) should appear.
	var storeCount int = 0
	for i := callOff + 5; i < n; i++ {
		if data[i] == cast(uint8, 0x89) { storeCount = storeCount + 1 }
	}
	if storeCount < 2 {
		return "multi-return should emit 2 MOVs (RAX→slot+0, RDX→slot+8)"
	}
	return ""
}

// Single-field multi-return (degenerate but valid): only RAX gets
// stored, no RDX store.
func TestEmitCallMultiReturnSingleFieldOnlyRax() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	var tuple @types.Type = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_CALL
	ins.StrVal = "oneInt"
	ins.Typ = tuple
	emitCall(a, "main", m, nilFuncs(), ins)
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var callOff int = -1
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { callOff = i }
	}
	if callOff < 0 { return "CALL should appear" }
	// Exactly one trailing MOV-to-mem (RAX → slot+0); no RDX store.
	var storeCount int = 0
	for i := callOff + 5; i < n; i++ {
		if data[i] == cast(uint8, 0x89) { storeCount = storeCount + 1 }
	}
	if storeCount != 1 {
		return "single-field multi-return should emit exactly 1 MOV"
	}
	return ""
}

// ============================================================
// Phase 3h: sret call paths
// ============================================================

// emitCall with a > 16-byte aggregate return: the sret-buffer
// pointer goes into RDI (LEA &allocOff), and any user args shift
// one slot — first user arg lands in RSI, not RDI.
//
// Pin: a LEA appears (for &dataOff), AND the CALL is emitted.
func TestEmitCallBigAggregateReturnPassesRdiBuffer() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// 24-byte struct return — > 16 = SysV InternalSretBytes →
	// sret.  Pre-populate a data region for it (where PlanFrame
	// would put it).
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 24)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 24)
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var bigStruct @types.Type = types.MakeStructType("Big", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_CALL
	ins.StrVal = "makeBig"
	ins.Typ = bigStruct
	emitCall(a, "main", m, nilFuncs(), ins)
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundLea bool = false
	var foundCall bool = false
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0x8D) { foundLea = true }
		if data[i] == cast(uint8, 0xE8) { foundCall = true }
	}
	if !foundLea {
		return "sret call should LEA &returnBuffer into RDI"
	}
	if !foundCall {
		return "sret call should emit a CALL"
	}
	return ""
}

// emitCall with > 16-byte multi-return tuple — sret via hidden
// RDI buffer (same as single-aggregate path); the bytes get
// written through the buffer directly, so no post-CALL register-
// to-slot copying.  Pin: only one LEA + CALL.  Without the
// bigMultiRet guard, the post-CALL multi-return path would emit
// extra MOVs to write RAX/RDX into the spill — which would
// silently overwrite the sret-written bytes with garbage.
func TestEmitCallBigMultiReturnSretNoPostCallMov() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// 9-int tuple = 72 bytes → > 16 = sret.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var fields @[]@types.Field = make_slice(@types.Field, 9)
	for i := 0; i < 9; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_CALL
	ins.StrVal = "manyInts"
	ins.Typ = tuple
	emitCall(a, "main", m, nilFuncs(), ins)
	// Find the CALL byte; count MOV-to-mem (0x89) AFTER it.
	// bigRet bypasses the multi-return-pack path, so we expect 0
	// post-CALL 0x89 stores.
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var callOff int = -1
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { callOff = i }
	}
	if callOff < 0 { return "CALL should appear" }
	var postCallStores int = 0
	for i := callOff + 5; i < n; i++ {
		if data[i] == cast(uint8, 0x89) { postCallStores = postCallStores + 1 }
	}
	if postCallStores > 0 {
		return "big multi-return sret should NOT emit post-CALL MOVs (callee wrote through RDI)"
	}
	return ""
}

// emitCall with sret + a user arg: the user arg shifts to RSI
// (arg-reg slot 1) because RDI is consumed by the sret buffer
// pointer.  Pin that the call sequence is well-formed AND that
// SOME MOV-to-RSI shape appears (a r/m,r MOV — opcode 0x89).
//
// We don't pin the exact RSI ModRM byte because operand-reload
// shapes vary; the test is "the dispatch shift happened at all".
// A regression that left arg 0 in RDI would clobber the sret
// pointer right before the CALL.
func TestEmitCallSretShiftsUserArgsByOne() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// Multi-return tuple > 16 bytes for the return (drives sret),
	// with one scalar user arg.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var fields @[]@types.Field = make_slice(@types.Field, 9)
	for i := 0; i < 9; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_CALL
	ins.StrVal = "manyInts"
	ins.Typ = tuple
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = arg0
	emitCall(a, "main", m, nilFuncs(), ins)
	// Verify some MOV-r/m,r is emitted (the user-arg shuffle into
	// RSI plus the LEA-RDI setup).  The point is "non-empty
	// pre-CALL byte stream"; the inverse — no MOV — would mean
	// the dispatch shift broke.
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var callOff int = -1
	for i := 0; i < n; i++ {
		if data[i] == cast(uint8, 0xE8) { callOff = i }
	}
	if callOff <= 0 {
		return "sret call should have non-empty pre-CALL setup"
	}
	return ""
}

// Args 7+ overflow to stack — pin that at least 6 args go in regs
// (no MOV to stack) and the 7th triggers a MOV to [rsp + 0].
func TestEmitCallSeventhArgOnStack() testing.TestResult {
	var a @asm.Assembler = callMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	for i := 0; i < 7; i++ {
		m.SpillIDs = common.AppendInt(m.SpillIDs, i + 1)
		m.SpillOffsets = common.AppendInt(m.SpillOffsets, i * 8)
	}
	m.OutgoingArgsSize = 16
	var args @[]@ir.Instr = make_slice(@ir.Instr, 7)
	for i := 0; i < 7; i++ {
		args[i] = make(ir.Instr)
		args[i].ID = i + 1
		args[i].Typ = types.TypInt()
	}
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL
	ins.StrVal = "foo"
	ins.Args = args
	emitCall(a, "main", m, nilFuncs(), ins)
	// Verify a CALL was emitted (0xE8 near the end).
	var n int = a.Sections[0].Len
	if n < 5 { return "should emit at least the CALL" }
	if a.Sections[0].Data[n-5] != cast(uint8, 0xE8) {
		return "CALL (0xE8) should be the last 5 bytes"
	}
	return ""
}
