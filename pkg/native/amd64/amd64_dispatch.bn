package "pkg/native/amd64"

import "pkg/asm"
import "pkg/asm/x64"
import "pkg/ir"
import "pkg/native/common"

// ============================================================
// emitInstr — instruction selection
// ============================================================
//
// Phase 3a: function frame + ret-void.
// Phase 3b: integer constants, binary arith, unary, scalar return.
// Phase 3c: comparisons + control flow (JMP, conditional BRANCH).
// Phase 3d: memory ops (ALLOC / LOAD / STORE / GET_FIELD_PTR /
//           GET_ELEM_PTR).
// Phase 3e: direct CALL + CONST_STRING + global refs.
// Everything else is silently dropped — fills in Phases 3f / 3g / 3h
// / 4.

// emitInstr lowers one IR instruction.  pkgName is the short
// package name used for symbol mangling (globals, CALL targets).
// funcSym is the mangled function symbol — used for branch
// targets (per-function block-label prefix).  allFuncs is the
// module's full function list — used by CallConv.CalleeUsesCSret
// in Phase 3h.
func emitInstr(a @asm.Assembler, pkgName *[]const char, funcSym @[]char,
		rm @common.RegMap, allFuncs @[]@ir.Func,
		strings @[]ir.StringConst, ins @ir.Instr) {
	currentEmitOp = ins.Op
	if ins.Op == ir.OP_CONST_INT {
		var r int = nextReg(rm, ins.ID)
		emitConstInt64(a, r, ins.IntVal)
		return
	}
	if ins.Op == ir.OP_CONST_BOOL {
		var r int = nextReg(rm, ins.ID)
		var v int = 0
		if ins.BoolVal { v = 1 }
		x64.Mov(a, x64.Reg(r, x64.SZ64), x64.Imm(v))
		return
	}
	if ins.Op == ir.OP_CONST_STRING {
		var id int = ir.FindStringID(strings, ins.StrVal)
		if id < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		x64.LeaRipLabel(a, x64.Reg(rd, x64.SZ64), stringLabel(id))
		return
	}
	if ins.Op == ir.OP_ALLOC {
		emitAlloc(a, rm, ins)
		return
	}
	if ins.Op == ir.OP_LOAD {
		emitLoad(a, pkgName, rm, ins)
		return
	}
	if ins.Op == ir.OP_STORE {
		emitStore(a, pkgName, rm, ins)
		return
	}
	if ins.Op == ir.OP_CONST_NIL {
		emitConstNil(a, rm, ins)
		return
	}
	if ins.Op == ir.OP_MAKE {
		emitMake(a, rm, ins)
		return
	}
	if ins.Op == ir.OP_MAKE_SLICE {
		emitMakeSlice(a, rm, ins)
		return
	}
	if ins.Op == ir.OP_BOX {
		emitBox(a, rm, ins)
		return
	}
	if ins.Op == ir.OP_REFINC {
		emitRefInc(a, rm, ins)
		return
	}
	if ins.Op == ir.OP_REFDEC {
		emitRefDec(a, rm, ins)
		return
	}
	if ins.Op == ir.OP_GET_FIELD_PTR {
		emitGetFieldPtr(a, pkgName, rm, ins)
		return
	}
	if ins.Op == ir.OP_GET_ELEM_PTR {
		emitGetElemPtr(a, pkgName, rm, ins)
		return
	}
	if ins.Op == ir.OP_EXTRACT {
		emitExtract(a, rm, ins)
		return
	}
	if ins.Op == ir.OP_RODATA_MSLICE || ins.Op == ir.OP_RODATA_SLICE {
		emitRodataMSliceOrSlice(a, rm, strings, ins)
		return
	}
	if ins.Op == ir.OP_RODATA_MSLICE_COPY {
		emitStringToCharsCopy(a, rm, strings, ins, ins.StrVal)
		return
	}
	if ins.Op == ir.OP_RODATA_ARRAY {
		emitStringToArray(a, rm, strings, ins)
		return
	}
	if ins.Op == ir.OP_CAST {
		// Numeric conversion: amd64 regmap is uniformly 64-bit-wide
		// (like arm64), so explicit narrowing via SHL+SAR/SHR places
		// the target's low-w bits in the destination with the correct
		// sign behavior.  Float casts (either side TYP_FLOAT) are
		// deferred along with the rest of float arg/return passing —
		// skip them rather than emit wrong bits.
		if len(ins.Args) < 1 || ins.TypeArg == nil { return }
		if common.IsFloatScalarTyp(ins.Args[0].Typ) ||
				common.IsFloatScalarTyp(ins.TypeArg) {
			return
		}
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		emitCast(a, rd, src, ins.TypeArg)
		return
	}
	if ins.Op == ir.OP_CALL {
		emitCall(a, pkgName, rm, allFuncs, ins)
		return
	}
	if ins.Op == ir.OP_C_CALL {
		// __c_call: same arg-dispatch + return-collect as OP_CALL;
		// emitCall pulls the verbatim C symbol from ins.StrVal (no
		// Binate mangling).  Stage-1 contract (scalar/pointer args
		// + return) keeps the sret arm out — CalleeUsesCSret
		// short-circuits on non-OP_CALL.
		emitCall(a, pkgName, rm, allFuncs, ins)
		return
	}
	if emitBinop(a, rm, ins) { return }
	if emitUnop(a, rm, ins) { return }
	if emitCompare(a, rm, ins) { return }
	if ins.Op == ir.OP_JUMP {
		if ins.Block1 == nil { return }
		x64.Jmp(a, blockLabel(funcSym, ins.Block1.Label))
		return
	}
	if ins.Op == ir.OP_BRANCH {
		// Args[0] = cond, Block1 = then-block, Block2 = else-block.
		// Lowering: TEST cond, cond ; JNZ then-label ; JMP else-label.
		if ins.Block1 == nil || ins.Block2 == nil ||
				len(ins.Args) < 1 {
			return
		}
		var condReg int = getOperand(a, rm, ins.Args[0].ID)
		if condReg < 0 { return }
		var condOp x64.Operand = x64.Reg(condReg, x64.SZ64)
		x64.Test(a, condOp, condOp)
		x64.Jcc(a, x64.CC_NZ, blockLabel(funcSym, ins.Block1.Label))
		x64.Jmp(a, blockLabel(funcSym, ins.Block2.Label))
		return
	}
	if ins.Op == ir.OP_RETURN {
		emitReturn(a, rm, ins)
		return
	}
	// Anything else is silently dropped.  Phase 3f–3h / 4 fill in
	// remaining op coverage.
}

// emitReturn lowers OP_RETURN.  Handles:
//   - void return (no args)
//   - single scalar return: RAX = value, then epilogue
//   - single aggregate return > 16 bytes (sret): memcpy from
//     local result into the caller's hidden RDI buffer (loaded
//     from SP+SretSlotOff), then RAX = buffer ptr per SysV
//   - multi-return tuple > 16 bytes (sret): per-arg write
//     through the sret buffer at FieldOffset(i), then RAX = ptr
//   - multi-return tuple ≤ 16 bytes: pack RAX (first word) + RDX
//     (second word)
//
// Single aggregate ≤ 16 bytes (RAX/RDX-packed return) is also
// handled here.
func emitReturn(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	// Sret-returning function: callee writes the result through
	// the hidden RDI buffer (stashed by emitFunc at SretSlotOff),
	// then returns the buffer pointer in RAX per SysV.
	if rm.SretSlotOff >= 0 {
		emitSretReturn(a, rm, ins)
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Multi-return tuple ≤ 16 bytes: pack RAX/RDX.
	if rm.MultiReturnType != nil && len(ins.Args) > 1 {
		emitMultiReturnPack(a, rm, ins)
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Single aggregate ≤ 16 bytes: pack RAX (+ RDX).
	if len(ins.Args) == 1 && common.IsAggregateTyp(ins.Args[0].Typ) {
		emitAggregateReturnPack(a, rm, ins)
		emitEpilogueAndRet(a, rm.FrameSize())
		return
	}
	// Scalar / void.
	if len(ins.Args) == 1 && !common.IsAggregateTyp(ins.Args[0].Typ) {
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src >= 0 && src != x64.RAX {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
				x64.Reg(src, x64.SZ64))
		}
	}
	emitEpilogueAndRet(a, rm.FrameSize())
}

// emitSretReturn copies the local result into the caller's sret
// buffer and loads RAX with the buffer pointer.  Single aggregate:
// memcpy the data region into the buffer.  Multi-return tuple:
// per-field write at FieldOffset.
func emitSretReturn(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	// Load the saved sret-buffer pointer into a scratch reg.
	var dstPtr int = scratchReg(rm)
	x64.Mov(a, x64.Reg(dstPtr, x64.SZ64),
		x64.Mem(x64.RSP, rm.SretSlotOff, x64.SZ64))

	if len(ins.Args) == 1 && common.IsAggregateTyp(ins.Args[0].Typ) {
		// Single aggregate: memcpy via qword-MOV loop from the
		// argument's pointer to the destination buffer.
		var srcPtr int = getOperand(a, rm, ins.Args[0].ID)
		if srcPtr >= 0 {
			var sz int = ins.Args[0].Typ.SizeOf()
			var tmp int = scratchReg(rm)
			for off := 0; off < sz; off = off + 8 {
				x64.Mov(a, x64.Reg(tmp, x64.SZ64),
					x64.Mem(srcPtr, off, x64.SZ64))
				x64.Mov(a, x64.Mem(dstPtr, off, x64.SZ64),
					x64.Reg(tmp, x64.SZ64))
			}
		}
	} else if rm.MultiReturnType != nil {
		// Multi-return: write each scalar field through the buffer.
		// Reload dstPtr each iteration in case the per-arg
		// ResetRegs strands it; matches arm64's pattern.
		for ai := 0; ai < len(ins.Args); ai++ {
			var arg @ir.Instr = ins.Args[ai]
			var fldOff int = rm.MultiReturnType.FieldOffset(ai)
			if common.IsAggregateTyp(arg.Typ) {
				// Aggregate field: memcpy.
				var ptr int = getOperand(a, rm, arg.ID)
				if ptr >= 0 {
					var sz int = arg.Typ.SizeOf()
					var tmp int = scratchReg(rm)
					for off := 0; off < sz; off = off + 8 {
						x64.Mov(a, x64.Reg(tmp, x64.SZ64),
							x64.Mem(ptr, off, x64.SZ64))
						x64.Mov(a,
							x64.Mem(dstPtr, fldOff + off, x64.SZ64),
							x64.Reg(tmp, x64.SZ64))
					}
				}
			} else {
				var src int = getOperand(a, rm, arg.ID)
				if src >= 0 {
					var sz int = 8
					if arg.Typ != nil { sz = arg.Typ.SizeOf() }
					if sz <= 0 { sz = 8 }
					emitScalarStore(a, src, dstPtr, fldOff, sz)
				}
			}
			rm.ResetRegs()
			// Reload dstPtr if we still have more args.
			if ai + 1 < len(ins.Args) {
				dstPtr = scratchReg(rm)
				x64.Mov(a, x64.Reg(dstPtr, x64.SZ64),
					x64.Mem(x64.RSP, rm.SretSlotOff, x64.SZ64))
			}
		}
	}

	// SysV requires sret-returning funcs to return the buffer
	// pointer in RAX.  Reload it.
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
		x64.Mem(x64.RSP, rm.SretSlotOff, x64.SZ64))
}

// emitMultiReturnPack handles ≤ 16-byte multi-return tuples:
// pack the first two scalar fields into RAX and RDX per SysV
// ABI.  Aggregate fields can't fit (would push tuple > 16 bytes
// and trigger sret); they shouldn't reach this path.
func emitMultiReturnPack(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	var n int = len(ins.Args)
	if n > 2 { n = 2 }
	for ai := 0; ai < n; ai++ {
		var src int = getOperand(a, rm, ins.Args[ai].ID)
		if src < 0 {
			rm.ResetRegs()
			continue
		}
		var dst int = x64.RAX
		if ai == 1 { dst = x64.RDX }
		if src != dst {
			x64.Mov(a, x64.Reg(dst, x64.SZ64),
				x64.Reg(src, x64.SZ64))
		}
		rm.ResetRegs()
	}
}

// emitAggregateReturnPack handles single-aggregate returns ≤ 16
// bytes: pack RAX (first 8 bytes) + RDX (second 8 bytes).
// Aggregates larger than 16 bytes go through emitSretReturn (the
// SretSlotOff branch in emitReturn).
func emitAggregateReturnPack(a @asm.Assembler, rm @common.RegMap,
		ins @ir.Instr) {
	var src int = getOperand(a, rm, ins.Args[0].ID)
	if src < 0 { return }
	var sz int = ins.Args[0].Typ.SizeOf()
	if sz > 0 {
		x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
			x64.Mem(src, 0, x64.SZ64))
	}
	if sz > 8 {
		x64.Mov(a, x64.Reg(x64.RDX, x64.SZ64),
			x64.Mem(src, 8, x64.SZ64))
	}
}
