package "pkg/native/amd64"

import "pkg/asm"
import "pkg/asm/x64"
import "pkg/ir"
import "pkg/native/common"

// ============================================================
// emitInstr — instruction selection (Phase 3b)
// ============================================================
//
// Phase 3b scope: integer constants, binary arith, unary ops, scalar
// return.  Everything else is silently dropped.  Subsequent sub-
// slices (3c–3h) extend this dispatcher.

// emitInstr lowers one IR instruction.
func emitInstr(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	currentEmitOp = ins.Op
	if ins.Op == ir.OP_CONST_INT {
		var r int = nextReg(rm, ins.ID)
		emitConstInt64(a, r, ins.IntVal)
		return
	}
	if ins.Op == ir.OP_CONST_BOOL {
		var r int = nextReg(rm, ins.ID)
		var v int = 0
		if ins.BoolVal { v = 1 }
		x64.Mov(a, x64.Reg(r, x64.SZ64), x64.Imm(v))
		return
	}
	if emitBinop(a, rm, ins) { return }
	if emitUnop(a, rm, ins) { return }
	if ins.Op == ir.OP_RETURN {
		emitReturn(a, rm, ins)
		return
	}
	// Anything else is silently dropped in Phase 3b.  Phase 3c–3h
	// fill in remaining op coverage.
}

// emitReturn lowers OP_RETURN.  Phase 3b handles:
//   - void return (no args)
//   - single scalar return: load the value into RAX, then epilogue
//
// Aggregate returns, multi-return tuples, and sret indirection are
// deferred to Phase 3f / 3h.  If those shapes arrive at this point,
// fall through to the void-return path (which will emit the wrong
// thing but won't crash) — they'll start working when their
// respective sub-slices land.
func emitReturn(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	// Single scalar return: load into RAX.
	if len(ins.Args) == 1 && !common.IsAggregateTyp(ins.Args[0].Typ) {
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src >= 0 && src != x64.RAX {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
				x64.Reg(src, x64.SZ64))
		}
	}
	emitEpilogueAndRet(a, rm.FrameSize())
}
