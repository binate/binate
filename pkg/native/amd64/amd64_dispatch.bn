package "pkg/native/amd64"

import "pkg/asm"
import "pkg/asm/x64"
import "pkg/ir"
import "pkg/native/common"

// ============================================================
// emitInstr — instruction selection
// ============================================================
//
// Phase 3a: function frame + ret-void.
// Phase 3b: integer constants, binary arith, unary, scalar return.
// Phase 3c: comparisons + control flow (JMP, conditional BRANCH).
// Phase 3d: memory ops (ALLOC / LOAD / STORE / GET_FIELD_PTR /
//           GET_ELEM_PTR).
// Phase 3e: direct CALL + CONST_STRING + global refs.
// Everything else is silently dropped — fills in Phases 3f / 3g / 3h
// / 4.

// emitInstr lowers one IR instruction.  pkgName is the short
// package name used for symbol mangling (globals, CALL targets).
// funcSym is the mangled function symbol — used for branch
// targets (per-function block-label prefix).  allFuncs is the
// module's full function list — used by CallConv.CalleeUsesCSret
// in Phase 3h.
func emitInstr(a @asm.Assembler, pkgName *[]const char, funcSym @[]char,
		rm @common.RegMap, allFuncs @[]@ir.Func,
		strings @[]ir.StringConst, ins @ir.Instr) {
	currentEmitOp = ins.Op
	if ins.Op == ir.OP_CONST_INT {
		var r int = nextReg(rm, ins.ID)
		emitConstInt64(a, r, ins.IntVal)
		return
	}
	if ins.Op == ir.OP_CONST_BOOL {
		var r int = nextReg(rm, ins.ID)
		var v int = 0
		if ins.BoolVal { v = 1 }
		x64.Mov(a, x64.Reg(r, x64.SZ64), x64.Imm(v))
		return
	}
	if ins.Op == ir.OP_CONST_STRING {
		var id int = ir.FindStringID(strings, ins.StrVal)
		if id < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		x64.LeaRipLabel(a, x64.Reg(rd, x64.SZ64), stringLabel(id))
		return
	}
	if ins.Op == ir.OP_ALLOC {
		emitAlloc(a, rm, ins)
		return
	}
	if ins.Op == ir.OP_LOAD {
		emitLoad(a, pkgName, rm, ins)
		return
	}
	if ins.Op == ir.OP_STORE {
		emitStore(a, pkgName, rm, ins)
		return
	}
	if ins.Op == ir.OP_GET_FIELD_PTR {
		emitGetFieldPtr(a, pkgName, rm, ins)
		return
	}
	if ins.Op == ir.OP_GET_ELEM_PTR {
		emitGetElemPtr(a, pkgName, rm, ins)
		return
	}
	if ins.Op == ir.OP_EXTRACT {
		emitExtract(a, rm, ins)
		return
	}
	if ins.Op == ir.OP_CALL {
		emitCall(a, pkgName, rm, allFuncs, ins)
		return
	}
	if emitBinop(a, rm, ins) { return }
	if emitUnop(a, rm, ins) { return }
	if emitCompare(a, rm, ins) { return }
	if ins.Op == ir.OP_JUMP {
		if ins.Block1 == nil { return }
		x64.Jmp(a, blockLabel(funcSym, ins.Block1.Label))
		return
	}
	if ins.Op == ir.OP_BRANCH {
		// Args[0] = cond, Block1 = then-block, Block2 = else-block.
		// Lowering: TEST cond, cond ; JNZ then-label ; JMP else-label.
		if ins.Block1 == nil || ins.Block2 == nil ||
				len(ins.Args) < 1 {
			return
		}
		var condReg int = getOperand(a, rm, ins.Args[0].ID)
		if condReg < 0 { return }
		var condOp x64.Operand = x64.Reg(condReg, x64.SZ64)
		x64.Test(a, condOp, condOp)
		x64.Jcc(a, x64.CC_NZ, blockLabel(funcSym, ins.Block1.Label))
		x64.Jmp(a, blockLabel(funcSym, ins.Block2.Label))
		return
	}
	if ins.Op == ir.OP_RETURN {
		emitReturn(a, rm, ins)
		return
	}
	// Anything else is silently dropped.  Phase 3f–3h / 4 fill in
	// remaining op coverage.
}

// emitReturn lowers OP_RETURN.  Handles:
//   - void return (no args)
//   - single scalar return: load the value into RAX, then epilogue
//
// Aggregate returns / multi-return tuples / sret indirection are
// deferred to Phase 3f / 3h.
func emitReturn(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) == 1 && !common.IsAggregateTyp(ins.Args[0].Typ) {
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src >= 0 && src != x64.RAX {
			x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64),
				x64.Reg(src, x64.SZ64))
		}
	}
	emitEpilogueAndRet(a, rm.FrameSize())
}
