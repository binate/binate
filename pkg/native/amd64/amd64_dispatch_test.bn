		return "OP_CONST_NIL should route to emitConstNil"
	}
	return ""
}

func TestEmitInstrMakeRoutes() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_MAKE
	ins.TypeArg = types.TypInt()
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	// emitMake emits a MOV-RDI + CALL — pin the CALL.
	var data *[]uint8 = a.Sections[0].Data
	var foundCall bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0xE8) { foundCall = true }
	}
	if !foundCall {
		return "OP_MAKE should route to emitMake (CALL bn_rt__Alloc)"
	}
	return ""
}

