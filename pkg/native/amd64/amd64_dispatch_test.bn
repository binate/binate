package "pkg/native/amd64"

import "pkg/asm"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// dispatchMkAsm: minimal assembler for dispatch tests.
func dispatchMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// emitInstr dispatches OP_CONST_INT to emitConstInt64 — verified by
// the produced instruction being non-empty.
func TestEmitInstrConstInt() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_CONST_INT
	ins.IntVal = 42
	ins.Typ = types.TypInt()
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	if a.Sections[0].Len == 0 {
		return "OP_CONST_INT should emit MOV r, imm"
	}
	return ""
}

