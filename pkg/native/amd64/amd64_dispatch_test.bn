package "pkg/native/amd64"

import "pkg/asm"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// dispatchMkAsm: minimal assembler for dispatch tests.
func dispatchMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// emitInstr dispatches OP_CONST_INT to emitConstInt64 — verified by
// the produced instruction being non-empty.
func TestEmitInstrConstInt() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_CONST_INT
	ins.IntVal = 42
	ins.Typ = types.TypInt()
	emitInstr(a, m, ins)
	if a.Sections[0].Len == 0 {
		return "OP_CONST_INT should emit MOV r, imm"
	}
	return ""
}

// emitInstr dispatches OP_CONST_BOOL → MOV r, 0/1.
func TestEmitInstrConstBool() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_CONST_BOOL
	ins.BoolVal = true
	ins.Typ = types.TypBool()
	emitInstr(a, m, ins)
	if a.Sections[0].Len == 0 {
		return "OP_CONST_BOOL should emit MOV r, 1"
	}
	return ""
}

// emitInstr routes OP_ADD through emitBinop.
func TestEmitInstrAddRoutesToBinop() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_ADD
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitInstr(a, m, ins)
	if a.Sections[0].Len == 0 {
		return "OP_ADD via emitInstr should route to emitBinop"
	}
	return ""
}

// emitInstr routes OP_NEG through emitUnop.
func TestEmitInstrNegRoutesToUnop() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_NEG
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitInstr(a, m, ins)
	if a.Sections[0].Len == 0 {
		return "OP_NEG via emitInstr should route to emitUnop"
	}
	return ""
}

// OP_RETURN scalar: emitReturn loads the value into RAX, then
// epilogue + ret.  Pin that the byte count covers reload + mov rax
// + epilogue (mov rsp,rbp; pop rbp; ret = 5 bytes).  Exact total
// depends on the reload encoding; pin the trailing ret byte.
func TestEmitInstrReturnScalarEndsWithRet() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_RETURN
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitInstr(a, m, ins)
	var n int = a.Sections[0].Len
	if n == 0 {
		return "OP_RETURN scalar should emit instructions"
	}
	// Last byte must be 0xC3 (ret).
	if a.Sections[0].Data[n-1] != cast(uint8, 0xC3) {
		return "OP_RETURN should end with `ret` (0xC3)"
	}
	return ""
}

// OP_RETURN void: no value to load, just emitEpilogueAndRet (5 bytes).
func TestEmitInstrReturnVoidIsEpilogueOnly() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_RETURN
	emitInstr(a, m, ins)
	// 5 bytes: 48 89 ec (mov rsp,rbp) + 5d (pop rbp) + c3 (ret).
	if a.Sections[0].Len != 5 {
		return "void OP_RETURN should emit just the 5-byte epilogue"
	}
	return ""
}

// Unhandled ops (e.g. OP_LOAD — coming in Phase 3d) are silently
// dropped; the emitted byte count stays zero so the surrounding
// function frame remains coherent.  Pre-Phase 3d this protects
// against accidental partial emissions.
func TestEmitInstrUnknownOpIsNoEmit() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_LOAD  // not yet handled in Phase 3b
	emitInstr(a, m, ins)
	if a.Sections[0].Len != 0 {
		return "unhandled op should emit nothing"
	}
	return ""
}
