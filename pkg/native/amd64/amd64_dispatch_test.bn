// OP_GET_FIELD_PTR routes to emitGetFieldPtr → LEA.
func TestEmitInstrGetFieldPtrRoutes() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	var pt @types.Type = types.MakeStructType("Pt", fields)
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var base @ir.Instr = make(ir.Instr)
	base.ID = 1
	base.TypeArg = pt
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_GET_FIELD_PTR
	ins.Index = 1
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = base
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	if a.Sections[0].Len == 0 {
		return "OP_GET_FIELD_PTR should route to emitGetFieldPtr"
	}
	return ""
}

// OP_GET_ELEM_PTR routes to emitGetElemPtr.
func TestEmitInstrGetElemPtrRoutes() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var base @ir.Instr = make(ir.Instr)
	base.ID = 1
	var idx @ir.Instr = make(ir.Instr)
	idx.ID = 2
	var ptrTyp @types.Type = make(types.Type)
	ptrTyp.Kind = types.TYP_POINTER
	ptrTyp.Elem = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_GET_ELEM_PTR
	ins.Typ = ptrTyp
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = base
	ins.Args[1] = idx
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	if a.Sections[0].Len == 0 {
		return "OP_GET_ELEM_PTR should route to emitGetElemPtr"
	}
	return ""
}

// ============================================================
// Phase 3h: emitReturn sret + packed-aggregate paths
// ============================================================

// emitReturn with rm.SretSlotOff >= 0 routes to emitSretReturn:
// reloads the saved buffer pointer, copies the result through it,
// and reloads RAX = the buffer pointer (SysV requires sret
// returners put the buffer ptr in RAX).
//
// Pin: the trailing 0xC3 ret AND at least one extra MOV is
// emitted post-copy (the RAX = buffer-ptr final reload).
func TestEmitReturnSretAggregateLoadsBufferAndRet() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SretSlotOff = 0  // simulate PlanFrame's sret-active state
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 8)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 24)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 32)
	// Return arg: 24-byte aggregate.
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var bigStruct @types.Type = types.MakeStructType("Big", fields)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = bigStruct
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_RETURN
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	var n int = a.Sections[0].Len
	if n == 0 {
		return "sret return should emit instructions"
	}
	// Trailing byte is `ret` (0xC3).
	if a.Sections[0].Data[n - 1] != cast(uint8, 0xC3) {
		return "sret return should end with `ret` (0xC3)"
	}
	return ""
}

// Single aggregate return ≤ 16 bytes packs RAX (+RDX) from the
// source pointer's data.  Pin a MOV-r,r/m (0x8B) appears — the
// read-into-RAX of the first 8 bytes.
func TestEmitReturnAggregateLE16PacksRaxRdx() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// 16-byte raw slice = exactly 2 words; not sret (≤ 16).
	var sliceTyp @types.Type = types.MakeSliceType(types.TypInt())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = sliceTyp
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_RETURN
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	var data *[]uint8 = a.Sections[0].Data
	var foundMov bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0x8B) { foundMov = true }
	}
	if !foundMov {
		return "≤ 16-byte aggregate return should emit MOV r,r/m to pack RAX"
	}
	return ""
}

// Multi-return ≤ 16 bytes: pack arg 0 → RAX, arg 1 → RDX.
// Pin a MOV-r,r appears packing into RAX (= reg 0).
func TestEmitReturnMultiReturnLE16PacksRaxRdx() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// (int, int) tuple = 16 bytes = ≤ 16 — packs RAX/RDX.
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	for i := 0; i < 2; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var tuple @types.Type = types.MakeStructType("", fields)
	m.MultiReturnType = tuple
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var arg0 @ir.Instr = make(ir.Instr)
	arg0.ID = 1
	arg0.Typ = types.TypInt()
	var arg1 @ir.Instr = make(ir.Instr)
	arg1.ID = 2
	arg1.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_RETURN
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = arg0
	ins.Args[1] = arg1
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	var data *[]uint8 = a.Sections[0].Data
	var foundMov bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		// 0x89 = MOV r/m,r (destination is rax/rdx in our case).
		if data[i] == cast(uint8, 0x89) { foundMov = true }
	}
	if !foundMov {
		return "≤16 multi-return should MOV args into RAX/RDX"
	}
	return ""
}

// Unhandled ops (e.g. OP_FUNC_VALUE — Phase 4 territory) are
// silently dropped; the emitted byte count stays zero so the
// surrounding function frame remains coherent.  Protects against
// accidental partial emissions from a regression that mis-
// dispatches an op.
func TestEmitInstrUnknownOpIsNoEmit() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_FUNC_VALUE  // Phase 4
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	if a.Sections[0].Len != 0 {
		return "unhandled op should emit nothing"
	}
	return ""
}
