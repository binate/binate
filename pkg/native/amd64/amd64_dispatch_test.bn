	ins.Typ = types.TypBool()
	emitInstr(a, "main", m, ins)
	if a.Sections[0].Len == 0 {
		return "OP_CONST_BOOL should emit MOV r, 1"
	}
	return ""
}

// emitInstr routes OP_ADD through emitBinop.
func TestEmitInstrAddRoutesToBinop() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_ADD
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitInstr(a, "main", m, ins)
	if a.Sections[0].Len == 0 {
		return "OP_ADD via emitInstr should route to emitBinop"
	}
	return ""
}

// emitInstr routes OP_NEG through emitUnop.
func TestEmitInstrNegRoutesToUnop() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_NEG
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitInstr(a, "main", m, ins)
	if a.Sections[0].Len == 0 {
		return "OP_NEG via emitInstr should route to emitUnop"
	}
	return ""
}

// OP_RETURN scalar: emitReturn loads the value into RAX, then
// epilogue + ret.  Pin that the byte count covers reload + mov rax
// + epilogue (mov rsp,rbp; pop rbp; ret = 5 bytes).  Exact total
// depends on the reload encoding; pin the trailing ret byte.
func TestEmitInstrReturnScalarEndsWithRet() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_RETURN
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitInstr(a, "main", m, ins)
	var n int = a.Sections[0].Len
	if n == 0 {
		return "OP_RETURN scalar should emit instructions"
	}
	// Last byte must be 0xC3 (ret).
	if a.Sections[0].Data[n-1] != cast(uint8, 0xC3) {
		return "OP_RETURN should end with `ret` (0xC3)"
	}
	return ""
}

// OP_RETURN void: no value to load, just emitEpilogueAndRet (5 bytes).
func TestEmitInstrReturnVoidIsEpilogueOnly() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_RETURN
	emitInstr(a, "main", m, ins)
	// 5 bytes: 48 89 ec (mov rsp,rbp) + 5d (pop rbp) + c3 (ret).
	if a.Sections[0].Len != 5 {
		return "void OP_RETURN should emit just the 5-byte epilogue"
	}
	return ""
}

// OP_JUMP unconditional: just `jmp <label>`.  Emits 5 bytes for
// a near jump (0xE9 + rel32).  Pin the trailing 4 zero bytes
// (the rel32 is filled by ResolveFixups; pre-fixup it's zero).
func TestEmitInstrJump() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var target @ir.Block = ir.AddBlock(ir.NewFunc("main.main",
		makeNoParams(), makeNoResults()), "target")
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_JUMP
	ins.Block1 = target
	emitInstr(a, "main", m, ins)
	if a.Sections[0].Len != 5 {
		return "OP_JUMP should emit 5-byte near jmp"
	}
	if a.Sections[0].Data[0] != cast(uint8, 0xE9) {
		return "OP_JUMP first byte should be 0xE9 (near jmp)"
	}
	return ""
}

// OP_BRANCH conditional: TEST cond, cond + JNZ then + JMP else.
// TEST reg,reg encoding for SZ64 = REX.W + 0x85 + ModRM (3 bytes).
// JNZ near = 0x0F 0x85 + rel32 (6 bytes).  JMP near = 0xE9 + rel32
// (5 bytes).  Plus operand reload (variable size).  Pin: ends with
// the JMP's rel32 zero placeholder, and contains the JNZ opcode
// pair (0x0F 0x85) somewhere.
func TestEmitInstrBranchEmitsTestJnzJmp() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var f @ir.Func = ir.NewFunc("main.main", makeNoParams(), makeNoResults())
	var thenB @ir.Block = ir.AddBlock(f, "then")
	var elseB @ir.Block = ir.AddBlock(f, "else")
	var cond @ir.Instr = make(ir.Instr)
	cond.ID = 1
	cond.Typ = types.TypBool()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_BRANCH
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = cond
	ins.Block1 = thenB
	ins.Block2 = elseB
	emitInstr(a, "main", m, ins)
	var n int = a.Sections[0].Len
	if n == 0 {
		return "OP_BRANCH should emit instructions"
	}
	// Verify a JNZ (0F 85) appears somewhere in the stream.
	var data *[]uint8 = a.Sections[0].Data
	var foundJnz bool = false
	for i := 0; i < n - 1; i++ {
		if data[i] == cast(uint8, 0x0F) &&
				data[i+1] == cast(uint8, 0x85) {
			foundJnz = true
		}
	}
	if !foundJnz {
		return "OP_BRANCH should emit JNZ (0F 85) for then-target"
	}
	return ""
}

// OP_EQ / OP_LT / OP_GE all route through emitCompare, which
// emits CMP + SETcc + MOVZX.  Pin that the SETcc opcode (0F 9X)
// appears in the stream — distinguishes Phase 3c from a regression
// that falls through to the unknown-op no-emit path.
func TestEmitInstrCompareEmitsSetcc() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_EQ
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	emitInstr(a, "main", m, ins)
	// SETcc opcode is 0F 9X — look for 0F 94 (SETE for OP_EQ).
	var data *[]uint8 = a.Sections[0].Data
	var n int = a.Sections[0].Len
	var foundSete bool = false
	for i := 0; i < n - 1; i++ {
		if data[i] == cast(uint8, 0x0F) &&
				data[i+1] == cast(uint8, 0x94) {
			foundSete = true
		}
	}
	if !foundSete {
		return "OP_EQ should emit SETE (0F 94)"
	}
	return ""
}

// makeNoParams / makeNoResults / makeNoInstrs are shared helpers
// for IR construction in the per-package dispatch + frame tests.
func makeNoParams() @[]@ir.Param {
	var p @[]@ir.Param
	return p
}
func makeNoResults() @[]@types.Type {
	var r @[]@types.Type
	return r
}

// Unhandled ops (e.g. OP_LOAD — coming in Phase 3d) are silently
// dropped; the emitted byte count stays zero so the surrounding
// function frame remains coherent.  Pre-Phase 3d this protects
// against accidental partial emissions.
func TestEmitInstrUnknownOpIsNoEmit() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_LOAD  // not yet handled in Phase 3b
	emitInstr(a, "main", m, ins)
	if a.Sections[0].Len != 0 {
		return "unhandled op should emit nothing"
	}
	return ""
}
