// OP_EXTRACT via emitInstr routes to emitExtract.  Pin that a
// scalar EXTRACT from a multi-return CALL produces a MOV (0x8B)
// reading from the spill slot.
func TestEmitInstrExtractRoutes() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	var tuple @types.Type = types.MakeStructType("", fields)
	var call @ir.Instr = make(ir.Instr)
	call.ID = 1
	call.Op = ir.OP_CALL
	call.Typ = tuple
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_EXTRACT
	ins.Index = 0
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = call
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	if a.Sections[0].Len == 0 {
		return "OP_EXTRACT should route to emitExtract"
	}
	return ""
}

// OP_CALL via emitInstr routes to emitCall → CALL <symbol>.
func TestEmitInstrCallRoutes() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL
	ins.StrVal = "bootstrap.Exit"
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	if a.Sections[0].Len != 5 {
		return "OP_CALL should route to emitCall (5-byte CALL)"
	}
	if a.Sections[0].Data[0] != cast(uint8, 0xE8) {
		return "OP_CALL should emit CALL (0xE8)"
	}
	return ""
}

// makeNoParams / makeNoResults / makeNoInstrs are shared helpers
// for IR construction in the per-package dispatch + frame tests.
func makeNoParams() @[]@ir.Param {
	var p @[]@ir.Param
	return p
}
func makeNoResults() @[]@types.Type {
	var r @[]@types.Type
	return r
}

// Phase 3d dispatch routing — pin that each new op reaches its
// handler.  Failure mode being guarded: a regression that loses
// the dispatch entry would silently no-op the op, which then
// surfaces only at conformance level as "wrong output".

// OP_ALLOC for an aggregate type routes to emitAlloc → emits
// zero-init stores.
func TestEmitInstrAllocAggregateRoutes() testing.TestResult {
	var a @asm.Assembler = dispatchMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_ALLOC
	ins.TypeArg = types.MakeSliceType(types.TypInt())
	emitInstr(a, "main", "bn_main__main", m, nilFuncs(), nilStrings(), ins)
	if a.Sections[0].Len == 0 {
		return "OP_ALLOC aggregate should route to emitAlloc"
	}
	return ""
}

