package "pkg/native/amd64"

import "pkg/asm"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/types"

// Phase 3a byte-shape tests for emitFunc / emitPrologue /
// emitEpilogueAndRet — every empty-body function should produce
// exactly the SysV-AMD64 prologue + epilogue + ret sequence.  These
// pins protect the prologue/epilogue convention through Phase 3b–3h
// (which only add behaviour for non-empty bodies).

// Empty-body function: no frame, no body.  Encoded:
//   55              push %rbp
//   48 89 e5        mov  %rsp, %rbp
//   48 89 ec        mov  %rbp, %rsp
//   5d              pop  %rbp
//   c3              ret
// frameSize is 0 (no params, no locals) so no `sub rsp, imm`
// between prologue and body.  Total: 9 bytes.
func TestEmitFuncEmptyBodyByteShape() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("main.main", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	emitFunc(a, "main", f, nilStrings(), nilFuncs())
	if a.Sections[0].Len != 9 {
		return fail("empty function should emit 9 bytes (prologue 4 + epilogue 5)")
	}
	var data *[]uint8 = a.Sections[0].Data
	if data[0] != cast(uint8, 0x55) { return fail("byte 0 should be push rbp (0x55)") }
	if data[1] != cast(uint8, 0x48) { return fail("byte 1 should be REX.W (0x48)") }
	if data[2] != cast(uint8, 0x89) { return fail("byte 2 should be MOV r/m,r (0x89)") }
	if data[3] != cast(uint8, 0xe5) { return fail("byte 3 should be ModRM mov rbp,rsp (0xe5)") }
	if data[4] != cast(uint8, 0x48) { return fail("byte 4 should be REX.W (0x48)") }
	if data[5] != cast(uint8, 0x89) { return fail("byte 5 should be MOV r/m,r (0x89)") }
	if data[6] != cast(uint8, 0xec) { return fail("byte 6 should be ModRM mov rsp,rbp (0xec)") }
	if data[7] != cast(uint8, 0x5d) { return fail("byte 7 should be pop rbp (0x5d)") }
	if data[8] != cast(uint8, 0xc3) { return fail("byte 8 should be ret (0xc3)") }
	return ""
}

// endsWithReturn pins the IR-shape branches that drive emitFunc's
// safety-net-epilogue skip.  Without correct branching, either
// (a) a real function gets a dead 5-byte trailing epilogue, or
// (b) a function with no OP_RETURN (defensive shape) emits no
// `ret` and crashes when its return path executes.
func TestEndsWithReturnYes() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("f", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	if !endsWithReturn(f) {
		return fail("function ending with OP_RETURN should report true")
	}
	return ""
}

func TestEndsWithReturnNoBlocks() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("f", noP, noR)
	// No blocks added — the safety net SHOULD fire on an empty IR.
	if endsWithReturn(f) {
		return fail("empty function (no blocks) should report false")
	}
	return ""
}

func TestEndsWithReturnEmptyBlock() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("f", noP, noR)
	ir.AddBlock(f, "entry")  // entry with no instructions
	// Block has no instrs — safety net SHOULD fire.
	if endsWithReturn(f) {
		return fail("function with empty entry block should report false")
	}
	return ""
}

func TestEndsWithReturnLastIsNotReturn() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("f", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	// Add some non-return instruction (a const) as the last instr.
	b.EmitConstInt(42, types.TypInt())
	if endsWithReturn(f) {
		return fail("function whose last instr is OP_CONST_INT should report false")
	}
	return ""
}

// Last-non-empty-block lookup: if the IR ends with an empty block
// after a returning block, the answer is still "yes" (the empty
// trailing block is unreachable; the returning one terminates the
// function).  Pin that walk-from-the-end-skipping-empty-blocks
// behaviour so a regression doesn't silently re-introduce the dead-
// epilogue tail.
func TestEndsWithReturnSkipsEmptyTrailingBlock() testing.TestResult {
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("f", noP, noR)
	var b0 @ir.Block = ir.AddBlock(f, "entry")
	var noArgs @[]@ir.Instr
	b0.EmitReturn(noArgs)
	ir.AddBlock(f, "trailing")  // empty, after the returning block
	if !endsWithReturn(f) {
		return fail("trailing empty block should be skipped")
	}
	return ""
}

// frameSize > 0 → an extra `sub rsp, imm` between the prologue and
// the body.  Add an OP_ALLOC to the function so PlanFrame reserves
// a slot.  Encoded for a single int alloca (frameSize padded to 16):
//   55                       push  %rbp
//   48 89 e5                 mov   %rsp, %rbp
//   48 83 ec 10              sub   $0x10, %rsp        <-- new
//   48 89 ec                 mov   %rbp, %rsp
//   5d                       pop   %rbp
//   c3                       ret
// 13 bytes total.
func TestEmitFuncWithAllocaHasSubRsp() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("main.main", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	// EmitAlloc reserves a stack slot the size of int; PlanFrame
	// rounds frameSize up to a 16-byte multiple → frameSize = 16.
	b.EmitAlloc(types.TypInt())
	var noArgs @[]@ir.Instr
	b.EmitReturn(noArgs)
	emitFunc(a, "main", f, nilStrings(), nilFuncs())
	// 4 (prologue) + 4 (sub rsp, 0x10) + 5 (epilogue) = 13 bytes.
	if a.Sections[0].Len != 13 {
		return fail("function with one alloca should emit 13 bytes")
	}
	var data *[]uint8 = a.Sections[0].Data
	// Byte 4–7 should be the sub-rsp-imm8 form: 48 83 ec 10.
	if data[4] != cast(uint8, 0x48) { return fail("byte 4 should be REX.W") }
	if data[5] != cast(uint8, 0x83) { return fail("byte 5 should be SUB r/m,imm8") }
	if data[6] != cast(uint8, 0xec) { return fail("byte 6 should be ModRM sub rsp") }
	if data[7] != cast(uint8, 0x10) { return fail("byte 7 should be imm8 16") }
	return ""
}
