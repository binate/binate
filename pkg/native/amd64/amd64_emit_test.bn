package "pkg/native/amd64"

import "pkg/asm"
import "pkg/asm/x64"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// emitMkAsm: minimal assembler for direct-emit tests.
func emitMkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func emitBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// emitAlloc on a scalar (TYP_INT) is a no-op — only aggregates get
// zero-initialised.
func TestEmitAllocScalarIsNoOp() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = ir.OP_ALLOC
	ins.TypeArg = types.TypInt()
	emitAlloc(a, m, ins)
	if emitBytes(a) != 0 {
		return "scalar alloc should emit nothing"
	}
	return ""
}

// emitAlloc on an aggregate emits a run of `mov qword ptr
// [rsp+off], 0` — one per 8-byte word.  16-byte slot (slice
// header) = 2 stores.  Each `mov [rsp+off], 0` with SZ64 and
// imm32 sign-extended is 8 bytes: REX.W 0xC7 ModRM SIB disp imm32 —
// pin "non-empty" rather than exact bytes since the encoding may
// vary based on disp size.
func TestEmitAllocAggregateZeroInits() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.AllocIDs = common.AppendInt(m.AllocIDs, 7)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = ir.OP_ALLOC
	ins.TypeArg = types.MakeSliceType(types.TypInt())
	emitAlloc(a, m, ins)
	if emitBytes(a) == 0 {
		return "aggregate alloc should emit zero-init stores"
	}
	return ""
}

// emitScalarLoad size=1 unsigned → MOVZX (opcode 0F B6).
func TestEmitScalarLoadByteUnsigned() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitScalarLoad(a, x64.R10, x64.RSP, 0, 1, false)
	var s @asm.Section = a.Sections[0]
	if s.Len < 3 {
		return "MOVZX should emit at least 3 bytes"
	}
	// REX byte first (varies based on R10 dst), then 0F B6.
	if s.Data[1] != cast(uint8, 0x0F) || s.Data[2] != cast(uint8, 0xB6) {
		return "size=1 unsigned should emit MOVZX (0F B6)"
	}
	return ""
}

// emitScalarLoad size=1 signed → MOVSX (opcode 0F BE).
func TestEmitScalarLoadByteSigned() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitScalarLoad(a, x64.R10, x64.RSP, 0, 1, true)
	var s @asm.Section = a.Sections[0]
	if s.Data[1] != cast(uint8, 0x0F) || s.Data[2] != cast(uint8, 0xBE) {
		return "size=1 signed should emit MOVSX (0F BE)"
	}
	return ""
}

// emitScalarLoad size=2 unsigned → MOVZX-word (opcode 0F B7).
func TestEmitScalarLoadWordUnsigned() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitScalarLoad(a, x64.R10, x64.RSP, 0, 2, false)
	var s @asm.Section = a.Sections[0]
	if s.Data[1] != cast(uint8, 0x0F) || s.Data[2] != cast(uint8, 0xB7) {
		return "size=2 unsigned should emit MOVZX word (0F B7)"
	}
	return ""
}

// emitScalarLoad size=4 signed → MOVSXD (REX.W + 0x63).
func TestEmitScalarLoadDwordSignedIsMovsxd() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitScalarLoad(a, x64.R10, x64.RSP, 0, 4, true)
	var s @asm.Section = a.Sections[0]
	// REX byte then 0x63.
	if s.Data[1] != cast(uint8, 0x63) {
		return "size=4 signed should emit MOVSXD (0x63)"
	}
	return ""
}

// emitScalarLoad size=4 unsigned → MOV r32, m32 (auto zero-extends).
// The MOV r32 opcode is 0x8B — no REX.W needed.
func TestEmitScalarLoadDwordUnsignedIsMovR32() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitScalarLoad(a, x64.RAX, x64.RSP, 0, 4, false)
	var s @asm.Section = a.Sections[0]
	// MOV EAX, [RSP+0]: 8B 04 24 (no REX since SZ32 + low regs).
	if s.Data[0] != cast(uint8, 0x8B) {
		return "size=4 unsigned should emit MOV r32 (0x8B, no REX.W)"
	}
	return ""
}

// emitScalarLoad size=8 → MOV r64, m64 (REX.W + 0x8B).
func TestEmitScalarLoadQword() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitScalarLoad(a, x64.R10, x64.RSP, 0, 8, true)
	var s @asm.Section = a.Sections[0]
	// REX.WB (0x4C since R10 dst) + 0x8B.
	if s.Data[0] != cast(uint8, 0x4C) {
		return "size=8 should emit REX.WB for r64 dst"
	}
	if s.Data[1] != cast(uint8, 0x8B) {
		return "size=8 should emit MOV r/m64 (0x8B)"
	}
	return ""
}

// emitScalarStore size=8 → MOV [m64], r64 (REX.W + 0x89).
func TestEmitScalarStoreQword() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitScalarStore(a, x64.R10, x64.RSP, 0, 8)
	var s @asm.Section = a.Sections[0]
	if s.Data[0] != cast(uint8, 0x4C) {
		return "size=8 store should emit REX.WB"
	}
	if s.Data[1] != cast(uint8, 0x89) {
		return "size=8 store should emit MOV r/m64 (0x89)"
	}
	return ""
}

// emitScalarStore size=1 → MOV [m8], r8 (opcode 0x88).  Pin the
// size dispatch — a regression that always emits the qword form
// would clobber 7 neighbour bytes on every char store.
func TestEmitScalarStoreByte() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitScalarStore(a, x64.RAX, x64.RSP, 0, 1)
	var s @asm.Section = a.Sections[0]
	// Find the MOV byte opcode 0x88 in the stream (REX byte may or
	// may not precede; RAX low byte is AL, no REX needed).
	var foundByteMov bool = false
	for i := 0; i < s.Len; i++ {
		if s.Data[i] == cast(uint8, 0x88) { foundByteMov = true }
	}
	if !foundByteMov {
		return "size=1 store should emit MOV r/m8 (0x88), not the qword form"
	}
	return ""
}

// emitScalarStore size=2 → MOV [m16], r16, prefixed with 0x66
// (operand-size override).  Pin the prefix — without it the
// instruction stream silently encodes a 32-bit store and clobbers
// 2 high-half bytes.
func TestEmitScalarStoreWordHas66Prefix() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitScalarStore(a, x64.RAX, x64.RSP, 0, 2)
	var s @asm.Section = a.Sections[0]
	if s.Data[0] != cast(uint8, 0x66) {
		return "size=2 store should start with 0x66 (operand-size override)"
	}
	return ""
}

// emitScalarStore size=4 → MOV [m32], r32, no REX.W, no 0x66 prefix.
func TestEmitScalarStoreDword() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	emitScalarStore(a, x64.RAX, x64.RSP, 0, 4)
	var s @asm.Section = a.Sections[0]
	// First byte should be the opcode 0x89 (no REX, no 0x66 for SZ32).
	if s.Data[0] != cast(uint8, 0x89) {
		return "size=4 store should be plain MOV r/m32 (0x89, no REX/0x66)"
	}
	return ""
}

// emitStore for aggregate args is a no-op in Phase 3d — struct copy
// lands in Phase 3g.  Pin that so a future regression doesn't
// silently emit garbage for aggregate STOREs.
func TestEmitStoreAggregateIsNoOpInPhase3d() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	m.AllocIDs = common.AppendInt(m.AllocIDs, 2)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 16)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	var dst @ir.Instr = make(ir.Instr)
	dst.ID = 1
	dst.Typ = types.MakeSliceType(types.TypInt())
	var src @ir.Instr = make(ir.Instr)
	src.ID = 2
	src.Typ = types.MakeSliceType(types.TypInt())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_STORE
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = dst
	ins.Args[1] = src
	emitStore(a, "main", m, ins)
	if emitBytes(a) != 0 {
		return "aggregate store should be no-op in Phase 3d"
	}
	return ""
}

// emitGetFieldPtr with alloca base: collapses fieldOff into the LEA
// disp — `lea rd, [rsp + allocOff + fieldOff]`.  Pin that this is
// a single LEA, not LEA + ADD.
func TestEmitGetFieldPtrAllocaBase() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	// Construct a struct type with two int fields.
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	var pt @types.Type = types.MakeStructType("Pt", fields)
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 16)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 32)
	var base @ir.Instr = make(ir.Instr)
	base.ID = 1
	base.TypeArg = pt
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_GET_FIELD_PTR
	ins.Index = 1  // second field, offset 8
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = base
	emitGetFieldPtr(a, "main", m, ins)
	if emitBytes(a) == 0 {
		return "emitGetFieldPtr should emit LEA"
	}
	// LEA opcode is 0x8D — search for it in the stream.
	var data *[]uint8 = a.Sections[0].Data
	var foundLea bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0x8D) { foundLea = true }
	}
	if !foundLea { return "emitGetFieldPtr should emit a LEA (0x8D)" }
	return ""
}

// emitGetFieldPtr with non-alloca base: LEA rd, [ptr + fieldOff].
// Field offset 8 (second int in {int, int}).  Pin that the LEA
// opcode appears AND no IMUL appears (the non-alloca path is
// `lea` not `add`+`mov`).
func TestEmitGetFieldPtrNonAllocaBase() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	var pt @types.Type = types.MakeStructType("Pt", fields)
	// Pointer-to-struct base; base.TypeArg = struct so StructTypeOf
	// returns the struct type.
	var base @ir.Instr = make(ir.Instr)
	base.ID = 1
	base.TypeArg = pt
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_GET_FIELD_PTR
	ins.Index = 1  // second field, offset 8
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = base
	emitGetFieldPtr(a, "main", m, ins)
	if emitBytes(a) == 0 {
		return "emitGetFieldPtr non-alloca should emit"
	}
	var data *[]uint8 = a.Sections[0].Data
	var foundLea bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0x8D) { foundLea = true }
	}
	if !foundLea {
		return "emitGetFieldPtr non-alloca should emit LEA (0x8D)"
	}
	return ""
}

// emitGetElemPtr non-SIB fallback: elemSize=24 (3-int struct)
// can't ride the SIB-scale form, so it routes through IMUL3 +
// LEA-with-SIB-scale-1.  Pin that the IMUL3 opcode (0x69) IS in
// the stream — the inverse pin of the SIB-path test.
func TestEmitGetElemPtrNonSibFallback() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	// Build a 3-int (24-byte) struct as the GEP's element type.
	var fields @[]@types.Field = make_slice(@types.Field, 3)
	for i := 0; i < 3; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var triple @types.Type = types.MakeStructType("Triple", fields)
	var ptrTyp @types.Type = make(types.Type)
	ptrTyp.Kind = types.TYP_POINTER
	ptrTyp.Elem = triple
	var base @ir.Instr = make(ir.Instr)
	base.ID = 1
	var idx @ir.Instr = make(ir.Instr)
	idx.ID = 2
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_GET_ELEM_PTR
	ins.Typ = ptrTyp
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = base
	ins.Args[1] = idx
	emitGetElemPtr(a, "main", m, ins)
	var data *[]uint8 = a.Sections[0].Data
	// Imul3 picks 0x6B (imm8 form) for small immediates that fit
	// signed-i8 like 24, and 0x69 (imm32 form) otherwise.  Accept
	// either so the test pins "an IMUL3 was emitted" without
	// coupling to the operand-size dispatch inside Imul3.
	var foundImul bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0x69) || data[i] == cast(uint8, 0x6B) {
			foundImul = true
		}
	}
	if !foundImul {
		return "elemSize=24 should hit IMUL3 (0x69/0x6B) fallback path"
	}
	return ""
}

// emitGetElemPtr SIB-scale path: elemSize=8 → single LEA r,
// [base + idx*8] with SIB byte.
func TestEmitGetElemPtrSibScale() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var base @ir.Instr = make(ir.Instr)
	base.ID = 1
	var idx @ir.Instr = make(ir.Instr)
	idx.ID = 2
	// GEP's result type is *elemTyp; ElemSizeOf reads Typ.Elem.
	var elemTyp @types.Type = types.TypInt()
	var ptrTyp @types.Type = make(types.Type)
	ptrTyp.Kind = types.TYP_POINTER
	ptrTyp.Elem = elemTyp
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_GET_ELEM_PTR
	ins.Typ = ptrTyp
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = base
	ins.Args[1] = idx
	emitGetElemPtr(a, "main", m, ins)
	if emitBytes(a) == 0 {
		return "emitGetElemPtr should emit instructions"
	}
	// SIB path: just the operand reloads + a single LEA (0x8D).
	// Non-SIB path would also include 0x69 (IMUL r,r,imm32).
	// Verify the IMUL isn't present (proving SIB path).
	var data *[]uint8 = a.Sections[0].Data
	var foundImul bool = false
	for i := 0; i < a.Sections[0].Len; i++ {
		if data[i] == cast(uint8, 0x69) ||
				data[i] == cast(uint8, 0x6B) {
			foundImul = true
		}
	}
	if foundImul {
		return "elemSize=8 should use SIB-scale path (no IMUL3)"
	}
	return ""
}

// isSibScale pins the SIB-eligible sizes: 1, 2, 4, 8 only.
func TestIsSibScale() testing.TestResult {
	if !isSibScale(1) { return "1 should be SIB" }
	if !isSibScale(2) { return "2 should be SIB" }
	if !isSibScale(4) { return "4 should be SIB" }
	if !isSibScale(8) { return "8 should be SIB" }
	if isSibScale(3) { return "3 should NOT be SIB" }
	if isSibScale(16) { return "16 should NOT be SIB" }
	if isSibScale(24) { return "24 should NOT be SIB" }
	return ""
}

// emitGlobalAddr emits a 7-byte RIP-relative LEA — same shape as
// x64.LeaRipLabel for any 64-bit dst.
func TestEmitGlobalAddrLeaRipShape() testing.TestResult {
	var a @asm.Assembler = emitMkAsm()
	var g @ir.Instr = make(ir.Instr)
	g.StrVal = "myvar"
	emitGlobalAddr(a, "main", x64.R10, g)
	var s @asm.Section = a.Sections[0]
	if s.Len != 7 {
		return "emitGlobalAddr should emit a 7-byte LEA"
	}
	// R10 dst → REX.WR = 0x4C; LEA opcode 0x8D; ModRM(reg=010 rm=101)
	// = 0x15.
	if s.Data[0] != cast(uint8, 0x4C) {
		return "byte 0 should be REX.WR for R10 dst"
	}
	if s.Data[1] != cast(uint8, 0x8D) {
		return "byte 1 should be LEA (0x8D)"
	}
	return ""
}

// isGlobalRef returns true iff ins.IsGlobalRef is set.
func TestIsGlobalRef() testing.TestResult {
	var ins @ir.Instr = make(ir.Instr)
	if isGlobalRef(ins) {
		return "default IsGlobalRef should be false"
	}
	ins.IsGlobalRef = true
	if !isGlobalRef(ins) {
		return "ins.IsGlobalRef = true should report true"
	}
	return ""
}

// isSliceFieldBase returns true for raw/managed slice pointers and
// for instructions whose result type is `*Slice` / `*ManagedSlice`.
func TestIsSliceFieldBaseManaged() testing.TestResult {
	var ins @ir.Instr = make(ir.Instr)
	ins.TypeArg = types.MakeManagedSliceType(types.TypInt())
	if !isSliceFieldBase(ins) {
		return "TypeArg=@[]int should be a slice-field base"
	}
	return ""
}

func TestIsSliceFieldBaseFalseForStruct() testing.TestResult {
	var fields @[]@types.Field = make_slice(@types.Field, 1)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	var s @types.Type = types.MakeStructType("S", fields)
	var ins @ir.Instr = make(ir.Instr)
	ins.TypeArg = s
	if isSliceFieldBase(ins) {
		return "struct TypeArg should NOT be a slice-field base"
	}
	return ""
}
