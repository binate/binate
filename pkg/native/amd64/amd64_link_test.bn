package "pkg/native/amd64"

import "pkg/bootstrap"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/types"

// Local end-to-end check for the x86_64 → Mach-O path (Phase 3b of
// plan-backend-objformat-decoupling.md): emit a Mach-O object with
// the amd64 backend, link it against the C runtime with the host
// toolchain (`clang -arch x86_64`), and run the result — under
// Rosetta on Apple Silicon, natively on Intel.  This is the slice
// that turns the amd64 backend from unit-test-only into something
// verifiable end-to-end on a dev machine.  Skipped (returns "")
// off-macOS or when Rosetta / the x86_64 toolchain isn't available.

// canRunX64Macho reports whether this host can link and run an
// x86-64 Mach-O: macOS (otool present) with Rosetta or native
// x86-64 (`arch -x86_64 true` succeeds).
func canRunX64Macho() bool {
	var ver @[]@[]char = make_slice(@[]char, 1)
	ver[0] = bootstrap.Concat("--version", "")
	if bootstrap.Exec("otool", ver) != 0 { return false }
	var ra @[]@[]char = make_slice(@[]char, 2)
	ra[0] = bootstrap.Concat("-x86_64", "")
	ra[1] = bootstrap.Concat("true", "")
	return bootstrap.Exec("arch", ra) == 0
}

// amdRuntimeFile probes the known worktree layouts for runtime/<name>.
func amdRuntimeFile(name *[]const char) @[]char {
	var c @[]@[]char = make_slice(@[]char, 4)
	c[0] = bootstrap.Concat("runtime/", name)
	c[1] = bootstrap.Concat("../../runtime/", name)
	c[2] = bootstrap.Concat("/Users/vtl/binate/binate/runtime/", name)
	c[3] = bootstrap.Concat("/Users/vtl/binate/temp-binate-5/runtime/", name)
	for i := 0; i < len(c); i++ {
		if bootstrap.Stat(c[i]) == 1 { return c[i] }
	}
	var empty @[]char
	return empty
}

// Build `__entry { bootstrap.Exit(42) }` as an x86-64 Mach-O object,
// link with the C runtime + test stubs via `clang -arch x86_64`, run
// it, and assert the process exits 42.  Exercises the full amd64
// Mach-O pipeline: '_'-prefixed symbols (Phase 3a), the x86-64 →
// Mach-O relocation mapping, and SysV-AMD64 prologue/call/ret.
func TestX64MachoExitsWithCode() testing.TestResult {
	if !canRunX64Macho() { return "" }
	var rt @[]char = amdRuntimeFile("binate_runtime.c")
	if len(rt) == 0 { return "" }
	var stubs @[]char = amdRuntimeFile("native_test_stubs.c")
	if len(stubs) == 0 { return "" }

	var noP @[]@ir.Param
	var noR @[]@types.Type
	var noArgs @[]@ir.Instr
	var m @ir.Module = ir.NewModule("\"main\"")
	// `__entry` mangles to `bn_entry` — the symbol the C runtime's
	// main() calls — and Phase 3a's '_' prefix makes it `_bn_entry`
	// to match the Mach-O C-linkage the runtime is compiled with.
	var f @ir.Func = ir.NewFunc("__entry", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	var c42 @ir.Instr = b.EmitConstInt(42, types.TypInt())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = c42
	b.EmitCall("pkg/bootstrap.Exit", args, types.TypVoid())
	b.EmitReturn(noArgs)
	m.AddFunc(f)

	var objPath *[]const char = "/tmp/binate_x64_macho_exit42.o"
	if !EmitObject(m, "macho", objPath) {
		return fail("amd64 EmitObject(macho) returned false")
	}

	var exePath *[]const char = "/tmp/binate_x64_macho_exit42"
	var largs @[]@[]char = make_slice(@[]char, 8)
	largs[0] = bootstrap.Concat("-arch", "")
	largs[1] = bootstrap.Concat("x86_64", "")
	largs[2] = bootstrap.Concat("-w", "")
	largs[3] = bootstrap.Concat("-o", "")
	largs[4] = bootstrap.Concat(exePath, "")
	largs[5] = bootstrap.Concat(objPath, "")
	largs[6] = bootstrap.Concat(rt, "")
	largs[7] = bootstrap.Concat(stubs, "")
	if bootstrap.Exec("clang", largs) != 0 {
		return fail("clang -arch x86_64 link failed")
	}

	// Direct exec — Rosetta runs the x86-64 Mach-O transparently.
	var runArgs @[]@[]char = make_slice(@[]char, 0)
	if bootstrap.Exec(exePath, runArgs) != 42 {
		return fail("expected the x86-64 binary to exit 42")
	}
	return ""
}
