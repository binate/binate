package "pkg/native/amd64"

import "pkg/asm/x64"
import "pkg/buf"
import "pkg/mangle"

// ============================================================
// Name helpers
// ============================================================
//
// ELF symbols on x86-64 Linux are unprefixed (unlike Mach-O which
// prepends '_' for C linkage).  bn_<pkg>__<name> goes straight to
// the linker.

// symPrefixed applies this backend's object-format linkage prefix to
// an already-mangled symbol name.  ELF symbols carry no prefix, so
// this is currently a copy — its purpose is to be the single place
// the prefix is (not) applied, mirroring arm64's underscorePrefix, so
// Phase 2 of plan-backend-objformat-decoupling.md can make the prefix
// format-driven (empty for ELF, "_" for Mach-O) in one spot.
func symPrefixed(name *[]const char) @[]char {
	var out buf.CharBuf = buf.New()
	out = out.WriteStr(name)
	return out.Bytes()
}

// symFor mangles a Binate (pkgName, funcName) pair to its ELF symbol
// name.  Dot-qualified names ("pkg.Func") are treated as pre-
// qualified by mangle.FuncName; pkgName is ignored in that case.
func symFor(pkgName *[]const char, funcName *[]const char) @[]char {
	var mangled buf.CharBuf = mangle.FuncName(pkgName, funcName)
	return symPrefixed(mangled.Bytes())
}

// stripQuotes strips surrounding '"' from a string (if present).
// Module names from the IR carry the source-text quoting (e.g.
// "\"pkg/foo\""); the mangler wants the bare path.
func stripQuotes(s *[]const char) *[]const char {
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		return s[1:len(s)-1]
	}
	return s
}

// globalSymFor mangles a package-level variable to its ELF symbol.
// Different from symFor because globals go through mangle.GlobalName
// (no special case for main.main).  Like symFor, ELF symbols are
// not underscore-prefixed.
func globalSymFor(pkgName *[]const char, name *[]const char) @[]char {
	var mangled buf.CharBuf = mangle.GlobalName(pkgName, name)
	return symPrefixed(mangled.Bytes())
}

// argReg returns the SysV-AMD64 integer arg register for the i-th
// argument slot.  SysV-AMD64 passes the first 6 GP args in RDI,
// RSI, RDX, RCX, R8, R9; args 7+ go on the stack.
func argReg(i int) int {
	if i == 0 { return x64.RDI }
	if i == 1 { return x64.RSI }
	if i == 2 { return x64.RDX }
	if i == 3 { return x64.RCX }
	if i == 4 { return x64.R8  }
	return x64.R9
}

// stringLabel is the local asm label for string constant <id>.
// Same naming scheme as arm64's stringLabel — the 'L' prefix
// keeps the label out of the exported symbol list.
func stringLabel(id int) @[]char {
	var out buf.CharBuf = buf.New()
	out = out.WriteStr("Lstr_")
	out = out.WriteInt(id)
	return out.Bytes()
}

// blockLabel mints a function-scoped label name for a basic block.
// The 'L' prefix keeps it out of the exported symbol list — same-
// section JMP/Jcc fixups are resolved before link, so the label
// never reaches the linker as a real symbol.
func blockLabel(funcSym @[]char, blkLabel @[]char) @[]char {
	var out buf.CharBuf = buf.New()
	out = out.WriteStr("L")
	out = out.WriteStr(funcSym)
	out = out.WriteStr("__")
	out = out.WriteStr(blkLabel)
	return out.Bytes()
}
