package "pkg/native/amd64"

import "pkg/builtin/testing"

// charsEqual compares two char slices byte-for-byte; used by the
// tests below to assert symFor output.
func charsEqual(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// symFor mangles (pkgName, funcName) → ELF symbol.  Bare names get
// `bn_<pkg>__<name>`; dot-qualified names like "pkg.Func" are
// treated as pre-qualified by mangle.FuncName (pkgName ignored).
func TestSymForBareName() testing.TestResult {
	var s @[]char = symFor("foo", "bar")
	if !charsEqual(s, "bn_foo__bar") {
		return "symFor(foo, bar) should be bn_foo__bar"
	}
	return ""
}

func TestSymForDotQualifiedNameIgnoresPkg() testing.TestResult {
	// The "pkg.Name" form is what pkg/ir emits for user functions
	// — already-qualified by package.  symFor's pkgName arg is
	// ignored in this case.
	var s @[]char = symFor("ignored", "main.main")
	if !charsEqual(s, "bn_main__main") {
		return "symFor with dot-qualified name should ignore pkgName"
	}
	return ""
}

func TestSymForNoUnderscorePrefix() testing.TestResult {
	// ELF (unlike Mach-O) doesn't add an underscore prefix for C
	// linkage.  Pin that — a regression here would link-fail on
	// every conformance test.
	var s @[]char = symFor("foo", "bar")
	if len(s) == 0 || s[0] == '_' {
		return "ELF symbols must NOT have an underscore prefix"
	}
	return ""
}

// stripQuotes peels off the surrounding source-text quoting from an
// IR module name (e.g. `"\"pkg/foo\""` → `pkg/foo`).
func TestStripQuotesRemoves() testing.TestResult {
	var s *[]const char = stripQuotes("\"pkg/foo\"")
	if !charsEqual(s, "pkg/foo") {
		return "stripQuotes should remove surrounding double-quotes"
	}
	return ""
}

func TestStripQuotesPassthroughIfNoQuotes() testing.TestResult {
	var s *[]const char = stripQuotes("pkg/foo")
	if !charsEqual(s, "pkg/foo") {
		return "stripQuotes should pass through if no quotes"
	}
	return ""
}

func TestStripQuotesShortString() testing.TestResult {
	// One-char input shouldn't trip the >= 2 guard.
	var s *[]const char = stripQuotes("a")
	if !charsEqual(s, "a") {
		return "stripQuotes should pass through 1-char input"
	}
	return ""
}

// blockLabel mints `L<funcSym>__<blkLabel>`.  Pin the exact shape
// so a regression to a different prefix / separator (e.g. dropping
// the double-underscore) doesn't silently collide with
// user-defined symbols.
func TestBlockLabelShape() testing.TestResult {
	var s @[]char = blockLabel("bn_main__main", "entry")
	if !charsEqual(s, "Lbn_main__main__entry") {
		return "blockLabel should be L<funcSym>__<blkLabel>"
	}
	return ""
}

// Distinct (funcSym, blkLabel) pairs must mint distinct labels,
// otherwise cross-function block-label collisions corrupt fixups.
func TestBlockLabelDistinct() testing.TestResult {
	var a @[]char = blockLabel("bn_main__main", "loop")
	var b @[]char = blockLabel("bn_main__main", "exit")
	if charsEqual(a, b) {
		return "different blkLabels should mint different labels"
	}
	var c @[]char = blockLabel("bn_pkg__other", "loop")
	if charsEqual(a, c) {
		return "different funcSyms should mint different labels"
	}
	return ""
}

// globalSymFor mangles a package-level variable to the bare
// `bn_<pkg>__<name>` symbol (no ELF underscore prefix).
func TestGlobalSymFor() testing.TestResult {
	var s @[]char = globalSymFor("main", "g")
	if !charsEqual(s, "bn_main__g") {
		return "globalSymFor(main, g) should be bn_main__g"
	}
	if len(s) > 0 && s[0] == '_' {
		return "ELF global symbols must NOT have underscore prefix"
	}
	return ""
}

// stringLabel mints `Lstr_<id>` — local label that ResolveFixups
// patches without needing a real ELF symbol.
func TestStringLabelShape() testing.TestResult {
	var s @[]char = stringLabel(0)
	if !charsEqual(s, "Lstr_0") {
		return "stringLabel(0) should be Lstr_0"
	}
	var s7 @[]char = stringLabel(7)
	if !charsEqual(s7, "Lstr_7") {
		return "stringLabel(7) should be Lstr_7"
	}
	return ""
}

// argReg returns the SysV-AMD64 integer arg-reg order.  Pin all 6
// slots — a swap would silently misorder every call's args.
func TestArgReg() testing.TestResult {
	// Use the x64 register constants for clarity.  RDI=7, RSI=6,
	// RDX=2, RCX=1, R8=8, R9=9 in pkg/asm/x64.
	if argReg(0) != 7 { return "arg 0 should be RDI" }
	if argReg(1) != 6 { return "arg 1 should be RSI" }
	if argReg(2) != 2 { return "arg 2 should be RDX" }
	if argReg(3) != 1 { return "arg 3 should be RCX" }
	if argReg(4) != 8 { return "arg 4 should be R8" }
	if argReg(5) != 9 { return "arg 5 should be R9" }
	return ""
}
