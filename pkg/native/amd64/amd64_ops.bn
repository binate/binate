package "pkg/native/amd64"

import "pkg/asm"
import "pkg/asm/x64"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// ============================================================
// Binary / unary / constant ops (Phase 3b)
// ============================================================

// emitConstInt64 materialises a 64-bit integer constant into rd.
// SysV-AMD64 MOV reg64, imm64 (encoded by x64.Mov as 0x48 0xB8+rd
// imm64) handles the full 64-bit range — no MOVK chain needed
// (unlike AArch64's 16-bit MOVZ/MOVK pairs).  x64.Mov picks the
// shortest encoding automatically (imm32-sext for small values,
// imm64 for full-width).
func emitConstInt64(a @asm.Assembler, rd int, val int) {
	x64.Mov(a, x64.Reg(rd, x64.SZ64), x64.Imm(val))
}

// emitBinop handles the integer arithmetic, bitwise, and shift ops.
// Returns true if it matched and emitted code; false otherwise.
//
// SysV-AMD64 two-operand encoding: `op dst, src` where dst is read
// and written.  We emit:
//   mov rd, lhs    ; rd holds lhs
//   <op> rd, rhs   ; rd = rd <op> rhs
// rd is the scratch register newly allocated for ins.ID.
//
// Shifts (SHL/SHR/SAR) require the count in CL.  When the rhs is a
// register, MOV it to CL first, then emit the shift with CL.
//
// DIV / REM are deferred — they need RDX:RAX setup (CQO + IDIV) and
// have register-allocation constraints that don't fit the simple
// `mov rd, lhs ; op rd, rhs` shape.  Phase 3b lands them as a
// follow-on micro-step if needed; for now they fall through.
func emitBinop(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != ir.OP_ADD &&
		ins.Op != ir.OP_SUB &&
		ins.Op != ir.OP_MUL &&
		ins.Op != ir.OP_AND &&
		ins.Op != ir.OP_OR  &&
		ins.Op != ir.OP_XOR &&
		ins.Op != ir.OP_SHL &&
		ins.Op != ir.OP_SHR &&
		ins.Op != ir.OP_LAND &&
		ins.Op != ir.OP_LOR {
		return false
	}
	if len(ins.Args) != 2 { return false }

	var lhs int = getOperand(a, rm, ins.Args[0].ID)
	var rhs int = getOperand(a, rm, ins.Args[1].ID)
	if lhs < 0 || rhs < 0 { return false }

	var rd int = nextReg(rm, ins.ID)
	var rdOp x64.Operand = x64.Reg(rd, x64.SZ64)
	var rhsOp x64.Operand = x64.Reg(rhs, x64.SZ64)
	x64.Mov(a, rdOp, x64.Reg(lhs, x64.SZ64))

	if ins.Op == ir.OP_ADD { x64.Add(a, rdOp, rhsOp); return true }
	if ins.Op == ir.OP_SUB { x64.Sub(a, rdOp, rhsOp); return true }
	if ins.Op == ir.OP_MUL { x64.Imul2(a, rdOp, rhsOp); return true }
	if ins.Op == ir.OP_AND { x64.And(a, rdOp, rhsOp); return true }
	if ins.Op == ir.OP_OR  { x64.Or(a, rdOp, rhsOp);  return true }
	if ins.Op == ir.OP_XOR { x64.Xor(a, rdOp, rhsOp); return true }
	// OP_LAND / OP_LOR — used by switch case lists (`case 1, 2, 3:`)
	// where all comparisons are always evaluated.  Plain bitwise on
	// bool registers gives the right result.  User-level `&&` / `||`
	// short-circuit through the IR's branch-form lowering and never
	// reach here.
	if ins.Op == ir.OP_LAND { x64.And(a, rdOp, rhsOp); return true }
	if ins.Op == ir.OP_LOR  { x64.Or(a, rdOp, rhsOp);  return true }

	// Shifts: count must be in CL.  Move rhs → RCX (the SZ8 view CL
	// is the low byte), then issue the shift on rd.  Unsigned uint
	// values need SHR (logical); signed values need SAR (arithmetic).
	var isUnsigned bool = ins.Typ != nil &&
		ins.Typ.IsInteger() && !ins.Typ.Signed
	if ins.Op == ir.OP_SHL || ins.Op == ir.OP_SHR {
		// MOV rcx, rhs (SZ64); the shift instruction reads CL.
		x64.Mov(a, x64.Reg(x64.RCX, x64.SZ64), x64.Reg(rhs, x64.SZ64))
		var clOp x64.Operand = x64.Reg(x64.RCX, x64.SZ8)
		if ins.Op == ir.OP_SHL {
			x64.Shl(a, rdOp, clOp)
			return true
		}
		// OP_SHR: signedness picks SHR (logical) vs SAR (arithmetic).
		if isUnsigned {
			x64.Shr(a, rdOp, clOp)
		} else {
			x64.Sar(a, rdOp, clOp)
		}
		return true
	}
	return false
}

// emitUnop handles unary ops (-, ~, !).  Returns true if matched.
func emitUnop(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != ir.OP_NEG && ins.Op != ir.OP_BITNOT &&
			ins.Op != ir.OP_NOT {
		return false
	}
	if len(ins.Args) != 1 { return false }

	var src int = getOperand(a, rm, ins.Args[0].ID)
	if src < 0 { return false }

	var rd int = nextReg(rm, ins.ID)
	var rdOp x64.Operand = x64.Reg(rd, x64.SZ64)
	x64.Mov(a, rdOp, x64.Reg(src, x64.SZ64))

	if ins.Op == ir.OP_NEG {
		x64.Neg(a, rdOp)
		return true
	}
	if ins.Op == ir.OP_BITNOT {
		x64.Not(a, rdOp)
		return true
	}
	// OP_NOT: logical negation on a bool.  Flip bit 0 with XOR 1.
	if ins.Op == ir.OP_NOT {
		x64.Xor(a, rdOp, x64.Imm(1))
		return true
	}
	return false
}
