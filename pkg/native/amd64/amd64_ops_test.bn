package "pkg/native/amd64"

import "pkg/asm"
import "pkg/asm/x64"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// opsMkAssembler: minimal assembler for direct-emit tests.
func opsMkAssembler() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func opsBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// emitConstInt64 small value → 5-byte `mov r10d, imm32` (no REX.W
// for values that fit signed 32-bit).  x64.Mov picks the shortest
// encoding automatically.
func TestEmitConstInt64SmallValue() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitConstInt64(a, x64.R10, 42)
	if opsBytes(a) == 0 {
		return "emitConstInt64 should emit at least one instruction"
	}
	return ""
}

// emitConstInt64 large value (> i32 max) → 10-byte movabs imm64
// (`49 BA imm64` for r10).  Pins the encoding so a future change
// that drops the imm64 encoding silently truncates wide constants.
func TestEmitConstInt64ImmediateWidth() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitConstInt64(a, x64.R10, 5000000000)
	// movabs r10, imm64 = REX.B (0x49) + 0xBA + 8 imm bytes = 10.
	if opsBytes(a) != 10 {
		return "movabs r64, imm64 should be 10 bytes"
	}
	var data *[]uint8 = a.Sections[0].Data
	if data[0] != cast(uint8, 0x49) {
		return "byte 0 should be REX.B prefix (0x49)"
	}
	if data[1] != cast(uint8, 0xBA) {
		return "byte 1 should be MOV r10, imm64 opcode (0xBA = 0xB8+2)"
	}
	return ""
}

// emitBinop OP_ADD path: spill-everything means it emits 2× MOV
// (reload lhs and rhs from spill slots), 1× MOV rd,lhs, 1× ADD
// rd,rhs.  The exact byte count is encoding-dependent; just pin
// "non-empty" and verify the lowering doesn't crash.  More
// detailed byte tests live in the conformance suite.
func TestEmitBinopAddNonEmpty() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_ADD
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_ADD"
	}
	if opsBytes(a) == 0 {
		return "OP_ADD should emit instructions"
	}
	return ""
}

// emitBinop rejects ops it doesn't handle (returns false so the
// dispatcher can try the next handler).  OP_LOAD is a memory op,
// not a binop, so emitBinop must return false for it without
// emitting any bytes.
func TestEmitBinopRejectsNonBinop() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_LOAD
	if emitBinop(a, m, ins) {
		return "emitBinop should return false for OP_LOAD"
	}
	if opsBytes(a) != 0 {
		return "emitBinop should emit nothing for unmatched op"
	}
	return ""
}

// OP_LOR / OP_LAND: used by switch case-OR generation (`case 1, 2,
// 3:` chains) where short-circuit doesn't apply.  emitBinop must
// dispatch them or the chain silently no-ops.  Mirrors aa64's
// TestEmitBinopHandlesLor.
func TestEmitBinopHandlesLor() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypBool()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypBool()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_LOR
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_LOR"
	}
	return ""
}

// Shifts route through CL; the rhs reg is MOV'd into RCX before
// the shift is emitted.  Pin that — without it, the shift would
// read whatever CL happened to hold and silently corrupt output.
func TestEmitBinopShiftMovesIntoCL() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 3)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypInt()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_SHL
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_SHL"
	}
	if opsBytes(a) == 0 {
		return "OP_SHL should emit instructions (incl. mov rcx, rhs)"
	}
	return ""
}

// emitUnop OP_NEG: 1× reload + 1× MOV rd,src + 1× NEG rd.
func TestEmitUnopNegNonEmpty() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_NEG
	ins.Typ = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	if !emitUnop(a, m, ins) {
		return "emitUnop should match OP_NEG"
	}
	if opsBytes(a) == 0 {
		return "OP_NEG should emit instructions"
	}
	return ""
}

// OP_NOT is logical-not on a bool; lowered to `xor rd, 1` to flip
// bit 0.  Pin that — a regression to `not rd` would invert ALL bits
// and break later truthiness checks.
func TestEmitUnopNotIsXorImm1() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Typ = types.TypBool()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 2
	ins.Op = ir.OP_NOT
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	if !emitUnop(a, m, ins) {
		return "emitUnop should match OP_NOT"
	}
	return ""
}

// emitUnop rejects non-unops — must return false for OP_ADD so the
// dispatcher can route it to emitBinop.
func TestEmitUnopRejectsBinop() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = common.NewRegMap(common.SysV_AMD64())
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_ADD
	if emitUnop(a, m, ins) {
		return "emitUnop should return false for OP_ADD"
	}
	if opsBytes(a) != 0 {
		return "emitUnop should emit nothing for unmatched op"
	}
	return ""
}
