// Package arm64 is the AArch64 backend of pkg/native. Named arm64 (not
// aarch64) so its mangled short name doesn't collide with pkg/asm/aarch64.
// Walking-skeleton stage: emits a Mach-O object file that can link with the
// existing C runtime (which provides int main()). Currently supports only
// the trivial bn_main with a single OP_RETURN and no arguments.
package "pkg/native/arm64"

import "pkg/ir"

// EmitObject lowers an IR module to AArch64 and writes a Mach-O .o file.
// Caller links the resulting object with runtime/binate_runtime.c.
func EmitObject(mod @ir.Module, path *[]const char) bool

// symFor returns the Mach-O symbol name for a Binate function:
// the mangled name with a leading '_' (Mach-O C-linkage convention).
func symFor(pkgName *[]const char, funcName *[]const char) @[]char
