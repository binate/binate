package "pkg/native/arm64"

import "pkg/asm"
import "pkg/asm/aarch64"
import "pkg/asm/macho"
import "pkg/ir"
import "pkg/mangle"
import "pkg/native/common"
import "pkg/types"

// ============================================================
// EmitObject — module entry
// ============================================================

// EmitObject emits one __text section containing every function in the
// module, plus a string table with collected literals, resolves
// fixups, and writes a Mach-O .o.
func EmitObject(mod @ir.Module, path *[]char) bool {
	ir.FinalizeStrings(mod)

	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)

	var pkgName *[]char = mangle.PkgShortName(stripQuotes(mod.Name))

	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		emitFunc(a, pkgName, f, mod.Strings)
	}

	emitStringTable(a, mod.Strings)

	aarch64.ResolveFixups(a)
	asm.Finalize(a)
	if a.HasError { return false }

	return macho.WriteARM64(a, path)
}

// emitStringTable emits every collected string literal with a local
// label `Lstr_<id>` pointing at its bytes. They live in the same
// `text` section as code so ADR fixups can be resolved in-place by
// aarch64.ResolveFixups — Mach-O's ADR_LO21 relocation isn't
// round-trippable through `ld`, so cross-section ADR won't link.
func emitStringTable(a @asm.Assembler, strings @[]ir.StringConst) {
	if len(strings) == 0 { return }
	for i := 0; i < len(strings); i++ {
		var sc ir.StringConst = strings[i]
		asm.DefineLabel(a, stringLabel(sc.ID))
		asm.EmitAsciz(a, sc.Data)
	}
	// Pad back up to instruction alignment so any subsequent emissions
	// stay on 4-byte boundaries.
	asm.Align(a, 4)
}

// ============================================================
// emitFunc — prologue, body, epilogue
// ============================================================

// emitFunc lowers one function. Prologue saves FP/LR and allocates
// the local stack frame; epilogue reverses.
func emitFunc(a @asm.Assembler, pkgName *[]char, f @ir.Func,
	strings @[]ir.StringConst) {
	var sym @[]char = symFor(pkgName, f.Name)
	asm.DefineLabel(a, sym)
	asm.SetGlobal(a, sym)

	var rm @common.RegMap = make(common.RegMap)
	var frameSize int = common.PlanFrame(rm, f)

	// Prologue:
	//   stp x29, x30, [sp, #-16]!
	//   mov x29, sp
	//   sub sp, sp, #frameSize
	aarch64.Stp(a, true, aarch64.FP, aarch64.LR,
		aarch64.MemPre(aarch64.SP, -16))
	aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
	if frameSize > 0 {
		aarch64.Sub(a, true, aarch64.SP, aarch64.SP,
			aarch64.Imm(frameSize))
	}
	// Spill incoming parameter registers to their stack slots so later
	// uses (which go through getOperand → spill reload) see them.
	// Aggregate params (slices) arrive spread across N consecutive arg
	// registers: we write the N words into the param's data region
	// (common.PlanFrame reserved one via AllocIDs) and store a pointer to that
	// region in the param's 8-byte spill slot, mirroring MAKE_SLICE.
	var argRegIdx int = 0
	for pi := 0; pi < len(f.Params) && argRegIdx < 8; pi++ {
		var p @ir.Param = f.Params[pi]
		if common.IsAggregateTyp(p.Typ) {
			var dataOff int = common.LookupAlloc(rm, p.ID)
			var sz int = common.LookupAllocSize(rm, p.ID)
			if dataOff >= 0 && sz > 0 {
				var nWords int = sz / 8
				for w := 0; w < nWords && argRegIdx < 8; w++ {
					aarch64.Str(a, true, argReg(argRegIdx),
						aarch64.MemImm(aarch64.SP, dataOff + 8*w))
					argRegIdx = argRegIdx + 1
				}
				var spillOff int = common.LookupSpill(rm, p.ID)
				if spillOff >= 0 {
					var tmp int = scratchReg(rm)
					aarch64.Add(a, true, tmp, aarch64.SP,
						aarch64.Imm(dataOff))
					aarch64.Str(a, true, tmp,
						aarch64.MemImm(aarch64.SP, spillOff))
				}
				common.ResetRegs(rm)
			}
		} else {
			var off int = common.LookupSpill(rm, p.ID)
			if off >= 0 {
				aarch64.Str(a, true, argReg(argRegIdx),
					aarch64.MemImm(aarch64.SP, off))
			}
			argRegIdx = argRegIdx + 1
		}
	}

	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		if bi > 0 {
			asm.DefineLabel(a, blockLabel(sym, b.Label))
		}
		// Each block starts with a fresh regmap. Cross-block values
		// flow through spill slots.
		common.ResetRegs(rm)
		for ii := 0; ii < len(b.Instrs); ii++ {
			emitInstr(a, pkgName, sym, rm, strings, b.Instrs[ii])
			// Spill the result (if this instruction produced a value)
			// and reset the register pool. emitCall handles its own
			// spill/reset internally, so this is a no-op for calls.
			spillAndReset(a, rm, b.Instrs[ii])
		}
	}

	// Safety net: emit an epilogue if the IR didn't end with OP_RETURN.
	emitEpilogueAndRet(a, frameSize)
}

// ============================================================
// emitInstr — instruction selection
// ============================================================

// emitInstr lowers one IR instruction. Walking-skeleton subset only;
// instructions outside this set are silently ignored.
func emitInstr(a @asm.Assembler, pkgName *[]char, funcSym @[]char,
	rm @common.RegMap, strings @[]ir.StringConst, ins @ir.Instr) {
	if ins.Op == ir.OP_CONST_INT {
		var r int = nextReg(rm, ins.ID)
		emitConstInt64(a, r, ins.IntVal)
		return
	}

	if ins.Op == ir.OP_CONST_BOOL {
		var r int = nextReg(rm, ins.ID)
		var v int = 0
		if ins.BoolVal { v = 1 }
		aarch64.Movz(a, true, r, v, 0)
		return
	}

	if ins.Op == ir.OP_CONST_NIL {
		// Aggregate nil (nil slice, zero struct): zero-init the data
		// region reserved in common.PlanFrame, produce a pointer to it.
		if common.IsAggregateTyp(ins.Typ) {
			var dataOff int = common.LookupAlloc(rm, ins.ID)
			var sz int = common.LookupAllocSize(rm, ins.ID)
			if dataOff >= 0 && sz > 0 {
				for bo := 0; bo < sz; bo = bo + 8 {
					aarch64.Str(a, true, aarch64.XZR,
						aarch64.MemImm(aarch64.SP, dataOff + bo))
				}
				var rd int = nextReg(rm, ins.ID)
				aarch64.Add(a, true, rd, aarch64.SP,
					aarch64.Imm(dataOff))
				return
			}
		}
		// Scalar nil (managed ptr, raw ptr, etc.): zero.
		var rd int = nextReg(rm, ins.ID)
		aarch64.Movz(a, true, rd, 0, 0)
		return
	}

	if ins.Op == ir.OP_CONST_STRING {
		var id int = ir.FindStringID(strings, ins.StrVal)
		if id < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		aarch64.Adr(a, rd, stringLabel(id))
		return
	}

	if ins.Op == ir.OP_STRING_TO_CHARS {
		// Materialize the string literal as a slice value in the data
		// region reserved by common.PlanFrame. Until we grow `@[]const
		// char` + a read-only data section for pre-baked globals, each
		// use pays the small cost of constructing {data, len, refptr=0,
		// backingLen=0}. Safe because bn_rt__RefInc/RefDec no-op on
		// null refptr.
		if len(ins.Args) < 1 { return }
		var strArg @ir.Instr = ins.Args[0]
		var sid int = ir.FindStringID(strings, strArg.StrVal)
		if sid < 0 { return }
		var dataOff int = common.LookupAlloc(rm, ins.ID)
		if dataOff < 0 { return }
		// data ptr → [sp, dataOff].
		var dataReg int = scratchReg(rm)
		aarch64.Adr(a, dataReg, stringLabel(sid))
		aarch64.Str(a, true, dataReg,
			aarch64.MemImm(aarch64.SP, dataOff))
		// length → [sp, dataOff+8].
		var lenReg int = scratchReg(rm)
		emitConstInt64(a, lenReg, len(strArg.StrVal))
		aarch64.Str(a, true, lenReg,
			aarch64.MemImm(aarch64.SP, dataOff + 8))
		// Managed slice (@[]char) fills refptr + backingLen with zeros;
		// raw slice (*[]char) is only 16 bytes, so skip.
		if ins.Typ != nil &&
			ins.Typ.Kind == types.TYP_MANAGED_SLICE {
			aarch64.Str(a, true, aarch64.XZR,
				aarch64.MemImm(aarch64.SP, dataOff + 16))
			aarch64.Str(a, true, aarch64.XZR,
				aarch64.MemImm(aarch64.SP, dataOff + 24))
		}
		common.ResetRegs(rm)
		// Produce pointer to the data region so downstream EXTRACT /
		// struct copy / call-arg spreading consumes it the same way as
		// MAKE_SLICE / LOAD results.
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}

	if emitCompare(a, rm, ins) { return }

	if ins.Op == ir.OP_CALL {
		emitCall(a, pkgName, rm, ins, false)
		return
	}

	if ins.Op == ir.OP_CALL_BUILTIN {
		// Builtin calls use StrVal verbatim as the C symbol.
		emitCall(a, pkgName, rm, ins, true)
		return
	}

	if ins.Op == ir.OP_REFCOUNT_INC {
		emitRefcountCall(a, rm, ins, "bn_rt__RefInc", false)
		return
	}

	if ins.Op == ir.OP_REFCOUNT_DEC {
		// Args[1], if present, is the destructor function pointer; if
		// absent, pass null. See ir.EmitRefcountDec / EmitRefcountDecDtor.
		emitRefcountCall(a, rm, ins, "bn_rt__RefDec", true)
		return
	}

	if ins.Op == ir.OP_RETURN {
		// Each return value goes in X0..X(N-1). If any two args already
		// live in clashing regs, a naive move sequence could clobber.
		// Walking-skeleton gets away with it because every getOperand
		// loads fresh from the spill slot into X9..X15.
		for ri := 0; ri < len(ins.Args) && ri < 8; ri++ {
			var src int = getOperand(a, rm, ins.Args[ri].ID)
			if src >= 0 && src != argReg(ri) {
				aarch64.Mov(a, true, argReg(ri), aarch64.Reg(src))
			}
		}
		emitEpilogueAndRet(a, common.FrameSize(rm))
		return
	}

	if ins.Op == ir.OP_MANAGED_TO_RAW {
		// @[]T → *[]T: the first 16 bytes of a managed-slice's
		// in-memory form (data + len) ARE the raw-slice
		// representation. Pass the source's pointer through; callers
		// (slice-as-call-arg, struct copy) read only the first 2
		// words.
		if len(ins.Args) < 1 { return }
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		aarch64.Mov(a, true, rd, aarch64.Reg(src))
		return
	}

	if ins.Op == ir.OP_BIT_CAST {
		// Reinterpret same-size bits. In a 64-bit register file this
		// is a plain move (or even a no-op if src == rd).
		if len(ins.Args) < 1 { return }
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		aarch64.Mov(a, true, rd, aarch64.Reg(src))
		return
	}

	if ins.Op == ir.OP_CAST {
		// Numeric conversion. For a narrower target (e.g. uint32), we
		// must truncate the high bits; AArch64 32-bit register view
		// would zero-extend for free, but our regmap is all X-regs,
		// so do it explicitly with LSL+LSR/ASR.
		if len(ins.Args) < 1 || ins.TypeArg == nil { return }
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		emitCast(a, rd, src, ins.TypeArg)
		return
	}

	if ins.Op == ir.OP_EXTRACT {
		// ins.Index-th word of an aggregate SSA value. Two storage
		// forms (see common.SpillHoldsAggregatePointer):
		//   (a) multi-return calls pack N*8 bytes directly into the
		//       spill slot (X0..X(N-1) stored at slot + 8*i by
		//       emitCall) — read at slot + 8*Index.
		//   (b) everything else aggregate-typed keeps a *pointer* to
		//       the data in the spill slot — indirect through the
		//       pointer + 8*Index.
		if len(ins.Args) < 1 { return }
		var src @ir.Instr = ins.Args[0]
		var rd int = nextReg(rm, ins.ID)
		if common.SpillHoldsAggregatePointer(src) {
			var ptr int = getOperand(a, rm, src.ID)
			if ptr < 0 { return }
			aarch64.Ldr(a, true, rd,
				aarch64.MemImm(ptr, 8*ins.Index))
			return
		}
		var srcSlot int = common.LookupSpill(rm, src.ID)
		if srcSlot < 0 { return }
		aarch64.Ldr(a, true, rd,
			aarch64.MemImm(aarch64.SP, srcSlot + 8*ins.Index))
		return
	}

	if ins.Op == ir.OP_ALLOC {
		// Offset was assigned in common.PlanFrame. Aggregate allocas
		// zero-init to match LLVM's `store ... zeroinitializer`.
		if common.IsAggregateTyp(ins.TypeArg) {
			var off int = common.LookupAlloc(rm, ins.ID)
			var sz int = common.LookupAllocSize(rm, ins.ID)
			if off >= 0 && sz > 0 {
				for bo := 0; bo < sz; bo = bo + 8 {
					aarch64.Str(a, true, aarch64.XZR,
						aarch64.MemImm(aarch64.SP, off + bo))
				}
			}
		}
		return
	}

	if ins.Op == ir.OP_MAKE {
		// make(T) — heap-allocate a zero-initialized @T.
		// bn_rt__Alloc(size) returns the payload pointer (refcount=1).
		if ins.TypeArg == nil { return }
		emitConstInt64(a, aarch64.X0, types.SizeOf(ins.TypeArg))
		var callee @[]char = underscorePrefix("bn_rt__Alloc")
		asm.SetGlobal(a, callee)
		aarch64.Bl(a, callee)
		common.ResetRegs(rm)
		var rd int = nextReg(rm, ins.ID)
		aarch64.Mov(a, true, rd, aarch64.Reg(aarch64.X0))
		return
	}

	if ins.Op == ir.OP_BOX {
		// box(val) — heap-copy val into a new managed allocation.
		// bn_rt__Box(srcPtr, size) → new payload pointer.
		// Supports the common case where Args[0] is an OP_ALLOC: we
		// already have a pointer to its stack storage; handing a
		// non-ALLOC scalar through box would require spilling to a
		// scratch buffer first, not yet needed.
		if len(ins.Args) < 1 { return }
		var val @ir.Instr = ins.Args[0]
		if val.Op != ir.OP_ALLOC || val.TypeArg == nil { return }
		var allocOff int = common.LookupAlloc(rm, val.ID)
		if allocOff < 0 { return }
		aarch64.Add(a, true, aarch64.X0, aarch64.SP,
			aarch64.Imm(allocOff))
		emitConstInt64(a, aarch64.X1, types.SizeOf(val.TypeArg))
		var callee @[]char = underscorePrefix("bn_rt__Box")
		asm.SetGlobal(a, callee)
		aarch64.Bl(a, callee)
		common.ResetRegs(rm)
		var rd int = nextReg(rm, ins.ID)
		aarch64.Mov(a, true, rd, aarch64.Reg(aarch64.X0))
		return
	}

	if ins.Op == ir.OP_MAKE_SLICE {
		// make_slice(T, n) — call bn_rt__MakeManagedSlice(elemSize, n).
		// common.PlanFrame reserved a dedicated 32-byte data region on this
		// ID (via AllocIDs) so OP_EXTRACT and OP_STORE struct-copies
		// can treat a MAKE_SLICE result identically to an OP_LOAD of
		// an aggregate: spill slot holds a pointer, data lives
		// elsewhere.
		//
		// ABI: the LLVM-compiled runtime returns the 32-byte struct
		// packed in X0..X3 (LLVM's default AArch64 lowering for
		// aggregate returns that fit in <=8 GP registers), not via
		// X8/sret. We store the 4 words into the data region after BL.
		if len(ins.Args) < 1 || ins.TypeArg == nil { return }
		var dataOff int = common.LookupAlloc(rm, ins.ID)
		if dataOff < 0 { return }
		emitConstInt64(a, aarch64.X0, types.SizeOf(ins.TypeArg))
		var lenReg int = getOperand(a, rm, ins.Args[0].ID)
		if lenReg < 0 { return }
		aarch64.Mov(a, true, aarch64.X1, aarch64.Reg(lenReg))
		var callee @[]char = underscorePrefix("bn_rt__MakeManagedSlice")
		asm.SetGlobal(a, callee)
		aarch64.Bl(a, callee)
		aarch64.Str(a, true, aarch64.X0,
			aarch64.MemImm(aarch64.SP, dataOff))
		aarch64.Str(a, true, aarch64.X1,
			aarch64.MemImm(aarch64.SP, dataOff + 8))
		aarch64.Str(a, true, aarch64.X2,
			aarch64.MemImm(aarch64.SP, dataOff + 16))
		aarch64.Str(a, true, aarch64.X3,
			aarch64.MemImm(aarch64.SP, dataOff + 24))
		common.ResetRegs(rm)
		// Produce a pointer to the data region; spillAndReset will
		// store it in the 8-byte spill slot.
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}

	if ins.Op == ir.OP_LOAD {
		if len(ins.Args) < 1 { return }
		// Struct/array load: pass the source pointer through; the IR
		// uses LOAD+STORE as a struct copy idiom.
		if common.IsAggregateTyp(ins.Typ) {
			var rd int = nextReg(rm, ins.ID)
			var allocOff int = common.LookupAlloc(rm, ins.Args[0].ID)
			if allocOff >= 0 {
				aarch64.Add(a, true, rd, aarch64.SP,
					aarch64.Imm(allocOff))
			} else {
				var src int = getOperand(a, rm, ins.Args[0].ID)
				if src < 0 { return }
				aarch64.Mov(a, true, rd, aarch64.Reg(src))
			}
			return
		}
		// Scalar load. Size-dispatched so char/uint8 uses LDRB rather
		// than LDR (which would pull in 7 bytes of neighboring memory
		// and call it a char). Signed integer narrowing is the caller
		// (OP_CAST) handling sign-extension explicitly, so LDRB/LDRH
		// are fine here.
		var sz int = 8
		if ins.Typ != nil { sz = types.SizeOf(ins.Typ) }
		if sz <= 0 { sz = 8 }
		var off int = common.LookupAlloc(rm, ins.Args[0].ID)
		if off >= 0 {
			var rd int = nextReg(rm, ins.ID)
			emitScalarLoad(a, rd, aarch64.SP, off, sz)
			return
		}
		var ptr int = getOperand(a, rm, ins.Args[0].ID)
		if ptr < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		emitScalarLoad(a, rd, ptr, 0, sz)
		return
	}

	if ins.Op == ir.OP_STORE {
		// Args[0] = dest ptr, Args[1] = value (or source ptr for
		// struct-copy — see OP_LOAD's aggregate path).
		if len(ins.Args) < 2 { return }
		if common.IsAggregateTyp(ins.Args[1].Typ) {
			emitStructCopy(a, rm, ins)
			return
		}
		// Scalar store. Size-dispatched (STRB/STRH/STR) so a char store
		// only touches 1 byte — writing 8 bytes would clobber 7 bytes
		// of surrounding memory.
		var sz int = 8
		if ins.Args[1].Typ != nil { sz = types.SizeOf(ins.Args[1].Typ) }
		if sz <= 0 { sz = 8 }
		var off int = common.LookupAlloc(rm, ins.Args[0].ID)
		var valReg int = getOperand(a, rm, ins.Args[1].ID)
		if valReg < 0 { return }
		if off >= 0 {
			emitScalarStore(a, valReg, aarch64.SP, off, sz)
			return
		}
		var ptr int = getOperand(a, rm, ins.Args[0].ID)
		if ptr < 0 { return }
		emitScalarStore(a, valReg, ptr, 0, sz)
		return
	}

	if ins.Op == ir.OP_GET_ELEM_PTR {
		// Args[0] = array/slice data pointer, Args[1] = index (i64).
		// The GEP's Typ is *elemTyp, which tells us the element size
		// regardless of whether we got here via array indexing or via
		// slice indexing (where the base has been shredded to i8*).
		if len(ins.Args) < 2 { return }
		var elemSize int = common.ElemSizeOf(ins)
		if elemSize <= 0 { return }
		var idx int = getOperand(a, rm, ins.Args[1].ID)
		if idx < 0 { return }

		// byteOff = idx * elemSize
		var sizeTmp int = scratchReg(rm)
		aarch64.Movz(a, true, sizeTmp, elemSize, 0)
		var byteOff int = scratchReg(rm)
		aarch64.Mul(a, true, byteOff, idx, sizeTmp)

		var rd int = nextReg(rm, ins.ID)
		var allocOff int = common.LookupAlloc(rm, ins.Args[0].ID)
		if allocOff >= 0 {
			aarch64.Add(a, true, rd, aarch64.SP,
				aarch64.Imm(allocOff))
			aarch64.Add(a, true, rd, rd, aarch64.Reg(byteOff))
			return
		}
		var base int = getOperand(a, rm, ins.Args[0].ID)
		if base < 0 { return }
		aarch64.Add(a, true, rd, base, aarch64.Reg(byteOff))
		return
	}

	if ins.Op == ir.OP_GET_FIELD_PTR {
		if len(ins.Args) < 1 { return }
		var baseTyp @types.Type = common.StructTypeOf(ins.Args[0])
		if baseTyp == nil { return }
		var fieldOff int = types.FieldOffset(baseTyp, ins.Index)
		var rd int = nextReg(rm, ins.ID)
		var allocOff int = common.LookupAlloc(rm, ins.Args[0].ID)
		if allocOff >= 0 {
			aarch64.Add(a, true, rd, aarch64.SP,
				aarch64.Imm(allocOff + fieldOff))
			return
		}
		var ptr int = getOperand(a, rm, ins.Args[0].ID)
		if ptr < 0 { return }
		aarch64.Add(a, true, rd, ptr, aarch64.Imm(fieldOff))
		return
	}

	if ins.Op == ir.OP_JUMP {
		if ins.Block1 == nil { return }
		aarch64.B(a, blockLabel(funcSym, ins.Block1.Label))
		return
	}

	if ins.Op == ir.OP_BRANCH {
		// Args[0] = cond, Block1 = then, Block2 = else.
		if ins.Block1 == nil || ins.Block2 == nil ||
			len(ins.Args) < 1 {
			return
		}
		var condReg int = getOperand(a, rm, ins.Args[0].ID)
		if condReg < 0 { return }
		aarch64.Cbnz(a, true, condReg,
			blockLabel(funcSym, ins.Block1.Label))
		aarch64.B(a, blockLabel(funcSym, ins.Block2.Label))
		return
	}

	if emitBinop(a, rm, ins) { return }
	if emitUnop(a, rm, ins)  { return }

	// Any other op is a no-op in this skeleton.
}
