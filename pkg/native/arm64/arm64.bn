package "pkg/native/arm64"

import "pkg/asm"
import "pkg/asm/aarch64"
import "pkg/asm/macho"
import "pkg/buf"
import "pkg/ir"
import "pkg/mangle"
import "pkg/native/common"
import "pkg/types"

// ============================================================
// EmitObject — module entry
// ============================================================

// EmitObject emits one __text section containing every function in the
// module, plus a string table with collected literals, resolves
// fixups, and writes a Mach-O .o.
func EmitObject(mod @ir.Module, path *[]const char) bool {
	ir.FinalizeStrings(mod)

	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)

	var pkgName *[]const char = mangle.PkgShortName(stripQuotes(mod.Name))

	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		emitFunc(a, pkgName, f, mod.Strings, mod.Funcs)
	}

	emitStringTable(a, mod.Strings)
	emitGlobals(a, pkgName, mod.Globals)
	emitFuncValueVtables(a, pkgName, mod)

	aarch64.ResolveFixups(a)
	asm.Finalize(a)
	if a.HasError { return false }

	return macho.WriteARM64(a, path)
}

// emitStringTable emits every collected string literal with a local
// label `Lstr_<id>` pointing at its bytes. Strings live in the
// `text` section alongside code; reaches go through ADRP+ADD pairs
// (PAGE21+PAGEOFF12 relocs) since Mach-O has no ADR reloc and ADR's
// ±1MB range can't span a large module.
func emitStringTable(a @asm.Assembler, strings @[]ir.StringConst) {
	if len(strings) == 0 { return }
	for i := 0; i < len(strings); i++ {
		var sc ir.StringConst = strings[i]
		asm.DefineLabel(a, stringLabel(sc.ID))
		asm.EmitAsciz(a, sc.Data)
	}
	// Pad back up to instruction alignment so any subsequent emissions
	// stay on 4-byte boundaries.
	asm.Align(a, 4)
}

// emitFuncValueVtables walks the module for OP_FUNC_VALUE references
// and emits one 16-byte vtable per unique function name in __DATA:
//   __vt.<mangled>:
//       .quad 0                ; dtor (no captured ctx for non-capturing)
//       .quad <mangled_func>   ; call slot — real C function pointer
// Globals are emitted with weak (Mach-O equivalent of weak_odr) so the
// linker dedupes across .o's without dropping them. See plan-function-
// values.md "VM-mode vtables — interop-compatible from Phase 1" for the
// design; native arm64 sits in compiled mode so vtable.call holds the
// real function pointer (not a Phase-3 trampoline).
func emitFuncValueVtables(a @asm.Assembler, pkgName *[]const char,
		mod @ir.Module) {
	var seen @[]@[]char
	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		for j := 0; j < len(f.Blocks); j++ {
			var blk @ir.Block = f.Blocks[j]
			for k := 0; k < len(blk.Instrs); k++ {
				var ins @ir.Instr = blk.Instrs[k]
				if ins.Op != ir.OP_FUNC_VALUE { continue }
				var dup bool = false
				for s := 0; s < len(seen); s++ {
					if charEqAA64(seen[s], ins.StrVal) {
						dup = true
						break
					}
				}
				if dup { continue }
				seen = appendNameAA64(seen, ins.StrVal)
			}
		}
	}
	if len(seen) == 0 { return }
	asm.SetSection(a, "data", -1)
	for i := 0; i < len(seen); i++ {
		var label @[]char = vtableSymFor(pkgName, seen[i])
		var fnLabel @[]char = symFor(pkgName, seen[i])
		asm.DefineLabel(a, label)
		asm.SetWeak(a, label)
		// Reference fnLabel so the assembler resolves it as a relocation.
		asm.SetGlobal(a, fnLabel)
		// dtor slot: 8 bytes of zero.
		asm.Zero(a, 8)
		// call slot: word-sized pointer to the function. EmitAddr
		// records a fixup that the linker resolves to the function's
		// runtime address.
		asm.EmitAddr(a, fnLabel)
	}
}

// vtableSymFor returns the underscore-prefixed Mach-O label for a
// function's vtable global: "_bn_<pkg>__<name>__vt".
func vtableSymFor(pkgName *[]const char, fnName *[]const char) @[]char {
	var fn @[]char = symFor(pkgName, fnName)
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(fn)
	cb = cb.WriteStr("__vt")
	return cb.Bytes()
}

// charEqAA64 compares two char slices for equality. Local helper
// (pkg/native/arm64 doesn't pull in pkg/buf's full set).
func charEqAA64(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// appendNameAA64 appends a name to a managed slice (O(n) copy).
func appendNameAA64(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// emitGlobals emits package-level variable storage in a new __DATA
// section. Each global gets a mangled `_bn_<pkg>__<name>` label
// followed by types.SizeOf(g.Typ) zero bytes. pkg/asm/macho maps the
// assembler "data" section to Mach-O __DATA,__data and advertises it
// with 8-byte alignment (see machoSectAlign) so 64-bit LDRs don't
// SIGBUS after the linker splices .o's together. Use sites reach the
// symbol via ADRP+ADD (see emitGlobalAddr).
func emitGlobals(a @asm.Assembler, pkgName *[]const char,
	globals @[]@ir.Global) {
	if len(globals) == 0 { return }
	asm.SetSection(a, "data", -1)
	for i := 0; i < len(globals); i++ {
		var g @ir.Global = globals[i]
		if g == nil { continue }
		var label @[]char = globalSymFor(pkgName, g.Name)
		asm.DefineLabel(a, label)
		asm.SetGlobal(a, label)
		var sz int = 8
		if g.Typ != nil { sz = types.SizeOf(g.Typ) }
		if sz < 8 { sz = 8 }
		if sz % 8 != 0 { sz = sz + (8 - sz % 8) }
		for b := 0; b < sz; b = b + 1 {
			asm.EmitUint8(a, cast(uint8, 0))
		}
	}
}

// ============================================================
// emitFunc — prologue, body, epilogue
// ============================================================

// emitFunc lowers one function. Prologue saves FP/LR and allocates
// the local stack frame; epilogue reverses.
func emitFunc(a @asm.Assembler, pkgName *[]const char, f @ir.Func,
	strings @[]ir.StringConst, allFuncs @[]@ir.Func) {
	// f.Name is dot-qualified ("pkg.Func", "pkg.Type.M", "main.main");
	// symFor → mangle.FuncName treats dotted names as pre-qualified,
	// so the pkgName arg is ignored. Kept for API stability with
	// bare-name callers (none currently in pkg/ir's output).
	var sym @[]char = symFor(pkgName, f.Name)
	asm.DefineLabel(a, sym)
	// IsLinkOnce (dtors / copy helpers, emitted into every module
	// that needs them) gets a Mach-O weak definition so ld
	// deduplicates across the linked .o set. LLVM uses
	// `linkonce_odr` for the same role.
	if f.IsLinkOnce {
		asm.SetWeak(a, sym)
	} else {
		asm.SetGlobal(a, sym)
	}

	var rm @common.RegMap = make(common.RegMap)
	var frameSize int = common.PlanFrame(rm, f)

	// Prologue:
	//   stp x29, x30, [sp, #-16]!
	//   mov x29, sp
	//   sub sp, sp, #frameSize
	aarch64.Stp(a, true, aarch64.FP, aarch64.LR,
		aarch64.MemPre(aarch64.SP, -16))
	aarch64.Mov(a, true, aarch64.FP, aarch64.Reg(aarch64.SP))
	if frameSize > 0 {
		aarch64.Sub(a, true, aarch64.SP, aarch64.SP,
			aarch64.Imm(frameSize))
	}
	// If this function returns an aggregate > 64 bytes, X8 is the
	// AAPCS indirect-result-register (sret) — caller passed a buffer
	// pointer in X8. Stash it before doing anything else; the
	// epilogue's emitReturn will copy the result through it.
	if rm.SretSlotOff >= 0 {
		aarch64.Str(a, true, aarch64.X8,
			aarch64.MemImm(aarch64.SP, rm.SretSlotOff))
	}

	// Spill incoming parameter registers (and read incoming stack
	// args) to their stack slots so later uses — which go through
	// getOperand → spill reload — see them. Mirrors emitCall's
	// AAPCS dispatch: the same regStart/stackOff per param.
	//
	// Incoming stack args sit in the *caller's* outgoing-args area,
	// which is now at [sp + frameSize + 16 + i*8] from the callee's
	// perspective: +frameSize undoes our `sub sp`, +16 undoes our
	// stp fp,lr push.
	var paramTypes @[]@types.Type = make_slice(@types.Type, len(f.Params))
	for pi := 0; pi < len(f.Params); pi++ {
		paramTypes[pi] = f.Params[pi].Typ
	}
	var stackArgsBase int = frameSize + 16
	// AAPCS NSRN: float-scalar params arrive in D(NSRN) (separate from
	// the GP NGRN budget tracked by CallArgRegStart). Walk parameters in
	// order so NSRN matches the caller's per-call counting.
	var nsrn int = 0
	for pi := 0; pi < len(f.Params); pi++ {
		var p @ir.Param = f.Params[pi]
		if common.IsFloatScalarTyp(p.Typ) {
			var off int = common.LookupSpill(rm, p.ID)
			if off >= 0 && nsrn < 8 {
				// Move the float bits from D(nsrn) through a GP scratch
				// to the spill slot. Spills remain GP-addressed memory
				// (matches the float-arithmetic spill pattern).
				var tmp int = scratchReg(rm)
				aarch64.Fmov_fp_to_gp(a, tmp, aarch64.D0 + nsrn)
				aarch64.Str(a, true, tmp,
					aarch64.MemImm(aarch64.SP, off))
				common.ResetRegs(rm)
			}
			nsrn = nsrn + 1
			continue
		}
		var regStart int = common.CallArgRegStart(paramTypes, pi)
		var stackOff int = common.CallArgStackOff(paramTypes, pi)
		if common.IsAggregateTyp(p.Typ) {
			var dataOff int = common.LookupAlloc(rm, p.ID)
			var sz int = common.LookupAllocSize(rm, p.ID)
			if dataOff < 0 || sz <= 0 { continue }
			var nWords int = sz / 8
			// Mirrors emitCall's split: store regs first to the data
			// region, then copy any overflow words from caller's
			// outgoing-args area. With both regStart and stackOff
			// non-negative the arg straddles the X0..X7 boundary.
			var regWords int = 0
			if regStart >= 0 {
				regWords = nWords
				if stackOff >= 0 { regWords = 8 - regStart }
				for w := 0; w < regWords; w++ {
					aarch64.Str(a, true, argReg(regStart + w),
						aarch64.MemImm(aarch64.SP, dataOff + 8*w))
				}
			}
			if stackOff >= 0 {
				var tmp int = scratchReg(rm)
				for w := regWords; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp,
						aarch64.MemImm(aarch64.SP,
							stackArgsBase + stackOff + 8*(w - regWords)))
					aarch64.Str(a, true, tmp,
						aarch64.MemImm(aarch64.SP, dataOff + 8*w))
				}
			}
			var spillOff int = common.LookupSpill(rm, p.ID)
			if spillOff >= 0 {
				var tmp2 int = scratchReg(rm)
				aarch64.Add(a, true, tmp2, aarch64.SP,
					aarch64.Imm(dataOff))
				aarch64.Str(a, true, tmp2,
					aarch64.MemImm(aarch64.SP, spillOff))
			}
			common.ResetRegs(rm)
		} else {
			var off int = common.LookupSpill(rm, p.ID)
			if off < 0 { continue }
			if regStart >= 0 {
				aarch64.Str(a, true, argReg(regStart),
					aarch64.MemImm(aarch64.SP, off))
			} else {
				var tmp int = scratchReg(rm)
				aarch64.Ldr(a, true, tmp,
					aarch64.MemImm(aarch64.SP,
						stackArgsBase + stackOff))
				aarch64.Str(a, true, tmp,
					aarch64.MemImm(aarch64.SP, off))
				common.ResetRegs(rm)
			}
		}
	}

	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		if bi > 0 {
			asm.DefineLabel(a, blockLabel(sym, b.Label))
		}
		// Each block starts with a fresh regmap. Cross-block values
		// flow through spill slots.
		common.ResetRegs(rm)
		for ii := 0; ii < len(b.Instrs); ii++ {
			emitInstr(a, pkgName, sym, rm, strings, allFuncs,
				b.Instrs[ii])
			// Spill the result (if this instruction produced a value)
			// and reset the register pool. emitCall handles its own
			// spill/reset internally, so this is a no-op for calls.
			spillAndReset(a, rm, b.Instrs[ii])
		}
	}

	// Safety net: emit an epilogue if the IR didn't end with OP_RETURN.
	emitEpilogueAndRet(a, frameSize)
}

// ============================================================
// emitInstr — instruction selection
// ============================================================

// emitInstr lowers one IR instruction. Walking-skeleton subset only;
// instructions outside this set are silently ignored. The big op
// handlers (MAKE*, STRING_TO_CHARS, LOAD, STORE, EXTRACT, GEP, etc.)
// live in arm64_emit.bn; this is the dispatcher.
func emitInstr(a @asm.Assembler, pkgName *[]const char, funcSym @[]char,
	rm @common.RegMap, strings @[]ir.StringConst,
	allFuncs @[]@ir.Func, ins @ir.Instr) {
	if ins.Op == ir.OP_CONST_INT {
		var r int = nextReg(rm, ins.ID)
		emitConstInt64(a, r, ins.IntVal)
		return
	}
	if ins.Op == ir.OP_CONST_BOOL {
		var r int = nextReg(rm, ins.ID)
		var v int = 0
		if ins.BoolVal { v = 1 }
		aarch64.Movz(a, true, r, v, 0)
		return
	}
	if ins.Op == ir.OP_CONST_NIL {
		emitConstNil(a, rm, ins)
		return
	}
	if ins.Op == ir.OP_CONST_STRING {
		var id int = ir.FindStringID(strings, ins.StrVal)
		if id < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		// Strings live in __cstring (cross-section). Mach-O has no
		// reloc for ADR; use ADRP + ADD for the @PAGE / @PAGEOFF
		// pair that ld accepts.
		aarch64.Adrp(a, rd, stringLabel(id))
		aarch64.AddImmLabel(a, true, rd, rd, stringLabel(id))
		return
	}
	if ins.Op == ir.OP_CONST_FLOAT {
		var rd int = nextReg(rm, ins.ID)
		emitConstFloat(a, rd, ins)
		return
	}
	if ins.Op == ir.OP_RODATA_ARRAY {
		emitStringToArray(a, rm, strings, ins)
		return
	}
	if ins.Op == ir.OP_RODATA_MSLICE ||
			ins.Op == ir.OP_RODATA_SLICE {
		emitRodataMSliceOrSlice(a, rm, strings, ins)
		return
	}
	if ins.Op == ir.OP_RODATA_MSLICE_COPY {
		emitStringToCharsCopy(a, rm, strings, ins, ins.StrVal)
		return
	}

	if emitCompare(a, rm, ins) { return }

	if ins.Op == ir.OP_CALL {
		emitCall(a, pkgName, rm, allFuncs, ins)
		return
	}
	if ins.Op == ir.OP_CALL_INDIRECT {
		emitCallIndirect(a, rm, allFuncs, ins)
		return
	}
	if ins.Op == ir.OP_CALL_FUNC_VALUE {
		emitCallFuncValue(a, rm, allFuncs, ins)
		return
	}
	if ins.Op == ir.OP_FUNC_ADDR {
		// Address of a named function, used as an i8* (e.g. a dtor
		// pointer for RefDec). Reach it via ADRP+ADD against the
		// function symbol; same PAGE21/PAGEOFF12 relocation pair as
		// global-variable addresses.
		if len(ins.StrVal) == 0 { return }
		var label @[]char = symFor(pkgName, ins.StrVal)
		asm.SetGlobal(a, label)
		var rd int = nextReg(rm, ins.ID)
		aarch64.Adrp(a, rd, label)
		aarch64.AddImmLabel(a, true, rd, rd, label)
		return
	}
	if ins.Op == ir.OP_FUNC_VALUE {
		// Function-value construction. Builds a 16-byte
		// {vtable_addr, null} aggregate in the IR-instruction's
		// pre-allocated data region (PlanFrame allocated it via
		// the OP_FUNC_VALUE arm in IsAggregateTyp).
		// vtable_addr is the address of the per-function vtable
		// global emitted by emitFuncValueVtables.
		if len(ins.StrVal) == 0 { return }
		var dataOff int = common.LookupAlloc(rm, ins.ID)
		if dataOff < 0 { return }
		var vtLabel @[]char = vtableSymFor(pkgName, ins.StrVal)
		asm.SetGlobal(a, vtLabel)
		// Compute vtable address into a scratch reg via ADRP+ADD.
		var addrTmp int = scratchReg(rm)
		aarch64.Adrp(a, addrTmp, vtLabel)
		aarch64.AddImmLabel(a, true, addrTmp, addrTmp, vtLabel)
		// Store vtable_addr at dataOff+0.
		aarch64.Str(a, true, addrTmp,
			aarch64.MemImm(aarch64.SP, dataOff))
		// Store 0 at dataOff+8 (data slot is null in compiled mode).
		aarch64.Str(a, true, aarch64.XZR,
			aarch64.MemImm(aarch64.SP, dataOff + 8))
		// Produce the data-region pointer as the result.
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}

	if ins.Op == ir.OP_REFCOUNT_INC {
		emitRefcountCall(a, rm, ins, "bn_rt__RefInc", false)
		return
	}
	if ins.Op == ir.OP_REFINC {
		emitRefIncInline(a, rm, ins)
		return
	}
	if ins.Op == ir.OP_REFCOUNT_DEC {
		emitRefcountCall(a, rm, ins, "bn_rt__RefDec", true)
		return
	}
	if ins.Op == ir.OP_REFDEC {
		emitRefDecInline(a, rm, ins)
		return
	}

	if ins.Op == ir.OP_RETURN {
		// A single aggregate return: pack into X0..X(N-1) when N≤8
		// (size ≤ 64 bytes). For sizes > 64 bytes, AAPCS sret —
		// memcpy through the X8 pointer the caller stashed in
		// SretSlotOff, then return void.
		if len(ins.Args) == 1 &&
			common.IsAggregateTyp(ins.Args[0].Typ) {
			var ptr int = getOperand(a, rm, ins.Args[0].ID)
			if ptr >= 0 {
				var sz int = types.SizeOf(ins.Args[0].Typ)
				var nWords int = sz / 8
				if rm.SretSlotOff >= 0 {
					var dstPtr int = scratchReg(rm)
					aarch64.Ldr(a, true, dstPtr,
						aarch64.MemImm(aarch64.SP,
							rm.SretSlotOff))
					var tmp int = scratchReg(rm)
					for ri := 0; ri < nWords; ri++ {
						aarch64.Ldr(a, true, tmp,
							aarch64.MemImm(ptr, 8*ri))
						aarch64.Str(a, true, tmp,
							aarch64.MemImm(dstPtr, 8*ri))
					}
				} else {
					for ri := 0; ri < nWords && ri < 8; ri++ {
						aarch64.Ldr(a, true, argReg(ri),
							aarch64.MemImm(ptr, 8*ri))
					}
				}
			}
			emitEpilogueAndRet(a, common.FrameSize(rm))
			return
		}
		// Multi-return tuple > 64 bytes: AAPCS-style sret. The caller
		// stashed &tupleBuffer in our SretSlotOff at entry; load it
		// back, then write each return value through it at the
		// MultiReturnType field offset. Mirrors the single-aggregate
		// sret path above, but per-arg.
		if rm.SretSlotOff >= 0 && rm.MultiReturnType != nil &&
			len(ins.Args) > 1 {
			var dstPtr int = scratchReg(rm)
			aarch64.Ldr(a, true, dstPtr,
				aarch64.MemImm(aarch64.SP, rm.SretSlotOff))
			for ai := 0; ai < len(ins.Args); ai++ {
				var arg @ir.Instr = ins.Args[ai]
				var fldOff int = types.FieldOffset(
					rm.MultiReturnType, ai)
				if common.IsAggregateTyp(arg.Typ) {
					var ptr int = getOperand(a, rm, arg.ID)
					if ptr < 0 { continue }
					var sz int = types.SizeOf(arg.Typ)
					var nWords int = sz / 8
					var tmp int = scratchReg(rm)
					for w := 0; w < nWords; w++ {
						aarch64.Ldr(a, true, tmp,
							aarch64.MemImm(ptr, 8*w))
						aarch64.Str(a, true, tmp,
							aarch64.MemImm(dstPtr,
								fldOff + 8*w))
					}
				} else {
					var src int = getOperand(a, rm, arg.ID)
					if src < 0 { continue }
					var sz int = types.SizeOf(arg.Typ)
					if sz <= 0 { sz = 8 }
					emitScalarStore(a, src, dstPtr,
						fldOff, sz)
				}
			}
			emitEpilogueAndRet(a, common.FrameSize(rm))
			return
		}
		// Multi-return / scalar-tuple return ≤64 bytes: pack values
		// into X0..X7. Aggregate args (e.g. a struct field of a
		// multi-return tuple) spread across multiple consecutive
		// regs — `return st, off` where st is a 5-word StrTab and
		// off is an int needs X0..X4 = st bytes, X5 = off.
		var rIdx int = 0
		for ai := 0; ai < len(ins.Args); ai++ {
			var arg @ir.Instr = ins.Args[ai]
			if common.IsAggregateTyp(arg.Typ) {
				var ptr int = getOperand(a, rm, arg.ID)
				if ptr < 0 { continue }
				var sz int = types.SizeOf(arg.Typ)
				var nWords int = sz / 8
				for w := 0; w < nWords && rIdx < 8; w++ {
					aarch64.Ldr(a, true, argReg(rIdx),
						aarch64.MemImm(ptr, 8*w))
					rIdx = rIdx + 1
				}
			} else {
				var src int = getOperand(a, rm, arg.ID)
				if src < 0 { continue }
				if rIdx < 8 && src != argReg(rIdx) {
					aarch64.Mov(a, true, argReg(rIdx),
						aarch64.Reg(src))
				}
				rIdx = rIdx + 1
			}
		}
		emitEpilogueAndRet(a, common.FrameSize(rm))
		return
	}

	if ins.Op == ir.OP_MANAGED_TO_RAW {
		// @[]T → *[]T: pass the source pointer through; the first 16
		// bytes of a managed-slice ARE the raw-slice representation.
		if len(ins.Args) < 1 { return }
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		aarch64.Mov(a, true, rd, aarch64.Reg(src))
		return
	}

	if ins.Op == ir.OP_BIT_CAST {
		// Reinterpret same-size bits — a plain move in a 64-bit file.
		if len(ins.Args) < 1 { return }
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		aarch64.Mov(a, true, rd, aarch64.Reg(src))
		return
	}

	if ins.Op == ir.OP_CAST {
		// Numeric conversion with explicit LSL+LSR/ASR narrowing; our
		// regmap is all X-regs, so we can't lean on 32-bit-view
		// zero-extension. emitFloatCast handles any branch where
		// either side is float (SCVTF / FCVTZS / float→float move).
		if len(ins.Args) < 1 || ins.TypeArg == nil { return }
		var src int = getOperand(a, rm, ins.Args[0].ID)
		if src < 0 { return }
		var rd int = nextReg(rm, ins.ID)
		if emitFloatCast(a, rd, src, ins.Args[0].Typ, ins.TypeArg) {
			return
		}
		emitCast(a, rd, src, ins.TypeArg)
		return
	}

	if ins.Op == ir.OP_EXTRACT      { emitExtract(a, rm, ins);     return }
	if ins.Op == ir.OP_ALLOC        { emitAlloc(a, rm, ins);       return }
	if ins.Op == ir.OP_MAKE         { emitMake(a, rm, ins);        return }
	if ins.Op == ir.OP_BOX          { emitBox(a, rm, ins);         return }
	if ins.Op == ir.OP_MAKE_SLICE   { emitMakeSlice(a, rm, ins);   return }
	if ins.Op == ir.OP_LOAD         { emitLoad(a, pkgName, rm, ins);        return }
	if ins.Op == ir.OP_STORE        { emitStore(a, pkgName, rm, ins);       return }
	if ins.Op == ir.OP_GET_ELEM_PTR { emitGetElemPtr(a, pkgName, rm, ins);  return }
	if ins.Op == ir.OP_GET_FIELD_PTR { emitGetFieldPtr(a, pkgName, rm, ins); return }

	if ins.Op == ir.OP_BOUNDS_CHECK {
		// Lower to a call to bn_rt__BoundsCheck(index, len). The
		// runtime aborts with "index out of bounds: %lld (len %lld)\n"
		// if the unsigned comparison fails — same fast-path the LLVM
		// backend uses, since pkg/rt provides the implementation.
		if len(ins.Args) < 2 { return }
		var idx int = getOperand(a, rm, ins.Args[0].ID)
		var ln int = getOperand(a, rm, ins.Args[1].ID)
		if idx < 0 || ln < 0 { return }
		aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(idx))
		aarch64.Mov(a, true, aarch64.X1, aarch64.Reg(ln))
		var callee @[]char = underscorePrefix("bn_rt__BoundsCheck")
		asm.SetGlobal(a, callee)
		aarch64.Bl(a, callee)
		common.ResetRegs(rm)
		return
	}

	if ins.Op == ir.OP_JUMP {
		if ins.Block1 == nil { return }
		aarch64.B(a, blockLabel(funcSym, ins.Block1.Label))
		return
	}
	if ins.Op == ir.OP_BRANCH {
		// Args[0] = cond, Block1 = then, Block2 = else.
		if ins.Block1 == nil || ins.Block2 == nil ||
			len(ins.Args) < 1 {
			return
		}
		var condReg int = getOperand(a, rm, ins.Args[0].ID)
		if condReg < 0 { return }
		aarch64.Cbnz(a, true, condReg,
			blockLabel(funcSym, ins.Block1.Label))
		aarch64.B(a, blockLabel(funcSym, ins.Block2.Label))
		return
	}

	if emitBinop(a, rm, ins) { return }
	if emitUnop(a, rm, ins)  { return }

	// Any other op is a no-op in this skeleton.
}
