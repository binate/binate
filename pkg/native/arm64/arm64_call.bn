package "pkg/native/arm64"

import "pkg/asm"
import "pkg/asm/aarch64"
import "pkg/ir"
import "pkg/mangle"
import "pkg/native/common"
import "pkg/types"

// ============================================================
// Function calls and struct copy
// ============================================================

// ============================================================
// Function calls and struct copy
// ============================================================

// emitCall moves args into X0..X7 and branches to the callee symbol.
// ins.StrVal is the Binate-level call name; goes through
// pkg/mangle.FuncName for the C symbol.
// Declares the callee as a global so Finalize emits a relocation
// rather than failing with "undefined symbol."
func emitCall(a @asm.Assembler, pkgName *[]const char, rm @common.RegMap,
	allFuncs @[]@ir.Func, ins @ir.Instr) {
	// AAPCS-style argument dispatch: scalars and aggregates get
	// reg-or-stack assignments via common.CallArgRegStart /
	// CallArgStackOff. Aggregates that don't fit in remaining regs
	// go ENTIRELY on stack (no reg/stack split per arg). Stack args
	// land in the outgoing-args area at [sp+0..OutgoingArgsSize),
	// which PlanFrame reserved at the bottom of the frame so SP
	// stays stable for the surrounding spill addressing.
	var argTypes @[]@types.Type = make_slice(@types.Type, len(ins.Args))
	for i := 0; i < len(ins.Args); i++ {
		argTypes[i] = ins.Args[i].Typ
	}
	// AAPCS NSRN: float scalar args go to D(NSRN), separate from the
	// GP NGRN counter. Currently capped at 8 (D0..D7) — beyond that
	// would need stack-arg handling, which no test exercises.
	var nsrn int = 0
	for ai := 0; ai < len(ins.Args); ai++ {
		var arg @ir.Instr = ins.Args[ai]
		if isFloatTyp(arg.Typ) {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if nsrn < 8 {
				aarch64.Fmov_gp_to_fp(a, aarch64.D0 + nsrn, src)
				nsrn = nsrn + 1
			}
			// Stack-overflow case (>8 FP args) deferred — not exercised.
			continue
		}
		var regStart int = common.CallArgRegStart(argTypes, ai)
		var stackOff int = common.CallArgStackOff(argTypes, ai)
		if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			var nWords int = common.ArgWords(arg.Typ)
			// Three cases: all-in-regs, all-on-stack, or split (some
			// in regs, overflow on stack). LLVM's byval AAPCS lowering
			// uses split when an aggregate straddles X0..X7; native
			// must match or cross-package calls between native main
			// and LLVM-compiled deps mismatch (conformance 337). X16
			// (IP0) is the load temp for the stack portion — regPool
			// saturates at X15 so scratchReg(rm) can collide with
			// `ptr`; X16 is AAPCS intra-call scratch, safe across
			// Ldr/Str (no `bl` between).
			var regWords int = 0
			if regStart >= 0 {
				regWords = nWords
				if stackOff >= 0 { regWords = 8 - regStart }
				for w := 0; w < regWords; w++ {
					aarch64.Ldr(a, true, argReg(regStart + w),
						aarch64.MemImm(ptr, 8*w))
				}
			}
			if stackOff >= 0 {
				var tmp int = aarch64.X16
				for w := regWords; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp,
						aarch64.MemImm(ptr, 8*w))
					aarch64.Str(a, true, tmp,
						aarch64.MemImm(aarch64.SP,
							stackOff + 8*(w - regWords)))
				}
			}
		} else {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if regStart >= 0 {
				if src != argReg(regStart) {
					aarch64.Mov(a, true, argReg(regStart),
						aarch64.Reg(src))
				}
			} else {
				aarch64.Str(a, true, src,
					aarch64.MemImm(aarch64.SP, stackOff))
			}
		}
	}

	// AAPCS sret: caller passes &returnBuffer in X8 before BL when
	// (a) return is an aggregate > 64 bytes (our internal Binate
	// convention), (b) the callee is a C-extern returning > 16
	// bytes (clang/AAPCS-C), or (c) the result is a multi-return
	// tuple > 64 bytes — without (c), tuples beyond X0..X7's 64
	// bytes silently drop their tail.
	var bigMultiRet bool = ins.ID >= 0 &&
		common.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 &&
		(common.CallReturnsBigAggregate(ins) ||
		 common.CalleeUsesCSret(allFuncs, ins) ||
		 bigMultiRet)
	if bigRet {
		// Multi-return tuples land in the spill slot (sized to the
		// full tuple by PlanFrame); single-aggregate returns land in
		// the data region (alloc).
		var sretOff int = -1
		if bigMultiRet {
			sretOff = common.LookupSpill(rm, ins.ID)
		} else {
			sretOff = common.LookupAlloc(rm, ins.ID)
		}
		if sretOff >= 0 {
			aarch64.Add(a, true, aarch64.X8, aarch64.SP,
				aarch64.Imm(sretOff))
		}
	}

	var callee @[]char = symFor(pkgName, ins.StrVal)
	asm.SetGlobal(a, callee)
	aarch64.Bl(a, callee)

	// BL clobbers X9..X15. Reset the pool, then spill this call's
	// return value(s) so later uses can reload.
	common.ResetRegs(rm)
	if ins.ID < 0 { return }
	// Aggregate return that isn't a multi-return TYP_STRUCT — a slice,
	// an array, or a named struct-by-value — goes into a dedicated
	// data region (pointer-in-spill form, same as MAKE_SLICE) so
	// arg-spreading and OP_EXTRACT can treat it uniformly with
	// LOAD/MAKE_SLICE results. For ≤64-byte returns the callee packs
	// X0..X(N-1) and we spill them into the region; for >64-byte sret
	// returns the callee already wrote through X8 — we just produce
	// the pointer.
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) &&
		!common.IsMultiReturnCall(ins) {
		var dataOff int = common.LookupAlloc(rm, ins.ID)
		if dataOff < 0 { return }
		var sz int = types.SizeOf(ins.Typ)
		if sz <= 0 { return }
		if !bigRet {
			var nWords int = sz / 8
			for ri := 0; ri < nWords && ri < 8; ri++ {
				aarch64.Str(a, true, argReg(ri),
					aarch64.MemImm(aarch64.SP, dataOff + 8*ri))
			}
		}
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}
	// Multi-return TYP_STRUCT packs the tuple bytes directly into the
	// slot. Mirror OP_RETURN's per-arg register assignment exactly:
	// scalar fields take one X-register each (sized stores keep
	// sub-word fields like uint32 from clobbering their neighbor in
	// the same 8-byte cell), aggregate fields spread across N
	// consecutive registers and write back to consecutive 8-byte
	// offsets within the field. A naive `nWords = SizeOf(tuple) / 8`
	// loses the second register entirely for `(uint32, uint32)` —
	// total size 8 bytes / 1 word, but the callee returns it in
	// X0 + X1.
	var spillOff int = common.LookupSpill(rm, ins.ID)
	if spillOff < 0 { return }
	// Big multi-return tuples were already written through X8 by the
	// callee — the spill slot is the X8 destination.  Nothing to
	// collect from registers.
	if bigMultiRet { return }
	if !common.IsMultiReturnCall(ins) {
		aarch64.Str(a, true, argReg(0),
			aarch64.MemImm(aarch64.SP, spillOff))
		return
	}
	var rIdx int = 0
	for fi := 0; fi < len(ins.Typ.Fields) && rIdx < 8; fi++ {
		var fldTyp @types.Type = ins.Typ.Fields[fi].Type
		var fldOff int = types.FieldOffset(ins.Typ, fi)
		if common.IsAggregateTyp(fldTyp) {
			var fldSz int = types.SizeOf(fldTyp)
			var nWords int = fldSz / 8
			if nWords < 1 { nWords = 1 }
			for w := 0; w < nWords && rIdx < 8; w++ {
				aarch64.Str(a, true, argReg(rIdx),
					aarch64.MemImm(aarch64.SP,
						spillOff + fldOff + 8*w))
				rIdx = rIdx + 1
			}
		} else {
			var fldSz int = types.SizeOf(fldTyp)
			if fldSz <= 0 { fldSz = 8 }
			emitScalarStore(a, argReg(rIdx), aarch64.SP,
				spillOff + fldOff, fldSz)
			rIdx = rIdx + 1
		}
	}
}

// emitCallIndirect emits an indirect call (BLR Xn). Args[0] is the
// fn_ptr (loaded into X17 before arg dispatch may clobber its source);
// Args[1..] are the call args, dispatched via the same AAPCS machinery
// emitCall uses (X0..X7, then stack at SP+0..). X17 is the AAPCS IP1
// scratch register, safe across MOV+arg-loads since BL is the only
// thing that clobbers X16/X17 and we haven't BL'd yet. Same return-
// value handling as emitCall.
func emitCallIndirect(a @asm.Assembler, rm @common.RegMap,
	allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Stash fn_ptr in X17 before the arg-dispatch loop, which writes
	// X0..X7 (and may use X16 as a load temp for stack aggregates).
	// Loading the source register here ensures the value survives
	// even if the source reg gets reused below.
	var fnSrc int = getOperand(a, rm, ins.Args[0].ID)
	if fnSrc < 0 { return }
	aarch64.Mov(a, true, aarch64.X17, aarch64.Reg(fnSrc))

	// AAPCS arg dispatch on the call args (Args[1..]).
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = make_slice(@types.Type, nCallArgs)
	for i := 0; i < nCallArgs; i++ {
		argTypes[i] = ins.Args[i + 1].Typ
	}
	var nsrn int = 0
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		if isFloatTyp(arg.Typ) {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if nsrn < 8 {
				aarch64.Fmov_gp_to_fp(a,
					aarch64.D0 + nsrn, src)
				nsrn = nsrn + 1
			}
			continue
		}
		var regStart int = common.CallArgRegStart(argTypes, ai)
		var stackOff int = common.CallArgStackOff(argTypes, ai)
		if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			var nWords int = common.ArgWords(arg.Typ)
			if regStart >= 0 {
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true,
						argReg(regStart + w),
						aarch64.MemImm(ptr, 8*w))
				}
			} else {
				var tmp int = aarch64.X16
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp,
						aarch64.MemImm(ptr, 8*w))
					aarch64.Str(a, true, tmp,
						aarch64.MemImm(aarch64.SP,
							stackOff + 8*w))
				}
			}
		} else {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if regStart >= 0 {
				if src != argReg(regStart) {
					aarch64.Mov(a, true,
						argReg(regStart),
						aarch64.Reg(src))
				}
			} else {
				aarch64.Str(a, true, src,
					aarch64.MemImm(aarch64.SP, stackOff))
			}
		}
	}

	// AAPCS sret: indirect calls have no callee-symbol, so
	// CalleeUsesCSret never fires here — only the (a)/(c) cases
	// from emitCall (big aggregate / big multi-return) apply.
	var bigMultiRet bool = ins.ID >= 0 &&
		common.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 &&
		(common.CallReturnsBigAggregate(ins) || bigMultiRet)
	if bigRet {
		var sretOff int = -1
		if bigMultiRet {
			sretOff = common.LookupSpill(rm, ins.ID)
		} else {
			sretOff = common.LookupAlloc(rm, ins.ID)
		}
		if sretOff >= 0 {
			aarch64.Add(a, true, aarch64.X8, aarch64.SP,
				aarch64.Imm(sretOff))
		}
	}

	// BLR X17 — branch-and-link through the stashed fn_ptr register.
	aarch64.Blr(a, aarch64.X17)

	common.ResetRegs(rm)
	if ins.ID < 0 { return }

	// Aggregate single-return: spill X0..X(N-1) into the alloc region,
	// then materialize the region pointer (mirror of emitCall).
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) &&
		!common.IsMultiReturnCall(ins) {
		var dataOff int = common.LookupAlloc(rm, ins.ID)
		if dataOff < 0 { return }
		var sz int = types.SizeOf(ins.Typ)
		if sz <= 0 { return }
		if !bigRet {
			var nWords int = sz / 8
			for ri := 0; ri < nWords && ri < 8; ri++ {
				aarch64.Str(a, true, argReg(ri),
					aarch64.MemImm(aarch64.SP,
						dataOff + 8*ri))
			}
		}
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}

	var spillOff int = common.LookupSpill(rm, ins.ID)
	if spillOff < 0 { return }
	if bigMultiRet { return }
	if !common.IsMultiReturnCall(ins) {
		aarch64.Str(a, true, argReg(0),
			aarch64.MemImm(aarch64.SP, spillOff))
		return
	}
	var rIdx int = 0
	for fi := 0; fi < len(ins.Typ.Fields) && rIdx < 8; fi++ {
		var fldTyp @types.Type = ins.Typ.Fields[fi].Type
		var fldOff int = types.FieldOffset(ins.Typ, fi)
		if common.IsAggregateTyp(fldTyp) {
			var fldSz int = types.SizeOf(fldTyp)
			var nWords int = fldSz / 8
			if nWords < 1 { nWords = 1 }
			for w := 0; w < nWords && rIdx < 8; w++ {
				aarch64.Str(a, true, argReg(rIdx),
					aarch64.MemImm(aarch64.SP,
						spillOff + fldOff + 8*w))
				rIdx = rIdx + 1
			}
		} else {
			var fldSz int = types.SizeOf(fldTyp)
			if fldSz <= 0 { fldSz = 8 }
			emitScalarStore(a, argReg(rIdx), aarch64.SP,
				spillOff + fldOff, fldSz)
			rIdx = rIdx + 1
		}
	}
}

// emitCallFuncValue lowers OP_CALL_FUNC_VALUE: call through a 2-word
// function value's vtable.call. Compiled-mode dispatch — the call
// slot holds a real function pointer (vs. VM-mode, where the slot
// is a Phase-1 placeholder and the bytecode short-circuits via the
// closure record's vm_func_idx). Args[0] is the function value's
// address; Args[1..] are the call args, dispatched the same way as
// emitCallIndirect / emitCall.
func emitCallFuncValue(a @asm.Assembler, rm @common.RegMap,
	allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Two-step load to populate X17 with vtable.call:
	//   LDR X17, [fvAddr + 0]   ; X17 = vtable_ptr
	//   LDR X17, [X17 + 8]      ; X17 = vtable.call
	// Same X17 for source+dest in the second LDR is fine — AArch64
	// updates the dest after the load completes.
	var fvAddr int = getOperand(a, rm, ins.Args[0].ID)
	if fvAddr < 0 { return }
	aarch64.Ldr(a, true, aarch64.X17,
		aarch64.MemImm(fvAddr, 0))
	aarch64.Ldr(a, true, aarch64.X17,
		aarch64.MemImm(aarch64.X17, 8))

	// AAPCS arg dispatch on the call args (Args[1..]). Mirrors
	// emitCallIndirect's body — see plan-function-values.md.
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = make_slice(@types.Type, nCallArgs)
	for i := 0; i < nCallArgs; i++ {
		argTypes[i] = ins.Args[i + 1].Typ
	}
	var nsrn int = 0
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		if isFloatTyp(arg.Typ) {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if nsrn < 8 {
				aarch64.Fmov_gp_to_fp(a,
					aarch64.D0 + nsrn, src)
				nsrn = nsrn + 1
			}
			continue
		}
		var regStart int = common.CallArgRegStart(argTypes, ai)
		var stackOff int = common.CallArgStackOff(argTypes, ai)
		if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			var nWords int = common.ArgWords(arg.Typ)
			if regStart >= 0 {
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true,
						argReg(regStart + w),
						aarch64.MemImm(ptr, 8*w))
				}
			} else {
				var tmp int = aarch64.X16
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp,
						aarch64.MemImm(ptr, 8*w))
					aarch64.Str(a, true, tmp,
						aarch64.MemImm(aarch64.SP,
							stackOff + 8*w))
				}
			}
		} else {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if regStart >= 0 {
				if src != argReg(regStart) {
					aarch64.Mov(a, true,
						argReg(regStart),
						aarch64.Reg(src))
				}
			} else {
				aarch64.Str(a, true, src,
					aarch64.MemImm(aarch64.SP, stackOff))
			}
		}
	}

	// AAPCS sret — indirect-call shape, see emitCallIndirect note.
	var bigMultiRet bool = ins.ID >= 0 &&
		common.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 &&
		(common.CallReturnsBigAggregate(ins) || bigMultiRet)
	if bigRet {
		var sretOff int = -1
		if bigMultiRet {
			sretOff = common.LookupSpill(rm, ins.ID)
		} else {
			sretOff = common.LookupAlloc(rm, ins.ID)
		}
		if sretOff >= 0 {
			aarch64.Add(a, true, aarch64.X8, aarch64.SP,
				aarch64.Imm(sretOff))
		}
	}

	aarch64.Blr(a, aarch64.X17)
	common.ResetRegs(rm)
	if ins.ID < 0 { return }

	// Aggregate single-return: spill X0..X(N-1) into the alloc region
	// and produce its pointer. Same as emitCallIndirect / emitCall.
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) &&
		!common.IsMultiReturnCall(ins) {
		var dataOff int = common.LookupAlloc(rm, ins.ID)
		if dataOff < 0 { return }
		var sz int = types.SizeOf(ins.Typ)
		if sz <= 0 { return }
		if !bigRet {
			var nWords int = sz / 8
			for ri := 0; ri < nWords && ri < 8; ri++ {
				aarch64.Str(a, true, argReg(ri),
					aarch64.MemImm(aarch64.SP,
						dataOff + 8*ri))
			}
		}
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}

	var spillOff int = common.LookupSpill(rm, ins.ID)
	if spillOff < 0 { return }
	if bigMultiRet { return }
	if !common.IsMultiReturnCall(ins) {
		aarch64.Str(a, true, argReg(0),
			aarch64.MemImm(aarch64.SP, spillOff))
		return
	}
	var rIdx int = 0
	for fi := 0; fi < len(ins.Typ.Fields) && rIdx < 8; fi++ {
		var fldTyp @types.Type = ins.Typ.Fields[fi].Type
		var fldOff int = types.FieldOffset(ins.Typ, fi)
		if common.IsAggregateTyp(fldTyp) {
			var fldSz int = types.SizeOf(fldTyp)
			var nWords int = fldSz / 8
			if nWords < 1 { nWords = 1 }
			for w := 0; w < nWords && rIdx < 8; w++ {
				aarch64.Str(a, true, argReg(rIdx),
					aarch64.MemImm(aarch64.SP,
						spillOff + fldOff + 8*w))
				rIdx = rIdx + 1
			}
		} else {
			var fldSz int = types.SizeOf(fldTyp)
			if fldSz <= 0 { fldSz = 8 }
			emitScalarStore(a, argReg(rIdx), aarch64.SP,
				spillOff + fldOff, fldSz)
			rIdx = rIdx + 1
		}
	}
}
