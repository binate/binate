package "pkg/native/arm64"

import "pkg/asm"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// Tests for the indirect-call lowering in arm64_call_indirect.bn.
// The end-to-end behavior (real OP_CALL_INDIRECT for dtor /
// _call_free_fn / cross-mode dispatch, OP_CALL_FUNC_VALUE through
// the always-shim) is covered by the conformance suite; these
// tests pin the byte-counts and the X17-target convention so a
// regression in the dispatch shape doesn't silently regress.
//
// opsMkAssembler / opsBytes / nilFuncs come from arm64_ops_test.bn
// (same package).

// emitCallIndirect with no call args emits:
//   LDR fnSrc, [SP, #...]   ; getOperand reload
//   MOV X17, fnSrc
//   BLR X17
// Three 4-byte AArch64 instructions = 12 bytes. ins.ID = -1 so
// the post-call return-handling block short-circuits.
func TestEmitCallIndirectNoArgsVoid() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	// Spill slot for fn_ptr (ID = 5) at offset 0.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)

	var fnPtr @ir.Instr = make(ir.Instr)
	fnPtr.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1            // void return — skip post-call spill
	ins.Op = ir.OP_CALL_INDIRECT
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fnPtr

	emitCallIndirect(a, m, nilFuncs(), ins)
	if opsBytes(a) != 12 {
		return "indirect call (no args, void) should emit 3 instrs (12 bytes)"
	}
	return ""
}

// emitCallFuncValue with no call args emits:
//   LDR fvAddr, [SP, #...]      ; getOperand reload
//   LDR X17, [fvAddr + 0]       ; vtable_ptr
//   LDR X17, [X17 + 8]          ; vtable.call
//   LDR X0, [fvAddr + 8]        ; data (always-shim convention)
//   BLR X17
// Five 4-byte AArch64 instructions = 20 bytes. Pins the always-
// shim convention — vtable.call's signature has *uint8 data
// prepended, so X0 is reserved for data and user args (none here)
// would shift to X1+.
func TestEmitCallFuncValueNoArgsVoid() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	// Spill slot for fv address (ID = 5) at offset 0.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)

	var fvAddr @ir.Instr = make(ir.Instr)
	fvAddr.ID = 5

	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1            // void return
	ins.Op = ir.OP_CALL_FUNC_VALUE
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = fvAddr

	emitCallFuncValue(a, m, nilFuncs(), ins)
	if opsBytes(a) != 20 {
		return "func-value call (no user args, void) should emit 5 instrs (20 bytes)"
	}
	return ""
}

// Defensive guards: both lowerings must early-out on a malformed
// instruction with no Args, never emitting any bytes. Without
// these guards a missing Args[0] would crash the encoder.
func TestEmitCallIndirectEmptyArgsIsNoOp() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_INDIRECT
	emitCallIndirect(a, m, nilFuncs(), ins)
	if opsBytes(a) != 0 {
		return "indirect call with no Args should emit nothing"
	}
	return ""
}

func TestEmitCallFuncValueEmptyArgsIsNoOp() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_CALL_FUNC_VALUE
	emitCallFuncValue(a, m, nilFuncs(), ins)
	if opsBytes(a) != 0 {
		return "func-value call with no Args should emit nothing"
	}
	return ""
}

// makeFuncValueRefModule builds a one-function module that contains
// a single OP_FUNC_VALUE pointing at `host.foo`, whose signature is
// taken from sig.  Used by the shim-shape tests below — drives
// collectFuncValueRefs / emitFuncValueShims without going through
// the full IR-gen pipeline.
func makeFuncValueRefModule(sig @types.Type) @ir.Module {
	var mod @ir.Module = ir.NewModule("\"host\"")
	var noP @[]@ir.Param
	var noR @[]@types.Type
	var f @ir.Func = ir.NewFunc("host.caller", noP, noR)
	var b @ir.Block = ir.AddBlock(f, "entry")
	b.EmitFuncValue("host.foo", sig)
	mod.AddFunc(f)
	return mod
}

// emitFuncValueShims counts REGISTER WORDS (not params) when shifting
// X1..Xn → X0..X(n-1) to drop the closure-data slot.  A slice param
// occupies two consecutive arg-words (slice.data + slice.len), so for
// `*func(*[]const char) int` the shim must emit 2 MOVs + 1 B = 12
// bytes — NOT 1 MOV + 1 B = 8 bytes (the pre-7096a94 bug that read
// `len(fvTyp.Params)` directly).
func TestEmitFuncValueShimSliceParamCountsWords() testing.TestResult {
	// Build `*func(*[]const char) int`.
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "s"
	p.Type = types.MakeSliceType(types.TypChar())
	params[0] = p
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var fvTyp @types.Type = types.MakeFuncValueType(params, results)

	var mod @ir.Module = makeFuncValueRefModule(fvTyp)

	var a @asm.Assembler = opsMkAssembler()
	emitFuncValueShims(a, "host", mod)
	// Expected: 2 MOVs (nUserWords=2 for the 2-word slice) + 1 B = 12 bytes.
	// Buggy expectation (count params not words): 1 MOV + 1 B = 8 bytes.
	if opsBytes(a) != 12 {
		return "slice-param shim should emit 2 MOVs + 1 B (12 bytes); "
			"8 bytes means arg-words regressed to len(Params)"
	}
	return ""
}

// Scalar-only shim: `*func(int) int`.  One int param = 1 arg-word, so
// the shim shifts a single MOV (X0←X1) + 1 B = 8 bytes.  Pins the
// "params-count == word-count" path so the slice test above doesn't
// pass for the wrong reason.
func TestEmitFuncValueShimScalarParam() testing.TestResult {
	var params @[]@types.Param = make_slice(@types.Param, 1)
	var p @types.Param = make(types.Param)
	p.Name = "x"
	p.Type = types.TypInt()
	params[0] = p
	var results @[]@types.Type = make_slice(@types.Type, 1)
	results[0] = types.TypInt()
	var fvTyp @types.Type = types.MakeFuncValueType(params, results)

	var mod @ir.Module = makeFuncValueRefModule(fvTyp)

	var a @asm.Assembler = opsMkAssembler()
	emitFuncValueShims(a, "host", mod)
	if opsBytes(a) != 8 {
		return "scalar-param shim should emit 1 MOV + 1 B (8 bytes)"
	}
	return ""
}

// Zero-param shim emits just a B (4 bytes) — there's no arg to shift.
// Pins the loop's lower-bound behavior (nUserWords=0 → no MOVs).
func TestEmitFuncValueShimZeroParams() testing.TestResult {
	var params @[]@types.Param
	var results @[]@types.Type
	var fvTyp @types.Type = types.MakeFuncValueType(params, results)

	var mod @ir.Module = makeFuncValueRefModule(fvTyp)

	var a @asm.Assembler = opsMkAssembler()
	emitFuncValueShims(a, "host", mod)
	if opsBytes(a) != 4 {
		return "zero-param shim should emit just 1 B (4 bytes)"
	}
	return ""
}
