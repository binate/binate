package "pkg/native/arm64"

import "pkg/asm"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// The handlers in arm64_emit.bn are exercised end-to-end by
// arm64_test.bn's EmitObject round-trips and by the conformance
// suite. These narrow unit tests verify the simplest observable
// property — that each handler emits the right number of bytes on a
// well-formed IR input — to guard against accidental regressions that
// would otherwise only surface at the conformance level.

func mkAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

func bytesWritten(a @asm.Assembler) int { return a.Sections[0].Len }

// emitAlloc on a scalar is a no-op (zero-init only applies to
// aggregates).
func TestEmitAllocScalarIsNoOp() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 0
	ins.Op = ir.OP_ALLOC
	ins.TypeArg = types.TypInt()
	emitAlloc(a, rm, ins)
	if bytesWritten(a) != 0 { return "scalar alloc should emit nothing" }
	return ""
}

// emitAlloc on an aggregate emits a run of `str xzr, [sp, #off]`
// instructions — one per 8 bytes.
func TestEmitAllocAggregateZeroInits() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 7)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 7
	ins.Op = ir.OP_ALLOC
	ins.TypeArg = types.MakeSliceType(types.TypInt())
	emitAlloc(a, rm, ins)
	// Two STR XZR instructions for the 16-byte slot = 8 bytes.
	if bytesWritten(a) != 8 {
		return "aggregate alloc should emit two STR XZR for 16-byte slot"
	}
	return ""
}

// emitConstInt64 with nonzero 16-bit chunks only at shift 0 and
// shift 48 must emit MOVZ + MOVK (8 bytes).  The high chunk
// (val >> 48) is reachable only because val is int64; with a 32-bit
// host `int` the value would truncate and the chunk would be lost,
// emitting just the MOVZ (4 bytes).
func TestEmitConstInt64HighChunkReachable() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var val int64 = (cast(int64, 1) << cast(int64, 48)) | cast(int64, 5)
	emitConstInt64(a, 0, val)
	if bytesWritten(a) != 8 {
		return "MOVZ+MOVK expected; high chunk at shift 48 must survive"
	}
	return ""
}

// emitConstNil on a scalar emits a single MOVZ rd, #0.
func TestEmitConstNilScalarIsSingleMovz() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 3)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_CONST_NIL
	ins.Typ = types.TypInt()
	emitConstNil(a, rm, ins)
	if bytesWritten(a) != 4 {
		return "scalar const_nil should emit a single 4-byte MOVZ"
	}
	return ""
}

// emitMake emits a non-trivial sequence (movz size, bl _bn_pkg__rt__Alloc,
// mov rd, x0). Not checking exact encoding — just that it fires.
func TestEmitMakeEmitsInstructions() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 5
	ins.Op = ir.OP_MAKE
	ins.TypeArg = types.TypInt()
	emitMake(a, rm, ins)
	if bytesWritten(a) == 0 {
		return "make should emit at least one instruction"
	}
	return ""
}

// emitConstNil on an aggregate type must zero-init its data region
// and produce a pointer to it (aggregate-pointer form). Distinct
// from the scalar path, which is just `movz rd, #0`.
func TestEmitConstNilAggregateZeroesAndPoints() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Planted data region and spill slot (as common.PlanFrame would).
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 11)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 11)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 11
	ins.Op = ir.OP_CONST_NIL
	ins.Typ = types.MakeSliceType(types.TypInt())
	emitConstNil(a, rm, ins)
	// Expect: 2× STR XZR (zero-init 16 bytes) + 1× ADD (pointer) =
	// 12 bytes.
	if bytesWritten(a) != 12 {
		return "aggregate const_nil should emit 2×STR XZR + 1×ADD"
	}
	return ""
}

// emitExtract has two storage paths — multi-return direct (read at
// slot + 8*Index) and aggregate-pointer indirect (ldr rd, [ptr,
// 8*Index]). Distinguishable by the source op.
func TestEmitExtractDirectFromMultiReturn() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 3)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 4)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	// Source = a multi-return CALL with struct result — construct a
	// Type with Kind = TYP_STRUCT directly rather than via the
	// type-checker helpers, which want a Field slice.
	var call @ir.Instr = make(ir.Instr)
	call.ID = 3
	call.Op = ir.OP_CALL
	var structTyp @types.Type = make(types.Type)
	structTyp.Kind = types.TYP_STRUCT
	call.Typ = structTyp
	var ext @ir.Instr = make(ir.Instr)
	ext.ID = 4
	ext.Op = ir.OP_EXTRACT
	ext.Index = 1
	ext.Typ = types.TypInt()
	ext.Args = make_slice(@ir.Instr, 1)
	ext.Args[0] = call
	emitExtract(a, rm, ext)
	// Direct path: one LDR from SP + 8*1 = 4 bytes.
	if bytesWritten(a) != 4 {
		return "direct extract should emit a single LDR"
	}
	return ""
}

// emitExtract on a multi-return tuple field that is itself an
// aggregate must produce an ADDRESS (ADD), not a value (LDR), so
// downstream OP_STORE can struct-copy from it. Pre-fix, EXTRACT(0)
// on a `(StrTab, int)` tuple LDR'd word 0 (the StrTab.Data.data
// pointer) and treated it as the StrTab pointer — main got
// StrTab.Data.data instead of `&tuple.0`. Also verify field offsets
// use FieldOffset, not 8*Index — for `(StrTab, int)` Index=1 sits
// at offset 40 (after the 5-word StrTab), not offset 8.
func TestEmitExtractMultiReturnAggregateField() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 3)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 4)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 48)
	// Build the (StrTab, int) tuple type.
	var strTabFields @[]@types.Field = make_slice(@types.Field, 2)
	strTabFields[0] = make(types.Field)
	strTabFields[0].Type = types.MakeManagedSliceType(types.TypChar())
	strTabFields[1] = make(types.Field)
	strTabFields[1].Type = types.TypInt()
	var strTab @types.Type = types.MakeStructType("StrTab", strTabFields)
	var tupleFields @[]@types.Field = make_slice(@types.Field, 2)
	tupleFields[0] = make(types.Field)
	tupleFields[0].Type = strTab
	tupleFields[1] = make(types.Field)
	tupleFields[1].Type = types.TypInt()
	var tuple @types.Type = types.MakeStructType("", tupleFields)

	var call @ir.Instr = make(ir.Instr)
	call.ID = 3
	call.Op = ir.OP_CALL
	call.Typ = tuple
	// EXTRACT(0) → StrTab (aggregate) — should ADD address.
	var ext @ir.Instr = make(ir.Instr)
	ext.ID = 4
	ext.Op = ir.OP_EXTRACT
	ext.Index = 0
	ext.Typ = strTab
	ext.Args = make_slice(@ir.Instr, 1)
	ext.Args[0] = call
	emitExtract(a, rm, ext)
	if bytesWritten(a) != 4 {
		return "aggregate-field extract should emit one ADD"
	}
	return ""
}

func TestEmitExtractMultiReturnIntFieldUsesFieldOffset() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 3)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 4)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 48)
	// Same (StrTab, int) tuple as above; Index=1 is the int.
	var strTabFields @[]@types.Field = make_slice(@types.Field, 2)
	strTabFields[0] = make(types.Field)
	strTabFields[0].Type = types.MakeManagedSliceType(types.TypChar())
	strTabFields[1] = make(types.Field)
	strTabFields[1].Type = types.TypInt()
	var strTab @types.Type = types.MakeStructType("StrTab", strTabFields)
	var tupleFields @[]@types.Field = make_slice(@types.Field, 2)
	tupleFields[0] = make(types.Field)
	tupleFields[0].Type = strTab
	tupleFields[1] = make(types.Field)
	tupleFields[1].Type = types.TypInt()
	var tuple @types.Type = types.MakeStructType("", tupleFields)

	var call @ir.Instr = make(ir.Instr)
	call.ID = 3
	call.Op = ir.OP_CALL
	call.Typ = tuple
	var ext @ir.Instr = make(ir.Instr)
	ext.ID = 4
	ext.Op = ir.OP_EXTRACT
	ext.Index = 1
	ext.Typ = types.TypInt()
	ext.Args = make_slice(@ir.Instr, 1)
	ext.Args[0] = call
	emitExtract(a, rm, ext)
	// Just one LDR — but the offset must be 40, not 8. We can't
	// easily check the offset from here without decoding the
	// instruction; the byte count alone is the existing guard.
	// (The conformance regression is the real teeth.)
	if bytesWritten(a) != 4 {
		return "scalar-field extract should emit one LDR"
	}
	return ""
}

// emitExtract on a multi-return tuple of two uint32s must use a
// 32-bit LDR (LDR Wn) for each field, not the 64-bit LDR Xn that
// would pull the neighbor's bits in along with the field's. The two
// fields share an 8-byte slot at offsets 0 and 4. Regression test
// for cluster-B pkg/asm/arm32 dpEnc failures.
func TestEmitExtractMultiReturnUint32FieldUsesScalarLoad() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 3)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 4)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var tupleFields @[]@types.Field = make_slice(@types.Field, 2)
	tupleFields[0] = make(types.Field)
	tupleFields[0].Type = types.TypUint32()
	tupleFields[1] = make(types.Field)
	tupleFields[1].Type = types.TypUint32()
	var tuple @types.Type = types.MakeStructType("", tupleFields)

	var call @ir.Instr = make(ir.Instr)
	call.ID = 3
	call.Op = ir.OP_CALL
	call.Typ = tuple
	var ext @ir.Instr = make(ir.Instr)
	ext.ID = 4
	ext.Op = ir.OP_EXTRACT
	ext.Index = 1
	ext.Typ = types.TypUint32()
	ext.Args = make_slice(@ir.Instr, 1)
	ext.Args[0] = call
	emitExtract(a, rm, ext)
	// One 4-byte instruction — that it's a 32-bit LDR specifically is
	// the whole point, but we don't decode here. The conformance
	// guarantee is end-to-end via builder-comp_native_aa64-comp_native_aa64 pkg/asm/arm32.
	if bytesWritten(a) != 4 {
		return "uint32 field extract should emit one LDR"
	}
	return ""
}

// emitExtract on an OP_MAKE_SLICE source must INDIRECT through the
// spill-slot pointer: first reload the pointer (LDR), then LDR the
// word at [ptr, 8*Index].
func TestEmitExtractIndirectFromMakeSlice() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 7)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 8)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 40)
	var ms @ir.Instr = make(ir.Instr)
	ms.ID = 7
	ms.Op = ir.OP_MAKE_SLICE
	ms.Typ = types.MakeManagedSliceType(types.TypInt())
	var ext @ir.Instr = make(ir.Instr)
	ext.ID = 8
	ext.Op = ir.OP_EXTRACT
	ext.Index = 1
	ext.Typ = types.TypInt()
	ext.Args = make_slice(@ir.Instr, 1)
	ext.Args[0] = ms
	emitExtract(a, rm, ext)
	// Indirect: reload ptr (LDR) + deref (LDR) = 8 bytes.
	if bytesWritten(a) != 8 {
		return "indirect extract should emit LDR + LDR"
	}
	return ""
}

// emitBox must use the OP_ALLOC fast path: compute the alloca's
// address into X0, load the size into X1, BL bn_pkg__rt__Box. Missing
// the alloca check would silently fall through and produce garbage.
func TestEmitBoxFromAlloca() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Allocated struct of 16 bytes at offset 0.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 2)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 16)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 3)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 16)
	var alc @ir.Instr = make(ir.Instr)
	alc.ID = 2
	alc.Op = ir.OP_ALLOC
	alc.TypeArg = types.MakeArrayType(types.TypInt(), 2)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 3
	ins.Op = ir.OP_BOX
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = alc
	emitBox(a, rm, ins)
	// ADD X0,SP,#off + MOVZ X1,#16 + BL + MOV rd,X0 = 16 bytes.
	if bytesWritten(a) != 16 {
		return "box-from-alloca should emit ADD+MOVZ+BL+MOV (16 bytes)"
	}
	return ""
}

// emitBox aggregate-load case: `box(iv)` for a loaded iv-value
// must emit the bn_pkg__rt__Box call using the operand's spill-slot
// pointer as srcPtr.  Pre-fix this path silently returned (the
// early-return guard only handled OP_ALLOC), leaving the
// downstream `@`-pointer uninitialized.  Conformance 444 / 445 /
// 450 / 458 exercise this end-to-end; this unit test pins it at
// the emit layer.
func TestEmitBoxFromAggregateLoad() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = make(common.RegMap)
	// The operand is a 16-byte aggregate (an iv) spilled at offset
	// 0; the spill slot holds a pointer to the data, per
	// SpillHoldsAggregatePointer.
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 6)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	// Build the iv-typed source instr.  No Op needed — we go
	// through the IsAggregateTyp branch which keys off val.Typ.
	var src @ir.Instr = make(ir.Instr)
	src.ID = 5
	src.Op = ir.OP_LOAD
	// Build an iv type by wrapping a placeholder iface.
	var iface @types.Type = types.MakeInterfaceType("test", "I")
	src.Typ = types.MakeInterfaceValueType(iface)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 6
	ins.Op = ir.OP_BOX
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = src
	emitBox(a, rm, ins)
	// LDR (operand pointer from spill) + MOV X0,src + MOVZ X1,#16 +
	// BL bn_pkg__rt__Box + MOV rd,X0 = 5 insns = 20 bytes.
	if bytesWritten(a) != 20 {
		return "box-from-aggregate-load should emit LDR+MOV+MOVZ+BL+MOV (20 bytes)"
	}
	return ""
}

// emitRodataMSliceOrSlice materializes a slice header at the reserved
// data region pointing into rodata. For @[]const char: ADRP + ADD
// (label) + STR(data) + MOVZ len + STR(len) + STR XZR×2 = 7 insns =
// 28 bytes; then one ADD for the result pointer = 32 bytes total.
// (ADRP+ADD instead of ADR because Mach-O can't relocate ADR
// cross-section — see e4c9edd.)
func TestEmitStringToCharsManaged() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Pre-registered string id=0, any contents.
	var strings @[]ir.StringConst = make_slice(ir.StringConst, 1)
	var sc ir.StringConst
	sc.ID = 0
	sc.Data = "hi"
	strings[0] = sc
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 9)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = ir.OP_RODATA_MSLICE
	ins.Typ = types.MakeManagedSliceType(types.TypChar())
	ins.StrVal = "hi"
	emitRodataMSliceOrSlice(a, rm, strings, ins)
	// 8 insns * 4 bytes = 32 bytes.
	if bytesWritten(a) != 32 {
		return "@[]const char materialize should emit 8 insns"
	}
	return ""
}

// emitStringToCharsCopy: Stage 2b lowering, dispatched via the
// OP_RODATA_MSLICE_COPY op. Allocates a fresh managed-slice via the
// runtime and memcpys the literal bytes — `var s @[]char = "..."`
// must own its bytes (aliasing rodata and writing would SIGBUS).
//
// Sequence: 2 MOVZ (elem=1, len) + BL MakeManagedSlice + 4× STR
// (slice header) + ADRP + ADD (rodata label) + MOVZ (memcpy len) +
// BL c_memcpy + ADD rd = 12 insns = 48 bytes. (ADRP+ADD instead of
// ADR for cross-section addressing — see e4c9edd.)
func TestEmitStringToCharsStage2bCopy() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var strings @[]ir.StringConst = make_slice(ir.StringConst, 1)
	var sc ir.StringConst
	sc.ID = 0
	sc.Data = "hi"
	strings[0] = sc
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 9)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = ir.OP_RODATA_MSLICE_COPY
	ins.Typ = types.MakeManagedSliceType(types.TypChar())
	ins.StrVal = "hi"
	emitStringToCharsCopy(a, rm, strings, ins, ins.StrVal)
	if bytesWritten(a) != 48 {
		return "Stage 2b copy should emit 12 insns / 48 bytes"
	}
	return ""
}

// emitStringToArray (now driven by OP_RODATA_ARRAY): zero-fill the
// buffer in 64-bit chunks then memcpy strLen bytes from rodata. For
// [5]char (rounded up to 8 by PlanFrame): 1 STR XZR + ADD dst +
// ADRP src + ADD (label) + MOVZ len + BL memcpy + ADD rd = 7 insns
// = 28 bytes. (ADRP+ADD instead of ADR for cross-section addressing
// — see e4c9edd.)
func TestEmitStringToArray() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	var strings @[]ir.StringConst = make_slice(ir.StringConst, 1)
	var sc ir.StringConst
	sc.ID = 0
	sc.Data = "abcde"
	strings[0] = sc
	// PlanFrame would round 5 up to 8; mirror that here.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 9)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 8)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 9)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 9
	ins.Op = ir.OP_RODATA_ARRAY
	ins.Typ = types.MakeArrayType(types.TypChar(), 5)
	ins.StrVal = "abcde"
	emitStringToArray(a, rm, strings, ins)
	if bytesWritten(a) != 28 {
		return "OP_RODATA_ARRAY [5]char should emit 7 insns / 28 bytes"
	}
	return ""
}

// emitGetFieldPtr on a slice base: subslice (a[1:3]) lowers to a
// chain of GetFieldPtr ops that index the four words of an alloca'd
// managed-slice (data, len, refptr, backingLen). Without slice-base
// support this silently no-op'd, leaving the destination address
// uninitialized — the regression that crashed
// 130_managed_slice_backing_rc and the rest of the subslice
// cluster.
func TestEmitGetFieldPtrManagedSliceField() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Allocate a 32-byte managed-slice on stack at offset 0.
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 5)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 6)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	var alc @ir.Instr = make(ir.Instr)
	alc.ID = 5
	alc.Op = ir.OP_ALLOC
	alc.TypeArg = types.MakeManagedSliceType(types.TypInt())
	alc.Typ = types.MakePointerType(types.MakeManagedSliceType(types.TypInt()))
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 6
	ins.Op = ir.OP_GET_FIELD_PTR
	ins.Index = 2
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = alc
	emitGetFieldPtr(a, "main", rm, ins)
	// Should emit a single ADD rd, SP, #(0 + 8*2) = 4 bytes.
	if bytesWritten(a) != 4 {
		return "GetFieldPtr on slice base should emit one ADD"
	}
	return ""
}

// emitMakeSlice emits: MOVZ X0 (elem size), MOV X1 (len reg), BL
// bn_pkg__rt__MakeManagedSlice, 4× STR Xi to data region, ADD rd (pointer
// result) = 32 bytes. Guards against the LLVM-returns-in-X0..X3
// assumption getting silently dropped.
func TestEmitMakeSliceSpillsFourWords() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	rm.AllocIDs = common.AppendInt(rm.AllocIDs, 5)
	rm.AllocOffsets = common.AppendInt(rm.AllocOffsets, 0)
	rm.AllocSizes = common.AppendInt(rm.AllocSizes, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 6)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 32)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 40)
	var lenArg @ir.Instr = make(ir.Instr)
	lenArg.ID = 6
	lenArg.Op = ir.OP_CONST_INT
	lenArg.Typ = types.TypInt()
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 5
	ins.Op = ir.OP_MAKE_SLICE
	ins.Typ = types.MakeManagedSliceType(types.TypInt())
	ins.TypeArg = types.TypInt()
	ins.Args = make_slice(@ir.Instr, 1)
	ins.Args[0] = lenArg
	emitMakeSlice(a, rm, ins)
	// MOVZ X0 + LDR len + MOV X1 + BL + 4×STR + ADD rd = 9 insns.
	if bytesWritten(a) != 36 {
		return "make_slice should emit 9 instructions (36 bytes)"
	}
	return ""
}

// emitInstr's OP_BOUNDS_CHECK arm lowers to a call to
// _bn_pkg__rt__BoundsCheck(idx, len). Without this arm, the IR's
// bounds-check ops were silently dropped and OOB indexing printed
// garbage instead of running the runtime trap. Pin both observable
// effects: the symbol must be registered as a global (so the BL
// links), and the emit count must reflect the load+mov+bl sequence.
func TestEmitBoundsCheckCallsRuntime() testing.TestResult {
	var a @asm.Assembler = mkAsm()
	var rm @common.RegMap = common.NewRegMap(common.AAPCS64())
	// Spill slots for the two operand IDs (idx=5, len=6).
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 5)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 0)
	rm.SpillIDs = common.AppendInt(rm.SpillIDs, 6)
	rm.SpillOffsets = common.AppendInt(rm.SpillOffsets, 8)
	var idxArg @ir.Instr = make(ir.Instr)
	idxArg.ID = 5
	var lenArg @ir.Instr = make(ir.Instr)
	lenArg.ID = 6
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_BOUNDS_CHECK
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = idxArg
	ins.Args[1] = lenArg
	var noStrings @[]ir.StringConst
	var noFuncsLocal @[]@ir.Func
	emitInstr(a, "main", "fn", rm, noStrings, noFuncsLocal, ins)
	// 2× LDR (idx, len) + 2× MOV (X0, X1) + BL = 5 insns = 20 bytes.
	if bytesWritten(a) != 20 {
		return "OP_BOUNDS_CHECK should emit 5 insns (20 bytes)"
	}
	var symIdx int = a.LookupSymbol("_bn_pkg__rt__BoundsCheck")
	if symIdx < 0 {
		return "OP_BOUNDS_CHECK should register _bn_pkg__rt__BoundsCheck"
	}
	if a.Symbols[symIdx].Binding != asm.BIND_GLOBAL {
		return "_bn_pkg__rt__BoundsCheck must be marked BIND_GLOBAL for linkage"
	}
	return ""
}
