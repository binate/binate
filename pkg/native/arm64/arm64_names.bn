package "pkg/native/arm64"

import "pkg/asm"
import "pkg/asm/aarch64"
import "pkg/buf"
import "pkg/ir"
import "pkg/mangle"
import "pkg/types"

// ============================================================
// Name helpers
// ============================================================

// symFor mangles a Binate (pkgName, funcName) pair to a Mach-O symbol,
// prepending the '_' required by Mach-O C-linkage.  Routes through
// underscorePrefix so the leading-'_' convention lives in exactly one
// place (Phase 1 of plan-backend-objformat-decoupling.md — the prefix
// becomes a format property in Phase 2).
func symFor(pkgName *[]const char, funcName *[]const char) @[]char {
	var mangled buf.CharBuf = mangle.FuncName(pkgName, funcName)
	return underscorePrefix(mangled.Bytes())
}

// globalSymFor mangles a package-level variable to its Mach-O symbol
// ('_' + `bn_<pkg>__<name>`). Different from symFor because globals go
// through mangle.GlobalName (no special case for main.main).
func globalSymFor(pkgName *[]const char, name *[]const char) @[]char {
	var mangled buf.CharBuf = mangle.GlobalName(pkgName, name)
	return underscorePrefix(mangled.Bytes())
}

// isSliceFieldBase reports whether ins names a base whose
// OP_GET_FIELD_PTR fields are word-sized slice fields rather than a
// real struct's. The IR uses the raw value's pointee type — a
// pointer to (managed)slice — to mean "I'm taking field N (data /
// len / refptr / backingLen) of the slice through this address."
func isSliceFieldBase(ins @ir.Instr) bool {
	if ins == nil { return false }
	if ins.TypeArg != nil &&
		(ins.TypeArg.Kind == types.TYP_SLICE ||
			ins.TypeArg.Kind == types.TYP_MANAGED_SLICE) {
		return true
	}
	if ins.Typ != nil && ins.Typ.Elem != nil {
		var k int = ins.Typ.Elem.Kind
		if k == types.TYP_SLICE || k == types.TYP_MANAGED_SLICE {
			return true
		}
	}
	return false
}

// isGlobalRef reports whether ins is the pseudo-Instr the IR produces
// for a package-level variable reference. Uses Instr.IsGlobalRef
// (set by lookupVar's global-fallback path) — a name-based check
// would falsely match local allocas whose variable name collides
// with a global. These reach their address via ADRP+ADD
// (cross-segment) rather than SP-relative allocas or spill reloads.
func isGlobalRef(ins @ir.Instr) bool {
	if ins == nil { return false }
	return ins.IsGlobalRef
}

// emitGlobalAddr emits the ADRP+ADD pair that places the runtime
// address of a package-level variable in rd. The two fixups
// (FIX_ADRP_HI21 → PAGE21, FIX_ADD_LO12 → PAGEOFF12) let the linker
// resolve the cross-segment address to __DATA.
func emitGlobalAddr(a @asm.Assembler, pkgName *[]const char, rd int,
	ins @ir.Instr) {
	var label @[]char = globalSymFor(pkgName, ins.StrVal)
	a.SetGlobal(label)
	aarch64.Adrp(a, rd, label)
	aarch64.AddImmLabel(a, true, rd, rd, label)
}

// underscorePrefix returns "_" + s, the Mach-O C-linkage convention.
func underscorePrefix(s *[]const char) @[]char {
	var out buf.CharBuf = buf.New()
	out = out.WriteStr("_")
	out = out.WriteStr(s)
	return out.Bytes()
}

// handleSymFor returns the Mach-O label for the LLVM-shape handle global
// `___handle.bn_<pkg>__<fn>`.  Mirrors the @__handle.<mangled> globals
// pkg/codegen emits via emitFuncValueHandle so cross-mode references
// (compiled-side function-value handle consumed by an aa64-emitted main,
// or vice versa) resolve to a single weak_odr definition at link time.
// Phase 4 of plan-uniform-native-fnptrs.md.
func handleSymFor(pkgName *[]const char, funcName *[]const char) @[]char {
	var mangled buf.CharBuf = mangle.FuncName(pkgName, funcName)
	var out buf.CharBuf = buf.New()
	out = out.WriteStr("___handle.")
	out = out.WriteStr(mangled.Bytes())
	return out.Bytes()
}

// vtableSymForLLVM returns the LLVM-shape vtable label
// `___vt.bn_<pkg>__<fn>`.  This is what the handle's vt_ptr slot
// points at, matching the @__vt.<mangled> pkg/codegen emits via
// emitFuncValueVtable.  Distinct from vtableSymFor (`_bn_..__vt`)
// which OP_FUNC_VALUE construction sites in arm64_dispatch.bn use
// internally — the two coexist for now; unification is a follow-up.
func vtableSymForLLVM(pkgName *[]const char, funcName *[]const char) @[]char {
	var mangled buf.CharBuf = mangle.FuncName(pkgName, funcName)
	var out buf.CharBuf = buf.New()
	out = out.WriteStr("___vt.")
	out = out.WriteStr(mangled.Bytes())
	return out.Bytes()
}

// shimSymForLLVM returns the LLVM-shape shim label
// `___shim.bn_<pkg>__<fn>` — what the LLVM-shape vtable's call slot
// points at (the per-function tail-call wrapper).
func shimSymForLLVM(pkgName *[]const char, funcName *[]const char) @[]char {
	var mangled buf.CharBuf = mangle.FuncName(pkgName, funcName)
	var out buf.CharBuf = buf.New()
	out = out.WriteStr("___shim.")
	out = out.WriteStr(mangled.Bytes())
	return out.Bytes()
}

// argReg returns the AArch64 register that carries the i-th integer
// arg under the Procedure Call Standard (X0..X7).
func argReg(i int) int {
	if i == 0 { return aarch64.X0 }
	if i == 1 { return aarch64.X1 }
	if i == 2 { return aarch64.X2 }
	if i == 3 { return aarch64.X3 }
	if i == 4 { return aarch64.X4 }
	if i == 5 { return aarch64.X5 }
	if i == 6 { return aarch64.X6 }
	return aarch64.X7
}

// stringLabel is the local asm label for string constant <id>.
func stringLabel(id int) @[]char {
	var out buf.CharBuf = buf.New()
	out = out.WriteStr("Lstr_")
	out = out.WriteInt(id)
	return out.Bytes()
}

// blockLabel mints a function-scoped label name for a basic block.
// The 'L' prefix keeps it out of the exported symbol list.
func blockLabel(funcSym @[]char, blockLabel @[]char) @[]char {
	var out buf.CharBuf = buf.New()
	out = out.WriteStr("L")
	out = out.WriteStr(funcSym)
	out = out.WriteStr("__")
	out = out.WriteStr(blockLabel)
	return out.Bytes()
}

// stripQuotes strips surrounding '"' from a string (if present).
func stripQuotes(s *[]const char) *[]const char {
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		return s[1:len(s)-1]
	}
	return s
}
