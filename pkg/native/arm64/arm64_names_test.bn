package "pkg/native/arm64"

import "pkg/asm/aarch64"
import "pkg/builtin/testing"

// argReg covers X0..X7 PCS slots and saturates at X7 for out-of-range
// indices (callers handle the >7 case via stack args).
func TestArgRegSlots() testing.TestResult {
	if argReg(0) != aarch64.X0 { return fail("argReg(0)") }
	if argReg(7) != aarch64.X7 { return fail("argReg(7)") }
	if argReg(8) != aarch64.X7 { return fail("argReg(8) saturates at X7") }
	return ""
}

// Eight Binate integer params go to X0..X7. The PCS is fixed; this
// guards against an accidental re-shuffle breaking every multi-arg
// call and return.
func TestArgRegOrdering() testing.TestResult {
	var last int = -1
	for i := 0; i < 8; i++ {
		var r int = argReg(i)
		if r == last { return "adjacent argReg results should differ" }
		last = r
	}
	return ""
}

// underscorePrefix is tiny but central: every Mach-O symbol we emit
// (function, builtin-call target, etc.) goes through it.
func TestUnderscorePrefix() testing.TestResult {
	var s @[]char = underscorePrefix("bn_print_int")
	if len(s) != 13 { return "wrong length for _bn_print_int" }
	if s[0] != '_' { return "missing underscore" }
	if s[1] != 'b' { return "wrong second byte" }
	return ""
}

// stripQuotes drops surrounding quotes when present, leaving the
// inner string. Anything not matching stays intact.
func TestStripQuotesUnquoted() testing.TestResult {
	var s *[]const char = stripQuotes("foo")
	if !charEq(s, "foo") { return fail("unquoted should be returned as-is") }
	return ""
}

func TestStripQuotesQuoted() testing.TestResult {
	var s *[]const char = stripQuotes("\"foo\"")
	if !charEq(s, "foo") { return fail("quoted should have quotes stripped") }
	return ""
}
