package "pkg/native/arm64"

import "pkg/asm"
import "pkg/asm/aarch64"
import "pkg/buf"
import "pkg/ir"
import "pkg/mangle"
import "pkg/native/common"
import "pkg/types"

// ============================================================
// Binary / unary / compare ops
// ============================================================

// emitBinop handles the integer arithmetic, bitwise, and shift ops.
// Returns true if it matched and emitted code; false otherwise.
func emitBinop(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != ir.OP_ADD &&
		ins.Op != ir.OP_SUB &&
		ins.Op != ir.OP_MUL &&
		ins.Op != ir.OP_DIV &&
		ins.Op != ir.OP_REM &&
		ins.Op != ir.OP_AND &&
		ins.Op != ir.OP_OR  &&
		ins.Op != ir.OP_XOR &&
		ins.Op != ir.OP_SHL &&
		ins.Op != ir.OP_SHR &&
		ins.Op != ir.OP_LAND &&
		ins.Op != ir.OP_LOR {
		return false
	}
	if len(ins.Args) != 2 { return false }

	// Float arithmetic: dispatch on result type. emitFloatBinop
	// only matches OP_ADD/SUB/MUL/DIV; integer ops on floats
	// don't exist and would fall through to the int path below.
	if emitFloatBinop(a, rm, ins) { return true }

	var lhs int = getOperand(a, rm, ins.Args[0].ID)
	var rhs int = getOperand(a, rm, ins.Args[1].ID)
	if lhs < 0 || rhs < 0 { return false }

	var rd int = nextReg(rm, ins.ID)
	var rhsOp aarch64.Operand = aarch64.Reg(rhs)

	if ins.Op == ir.OP_ADD { aarch64.Add(a, true, rd, lhs, rhsOp); return true }
	if ins.Op == ir.OP_SUB { aarch64.Sub(a, true, rd, lhs, rhsOp); return true }
	if ins.Op == ir.OP_MUL { aarch64.Mul(a, true, rd, lhs, rhs);   return true }
	if ins.Op == ir.OP_DIV { aarch64.Sdiv(a, true, rd, lhs, rhs);  return true }
	// OP_REM: synthesize via SDIV + MSUB (rd = lhs - (lhs/rhs)*rhs).
	if ins.Op == ir.OP_REM {
		aarch64.Sdiv(a, true, rd, lhs, rhs)
		aarch64.Msub(a, true, rd, rd, rhs, lhs)
		return true
	}
	if ins.Op == ir.OP_AND { aarch64.And(a, true, rd, lhs, rhsOp); return true }
	if ins.Op == ir.OP_OR  { aarch64.Orr(a, true, rd, lhs, rhsOp); return true }
	// OP_LAND / OP_LOR — used by switch case lists (`case 1, 2, 3:`)
	// where all comparisons are always evaluated. Plain bitwise on
	// bool registers gives the right result. User-level `&&` / `||`
	// short-circuit through the IR's branch-form lowering and never
	// reach here.
	if ins.Op == ir.OP_LAND { aarch64.And(a, true, rd, lhs, rhsOp); return true }
	if ins.Op == ir.OP_LOR  { aarch64.Orr(a, true, rd, lhs, rhsOp); return true }
	if ins.Op == ir.OP_XOR { aarch64.Eor(a, true, rd, lhs, rhsOp); return true }
	if ins.Op == ir.OP_SHL { aarch64.Lsl(a, true, rd, lhs, rhsOp); return true }
	// OP_SHR: arithmetic shift right (preserves sign for signed ints).
	if ins.Op == ir.OP_SHR { aarch64.Asr(a, true, rd, lhs, rhsOp); return true }
	return false
}

// emitCompare handles OP_EQ/NE/LT/LE/GT/GE by emitting CMP + CSINC with
// XZR (the CSET idiom). The assembler doesn't expose CSET directly, but
// CSET Rd, cond ≡ CSINC Rd, XZR, XZR, invert(cond).
func emitCompare(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != ir.OP_EQ && ins.Op != ir.OP_NE &&
		ins.Op != ir.OP_LT && ins.Op != ir.OP_LE &&
		ins.Op != ir.OP_GT && ins.Op != ir.OP_GE {
		return false
	}
	if len(ins.Args) != 2 { return false }
	var lhs int = getOperand(a, rm, ins.Args[0].ID)
	var rhs int = getOperand(a, rm, ins.Args[1].ID)
	if lhs < 0 || rhs < 0 { return false }

	var rd int = nextReg(rm, ins.ID)
	aarch64.Cmp(a, true, lhs, aarch64.Reg(rhs))

	var invCond int = invertCondForOp(ins.Op)
	aarch64.Csinc(a, true, rd, aarch64.XZR, aarch64.XZR, invCond)
	return true
}

// invertCondForOp returns the AArch64 condition code that is the
// logical inverse of the IR comparison, so `csinc rd,xzr,xzr,invCond`
// sets rd=1 exactly when the comparison holds.
func invertCondForOp(op int) int {
	if op == ir.OP_EQ { return aarch64.COND_NE }
	if op == ir.OP_NE { return aarch64.COND_EQ }
	if op == ir.OP_LT { return aarch64.COND_GE }  // signed
	if op == ir.OP_LE { return aarch64.COND_GT }  // signed
	if op == ir.OP_GT { return aarch64.COND_LE }  // signed
	return aarch64.COND_LT                         // OP_GE, signed
}

// emitUnop handles unary ops (-, ~, !). Returns true if matched.
func emitUnop(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) bool {
	if ins.Op != ir.OP_NEG && ins.Op != ir.OP_BITNOT && ins.Op != ir.OP_NOT {
		return false
	}
	if len(ins.Args) != 1 { return false }

	// Float negation goes through FNEG via D scratch.
	if ins.Op == ir.OP_NEG && emitFloatNeg(a, rm, ins) { return true }

	var src int = getOperand(a, rm, ins.Args[0].ID)
	if src < 0 { return false }

	var rd int = nextReg(rm, ins.ID)
	if ins.Op == ir.OP_NEG {
		aarch64.Neg(a, true, rd, aarch64.Reg(src))
		return true
	}
	if ins.Op == ir.OP_BITNOT {
		aarch64.Mvn(a, true, rd, aarch64.Reg(src))
		return true
	}
	// OP_NOT: logical negation on a bool. Flip bit 0.
	if ins.Op == ir.OP_NOT {
		aarch64.Eor(a, true, rd, src, aarch64.Imm(1))
		return true
	}
	return false
}

// ============================================================
// Function calls and struct copy
// ============================================================

// emitCall moves args into X0..X7 and branches to the callee symbol.
// ins.StrVal is the Binate-level call name; goes through
// pkg/mangle.FuncName for the C symbol.
// Declares the callee as a global so Finalize emits a relocation
// rather than failing with "undefined symbol."
func emitCall(a @asm.Assembler, pkgName *[]const char, rm @common.RegMap,
	allFuncs @[]@ir.Func, ins @ir.Instr) {
	// AAPCS-style argument dispatch: scalars and aggregates get
	// reg-or-stack assignments via common.CallArgRegStart /
	// CallArgStackOff. Aggregates that don't fit in remaining regs
	// go ENTIRELY on stack (no reg/stack split per arg). Stack args
	// land in the outgoing-args area at [sp+0..OutgoingArgsSize),
	// which PlanFrame reserved at the bottom of the frame so SP
	// stays stable for the surrounding spill addressing.
	var argTypes @[]@types.Type = make_slice(@types.Type, len(ins.Args))
	for i := 0; i < len(ins.Args); i++ {
		argTypes[i] = ins.Args[i].Typ
	}
	// AAPCS NSRN: float scalar args go to D(NSRN), separate from the
	// GP NGRN counter. Currently capped at 8 (D0..D7) — beyond that
	// would need stack-arg handling, which no test exercises.
	var nsrn int = 0
	for ai := 0; ai < len(ins.Args); ai++ {
		var arg @ir.Instr = ins.Args[ai]
		if isFloatTyp(arg.Typ) {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if nsrn < 8 {
				aarch64.Fmov_gp_to_fp(a, aarch64.D0 + nsrn, src)
				nsrn = nsrn + 1
			}
			// Stack-overflow case (>8 FP args) deferred — not exercised.
			continue
		}
		var regStart int = common.CallArgRegStart(argTypes, ai)
		var stackOff int = common.CallArgStackOff(argTypes, ai)
		if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			var nWords int = common.ArgWords(arg.Typ)
			// Three cases: all-in-regs, all-on-stack, or split (some
			// in regs, overflow on stack). LLVM's byval AAPCS lowering
			// uses split when an aggregate straddles X0..X7; native
			// must match or cross-package calls between native main
			// and LLVM-compiled deps mismatch (conformance 337). X16
			// (IP0) is the load temp for the stack portion — regPool
			// saturates at X15 so scratchReg(rm) can collide with
			// `ptr`; X16 is AAPCS intra-call scratch, safe across
			// Ldr/Str (no `bl` between).
			var regWords int = 0
			if regStart >= 0 {
				regWords = nWords
				if stackOff >= 0 { regWords = 8 - regStart }
				for w := 0; w < regWords; w++ {
					aarch64.Ldr(a, true, argReg(regStart + w),
						aarch64.MemImm(ptr, 8*w))
				}
			}
			if stackOff >= 0 {
				var tmp int = aarch64.X16
				for w := regWords; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp,
						aarch64.MemImm(ptr, 8*w))
					aarch64.Str(a, true, tmp,
						aarch64.MemImm(aarch64.SP,
							stackOff + 8*(w - regWords)))
				}
			}
		} else {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if regStart >= 0 {
				if src != argReg(regStart) {
					aarch64.Mov(a, true, argReg(regStart),
						aarch64.Reg(src))
				}
			} else {
				aarch64.Str(a, true, src,
					aarch64.MemImm(aarch64.SP, stackOff))
			}
		}
	}

	// AAPCS sret: caller passes &returnBuffer in X8 before BL when
	// (a) return is an aggregate > 64 bytes (our internal Binate
	// convention), (b) the callee is a C-extern returning > 16
	// bytes (clang/AAPCS-C), or (c) the result is a multi-return
	// tuple > 64 bytes — without (c), tuples beyond X0..X7's 64
	// bytes silently drop their tail.
	var bigMultiRet bool = ins.ID >= 0 &&
		common.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 &&
		(common.CallReturnsBigAggregate(ins) ||
		 common.CalleeUsesCSret(allFuncs, ins) ||
		 bigMultiRet)
	if bigRet {
		// Multi-return tuples land in the spill slot (sized to the
		// full tuple by PlanFrame); single-aggregate returns land in
		// the data region (alloc).
		var sretOff int = -1
		if bigMultiRet {
			sretOff = common.LookupSpill(rm, ins.ID)
		} else {
			sretOff = common.LookupAlloc(rm, ins.ID)
		}
		if sretOff >= 0 {
			aarch64.Add(a, true, aarch64.X8, aarch64.SP,
				aarch64.Imm(sretOff))
		}
	}

	var callee @[]char = symFor(pkgName, ins.StrVal)
	asm.SetGlobal(a, callee)
	aarch64.Bl(a, callee)

	// BL clobbers X9..X15. Reset the pool, then spill this call's
	// return value(s) so later uses can reload.
	common.ResetRegs(rm)
	if ins.ID < 0 { return }
	// Aggregate return that isn't a multi-return TYP_STRUCT — a slice,
	// an array, or a named struct-by-value — goes into a dedicated
	// data region (pointer-in-spill form, same as MAKE_SLICE) so
	// arg-spreading and OP_EXTRACT can treat it uniformly with
	// LOAD/MAKE_SLICE results. For ≤64-byte returns the callee packs
	// X0..X(N-1) and we spill them into the region; for >64-byte sret
	// returns the callee already wrote through X8 — we just produce
	// the pointer.
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) &&
		!common.IsMultiReturnCall(ins) {
		var dataOff int = common.LookupAlloc(rm, ins.ID)
		if dataOff < 0 { return }
		var sz int = types.SizeOf(ins.Typ)
		if sz <= 0 { return }
		if !bigRet {
			var nWords int = sz / 8
			for ri := 0; ri < nWords && ri < 8; ri++ {
				aarch64.Str(a, true, argReg(ri),
					aarch64.MemImm(aarch64.SP, dataOff + 8*ri))
			}
		}
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}
	// Multi-return TYP_STRUCT packs the tuple bytes directly into the
	// slot. Mirror OP_RETURN's per-arg register assignment exactly:
	// scalar fields take one X-register each (sized stores keep
	// sub-word fields like uint32 from clobbering their neighbor in
	// the same 8-byte cell), aggregate fields spread across N
	// consecutive registers and write back to consecutive 8-byte
	// offsets within the field. A naive `nWords = SizeOf(tuple) / 8`
	// loses the second register entirely for `(uint32, uint32)` —
	// total size 8 bytes / 1 word, but the callee returns it in
	// X0 + X1.
	var spillOff int = common.LookupSpill(rm, ins.ID)
	if spillOff < 0 { return }
	// Big multi-return tuples were already written through X8 by the
	// callee — the spill slot is the X8 destination.  Nothing to
	// collect from registers.
	if bigMultiRet { return }
	if !common.IsMultiReturnCall(ins) {
		aarch64.Str(a, true, argReg(0),
			aarch64.MemImm(aarch64.SP, spillOff))
		return
	}
	var rIdx int = 0
	for fi := 0; fi < len(ins.Typ.Fields) && rIdx < 8; fi++ {
		var fldTyp @types.Type = ins.Typ.Fields[fi].Type
		var fldOff int = types.FieldOffset(ins.Typ, fi)
		if common.IsAggregateTyp(fldTyp) {
			var fldSz int = types.SizeOf(fldTyp)
			var nWords int = fldSz / 8
			if nWords < 1 { nWords = 1 }
			for w := 0; w < nWords && rIdx < 8; w++ {
				aarch64.Str(a, true, argReg(rIdx),
					aarch64.MemImm(aarch64.SP,
						spillOff + fldOff + 8*w))
				rIdx = rIdx + 1
			}
		} else {
			var fldSz int = types.SizeOf(fldTyp)
			if fldSz <= 0 { fldSz = 8 }
			emitScalarStore(a, argReg(rIdx), aarch64.SP,
				spillOff + fldOff, fldSz)
			rIdx = rIdx + 1
		}
	}
}

// emitCallIndirect emits an indirect call (BLR Xn). Args[0] is the
// fn_ptr (loaded into X17 before arg dispatch may clobber its source);
// Args[1..] are the call args, dispatched via the same AAPCS machinery
// emitCall uses (X0..X7, then stack at SP+0..). X17 is the AAPCS IP1
// scratch register, safe across MOV+arg-loads since BL is the only
// thing that clobbers X16/X17 and we haven't BL'd yet. Same return-
// value handling as emitCall.
func emitCallIndirect(a @asm.Assembler, rm @common.RegMap,
	allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Stash fn_ptr in X17 before the arg-dispatch loop, which writes
	// X0..X7 (and may use X16 as a load temp for stack aggregates).
	// Loading the source register here ensures the value survives
	// even if the source reg gets reused below.
	var fnSrc int = getOperand(a, rm, ins.Args[0].ID)
	if fnSrc < 0 { return }
	aarch64.Mov(a, true, aarch64.X17, aarch64.Reg(fnSrc))

	// AAPCS arg dispatch on the call args (Args[1..]).
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = make_slice(@types.Type, nCallArgs)
	for i := 0; i < nCallArgs; i++ {
		argTypes[i] = ins.Args[i + 1].Typ
	}
	var nsrn int = 0
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		if isFloatTyp(arg.Typ) {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if nsrn < 8 {
				aarch64.Fmov_gp_to_fp(a,
					aarch64.D0 + nsrn, src)
				nsrn = nsrn + 1
			}
			continue
		}
		var regStart int = common.CallArgRegStart(argTypes, ai)
		var stackOff int = common.CallArgStackOff(argTypes, ai)
		if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			var nWords int = common.ArgWords(arg.Typ)
			if regStart >= 0 {
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true,
						argReg(regStart + w),
						aarch64.MemImm(ptr, 8*w))
				}
			} else {
				var tmp int = aarch64.X16
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp,
						aarch64.MemImm(ptr, 8*w))
					aarch64.Str(a, true, tmp,
						aarch64.MemImm(aarch64.SP,
							stackOff + 8*w))
				}
			}
		} else {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if regStart >= 0 {
				if src != argReg(regStart) {
					aarch64.Mov(a, true,
						argReg(regStart),
						aarch64.Reg(src))
				}
			} else {
				aarch64.Str(a, true, src,
					aarch64.MemImm(aarch64.SP, stackOff))
			}
		}
	}

	// AAPCS sret: indirect calls have no callee-symbol, so
	// CalleeUsesCSret never fires here — only the (a)/(c) cases
	// from emitCall (big aggregate / big multi-return) apply.
	var bigMultiRet bool = ins.ID >= 0 &&
		common.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 &&
		(common.CallReturnsBigAggregate(ins) || bigMultiRet)
	if bigRet {
		var sretOff int = -1
		if bigMultiRet {
			sretOff = common.LookupSpill(rm, ins.ID)
		} else {
			sretOff = common.LookupAlloc(rm, ins.ID)
		}
		if sretOff >= 0 {
			aarch64.Add(a, true, aarch64.X8, aarch64.SP,
				aarch64.Imm(sretOff))
		}
	}

	// BLR X17 — branch-and-link through the stashed fn_ptr register.
	aarch64.Blr(a, aarch64.X17)

	common.ResetRegs(rm)
	if ins.ID < 0 { return }

	// Aggregate single-return: spill X0..X(N-1) into the alloc region,
	// then materialize the region pointer (mirror of emitCall).
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) &&
		!common.IsMultiReturnCall(ins) {
		var dataOff int = common.LookupAlloc(rm, ins.ID)
		if dataOff < 0 { return }
		var sz int = types.SizeOf(ins.Typ)
		if sz <= 0 { return }
		if !bigRet {
			var nWords int = sz / 8
			for ri := 0; ri < nWords && ri < 8; ri++ {
				aarch64.Str(a, true, argReg(ri),
					aarch64.MemImm(aarch64.SP,
						dataOff + 8*ri))
			}
		}
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}

	var spillOff int = common.LookupSpill(rm, ins.ID)
	if spillOff < 0 { return }
	if bigMultiRet { return }
	if !common.IsMultiReturnCall(ins) {
		aarch64.Str(a, true, argReg(0),
			aarch64.MemImm(aarch64.SP, spillOff))
		return
	}
	var rIdx int = 0
	for fi := 0; fi < len(ins.Typ.Fields) && rIdx < 8; fi++ {
		var fldTyp @types.Type = ins.Typ.Fields[fi].Type
		var fldOff int = types.FieldOffset(ins.Typ, fi)
		if common.IsAggregateTyp(fldTyp) {
			var fldSz int = types.SizeOf(fldTyp)
			var nWords int = fldSz / 8
			if nWords < 1 { nWords = 1 }
			for w := 0; w < nWords && rIdx < 8; w++ {
				aarch64.Str(a, true, argReg(rIdx),
					aarch64.MemImm(aarch64.SP,
						spillOff + fldOff + 8*w))
				rIdx = rIdx + 1
			}
		} else {
			var fldSz int = types.SizeOf(fldTyp)
			if fldSz <= 0 { fldSz = 8 }
			emitScalarStore(a, argReg(rIdx), aarch64.SP,
				spillOff + fldOff, fldSz)
			rIdx = rIdx + 1
		}
	}
}

// emitCallFuncValue lowers OP_CALL_FUNC_VALUE: call through a 2-word
// function value's vtable.call. Compiled-mode dispatch — the call
// slot holds a real function pointer (vs. VM-mode, where the slot
// is a Phase-1 placeholder and the bytecode short-circuits via the
// closure record's vm_func_idx). Args[0] is the function value's
// address; Args[1..] are the call args, dispatched the same way as
// emitCallIndirect / emitCall.
func emitCallFuncValue(a @asm.Assembler, rm @common.RegMap,
	allFuncs @[]@ir.Func, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }

	// Two-step load to populate X17 with vtable.call:
	//   LDR X17, [fvAddr + 0]   ; X17 = vtable_ptr
	//   LDR X17, [X17 + 8]      ; X17 = vtable.call
	// Same X17 for source+dest in the second LDR is fine — AArch64
	// updates the dest after the load completes.
	var fvAddr int = getOperand(a, rm, ins.Args[0].ID)
	if fvAddr < 0 { return }
	aarch64.Ldr(a, true, aarch64.X17,
		aarch64.MemImm(fvAddr, 0))
	aarch64.Ldr(a, true, aarch64.X17,
		aarch64.MemImm(aarch64.X17, 8))

	// AAPCS arg dispatch on the call args (Args[1..]). Mirrors
	// emitCallIndirect's body — see plan-function-values.md.
	var nCallArgs int = len(ins.Args) - 1
	var argTypes @[]@types.Type = make_slice(@types.Type, nCallArgs)
	for i := 0; i < nCallArgs; i++ {
		argTypes[i] = ins.Args[i + 1].Typ
	}
	var nsrn int = 0
	for ai := 0; ai < nCallArgs; ai++ {
		var arg @ir.Instr = ins.Args[ai + 1]
		if isFloatTyp(arg.Typ) {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if nsrn < 8 {
				aarch64.Fmov_gp_to_fp(a,
					aarch64.D0 + nsrn, src)
				nsrn = nsrn + 1
			}
			continue
		}
		var regStart int = common.CallArgRegStart(argTypes, ai)
		var stackOff int = common.CallArgStackOff(argTypes, ai)
		if common.IsAggregateTyp(arg.Typ) {
			var ptr int = getOperand(a, rm, arg.ID)
			if ptr < 0 { continue }
			var nWords int = common.ArgWords(arg.Typ)
			if regStart >= 0 {
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true,
						argReg(regStart + w),
						aarch64.MemImm(ptr, 8*w))
				}
			} else {
				var tmp int = aarch64.X16
				for w := 0; w < nWords; w++ {
					aarch64.Ldr(a, true, tmp,
						aarch64.MemImm(ptr, 8*w))
					aarch64.Str(a, true, tmp,
						aarch64.MemImm(aarch64.SP,
							stackOff + 8*w))
				}
			}
		} else {
			var src int = getOperand(a, rm, arg.ID)
			if src < 0 { continue }
			if regStart >= 0 {
				if src != argReg(regStart) {
					aarch64.Mov(a, true,
						argReg(regStart),
						aarch64.Reg(src))
				}
			} else {
				aarch64.Str(a, true, src,
					aarch64.MemImm(aarch64.SP, stackOff))
			}
		}
	}

	// AAPCS sret — indirect-call shape, see emitCallIndirect note.
	var bigMultiRet bool = ins.ID >= 0 &&
		common.CallReturnsBigMultiReturn(ins)
	var bigRet bool = ins.ID >= 0 &&
		(common.CallReturnsBigAggregate(ins) || bigMultiRet)
	if bigRet {
		var sretOff int = -1
		if bigMultiRet {
			sretOff = common.LookupSpill(rm, ins.ID)
		} else {
			sretOff = common.LookupAlloc(rm, ins.ID)
		}
		if sretOff >= 0 {
			aarch64.Add(a, true, aarch64.X8, aarch64.SP,
				aarch64.Imm(sretOff))
		}
	}

	aarch64.Blr(a, aarch64.X17)
	common.ResetRegs(rm)
	if ins.ID < 0 { return }

	// Aggregate single-return: spill X0..X(N-1) into the alloc region
	// and produce its pointer. Same as emitCallIndirect / emitCall.
	if ins.Typ != nil && common.IsAggregateTyp(ins.Typ) &&
		!common.IsMultiReturnCall(ins) {
		var dataOff int = common.LookupAlloc(rm, ins.ID)
		if dataOff < 0 { return }
		var sz int = types.SizeOf(ins.Typ)
		if sz <= 0 { return }
		if !bigRet {
			var nWords int = sz / 8
			for ri := 0; ri < nWords && ri < 8; ri++ {
				aarch64.Str(a, true, argReg(ri),
					aarch64.MemImm(aarch64.SP,
						dataOff + 8*ri))
			}
		}
		var rd int = nextReg(rm, ins.ID)
		aarch64.Add(a, true, rd, aarch64.SP, aarch64.Imm(dataOff))
		return
	}

	var spillOff int = common.LookupSpill(rm, ins.ID)
	if spillOff < 0 { return }
	if bigMultiRet { return }
	if !common.IsMultiReturnCall(ins) {
		aarch64.Str(a, true, argReg(0),
			aarch64.MemImm(aarch64.SP, spillOff))
		return
	}
	var rIdx int = 0
	for fi := 0; fi < len(ins.Typ.Fields) && rIdx < 8; fi++ {
		var fldTyp @types.Type = ins.Typ.Fields[fi].Type
		var fldOff int = types.FieldOffset(ins.Typ, fi)
		if common.IsAggregateTyp(fldTyp) {
			var fldSz int = types.SizeOf(fldTyp)
			var nWords int = fldSz / 8
			if nWords < 1 { nWords = 1 }
			for w := 0; w < nWords && rIdx < 8; w++ {
				aarch64.Str(a, true, argReg(rIdx),
					aarch64.MemImm(aarch64.SP,
						spillOff + fldOff + 8*w))
				rIdx = rIdx + 1
			}
		} else {
			var fldSz int = types.SizeOf(fldTyp)
			if fldSz <= 0 { fldSz = 8 }
			emitScalarStore(a, argReg(rIdx), aarch64.SP,
				spillOff + fldOff, fldSz)
			rIdx = rIdx + 1
		}
	}
}

// emitRefcountCall emits a call to bn_rt__RefInc or bn_rt__RefDec.
// For RefDec (takesDtor=true), Args[1] is the optional destructor
// pointer; if absent, pass null in X1 (the IR uses null to mean "no
// dtor" — see ir.EmitRefcountDec).
func emitRefcountCall(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr,
	sym *[]const char, takesDtor bool) {
	if len(ins.Args) < 1 { return }
	var ptrReg int = getOperand(a, rm, ins.Args[0].ID)
	if ptrReg < 0 { return }
	aarch64.Mov(a, true, aarch64.X0, aarch64.Reg(ptrReg))
	if takesDtor {
		if len(ins.Args) > 1 {
			var dtorReg int = getOperand(a, rm, ins.Args[1].ID)
			if dtorReg < 0 { return }
			aarch64.Mov(a, true, aarch64.X1, aarch64.Reg(dtorReg))
		} else {
			aarch64.Movz(a, true, aarch64.X1, 0, 0)
		}
	}
	var callee @[]char = underscorePrefix(sym)
	asm.SetGlobal(a, callee)
	aarch64.Bl(a, callee)
	common.ResetRegs(rm)
}

// refincSeq is a module-scoped counter for unique skip labels in
// emitRefIncInline. Local labels (Lri_skip_<seq>) need to be unique
// across the entire emitted text section, not just per-function.
var refincSeq int

// refincSkipLabel formats the per-emission unique skip label.
func refincSkipLabel(seq int) @[]char {
	var out buf.CharBuf = buf.New()
	out = out.WriteStr("Lri_skip_")
	out = out.WriteInt(seq)
	return out.Bytes()
}

// emitRefIncInline lowers OP_REFINC to an inline RefInc fast path:
// nil-check, then a pre-indexed load that updates ptr to the header
// address and reads the refcount in one instruction, then add+store.
//
//   CBZ  ptrReg, .Lri_skip_<seq>
//   LDR  refcount, [ptrReg, #-16]!    ; ptrReg = ptr-16; refcount = *ptrReg
//   ADD  refcount, refcount, #1
//   STR  refcount, [ptrReg, #0]
// .Lri_skip_<seq>:
//
// Reusing ptrReg as the post-decrement header pointer is safe because
// spillAndReset clears the regmap after every instruction; subsequent
// uses of the SSA value reload from its spill slot.
func emitRefIncInline(a @asm.Assembler, rm @common.RegMap, ins @ir.Instr) {
	if len(ins.Args) < 1 { return }
	var ptrReg int = getOperand(a, rm, ins.Args[0].ID)
	if ptrReg < 0 { return }
	var refcountReg int = scratchReg(rm)
	var skipLabel @[]char = refincSkipLabel(refincSeq)
	refincSeq = refincSeq + 1
	aarch64.Cbz(a, true, ptrReg, skipLabel)
	aarch64.Ldr(a, true, refcountReg, aarch64.MemPre(ptrReg, -16))
	aarch64.Add(a, true, refcountReg, refcountReg, aarch64.Imm(1))
	aarch64.Str(a, true, refcountReg, aarch64.MemImm(ptrReg, 0))
	asm.DefineLabel(a, skipLabel)
}

// emitStructCopy lowers an OP_STORE that is copying a struct (or
// array) as a byte-for-byte memcpy. Source pointer comes from Args[1]
// (which, per OP_LOAD's struct handling, is a pointer in a register);
// dest from Args[0]. Either endpoint may be a package-level global,
// reached via ADRP+ADD to the __DATA symbol.
func emitStructCopy(a @asm.Assembler, pkgName *[]const char,
	rm @common.RegMap, ins @ir.Instr) {
	var sz int = types.SizeOf(ins.Args[1].Typ)
	if sz <= 0 { return }

	var srcPtr int
	if isGlobalRef(ins.Args[1]) {
		srcPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, srcPtr, ins.Args[1])
	} else if common.IsMultiReturnCall(ins.Args[1]) {
		// Multi-return spill holds the N*8 bytes themselves; we
		// need the address of those bytes, not their first word.
		var srcOff int = common.LookupSpill(rm, ins.Args[1].ID)
		if srcOff < 0 { return }
		srcPtr = scratchReg(rm)
		aarch64.Add(a, true, srcPtr, aarch64.SP, aarch64.Imm(srcOff))
	} else {
		srcPtr = getOperand(a, rm, ins.Args[1].ID)
	}
	if srcPtr < 0 { return }

	var dstPtr int
	var allocOff int = common.LookupAlloc(rm, ins.Args[0].ID)
	if allocOff >= 0 {
		dstPtr = scratchReg(rm)
		aarch64.Add(a, true, dstPtr, aarch64.SP, aarch64.Imm(allocOff))
	} else if isGlobalRef(ins.Args[0]) {
		dstPtr = scratchReg(rm)
		emitGlobalAddr(a, pkgName, dstPtr, ins.Args[0])
	} else {
		dstPtr = getOperand(a, rm, ins.Args[0].ID)
	}
	if dstPtr < 0 { return }

	var tmp int = scratchReg(rm)
	for off := 0; off < sz; off = off + 8 {
		aarch64.Ldr(a, true, tmp, aarch64.MemImm(srcPtr, off))
		aarch64.Str(a, true, tmp, aarch64.MemImm(dstPtr, off))
	}
}

// emitScalarLoad picks the right LDR variant for the given byte size
// (1/2/4/8) and emits a load into rd from [base, #off]. Byte and
// halfword loads are unsigned; the one existing use case is `char`
// (uint8). Callers needing signed narrowing should go through OP_CAST
// afterwards. The aarch64 lib handles oversize offsets internally
// (materializing via X17), so callers don't need to size-check off.
func emitScalarLoad(a @asm.Assembler, rd int, base int, off int, sz int) {
	if sz == 1 {
		aarch64.Ldrb(a, rd, aarch64.MemImm(base, off))
		return
	}
	if sz == 2 {
		aarch64.Ldrh(a, rd, aarch64.MemImm(base, off))
		return
	}
	if sz == 4 {
		aarch64.Ldr(a, false, rd, aarch64.MemImm(base, off))
		return
	}
	aarch64.Ldr(a, true, rd, aarch64.MemImm(base, off))
}

// emitScalarStore is the symmetric STRB/STRH/STR dispatcher. The
// aarch64 lib handles oversize offsets internally; callers don't
// need to size-check off.
func emitScalarStore(a @asm.Assembler, rt int, base int, off int, sz int) {
	if sz == 1 {
		aarch64.Strb(a, rt, aarch64.MemImm(base, off))
		return
	}
	if sz == 2 {
		aarch64.Strh(a, rt, aarch64.MemImm(base, off))
		return
	}
	if sz == 4 {
		aarch64.Str(a, false, rt, aarch64.MemImm(base, off))
		return
	}
	aarch64.Str(a, true, rt, aarch64.MemImm(base, off))
}

// emitConstInt64 loads a 64-bit integer constant into rd using a
// movz+movk chain — one MOVZ for the first non-zero 16-bit chunk,
// MOVKs for subsequent non-zero chunks. A single MOVZ suffices for
// small positives; larger values (e.g. 0x80000000 from test 151)
// need the chain.
//
// Negative values with bit 63 set are NOT handled here — they'd need
// MOVN. The IR typically emits positive IntVal with OP_NEG for
// negation, so this covers the common case.
func emitConstInt64(a @asm.Assembler, rd int, val int) {
	if val == 0 {
		aarch64.Movz(a, true, rd, 0, 0)
		return
	}
	var first bool = true
	for i := 0; i < 4; i++ {
		var shift int = 16 * i
		var chunk int = (val >> shift) & 0xFFFF
		if chunk == 0 { continue }
		if first {
			aarch64.Movz(a, true, rd, chunk, shift)
			first = false
		} else {
			aarch64.Movk(a, true, rd, chunk, shift)
		}
	}
	if first {
		// All chunks were zero but val != 0 — shouldn't happen for
		// finite values. Defensive fallback.
		aarch64.Movz(a, true, rd, 0, 0)
	}
}

// emitCast truncates src to the width of target (uint32/int32/…),
// storing the result in rd. For unsigned targets, zero-extend via
// LSL+LSR; for signed, sign-extend via LSL+ASR. For 64-bit targets
// (or target.Width == 0, meaning the predeclared `int`), pass
// through unchanged.
func emitCast(a @asm.Assembler, rd int, src int, target @types.Type) {
	var w int = 0
	if target != nil { w = target.Width }
	if w == 0 || w >= 64 {
		aarch64.Mov(a, true, rd, aarch64.Reg(src))
		return
	}
	var shift int = 64 - w
	aarch64.Lsl(a, true, rd, src, aarch64.Imm(shift))
	if target != nil && target.Signed {
		aarch64.Asr(a, true, rd, rd, aarch64.Imm(shift))
	} else {
		aarch64.Lsr(a, true, rd, rd, aarch64.Imm(shift))
	}
}

// emitEpilogueAndRet tears down the frame.
func emitEpilogueAndRet(a @asm.Assembler, frameSize int) {
	if frameSize > 0 {
		aarch64.Add(a, true, aarch64.SP, aarch64.SP, aarch64.Imm(frameSize))
	}
	aarch64.Ldp(a, true, aarch64.FP, aarch64.LR,
		aarch64.MemPost(aarch64.SP, 16))
	aarch64.Ret(a)
}

