package "pkg/native/arm64"

import "pkg/asm"
import "pkg/asm/aarch64"
import "pkg/ir"
import "pkg/native/common"
import "pkg/builtin/testing"

// opsMkAssembler: minimal assembler for direct-emit tests.
func opsMkAssembler() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)
	return a
}

func opsBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// emitScalarLoad dispatches by size: 1→LDRB, 2→LDRH, 4→LDR(W),
// 8→LDR(X). A regression that treats char as 8 bytes (pre-size-
// dispatch bug) would fail the size=1 case, and char handling across
// ~10 tests would silently break.
func TestEmitScalarLoadSizeOneIsLdrb() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarLoad(a, aarch64.X9, aarch64.SP, 0, 1)
	if opsBytes(a) != 4 { return "LDRB should be 4 bytes" }
	// LDRB (unsigned immediate) opcode top byte is 0x39.
	if a.Sections[0].Data[3] != cast(uint8, 0x39) {
		return "size=1 should emit LDRB (top byte 0x39)"
	}
	return ""
}

func TestEmitScalarLoadSizeEightIsLdrX() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarLoad(a, aarch64.X9, aarch64.SP, 0, 8)
	if opsBytes(a) != 4 { return "LDR X should be 4 bytes" }
	// LDR (X, unsigned immediate) opcode top byte is 0xF9.
	if a.Sections[0].Data[3] != cast(uint8, 0xF9) {
		return "size=8 should emit LDR X (top byte 0xF9)"
	}
	return ""
}

func TestEmitScalarStoreSizeOneIsStrb() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarStore(a, aarch64.X9, aarch64.SP, 0, 1)
	if opsBytes(a) != 4 { return "STRB should be 4 bytes" }
	// STRB opcode top byte is 0x39.
	if a.Sections[0].Data[3] != cast(uint8, 0x39) {
		return "size=1 should emit STRB (top byte 0x39)"
	}
	return ""
}

// emitRefcountCall emits into a fresh assembler: 2 movs (ptr+dtor) +
// 1 BL for RefDec, or 1 mov + 1 BL for RefInc. We check byte counts
// rather than exact encodings because the BL encodes a PC-relative
// offset that depends on fixup resolution.
func TestEmitRefcountInc() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_REFCOUNT_INC
	ins.Args = make_slice(@ir.Instr, 1)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 5
	ins.Args[0] = arg
	emitRefcountCall(a, m, ins, "bn_rt__RefInc", false)
	// Expect: LDR (reload ptr from spill) + MOV X0,rn + BL = 12 bytes.
	if opsBytes(a) != 12 {
		return "RefInc should emit LDR + MOV + BL (12 bytes)"
	}
	return ""
}

func TestEmitRefcountDecNoDtor() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_REFCOUNT_DEC
	ins.Args = make_slice(@ir.Instr, 1)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 5
	ins.Args[0] = arg
	emitRefcountCall(a, m, ins, "bn_rt__RefDec", true)
	// Expect: LDR + MOV X0,rn + MOVZ X1,#0 + BL = 16 bytes.
	if opsBytes(a) != 16 {
		return "RefDec w/o dtor should emit LDR+MOV+MOVZ+BL (16 bytes)"
	}
	return ""
}

// emitCall must spread aggregate args across multiple consecutive
// arg regs (2 for *[]T, 4 for @[]T), not just mov the pointer into
// one slot. Regressions here break slice-as-function-arg (the +6
// commit) silently by passing the data pointer in X0 and leaving
// X1 untouched.
func TestEmitCallSpreadsRawSliceArgAcrossTwoRegs() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	// Arg 0 is a raw-slice SSA value (16 bytes, pointer in spill).
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var sliceArg @ir.Instr = make(ir.Instr)
	sliceArg.ID = 2
	sliceArg.Op = ir.OP_LOAD
	sliceArg.Typ = types.MakeSliceType(types.TypInt())
	var call @ir.Instr = make(ir.Instr)
	call.ID = -1
	call.Op = ir.OP_CALL
	call.StrVal = "main.dummy"
	call.Typ = types.TypVoid()
	call.Args = make_slice(@ir.Instr, 1)
	call.Args[0] = sliceArg
	emitCall(a, "main", m, call, false)
	// Expected sequence: LDR reload ptr (4), 2× LDR X_argi (8), BL (4)
	// = 16 bytes. A regression that used `mov x0, rn` instead of two
	// ldrs would land at 12 bytes.
	if opsBytes(a) != 16 {
		return "raw slice arg should spread to X0+X1 (two LDRs)"
	}
	return ""
}

// invertCondForOp maps IR comparisons to the AArch64 condition codes
// that make `csinc rd,xzr,xzr,<cond>` set rd=1 iff the comparison
// holds. These are the walking-skeleton's truth table; a subtle
// off-by-one or wrong invert flips every boolean in the backend.

func TestInvertCondForOp() testing.TestResult {
	// For x == y, we want rd=1 on equality; csinc with COND_NE does
	// that (cond-true → rn=xzr; cond-false → rm+1=1).
	// Pairs: (ir op) → (expected cond code name)
	// We only check it's NOT the opposite — the exact constants live
	// in pkg/asm/aarch64 and change would break this anyway.
	var eq int = invertCondForOp(ir.OP_EQ)
	var ne int = invertCondForOp(ir.OP_NE)
	if eq == ne { return "OP_EQ and OP_NE should invert to distinct conds" }

	var lt int = invertCondForOp(ir.OP_LT)
	var ge int = invertCondForOp(ir.OP_GE)
	if lt == ge { return "OP_LT and OP_GE should invert to distinct conds" }

	var le int = invertCondForOp(ir.OP_LE)
	var gt int = invertCondForOp(ir.OP_GT)
	if le == gt { return "OP_LE and OP_GT should invert to distinct conds" }
	return ""
}

// Eight Binate integer params go to X0..X7. The PCS is fixed; this
// guards against an accidental re-shuffle breaking every multi-arg
// call and return.
func TestArgRegOrdering() testing.TestResult {
	var last int = -1
	for i := 0; i < 8; i++ {
		var r int = argReg(i)
		if r == last { return "adjacent argReg results should differ" }
		last = r
	}
	return ""
}

// underscorePrefix is tiny but central: every Mach-O symbol we emit
// (function, builtin-call target, etc.) goes through it.
func TestUnderscorePrefix() testing.TestResult {
	var s @[]char = underscorePrefix("bn_print_int")
	if len(s) != 13 { return "wrong length for _bn_print_int" }
	if s[0] != '_' { return "missing underscore" }
	if s[1] != 'b' { return "wrong second byte" }
	return ""
}
