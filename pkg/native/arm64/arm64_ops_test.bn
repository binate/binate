package "pkg/native/arm64"

import "pkg/ir"
import "pkg/builtin/testing"

// invertCondForOp maps IR comparisons to the AArch64 condition codes
// that make `csinc rd,xzr,xzr,<cond>` set rd=1 iff the comparison
// holds. These are the walking-skeleton's truth table; a subtle
// off-by-one or wrong invert flips every boolean in the backend.

func TestInvertCondForOp() testing.TestResult {
	// For x == y, we want rd=1 on equality; csinc with COND_NE does
	// that (cond-true → rn=xzr; cond-false → rm+1=1).
	// Pairs: (ir op) → (expected cond code name)
	// We only check it's NOT the opposite — the exact constants live
	// in pkg/asm/aarch64 and change would break this anyway.
	var eq int = invertCondForOp(ir.OP_EQ)
	var ne int = invertCondForOp(ir.OP_NE)
	if eq == ne { return "OP_EQ and OP_NE should invert to distinct conds" }

	var lt int = invertCondForOp(ir.OP_LT)
	var ge int = invertCondForOp(ir.OP_GE)
	if lt == ge { return "OP_LT and OP_GE should invert to distinct conds" }

	var le int = invertCondForOp(ir.OP_LE)
	var gt int = invertCondForOp(ir.OP_GT)
	if le == gt { return "OP_LE and OP_GT should invert to distinct conds" }
	return ""
}

// Eight Binate integer params go to X0..X7. The PCS is fixed; this
// guards against an accidental re-shuffle breaking every multi-arg
// call and return.
func TestArgRegOrdering() testing.TestResult {
	var last int = -1
	for i := 0; i < 8; i++ {
		var r int = argReg(i)
		if r == last { return "adjacent argReg results should differ" }
		last = r
	}
	return ""
}

// underscorePrefix is tiny but central: every Mach-O symbol we emit
// (function, builtin-call target, etc.) goes through it.
func TestUnderscorePrefix() testing.TestResult {
	var s @[]char = underscorePrefix("bn_print_int")
	if len(s) != 13 { return "wrong length for _bn_print_int" }
	if s[0] != '_' { return "missing underscore" }
	if s[1] != 'b' { return "wrong second byte" }
	return ""
}
