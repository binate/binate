package "pkg/native/arm64"

import "pkg/asm"
import "pkg/asm/aarch64"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/native/common"

// opsMkAssembler: minimal assembler for direct-emit tests.
func opsMkAssembler() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)
	return a
}

func opsBytes(a @asm.Assembler) int { return a.Sections[0].Len }

// nilFuncs returns an empty @[]@ir.Func for tests that don't need
// callee-lookup (CalleeUsesCSret returns false on an empty list).
func nilFuncs() @[]@ir.Func {
	var empty @[]@ir.Func
	return empty
}

// OP_LOR / OP_LAND are emitted by switch case-OR generation
// (`case 1, 2, 3:` chains) where short-circuit doesn't apply.
// emitBinop must dispatch them or the chain silently no-ops, leaving
// the BRANCH cond uninitialized — the regression that broke
// 083_multi_case_switch.
func TestEmitBinopHandlesLor() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var lhs @ir.Instr = make(ir.Instr)
	lhs.ID = 1
	lhs.Typ = types.TypBool()
	var rhs @ir.Instr = make(ir.Instr)
	rhs.ID = 2
	rhs.Typ = types.TypBool()
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_LOR
	ins.Typ = types.TypBool()
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = lhs
	ins.Args[1] = rhs
	if !emitBinop(a, m, ins) {
		return "emitBinop should match OP_LOR"
	}
	// 2× LDR (operand reloads) + 1× ORR = 12 bytes.
	if opsBytes(a) != 12 {
		return "OP_LOR should emit LDR + LDR + ORR"
	}
	return ""
}

// emitScalarLoad dispatches by size: 1→LDRB, 2→LDRH, 4→LDR(W),
// 8→LDR(X). A regression that treats char as 8 bytes (pre-size-
// dispatch bug) would fail the size=1 case, and char handling across
// ~10 tests would silently break.
func TestEmitScalarLoadSizeOneIsLdrb() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarLoad(a, aarch64.X9, aarch64.SP, 0, 1)
	if opsBytes(a) != 4 { return "LDRB should be 4 bytes" }
	// LDRB (unsigned immediate) opcode top byte is 0x39.
	if a.Sections[0].Data[3] != cast(uint8, 0x39) {
		return "size=1 should emit LDRB (top byte 0x39)"
	}
	return ""
}

func TestEmitScalarLoadSizeEightIsLdrX() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarLoad(a, aarch64.X9, aarch64.SP, 0, 8)
	if opsBytes(a) != 4 { return "LDR X should be 4 bytes" }
	// LDR (X, unsigned immediate) opcode top byte is 0xF9.
	if a.Sections[0].Data[3] != cast(uint8, 0xF9) {
		return "size=8 should emit LDR X (top byte 0xF9)"
	}
	return ""
}

func TestEmitScalarStoreSizeOneIsStrb() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	emitScalarStore(a, aarch64.X9, aarch64.SP, 0, 1)
	if opsBytes(a) != 4 { return "STRB should be 4 bytes" }
	// STRB opcode top byte is 0x39.
	if a.Sections[0].Data[3] != cast(uint8, 0x39) {
		return "size=1 should emit STRB (top byte 0x39)"
	}
	return ""
}

// emitRefcountCall emits into a fresh assembler: 2 movs (ptr+dtor) +
// 1 BL for RefDec, or 1 mov + 1 BL for RefInc. We check byte counts
// rather than exact encodings because the BL encodes a PC-relative
// offset that depends on fixup resolution.
func TestEmitRefcountInc() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_REFCOUNT_INC
	ins.Args = make_slice(@ir.Instr, 1)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 5
	ins.Args[0] = arg
	emitRefcountCall(a, m, ins, "bn_rt__RefInc", false)
	// Expect: LDR (reload ptr from spill) + MOV X0,rn + BL = 12 bytes.
	if opsBytes(a) != 12 {
		return "RefInc should emit LDR + MOV + BL (12 bytes)"
	}
	return ""
}

func TestEmitRefcountDecNoDtor() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 5)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = -1
	ins.Op = ir.OP_REFCOUNT_DEC
	ins.Args = make_slice(@ir.Instr, 1)
	var arg @ir.Instr = make(ir.Instr)
	arg.ID = 5
	ins.Args[0] = arg
	emitRefcountCall(a, m, ins, "bn_rt__RefDec", true)
	// Expect: LDR + MOV X0,rn + MOVZ X1,#0 + BL = 16 bytes.
	if opsBytes(a) != 16 {
		return "RefDec w/o dtor should emit LDR+MOV+MOVZ+BL (16 bytes)"
	}
	return ""
}

// emitStructCopy must distinguish multi-return-call sources (whose
// spill holds N*8 bytes directly) from regular aggregate-pointer
// sources (whose spill holds a pointer). The former needs `add SP,
// #spillOff` to materialize the address; the latter needs `ldr` to
// reload the pointer. Without the multi-return branch, a multi-return
// source ldr's the first word and treats that scalar as a pointer —
// the regression that broke 227_multi_return_managed_cleanup (the
// dtor of the anon-struct temp dereferences whatever the @Node ptr
// points to instead of the actual {ptr, int} bytes).
func TestEmitStructCopyMultiReturnSourceUsesAddNotLdr() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	// Source SSA id=1: an anonymous-struct multi-return CALL whose
	// 16-byte payload (a {ptr, int} tuple) lives in the spill slot.
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	// Dest SSA id=2: a 16-byte alloca (the temp the IR fabricates to
	// hand a pointer to the dtor).
	m.AllocIDs = common.AppendInt(m.AllocIDs, 2)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 16)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 16)
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.TypInt()
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	var anonStruct @types.Type = types.MakeStructType("", fields)
	// Name="" so IsMultiReturnCall is true.
	var src @ir.Instr = make(ir.Instr)
	src.ID = 1
	src.Op = ir.OP_CALL
	src.Typ = anonStruct
	var dst @ir.Instr = make(ir.Instr)
	dst.ID = 2
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_STORE
	ins.Args = make_slice(@ir.Instr, 2)
	ins.Args[0] = dst
	ins.Args[1] = src
	emitStructCopy(a, "main", m, ins)
	// Expected: ADD srcPtr,SP,#0 + ADD dstPtr,SP,#16 + 2× (LDR + STR)
	// = 2 + 4 = 6 instrs = 24 bytes. A regression that LDR-reloads
	// the source ends at: LDR + ADD dst + 2×(LDR+STR) = 5 instrs / 20.
	if opsBytes(a) != 24 {
		return "multi-return src should add+add+2(ldr+str) = 24 bytes"
	}
	return ""
}

// emitCall on an aggregate-returning callee (slice, named struct)
// stores X0..X(N-1) into a data region (planFrame's AllocIDs entry)
// rather than a single-word spill, and produces a pointer to the
// region. Without this path, the upper words of a slice return
// were silently dropped — the regression that broke
// 110_cross_pkg_type_alias.
func TestEmitCallAggregateReturnSpillsAllWords() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	// Plant the data region + pointer spill slot common.PlanFrame
	// would create for a managed-slice (32 bytes / 4 words) return.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 32)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 32)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_CALL
	ins.StrVal = "main.dummy"
	ins.Typ = types.MakeManagedSliceType(types.TypInt())
	emitCall(a, "main", m, nilFuncs(), ins, false)
	// Sequence: BL + 4× STR Xi to data region + ADD rd = 24 bytes
	// (no arg-loading because we passed no Args).
	if opsBytes(a) != 24 {
		return "@[]T return should emit BL + 4×STR + ADD (24 bytes)"
	}
	return ""
}

// emitCall must spread aggregate args across multiple consecutive
// arg regs (2 for *[]T, 4 for @[]T), not just mov the pointer into
// one slot. Regressions here break slice-as-function-arg (the +6
// commit) silently by passing the data pointer in X0 and leaving
// X1 untouched.
func TestEmitCallSpreadsRawSliceArgAcrossTwoRegs() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	// Arg 0 is a raw-slice SSA value (16 bytes, pointer in spill).
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var sliceArg @ir.Instr = make(ir.Instr)
	sliceArg.ID = 2
	sliceArg.Op = ir.OP_LOAD
	sliceArg.Typ = types.MakeSliceType(types.TypInt())
	var call @ir.Instr = make(ir.Instr)
	call.ID = -1
	call.Op = ir.OP_CALL
	call.StrVal = "main.dummy"
	call.Typ = types.TypVoid()
	call.Args = make_slice(@ir.Instr, 1)
	call.Args[0] = sliceArg
	emitCall(a, "main", m, nilFuncs(), call, false)
	// Expected sequence: LDR reload ptr (4), 2× LDR X_argi (8), BL (4)
	// = 16 bytes. A regression that used `mov x0, rn` instead of two
	// ldrs would land at 12 bytes.
	if opsBytes(a) != 16 {
		return "raw slice arg should spread to X0+X1 (two LDRs)"
	}
	return ""
}

// emitCall must write overflow aggregate args to the outgoing-args
// area on the stack rather than dropping their tail words in regs.
// This is the fix that unblocked 135_slice_struct_elem_rc — passing
// a 4-word @[]T slice plus a 5-word Entry pushed Entry past X7;
// pre-fix the 5th word silently disappeared.
func TestEmitCallStackOverflowAggregateArg() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	// Arg 0: a 4-word managed-slice (consumes X0..X3).
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 0)
	var sliceArg @ir.Instr = make(ir.Instr)
	sliceArg.ID = 1
	sliceArg.Op = ir.OP_LOAD
	sliceArg.Typ = types.MakeManagedSliceType(types.TypInt())
	// Arg 1: an Entry struct (managed slice + int, 5 words, 40 bytes).
	// Doesn't fit in remaining 4 regs → goes ENTIRELY on stack.
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.MakeManagedSliceType(types.TypInt())
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	var entryTyp @types.Type = types.MakeStructType("Entry", fields)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 2)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 8)
	var entryArg @ir.Instr = make(ir.Instr)
	entryArg.ID = 2
	entryArg.Op = ir.OP_LOAD
	entryArg.Typ = entryTyp
	var call @ir.Instr = make(ir.Instr)
	call.ID = -1
	call.Op = ir.OP_CALL
	call.StrVal = "main.dummy"
	call.Typ = types.TypVoid()
	call.Args = make_slice(@ir.Instr, 2)
	call.Args[0] = sliceArg
	call.Args[1] = entryArg
	emitCall(a, "main", m, nilFuncs(), call, false)
	// Slice path: LDR ptr-reload + 4× LDR (X0..X3) = 5 instrs.
	// Entry stack path: LDR ptr-reload + 5× (LDR + STR) = 11 instrs.
	// BL = 1 instr. Total = 17 instrs = 68 bytes.
	if opsBytes(a) != 68 {
		return "slice + Entry-on-stack call should emit 17 instrs (68 bytes)"
	}
	return ""
}

// emitCall on a callee returning an aggregate > 64 bytes must pass
// the buffer pointer in X8 BEFORE the BL (sret), and skip the X0..X7
// spill afterwards (the callee already wrote through X8). Regression
// guard for the fix that unblocked 252/253.
func TestEmitCallSretSetsX8BeforeBl() testing.TestResult {
	var a @asm.Assembler = opsMkAssembler()
	var m @common.RegMap = make(common.RegMap)
	// 80-byte struct return (10 ints) — > 64 → sret path.
	var fields @[]@types.Field = make_slice(@types.Field, 10)
	for i := 0; i < 10; i++ {
		fields[i] = make(types.Field)
		fields[i].Type = types.TypInt()
	}
	var bigStruct @types.Type = types.MakeStructType("Big", fields)
	m.AllocIDs = common.AppendInt(m.AllocIDs, 1)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 0)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 80)
	m.SpillIDs = common.AppendInt(m.SpillIDs, 1)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 80)
	var ins @ir.Instr = make(ir.Instr)
	ins.ID = 1
	ins.Op = ir.OP_CALL
	ins.StrVal = "main.dummy"
	ins.Typ = bigStruct
	emitCall(a, "main", m, nilFuncs(), ins, false)
	// Expected: ADD X8, SP, #0 (sret pointer) + BL + ADD rd, SP, #0
	// = 3 instrs = 12 bytes. The X0..X7 spill loop is skipped.
	if opsBytes(a) != 12 {
		return "sret call should emit ADD X8 + BL + ADD rd (12 bytes)"
	}
	return ""
}

// invertCondForOp maps IR comparisons to the AArch64 condition codes
// that make `csinc rd,xzr,xzr,<cond>` set rd=1 iff the comparison
// holds. These are the walking-skeleton's truth table; a subtle
// off-by-one or wrong invert flips every boolean in the backend.

func TestInvertCondForOp() testing.TestResult {
	// For x == y, we want rd=1 on equality; csinc with COND_NE does
	// that (cond-true → rn=xzr; cond-false → rm+1=1).
	// Pairs: (ir op) → (expected cond code name)
	// We only check it's NOT the opposite — the exact constants live
	// in pkg/asm/aarch64 and change would break this anyway.
	var eq int = invertCondForOp(ir.OP_EQ)
	var ne int = invertCondForOp(ir.OP_NE)
	if eq == ne { return "OP_EQ and OP_NE should invert to distinct conds" }

	var lt int = invertCondForOp(ir.OP_LT)
	var ge int = invertCondForOp(ir.OP_GE)
	if lt == ge { return "OP_LT and OP_GE should invert to distinct conds" }

	var le int = invertCondForOp(ir.OP_LE)
	var gt int = invertCondForOp(ir.OP_GT)
	if le == gt { return "OP_LE and OP_GT should invert to distinct conds" }
	return ""
}

// Eight Binate integer params go to X0..X7. The PCS is fixed; this
// guards against an accidental re-shuffle breaking every multi-arg
// call and return.
func TestArgRegOrdering() testing.TestResult {
	var last int = -1
	for i := 0; i < 8; i++ {
		var r int = argReg(i)
		if r == last { return "adjacent argReg results should differ" }
		last = r
	}
	return ""
}

// underscorePrefix is tiny but central: every Mach-O symbol we emit
// (function, builtin-call target, etc.) goes through it.
func TestUnderscorePrefix() testing.TestResult {
	var s @[]char = underscorePrefix("bn_print_int")
	if len(s) != 13 { return "wrong length for _bn_print_int" }
	if s[0] != '_' { return "missing underscore" }
	if s[1] != 'b' { return "wrong second byte" }
	return ""
}
