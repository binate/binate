package "pkg/native/arm64"

import "pkg/asm"
import "pkg/asm/aarch64"
import "pkg/ir"
import "pkg/types"

// ============================================================
// Walking-skeleton register map
// ============================================================

// regMap tracks register assignments and the per-function stack
// layout. Under the "spill everything" policy (see planFrame), the
// register table only holds values live within a single instruction;
// the alloc and spill slot tables describe the stable stack frame.
type regMap struct {
	IDs  @[]int    // SSA IDs (index aligns with Regs)
	Regs @[]int    // aarch64.X<N> (parallel to IDs)
	Next int       // index of next free register in regPool

	// Stack-slot map for OP_ALLOC. An alloca's address is stable for
	// the whole function; LOAD/STORE through it references the same
	// frame slot every time.
	AllocIDs     @[]int   // SSA IDs of OP_ALLOC instructions
	AllocOffsets @[]int   // SP-relative offset for each AllocIDs entry
	AllocSizes   @[]int   // byte size of each alloca slot (for zero-init)

	// Spill-slot map: every non-void SSA value is spilled here after
	// computation so a later use can reload via getOperand.
	SpillIDs     @[]int
	SpillOffsets @[]int

	// FrameSize is set by planFrame and returned by frameSizeFromRegMap
	// so epilogue emission stays in sync with prologue. Individual spill
	// slots can be wider than 8 bytes (slice values, multi-return packs),
	// so it's not derivable from len(SpillIDs)*8 alone.
	FrameSize int
}

// lookupAlloc returns the SP-relative offset of an OP_ALLOC value, or
// -1 if id is not an alloca.
func lookupAlloc(m @regMap, id int) int {
	for i := 0; i < len(m.AllocIDs); i++ {
		if m.AllocIDs[i] == id { return m.AllocOffsets[i] }
	}
	return -1
}

// lookupAllocSize returns the byte size of an alloca slot, or -1.
func lookupAllocSize(m @regMap, id int) int {
	for i := 0; i < len(m.AllocIDs); i++ {
		if m.AllocIDs[i] == id { return m.AllocSizes[i] }
	}
	return -1
}

// lookupSpill returns the SP-relative offset of a spilled SSA value,
// or -1 if not spilled.
func lookupSpill(m @regMap, id int) int {
	for i := 0; i < len(m.SpillIDs); i++ {
		if m.SpillIDs[i] == id { return m.SpillOffsets[i] }
	}
	return -1
}

// regPool is the callee-clobbered scratch set we hand out to values.
// X0..X7 are reserved for args/returns; X9..X15 are caller-saved.
func regPool(i int) int {
	if i == 0 { return aarch64.X9  }
	if i == 1 { return aarch64.X10 }
	if i == 2 { return aarch64.X11 }
	if i == 3 { return aarch64.X12 }
	if i == 4 { return aarch64.X13 }
	if i == 5 { return aarch64.X14 }
	return aarch64.X15
}

// scratchReg hands out an ephemeral register (not registered in the
// id→reg map). Used when we need working registers that won't outlive
// the current instruction.
func scratchReg(m @regMap) int {
	var r int = regPool(m.Next)
	m.Next = m.Next + 1
	return r
}

// assignReg records that SSA id = reg and returns reg.
func assignReg(m @regMap, id int, reg int) int {
	m.IDs = appendInt(m.IDs, id)
	m.Regs = appendInt(m.Regs, reg)
	return reg
}

// nextReg allocates the next free register for SSA id.
func nextReg(m @regMap, id int) int {
	var r int = regPool(m.Next)
	m.Next = m.Next + 1
	return assignReg(m, id, r)
}

// lookupReg returns the register holding SSA id, or -1 if not found.
func lookupReg(m @regMap, id int) int {
	for i := 0; i < len(m.IDs); i++ {
		if m.IDs[i] == id { return m.Regs[i] }
	}
	return -1
}

// getOperand returns the register holding SSA id. If the value isn't
// in the current regmap, it's reloaded from the spill slot into a
// fresh scratch register. Returns -1 if neither mapping exists.
func getOperand(a @asm.Assembler, m @regMap, id int) int {
	var r int = lookupReg(m, id)
	if r >= 0 { return r }
	var off int = lookupSpill(m, id)
	if off >= 0 {
		var rd int = nextReg(m, id)
		aarch64.Ldr(a, true, rd, aarch64.MemImm(aarch64.SP, off))
		return rd
	}
	return -1
}

// spillAndReset stores the result of a just-emitted instruction to its
// stack slot (if any) and clears the register map. Called after every
// instruction — the "spill everything" policy means each op loads
// operands, computes, then hands off to memory.
func spillAndReset(a @asm.Assembler, m @regMap, ins @ir.Instr) {
	if ins.ID >= 0 {
		var reg int = lookupReg(m, ins.ID)
		if reg >= 0 {
			var off int = lookupSpill(m, ins.ID)
			if off >= 0 {
				aarch64.Str(a, true, reg, aarch64.MemImm(aarch64.SP, off))
			}
		}
	}
	resetRegs(m)
}

// resetRegs clears the register map (but leaves alloc/spill tables
// intact — those describe the stack frame, not transient state).
func resetRegs(m @regMap) {
	var emptyIDs @[]int
	var emptyRegs @[]int
	m.IDs = emptyIDs
	m.Regs = emptyRegs
	m.Next = 0
}

// appendInt grows an @[]int by one.
func appendInt(s @[]int, v int) @[]int {
	var out @[]int = make_slice(int, len(s)+1)
	for i := 0; i < len(s); i++ {
		out[i] = s[i]
	}
	out[len(s)] = v
	return out
}

// ============================================================
// Frame planning
// ============================================================

// planFrame assigns a stack slot to every function parameter and every
// value-producing SSA instruction (allocas sized by types.SizeOf;
// every other non-void value gets 8 bytes, except multi-return calls
// which reserve N*8 for their packed results). Returns the 16-byte
// aligned frame size.
//
// "Spill everything" rationale: a rotating 7-register pool aliased on
// expressions with more than ~7 live values (e.g. a Rect literal that
// computed 10+ addresses simultaneously all ended up colliding on
// X15). Stack-spilling every value is slow but correct; proper
// register allocation can reclaim later.
func planFrame(m @regMap, f @ir.Func) int {
	var offset int = 0
	// Parameters come first so entry-point register stores can find
	// their slots by ID.
	for pi := 0; pi < len(f.Params); pi++ {
		m.SpillIDs = appendInt(m.SpillIDs, f.Params[pi].ID)
		m.SpillOffsets = appendInt(m.SpillOffsets, offset)
		offset = offset + 8
	}
	for bi := 0; bi < len(f.Blocks); bi++ {
		var b @ir.Block = f.Blocks[bi]
		for ii := 0; ii < len(b.Instrs); ii++ {
			var ins @ir.Instr = b.Instrs[ii]
			if ins.Op == ir.OP_ALLOC {
				var sz int = 8
				if ins.TypeArg != nil { sz = types.SizeOf(ins.TypeArg) }
				if sz < 8 { sz = 8 }
				if sz % 8 != 0 { sz = sz + (8 - sz % 8) }
				m.AllocIDs = appendInt(m.AllocIDs, ins.ID)
				m.AllocSizes = appendInt(m.AllocSizes, sz)
				m.AllocOffsets = appendInt(m.AllocOffsets, offset)
				offset = offset + sz
			} else if ins.ID >= 0 && !instrIsVoid(ins) {
				// OP_MAKE_SLICE gets a dedicated data region (where
				// bn_rt__MakeManagedSlice writes its 32 bytes via X8);
				// the spill slot itself then holds a *pointer* to
				// that region, matching OP_LOAD's aggregate form so
				// downstream OP_EXTRACT / OP_STORE can treat them
				// uniformly.
				if ins.Op == ir.OP_MAKE_SLICE && ins.Typ != nil {
					var dataSz int = types.SizeOf(ins.Typ)
					if dataSz > 0 {
						m.AllocIDs = appendInt(m.AllocIDs, ins.ID)
						m.AllocSizes = appendInt(m.AllocSizes, dataSz)
						m.AllocOffsets = appendInt(m.AllocOffsets, offset)
						offset = offset + dataSz
					}
				}
				m.SpillIDs = appendInt(m.SpillIDs, ins.ID)
				m.SpillOffsets = appendInt(m.SpillOffsets, offset)
				// Multi-return calls reserve N*8 contiguous bytes so
				// X0..X(N-1) can land at slot + 8*i; OP_EXTRACT later
				// reads the i-th word.
				var slotSz int = 8
				if (ins.Op == ir.OP_CALL || ins.Op == ir.OP_CALL_BUILTIN) &&
					ins.Typ != nil && ins.Typ.Kind == types.TYP_STRUCT {
					slotSz = 8 * len(ins.Typ.Fields)
					if slotSz < 8 { slotSz = 8 }
				}
				offset = offset + slotSz
			}
		}
	}
	var size int = offset
	if size % 16 != 0 {
		size = size + (16 - size % 16)
	}
	m.FrameSize = size
	return size
}

// frameSizeFromRegMap returns the frame size computed by planFrame.
// Spill slots aren't uniformly 8 bytes (slices are 16/32, multi-return
// packs are N*8), so this reads the cached value rather than summing.
func frameSizeFromRegMap(m @regMap) int { return m.FrameSize }

// ============================================================
// Type predicates
// ============================================================

// instrIsVoid reports whether an instruction produces no SSA value.
func instrIsVoid(ins @ir.Instr) bool {
	if ins.ID < 0 { return true }
	if ins.Typ == nil { return true }
	return ins.Typ.Kind == types.TYP_VOID
}

// callReturnsVoid reports whether an OP_CALL/OP_CALL_BUILTIN has no
// result (e.g. bn_print_int, bootstrap.Exit).
func callReturnsVoid(ins @ir.Instr) bool {
	if ins.Typ == nil { return true }
	return ins.Typ.Kind == types.TYP_VOID
}

// isAggregateTyp reports whether a type is a struct, array, or slice —
// i.e., not an in-register value. OP_LOAD passes a pointer through
// rather than materializing the bytes; OP_STORE does a memcpy.
func isAggregateTyp(t @types.Type) bool {
	if t == nil { return false }
	return t.Kind == types.TYP_STRUCT ||
		t.Kind == types.TYP_ARRAY ||
		t.Kind == types.TYP_MANAGED_SLICE ||
		t.Kind == types.TYP_SLICE
}

// elemSizeOf returns the element byte size for an OP_GET_ELEM_PTR
// instruction. The GEP's own result type is `*elemTyp` (set by
// ir.EmitGetElemPtr), which covers both array indexing and slice
// indexing (where the base pointer has already been extracted to a raw
// i8* and the element type lives only on the GEP itself).
func elemSizeOf(gep @ir.Instr) int {
	if gep == nil || gep.Typ == nil || gep.Typ.Elem == nil { return 0 }
	return types.SizeOf(gep.Typ.Elem)
}

// structTypeOf returns the struct type underlying a pointer-valued
// instruction, or nil if not a struct pointer.
func structTypeOf(ins @ir.Instr) @types.Type {
	if ins == nil { return nil }
	if ins.TypeArg != nil && ins.TypeArg.Kind == types.TYP_STRUCT {
		return ins.TypeArg
	}
	if ins.Typ != nil && ins.Typ.Elem != nil {
		if ins.Typ.Elem.Kind == types.TYP_STRUCT { return ins.Typ.Elem }
	}
	return nil
}
