package "pkg/native/arm64"

import "pkg/asm"
import "pkg/builtin/testing"
import "pkg/native/common"

// Tests for the arm64-specific register allocation helpers. The
// arch-agnostic regmap / frame / predicate logic is tested in
// pkg/native/common/common_test.bn; the aarch64.Ldr/Str paths
// (getOperand, spillAndReset) get end-to-end coverage from
// arm64_test.bn's EmitObject round-trips.

func nrm() @common.RegMap { return make(common.RegMap) }

func mkAssembler() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)
	return a
}

func TestNextRegAdvancesPool() testing.TestResult {
	var m @common.RegMap = nrm()
	var a int = nextReg(m, 1)
	var b int = nextReg(m, 2)
	if a == b { return "nextReg should hand out distinct regs" }
	if common.LookupReg(m, 1) != a { return "id 1 should map to first reg" }
	if common.LookupReg(m, 2) != b { return "id 2 should map to second reg" }
	return ""
}

// regPool hands out X9..X15 (7 entries); scratchReg also advances
// m.Next past those, even though it doesn't register in the id table.
func TestScratchRegAdvancesNext() testing.TestResult {
	var m @common.RegMap = nrm()
	var r0 int = scratchReg(m)
	var r1 int = scratchReg(m)
	if r0 == r1 { return "scratchReg should return distinct regs early on" }
	if m.Next != 2 { return "m.Next should advance with each scratch" }
	return ""
}

// getOperand on an alloca ID must materialize its address with
// `add rd, sp, #off` — the IR uses OP_ALLOC's own SSA value as the
// `&x` expression, so a regression here silently breaks any code
// that takes the address of a local or stores a struct through a
// variable. This was the +30-conformance-test fix; guard it.
func TestGetOperandMaterializesAllocaPointer() testing.TestResult {
	var a @asm.Assembler = mkAssembler()
	var m @common.RegMap = nrm()
	// Plant an alloca at SP-relative offset 8.
	m.AllocIDs = common.AppendInt(m.AllocIDs, 17)
	m.AllocOffsets = common.AppendInt(m.AllocOffsets, 8)
	m.AllocSizes = common.AppendInt(m.AllocSizes, 8)
	var r int = getOperand(a, m, 17)
	if r < 0 { return "getOperand on an alloca should not return -1" }
	// Expect a single ADD rd, SP, #8 = 4 bytes.
	if a.Sections[0].Len != 4 {
		return "alloca path should emit exactly one ADD"
	}
	// Subsequent calls for the same id should reuse the register
	// (common.LookupReg hit), so no new bytes are emitted.
	var r2 int = getOperand(a, m, 17)
	if r2 != r { return "second getOperand should return the same reg" }
	if a.Sections[0].Len != 4 {
		return "reuse of a live alloca reg must not emit"
	}
	return ""
}

// getOperand on an ID that's neither in the reg table, the alloc
// table, nor the spill table returns -1. Used as a bail-out by the
// emit handlers when an arg's provenance is unknown.
func TestGetOperandReturnsMinusOneForUnknownID() testing.TestResult {
	var a @asm.Assembler = mkAssembler()
	var m @common.RegMap = nrm()
	if getOperand(a, m, 42) != -1 {
		return "unknown id should return -1"
	}
	if a.Sections[0].Len != 0 {
		return "miss path shouldn't emit anything"
	}
	return ""
}

// getOperand on a spill-slot ID emits a single LDR to reload.
func TestGetOperandReloadsFromSpillSlot() testing.TestResult {
	var a @asm.Assembler = mkAssembler()
	var m @common.RegMap = nrm()
	m.SpillIDs = common.AppendInt(m.SpillIDs, 9)
	m.SpillOffsets = common.AppendInt(m.SpillOffsets, 16)
	var r int = getOperand(a, m, 9)
	if r < 0 { return "spill lookup should succeed" }
	if a.Sections[0].Len != 4 {
		return "spill reload should emit exactly one LDR"
	}
	return ""
}
