package "pkg/native/arm64"

import "pkg/ir"
import "pkg/types"
import "pkg/builtin/testing"

// End-to-end coverage of the regmap code paths (planFrame, getOperand,
// spillAndReset) is exercised by arm64_test.bn's full EmitObject
// round-trips; these tests verify the small pure helpers in isolation.

// nrm returns a freshly-constructed regmap.
func nrm() @regMap { return make(regMap) }

func TestLookupsReturnMinusOneOnMiss() testing.TestResult {
	var m @regMap = nrm()
	if lookupAlloc(m, 7) != -1 { return "lookupAlloc miss should be -1" }
	if lookupAllocSize(m, 7) != -1 { return "lookupAllocSize miss should be -1" }
	if lookupSpill(m, 7) != -1 { return "lookupSpill miss should be -1" }
	if lookupReg(m, 7) != -1 { return "lookupReg miss should be -1" }
	return ""
}

func TestAssignAndLookupReg() testing.TestResult {
	var m @regMap = nrm()
	assignReg(m, 3, 42)
	if lookupReg(m, 3) != 42 { return "expected 42 after assign" }
	if lookupReg(m, 99) != -1 { return "expected -1 for unknown id" }
	return ""
}

func TestNextRegAdvancesPool() testing.TestResult {
	var m @regMap = nrm()
	var a int = nextReg(m, 1)
	var b int = nextReg(m, 2)
	if a == b { return "nextReg should hand out distinct regs" }
	if lookupReg(m, 1) != a { return "id 1 should map to first reg" }
	if lookupReg(m, 2) != b { return "id 2 should map to second reg" }
	return ""
}

func TestResetClearsRegsButKeepsSlots() testing.TestResult {
	var m @regMap = nrm()
	m.AllocIDs = appendInt(m.AllocIDs, 5)
	m.AllocOffsets = appendInt(m.AllocOffsets, 32)
	m.AllocSizes = appendInt(m.AllocSizes, 8)
	m.SpillIDs = appendInt(m.SpillIDs, 6)
	m.SpillOffsets = appendInt(m.SpillOffsets, 40)
	assignReg(m, 7, 11)
	resetRegs(m)
	if lookupReg(m, 7) != -1 { return "regs should be cleared" }
	if lookupAlloc(m, 5) != 32 { return "alloc slot should survive" }
	if lookupSpill(m, 6) != 40 { return "spill slot should survive" }
	return ""
}

func TestInstrIsVoid() testing.TestResult {
	var vf @ir.Instr = make(ir.Instr)
	vf.ID = -1
	if !instrIsVoid(vf) { return "id=-1 should be void" }

	var noTyp @ir.Instr = make(ir.Instr)
	noTyp.ID = 3
	if !instrIsVoid(noTyp) { return "nil Typ should be void" }

	var notVoid @ir.Instr = make(ir.Instr)
	notVoid.ID = 4
	notVoid.Typ = types.TypInt()
	if instrIsVoid(notVoid) { return "int-typed should not be void" }
	return ""
}

func TestIsAggregateTyp() testing.TestResult {
	if isAggregateTyp(nil) { return "nil should not be aggregate" }
	if isAggregateTyp(types.TypInt()) { return "int is not aggregate" }
	var arr @types.Type = types.MakeArrayType(types.TypInt(), 4)
	if !isAggregateTyp(arr) { return "array should be aggregate" }
	return ""
}

func TestFrameSizeZero() testing.TestResult {
	var m @regMap = nrm()
	if frameSizeFromRegMap(m) != 0 {
		return "empty regmap should yield frame size 0"
	}
	return ""
}

func TestFrameSizeAlignedTo16() testing.TestResult {
	var m @regMap = nrm()
	// One 8-byte spill slot → 8 → round to 16.
	m.SpillIDs = appendInt(m.SpillIDs, 1)
	m.SpillOffsets = appendInt(m.SpillOffsets, 0)
	if frameSizeFromRegMap(m) != 16 {
		return "single 8-byte spill should round up to 16"
	}
	// Two 8-byte spill slots → exactly 16.
	m.SpillIDs = appendInt(m.SpillIDs, 2)
	m.SpillOffsets = appendInt(m.SpillOffsets, 8)
	if frameSizeFromRegMap(m) != 16 {
		return "two 8-byte spills should be exactly 16"
	}
	return ""
}
