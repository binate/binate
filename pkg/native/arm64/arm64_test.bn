package "pkg/native/arm64"

import "pkg/bootstrap"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/types"

// --- Module-level empties (pattern from pkg/ir/ir_test.bn). ---
var noParams @[]@ir.Param
var noResults @[]@types.Type
var noArgs @[]@ir.Instr

// --- Helpers ---

func fail(msg *[]const char) testing.TestResult {
	var r @[]char = buf.CopyStr(msg)
	return r
}

func charEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// canLinkAndRun — proxy for "macOS host" (otool is macOS-only).
func canLinkAndRun() bool {
	var args @[]@[]char = make_slice(@[]char, 1)
	args[0] = bootstrap.Concat("--version", "")
	return bootstrap.Exec("otool", args) == 0
}

// --- symFor ---

func TestSymForMainPkg() testing.TestResult {
	var s @[]char = symFor("main", "main")
	if !charEq(s, "_bn_main") { return fail("expected _bn_main") }
	return ""
}

func TestSymForNonMainPkg() testing.TestResult {
	var s @[]char = symFor("parser", "parseExpr")
	if !charEq(s, "_bn_parser__parseExpr") {
		return fail("expected _bn_parser__parseExpr")
	}
	return ""
}

// --- EmitObject end-to-end ---

// Build a module with just main { return } and check EmitObject writes a
// Mach-O object.  Skipped off-macOS.
func TestEmitEmptyMainObject() testing.TestResult {
	if !canLinkAndRun() { return "" }

	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func = ir.NewFunc("main", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	ir.EmitReturn(b, noArgs)
	ir.AddFunc(m, f)

	var path *[]const char = "/tmp/binate_native_empty_main.o"
	var ok bool = EmitObject(m, path)
	if !ok { return fail("EmitObject returned false") }
	if bootstrap.Stat(path) != 1 { return fail("no .o file written") }

	// Disassemble with otool -tv; the test passes if otool accepts the file.
	var args @[]@[]char = make_slice(@[]char, 2)
	args[0] = bootstrap.Concat("-tv", "")
	args[1] = bootstrap.Concat(path, "")
	if bootstrap.Exec("otool", args) != 0 {
		return fail("otool -tv rejected the .o file")
	}
	return ""
}

// Check the full link+run path: clang links our .o with the C runtime and
// the result exits 0.
func TestEmitEmptyMainLinksAndRuns() testing.TestResult {
	if !canLinkAndRun() { return "" }

	var rt @[]char = findRuntimePath()
	if len(rt) == 0 { return "" } // no runtime to link against — skip

	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func = ir.NewFunc("main", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")
	ir.EmitReturn(b, noArgs)
	ir.AddFunc(m, f)

	var objPath *[]const char = "/tmp/binate_native_link_empty.o"
	if !EmitObject(m, objPath) { return fail("EmitObject returned false") }

	var exePath *[]const char = "/tmp/binate_native_link_empty"
	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = bootstrap.Concat("-w", "")
	args[1] = bootstrap.Concat("-o", "")
	args[2] = bootstrap.Concat(exePath, "")
	args[3] = bootstrap.Concat(objPath, "")
	args[4] = bootstrap.Concat(rt, "")
	if bootstrap.Exec("clang", args) != 0 {
		return fail("clang link failed")
	}

	var runArgs @[]@[]char = make_slice(@[]char, 0)
	if bootstrap.Exec(exePath, runArgs) != 0 {
		return fail("binary exited non-zero")
	}
	return ""
}

// Build a program equivalent to `bootstrap.Exit(42)` and verify it
// links with the C runtime and that the resulting process exits 42.
// Exercises OP_CONST_INT + OP_CALL + prologue/epilogue.
func TestEmitCallExitsWithCode() testing.TestResult {
	if !canLinkAndRun() { return "" }

	var rt @[]char = findRuntimePath()
	if len(rt) == 0 { return "" }

	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func = ir.NewFunc("main", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")

	// v0 = 42 : int
	var c42 @ir.Instr = ir.EmitConstInt(f, b, 42, types.TypInt())
	// call bootstrap.Exit(v0) — void return
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = c42
	ir.EmitCall(f, b, "bootstrap.Exit", args, types.TypVoid())
	ir.EmitReturn(b, noArgs)
	ir.AddFunc(m, f)

	var objPath *[]const char = "/tmp/binate_native_exit42.o"
	if !EmitObject(m, objPath) { return fail("EmitObject returned false") }

	var exePath *[]const char = "/tmp/binate_native_exit42"
	var largs @[]@[]char = make_slice(@[]char, 5)
	largs[0] = bootstrap.Concat("-w", "")
	largs[1] = bootstrap.Concat("-o", "")
	largs[2] = bootstrap.Concat(exePath, "")
	largs[3] = bootstrap.Concat(objPath, "")
	largs[4] = bootstrap.Concat(rt, "")
	if bootstrap.Exec("clang", largs) != 0 {
		return fail("clang link failed")
	}

	var runArgs @[]@[]char = make_slice(@[]char, 0)
	var rc int = bootstrap.Exec(exePath, runArgs)
	if rc != 42 {
		return fail("expected exit 42")
	}
	return ""
}

// Build a program equivalent to `println(7)` (via OP_CALL_BUILTIN to
// bn_print_int + bn_print_newline) and verify the linked binary
// prints "7\n".  Exercises OP_CALL_BUILTIN.
func TestEmitCallBuiltinPrintsInt() testing.TestResult {
	if !canLinkAndRun() { return "" }

	var rt @[]char = findRuntimePath()
	if len(rt) == 0 { return "" }

	var m @ir.Module = ir.NewModule("\"main\"")
	var f @ir.Func = ir.NewFunc("main", noParams, noResults)
	var b @ir.Block = ir.AddBlock(f, "entry")

	var c7 @ir.Instr = ir.EmitConstInt(f, b, 7, types.TypInt())
	var args @[]@ir.Instr = make_slice(@ir.Instr, 1)
	args[0] = c7
	ir.EmitCallBuiltin(f, b, "bn_print_int", args, types.TypVoid())
	var noArgsLocal @[]@ir.Instr
	ir.EmitCallBuiltin(f, b, "bn_print_newline", noArgsLocal, types.TypVoid())
	ir.EmitReturn(b, noArgs)
	ir.AddFunc(m, f)

	var objPath *[]const char = "/tmp/binate_native_println7.o"
	if !EmitObject(m, objPath) { return fail("EmitObject returned false") }

	var exePath *[]const char = "/tmp/binate_native_println7"
	var largs @[]@[]char = make_slice(@[]char, 5)
	largs[0] = bootstrap.Concat("-w", "")
	largs[1] = bootstrap.Concat("-o", "")
	largs[2] = bootstrap.Concat(exePath, "")
	largs[3] = bootstrap.Concat(objPath, "")
	largs[4] = bootstrap.Concat(rt, "")
	if bootstrap.Exec("clang", largs) != 0 { return fail("clang link failed") }

	// Run and capture stdout via `sh -c "exe > tmpout"`.
	var stdoutPath *[]const char = "/tmp/binate_native_println7.out"
	var runArgs @[]@[]char = make_slice(@[]char, 2)
	runArgs[0] = bootstrap.Concat("-c", "")
	runArgs[1] = bootstrap.Concat(bootstrap.Concat(exePath, " > "), stdoutPath)
	if bootstrap.Exec("sh", runArgs) != 0 { return fail("binary exited non-zero") }

	// Read stdout and compare to "7\n" (3 bytes).
	var fd int = bootstrap.Open(stdoutPath, bootstrap.O_RDONLY)
	if fd < 0 { return fail("could not open stdout capture") }
	var bufr @[]uint8 = make_slice(uint8, 16)
	var n int = bootstrap.Read(fd, bufr)
	bootstrap.Close(fd)
	if n != 2 { return fail("stdout wrong length") }
	if bufr[0] != cast(uint8, '7') { return fail("first byte != '7'") }
	if bufr[1] != cast(uint8, '\n') { return fail("second byte != newline") }
	return ""
}

// findRuntimePath probes the known worktree layouts. Returns empty slice
// if none of the candidates exists.
func findRuntimePath() @[]char {
	var c @[]@[]char = make_slice(@[]char, 3)
	c[0] = bootstrap.Concat("/Users/vtl/binate/temp-binate-3/runtime/binate_runtime.c", "")
	c[1] = bootstrap.Concat("/Users/vtl/binate/binate/runtime/binate_runtime.c", "")
	c[2] = bootstrap.Concat("../../runtime/binate_runtime.c", "")
	for i := 0; i < len(c); i++ {
		if bootstrap.Stat(c[i]) == 1 { return c[i] }
	}
	var empty @[]char
	return empty
}
