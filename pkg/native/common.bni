// Package common holds the arch-agnostic pieces of the native backend:
// the per-function register map + stack layout, frame planning, the
// type predicates that classify SSA values into the lowering strategies
// every arch needs, and the CallConv descriptor that parameterises the
// arg-passing / return-classification helpers.
//
// Each pkg/native/<arch>/ package consumes this alongside the
// arch-specific register pool, scratch-register allocator, and
// instruction emission helpers.
package "pkg/native/common"

import "pkg/ir"
import "pkg/types"

// CallConv describes a target calling convention. Each backend
// constructs its CallConv once (via AAPCS64() / SysV_AMD64()) and
// stamps it onto the per-function RegMap, so the parameterised
// helpers can be read via rm.CC.X(...).
type CallConv struct {
	NumGpArgRegs       int
	NumFpArgRegs       int
	InternalSretBytes  int
	CExternSretBytes   int
	AggregateInRegMax  int
	StackAlign         int
	SplitAggregates    bool
	// VariadicStackOnly forces variadic args (those at index >=
	// fixedCount in the V-variant helpers below) entirely to the
	// stack regardless of GP-register budget.  Set on darwin-arm64
	// to match Apple's ARM64 calling convention.
	VariadicStackOnly  bool
}

// AAPCS64 returns the AArch64 Procedure Call Standard CallConv
// (Linux variant — varargs follow the normal register/stack rule).
func AAPCS64() CallConv
// AAPCS64_Darwin returns AAPCS64 with VariadicStackOnly = true: on
// Apple's ARM64 ABI, every variadic argument is passed on the stack.
func AAPCS64_Darwin() CallConv
// SysV_AMD64 returns the System V x86-64 CallConv (Linux / macOS / BSD).
func SysV_AMD64() CallConv

// RegMap tracks live register assignments and the per-function stack
// layout. The same structure works across architectures: individual
// Regs entries are arch-specific register numbers, but the algorithms
// below — lookup, frame planning, slot assignment — don't care. Per-
// arch emitters consume RegMap through the lookups and through
// their own nextReg / scratchReg / getOperand helpers.
type RegMap struct {
	IDs  @[]int
	Regs @[]int
	Next int

	AllocIDs     @[]int
	AllocOffsets @[]int
	AllocSizes   @[]int

	SpillIDs     @[]int
	SpillOffsets @[]int

	FrameSize int
	OutgoingArgsSize int
	SretSlotOff int
	MultiReturnType @types.Type

	// CC is the target calling convention. Set by the backend before
	// PlanFrame; consumed by every helper that's CallConv-parameterised.
	CC CallConv
}

// Lookups. Return -1 on miss.
func (m @RegMap) LookupAlloc(id int) int
func (m @RegMap) LookupAllocSize(id int) int
func (m @RegMap) LookupSpill(id int) int
func (m @RegMap) LookupReg(id int) int

// AssignReg records that SSA id = reg (the arch-specific register
// number). Returns reg. ResetRegs clears the live-register table but
// preserves the stable stack-frame tables.
func (m @RegMap) AssignReg(id int, reg int) int
func (m @RegMap) ResetRegs()

// NewRegMap returns a freshly-constructed RegMap with cc pre-stamped.
// The preferred constructor — backends should never `make(RegMap)`
// directly, since that would leave m.CC zero-valued.
func NewRegMap(cc CallConv) @RegMap

// AppendInt is exposed because per-arch code sometimes grows its own
// tables (e.g. recording param data regions in the prologue).
func AppendInt(s @[]int, v int) @[]int

// PlanFrame sizes and lays out the frame for f, filling in m. The
// returned size is 16-byte aligned; it's also cached on m.FrameSize
// (use m.FrameSize() in the epilogue). Requires m.CC to be set.
func (m @RegMap) PlanFrame(f @ir.Func) int
func (m @RegMap) FrameSize() int

// Type / value predicates used by the lowering rules.
func InstrIsVoid(ins @ir.Instr) bool
func CallReturnsVoid(ins @ir.Instr) bool
func IsAggregateTyp(t @types.Type) bool
func IsFloatScalarTyp(t @types.Type) bool
func IsMultiReturnCall(ins @ir.Instr) bool
func SpillHoldsAggregatePointer(ins @ir.Instr) bool
func ElemSizeOf(gep @ir.Instr) int
func StructTypeOf(ins @ir.Instr) @types.Type

// Word size of an argument (8 bytes per word on every current backend).
// CallConv-independent; lives in common_call.bn alongside the other
// non-parameterised helpers.
func ArgWords(t @types.Type) int

// Per-CallConv call-arg dispatch + return classification. See
// common_callconv.bn for the AAPCS-style algorithm; SysV-AMD64
// aggregate dispatch will diverge and lives in pkg/native/x64.
func (cc CallConv) CallArgRegStart(argTypes @[]@types.Type, i int) int
func (cc CallConv) CallArgStackOff(argTypes @[]@types.Type, i int) int
func (cc CallConv) CallStackBytes(argTypes @[]@types.Type) int

// V-variants take a fixedCount marking the variadic boundary.  With
// VariadicStackOnly set (AAPCS64_Darwin), args at index >= fixedCount
// are forced to the stack regardless of remaining GP-register budget.
// Non-variadic callers pass fixedCount = len(argTypes) for identical
// behavior to the non-V originals.
func (cc CallConv) CallArgRegStartV(argTypes @[]@types.Type, i int, fixedCount int) int
func (cc CallConv) CallArgStackOffV(argTypes @[]@types.Type, i int, fixedCount int) int
func (cc CallConv) CallStackBytesV(argTypes @[]@types.Type, fixedCount int) int

func (cc CallConv) FuncReturnsBigAggregate(f @ir.Func) bool
func (cc CallConv) CallReturnsBigAggregate(ins @ir.Instr) bool
func (cc CallConv) FuncReturnsBigMultiReturn(f @ir.Func) bool
func (cc CallConv) CallReturnsBigMultiReturn(ins @ir.Instr) bool
func (cc CallConv) CalleeUsesCSret(funcs @[]@ir.Func, ins @ir.Instr) bool

// Char-slice concat helpers shared across the native arches' iface
// code, which threads raw `@[]char` buffers (rather than CharBuf)
// while building mangled symbol names.
func AppendStr(dst @[]char, src *[]const char) @[]char
func AppendPkgIdent(b @[]char, pkg *[]const char) @[]char

// ParseFloatLitToBits converts an unsigned decimal float-literal text
// (the IR strips any leading '-' into OP_NEG) to its IEEE 754 double-
// precision bit pattern.  Implemented in pure integer arithmetic so
// every native backend lowers the same literal to the same bits.
// Sign is the caller's responsibility — the IR has already emitted
// OP_NEG above this for negative literals.
func ParseFloatLitToBits(text *[]const char) uint64
