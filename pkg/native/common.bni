// Package common holds the arch-agnostic pieces of the native backend:
// the per-function register map + stack layout, frame planning, and
// the type predicates that classify SSA values into the lowering
// strategies both arches need (scalar vs. aggregate, direct-in-spill
// vs. pointer-in-spill, etc.).
//
// Each pkg/native/<arch>/ package consumes this alongside the
// arch-specific register pool, scratch-register allocator, and
// instruction emission helpers.
package "pkg/native/common"

import "pkg/ir"
import "pkg/types"

// RegMap holds the per-function register and stack-frame layout used by
// the native backend. The (IDs, Regs) parallel arrays track the live
// SSA-id -> register assignment (cleared between blocks via ResetRegs).
// The Alloc* and Spill* parallel arrays record the stable stack frame:
// alloca slots and spill slots laid out by PlanFrame and consumed by
// the prologue/epilogue. FrameSize is the 16-byte-aligned total frame
// size; OutgoingArgsSize reserves room for stack-passed call args; and
// SretSlotOff is the offset of the AAPCS sret pointer slot when the
// callee returns a > 16-byte aggregate via X8.
type RegMap struct {
	IDs  @[]int
	Regs @[]int
	Next int

	AllocIDs     @[]int
	AllocOffsets @[]int
	AllocSizes   @[]int

	SpillIDs     @[]int
	SpillOffsets @[]int

	FrameSize int
	OutgoingArgsSize int
	SretSlotOff int
	MultiReturnType @types.Type
}

// Lookups. Return -1 on miss.
func (m @RegMap) LookupAlloc(id int) int
// LookupAlloc is the free-function shim for @RegMap.LookupAlloc.
func LookupAlloc(m @RegMap, id int) int
func (m @RegMap) LookupAllocSize(id int) int
// LookupAllocSize is the free-function shim for @RegMap.LookupAllocSize.
func LookupAllocSize(m @RegMap, id int) int
func (m @RegMap) LookupSpill(id int) int
// LookupSpill is the free-function shim for @RegMap.LookupSpill.
func LookupSpill(m @RegMap, id int) int
func (m @RegMap) LookupReg(id int) int
// LookupReg is the free-function shim for @RegMap.LookupReg.
func LookupReg(m @RegMap, id int) int

// AssignReg records that SSA id = reg (the arch-specific register
// number). Returns reg. ResetRegs clears the live-register table but
// preserves the stable stack-frame tables.
func (m @RegMap) AssignReg(id int, reg int) int
// AssignReg is the free-function shim for @RegMap.AssignReg.
func AssignReg(m @RegMap, id int, reg int) int
func (m @RegMap) ResetRegs()
// ResetRegs is the free-function shim for @RegMap.ResetRegs.
func ResetRegs(m @RegMap)

// AppendInt is exposed because per-arch code sometimes grows its own
// tables (e.g. recording param data regions in the prologue).
func AppendInt(s @[]int, v int) @[]int

// PlanFrame sizes and lays out the frame for f, filling in m. The
// returned size is 16-byte aligned; it's also cached on m.FrameSize
// (use FrameSize(m) in the epilogue).
func (m @RegMap) PlanFrame(f @ir.Func) int
// PlanFrame is the free-function shim for @RegMap.PlanFrame.
func PlanFrame(m @RegMap, f @ir.Func) int
func (m @RegMap) FrameSize() int
// FrameSize is the free-function shim for @RegMap.FrameSize.
func FrameSize(m @RegMap) int

// Type / value predicates used by the lowering rules.
func InstrIsVoid(ins @ir.Instr) bool
func CallReturnsVoid(ins @ir.Instr) bool
func IsAggregateTyp(t @types.Type) bool
func IsFloatScalarTyp(t @types.Type) bool
func IsMultiReturnCall(ins @ir.Instr) bool
func SpillHoldsAggregatePointer(ins @ir.Instr) bool
func ElemSizeOf(gep @ir.Instr) int
func StructTypeOf(ins @ir.Instr) @types.Type

// AAPCS-style call argument dispatch.
func ArgWords(t @types.Type) int
func CallArgRegStart(argTypes @[]@types.Type, i int) int
func CallArgStackOff(argTypes @[]@types.Type, i int) int
func CallStackBytes(argTypes @[]@types.Type) int

// AAPCS-style return: X8 sret indirection for aggregates > 64 bytes.
func FuncReturnsBigAggregate(f @ir.Func) bool
func CallReturnsBigAggregate(ins @ir.Instr) bool
// Multi-return tuples > 64 bytes also need sret — without it, the
// X0..X7 packing path silently drops bytes past word 8.
func FuncReturnsBigMultiReturn(f @ir.Func) bool
func CallReturnsBigMultiReturn(ins @ir.Instr) bool
// C-extern AAPCS sret: required by interop with bootstrap.* (and any
// other IsCExtern callee returning > 16 bytes).
func CalleeUsesCSret(funcs @[]@ir.Func, ins @ir.Instr) bool
