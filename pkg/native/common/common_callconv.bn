package "pkg/native/common"

import "pkg/ir"
import "pkg/types"

// ============================================================
// CallConv — per-target calling convention descriptor
// ============================================================
//
// CallConv parameterises the arg-passing / return-classification
// helpers below so the same algorithms serve multiple backends.
// Each backend constructs its CallConv once and stamps it onto the
// per-function RegMap, so call-site code reads it via rm.CC.X(...).
//
// The numeric thresholds and register-count fields match the values
// historically hardcoded for AAPCS64; the AAPCS64() constructor
// reproduces them so the arm64 backend's behaviour is unchanged.
type CallConv struct {
	// NumGpArgRegs is the count of general-purpose argument registers
	// (X0..X7 on AAPCS64 → 8; RDI/RSI/RDX/RCX/R8/R9 on SysV-AMD64 → 6).
	// Aggregates and scalars compete for the same pool except where
	// IsFloatScalarTyp pulls a value into the FP register file.
	NumGpArgRegs int

	// NumFpArgRegs is the count of FP/SIMD argument registers
	// (D0..D7 on AAPCS64; XMM0..XMM7 on SysV-AMD64). Currently both
	// targets cap at 8.
	NumFpArgRegs int

	// InternalSretBytes is the size threshold above which a Binate-
	// internal aggregate or multi-return tuple is returned via the
	// AAPCS-style sret indirection (X8 on AAPCS64, hidden first arg on
	// SysV) rather than packed into return registers. > N → sret.
	InternalSretBytes int

	// CExternSretBytes is the same threshold for C-extern callees.
	// On AAPCS-C and SysV-AMD64 the threshold is 16: aggregates above
	// 16 bytes go through a hidden return-buffer pointer.
	CExternSretBytes int

	// AggregateInRegMax is the largest aggregate (in bytes) that may
	// be passed in registers. AAPCS64 spreads any aggregate across
	// NumGpArgRegs*8 bytes; SysV-AMD64 caps at 16 bytes per aggregate
	// (above that → memory). Used by the aggregate-arg classifier.
	AggregateInRegMax int

	// StackAlign is the required alignment of the stack pointer at a
	// call boundary. 16 for both AAPCS64 and SysV-AMD64.
	StackAlign int
}

// AAPCS64 returns the CallConv for the AArch64 Procedure Call Standard,
// matching the constants the arm64 backend has historically hardcoded.
func AAPCS64() CallConv {
	var cc CallConv
	cc.NumGpArgRegs = 8
	cc.NumFpArgRegs = 8
	cc.InternalSretBytes = 64
	cc.CExternSretBytes = 16
	cc.AggregateInRegMax = 64
	cc.StackAlign = 16
	return cc
}

// SysV_AMD64 returns the CallConv for the System V x86-64 ABI used by
// Linux, macOS, and the BSDs. Defined here so a sibling pkg/native/x64
// backend can construct it without re-declaring the convention.
func SysV_AMD64() CallConv {
	var cc CallConv
	cc.NumGpArgRegs = 6
	cc.NumFpArgRegs = 8
	cc.InternalSretBytes = 16
	cc.CExternSretBytes = 16
	cc.AggregateInRegMax = 16
	cc.StackAlign = 16
	return cc
}

// ============================================================
// Call argument dispatch (parameterised by CallConv)
// ============================================================
//
// AAPCS64-style argument dispatch generalised by NumGpArgRegs:
// - NGRN starts at 0.
// - For a scalar arg: if NGRN < NumGpArgRegs → reg, NGRN += 1.
//                     else → 8-byte stack slot.
// - For an aggregate of N words: if NGRN + N ≤ NumGpArgRegs → spread
//   across NGRN..NGRN+N-1; otherwise place the in-reg-eligible words
//   in NGRN..NumGpArgRegs-1 and the remainder on the stack (SPLIT).
//
// The SPLIT case matters because LLVM byval lowering also splits, and
// native callers of LLVM-compiled callees must match (conformance 337).
// SysV-AMD64 differs in aggregate handling (classification-based,
// AggregateInRegMax = 16 → otherwise memory); the SysV backend will
// implement aggregate dispatch separately. The helpers below cover the
// scalar / "spread" shape that both backends share for scalars.

// CallArgRegStart returns the first arg-reg index (0..NumGpArgRegs-1)
// for arg i, or -1 if it's passed entirely on the stack. Float scalars
// don't consume GP-register budget and return -1; callers should
// detect floats via IsFloatScalarTyp first and place them in the FP
// register file (tracked separately with an NSRN counter).
func (cc CallConv) CallArgRegStart(argTypes @[]@types.Type, i int) int {
	var ngrn int = 0
	for k := 0; k <= i; k++ {
		if IsFloatScalarTyp(argTypes[k]) {
			if k == i { return -1 }
			continue
		}
		var w int = ArgWords(argTypes[k])
		if ngrn >= cc.NumGpArgRegs {
			if k == i { return -1 }
			continue
		}
		if k == i { return ngrn }
		var inRegs int = w
		if ngrn + inRegs > cc.NumGpArgRegs {
			inRegs = cc.NumGpArgRegs - ngrn
		}
		ngrn = ngrn + inRegs
	}
	return -1
}

// CallArgStackOff returns the byte offset into the outgoing-args area
// for arg i's stack portion. Returns -1 if arg i is fully in registers
// (or is a float scalar — those go in FP regs). Returns >=0 when the
// arg has any words on the stack, including the SPLIT case (some words
// in regs, overflow on stack at the returned offset).
func (cc CallConv) CallArgStackOff(argTypes @[]@types.Type, i int) int {
	var ngrn int = 0
	var soff int = 0
	for k := 0; k <= i; k++ {
		if IsFloatScalarTyp(argTypes[k]) {
			if k == i { return -1 }
			continue
		}
		var w int = ArgWords(argTypes[k])
		var stackWords int = 0
		if ngrn >= cc.NumGpArgRegs {
			stackWords = w
		} else if ngrn + w > cc.NumGpArgRegs {
			stackWords = w - (cc.NumGpArgRegs - ngrn)
			ngrn = cc.NumGpArgRegs
		} else {
			ngrn = ngrn + w
		}
		if k == i {
			if stackWords > 0 { return soff }
			return -1
		}
		soff = soff + stackWords * 8
	}
	return -1
}

// CallStackBytes returns the total outgoing-args area size in bytes for
// a call with the given arg types, rounded up to StackAlign. Float
// scalars don't contribute (FP-reg passing only). Mirrors the SPLIT
// semantics in CallArgRegStart/CallArgStackOff: only words past the
// last GP arg reg count toward the stack tally.
func (cc CallConv) CallStackBytes(argTypes @[]@types.Type) int {
	var ngrn int = 0
	var soff int = 0
	for k := 0; k < len(argTypes); k++ {
		if IsFloatScalarTyp(argTypes[k]) { continue }
		var w int = ArgWords(argTypes[k])
		var stackWords int = 0
		if ngrn >= cc.NumGpArgRegs {
			stackWords = w
		} else if ngrn + w > cc.NumGpArgRegs {
			stackWords = w - (cc.NumGpArgRegs - ngrn)
			ngrn = cc.NumGpArgRegs
		} else {
			ngrn = ngrn + w
		}
		soff = soff + stackWords * 8
	}
	if cc.StackAlign > 1 && soff % cc.StackAlign != 0 {
		soff = soff + (cc.StackAlign - soff % cc.StackAlign)
	}
	return soff
}

// ============================================================
// Return classification (parameterised by CallConv)
// ============================================================

// FuncReturnsBigAggregate reports whether f returns a single aggregate
// value larger than cc.InternalSretBytes — the threshold at which the
// calling convention switches from register-packing to sret indirection.
func (cc CallConv) FuncReturnsBigAggregate(f @ir.Func) bool {
	if len(f.Results) != 1 { return false }
	if !IsAggregateTyp(f.Results[0]) { return false }
	return f.Results[0].SizeOf() > cc.InternalSretBytes
}

// CallReturnsBigAggregate is the symmetric predicate for an OP_CALL.
// True when the callee returns a single aggregate above the internal
// sret threshold — the caller must pass the return-buffer pointer in
// the sret register before the call and skip the in-reg return-collect
// afterwards.
func (cc CallConv) CallReturnsBigAggregate(ins @ir.Instr) bool {
	if ins == nil || ins.Typ == nil { return false }
	if IsMultiReturnCall(ins) { return false }
	if !IsAggregateTyp(ins.Typ) { return false }
	return ins.Typ.SizeOf() > cc.InternalSretBytes
}

// FuncReturnsBigMultiReturn reports whether f's multi-return tuple's
// total size exceeds the internal sret threshold. Above the threshold,
// the in-reg packing path would silently drop the tail bytes, so we
// switch to sret indirection: caller passes a buffer pointer, callee
// writes each return value through it at FieldOffset(MultiReturnType, i).
func (cc CallConv) FuncReturnsBigMultiReturn(f @ir.Func) bool {
	if len(f.Results) <= 1 { return false }
	if f.MultiReturnType == nil { return false }
	return f.MultiReturnType.SizeOf() > cc.InternalSretBytes
}

// CallReturnsBigMultiReturn is the symmetric predicate for an OP_CALL
// whose result is a multi-return tuple above the internal sret
// threshold.
func (cc CallConv) CallReturnsBigMultiReturn(ins @ir.Instr) bool {
	if ins == nil || ins.Typ == nil { return false }
	if !IsMultiReturnCall(ins) { return false }
	return ins.Typ.SizeOf() > cc.InternalSretBytes
}

// CalleeUsesCSret reports whether ins (an OP_CALL) targets a C-extern
// callee whose return type triggers the C sret convention (aggregate >
// cc.CExternSretBytes). pkg/codegen emits the LLVM declaration with
// `sret(...)` for these — clang lowers the corresponding C definition
// to take a hidden return-buffer pointer, write the result through it,
// and return void. The native backend must mirror that convention when
// calling into bootstrap.* / libc / etc.
//
// Returns false for internal Binate calls — they use the
// InternalSretBytes threshold via CallReturnsBigAggregate instead.
func (cc CallConv) CalleeUsesCSret(funcs @[]@ir.Func, ins @ir.Instr) bool {
	if ins == nil || ins.Typ == nil { return false }
	if ins.Op != ir.OP_CALL { return false }
	if IsMultiReturnCall(ins) { return false }
	if !IsAggregateTyp(ins.Typ) { return false }
	if ins.Typ.SizeOf() <= cc.CExternSretBytes { return false }
	for i := 0; i < len(funcs); i++ {
		var f @ir.Func = funcs[i]
		if f == nil { continue }
		if !f.IsCExtern { continue }
		if charSliceEq(f.Name, ins.StrVal) { return true }
	}
	return false
}
