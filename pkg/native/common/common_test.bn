package "pkg/native/common"

import "pkg/ir"
import "pkg/types"
import "pkg/builtin/testing"

// Unit coverage for the pure, arch-agnostic helpers. Anything that
// depends on arch-specific emission (getOperand, spillAndReset, the
// register pool, prologue/epilogue) is tested in pkg/native/<arch>/
// via end-to-end EmitObject round-trips.

// nrm returns a freshly-constructed regmap.
func nrm() @RegMap { return make(RegMap) }


func TestLookupsReturnMinusOneOnMiss() testing.TestResult {
	var m @RegMap = nrm()
	if LookupAlloc(m, 7) != -1 { return "LookupAlloc miss should be -1" }
	if LookupAllocSize(m, 7) != -1 { return "LookupAllocSize miss should be -1" }
	if LookupSpill(m, 7) != -1 { return "LookupSpill miss should be -1" }
	if LookupReg(m, 7) != -1 { return "LookupReg miss should be -1" }
	return ""
}

func TestAssignAndLookupReg() testing.TestResult {
	var m @RegMap = nrm()
	AssignReg(m, 3, 42)
	if LookupReg(m, 3) != 42 { return "expected 42 after assign" }
	if LookupReg(m, 99) != -1 { return "expected -1 for unknown id" }
	return ""
}

func TestResetClearsRegsButKeepsSlots() testing.TestResult {
	var m @RegMap = nrm()
	m.AllocIDs = AppendInt(m.AllocIDs, 5)
	m.AllocOffsets = AppendInt(m.AllocOffsets, 32)
	m.AllocSizes = AppendInt(m.AllocSizes, 8)
	m.SpillIDs = AppendInt(m.SpillIDs, 6)
	m.SpillOffsets = AppendInt(m.SpillOffsets, 40)
	AssignReg(m, 7, 11)
	ResetRegs(m)
	if LookupReg(m, 7) != -1 { return "regs should be cleared" }
	if LookupAlloc(m, 5) != 32 { return "alloc slot should survive" }
	if LookupSpill(m, 6) != 40 { return "spill slot should survive" }
	return ""
}

func TestInstrIsVoid() testing.TestResult {
	var vf @ir.Instr = make(ir.Instr)
	vf.ID = -1
	if !InstrIsVoid(vf) { return "id=-1 should be void" }

	var noTyp @ir.Instr = make(ir.Instr)
	noTyp.ID = 3
	if !InstrIsVoid(noTyp) { return "nil Typ should be void" }

	var notVoid @ir.Instr = make(ir.Instr)
	notVoid.ID = 4
	notVoid.Typ = types.TypInt()
	if InstrIsVoid(notVoid) { return "int-typed should not be void" }
	return ""
}

func TestIsAggregateTyp() testing.TestResult {
	if IsAggregateTyp(nil) { return "nil should not be aggregate" }
	if IsAggregateTyp(types.TypInt()) { return "int is not aggregate" }
	var arr @types.Type = types.MakeArrayType(types.TypInt(), 4)
	if !IsAggregateTyp(arr) { return "array should be aggregate" }
	if !IsAggregateTyp(types.MakeManagedSliceType(types.TypInt())) {
		return "@[]int should be aggregate"
	}
	if !IsAggregateTyp(types.MakeSliceType(types.TypInt())) {
		return "*[]int should be aggregate"
	}
	return ""
}

// PlanFrame should reserve two regions for OP_MAKE_SLICE: a sized data
// region (where the runtime writes the 32 bytes) and a pointer-sized
// spill slot (which holds the address of that region).
func TestPlanFrameReservesMakeSliceDataRegion() testing.TestResult {
	var f @ir.Func = ir.NewFunc("t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	var n @ir.Instr = ir.EmitConstInt(f, b, 3, types.TypInt())
	var ms @ir.Instr = ir.EmitMakeSlice(f, b, types.TypInt(), n)
	ir.EmitReturn(b, makeNoInstrs())

	var m @RegMap = nrm()
	PlanFrame(m, f)

	if LookupAlloc(m, ms.ID) < 0 {
		return "MAKE_SLICE should have an alloc region"
	}
	if LookupAllocSize(m, ms.ID) != 32 {
		return "MAKE_SLICE alloc region should be 32 bytes"
	}
	if LookupSpill(m, ms.ID) < 0 {
		return "MAKE_SLICE should have a spill slot too"
	}
	return ""
}

func makeNoParams() @[]@ir.Param {
	var p @[]@ir.Param
	return p
}

func makeNoResults() @[]@types.Type {
	var r @[]@types.Type
	return r
}

func makeNoInstrs() @[]@ir.Instr {
	var i @[]@ir.Instr
	return i
}

func TestFrameSizeZero() testing.TestResult {
	var m @RegMap = nrm()
	if FrameSize(m) != 0 { return "empty regmap should yield frame size 0" }
	return ""
}

func TestFrameSizeReturnsPlannedValue() testing.TestResult {
	var m @RegMap = nrm()
	m.FrameSize = 48
	if FrameSize(m) != 48 { return "FrameSize should return cached FrameSize" }
	return ""
}

// IsMultiReturnCall — the encoding the IR uses for a function with
// multiple return values is an OP_CALL whose Typ is an anonymous
// TYP_STRUCT (Name == ""). Named struct returns must NOT be treated
// as multi-return; they go through pointer-form storage like other
// aggregates.
func TestIsMultiReturnCallAnonymousStruct() testing.TestResult {
	var ty @types.Type = make(types.Type)
	ty.Kind = types.TYP_STRUCT
	// Name left empty — multi-return convention.
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.Typ = ty
	if !IsMultiReturnCall(ins) {
		return "anonymous TYP_STRUCT call should be multi-return"
	}
	return ""
}

func TestIsMultiReturnCallNamedStructIsNot() testing.TestResult {
	var ty @types.Type = make(types.Type)
	ty.Kind = types.TYP_STRUCT
	ty.Name = "Point"
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.Typ = ty
	if IsMultiReturnCall(ins) {
		return "named struct call should not be multi-return"
	}
	return ""
}

func TestIsMultiReturnCallNonCallIsNot() testing.TestResult {
	var ty @types.Type = make(types.Type)
	ty.Kind = types.TYP_STRUCT
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_LOAD
	ins.Typ = ty
	if IsMultiReturnCall(ins) {
		return "non-CALL op should not be multi-return"
	}
	return ""
}

// SpillHoldsAggregatePointer's contract: true for every aggregate SSA
// value EXCEPT multi-return calls. Distinguishes the two storage
// forms OP_EXTRACT has to know about.
func TestSpillHoldsPointerForLoadOfAggregate() testing.TestResult {
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_LOAD
	ins.Typ = MakeManagedSliceTypeForTest()
	if !SpillHoldsAggregatePointer(ins) {
		return "OP_LOAD of slice should be pointer-form"
	}
	return ""
}

func TestSpillHoldsDataDirectlyForMultiReturn() testing.TestResult {
	var ty @types.Type = make(types.Type)
	ty.Kind = types.TYP_STRUCT
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.Typ = ty
	if SpillHoldsAggregatePointer(ins) {
		return "multi-return call should be direct-form"
	}
	return ""
}

func TestSpillHoldsPointerForNamedStructCall() testing.TestResult {
	var ty @types.Type = make(types.Type)
	ty.Kind = types.TYP_STRUCT
	ty.Name = "Point"
	var ins @ir.Instr = make(ir.Instr)
	ins.Op = ir.OP_CALL
	ins.Typ = ty
	if !SpillHoldsAggregatePointer(ins) {
		return "named struct call should be pointer-form"
	}
	return ""
}

// PlanFrame for an aggregate-returning call (slice / named struct)
// reserves a data region (AllocIDs entry) plus an 8-byte pointer
// spill slot — the same shape as OP_MAKE_SLICE.
func TestPlanFrameReservesAggregateCallReturnRegion() testing.TestResult {
	var f @ir.Func = ir.NewFunc("t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	// Construct a CALL that returns @[]int (managed slice = 32 bytes).
	var noArgs @[]@ir.Instr
	var ret @ir.Instr = ir.EmitCall(f, b, "callee", noArgs,
		MakeManagedSliceTypeForTest())
	ir.EmitReturn(b, makeNoInstrs())

	var m @RegMap = nrm()
	PlanFrame(m, f)

	if LookupAlloc(m, ret.ID) < 0 {
		return "aggregate call return should have a data region"
	}
	if LookupAllocSize(m, ret.ID) != 32 {
		return "managed-slice return region should be 32 bytes"
	}
	if LookupSpill(m, ret.ID) < 0 {
		return "aggregate call return should have a pointer spill"
	}
	return ""
}

// MakeManagedSliceTypeForTest avoids depending on the test file
// having access to the right helper alias name.
func MakeManagedSliceTypeForTest() @types.Type {
	return types.MakeManagedSliceType(types.TypInt())
}

// AAPCS-style argument dispatch: scalars consume one reg each up to
// X7; an aggregate that doesn't fit in remaining regs goes ENTIRELY
// on stack. The exact rule matters because a "split" (some words in
// regs, some on stack) was the regression that silently dropped
// Entry.Val in 135 — the caller wrote 4 of 5 words to X4..X7 and
// dropped word 5.

func TestArgWordsAggregateRoundsUp() testing.TestResult {
	// @[]int = managed slice = 32 bytes = 4 words.
	var ms @types.Type = types.MakeManagedSliceType(types.TypInt())
	if ArgWords(ms) != 4 {
		return "managed slice should be 4 words"
	}
	// Plain pointer (managed-ptr): 1 word.
	if ArgWords(types.TypInt()) != 1 {
		return "scalar should be 1 word"
	}
	return ""
}

func TestCallStackBytesAllInRegs() testing.TestResult {
	// (int, @[]int): 1 + 4 = 5 words. Fits in X0..X4. Zero stack.
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.TypInt()
	ts[1] = types.MakeManagedSliceType(types.TypInt())
	if CallStackBytes(ts) != 0 {
		return "all-fit args should need 0 stack bytes"
	}
	if CallArgRegStart(ts, 0) != 0 { return "arg 0 should be at X0" }
	if CallArgRegStart(ts, 1) != 1 { return "arg 1 should start at X1" }
	if CallArgStackOff(ts, 0) != -1 { return "arg 0 should not be on stack" }
	return ""
}

func TestCallStackBytesAggregateOverflowsAtomically() testing.TestResult {
	// (@[]int, Entry5w): 4 + 5 = 9 words. Slice fits in X0..X3 (NGRN
	// 0→4); Entry needs 5, only 4 left, goes ENTIRELY on stack at
	// offset 0. Total stack = 5*8 = 40, rounded up to 48 (16-aligned).
	var fields @[]@types.Field = make_slice(@types.Field, 2)
	fields[0] = make(types.Field)
	fields[0].Type = types.MakeManagedSliceType(types.TypInt())
	fields[1] = make(types.Field)
	fields[1].Type = types.TypInt()
	var entry @types.Type = types.MakeStructType("Entry", fields)
	var ts @[]@types.Type = make_slice(@types.Type, 2)
	ts[0] = types.MakeManagedSliceType(types.TypInt())
	ts[1] = entry
	if CallArgRegStart(ts, 0) != 0 { return "slice arg should start X0" }
	if CallArgRegStart(ts, 1) != -1 {
		return "Entry should overflow to stack, not split into X4..X7"
	}
	if CallArgStackOff(ts, 1) != 0 {
		return "first stack arg should be at offset 0"
	}
	if CallStackBytes(ts) != 48 {
		return "5-word stack arg should reserve 48 bytes (16-aligned)"
	}
	return ""
}

func TestCallStackBytesScalarOverflowAfterEightFilled() testing.TestResult {
	// 9 ints: X0..X7 used, then 9th goes on stack at offset 0.
	var ts @[]@types.Type = make_slice(@types.Type, 9)
	for i := 0; i < 9; i++ {
		ts[i] = types.TypInt()
	}
	if CallArgRegStart(ts, 7) != 7 { return "arg 7 should be in X7" }
	if CallArgRegStart(ts, 8) != -1 { return "arg 8 should overflow" }
	if CallArgStackOff(ts, 8) != 0 { return "arg 8 stack offset should be 0" }
	if CallStackBytes(ts) != 16 {
		return "1-word stack arg should pad to 16 bytes"
	}
	return ""
}

// PlanFrame must reserve OutgoingArgsSize at the bottom of the frame
// (offset 0..N), so spills/allocas land at offsets >= N. Without this
// shift, the caller's stack-arg writes would clobber its own spills.
func TestPlanFrameReservesOutgoingArgsArea() testing.TestResult {
	var f @ir.Func = ir.NewFunc("t", makeNoParams(), makeNoResults())
	var b @ir.Block = ir.AddBlock(f, "entry")
	// Construct a CALL with 9 int args so 1 word overflows to stack.
	// CallStackBytes = 16 (one word, 16-aligned).
	var args @[]@ir.Instr = make_slice(@ir.Instr, 9)
	for i := 0; i < 9; i++ {
		args[i] = ir.EmitConstInt(f, b, i, types.TypInt())
	}
	ir.EmitCall(f, b, "callee", args, types.TypVoid())
	ir.EmitReturn(b, makeNoInstrs())

	var m @RegMap = nrm()
	PlanFrame(m, f)

	if m.OutgoingArgsSize != 16 {
		return "OutgoingArgsSize should be 16 for 9-int call"
	}
	// First spill (arg 0's CONST_INT) must land at offset >= 16.
	var firstSpill int = LookupSpill(m, args[0].ID)
	if firstSpill < 16 {
		return "spills must sit above the outgoing-args area"
	}
	return ""
}
