package "pkg/native"

import "pkg/ir"
import "pkg/native/arm64"

// strEq compares two raw char slices for equality.
func strEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// EmitObject dispatches to the per-arch backend.
func EmitObject(mod @ir.Module, arch *[]const char, path *[]const char) bool {
	if strEq(arch, "aarch64") || strEq(arch, "arm64") {
		return arm64.EmitObject(mod, path)
	}
	return false
}
