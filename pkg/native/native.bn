package "pkg/native"

import "pkg/ir"
import "pkg/native/amd64"
import "pkg/native/arm64"

// Backend lowers an IR module to a native object file for one target
// architecture.  The per-arch sub-packages do the actual lowering; the
// impls below are thin stateless adapters, so EmitObject dispatches
// through the interface vtable rather than calling the sub-package
// entry points directly.  This is the seam a driver-level backend
// abstraction can grow from (an LLVM-emitting impl would join here).
interface Backend {
	emitObject(mod @ir.Module, format *[]const char,
		path *[]const char) bool
}

// arm64Backend targets pkg/native/arm64 (Mach-O on macOS).
type arm64Backend struct {}

// emitObject lowers mod to an AArch64 object at path via pkg/native/arm64,
// in the requested object format.
func (b *arm64Backend) emitObject(mod @ir.Module, format *[]const char,
		path *[]const char) bool {
	return arm64.EmitObject(mod, format, path)
}

impl *arm64Backend : Backend

// amd64Backend targets pkg/native/amd64 (SysV-AMD64).
type amd64Backend struct {}

// emitObject lowers mod to an x86-64 object at path via pkg/native/amd64,
// in the requested object format.
func (b *amd64Backend) emitObject(mod @ir.Module, format *[]const char,
		path *[]const char) bool {
	return amd64.EmitObject(mod, format, path)
}

impl *amd64Backend : Backend

// strEq compares two raw char slices for equality.
func strEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// EmitObject selects the per-arch Backend and dispatches through it,
// emitting in the requested object `format` ("macho" / "elf").  Arch
// and format are independent axes (plan-backend-objformat-decoupling.md):
// the caller derives both from the target triple and passes them
// separately; this function never infers one from the other.
//
// Recognised arch strings:
//   - "aarch64", "arm64"   → pkg/native/arm64
//   - "x86_64", "x64"      → pkg/native/amd64 (SysV-AMD64)
func EmitObject(mod @ir.Module, arch *[]const char,
		format *[]const char, path *[]const char) bool {
	if strEq(arch, "aarch64") || strEq(arch, "arm64") {
		var be arm64Backend
		var b *Backend = &be
		return b.emitObject(mod, format, path)
	}
	if strEq(arch, "x86_64") || strEq(arch, "x64") {
		var be amd64Backend
		var b *Backend = &be
		return b.emitObject(mod, format, path)
	}
	return false
}
