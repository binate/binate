package "pkg/native"

import "pkg/ir"
import "pkg/builtin/testing"

// fail builds a @[]char failure message.
func fail(msg *[]char) testing.TestResult {
	var r @[]char
	if len(msg) == 0 { return r }
	var out @[]char = make_slice(char, len(msg))
	for i := 0; i < len(msg); i++ { out[i] = msg[i] }
	return out
}

// EmitObject returns false for an unrecognised arch string.
func TestEmitObjectUnknownArch() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	if EmitObject(m, "mips", "/tmp/binate_native_dispatch.o") {
		return fail("expected false for unknown arch 'mips'")
	}
	return ""
}

// Both "aarch64" and "arm64" are accepted as the same backend; the
// dispatcher delegates to pkg/native/arm64 in both cases. We don't
// actually link/run here — that's covered by arm64's own tests — but
// a successful EmitObject proves the dispatch table is wired.
func TestEmitObjectAArch64Aliases() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	// An empty module emits a zero-function text section; the arm64
	// backend still writes a valid .o.
	if !EmitObject(m, "aarch64", "/tmp/binate_native_dispatch_aa.o") {
		return fail("expected EmitObject to succeed for 'aarch64'")
	}
	if !EmitObject(m, "arm64", "/tmp/binate_native_dispatch_a64.o") {
		return fail("expected EmitObject to succeed for 'arm64'")
	}
	return ""
}
