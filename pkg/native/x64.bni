// Package x64 is the native SysV-AMD64 backend (sibling of
// pkg/native/arm64).  Phase 2 scaffold — EmitObject is a stub that
// returns false; Phase 3 onward fills in per-op lowering.
//
// See explorations/plan-native-x64.md.
package "pkg/native/x64"

import "pkg/ir"

// EmitObject lowers mod to an x86_64-linux ELF object at path.
// Currently a stub: returns false to signal "backend not yet
// implemented" so cmd/bnc can print a clear error and the
// conformance runner records COMPILE_ERROR per test.  Phase 3
// onward replaces this with real per-op lowering.
func EmitObject(mod @ir.Module, path *[]const char) bool
