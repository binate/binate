package "pkg/native/x64"

import "pkg/asm"
import "pkg/asm/elf"
import "pkg/asm/macho"
import "pkg/asm/x64"
import "pkg/ir"

// ============================================================
// EmitObject — module entry
// ============================================================

// objFmtEq compares two object-format selector strings.
func objFmtEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// EmitObject walks the IR module, emits each function's text via
// emitFunc, then the string-constant table and any package-level
// globals.  ResolveFixups patches same-section RIP-relative LEA / JMP
// / Jcc / CALL fixups; cross-section / extern targets stay as
// R_X86_64_PC32 (or R_X86_64_PLT32) relocations the linker resolves.
//
// `format` selects the object file ("elf" or "macho"; anything else
// defaults to ELF, this backend's primary runtime target).  Phase 2
// of plan-backend-objformat-decoupling.md.  (Mach-O symbols also need
// the leading-'_' prefix, which symPrefixed will gain in Phase 3 when
// the x86_64-darwin target + local Rosetta runner land; until then no
// target requests x86_64+Mach-O.)
func EmitObject(mod @ir.Module, format *[]const char,
		path *[]const char) bool {
	// Set the object-format linkage prefix before any symbol is
	// emitted: Mach-O C-linkage needs a leading '_', ELF none.
	if objFmtEq(format, "macho") {
		objSymPrefix = "_"
	} else {
		objSymPrefix = ""
	}
	mod.FinalizeStrings()

	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	// Full package path; the mangler short-names it internally for
	// now (full-path migration — see pkg/binate/mangle).
	var pkgName *[]const char = stripQuotes(mod.Name)

	for i := 0; i < len(mod.Funcs); i++ {
		var f @ir.Func = mod.Funcs[i]
		if f.IsExtern { continue }
		emitFunc(a, pkgName, f, mod.Strings, mod.Funcs)
	}

	emitFuncValueShims(a, pkgName, mod)
	emitStringTable(a, mod.Strings)
	emitGlobals(a, pkgName, mod.Globals)
	emitFuncValueVtables(a, pkgName, mod)
	emitImplVtables(a, pkgName, mod)

	x64.ResolveFixups(a)
	a.Finalize()

	// Restore the default (bare/ELF) prefix before returning so the
	// module-global objSymPrefix never leaks past one EmitObject call
	// — direct symFor/globalSymFor callers (and the next EmitObject)
	// always start from the bare default.
	var isMacho bool = objFmtEq(format, "macho")
	objSymPrefix = ""
	if a.HasError { return false }
	if isMacho {
		return macho.WriteX86_64(a, path)
	}
	return elf.WriteX86_64(a, path)
}

// emitStringTable emits every collected string literal with a local
// label `Lstr_<id>` pointing at its bytes.  Strings live in the
// text section alongside code; LEA reaches resolve same-section via
// FIX_REL32.  Same convention as arm64's emitStringTable.
func emitStringTable(a @asm.Assembler, strings @[]ir.StringConst) {
	if len(strings) == 0 { return }
	for i := 0; i < len(strings); i++ {
		var sc ir.StringConst = strings[i]
		a.DefineLabel(stringLabel(sc.ID))
		a.EmitAsciz(sc.Data)
	}
}

// emitGlobals emits package-level variable storage in a `data`
// section.  Each global gets a mangled `bn_<pkg>__<name>` symbol
// followed by g.Typ.SizeOf() zero bytes.  pkg/asm/elf maps the
// assembler "data" section to ELF .data so use-site RIP-relative
// LEAs (via emitGlobalAddr) reach the runtime address through an
// R_X86_64_PC32 cross-section relocation.
func emitGlobals(a @asm.Assembler, pkgName *[]const char,
		globals @[]@ir.Global) {
	if len(globals) == 0 { return }
	a.SetSection("data", -1)
	for i := 0; i < len(globals); i++ {
		var g @ir.Global = globals[i]
		if g == nil { continue }
		var label @[]char = globalSymFor(pkgName, g.Name)
		a.DefineLabel(label)
		a.SetGlobal(label)
		var sz int = 8
		if g.Typ != nil { sz = g.Typ.SizeOf() }
		if sz < 8 { sz = 8 }
		if sz % 8 != 0 { sz = sz + (8 - sz % 8) }
		for b := 0; b < sz; b = b + 1 {
			a.EmitUint8(cast(uint8, 0))
		}
	}
}
