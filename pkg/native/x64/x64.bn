package "pkg/native/x64"

import "pkg/ir"

// ============================================================
// EmitObject — module entry (Phase 2 scaffold)
// ============================================================
//
// Returns false unconditionally — the dispatch path is wired through
// pkg/native.EmitObject, cmd/bnc applyTarget recognises
// `--target x86_64-linux`, and the conformance runner exists.  When
// Phase 3 starts filling in real per-op lowering (frame planning, arg
// dispatch, prologue/epilogue, the basic arithmetic and control-flow
// ops), this stub will be replaced with the actual entry point.
//
// Returning false makes cmd/bnc print
//   `error: native backend failed to emit object`
// and exit 1, which the conformance runner records as COMPILE_ERROR
// — a measurable per-test failure mode rather than a wedge.
func EmitObject(mod @ir.Module, path *[]const char) bool {
	return false
}
