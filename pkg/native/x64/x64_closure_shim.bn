package "pkg/native/x64"

import "pkg/asm"
import "pkg/asm/x64"
import "pkg/ir"
import "pkg/native/common"
import "pkg/types"

// Native x64 emission for the per-(literal, capture-shape) shim
// that backs a capturing function literal (B.2 of plan-function-
// values-phase-2.md).  Split from x64_funcvalue.bn to keep that
// file under the hygiene soft length cap.
//
// SysV ABI: integer arg registers are RDI, RSI, RDX, RCX, R8, R9
// in that order — that's what argReg(0..5) returns.
//
// Closure shim shape (scalar / void return only — aggregate-return
// closures are not yet supported):
//
//   shim:
//     <shift user args argReg(1..M) up to argReg(W..W+M-1)>
//     <load capture words argReg(W-1)..argReg(1) from [RDI + off_*]>
//     <load argReg(0) (= RDI) from [RDI + off_0]>  // overwrites
//                                                  // base last
//     JMP underlying_fn
//
// W is the TOTAL capture-word count under the SysV ABI (not the
// capture *count*) — a multi-word capture (e.g., a managed-slice
// at 3 consecutive registers) is loaded into multiple registers
// and the user-arg shift accounts for them.  The user-arg shift
// is right-to-left (highest dst first) so source regs are read
// before being overwritten.  The capture loads are right-to-left
// so RDI stays valid as the closure-struct base until the last
// word is loaded (which reads [RDI + off_0] then writes RDI).

// lookupClosureFunc_x64 returns the Func with the given name iff
// it is a capturing-literal closure (IsClosure=true).  Returns nil
// for non-closure refs and for cross-module references.
func lookupClosureFunc_x64(mod @ir.Module, name @[]char) @ir.Func {
	for i := 0; i < len(mod.Funcs); i++ {
		if !charsEq_closureshim_x64(mod.Funcs[i].Name, name) {
			continue
		}
		if !mod.Funcs[i].IsClosure { return nil }
		return mod.Funcs[i]
	}
	return nil
}

// charsEq_closureshim_x64 is a local byte-compare for char slices.
// Distinct name from sibling files' charEq* helpers to avoid
// duplicate-symbol issues within pkg/native/x64.
func charsEq_closureshim_x64(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// emitClosureShim_x64 emits the per-(literal, capture-shape) shim
// for a capturing closure.  Caller has already emitted the label
// and SetWeak; this writes the shim body.
//
// Constraints for B.2 / B.3a:
//   - scalar / void return only (return size ≤ 8 bytes)
//   - captureWords + nUserWords ≤ 6 (must fit in RDI..R9).
//     captureWords is the SUM of common.ArgWords over capture
//     types, so a single @[]T capture already consumes 3 of the 6
//     slots.
//
// Beyond these the shim falls back to a plain tail-jump to the
// underlying — wrong behavior but doesn't crash the assembler.
func emitClosureShim_x64(a @asm.Assembler, fnLabel @[]char,
		fvTyp @types.Type, f @ir.Func) {
	var captureWords int = totalCaptureWords_x64(f)
	var nUserWords int = 0
	for pi := 0; pi < len(fvTyp.Params); pi++ {
		nUserWords = nUserWords +
			common.ArgWords(fvTyp.Params[pi].Type)
	}
	if captureWords + nUserWords > 6 {
		// Beyond register-arg budget.  Fall back to plain jump.
		a.SetGlobal(fnLabel)
		x64.Jmp(a, fnLabel)
		return
	}
	// Step 1: shift user args at argReg(1..M) to
	// argReg(W..W+M-1).  Right-to-left (j high to low) so each
	// source is read before being overwritten.  When W == 1 the
	// shift is a no-op (src == dst at each j).
	for j := nUserWords - 1; j >= 0; j = j - 1 {
		var srcReg int = argReg(j + 1)
		var dstReg int = argReg(captureWords + j)
		if srcReg != dstReg {
			x64.Mov(a, x64.Reg(dstReg, x64.SZ64),
				x64.Reg(srcReg, x64.SZ64))
		}
	}
	// Step 2: load capture words from [RDI + off+k*8] into
	// argReg(0..W-1).  Right-to-left so RDI stays valid as the
	// base until the last load (the i=0,k=0 self-load:
	// RDI <- [RDI + off_0]).  A multi-word capture (e.g., @[]T)
	// loads `wordCount` consecutive registers from `wordCount`
	// consecutive 8-byte slots starting at the field's offset.
	var w int = captureWords
	for i := f.NumCaptureParams - 1; i >= 0; i = i - 1 {
		var ft @types.Type = f.ClosureStruct.Fields[i].Type
		var wordCount int = common.ArgWords(ft)
		var baseOfs int = f.ClosureStruct.FieldOffset(i)
		for k := wordCount - 1; k >= 0; k = k - 1 {
			w = w - 1
			x64.Mov(a, x64.Reg(argReg(w), x64.SZ64),
				x64.Mem(x64.RDI, baseOfs + k * 8, x64.SZ64))
		}
	}
	// Step 3: tail-jump to the underlying lifted function.
	a.SetGlobal(fnLabel)
	x64.Jmp(a, fnLabel)
}

// totalCaptureWords_x64 sums the SysV register-word footprint of
// each capture-type — scalars / pointers are 1, managed-slice is
// 3, managed function-value is 2, etc.  Used by emitClosureShim_x64
// to budget RDI..R9 register-arg slots and to compute the user-arg
// shift target index.
func totalCaptureWords_x64(f @ir.Func) int {
	var w int = 0
	for i := 0; i < f.NumCaptureParams; i++ {
		w = w + common.ArgWords(f.ClosureStruct.Fields[i].Type)
	}
	return w
}
