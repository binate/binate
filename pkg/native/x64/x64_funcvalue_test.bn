package "pkg/native/x64"

import "pkg/asm"
import "pkg/builtins/testing"
import "pkg/ir"

// emitFuncValueShims / emitFuncValueVtables on a module with no
// OP_FUNC_VALUE / OP_FUNC_HANDLE refs should be no-ops.  Pin both
// the shim emitter and the vtable emitter individually so a
// regression that always-emits something gets caught.
func TestEmitFuncValueShimsEmptyNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var mod @ir.Module = ir.NewModule("\"main\"")
	emitFuncValueShims(a, "main", mod)
	if a.Sections[0].Len != 0 {
		return "empty module should produce no shims"
	}
	return ""
}

func TestEmitFuncValueVtablesEmptyNoOp() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	var mod @ir.Module = ir.NewModule("\"main\"")
	emitFuncValueVtables(a, "main", mod)
	if a.Sections[0].Len != 0 {
		return "empty module should produce no vtables"
	}
	return ""
}

// shimSymFor_x64 / vtableSymFor_x64 / handleSymFor_x64 build
// composable, well-formed symbol names.  Pin the suffix conventions
// — a regression that swaps __shim and __vt would silently break
// the dispatch wiring.
func TestFuncValueSymbolSuffixes() testing.TestResult {
	var shim @[]char = shimSymFor_x64("main", "add")
	if !endsWithFV(shim, "__shim") {
		return "shimSymFor_x64 must end with __shim"
	}
	var vt @[]char = vtableSymFor_x64("main", "add")
	if !endsWithFV(vt, "__vt") {
		return "vtableSymFor_x64 must end with __vt"
	}
	var h @[]char = handleSymFor_x64("main", "add")
	if !containsFV(h, "__handle.") {
		return "handleSymFor_x64 must contain __handle."
	}
	return ""
}

// endsWithFV reports whether `s` ends with suffix `suf`.
func endsWithFV(s @[]char, suf *[]const char) bool {
	if len(s) < len(suf) { return false }
	var off int = len(s) - len(suf)
	for i := 0; i < len(suf); i++ {
		if s[off + i] != suf[i] { return false }
	}
	return true
}

// containsFV reports whether `s` contains `needle`.
func containsFV(s @[]char, needle *[]const char) bool {
	if len(needle) == 0 { return true }
	for i := 0; i + len(needle) <= len(s); i++ {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if s[i + j] != needle[j] {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}
