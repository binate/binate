package "pkg/native/x64"

import "pkg/builtin/testing"
import "pkg/ir"

// fail builds a @[]char failure message from a raw char-slice.
func fail(msg *[]const char) testing.TestResult {
	var r @[]char
	if len(msg) == 0 { return r }
	var out @[]char = make_slice(char, len(msg))
	for i := 0; i < len(msg); i++ { out[i] = msg[i] }
	return out
}

// Phase 2 scaffold: EmitObject is a stub that returns false.  Pin
// the stub behaviour so the rest of the dispatch chain (pkg/native
// dispatch, cmd/bnc applyTarget, runner) keeps working as the real
// implementation is filled in.  When Phase 3 lands, this test should
// be replaced with end-to-end tests that drive EmitObject and
// inspect the produced ELF.
func TestEmitObjectIsStub() testing.TestResult {
	var m @ir.Module = ir.NewModule("\"main\"")
	if EmitObject(m, "/tmp/binate_x64_stub_test.o") {
		return fail("Phase 2 stub should return false until per-op lowering lands")
	}
	return ""
}
