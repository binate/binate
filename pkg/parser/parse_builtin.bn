package "pkg/parser"

import "pkg/ast"
import "pkg/token"

// ============================================================
// Builtin Calls
// ============================================================
//
// Per-builtin parsers for the compiler builtins (make, make_slice,
// box, cast, bit_cast, len, unsafe_index, sizeof, alignof,
// _raw_func_addr). Each emits an EXPR_BUILTIN with token.* set on
// e.Op so the type-checker can dispatch by tag. parsePrimaryExpr
// in parse_primary.bn picks the right parser by leading keyword.

// parseMakeCall parses a make(T) builtin call.
func parseMakeCall(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume make
	p.expect(token.LPAREN)
	// make(T) — takes only a type, no size argument
	var typ @ast.TypeExpr = parseType(p)
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Pos = pos
	e.Op = cast(int, token.MAKE)
	e.TypeRef = typ
	return e
}

// parseMakeSliceCall parses a make_slice(T, n) builtin call.
func parseMakeSliceCall(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume make_slice
	p.expect(token.LPAREN)
	// make_slice(T, n) — element type + size
	var typ @ast.TypeExpr = parseType(p)
	p.expect(token.COMMA)
	var size @ast.Expr = parseExpr(p)
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_BUILTIN
	e.Pos = pos
	e.Op = cast(int, token.MAKE_SLICE)
	e.TypeRef = typ
	var args @[]@ast.Expr
	args = appendExpr(args, size)
	e.Args = args
	return e
}

