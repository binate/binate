package "pkg/parser"

import "pkg/ast"
import "pkg/token"

// ============================================================
// Declaration Parsing
// ============================================================

// parseFuncDecl parses a function or method declaration. After `func`,
// an LPAREN means a method receiver (`func (r RT) Name(...)`); an IDENT
// means a free function.
func parseFuncDecl(p @Parser) @ast.Decl {
	var pos token.Pos = p.tok.Pos
	p.expect(token.FUNC)

	// Optional receiver
	var recv @ast.ParamDecl = nil
	if p.tok.Typ == token.LPAREN {
		p.next()
		recv = parseParamDecl(p)
		p.expect(token.RPAREN)
	}

	var nameTok token.Token = p.expect(token.IDENT)

	// Parameters
	p.expect(token.LPAREN)
	var params @[]@ast.ParamDecl
	if p.tok.Typ != token.RPAREN {
		params = parseParamList(p)
	}
	p.expect(token.RPAREN)

	// Result types
	var results @[]@ast.TypeExpr
	if p.tok.Typ == token.LPAREN {
		// Multiple returns: (T1, T2)
		p.next()
		results = parseTypeList(p)
		p.expect(token.RPAREN)
	} else if p.tok.Typ != token.LBRACE && p.tok.Typ != token.SEMICOLON && p.tok.Typ != token.EOF {
		// Single return type
		results = appendTypeExpr(results, parseType(p))
	}

	var body @ast.Stmt = nil
	if !p.interfaceFile {
		body = parseBlock(p)
	}

	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Pos = pos
	d.Name = nameTok.Lit
	d.Recv = recv
	d.Params = params
	d.Results = results
	d.Body = body
	return d
}

// parseFuncLit parses a function literal in expression position:
//   func(<params>) <results> { <body> }
// No receiver, no name. Phase 1 restriction (capture analysis at the
// type-check stage rejects references to enclosing-scope locals);
// the parser accepts the syntactic form unconditionally.
//
// Carries the signature and body via a synthetic Decl on Expr.DeclRef
// — same shape as parseFuncDecl produces, minus Recv and Name.
func parseFuncLit(p @Parser) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.expect(token.FUNC)

	// Parameters
	p.expect(token.LPAREN)
	var params @[]@ast.ParamDecl
	if p.tok.Typ != token.RPAREN {
		params = parseParamList(p)
	}
	p.expect(token.RPAREN)

	// Result types
	var results @[]@ast.TypeExpr
	if p.tok.Typ == token.LPAREN {
		// Multiple returns: (T1, T2)
		p.next()
		results = parseTypeList(p)
		p.expect(token.RPAREN)
	} else if p.tok.Typ != token.LBRACE && p.tok.Typ != token.SEMICOLON && p.tok.Typ != token.EOF {
		// Single return type
		results = appendTypeExpr(results, parseType(p))
	}

	var body @ast.Stmt = parseBlock(p)

	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Pos = pos
	// Name and Recv left empty — filled in by IR-gen (synthetic name).
	d.Params = params
	d.Results = results
	d.Body = body

	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_FUNC_LIT
	e.Pos = pos
	e.DeclRef = d
	return e
}

// parseInterfaceDecl parses a top-level interface declaration or
// alias:
//   interface <Name> { <method-sig>; <method-sig>; ... }
//   interface <Name> = <OtherInterface>      // alias form
//
// Each method signature has the same shape as a function header
// (name, params, optional results) but no receiver and no body.
// Per plan-interface-syntax-revision.md: bare `Stringer` is not a
// usable type expression; it's a referenceable name only. Anonymous
// interfaces (`interface { ... }` as a type expression) are not
// supported. The alias form (Slice 2.4) creates a nominal-equivalent
// alias — `MyStringer` and `Stringer` refer to the same interface.
//
// AST: DECL_INTERFACE with Name set, plus either:
//   - Decls populated (one stub DECL_FUNC per method) for the
//     declaration form, or
//   - IsAlias=true and TypeRef set to a TEXPR_NAMED of the target
//     interface for the alias form.
func parseInterfaceDecl(p @Parser) @ast.Decl {
	var pos token.Pos = p.tok.Pos
	p.expect(token.INTERFACE)
	var nameTok token.Token = p.expect(token.IDENT)

	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_INTERFACE
	d.Pos = pos
	d.Name = nameTok.Lit

	if p.tok.Typ == token.ASSIGN {
		// Alias form: `interface MyStringer = Stringer`.
		p.next()
		d.IsAlias = true
		d.TypeRef = parseInterfaceRef(p)
		return d
	}

	p.expect(token.LBRACE)

	var methods @[]@ast.Decl
	for p.tok.Typ != token.RBRACE && p.tok.Typ != token.EOF {
		methods = appendDecl(methods, parseInterfaceMethod(p))
		if !p.got(token.SEMICOLON) {
			break
		}
	}
	p.expect(token.RBRACE)
	d.Decls = methods
	return d
}

// parseImplDecl parses an impl declaration:
//   `impl <recv-type> : <Iface1>, <Iface2>, ...`
// where <recv-type> is any type expression (typically T, *T, *const T,
// or @T) and each <Iface> is a (possibly qualified) interface name.
// The impl is a pure connection between a type and the interfaces it
// satisfies — no body, no methods inside the decl. Methods that
// satisfy the interface are declared elsewhere (Go-style, outside the
// impl block) on the same receiver type.
//
// Phase 2 / Slice 2.1 of plan-interface-syntax-revision.md: parses
// and collects, but does NOT yet check that the receiver actually
// satisfies the named interfaces. That lands in a follow-up slice.
func parseImplDecl(p @Parser) @ast.Decl {
	var pos token.Pos = p.tok.Pos
	p.expect(token.IMPL)
	var recv @ast.TypeExpr = parseType(p)
	p.expect(token.COLON)
	var ifaces @[]@ast.TypeExpr
	ifaces = appendTypeExpr(ifaces, parseInterfaceRef(p))
	for p.got(token.COMMA) {
		ifaces = appendTypeExpr(ifaces, parseInterfaceRef(p))
	}
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_IMPL
	d.Pos = pos
	d.TypeRef = recv
	d.Interfaces = ifaces
	return d
}

// parseInterfaceRef parses an interface name reference inside an
// `impl T : ...` clause: either `Iface` or `pkg.Iface`. Returns a
// TEXPR_NAMED node — bare interface names aren't usable type
// expressions in general (Slice 2.0), but in this position they
// name the interface specifically.
func parseInterfaceRef(p @Parser) @ast.TypeExpr {
	var nameTok token.Token = p.expect(token.IDENT)
	var te @ast.TypeExpr = make(ast.TypeExpr)
	te.Kind = ast.TEXPR_NAMED
	te.Pos = nameTok.Pos
	if p.tok.Typ == token.DOT {
		p.next()
		var memberTok token.Token = p.expect(token.IDENT)
		te.Pkg = nameTok.Lit
		te.Name = memberTok.Lit
	} else {
		te.Name = nameTok.Lit
	}
	return te
}

// parseInterfaceMethod parses a method signature inside an interface
// body: `<name>(<params>) <results>`. Returns a stub DECL_FUNC with
// no Recv and no Body.
func parseInterfaceMethod(p @Parser) @ast.Decl {
	var nameTok token.Token = p.expect(token.IDENT)
	p.expect(token.LPAREN)
	var params @[]@ast.ParamDecl
	if p.tok.Typ != token.RPAREN {
		params = parseParamList(p)
	}
	p.expect(token.RPAREN)

	var results @[]@ast.TypeExpr
	if p.tok.Typ == token.LPAREN {
		// Multiple returns: (T1, T2)
		p.next()
		results = parseTypeList(p)
		p.expect(token.RPAREN)
	} else if p.tok.Typ != token.SEMICOLON && p.tok.Typ != token.RBRACE && p.tok.Typ != token.EOF {
		results = appendTypeExpr(results, parseType(p))
	}

	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_FUNC
	d.Pos = nameTok.Pos
	d.Name = nameTok.Lit
	d.Params = params
	d.Results = results
	// No Recv, no Body — interface method signature only.
	return d
}

// parseParamList parses a comma-separated list of function parameters.
func parseParamList(p @Parser) @[]@ast.ParamDecl {
	var params @[]@ast.ParamDecl
	params = appendParamDecl(params, parseParamDecl(p))
	for p.got(token.COMMA) {
		if p.tok.Typ == token.RPAREN {
			break // trailing comma
		}
		params = appendParamDecl(params, parseParamDecl(p))
	}
	return params
}

// parseParamDecl parses a single parameter declaration (name and type).
func parseParamDecl(p @Parser) @ast.ParamDecl {
	var nameTok token.Token = p.expect(token.IDENT)
	var typ @ast.TypeExpr = parseType(p)
	var pd @ast.ParamDecl = make(ast.ParamDecl)
	pd.Pos = nameTok.Pos
	pd.Name = nameTok.Lit
	pd.Type = typ
	return pd
}

// parseTypeList parses a comma-separated list of types (used for multiple return types).
func parseTypeList(p @Parser) @[]@ast.TypeExpr {
	var list @[]@ast.TypeExpr
	list = appendTypeExpr(list, parseType(p))
	for p.got(token.COMMA) {
		list = appendTypeExpr(list, parseType(p))
	}
	return list
}

// parseTypeDecl parses a type declaration, single or grouped.
func parseTypeDecl(p @Parser) @ast.Decl {
	var pos token.Pos = p.tok.Pos
	p.expect(token.TYPE)

	if p.tok.Typ == token.LPAREN {
		// Grouped type declarations
		p.next()
		var decls @[]@ast.Decl
		for p.tok.Typ != token.RPAREN && p.tok.Typ != token.EOF {
			var nameTok token.Token = p.expect(token.IDENT)
			decls = appendDecl(decls, parseTypeSpec(p, pos, nameTok))
			if !p.got(token.SEMICOLON) {
				break
			}
		}
		p.expect(token.RPAREN)
		if len(decls) == 1 {
			return decls[0]
		}
		var d @ast.Decl = make(ast.Decl)
		d.Kind = ast.DECL_GROUP
		d.Pos = pos
		d.Decls = decls
		return d
	}

	var nameTok token.Token = p.expect(token.IDENT)
	return parseTypeSpec(p, pos, nameTok)
}

// parseTypeSpec parses a single type spec: alias (= T), named struct, or distinct type.
func parseTypeSpec(p @Parser, typePos token.Pos, nameTok token.Token) @ast.Decl {
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_TYPE
	d.Pos = typePos
	d.Name = nameTok.Lit

	if p.tok.Typ == token.ASSIGN {
		// Type alias: type X = T
		p.next()
		d.IsAlias = true
		d.TypeRef = parseType(p)
	} else if p.tok.Typ == token.STRUCT {
		// Named struct: type X struct { ... }
		d.TypeRef = parseStructType(p)
	} else {
		// Distinct type: type X T
		d.TypeRef = parseType(p)
	}
	return d
}

// parseVarDecl parses a var declaration, single or grouped.
func parseVarDecl(p @Parser) @ast.Decl {
	var pos token.Pos = p.tok.Pos
	p.expect(token.VAR)

	if p.tok.Typ == token.LPAREN {
		// Grouped var declarations
		p.next()
		var decls @[]@ast.Decl
		for p.tok.Typ != token.RPAREN && p.tok.Typ != token.EOF {
			decls = appendDecl(decls, parseVarSpec(p, pos))
			if !p.got(token.SEMICOLON) {
				break
			}
		}
		p.expect(token.RPAREN)
		if len(decls) == 1 {
			return decls[0]
		}
		var d @ast.Decl = make(ast.Decl)
		d.Kind = ast.DECL_GROUP
		d.Pos = pos
		d.Decls = decls
		return d
	}

	return parseVarSpec(p, pos)
}

// parseVarSpec parses a single var spec: name with optional type and/or initializer.
func parseVarSpec(p @Parser, varPos token.Pos) @ast.Decl {
	var nameTok token.Token = p.expect(token.IDENT)
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_VAR
	d.Pos = varPos
	d.Name = nameTok.Lit

	if p.tok.Typ == token.ASSIGN {
		// var x = expr (type inferred)
		p.next()
		d.Value = parseExpr(p)
	} else {
		// var x T or var x T = expr
		d.TypeRef = parseType(p)
		if p.got(token.ASSIGN) {
			d.Value = parseExpr(p)
		}
	}
	return d
}

// parseConstDecl parses a const declaration, single or grouped.
func parseConstDecl(p @Parser) @ast.Decl {
	var pos token.Pos = p.tok.Pos
	p.expect(token.CONST)

	if p.tok.Typ == token.LPAREN {
		// Grouped const
		p.next()
		var decls @[]@ast.Decl
		for p.tok.Typ != token.RPAREN && p.tok.Typ != token.EOF {
			decls = appendDecl(decls, parseConstSpec(p, pos))
			if !p.got(token.SEMICOLON) {
				break
			}
		}
		p.expect(token.RPAREN)
		if len(decls) == 1 {
			return decls[0]
		}
		var d @ast.Decl = make(ast.Decl)
		d.Kind = ast.DECL_GROUP
		d.Pos = pos
		d.Decls = decls
		return d
	}

	return parseConstSpec(p, pos)
}

// parseConstSpec parses a single const spec with optional type and value.
func parseConstSpec(p @Parser, constPos token.Pos) @ast.Decl {
	var nameTok token.Token = p.expect(token.IDENT)
	var d @ast.Decl = make(ast.Decl)
	d.Kind = ast.DECL_CONST
	d.Pos = constPos
	d.Name = nameTok.Lit

	if p.tok.Typ == token.ASSIGN {
		// const x = expr
		p.next()
		d.Value = parseExpr(p)
	} else if p.tok.Typ != token.SEMICOLON && p.tok.Typ != token.RPAREN {
		// const x T = expr or bare name (repeat previous)
		if p.tok.Typ != token.ASSIGN {
			d.TypeRef = parseType(p)
		}
		if p.got(token.ASSIGN) {
			d.Value = parseExpr(p)
		}
	}
	return d
}

