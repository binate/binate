package "pkg/parser"

import "pkg/ast"
import "pkg/builtin/testing"
import "pkg/token"

// ============================================================
// Declaration Tests
// ============================================================
func TestParseVarDecl() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x int = 5"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseVarDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_VAR {
		return fail("TestParseVarDecl", "expected DECL_VAR")
	}
	if !charEq(d.Name, "x") {
		return fail("TestParseVarDecl", "expected name 'x'")
	}
	return ""
}

func TestParseFuncDecl() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc add(a int, b int) int { return a + b }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseFuncDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_FUNC {
		return fail("TestParseFuncDecl", "expected DECL_FUNC")
	}
	if !charEq(d.Name, "add") {
		return fail("TestParseFuncDecl", "expected name 'add'")
	}
	if len(d.Params) != 2 {
		return fail("TestParseFuncDecl", "expected 2 params")
	}
	if len(d.Results) != 1 {
		return fail("TestParseFuncDecl", "expected 1 result")
	}
	return ""
}

func TestParseMethodDeclPointerRecv() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc (p *Point) Translate(dx int, dy int) { return }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseMethodDeclPointerRecv", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_FUNC {
		return fail("TestParseMethodDeclPointerRecv", "expected DECL_FUNC")
	}
	if d.Recv == nil {
		return fail("TestParseMethodDeclPointerRecv", "expected non-nil Recv")
	}
	if !charEq(d.Recv.Name, "p") {
		return fail("TestParseMethodDeclPointerRecv", "expected recv name 'p'")
	}
	if d.Recv.Type == nil || d.Recv.Type.Kind != ast.TEXPR_POINTER {
		return fail("TestParseMethodDeclPointerRecv", "expected pointer recv type")
	}
	if d.Recv.Type.Base == nil || d.Recv.Type.Base.Kind != ast.TEXPR_NAMED ||
		!charEq(d.Recv.Type.Base.Name, "Point") {
		return fail("TestParseMethodDeclPointerRecv", "expected base type Point")
	}
	if !charEq(d.Name, "Translate") {
		return fail("TestParseMethodDeclPointerRecv", "expected name 'Translate'")
	}
	if len(d.Params) != 2 {
		return fail("TestParseMethodDeclPointerRecv", "expected 2 params")
	}
	return ""
}

func TestParseMethodDeclValueRecv() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc (p Point) X() int { return 0 }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseMethodDeclValueRecv", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Recv == nil || d.Recv.Type == nil || d.Recv.Type.Kind != ast.TEXPR_NAMED ||
		!charEq(d.Recv.Type.Name, "Point") {
		return fail("TestParseMethodDeclValueRecv", "expected value recv of Point")
	}
	return ""
}

func TestParseMethodDeclManagedRecv() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc (n @Node) Next() @Node { return nil }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseMethodDeclManagedRecv", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Recv == nil || d.Recv.Type == nil || d.Recv.Type.Kind != ast.TEXPR_MANAGED {
		return fail("TestParseMethodDeclManagedRecv", "expected @T recv")
	}
	if d.Recv.Type.Base == nil || !charEq(d.Recv.Type.Base.Name, "Node") {
		return fail("TestParseMethodDeclManagedRecv", "expected @Node recv")
	}
	return ""
}

func TestParseFreeFuncHasNilRecv() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc add(a int, b int) int { return a + b }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	var d @ast.Decl = f.Decls[0]
	if d.Recv != nil {
		return fail("TestParseFreeFuncHasNilRecv", "expected nil Recv on free function")
	}
	return ""
}

func TestParseTypeDecl() testing.TestResult {
	var src *[]const char = "package \"test\"\ntype Foo struct { x int; y int }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseTypeDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_TYPE {
		return fail("TestParseTypeDecl", "expected DECL_TYPE")
	}
	if !charEq(d.Name, "Foo") {
		return fail("TestParseTypeDecl", "expected name 'Foo'")
	}
	return ""
}

func TestParseTypeAlias() testing.TestResult {
	var src *[]const char = "package \"test\"\ntype MyInt = int"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseTypeAlias", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_TYPE {
		return fail("TestParseTypeAlias", "expected DECL_TYPE")
	}
	if !d.IsAlias {
		return fail("TestParseTypeAlias", "expected IsAlias true")
	}
	return ""
}

func TestParseConstDecl() testing.TestResult {
	var src *[]const char = "package \"test\"\nconst X int = 42"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseConstDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_CONST {
		return fail("TestParseConstDecl", "expected DECL_CONST")
	}
	return ""
}

func TestParseGroupedConst() testing.TestResult {
	var src *[]const char = "package \"test\"\nconst ( A int = 1; B int = 2; C int = 3 )"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseGroupedConst", "expected 1 decl (group)")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_GROUP {
		return fail("TestParseGroupedConst", "expected DECL_GROUP")
	}
	if len(d.Decls) != 3 {
		return fail("TestParseGroupedConst", "expected 3 consts in group")
	}
	return ""
}

// ============================================================
// Interface declarations (plan-interface-syntax-revision.md
// shape) and extension form (plan-interface-embedding.md Slice E.1).
// ============================================================

func TestParseInterfaceEmpty() testing.TestResult {
	var src *[]const char = "package \"test\"\ninterface I {\n}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseInterfaceEmpty", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_INTERFACE {
		return fail("TestParseInterfaceEmpty", "expected DECL_INTERFACE")
	}
	if d.IsAlias {
		return fail("TestParseInterfaceEmpty", "expected IsAlias false")
	}
	if len(d.Interfaces) != 0 {
		return fail("TestParseInterfaceEmpty", "expected no parents")
	}
	if len(d.Decls) != 0 {
		return fail("TestParseInterfaceEmpty", "expected no methods")
	}
	return ""
}

func TestParseInterfaceAlias() testing.TestResult {
	var src *[]const char = "package \"test\"\ninterface MyI = I\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseInterfaceAlias", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_INTERFACE {
		return fail("TestParseInterfaceAlias", "expected DECL_INTERFACE")
	}
	if !d.IsAlias {
		return fail("TestParseInterfaceAlias", "expected IsAlias true")
	}
	if d.TypeRef == nil || d.TypeRef.Kind != ast.TEXPR_NAMED ||
			!charEq(d.TypeRef.Name, "I") {
		return fail("TestParseInterfaceAlias",
			"expected TypeRef -> NAMED 'I'")
	}
	return ""
}

func TestParseInterfaceExtendSingleParent() testing.TestResult {
	var src *[]const char =
		"package \"test\"\ninterface RC : Closer {\n\tRead() int\n}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseInterfaceExtendSingleParent",
			"expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_INTERFACE {
		return fail("TestParseInterfaceExtendSingleParent",
			"expected DECL_INTERFACE")
	}
	if d.IsAlias {
		return fail("TestParseInterfaceExtendSingleParent",
			"expected IsAlias false")
	}
	if len(d.Interfaces) != 1 {
		return fail("TestParseInterfaceExtendSingleParent",
			"expected 1 parent")
	}
	if d.Interfaces[0].Kind != ast.TEXPR_NAMED ||
			!charEq(d.Interfaces[0].Name, "Closer") {
		return fail("TestParseInterfaceExtendSingleParent",
			"expected parent NAMED 'Closer'")
	}
	if len(d.Decls) != 1 {
		return fail("TestParseInterfaceExtendSingleParent",
			"expected 1 own method")
	}
	return ""
}

func TestParseInterfaceExtendMultiParent() testing.TestResult {
	var src *[]const char =
		"package \"test\"\ninterface RWC : Reader, Writer, Closer {\n}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseInterfaceExtendMultiParent",
			"expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.Interfaces) != 3 {
		return fail("TestParseInterfaceExtendMultiParent",
			"expected 3 parents")
	}
	if !charEq(d.Interfaces[0].Name, "Reader") ||
			!charEq(d.Interfaces[1].Name, "Writer") ||
			!charEq(d.Interfaces[2].Name, "Closer") {
		return fail("TestParseInterfaceExtendMultiParent",
			"expected parents in source order")
	}
	if len(d.Decls) != 0 {
		return fail("TestParseInterfaceExtendMultiParent",
			"expected no own methods")
	}
	return ""
}

func TestParseInterfaceExtendQualifiedParent() testing.TestResult {
	var src *[]const char =
		"package \"test\"\ninterface MyRC : io.ReadCloser {\n}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseInterfaceExtendQualifiedParent",
			"expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.Interfaces) != 1 {
		return fail("TestParseInterfaceExtendQualifiedParent",
			"expected 1 parent")
	}
	if !charEq(d.Interfaces[0].Pkg, "io") ||
			!charEq(d.Interfaces[0].Name, "ReadCloser") {
		return fail("TestParseInterfaceExtendQualifiedParent",
			"expected qualified parent 'io.ReadCloser'")
	}
	return ""
}

func TestParseInterfaceExtendEmptyBody() testing.TestResult {
	var src *[]const char =
		"package \"test\"\ninterface RC : R, C {\n}\n"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseInterfaceExtendEmptyBody",
			"expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.Interfaces) != 2 {
		return fail("TestParseInterfaceExtendEmptyBody",
			"expected 2 parents")
	}
	if len(d.Decls) != 0 {
		return fail("TestParseInterfaceExtendEmptyBody",
			"expected no own methods")
	}
	return ""
}
