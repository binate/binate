package "pkg/parser"

import "pkg/ast"
import "pkg/token"

// ============================================================
// Expression Parsing
// ============================================================

// parseExpr parses an expression (entry point for all expression parsing).
func parseExpr(p @Parser) @ast.Expr {
	return parseOrExpr(p)
}

// parseExprNoCompositeLit parses an expression with composite literal parsing suppressed.
func parseExprNoCompositeLit(p @Parser) @ast.Expr {
	var old bool = p.noCompositeLit
	p.noCompositeLit = true
	var x @ast.Expr = parseExpr(p)
	p.noCompositeLit = old
	return x
}

// parseOrExpr parses a logical-OR expression (||).
func parseOrExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseAndExpr(p)
	for p.tok.Typ == token.LOR {
		var pos token.Pos = p.tok.Pos
		p.next()
		var y @ast.Expr = parseAndExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = cast(int, token.LOR)
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseAndExpr parses a logical-AND expression (&&).
func parseAndExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseCompareExpr(p)
	for p.tok.Typ == token.LAND {
		var pos token.Pos = p.tok.Pos
		p.next()
		var y @ast.Expr = parseCompareExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = cast(int, token.LAND)
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseCompareExpr parses a comparison expression (==, !=, <, >, <=, >=).
func parseCompareExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseBitOrExpr(p)
	if p.tok.Typ == token.EQ || p.tok.Typ == token.NEQ ||
		p.tok.Typ == token.LT || p.tok.Typ == token.GT ||
		p.tok.Typ == token.LEQ || p.tok.Typ == token.GEQ {
		var pos token.Pos = p.tok.Pos
		var op int = cast(int, p.tok.Typ)
		p.next()
		var y @ast.Expr = parseBitOrExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = op
		e.X = x
		e.Y = y
		return e
	}
	return x
}

// parseBitOrExpr parses a bitwise-OR expression (|).
func parseBitOrExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseBitXorExpr(p)
	for p.tok.Typ == token.PIPE {
		var pos token.Pos = p.tok.Pos
		p.next()
		var y @ast.Expr = parseBitXorExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = cast(int, token.PIPE)
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseBitXorExpr parses a bitwise-XOR expression (^).
func parseBitXorExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseBitAndExpr(p)
	for p.tok.Typ == token.CARET {
		var pos token.Pos = p.tok.Pos
		p.next()
		var y @ast.Expr = parseBitAndExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = cast(int, token.CARET)
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseBitAndExpr parses a bitwise-AND expression (&).
func parseBitAndExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseShiftExpr(p)
	for p.tok.Typ == token.AMP {
		var pos token.Pos = p.tok.Pos
		p.next()
		var y @ast.Expr = parseShiftExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = cast(int, token.AMP)
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseShiftExpr parses a bit-shift expression (<< or >>).
func parseShiftExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseAddExpr(p)
	for p.tok.Typ == token.SHL || p.tok.Typ == token.SHR {
		var pos token.Pos = p.tok.Pos
		var op int = cast(int, p.tok.Typ)
		p.next()
		var y @ast.Expr = parseAddExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = op
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseAddExpr parses an additive expression (+ or -).
func parseAddExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseMulExpr(p)
	for p.tok.Typ == token.PLUS || p.tok.Typ == token.MINUS {
		var pos token.Pos = p.tok.Pos
		var op int = cast(int, p.tok.Typ)
		p.next()
		var y @ast.Expr = parseMulExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = op
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseMulExpr parses a multiplicative expression (*, /, or %).
func parseMulExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parseUnaryExpr(p)
	for p.tok.Typ == token.STAR || p.tok.Typ == token.SLASH || p.tok.Typ == token.PERCENT {
		var pos token.Pos = p.tok.Pos
		var op int = cast(int, p.tok.Typ)
		p.next()
		var y @ast.Expr = parseUnaryExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_BINARY
		e.Pos = pos
		e.Op = op
		e.X = x
		e.Y = y
		x = e
	}
	return x
}

// parseUnaryExpr parses a unary expression (!, ~, -, *, &) or falls through to postfix.
func parseUnaryExpr(p @Parser) @ast.Expr {
	if p.tok.Typ == token.NOT || p.tok.Typ == token.TILDE ||
		p.tok.Typ == token.MINUS || p.tok.Typ == token.STAR ||
		p.tok.Typ == token.AMP {
		var pos token.Pos = p.tok.Pos
		var op int = cast(int, p.tok.Typ)
		p.next()
		// `*[]T{...}` — raw-slice composite literal. After
		// consuming `*`, an immediate `[` can only be the start
		// of `[]T` (a raw-slice type prefix) — a deref of an
		// array literal `*[N]T{...}` would be ill-typed (array
		// values aren't first-class in expression context).
		// parseRawSliceLit consumes the `[` `]` and parses the
		// rest of the literal.
		if op == cast(int, token.STAR) && p.tok.Typ == token.LBRACKET {
			return parseRawSliceLit(p, pos)
		}
		var x @ast.Expr = parseUnaryExpr(p)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_UNARY
		e.Pos = pos
		e.Op = op
		e.X = x
		return e
	}
	return parsePostfixExpr(p)
}

// parsePostfixExpr parses a primary expression followed by postfix operators.
func parsePostfixExpr(p @Parser) @ast.Expr {
	var x @ast.Expr = parsePrimaryExpr(p)
	return continuePostfix(p, x)
}

// continuePostfix continues parsing postfix operators (., *[], ()) on an existing expression.
func continuePostfix(p @Parser, x @ast.Expr) @ast.Expr {
	for {
		if p.tok.Typ == token.DOT {
			var pos token.Pos = p.tok.Pos
			p.next()
			var nameTok token.Token = p.tok
			p.next()
			var e @ast.Expr = make(ast.Expr)
			e.Kind = ast.EXPR_SELECTOR
			e.Pos = pos
			e.X = x
			e.Name = nameTok.Lit
			x = e
		} else if p.tok.Typ == token.LBRACKET {
			x = parseIndexOrSlice(p, x)
		} else if p.tok.Typ == token.LPAREN {
			x = parseCallExpr(p, x)
		} else {
			return x
		}
	}
	return x
}

// parseIndexOrSlice parses one of:
//   x[lo:hi]           — slice, unambiguous
//   x[i]               — single bracketed expr; ambiguous between
//                        value indexing and single-type-arg generic
//                        instantiation, produces EXPR_INSTANTIATE_OR_INDEX
//   x[T1, T2, ...]     — multi bracketed exprs; only legal as generic
//                        instantiation (value indexing takes one
//                        expr), produces EXPR_INSTANTIATE_OR_INDEX
// Per `plan-generics.md` Slice 1: the type checker disambiguates the
// single-element form by inspecting whether the head resolves to a
// generic decl or a value of slice / array type.
func parseIndexOrSlice(p @Parser, x @ast.Expr) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume [

	// [:hi]
	if p.tok.Typ == token.COLON {
		p.next()
		var hi @ast.Expr = nil
		if p.tok.Typ != token.RBRACKET {
			hi = parseExpr(p)
		}
		p.expect(token.RBRACKET)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_SLICE
		e.Pos = pos
		e.X = x
		e.Y = hi  // hi
		// Z (lo) left nil
		return e
	}

	var first @ast.Expr = parseExpr(p)

	if p.tok.Typ == token.COLON {
		// x[lo:hi]
		p.next()
		var hi @ast.Expr = nil
		if p.tok.Typ != token.RBRACKET {
			hi = parseExpr(p)
		}
		p.expect(token.RBRACKET)
		var e @ast.Expr = make(ast.Expr)
		e.Kind = ast.EXPR_SLICE
		e.Pos = pos
		e.X = x
		e.Y = hi   // hi
		e.Z = first  // lo
		return e
	}

	// x[i] or x[T1, T2, ...]
	var args @[]@ast.Expr
	args = appendExpr(args, first)
	for p.tok.Typ == token.COMMA {
		p.next()
		args = appendExpr(args, parseExpr(p))
	}
	p.expect(token.RBRACKET)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_INSTANTIATE_OR_INDEX
	e.Pos = pos
	e.X = x
	e.Args = args
	return e
}

// parseCallExpr parses a function call expression with arguments.
func parseCallExpr(p @Parser, fn @ast.Expr) @ast.Expr {
	var pos token.Pos = p.tok.Pos
	p.next() // consume (
	var args @[]@ast.Expr
	if p.tok.Typ != token.RPAREN {
		args = parseExprList(p)
	}
	p.expect(token.RPAREN)
	var e @ast.Expr = make(ast.Expr)
	e.Kind = ast.EXPR_CALL
	e.Pos = pos
	e.X = fn
	e.Args = args
	return e
}
