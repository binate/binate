package "pkg/parser"

import "pkg/ast"
import "pkg/binate/token"
import "pkg/builtins/testing"

// ============================================================
// Expression Tests
// ============================================================

func TestParseBinaryExpr() testing.TestResult {
	var p @Parser = mkParser("1 + 2")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BINARY {
		return fail("TestParseBinaryExpr", "expected EXPR_BINARY")
	}
	if e.Op != cast(int, token.PLUS) {
		return fail("TestParseBinaryExpr", "expected PLUS op")
	}
	if e.X.Kind != ast.EXPR_INT_LIT {
		return fail("TestParseBinaryExpr", "expected X to be INT_LIT")
	}
	if e.Y.Kind != ast.EXPR_INT_LIT {
		return fail("TestParseBinaryExpr", "expected Y to be INT_LIT")
	}
	return ""
}

func TestParsePrecedence() testing.TestResult {
	// 1 + 2 * 3 should parse as 1 + (2 * 3)
	var p @Parser = mkParser("1 + 2 * 3")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_BINARY {
		return fail("TestParsePrecedence", "expected EXPR_BINARY at top")
	}
	if e.Op != cast(int, token.PLUS) {
		return fail("TestParsePrecedence", "expected PLUS at top")
	}
	if e.Y.Kind != ast.EXPR_BINARY {
		return fail("TestParsePrecedence", "expected BINARY on right")
	}
	if e.Y.Op != cast(int, token.STAR) {
		return fail("TestParsePrecedence", "expected STAR on right")
	}
	return ""
}

func TestParseUnary() testing.TestResult {
	var p @Parser = mkParser("-x")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_UNARY {
		return fail("TestParseUnary", "expected EXPR_UNARY")
	}
	if e.Op != cast(int, token.MINUS) {
		return fail("TestParseUnary", "expected MINUS op")
	}
	if e.X.Kind != ast.EXPR_IDENT {
		return fail("TestParseUnary", "expected IDENT operand")
	}
	return ""
}

func TestParseCallExpr() testing.TestResult {
	var p @Parser = mkParser("foo(1, 2)")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_CALL {
		return fail("TestParseCallExpr", "expected EXPR_CALL")
	}
	if e.X.Kind != ast.EXPR_IDENT {
		return fail("TestParseCallExpr", "expected IDENT callee")
	}
	if len(e.Args) != 2 {
		return fail("TestParseCallExpr", "expected 2 args")
	}
	return ""
}

func TestParseIndexExpr() testing.TestResult {
	var p @Parser = mkParser("arr[0]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX {
		return fail("TestParseIndexExpr",
			"expected EXPR_INSTANTIATE_OR_INDEX")
	}
	if e.X.Kind != ast.EXPR_IDENT {
		return fail("TestParseIndexExpr", "expected IDENT base")
	}
	if len(e.Args) != 1 {
		return fail("TestParseIndexExpr", "expected 1 arg")
	}
	if e.Args[0].Kind != ast.EXPR_INT_LIT {
		return fail("TestParseIndexExpr", "expected INT_LIT index")
	}
	return ""
}

// Multi-arg bracketed form `name[T1, T2]` — syntactic shape of
// generic instantiation. Parser accepts it; type-checker rejects
// in Slice 1 (since generics aren't supported yet).
func TestParseGenericInstantiate() testing.TestResult {
	var p @Parser = mkParser("sort[int, *Point]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX {
		return fail("TestParseGenericInstantiate",
			"expected EXPR_INSTANTIATE_OR_INDEX")
	}
	if e.X.Kind != ast.EXPR_IDENT {
		return fail("TestParseGenericInstantiate", "expected IDENT head")
	}
	if !charEq(e.X.Name, "sort") {
		return fail("TestParseGenericInstantiate", "expected head 'sort'")
	}
	if len(e.Args) != 2 {
		return fail("TestParseGenericInstantiate", "expected 2 type args")
	}
	if e.Args[0].Kind != ast.EXPR_IDENT {
		return fail("TestParseGenericInstantiate",
			"expected first arg IDENT")
	}
	if !charEq(e.Args[0].Name, "int") {
		return fail("TestParseGenericInstantiate", "expected first arg 'int'")
	}
	return ""
}

// `f[@T]` — managed-pointer type argument.  Has no expression
// spelling, so the parser must route it through parseType and wrap
// it in EXPR_TYPE.  Regression for the CRITICAL "generic call type
// args reject @T / @[]T / *[]T" parser bug.
func TestParseManagedPtrTypeArg() testing.TestResult {
	var p @Parser = mkParser("Append[@Decl]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX {
		return fail("TestParseManagedPtrTypeArg",
			"expected EXPR_INSTANTIATE_OR_INDEX")
	}
	if len(e.Args) != 1 {
		return fail("TestParseManagedPtrTypeArg", "expected 1 type arg")
	}
	if e.Args[0].Kind != ast.EXPR_TYPE {
		return fail("TestParseManagedPtrTypeArg",
			"expected EXPR_TYPE arg")
	}
	if e.Args[0].TypeRef == nil ||
			e.Args[0].TypeRef.Kind != ast.TEXPR_MANAGED {
		return fail("TestParseManagedPtrTypeArg",
			"expected TEXPR_MANAGED TypeRef")
	}
	return ""
}

// `f[@[]T]` (managed slice) and `f[*[]T]` (raw slice) type args:
// both type-only forms, both wrapped in EXPR_TYPE.
func TestParseSliceTypeArgs() testing.TestResult {
	var p @Parser = mkParser("Append[@[]char]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX ||
			len(e.Args) != 1 ||
			e.Args[0].Kind != ast.EXPR_TYPE {
		return fail("TestParseSliceTypeArgs",
			"@[]char: expected single EXPR_TYPE arg")
	}
	if e.Args[0].TypeRef == nil ||
			e.Args[0].TypeRef.Kind != ast.TEXPR_MANAGED_SLICE {
		return fail("TestParseSliceTypeArgs",
			"expected TEXPR_MANAGED_SLICE")
	}
	var p2 @Parser = mkParser("Append[*[]uint8]")
	var e2 @ast.Expr = parseExpr(p2)
	if e2.Kind != ast.EXPR_INSTANTIATE_OR_INDEX ||
			len(e2.Args) != 1 ||
			e2.Args[0].Kind != ast.EXPR_TYPE {
		return fail("TestParseSliceTypeArgs",
			"*[]uint8: expected single EXPR_TYPE arg")
	}
	if e2.Args[0].TypeRef == nil ||
			e2.Args[0].TypeRef.Kind != ast.TEXPR_SLICE {
		return fail("TestParseSliceTypeArgs",
			"expected TEXPR_SLICE")
	}
	return ""
}

// Mixed `f[int, @T]`: a bare-name expression arg followed by a
// type-only EXPR_TYPE arg.  Each bracket element is classified
// independently.
func TestParseMixedTypeArgs() testing.TestResult {
	var p @Parser = mkParser("Pair[int, @Decl]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || len(e.Args) != 2 {
		return fail("TestParseMixedTypeArgs", "expected 2 args")
	}
	if e.Args[0].Kind != ast.EXPR_IDENT {
		return fail("TestParseMixedTypeArgs",
			"expected first arg EXPR_IDENT")
	}
	if e.Args[1].Kind != ast.EXPR_TYPE {
		return fail("TestParseMixedTypeArgs",
			"expected second arg EXPR_TYPE")
	}
	return ""
}

// `arr[*p]` must stay a value index (deref expression), NOT be
// mistaken for a `*[]T`-style type arg: `*` followed by an
// identifier is the deref-expression path, only `*[` routes to the
// type parser.
func TestParseDerefIndexNotTypeArg() testing.TestResult {
	var p @Parser = mkParser("arr[*p]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INSTANTIATE_OR_INDEX || len(e.Args) != 1 {
		return fail("TestParseDerefIndexNotTypeArg", "expected 1 arg")
	}
	if e.Args[0].Kind != ast.EXPR_UNARY {
		return fail("TestParseDerefIndexNotTypeArg",
			"expected EXPR_UNARY (deref), got a non-expression arg")
	}
	return ""
}

func TestParseSliceExpr() testing.TestResult {
	var p @Parser = mkParser("arr[1:3]")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_SLICE {
		return fail("TestParseSliceExpr", "expected EXPR_SLICE")
	}
	return ""
}

func TestParseSelectorExpr() testing.TestResult {
	var p @Parser = mkParser("x.y")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_SELECTOR {
		return fail("TestParseSelectorExpr", "expected EXPR_SELECTOR")
	}
	if !charEq(e.Name, "y") {
		return fail("TestParseSelectorExpr", "expected field 'y'")
	}
	return ""
}

// `func(x int) int { return x }` parses as EXPR_FUNC_LIT carrying a
// synthetic Decl with no Name and no Recv. (Slice A.7 of
// plan-function-values.)
func TestParseFuncLit() testing.TestResult {
	var p @Parser = mkParser("func(x int) int { return x }")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_FUNC_LIT {
		return fail("TestParseFuncLit", "expected EXPR_FUNC_LIT")
	}
	if e.DeclRef == nil {
		return fail("TestParseFuncLit", "DeclRef should not be nil")
	}
	if e.DeclRef.Recv != nil {
		return fail("TestParseFuncLit", "literal should have no receiver")
	}
	if len(e.DeclRef.Name) != 0 {
		return fail("TestParseFuncLit", "literal should have empty name")
	}
	if len(e.DeclRef.Params) != 1 {
		return fail("TestParseFuncLit", "expected 1 param")
	}
	if !charEq(e.DeclRef.Params[0].Name, "x") {
		return fail("TestParseFuncLit", "expected param 'x'")
	}
	if len(e.DeclRef.Results) != 1 {
		return fail("TestParseFuncLit", "expected 1 result")
	}
	if e.DeclRef.Body == nil {
		return fail("TestParseFuncLit", "literal should have a body")
	}
	return ""
}

// Function literal with no parameters and no results.
func TestParseFuncLitVoid() testing.TestResult {
	var p @Parser = mkParser("func() { }")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_FUNC_LIT {
		return fail("TestParseFuncLitVoid", "expected EXPR_FUNC_LIT")
	}
	if len(e.DeclRef.Params) != 0 {
		return fail("TestParseFuncLitVoid", "expected 0 params")
	}
	if len(e.DeclRef.Results) != 0 {
		return fail("TestParseFuncLitVoid", "expected 0 results")
	}
	return ""
}

// Function literal with multiple returns.
func TestParseFuncLitMultiReturn() testing.TestResult {
	var p @Parser = mkParser("func(a int, b int) (int, int) { return a, b }")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_FUNC_LIT {
		return fail("TestParseFuncLitMultiReturn", "expected EXPR_FUNC_LIT")
	}
	if len(e.DeclRef.Params) != 2 {
		return fail("TestParseFuncLitMultiReturn", "expected 2 params")
	}
	if len(e.DeclRef.Results) != 2 {
		return fail("TestParseFuncLitMultiReturn", "expected 2 results")
	}
	return ""
}
