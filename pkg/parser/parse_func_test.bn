package "pkg/parser"

import "pkg/ast"
import "pkg/builtin/testing"

// Parser tests for function-related declarations (`func` decls,
// methods, generic type-parameter lists).  Matches parse_func.bn.
// Generic-instantiation expression-side parsing is exercised in
// parse_expr_test.bn alongside other expression-form tests.

func TestParseFuncDecl() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc add(a int, b int) int { return a + b }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseFuncDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_FUNC {
		return fail("TestParseFuncDecl", "expected DECL_FUNC")
	}
	if !charEq(d.Name, "add") {
		return fail("TestParseFuncDecl", "expected name 'add'")
	}
	if len(d.Params) != 2 {
		return fail("TestParseFuncDecl", "expected 2 params")
	}
	if len(d.Results) != 1 {
		return fail("TestParseFuncDecl", "expected 1 result")
	}
	if len(d.TypeParams) != 0 {
		return fail("TestParseFuncDecl",
			"expected no type parameters on non-generic decl")
	}
	return ""
}

// Generic function decl: `func id[T any](x T) T { return x }`
// Parser populates Decl.TypeParams; type-checker doesn't run here.
func TestParseGenericFuncDecl() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc id[T any](x T) T { return x }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseGenericFuncDecl", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_FUNC {
		return fail("TestParseGenericFuncDecl", "expected DECL_FUNC")
	}
	if len(d.TypeParams) != 1 {
		return fail("TestParseGenericFuncDecl",
			"expected 1 type parameter")
	}
	var tp @ast.TypeParam = d.TypeParams[0]
	if !charEq(tp.Name, "T") {
		return fail("TestParseGenericFuncDecl", "expected type param 'T'")
	}
	if tp.Constraint == nil ||
			tp.Constraint.Kind != ast.TEXPR_NAMED ||
			!charEq(tp.Constraint.Name, "any") {
		return fail("TestParseGenericFuncDecl",
			"expected constraint 'any'")
	}
	if len(d.Params) != 1 {
		return fail("TestParseGenericFuncDecl", "expected 1 value param")
	}
	if d.Params[0].Type == nil ||
			d.Params[0].Type.Kind != ast.TEXPR_NAMED ||
			!charEq(d.Params[0].Type.Name, "T") {
		return fail("TestParseGenericFuncDecl",
			"expected param type ref 'T'")
	}
	if len(d.Results) != 1 ||
			d.Results[0].Kind != ast.TEXPR_NAMED ||
			!charEq(d.Results[0].Name, "T") {
		return fail("TestParseGenericFuncDecl",
			"expected result type ref 'T'")
	}
	return ""
}

// Two-parameter generic decl + the trailing-comma form.
func TestParseGenericFuncDeclTwoParams() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc pair[T any, U any,](x T, y U) {}"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseGenericFuncDeclTwoParams", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.TypeParams) != 2 {
		return fail("TestParseGenericFuncDeclTwoParams",
			"expected 2 type parameters")
	}
	if !charEq(d.TypeParams[0].Name, "T") ||
			!charEq(d.TypeParams[1].Name, "U") {
		return fail("TestParseGenericFuncDeclTwoParams",
			"wrong type-param names")
	}
	return ""
}

// Rejection: missing constraint after the name.  parseType errors
// on the following `]` and pushes a parse error.
func TestParseGenericFuncDeclMissingConstraint() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc bad[T](x T) {}"
	var p @Parser = mkParser(src)
	p.ParseFile()
	if len(p.errs) == 0 {
		return fail("TestParseGenericFuncDeclMissingConstraint",
			"expected at least one parse error")
	}
	return ""
}

// Rejection: missing closing `]` in the type-param list.
func TestParseGenericFuncDeclMissingRBracket() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc bad[T any(x T) {}"
	var p @Parser = mkParser(src)
	p.ParseFile()
	if len(p.errs) == 0 {
		return fail("TestParseGenericFuncDeclMissingRBracket",
			"expected at least one parse error")
	}
	return ""
}

func TestParseMethodDeclPointerRecv() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc (p *Point) Translate(dx int, dy int) { return }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseMethodDeclPointerRecv", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Kind != ast.DECL_FUNC {
		return fail("TestParseMethodDeclPointerRecv", "expected DECL_FUNC")
	}
	if d.Recv == nil {
		return fail("TestParseMethodDeclPointerRecv", "expected non-nil Recv")
	}
	if !charEq(d.Recv.Name, "p") {
		return fail("TestParseMethodDeclPointerRecv", "expected recv name 'p'")
	}
	if d.Recv.Type == nil || d.Recv.Type.Kind != ast.TEXPR_POINTER {
		return fail("TestParseMethodDeclPointerRecv", "expected pointer recv type")
	}
	if d.Recv.Type.Base == nil || d.Recv.Type.Base.Kind != ast.TEXPR_NAMED ||
		!charEq(d.Recv.Type.Base.Name, "Point") {
		return fail("TestParseMethodDeclPointerRecv", "expected base type Point")
	}
	if !charEq(d.Name, "Translate") {
		return fail("TestParseMethodDeclPointerRecv", "expected name 'Translate'")
	}
	if len(d.Params) != 2 {
		return fail("TestParseMethodDeclPointerRecv", "expected 2 params")
	}
	return ""
}

func TestParseMethodDeclValueRecv() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc (p Point) X() int { return 0 }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseMethodDeclValueRecv", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Recv == nil || d.Recv.Type == nil || d.Recv.Type.Kind != ast.TEXPR_NAMED ||
		!charEq(d.Recv.Type.Name, "Point") {
		return fail("TestParseMethodDeclValueRecv", "expected value recv of Point")
	}
	return ""
}

func TestParseMethodDeclManagedRecv() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc (n @Node) Next() @Node { return nil }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseMethodDeclManagedRecv", "expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if d.Recv == nil || d.Recv.Type == nil || d.Recv.Type.Kind != ast.TEXPR_MANAGED {
		return fail("TestParseMethodDeclManagedRecv", "expected @T recv")
	}
	if d.Recv.Type.Base == nil || !charEq(d.Recv.Type.Base.Name, "Node") {
		return fail("TestParseMethodDeclManagedRecv", "expected @Node recv")
	}
	return ""
}

func TestParseFreeFuncHasNilRecv() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc add(a int, b int) int { return a + b }"
	var p @Parser = mkParser(src)
	var f @ast.File = p.ParseFile()
	var d @ast.Decl = f.Decls[0]
	if d.Recv != nil {
		return fail("TestParseFreeFuncHasNilRecv", "expected nil Recv on free function")
	}
	return ""
}

// plan-generics.md Slice 7 / Q7: a non-generic func decl in
// `.bni` mode is signature-only — no body parsed.  The Body
// field stays nil and the source must not have an opening brace
// where the body would be.
func TestParseBniNonGenericNoBody() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc add(a int, b int) int"
	var p @Parser = mkBniParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseBniNonGenericNoBody",
			"expected 1 decl")
	}
	if f.Decls[0].Body != nil {
		return fail("TestParseBniNonGenericNoBody",
			"non-generic decl should have nil Body in .bni mode")
	}
	return ""
}

// plan-generics.md Slice 7 / Q7: a generic func decl in `.bni`
// mode carries its body so a cross-package consumer can
// monomorphize.  Body is parsed and the resulting Body field is
// non-nil.
func TestParseBniGenericKeepsBody() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc id[T any](x T) T { return x }"
	var p @Parser = mkBniParser(src)
	var f @ast.File = p.ParseFile()
	if len(f.Decls) != 1 {
		return fail("TestParseBniGenericKeepsBody",
			"expected 1 decl")
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.TypeParams) != 1 {
		return fail("TestParseBniGenericKeepsBody",
			"expected 1 type parameter")
	}
	if d.Body == nil {
		return fail("TestParseBniGenericKeepsBody",
			"generic decl should carry Body in .bni mode")
	}
	return ""
}
