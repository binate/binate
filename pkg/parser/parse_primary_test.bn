package "pkg/parser"

import "pkg/token"
import "pkg/ast"
import "pkg/builtin/testing"

func TestParseIntLit() testing.TestResult {
	var p @Parser = mkParser("42")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_INT_LIT {
		return fail("TestParseIntLit", "expected EXPR_INT_LIT")
	}
	if !charEq(e.Name, "42") {
		return fail("TestParseIntLit", "expected '42'")
	}
	return ""
}

func TestParseFloatLit() testing.TestResult {
	var p @Parser = mkParser("3.14")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_FLOAT_LIT {
		return fail("TestParseFloatLit", "expected EXPR_FLOAT_LIT")
	}
	if !charEq(e.Name, "3.14") {
		return fail("TestParseFloatLit", "expected '3.14'")
	}
	return ""
}

func TestParseFloatLitExponent() testing.TestResult {
	var p @Parser = mkParser("1e5")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_FLOAT_LIT {
