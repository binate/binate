package "pkg/parser"

import "pkg/ast"
import "pkg/buf"
import "pkg/lexer"
import "pkg/token"

// New creates a parser for source code.
func New(src *[]uint8, file *[]const char) @Parser {
	var p @Parser = make(Parser)
	p.lex = lexer.New(src, file)
	p.noCompositeLit = false
	p.interfaceFile = false
	p.next()
	return p
}

// NewInterface creates a parser for a .bni interface file.
func NewInterface(src *[]uint8, file *[]const char) @Parser {
	var p @Parser = make(Parser)
	p.lex = lexer.New(src, file)
	p.noCompositeLit = false
	p.interfaceFile = true
	p.next()
	return p
}

// Errors returns the list of parse errors.
func Errors(p @Parser) @[]ParseError {
	return p.errs
}

// next advances to the next token. If peekTok() has stashed a
// lookahead token, drain that first.
func (p @Parser) next() {
	p.prev = p.tok
	if p.hasPeek {
		p.tok = p.peek
		p.hasPeek = false
	} else {
		p.tok = p.lex.Next()
	}
}

// peekTok returns the token after the current one without consuming
// the current. Subsequent calls return the same stashed token until
// a p.next() drains it.
func (p @Parser) peekTok() token.Token {
	if !p.hasPeek {
		p.peek = p.lex.Next()
		p.hasPeek = true
	}
	return p.peek
}

// expect consumes the current token if it matches typ, otherwise records an error.
func (p @Parser) expect(typ token.Type) token.Token {
	var tok token.Token = p.tok
	if p.tok.Typ != typ {
		p.errExpected(typ)
	} else {
		p.next()
	}
	return tok
}

// got returns true and advances if the current token matches typ.
func (p @Parser) got(typ token.Type) bool {
	if p.tok.Typ == typ {
		p.next()
		return true
	}
	return false
}

// errExpected records "expected X, got Y" error.
func (p @Parser) errExpected(typ token.Type) {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("expected ")
	cb = cb.WriteStr(token.TypeName(typ))
	cb = cb.WriteStr(", got ")
	cb = cb.WriteStr(token.TypeName(p.tok.Typ))
	p.addError(p.tok.Pos, cb.Bytes())
}

// errMsg records a parse error with a custom message.
func (p @Parser) errMsg(msg @[]char) {
	p.addError(p.tok.Pos, msg)
}

// addError appends a parse error.
func (p @Parser) addError(pos token.Pos, msg @[]char) {
	var e ParseError
	e.Pos = pos
	e.Msg = msg
	p.errs = appendParseError(p.errs, e)
}

// ============================================================
// Source File Parsing
// ============================================================

// ParseFile parses a complete source file: package clause, imports, and top-level declarations.
func ParseFile(p @Parser) @ast.File {
	var f @ast.File = make(ast.File)
	f.Pos = p.tok.Pos

	// Package clause
	p.expect(token.PACKAGE)
	if p.tok.Typ == token.STRING {
		f.PkgName = p.tok.Lit
		p.next()
	} else {
		p.errMsg("expected package name string")
	}
	p.expect(token.SEMICOLON)

	// Import declarations
	for p.tok.Typ == token.IMPORT {
		var specs @[]@ast.ImportSpec = parseImportDecl(p)
		for i := 0; i < len(specs); i++ {
			f.Imports = appendImportSpec(f.Imports, specs[i])
		}
		p.expect(token.SEMICOLON)
	}

	// Top-level declarations
	for p.tok.Typ != token.EOF {
		var d @ast.Decl = parseTopLevelDecl(p)
		if d != nil {
			f.Decls = appendDecl(f.Decls, d)
		}
		if p.tok.Typ != token.EOF {
			p.expect(token.SEMICOLON)
		}
	}

	return f
}

// ============================================================
// REPL entry points
// ============================================================

// ParseExpr parses a single expression from the parser's current
// position.  Caller is responsible for setting up the parser via New
// and for inspecting Errors afterward.  Used by the REPL to evaluate
// bare expressions in immediate mode.
func ParseExpr(p @Parser) @ast.Expr {
	return parseExpr(p)
}

// ParseTopLevelDecl parses a single top-level declaration (`func`,
// `type`, `var`, or `const`).  REPL entry point for Tier 2: a decl
// typed at the prompt becomes a persistent addition to the loaded
// module's scope.  Errors out (returns nil) if the current token
// isn't one of the four decl-leading keywords.
func ParseTopLevelDecl(p @Parser) @ast.Decl {
	return parseTopLevelDecl(p)
}

// IsAtTopLevelDecl returns true if the parser's current token
// starts a top-level declaration (func / type / var / const).
// REPL dispatch helper: lets the prompt route input to
// ParseTopLevelDecl vs. ParseStmtList without exposing the
// parser's token-type internals.  Call immediately after `New`
// (which preloads the first token) and before any parse call
// that consumes it.
func IsAtTopLevelDecl(p @Parser) bool {
	if p.tok.Typ == token.FUNC { return true }
	if p.tok.Typ == token.TYPE { return true }
	if p.tok.Typ == token.VAR { return true }
	if p.tok.Typ == token.CONST { return true }
	if p.tok.Typ == token.INTERFACE { return true }
	if p.tok.Typ == token.IMPL { return true }
	return false
}

// ParseStmtList parses statements until EOF.  Mirrors the inner loop
// of parseBlock but without the surrounding braces.  Used by the REPL
// to evaluate a bare statement list in immediate mode (e.g. multiple
// statements separated by newlines/semicolons typed at the prompt).
func ParseStmtList(p @Parser) @[]@ast.Stmt {
	var stmts @[]@ast.Stmt
	for p.tok.Typ != token.EOF {
		stmts = appendStmt(stmts, parseStmt(p))
		if !p.got(token.SEMICOLON) {
			if p.tok.Typ != token.EOF {
				p.errMsg("expected ; or end of input")
				p.next()
			}
		}
	}
	return stmts
}

// parseImportDecl parses a single or grouped import declaration.
func parseImportDecl(p @Parser) @[]@ast.ImportSpec {
	p.expect(token.IMPORT)

	if p.tok.Typ == token.LPAREN {
		// Grouped import
		p.next()
		var specs @[]@ast.ImportSpec
		for p.tok.Typ != token.RPAREN && p.tok.Typ != token.EOF {
			specs = appendImportSpec(specs, parseImportSpec(p))
			if !p.got(token.SEMICOLON) {
				break
			}
		}
		p.expect(token.RPAREN)
		return specs
	}

	var specs @[]@ast.ImportSpec
	specs = appendImportSpec(specs, parseImportSpec(p))
	return specs
}

// parseImportSpec parses a single import spec with optional alias and path.
func parseImportSpec(p @Parser) @ast.ImportSpec {
	var spec @ast.ImportSpec = make(ast.ImportSpec)
	spec.Pos = p.tok.Pos

	if p.tok.Typ == token.IDENT {
		spec.Alias = p.tok.Lit
		p.next()
	}
	if p.tok.Typ == token.STRING {
		spec.Path = p.tok.Lit
		p.next()
	} else {
		p.errMsg("expected import path string")
	}
	return spec
}

// parseTopLevelDecl parses a top-level declaration (func, type, var, or const).
func parseTopLevelDecl(p @Parser) @ast.Decl {
	if p.tok.Typ == token.FUNC {
		return parseFuncDecl(p)
	}
	if p.tok.Typ == token.TYPE {
		return parseTypeDecl(p)
	}
	if p.tok.Typ == token.VAR {
		return parseVarDecl(p)
	}
	if p.tok.Typ == token.CONST {
		return parseConstDecl(p)
	}
	if p.tok.Typ == token.INTERFACE {
		return parseInterfaceDecl(p)
	}
	if p.tok.Typ == token.IMPL {
		return parseImplDecl(p)
	}
	p.errMsg("expected declaration")
	p.next()
	return nil
}

