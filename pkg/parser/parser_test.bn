package "pkg/parser"

import "pkg/ast"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/token"

// Module-level source buffer — keeps the source alive while the parser borrows it.
var parserSrcBuf @[]uint8

// Helper to create a parser from a string.
// Stores the source in parserSrcBuf so the parser's borrow stays valid.
func mkParser(src *[]const char) @Parser {
	parserSrcBuf = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		parserSrcBuf[i] = cast(uint8, src[i])
	}
	return New(parserSrcBuf, "test.bn")
}

// Helper to build a failure message with context
func fail(msg *[]const char, detail *[]const char) testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(msg)
	cb = cb.WriteStr(": ")
	cb = cb.WriteStr(detail)
	var result @[]char = cb.Bytes()
	return result
}

// charEq compares two *[]const char for equality.
func charEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// ============================================================
// Type Tests
// ============================================================

func TestParseNamedType() testing.TestResult {
	var p @Parser = mkParser("int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_NAMED {
		return fail("TestParseNamedType", "expected TEXPR_NAMED")
	}
	if !charEq(te.Name, "int") {
		return fail("TestParseNamedType", "expected 'int'")
	}
	return ""
}

func TestParseQualifiedType() testing.TestResult {
	var p @Parser = mkParser("token.Type")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_NAMED {
		return fail("TestParseQualifiedType", "expected TEXPR_NAMED")
	}
	if !charEq(te.Pkg, "token") {
		return fail("TestParseQualifiedType", "expected pkg 'token'")
	}
	if !charEq(te.Name, "Type") {
		return fail("TestParseQualifiedType", "expected name 'Type'")
	}
	return ""
}

func TestParsePointerType() testing.TestResult {
	var p @Parser = mkParser("*int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_POINTER {
		return fail("TestParsePointerType", "expected TEXPR_POINTER")
	}
	if te.Base.Kind != ast.TEXPR_NAMED {
		return fail("TestParsePointerType", "expected NAMED base")
	}
	return ""
}

func TestParseSliceType() testing.TestResult {
	var p @Parser = mkParser("*[]int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_SLICE {
		return fail("TestParseSliceType", "expected TEXPR_SLICE")
	}
	return ""
}

func TestParseManagedPtrType() testing.TestResult {
	var p @Parser = mkParser("@Foo")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_MANAGED {
		return fail("TestParseManagedPtrType", "expected TEXPR_MANAGED")
	}
	return ""
}

func TestParseManagedSliceType() testing.TestResult {
	var p @Parser = mkParser("@[]int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_MANAGED_SLICE {
		return fail("TestParseManagedSliceType", "expected TEXPR_MANAGED_SLICE")
	}
	return ""
}

func TestParseArrayType() testing.TestResult {
	var p @Parser = mkParser("[10]int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_ARRAY {
		return fail("TestParseArrayType", "expected TEXPR_ARRAY")
	}
	return ""
}

// `const int` — const modifier on a named type.
func TestParseConstType() testing.TestResult {
	var p @Parser = mkParser("const int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_CONST {
		return fail("TestParseConstType", "expected TEXPR_CONST")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_NAMED {
		return fail("TestParseConstType", "expected NAMED base")
	}
	return ""
}

// `*const int` — pointer to const int. Outer is TEXPR_POINTER; its
// Base is TEXPR_CONST wrapping a NAMED int.
func TestParsePointerToConst() testing.TestResult {
	var p @Parser = mkParser("*const int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_POINTER {
		return fail("TestParsePointerToConst", "expected TEXPR_POINTER")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_CONST {
		return fail("TestParsePointerToConst", "expected CONST under POINTER")
	}
	if te.Base.Base == nil || te.Base.Base.Kind != ast.TEXPR_NAMED {
		return fail("TestParsePointerToConst", "expected NAMED under CONST")
	}
	return ""
}

// `const *int` — const pointer to int. Outer is TEXPR_CONST; its
// Base is TEXPR_POINTER.
func TestParseConstPointer() testing.TestResult {
	var p @Parser = mkParser("const *int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_CONST {
		return fail("TestParseConstPointer", "expected outer TEXPR_CONST")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_POINTER {
		return fail("TestParseConstPointer", "expected POINTER under CONST")
	}
	return ""
}

// `*[]const int` — raw slice of const int.
func TestParseRawSliceOfConst() testing.TestResult {
	var p @Parser = mkParser("*[]const int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_SLICE {
		return fail("TestParseRawSliceOfConst", "expected TEXPR_SLICE")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_CONST {
		return fail("TestParseRawSliceOfConst", "expected CONST element")
	}
	return ""
}

// `@[]const char` — managed slice of const char (spec'd default
// for string literals).
func TestParseManagedSliceOfConst() testing.TestResult {
	var p @Parser = mkParser("@[]const char")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_MANAGED_SLICE {
		return fail("TestParseManagedSliceOfConst", "expected TEXPR_MANAGED_SLICE")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_CONST {
		return fail("TestParseManagedSliceOfConst", "expected CONST element")
	}
	return ""
}

// `const const int` — two const modifiers stack (implementation is
// allowed to collapse, but AST-wise both appear).
func TestParseConstConst() testing.TestResult {
	var p @Parser = mkParser("const const int")
	var te @ast.TypeExpr = parseType(p)
	if te.Kind != ast.TEXPR_CONST {
		return fail("TestParseConstConst", "expected outer CONST")
	}
	if te.Base == nil || te.Base.Kind != ast.TEXPR_CONST {
		return fail("TestParseConstConst", "expected inner CONST")
	}
	if te.Base.Base == nil || te.Base.Base.Kind != ast.TEXPR_NAMED {
		return fail("TestParseConstConst", "expected NAMED at the bottom")
	}
	return ""
}

// *[]T raw-slice sugar (Stage 1 of plan-raw-slice-syntax.md).
// Same AST as *[]T (TEXPR_SLICE), just a second surface syntax.
func TestParseRawSliceStarSugar() testing.TestResult {
	var p @Parser = mkParser("*[]int")
	var te @ast.TypeExpr = parseType(p)
	var errs @[]ParseError = Errors(p)
	if len(errs) != 0 {
		return fail("TestParseRawSliceStarSugar", errs[0].Msg)
	}
	if te.Kind != ast.TEXPR_SLICE {
		return fail("TestParseRawSliceStarSugar", "expected TEXPR_SLICE")
	}
	if te.Base.Kind != ast.TEXPR_NAMED {
		return fail("TestParseRawSliceStarSugar", "expected NAMED elem")
	}
	if !charEq(te.Base.Name, "int") {
		return fail("TestParseRawSliceStarSugar", "expected int elem")
	}
	return ""
}

// *[]*[]char — nested raw-slice sugar.
func TestParseRawSliceStarSugarNested() testing.TestResult {
	var p @Parser = mkParser("*[]*[]char")
	var te @ast.TypeExpr = parseType(p)
	var errs @[]ParseError = Errors(p)
	if len(errs) != 0 {
		return fail("TestParseRawSliceStarSugarNested", errs[0].Msg)
	}
	if te.Kind != ast.TEXPR_SLICE {
		return fail("TestParseRawSliceStarSugarNested", "expected outer TEXPR_SLICE")
	}
	if te.Base.Kind != ast.TEXPR_SLICE {
		return fail("TestParseRawSliceStarSugarNested", "expected inner TEXPR_SLICE")
	}
	if !charEq(te.Base.Base.Name, "char") {
		return fail("TestParseRawSliceStarSugarNested", "expected char elem")
	}
	return ""
}

// *[10]int — bare *[<expr> is no longer valid; must use *([10]int).
func TestParseBareStarBracketArrayRejected() testing.TestResult {
	var p @Parser = mkParser("*[10]int")
	var te @ast.TypeExpr = parseType(p)
	if te == nil {
		return fail("TestParseBareStarBracketArrayRejected", "parseType returned nil")
	}
	var errs @[]ParseError = Errors(p)
	if len(errs) == 0 {
		return fail("TestParseBareStarBracketArrayRejected", "expected parse error, got none")
	}
	return ""
}

// *([10]int) — pointer-to-array via parens.
func TestParsePointerToArrayViaParens() testing.TestResult {
	var p @Parser = mkParser("*([10]int)")
	var te @ast.TypeExpr = parseType(p)
	var errs @[]ParseError = Errors(p)
	if len(errs) != 0 {
		return fail("TestParsePointerToArrayViaParens", errs[0].Msg)
	}
	if te.Kind != ast.TEXPR_POINTER {
		return fail("TestParsePointerToArrayViaParens", "expected TEXPR_POINTER")
	}
	if te.Base.Kind != ast.TEXPR_PAREN {
		return fail("TestParsePointerToArrayViaParens", "expected TEXPR_PAREN base")
	}
	if te.Base.Base.Kind != ast.TEXPR_ARRAY {
		return fail("TestParsePointerToArrayViaParens", "expected TEXPR_ARRAY inside paren")
	}
	return ""
}

// *(*[]int) — pointer-to-raw-slice via parens.
func TestParsePointerToSliceViaParens() testing.TestResult {
	var p @Parser = mkParser("*(*[]int)")
	var te @ast.TypeExpr = parseType(p)
	var errs @[]ParseError = Errors(p)
	if len(errs) != 0 {
		return fail("TestParsePointerToSliceViaParens", errs[0].Msg)
	}
	if te.Kind != ast.TEXPR_POINTER {
		return fail("TestParsePointerToSliceViaParens", "expected TEXPR_POINTER")
	}
	if te.Base.Kind != ast.TEXPR_PAREN {
		return fail("TestParsePointerToSliceViaParens", "expected TEXPR_PAREN base")
	}
	if te.Base.Base.Kind != ast.TEXPR_SLICE {
		return fail("TestParsePointerToSliceViaParens", "expected TEXPR_SLICE inside paren")
	}
	return ""
}



// ============================================================
// File Parsing Tests
// ============================================================

func TestParseImports() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nimport \"pkg/token\"\nimport \"pkg/ast\"\nfunc main() {}"
	var p @Parser = mkParser(src)
	var f @ast.File = ParseFile(p)
	if len(f.Imports) != 2 {
		return fail("TestParseImports", "expected 2 imports")
	}
	if !charEq(f.PkgName, "\"test\"") {
		return fail("TestParseImports", "expected pkg name '\"test\"'")
	}
	return ""
}

func TestParseNoErrors() testing.TestResult {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("package \"test\"\n")
	b = b.WriteStr("import \"pkg/token\"\n")
	b = b.WriteStr("func foo(x int) int { return x + 1 }\n")
	b = b.WriteStr("var y int = 10")
	var src @[]char = b.Bytes()
	var p @Parser = mkParser(src)
	var f @ast.File = ParseFile(p)
	var errs @[]ParseError = Errors(p)
	if len(errs) != 0 {
		return fail("TestParseNoErrors", errs[0].Msg)
	}
	if len(f.Decls) != 2 {
		return fail("TestParseNoErrors", "expected 2 decls")
	}
	return ""
}

func TestParseCompositeLit() testing.TestResult {
	var p @Parser = mkParser("Foo{x: 1, y: 2}")
	var e @ast.Expr = parseExpr(p)
	if e.Kind != ast.EXPR_COMPOSITE {
		return fail("TestParseCompositeLit", "expected EXPR_COMPOSITE")
	}
	if len(e.Elems) != 2 {
		return fail("TestParseCompositeLit", "expected 2 elements")
	}
	if e.Elems[0].Key == nil {
		return fail("TestParseCompositeLit", "expected key in element")
	}
	return ""
}

func TestParseMultiReturn() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc divmod(a int, b int) (int, int) { return a / b, a % b }"
	var p @Parser = mkParser(src)
	var f @ast.File = ParseFile(p)
	var errs @[]ParseError = Errors(p)
	if len(errs) != 0 {
		return fail("TestParseMultiReturn", errs[0].Msg)
	}
	var d @ast.Decl = f.Decls[0]
	if len(d.Results) != 2 {
		return fail("TestParseMultiReturn", "expected 2 results")
	}
	return ""
}
