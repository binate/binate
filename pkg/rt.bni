// Package rt is the Binate runtime, providing reference-counted memory
// management (alloc, free, refcount inc/dec), managed-slice creation,
// boxing, and bounds checking. Written in Binate; uses thin C stubs
// for malloc/free/memset/memcpy.
package "pkg/rt"

// Thin C wrappers (implemented in runtime/rt_stubs.c).
// These are internal — user code should use Alloc/Free/Box instead.

// c_malloc wraps C malloc.
func c_malloc(size int) *uint8

// c_calloc wraps C calloc (zero-initialized allocation).
func c_calloc(count int, size int) *uint8

// c_free wraps C free.
func c_free(ptr *uint8)

// c_memset wraps C memset.
func c_memset(ptr *uint8, val int, size int)

// c_memcpy wraps C memcpy.
func c_memcpy(dst *uint8, src *uint8, size int)

// c_exit wraps C exit.
func c_exit(code int)

// c_call_dtor calls a destructor function pointer on a payload pointer.
func c_call_dtor(dtor *uint8, ptr *uint8)

// c_bounds_fail prints a bounds-check failure message and exits.
func c_bounds_fail(index int, length int)

// Exit terminates the process with the given exit code. Currently
// a thin wrapper around c_exit; on a libc-free target this would
// dispatch through a syscall stub instead. Use this rather than
// c_exit directly so the rest of the codebase stays portable.
func Exit(code int)

// Malloc allocates size bytes of raw, unmanaged memory and returns
// a pointer to it. Currently a thin wrapper around c_malloc; on a
// libc-free target this would dispatch to a Binate-implemented
// allocator. The returned pointer must be released with CFree.
// For managed (refcounted) allocations, use Alloc instead.
func Malloc(size int) *uint8

// Calloc allocates count*size bytes of raw, zero-initialized,
// unmanaged memory. Wrapper around c_calloc; same portability story
// as Malloc.
func Calloc(count int, size int) *uint8

// CFree releases a raw allocation previously returned by Malloc /
// Calloc. Wrapper around c_free. For managed (refcounted)
// allocations, use Free instead.
func CFree(ptr *uint8)

// Memset writes val into the first size bytes of ptr. Wrapper
// around c_memset; on a libc-free target this dispatches to a
// pure-Binate implementation.
func Memset(ptr *uint8, val int, size int)

// Memcpy copies size bytes from src to dst (no overlap). Wrapper
// around c_memcpy; on a libc-free target this dispatches to a
// pure-Binate implementation.
func Memcpy(dst *uint8, src *uint8, size int)

// BoundsFail prints a bounds-check failure diagnostic and exits.
// Does not return. Wrapper around c_bounds_fail; on a libc-free
// target this dispatches to a target-specific abort path.
func BoundsFail(index int, length int)

// CallDtor invokes a destructor function pointer on a payload
// pointer. Wrapper around c_call_dtor; needed by the bytecode VM's
// extern dispatch path for dispatching destructors out of compiled
// code.
func CallDtor(dtor *uint8, ptr *uint8)

// Alloc allocates a managed payload of the given size with a 16-byte
// management header (refcount=1, free_fn=null) at negative offset.
func Alloc(payloadSize int) *uint8

// Free releases a managed allocation (header + payload).
func Free(ptr *uint8)

// RefInc increments the reference count. No-op on nil.
func RefInc(ptr *uint8)

// RefDec decrements the reference count. When it reaches 0, calls dtor(ptr)
// if dtor is non-nil, then frees the allocation. No-op if ptr is nil.
func RefDec(ptr *uint8, dtor *uint8)

// Refcount returns the current reference count of a managed allocation.
// Use bit_cast(*uint8, managedPtr) to obtain the raw pointer argument.
func Refcount(ptr *uint8) int

// ManagedSlice layout matches @[]T: { data, len, backing_refptr, backing_len }.
type ManagedSlice struct {
	Data       *uint8
	Len        int
	Refptr     *uint8
	BackingLen int
}

// Box copies size bytes from src into a new managed allocation and returns it.
func Box(src *uint8, size int) *uint8

// BoundsCheck panics if index is out of [0, length).
func BoundsCheck(index int, length int)

// MakeManagedSlice allocates a managed backing array for length elements of
// elemSize bytes each and returns a ManagedSlice with refcount=1.
func MakeManagedSlice(elemSize int, length int) ManagedSlice
