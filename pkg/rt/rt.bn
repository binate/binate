package "pkg/rt"

// Management header layout (2 words = 16 bytes):
//   word 0: refcount (int)
//   word 1: free function pointer (int, stored as int)
// Header sits at negative offset from payload pointer.

// HEADER_WORDS is the size of the management header in words (refcount + dtor).
const HEADER_WORDS int = 2
// HEADER_SIZE is the size of the management header in bytes (HEADER_WORDS * 8).
const HEADER_SIZE int = 16

// Exit terminates the process with the given exit code. Currently
// a thin wrapper around c_exit; on a libc-free target this would
// dispatch through a syscall stub instead.
func Exit(code int) {
	c_exit(code)
}

// RawAlloc allocates size bytes of uninitialized, unmanaged memory.
// Aborts the process if size <= 0 or on out-of-memory. See rt.bni
// for the full precondition contract.
func RawAlloc(size int) *uint8 {
	if size <= 0 {
		println("rt.RawAlloc: size must be > 0")
		Exit(1)
	}
	var p *uint8 = c_malloc(size)
	if p == nil {
		println("rt.RawAlloc: out of memory")
		Exit(1)
	}
	return p
}

// RawAllocZero allocates size bytes of zero-initialized, unmanaged
// memory. Aborts the process if size <= 0 or on out-of-memory.
func RawAllocZero(size int) *uint8 {
	if size <= 0 {
		println("rt.RawAllocZero: size must be > 0")
		Exit(1)
	}
	var p *uint8 = c_calloc(1, size)
	if p == nil {
		println("rt.RawAllocZero: out of memory")
		Exit(1)
	}
	return p
}

// RawFree releases a raw (RawAlloc / RawAllocZero) allocation.
// Distinct from Free, which releases managed (refcounted)
// allocations and walks the management header.
func RawFree(ptr *uint8) {
	if ptr == nil { return }
	c_free(ptr)
}

// MemCopy copies size bytes from src to dst. size == 0 is a no-op
// (no pointer requirements); size < 0 aborts.
func MemCopy(dst *uint8, src *const uint8, size int) {
	if size == 0 { return }
	if size < 0 {
		println("rt.MemCopy: size must be >= 0")
		Exit(1)
	}
	c_memcpy(dst, src, size)
}

// MemZero writes size zero bytes starting at ptr. size == 0 is a
// no-op (no pointer requirement); size < 0 aborts.
func MemZero(ptr *uint8, size int) {
	if size == 0 { return }
	if size < 0 {
		println("rt.MemZero: size must be >= 0")
		Exit(1)
	}
	c_memset(ptr, 0, size)
}

// BoundsFail prints a bounds-check failure diagnostic and aborts.
func BoundsFail(index int, length int) {
	c_bounds_fail(index, length)
}

// CallDtor invokes a destructor function pointer on a payload
// pointer.
func CallDtor(dtor *uint8, ptr *uint8) {
	c_call_dtor(dtor, ptr)
}

// Alloc allocates a managed object with the given payload size.
// Returns a pointer to the payload; the header (refcount=1, dtor=null)
// is at a negative offset. The payload is zero-initialized.
func Alloc(payloadSize int) *uint8 {
	var totalSize int = HEADER_SIZE + payloadSize
	var base *uint8 = c_malloc(totalSize)
	var header *int = bit_cast(*int, base)
	header[0] = 1  // refcount = 1
	header[1] = 0  // free_fn = null (default)
	var payload *uint8 = bit_cast(*uint8, &header[HEADER_WORDS])
	c_memset(payload, 0, payloadSize)
	return payload
}

// headerPtr returns a pointer to the management header for a managed payload.
// The header is HEADER_SIZE bytes before the payload pointer.
func headerPtr(ptr *uint8) *int {
	// ptr points to payload; header is HEADER_WORDS ints before it
	var asInt *int = bit_cast(*int, ptr)
	var addr int = bit_cast(int, asInt)
	var headerAddr int = addr - HEADER_SIZE
	return bit_cast(*int, headerAddr)
}

// Free releases the memory for a managed payload (including its header).
// ptr must be a managed payload pointer from Alloc, or nil (no-op).
func Free(ptr *uint8) {
	if ptr == nil { return }
	var h *int = headerPtr(ptr)
	c_free(bit_cast(*uint8, h))
}

// RefInc increments the reference count. ptr must be a managed payload pointer, or nil (no-op).
func RefInc(ptr *uint8) {
	if ptr == nil { return }
	var h *int = headerPtr(ptr)
	h[0] = h[0] + 1
}

// RefDec decrements the reference count. If it reaches zero, calls dtor (if non-nil)
// to clean up managed fields, then frees the allocation. ptr must be a managed
// payload pointer, or nil (no-op).
func RefDec(ptr *uint8, dtor *uint8) {
	if ptr == nil { return }
	var h *int = headerPtr(ptr)
	if h[0] <= 0 {
		c_bounds_fail(h[0], 0)  // abuse bounds_fail to print the bad refcount
	}
	h[0] = h[0] - 1
	if h[0] == 0 {
		if dtor != nil {
			c_call_dtor(dtor, ptr)
		}
		Free(ptr)
	}
}

// Refcount returns the current reference count of a managed allocation.
// ptr must be a managed payload pointer (i.e., the result of Alloc or
// the raw pointer underlying an @T). Use bit_cast to convert @T to *uint8.
func Refcount(ptr *uint8) int {
	if ptr == nil { return 0 }
	var h *int = headerPtr(ptr)
	return h[0]
}

// BoundsCheck aborts with a bounds-failure diagnostic if index is out of [0, length).
func BoundsCheck(index int, length int) {
	if index < 0 || index >= length {
		c_bounds_fail(index, length)
	}
}

// Box allocates a managed copy of size bytes from src and returns the payload pointer.
// The new allocation has refcount=1.
func Box(src *uint8, size int) *uint8 {
	var payload *uint8 = Alloc(size)
	c_memcpy(payload, src, size)
	return payload
}

// ManagedSlice layout matches @[]T: { data, len, backing_refptr, backing_len }
type ManagedSlice struct {
	Data       *uint8
	Len        int
	Refptr     *uint8
	BackingLen int
}

// MakeManagedSlice allocates a zero-initialized managed slice with the given
// element count. Returns a ManagedSlice where Data and Refptr point to the
// same allocation (refcount=1). If length is 0, Data and Refptr are nil.
func MakeManagedSlice(elemSize int, length int) ManagedSlice {
	var ms ManagedSlice
	if length > 0 {
		var ptr *uint8 = Alloc(length * elemSize)
		ms.Data = ptr
		ms.Refptr = ptr
	}
	ms.Len = length
	ms.BackingLen = length
	return ms
}
