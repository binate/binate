// Package slices provides generic helpers over managed-slices (`@[]T`),
// starting with Append.  It collapses the per-type `appendXxx` /
// `appendXxxPtr` helpers that were scattered across cmd/bnc's tree
// (one generic definition, monomorphized per concrete T at each call
// site) now that the BUILDER bnc understands generics.
package "pkg/slices"

// Generic managed-slice helpers.  The decls carry their bodies here
// (not just signatures) because Binate generics are monomorphized at
// the call site — a cross-package consumer reads the body from this
// `.bni` and specializes it for each concrete T.  See plan-generics.md
// Slice 7 / Q7.
//
// No type inference (claude-notes.md): callers spell the type argument
// explicitly, e.g. `slices.Append[@ast.Decl](xs, d)`.
//
// This package is a first step toward a coherent standard library;
// expect it to be folded into / renamed under that effort later.

// Append returns a new managed-slice with v appended.  O(n): allocates
// a fresh backing of len(s)+1 and copies the existing elements.  The
// per-type `appendXxx` / `appendXxxPtr` helpers scattered across
// cmd/bnc's tree collapse into call sites of this one generic.
func Append[T any](s @[]T, v T) @[]T {
	var n int = len(s)
	var ns @[]T = make_slice(T, n + 1)
	for i := 0; i < n; i++ {
		ns[i] = s[i]
	}
	ns[n] = v
	return ns
}
