package "pkg/slices"

import "pkg/builtin/testing"

func fail(msg @[]char) testing.TestResult { return msg }

// Append[int]: grows an int managed-slice, preserving order.
func TestAppendInt() testing.TestResult {
	var xs @[]int
	xs = Append[int](xs, 10)
	xs = Append[int](xs, 20)
	xs = Append[int](xs, 30)
	if len(xs) != 3 { return fail("expected len 3") }
	if xs[0] != 10 || xs[1] != 20 || xs[2] != 30 {
		return fail("wrong element order")
	}
	return ""
}

// Append returns a fresh backing — appending to the returned slice
// leaves the source slice's length unchanged.
func TestAppendDoesNotAliasOriginal() testing.TestResult {
	var a @[]int
	a = Append[int](a, 1)
	var b @[]int = Append[int](a, 2)
	if len(a) != 1 { return fail("original slice length mutated") }
	if len(b) != 2 { return fail("returned slice wrong length") }
	if a[0] != 1 || b[0] != 1 || b[1] != 2 {
		return fail("element copy wrong")
	}
	return ""
}

// Thing is a managed-allocated element type for exercising
// Append[@Thing] — the shape the appendXxxPtr migration targets
// (a managed-slice of managed pointers, `@[]@Thing`).
type Thing struct {
	v int
}

// Append[@Thing]: the managed-pointer element case — what the
// per-type `appendDeclPtr` / `appendFilePtr` / etc. helpers become
// (`slices.Append[@ast.Decl]` and friends).  Exercises the parser's
// `@T` type-argument support (the CRITICAL fix) plus monomorphizing
// T to a managed pointer: element pointers must survive the realloc
// + copy into the fresh backing.
func TestAppendManagedPtrElem() testing.TestResult {
	var t1 @Thing = make(Thing)
	t1.v = 100
	var t2 @Thing = make(Thing)
	t2.v = 200

	var xs @[]@Thing
	xs = Append[@Thing](xs, t1)
	xs = Append[@Thing](xs, t2)
	if len(xs) != 2 { return fail("expected len 2") }
	if xs[0].v != 100 || xs[1].v != 200 {
		return fail("managed-pointer elements not preserved")
	}

	var t3 @Thing = make(Thing)
	t3.v = 300
	xs = Append[@Thing](xs, t3)
	if len(xs) != 3 { return fail("expected len 3 after third append") }
	if xs[0].v != 100 || xs[1].v != 200 || xs[2].v != 300 {
		return fail("elements corrupted across realloc")
	}
	return ""
}
