// Package types implements type representation, construction, comparison,
// layout computation, scope/symbol management, and type checking for Binate.
package "pkg/types"

import "pkg/ast"
import "pkg/token"

// ============================================================
// Type Representations
// ============================================================

// TypeKind identifies what kind of type a Type represents.
const (
	TYP_INT int = iota
	TYP_FLOAT
	TYP_BOOL
	TYP_VOID
	TYP_NIL
	TYP_UNTYPED_INT
	TYP_UNTYPED_FLOAT
	TYP_UNTYPED_BOOL
	TYP_POINTER
	TYP_MANAGED_PTR
	TYP_SLICE
	TYP_MANAGED_SLICE
	TYP_ARRAY
	TYP_STRUCT
	TYP_FUNC
	TYP_FUNC_VALUE          // *func(args) ret — raw function value
	                        // (2-word {vtable, data}, 16 bytes)
	TYP_MANAGED_FUNC_VALUE  // @func(args) ret — managed function value
	                        // (2-word {vtable, data}, 16 bytes; data
	                        // pointer is refcounted)
	TYP_NAMED
	TYP_ALIAS
	TYP_CONST
	TYP_INTERFACE  // declared interface — stores the method set on
	               // the type's Methods table. Bare interface name
	               // is NOT a usable value-type expression (see
	               // plan-interface-syntax-revision.md); usable
	               // forms are *Iface and @Iface, lowered to the
	               // TYP_INTERFACE_VALUE / TYP_INTERFACE_VALUE_MANAGED
	               // kinds below. TYP_INTERFACE itself is stored on
	               // the SYM_INTERFACE entry for the declared name
	               // and is referenced from interface-value types
	               // via t.Elem.
	TYP_INTERFACE_VALUE          // *Iface — raw interface value
	                             // (2-word {data, vtable}, 16 bytes)
	TYP_INTERFACE_VALUE_MANAGED  // @Iface — managed interface value
	                             // (2-word {data, vtable}, 16 bytes;
	                             // data ptr is refcounted)
	NUM_TYPE_KINDS
)

// Type represents a resolved type.
type Type struct {
	Kind    int
	Name    @[]char
	Width   int
	Signed  bool

	// Pkg: short package name where this type is declared. Set for
	// TYP_INTERFACE so cross-package iface refs preserve their
	// canonical (Pkg, Name) identity through IR-gen and codegen.
	// Empty for primitive types and for types where Pkg is implied
	// by enclosing identity (e.g., TYP_STRUCT carries its qualified
	// name in Name itself; TYP_NAMED's package comes from its
	// declaration scope). Slice 2.7 of plan-cross-package-
	// interfaces.md.
	Pkg @[]char

	// For pointer, managed ptr, slice, managed slice, array
	Elem @Type

	// For array
	ArrayLen int

	// For struct
	Fields @[]@Field

	// For func
	Params  @[]@Param
	Results @[]@Type

	// For named (distinct type)
	Underlying @Type
	// Methods registered on this named type (declaration order). Only
	// meaningful when Kind == TYP_NAMED.
	Methods @[]@Method

	// For alias
	Target @Type
}

type Field struct {
	Name @[]char
	Type @Type
}

type Param struct {
	Name @[]char
	Type @Type
}

// Method describes a method registered on a named type. RecvType is the
// full receiver type as written (T, *T, @T, *const T, etc.); FuncType is
// the function signature with the receiver included as Params[0].
type Method struct {
	Name     @[]char
	RecvType @Type
	FuncType @Type
}

// ============================================================
// Predeclared Type Singletons
// ============================================================

// TypInt returns the predeclared int type.
func TypInt() @Type
// TypInt8 returns the predeclared int8 type.
func TypInt8() @Type
// TypInt16 returns the predeclared int16 type.
func TypInt16() @Type
// TypInt32 returns the predeclared int32 type.
func TypInt32() @Type
// TypInt64 returns the predeclared int64 type.
func TypInt64() @Type
// TypUint returns the predeclared uint type.
func TypUint() @Type
// TypUint8 returns the predeclared uint8 type.
func TypUint8() @Type
// TypUint16 returns the predeclared uint16 type.
func TypUint16() @Type
// TypUint32 returns the predeclared uint32 type.
func TypUint32() @Type
// TypUint64 returns the predeclared uint64 type.
func TypUint64() @Type
// TypFloat32 returns the predeclared float32 type.
func TypFloat32() @Type
// TypFloat64 returns the predeclared float64 type.
func TypFloat64() @Type
// TypBool returns the predeclared bool type.
func TypBool() @Type
// TypChar returns the predeclared char type.
func TypChar() @Type
// TypByte returns the predeclared byte type (alias for uint8).
func TypByte() @Type
// TypVoid returns the predeclared void type.
func TypVoid() @Type
// TypNil returns the predeclared nil type.
func TypNil() @Type
// TypUntypedInt returns the untyped integer constant type.
func TypUntypedInt() @Type
// TypUntypedFloat returns the untyped float constant type.
func TypUntypedFloat() @Type
// TypUntypedBool returns the untyped boolean constant type.
func TypUntypedBool() @Type

// ============================================================
// Type Construction
// ============================================================

// MakePointerType creates a raw pointer type (*elem).
func MakePointerType(elem @Type) @Type
// MakeManagedPtrType creates a managed pointer type (@elem).
func MakeManagedPtrType(elem @Type) @Type
// MakeSliceType creates a raw slice type (*[]elem).
func MakeSliceType(elem @Type) @Type
// MakeManagedSliceType creates a managed-slice type (@[]elem).
func MakeManagedSliceType(elem @Type) @Type
// MakeArrayType creates an array type ([length]elem).
func MakeArrayType(elem @Type, length int) @Type
// MakeStructType creates a struct type with the given name and fields.
func MakeStructType(name @[]char, fields @[]@Field) @Type
// MakeFuncType creates a function type with the given parameters and results.
func MakeFuncType(params @[]@Param, results @[]@Type) @Type
// MakeFuncValueType creates a raw function-value type (*func(args) ret).
// The 2-word {vtable, data} layout is uniform across signatures; the
// signature shows up only in vtable type generation downstream.
func MakeFuncValueType(params @[]@Param, results @[]@Type) @Type
// MakeManagedFuncValueType creates a managed function-value type
// (@func(args) ret). Same layout as MakeFuncValueType; the data
// pointer is refcounted.
func MakeManagedFuncValueType(params @[]@Param, results @[]@Type) @Type
// MakeNamedType creates a named (distinct) type with no underlying type set yet.
func MakeNamedType(name @[]char) @Type
// MakeAliasType creates a type alias that resolves to target.
func MakeAliasType(name @[]char, target @Type) @Type
// MakeInterfaceType creates a declared-interface type with no methods set,
// keyed by its defining package's short name. (Pkg, Name) is the canonical
// identity used by implCoversInterface so cross-package iface refs that
// share a Name don't false-match.
// yet. The Methods table is populated via AddMethod during type-checker
// pass-1 collection. See plan-interface-syntax-revision.md.
func MakeInterfaceType(pkg @[]char, name @[]char) @Type
// MakeInterfaceValueType wraps a TYP_INTERFACE in a raw interface-value
// type (`*Iface`). Layout is 2-word {data, vtable} (16 bytes), uniform
// across interfaces — the interface shows up only in vtable selection
// and method-dispatch checks downstream. The wrapped interface is
// stored as t.Elem.
func MakeInterfaceValueType(iface @Type) @Type
// MakeManagedInterfaceValueType wraps a TYP_INTERFACE in a managed
// interface-value type (`@Iface`). Same 2-word layout as
// MakeInterfaceValueType; the data pointer is refcounted.
func MakeManagedInterfaceValueType(iface @Type) @Type

// MakeMethod constructs a Method record. FuncType must include the
// receiver as Params[0].
func MakeMethod(name @[]char, recvType @Type, funcType @Type) @Method

// AddMethod appends m to the named type t's method set. Returns false
// (without modifying t) if a method with the same name is already
// present.
func (t @Type) AddMethod(m @Method) bool

// SetOrAppendMethod replaces an existing same-named method on t in
// place, or appends m if no match. REPL redefinition entry point:
// callers using SetOrAppendMethod in place of AddMethod opt out of
// the duplicate-method error so a method can be re-typed at the
// prompt. Returns false only if t isn't a method-bearing type.
func (t @Type) SetOrAppendMethod(m @Method) bool

// LookupMethod returns the method named `name` on the named type t, or
// nil if no such method is registered.
func (t @Type) LookupMethod(name *[]const char) @Method

// ReceiverBaseNamed unwraps a receiver type's outer pointer/managed/const
// wrappers and returns the underlying named type, or nil if the receiver
// is not (a wrapper around) a named type.
func (t @Type) ReceiverBaseNamed() @Type
// MakeConstType wraps inner with the const type modifier.
func MakeConstType(inner @Type) @Type
// IsConst reports whether t has the const modifier at its
// outermost level (after stripping aliases).
func (t @Type) IsConst() bool
// StripConst returns the inner type, peeling one const wrapper.
// Returns t unchanged if t is not const at the outermost level.
func (t @Type) StripConst() @Type

// ============================================================
// Type Queries
// ============================================================

// TypeName returns a human-readable name for the type.
func (t @Type) TypeName() @[]char
// IsInteger reports whether t is an integer type.
func (t @Type) IsInteger() bool

// IsFloat reports whether t is a floating-point type.
func (t @Type) IsFloat() bool
// IsNumeric reports whether t is a numeric type.
func (t @Type) IsNumeric() bool
// IsBool reports whether t is a boolean type.
func (t @Type) IsBool() bool
// IsPointer reports whether t is a pointer type (raw or managed).
func (t @Type) IsPointer() bool
// IsSlice reports whether t is a slice type (raw or managed).
func (t @Type) IsSlice() bool
// IsNillable reports whether t can be assigned nil.
func (t @Type) IsNillable() bool
// Identical reports whether types a and b are structurally identical.
func (a @Type) Identical(b @Type) bool
// AssignableTo reports whether a value of type src is assignable to type dst.
func (src @Type) AssignableTo(dst @Type) bool
// ResolveAlias follows alias chains and returns the underlying type.
func (t @Type) ResolveAlias() @Type
// SliceElem returns the element type of a slice or managed-slice type.
func (t @Type) SliceElem() @Type
// PointerElem returns the element type of a pointer or managed pointer type.
func (t @Type) PointerElem() @Type
// FieldByName looks up a struct field by name, returning nil if not found.
func (t @Type) FieldByName(name *[]const char) @Field
// NeedsDestruction reports whether t contains managed pointers requiring cleanup.
func (t @Type) NeedsDestruction() bool

// ============================================================
// Type Layout
// ============================================================

// TargetInfo describes the target platform's basic properties.
type TargetInfo struct {
	PointerSize int    // 4 or 8
	IntSize     int    // typically == PointerSize
	MaxAlign    int    // typically == PointerSize
}

// SetTarget configures the target platform properties for layout computation.
func SetTarget(info TargetInfo)
// GetTarget returns the current target platform properties.
func GetTarget() TargetInfo

// SizeOf computes the size in bytes of a value of type t.
func (t @Type) SizeOf() int
// AlignOf computes the alignment requirement in bytes of type t.
func (t @Type) AlignOf() int
// FieldOffset computes the byte offset of the field at the given index in a struct.
func (t @Type) FieldOffset(index int) int

// FieldLayout describes one field's position in the physical struct layout.
type FieldLayout struct {
	FieldIndex    int
	Offset        int
	Size          int
	PaddingBefore int
}

// StructLayout computes the physical layout of all fields in a struct type.
func (t @Type) StructLayout() @[]FieldLayout
// TrailingPadding computes the number of padding bytes after the last field in a struct.
func (t @Type) TrailingPadding() int

// Slice field indices
const SLICE_FIELD_DATA int = 0
const SLICE_FIELD_LEN int = 1

// Managed-slice field indices
const MSLICE_FIELD_DATA int = 0
const MSLICE_FIELD_LEN int = 1
const MSLICE_FIELD_BACKING int = 2
const MSLICE_FIELD_BACKING_LEN int = 3

// SliceDataOffset returns the byte offset of the data pointer in a raw slice.
func SliceDataOffset() int
// SliceLenOffset returns the byte offset of the length field in a raw slice.
func SliceLenOffset() int
// MSliceDataOffset returns the byte offset of the data pointer in a managed-slice.
func MSliceDataOffset() int
// MSliceLenOffset returns the byte offset of the length field in a managed-slice.
func MSliceLenOffset() int
// MSliceBackingOffset returns the byte offset of the backing pointer in a managed-slice.
func MSliceBackingOffset() int
// MSliceBackingLenOffset returns the byte offset of the backing length in a managed-slice.
func MSliceBackingLenOffset() int
// ManagedHeaderSize returns the size in bytes of the managed allocation header.
func ManagedHeaderSize() int
// ManagedRefcountOffset returns the byte offset of the refcount in a managed header.
func ManagedRefcountOffset() int
// ManagedFreeFnOffset returns the byte offset of the free function pointer in a managed header.
func ManagedFreeFnOffset() int

// ============================================================
// Scope and Symbols
// ============================================================

const (
	SYM_VAR int = iota
	SYM_CONST
	SYM_TYPE
	SYM_FUNC
	SYM_PKG
	SYM_INTERFACE  // declared interface (not a value type — see
	               // plan-interface-syntax-revision.md). Only legal
	               // in `*Iface` / `@Iface` type expressions, on the
	               // LHS of an `impl T : Iface` decl, or as the
	               // target of an interface alias.
)

type Symbol struct {
	Name    @[]char
	Type    @Type
	Kind    int
	PkgPath @[]char
}

type Scope struct {
	Parent  @Scope
	Syms    @[]@Symbol
}

// NewScope creates a new scope with the given parent (nil for the top-level scope).
func NewScope(parent @Scope) @Scope
// Define adds a symbol to the scope.
func (s @Scope) Define(sym @Symbol)
// Lookup searches for a symbol by name in the scope and its parents.
func (s @Scope) Lookup(name *[]const char) @Symbol

// ============================================================
// Checker
// ============================================================

type CheckError struct {
	Pos token.Pos
	Msg @[]char
}

type Checker struct {
	Errors    @[]CheckError
	Scope     @Scope
	FuncRet   @[]@Type
	Packages  @[]@PkgEntry
	Iota      int
	InLoop    bool  // true inside for loops (break + continue valid)
	InSwitch  bool  // true inside switch (break valid, continue not)

	// AllowRedef: when true, suppresses the bni-vs-bn signature
	// match check that normally fires whenever a function name is
	// already in local scope.  Set by REPL entry points
	// (CheckDeclInScope) so re-typing a func at the prompt isn't
	// reported as a "bni declared X" mismatch.  Off by default;
	// the compile-time path keeps the check active.
	AllowRedef bool

	// PackageScope: the file/package-level scope, captured at the
	// start of pass-2 body checking. Used by checkFuncLit (Slice A.7
	// of plan-function-values.md) to prevent function literals from
	// capturing enclosing-function locals: the literal's body is
	// checked with PackageScope as the parent, skipping any
	// intermediate function/block scopes.
	PackageScope @Scope

	// Type registry: maps ResolvedTypeID → Type.
	// Populated during type checking; queried by downstream tools (linter, etc.).
	ExprTypes    @[]@Type
	NumExprTypes int

	// Impls: collected `impl T : Iface, ...` declarations. Slice 2.1
	// of plan-interface-syntax-revision.md only collects (resolves
	// the receiver type and interface names); satisfaction checks
	// land in a follow-up slice.
	Impls @[]@Impl

	// Tier 3 forward references — pending decl tracking.  When
	// TentativeMode is set, ALL errors during the body check
	// route to TentativeErrors instead of the user-visible
	// Errors slice.  errUndefined ALSO captures the name in
	// TentativeMissing.  After the body check, the REPL driver
	// uses this to decide:
	//   - TentativeMissing non-empty → park the decl (the
	//     missing names are why; the cascading errors that
	//     followed them are noise).
	//   - TentativeMissing empty but TentativeErrors non-empty
	//     → real errors with no missing-name blame; migrate
	//     them to Errors so the user sees them.
	TentativeMode    bool
	TentativeMissing @[]@[]char
	TentativeErrors  @[]CheckError
	Pending          @[]@PendingDecl
}

// PendingDecl is one parked declaration that couldn't fully
// resolve at first-check time because it referenced names not
// yet bound.  Held in Checker.Pending; the REPL driver retries
// each entry after every subsequent decl, removing those that
// now resolve cleanly.
type PendingDecl struct {
	Decl         @ast.Decl
	MissingNames @[]@[]char
}

// Impl records a single `impl T : I1, I2, ...` declaration. The
// receiver type captures the receiver-kind nuance (TYP_POINTER vs
// TYP_MANAGED_PTR vs the bare type, plus const) so that downstream
// satisfaction checks and codegen can route correctly. Each
// interface entry is a TYP_INTERFACE.
type Impl struct {
	Pos        token.Pos
	RecvType   @Type
	Interfaces @[]@Type
}

type PkgEntry struct {
	Path  @[]char
	Scope @Scope
}

// NewChecker creates a new type checker with predeclared types in scope.
func NewChecker() @Checker
// WithChecker installs c as the active checker for query routines
// that need impl/decl context (currently AssignableTo's interface-
// value arm). Returns the previously-installed checker; pair with
// RestoreChecker on exit.
func WithChecker(c @Checker) @Checker
// RestoreChecker reinstalls a previously-active checker captured
// from WithChecker.
func RestoreChecker(prev @Checker)
// WithPkgShort installs `pkg` as the active package short-name for
// MakeInterfaceType's Pkg-stamping. Returns the previous value;
// pair with RestorePkgShort. Slice 2.7.
func WithPkgShort(pkg @[]char) @[]char
// RestorePkgShort reinstalls the previously-active package short-
// name captured from WithPkgShort.
func RestorePkgShort(prev @[]char)
// Check type-checks a single file and records any errors in the checker.
func (c @Checker) Check(file @ast.File)
// CheckPackage type-checks a merged package file and registers it by path.
func (c @Checker) CheckPackage(path @[]char, merged @ast.File)
// LoadPackageInterface loads type information from a .bni interface file.
func LoadPackageInterface(c @Checker, path @[]char, bni @ast.File)
// CheckMainPersistent type-checks a main source file like Check but
// leaves the file's scope installed on c.Scope when it returns, so
// a REPL session can issue subsequent CheckExpr / CheckStmtList
// calls against that scope.
func (c @Checker) CheckMainPersistent(file @ast.File)
// CheckDeclInScope type-checks a single top-level declaration
// against c.Scope — registers the symbol persistently and checks
// the body / initializer.  REPL entry point for Tier 2.
//
// Tier 3 forward refs: for DECL_FUNC, the body check runs in
// tentative mode.  If it referenced names not yet bound, the
// decl is parked on c.Pending and the missing names are
// returned via c.TentativeMissing — the REPL driver detects
// this and skips IR-gen.  Sig check is always immediate so the
// func's symbol enters c.Scope and other code can reference it.
func (c @Checker) CheckDeclInScope(d @ast.Decl)

// IsDeclPending reports whether the most recent CheckDeclInScope
// call parked its decl.  Equivalent to checking whether
// `c.TentativeMissing` is non-empty after the call.  Caller
// (REPL driver) uses this to gate IR-gen.
func IsDeclPending(c @Checker) bool

// RetryPendingDecls re-runs the body check on every entry in
// c.Pending.  Returns the decls that now resolve cleanly
// (caller IR-gens them) and removes them from the queue.
// Decls still missing names stay parked.  Called by the REPL
// driver after every subsequent decl that successfully binds
// new names.
func RetryPendingDecls(c @Checker) @[]@ast.Decl

// IsPendingFunc reports whether `name` is currently parked in
// the checker's pending queue (a func whose body couldn't be
// fully checked yet because it referenced names that weren't
// bound).  Use-site call paths can surface a clear error via
// this rather than letting a parked symbol's stale type
// propagate.
func IsPendingFunc(c @Checker, name *[]const char) bool

// LookupMethodForDecl returns the method (if any) currently
// registered on the named base type of d.Recv with name d.Name,
// or nil if d isn't a method or no match is registered.  REPL
// driver calls this BEFORE CheckDeclInScope on a method decl to
// capture the pre-redef sig (CheckDeclInScope overwrites it via
// SetOrAppendMethod when c.AllowRedef is set), so the driver
// can decide replace vs shadow at the IR/VM layers.
func LookupMethodForDecl(c @Checker, d @ast.Decl) @Method

// CheckExprInScope type-checks a single expression against c.Scope.
// REPL entry point; returns the resolved expression type.
func (c @Checker) CheckExprInScope(e @ast.Expr) @Type
// CheckStmtListInScope type-checks a statement list against c.Scope.
// REPL entry point; errors are appended to c.Errors.
func (c @Checker) CheckStmtListInScope(ss @[]@ast.Stmt)
// CheckerErrors returns the list of type errors accumulated during checking.
func (c @Checker) CheckerErrors() @[]CheckError
// ExprType returns the resolved type for an expression by its ResolvedTypeID.
// Returns nil if the ID is 0 (unresolved) or out of range.
func ExprType(c @Checker, id int) @Type
