package "pkg/types"

import "pkg/builtin/testing"

// check_builtin.bn handles the per-builtin shape rules. The happy
// paths are exercised end-to-end by the conformance suite and by
// check_expr_test.bn (sizeof, make_slice, etc.). These tests pin
// the diagnostic-emission paths — wrong arity, wrong arg type,
// wrong arg shape — that are easy to silently regress.

// make_slice requires an integer length argument. A non-integer
// must produce a check error (not silently pass).
func TestCheckBuiltinMakeSliceLenMustBeInt() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar s @[]int = make_slice(int, true)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("make_slice with non-int length must error")
	}
	return ""
}

// box(arg) returns a managed pointer to the boxed value. The arg
// type's default (e.g., untyped int → int) determines the result's
// element type.
func TestCheckBuiltinBoxReturnsManagedPtr() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar p @int = box(42)\n")
	return expectNoErrors(c)
}

// len's argument must be a slice or array — passing a bare int is
// a type error.
func TestCheckBuiltinLenRequiresSliceOrArray() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar n int = len(42)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("len(int) must error")
	}
	return ""
}

// _raw_func_addr(x) must reject anything other than a named-function
// reference. A bare int literal must not slip through (regression
// guard for the EXPR_IDENT/EXPR_SELECTOR shape check).
func TestCheckBuiltinRawFuncAddrRejectsNonFunc() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar p *uint8 = _raw_func_addr(42)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("_raw_func_addr(42) must error")
	}
	return ""
}

// _raw_func_addr on a named function in the local package is
// accepted and returns *uint8.
func TestCheckBuiltinRawFuncAddrAcceptsNamedFunc() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc helper() { }\nvar p *uint8 = _raw_func_addr(helper)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// _func_handle is the canonical spelling post-Phase-4 of
// plan-uniform-native-fnptrs.md.  Both end-to-end behaviors
// (reject non-func / accept named func) parallel the
// `_raw_func_addr` tests above to make sure the type-checker
// treats the two spellings identically — the alias is purely a
// lexer concern.
func TestCheckBuiltinFuncHandleRejectsNonFunc() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar p *uint8 = _func_handle(42)\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("_func_handle(42) must error")
	}
	return ""
}

func TestCheckBuiltinFuncHandleAcceptsNamedFunc() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc helper() { }\nvar p *uint8 = _func_handle(helper)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// __c_call returns its declared return type; scalar args are accepted.
func TestCheckCCallBasic() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nfunc f(x int32) int32 { return __c_call(\"abs\", int32, x) }\n")
	return expectNoErrors(c)
}

// A managed-slice argument has no clean C ABI — must error (the caller
// should pass a pointer to the underlying data instead).
func TestCheckCCallRejectsManagedSlice() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nfunc f(s @[]char) int { return __c_call(\"g\", int, s) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("__c_call managed-slice arg must error")
	}
	return ""
}

// Pointer arguments — the other half of the v1 contract — must be
// accepted alongside scalars (a regression here would block almost
// every real C call: write(buf), read(buf), strlen(s), free(p) …).
func TestCheckCCallPointerArg() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nfunc f(p *uint8) int { return __c_call(\"strlen\", int, p) }\n")
	return expectNoErrors(c)
}

// Struct return is a planned later addition — until codegen handles
// the sret path, the type checker must reject it (a silent-pass would
// reach codegen and emit malformed IR).
func TestCheckCCallRejectsStructReturn() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\ntype Pair struct { x int; y int }\nfunc f() Pair { return __c_call(\"makePair\", Pair) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("__c_call struct return must error")
	}
	return ""
}

// Variadic __c_call is not yet supported (Stage 1) — the `...` marker
// must produce a diagnostic, not a silently-miscompiled call.
func TestCheckCCallVariadicRejected() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nfunc f(x int32) int32 { return __c_call(\"h\", int32, x, ..., x) }\n")
	if len(c.CheckerErrors()) == 0 {
		return fail("variadic __c_call must error")
	}
	return ""
}

// unsafe_index requires an integer index — passing a non-integer
// must error (mirrors the rule for `coll[idx]`).
func TestCheckBuiltinUnsafeIndexIndexMustBeInt() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc f() { var x int = unsafe_index(make_slice(int, 4), true) }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return fail("unsafe_index with non-int index must error")
	}
	return ""
}

// unsafe_index requires a slice/array/pointer collection. A bare
// integer is not indexable.
func TestCheckBuiltinUnsafeIndexCollMustBeIndexable() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc f() { var x int = unsafe_index(42, 0) }\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return fail("unsafe_index on non-indexable must error")
	}
	return ""
}

// sizeof / alignof require a type argument (TypeRef set), not an
// expression. The parser enforces shape; this pins the resolver
// path that runs against the resolved type.
func TestCheckBuiltinSizeofResolvesType() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nvar n uint = sizeof(*[]int)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// sizeof of an unknown named type must surface the underlying
// "undefined" diagnostic from resolveTypeExpr — confirming the
// builtin path doesn't swallow resolver errors.
func TestCheckBuiltinSizeofPropagatesUndefined() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nvar n uint = sizeof(NoSuchType)\n"
	var c @Checker = checkSrc(src)
	if len(c.CheckerErrors()) == 0 {
		return fail("sizeof of unknown type must report undefined")
	}
	return ""
}
