package "pkg/types"

import "pkg/ast"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/parser"

// Tests that exercise the func/method-decl machinery in
// check_decl_func.bn: simple func decls, the missing-return /
// termination analysis, and method declarations.

// ============================================================
// Function declarations
// ============================================================

func TestCheckFuncDecl() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc add(a int, b int) int { return a + b }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFuncReturnTypeMismatch() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc f() int { return true }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// Termination analysis / missing-return detection
// ============================================================

// Void function with no return is fine (no check applies).
func TestMissingReturnVoidOk() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc f() { }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Missing return at end of non-void function is an error.
func TestMissingReturnFallthrough() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc f() int { var x int = 1 }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// if without else cannot terminate — fall-through possible.
func TestMissingReturnIfNoElse() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f(x int) int { if x > 0 { return 1 } }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// if/else where only one branch returns is an error.
func TestMissingReturnIfElsePartial() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f(x int) int {\n")
	cb = cb.WriteStr("  if x > 0 { return 1 } else { var y int = 2 }\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// if/else where both branches return terminates.
func TestTerminatesIfElseBothReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f(x int) int {\n")
	cb = cb.WriteStr("  if x > 0 { return 1 } else { return -1 }\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Unconditional for-loop with no break terminates.
func TestTerminatesForNoBreak() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f() int { for { var x int = 1 } }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Unconditional for-loop with a top-level break does NOT terminate.
func TestMissingReturnForWithBreak() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f() int { for { break } }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// for with a condition does NOT terminate (the cond may be false).
func TestMissingReturnForWithCond() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f() int {\n")
	cb = cb.WriteStr("  for i := 0; i < 10; i++ { }\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Switch with default + all cases terminating = terminates.
func TestTerminatesSwitchWithDefault() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f(x int) int {\n")
	cb = cb.WriteStr("  switch x {\n")
	cb = cb.WriteStr("  case 1: return 10\n")
	cb = cb.WriteStr("  default: return 0\n")
	cb = cb.WriteStr("  }\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Switch with no default does NOT terminate.
func TestMissingReturnSwitchNoDefault() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f(x int) int {\n")
	cb = cb.WriteStr("  switch x {\n")
	cb = cb.WriteStr("  case 1: return 10\n")
	cb = cb.WriteStr("  case 2: return 20\n")
	cb = cb.WriteStr("  }\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Switch where one case doesn't return does NOT terminate.
func TestMissingReturnSwitchCaseNoReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f(x int) int {\n")
	cb = cb.WriteStr("  switch x {\n")
	cb = cb.WriteStr("  case 1: return 10\n")
	cb = cb.WriteStr("  default: var y int = 0\n")
	cb = cb.WriteStr("  }\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Switch case containing a top-level `break` does NOT terminate
// (break escapes the switch without returning).
func TestMissingReturnSwitchCaseBreak() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f(x int) int {\n")
	cb = cb.WriteStr("  switch x {\n")
	cb = cb.WriteStr("  case 1: break\n")
	cb = cb.WriteStr("  default: return 0\n")
	cb = cb.WriteStr("  }\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Nested: a `break` inside a nested for should not disqualify the
// outer for { } as terminating.
func TestTerminatesNestedBreakIgnored() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f() int {\n")
	cb = cb.WriteStr("  for {\n")
	cb = cb.WriteStr("    for i := 0; i < 3; i++ { break }\n")
	cb = cb.WriteStr("  }\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// panic(...) as the final statement is a terminator. Non-void
// functions need not have an explicit return after a panic.
func TestTerminatesPanic() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc f() int { panic(\"nope\") }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// panic in the fall-through position after a conditional return.
func TestTerminatesIfReturnElsePanic() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f(x int) int {\n")
	cb = cb.WriteStr("  if x > 0 { return x }\n")
	cb = cb.WriteStr("  panic(\"nope\")\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// panic in both branches of an if/else.
func TestTerminatesIfElseBothPanic() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func f(x int) int {\n")
	cb = cb.WriteStr("  if x > 0 { panic(\"a\") } else { panic(\"b\") }\n")
	cb = cb.WriteStr("}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Regular function calls that look like panic but aren't are not
// terminators. A return is still required.
func TestNonPanicExprDoesNotTerminate() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func g() { }\n")
	cb = cb.WriteStr("func f() int { g() }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// Method declarations (Stage 2 of plan-receivers.md)
// ============================================================

func TestCheckMethodPointerRecv() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Point struct { x int; y int }\n")
	cb = cb.WriteStr("func (p *Point) X() int { return p.x }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodValueRecv() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Counter struct { n int }\n")
	cb = cb.WriteStr("func (c Counter) Get() int { return c.n }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodManagedRecv() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Node struct { val int }\n")
	cb = cb.WriteStr("func (n @Node) Val() int { return n.val }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodOnNamedPrimitive() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Celsius int\n")
	cb = cb.WriteStr("func (c Celsius) Zero() bool { return false }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodOnAliasIsError() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type MyInt = int\n")
	cb = cb.WriteStr("func (m MyInt) Get() int { return 0 }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

func TestCheckMethodOnBuiltinIsError() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc (i int) Foo() int { return 0 }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckMethodDuplicateIsError() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Point struct { x int }\n")
	cb = cb.WriteStr("func (p *Point) X() int { return p.x }\n")
	cb = cb.WriteStr("func (p *Point) X() int { return 0 }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Free function and method with the same name are allowed: methods
// live in per-type method sets, not the package symbol table.
func TestCheckMethodAndFreeFunctionSameNameOK() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Point struct { x int }\n")
	cb = cb.WriteStr("func (p *Point) Foo() int { return p.x }\n")
	cb = cb.WriteStr("func Foo() int { return 42 }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Two methods with the same name on different types are allowed.
func TestCheckMethodSameNameDifferentTypesOK() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type A struct { x int }\n")
	cb = cb.WriteStr("type B struct { y int }\n")
	cb = cb.WriteStr("func (a *A) Get() int { return a.x }\n")
	cb = cb.WriteStr("func (b *B) Get() int { return b.y }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// The receiver name must be visible inside the method body.
func TestCheckMethodBodySeesReceiver() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Point struct { x int; y int }\n")
	cb = cb.WriteStr("func (p *Point) Sum() int { return p.x + p.y }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Method bodies type-check normally; an int-vs-bool mismatch is reported.
func TestCheckMethodBodyTypeError() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Point struct { x int }\n")
	cb = cb.WriteStr("func (p *Point) X() bool { return p.x }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// ============================================================
// Method redefinition (Tier 4 follow-up: REPL prompt)
// ============================================================

// SetOrAppendMethod replaces a same-named method on the type's
// method set in place; AddMethod refuses.  This is the substrate
// the REPL c.AllowRedef branch in collectMethodDecl uses.
//
// We distinguish the old vs new entry by giving them different
// FuncType return types (int vs bool) and comparing via
// Identical — direct @Method comparison isn't supported by the
// bootstrap interpreter.
func TestSetOrAppendMethodReplaces() testing.TestResult {
	var t @Type = MakeNamedType(buf.CopyStr("Counter"))
	var noParams @[]@Param

	var resInt @[]@Type = make_slice(@Type, 1)
	resInt[0] = TypInt()
	var ftInt @Type = MakeFuncType(noParams, resInt)

	var resBool @[]@Type = make_slice(@Type, 1)
	resBool[0] = TypBool()
	var ftBool @Type = MakeFuncType(noParams, resBool)

	if !t.AddMethod(MakeMethod(buf.CopyStr("Inc"), t, ftInt)) {
		return fail("first AddMethod failed")
	}
	if len(t.Methods) != 1 { return fail("expected 1 method after first add") }

	if !t.SetOrAppendMethod(MakeMethod(buf.CopyStr("Inc"), t, ftBool)) {
		return fail("SetOrAppendMethod returned false")
	}
	if len(t.Methods) != 1 {
		return fail("expected method-set length to stay at 1 after replace")
	}
	if !t.Methods[0].FuncType.Identical(ftBool) {
		return fail("expected the new (bool-returning) FuncType in place")
	}
	return ""
}

// SetOrAppendMethod with a fresh name behaves like AddMethod
// (appends, doesn't replace).
func TestSetOrAppendMethodAppendsFresh() testing.TestResult {
	var t @Type = MakeNamedType(buf.CopyStr("Counter"))
	var noParams @[]@Param
	var noResults @[]@Type
	var ft @Type = MakeFuncType(noParams, noResults)
	if !t.SetOrAppendMethod(MakeMethod(buf.CopyStr("Inc"), t, ft)) {
		return fail("first SetOrAppendMethod failed")
	}
	if !t.SetOrAppendMethod(MakeMethod(buf.CopyStr("Dec"), t, ft)) {
		return fail("second SetOrAppendMethod failed")
	}
	if len(t.Methods) != 2 {
		return fail("expected 2 methods on the type after distinct names")
	}
	return ""
}

// CheckDeclInScope on a method redef does NOT error (sets
// AllowRedef, which routes collectMethodDecl through
// SetOrAppendMethod) — and the receiver type's method set still
// has only one entry by that name.  This is the type-checker
// half of the REPL "method redefinition" Tier 4 follow-up.
func TestCheckDeclInScopeMethodRedefSameSig() testing.TestResult {
	var src *[]const char =
		"package \"test\"\ntype Counter struct { n int }\nfunc main() {}\n"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	var f @ast.File = parser.ParseFile(p)
	var c @Checker = NewChecker()
	CheckMainPersistent(c, f)
	if len(CheckerErrors(c)) != 0 {
		return fail("loading base file produced errors")
	}

	// First-time method definition.
	var m1Src *[]const char =
		"func (c *Counter) Inc() { c.n = c.n + 1 }"
	var p1 @parser.Parser = parser.New(toBytes(m1Src), "<repl>")
	var d1 @ast.Decl = parser.ParseTopLevelDecl(p1)
	CheckDeclInScope(c, d1)
	if len(CheckerErrors(c)) != 0 {
		return fail("first method definition errored")
	}

	// Redefinition with the same sig.
	var m2Src *[]const char =
		"func (c *Counter) Inc() { c.n = c.n + 2 }"
	var p2 @parser.Parser = parser.New(toBytes(m2Src), "<repl>")
	var d2 @ast.Decl = parser.ParseTopLevelDecl(p2)
	CheckDeclInScope(c, d2)
	if len(CheckerErrors(c)) != 0 {
		return fail("method redef under AllowRedef should not error")
	}

	// Receiver type's method set still has exactly one Inc.
	var counterSym @Symbol = c.Scope.Lookup("Counter")
	if counterSym == nil || counterSym.Type == nil {
		return fail("Counter not found in scope")
	}
	var count int = 0
	for i := 0; i < len(counterSym.Type.Methods); i++ {
		if charEq(counterSym.Type.Methods[i].Name, "Inc") {
			count = count + 1
		}
	}
	if count != 1 {
		return fail("expected exactly one Inc on Counter after redef")
	}
	return ""
}

// LookupMethodForDecl returns the registered Method (used by the
// REPL driver to capture the pre-redef sig before
// CheckDeclInScope overwrites it).
func TestLookupMethodForDeclFindsExisting() testing.TestResult {
	var src *[]const char =
		"package \"test\"\ntype Counter struct { n int }\nfunc (c *Counter) Inc() {}\nfunc main() {}\n"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	var f @ast.File = parser.ParseFile(p)
	var c @Checker = NewChecker()
	CheckMainPersistent(c, f)
	if len(CheckerErrors(c)) != 0 { return fail("setup errored") }

	var redefSrc *[]const char =
		"func (c *Counter) Inc() { c.n = 1 }"
	var rp @parser.Parser = parser.New(toBytes(redefSrc), "<repl>")
	var d @ast.Decl = parser.ParseTopLevelDecl(rp)
	var existing @Method = LookupMethodForDecl(c, d)
	if existing == nil {
		return fail("expected to find existing Inc method")
	}
	if !charEq(existing.Name, "Inc") {
		return fail("LookupMethodForDecl returned wrong method")
	}
	return ""
}

// LookupMethodForDecl returns nil for a free func decl, an
// unknown receiver type, or a decl whose method isn't yet
// registered.  Same nil-on-miss contract the REPL driver relies
// on to detect first-time-definition vs redef.
func TestLookupMethodForDeclNilOnMiss() testing.TestResult {
	var src *[]const char =
		"package \"test\"\ntype Counter struct { n int }\nfunc main() {}\n"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	var f @ast.File = parser.ParseFile(p)
	var c @Checker = NewChecker()
	CheckMainPersistent(c, f)

	// Free func: nil.
	var freeSrc *[]const char = "func plain() int { return 0 }"
	var fp @parser.Parser = parser.New(toBytes(freeSrc), "<repl>")
	var fd @ast.Decl = parser.ParseTopLevelDecl(fp)
	if LookupMethodForDecl(c, fd) != nil {
		return fail("expected nil for a free func decl")
	}

	// Unknown receiver type: nil.
	var unkSrc *[]const char = "func (u *Unknown) M() {}"
	var up @parser.Parser = parser.New(toBytes(unkSrc), "<repl>")
	var ud @ast.Decl = parser.ParseTopLevelDecl(up)
	if LookupMethodForDecl(c, ud) != nil {
		return fail("expected nil for an unknown receiver type")
	}

	// Known receiver, unregistered method name: nil.
	var newSrc *[]const char = "func (c *Counter) Brand() {}"
	var np @parser.Parser = parser.New(toBytes(newSrc), "<repl>")
	var nd @ast.Decl = parser.ParseTopLevelDecl(np)
	if LookupMethodForDecl(c, nd) != nil {
		return fail("expected nil for an unregistered method name")
	}
	return ""
}
