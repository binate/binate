package "pkg/types"

import "pkg/buf"
import "pkg/builtin/testing"

func TestCheckVarDecl() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x int = 42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckVarDeclTypeMismatch() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x bool = 42\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckStringVar() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x @[]const char = \"hello\"\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFuncDecl() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc add(a int, b int) int { return a + b }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFuncReturnTypeMismatch() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc f() int { return true }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckUndefined() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x int = y\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckConstDecl() testing.TestResult {
	var src *[]const char = "package \"test\"\nconst x int = 42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckConstGroup() testing.TestResult {
	var src *[]const char = "package \"test\"\nconst (\n\tA int = iota\n\tB\n\tC\n)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckTypeDecl() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Point struct { X int; Y int }\n")
	cb = buf.WriteStr(cb, "func f() { var p Point; p.X = 1 }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// ============================================================
// Termination analysis / missing-return detection
// ============================================================

// Void function with no return is fine (no check applies).
func TestMissingReturnVoidOk() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc f() { }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Missing return at end of non-void function is an error.
func TestMissingReturnFallthrough() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc f() int { var x int = 1 }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// if without else cannot terminate — fall-through possible.
func TestMissingReturnIfNoElse() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f(x int) int { if x > 0 { return 1 } }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// if/else where only one branch returns is an error.
func TestMissingReturnIfElsePartial() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f(x int) int {\n")
	cb = buf.WriteStr(cb, "  if x > 0 { return 1 } else { var y int = 2 }\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// if/else where both branches return terminates.
func TestTerminatesIfElseBothReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f(x int) int {\n")
	cb = buf.WriteStr(cb, "  if x > 0 { return 1 } else { return -1 }\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Unconditional for-loop with no break terminates.
func TestTerminatesForNoBreak() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f() int { for { var x int = 1 } }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Unconditional for-loop with a top-level break does NOT terminate.
func TestMissingReturnForWithBreak() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f() int { for { break } }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// for with a condition does NOT terminate (the cond may be false).
func TestMissingReturnForWithCond() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f() int {\n")
	cb = buf.WriteStr(cb, "  for i := 0; i < 10; i++ { }\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Switch with default + all cases terminating = terminates.
func TestTerminatesSwitchWithDefault() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f(x int) int {\n")
	cb = buf.WriteStr(cb, "  switch x {\n")
	cb = buf.WriteStr(cb, "  case 1: return 10\n")
	cb = buf.WriteStr(cb, "  default: return 0\n")
	cb = buf.WriteStr(cb, "  }\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Switch with no default does NOT terminate.
func TestMissingReturnSwitchNoDefault() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f(x int) int {\n")
	cb = buf.WriteStr(cb, "  switch x {\n")
	cb = buf.WriteStr(cb, "  case 1: return 10\n")
	cb = buf.WriteStr(cb, "  case 2: return 20\n")
	cb = buf.WriteStr(cb, "  }\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Switch where one case doesn't return does NOT terminate.
func TestMissingReturnSwitchCaseNoReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f(x int) int {\n")
	cb = buf.WriteStr(cb, "  switch x {\n")
	cb = buf.WriteStr(cb, "  case 1: return 10\n")
	cb = buf.WriteStr(cb, "  default: var y int = 0\n")
	cb = buf.WriteStr(cb, "  }\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Switch case containing a top-level `break` does NOT terminate
// (break escapes the switch without returning).
func TestMissingReturnSwitchCaseBreak() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f(x int) int {\n")
	cb = buf.WriteStr(cb, "  switch x {\n")
	cb = buf.WriteStr(cb, "  case 1: break\n")
	cb = buf.WriteStr(cb, "  default: return 0\n")
	cb = buf.WriteStr(cb, "  }\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Nested: a `break` inside a nested for should not disqualify the
// outer for { } as terminating.
func TestTerminatesNestedBreakIgnored() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f() int {\n")
	cb = buf.WriteStr(cb, "  for {\n")
	cb = buf.WriteStr(cb, "    for i := 0; i < 3; i++ { break }\n")
	cb = buf.WriteStr(cb, "  }\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// panic(...) as the final statement is a terminator. Non-void
// functions need not have an explicit return after a panic.
func TestTerminatesPanic() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc f() int { panic(\"nope\") }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// panic in the fall-through position after a conditional return.
func TestTerminatesIfReturnElsePanic() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f(x int) int {\n")
	cb = buf.WriteStr(cb, "  if x > 0 { return x }\n")
	cb = buf.WriteStr(cb, "  panic(\"nope\")\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// panic in both branches of an if/else.
func TestTerminatesIfElseBothPanic() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f(x int) int {\n")
	cb = buf.WriteStr(cb, "  if x > 0 { panic(\"a\") } else { panic(\"b\") }\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Regular function calls that look like panic but aren't are not
// terminators. A return is still required.
func TestNonPanicExprDoesNotTerminate() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func g() { }\n")
	cb = buf.WriteStr(cb, "func f() int { g() }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// Method declarations (Stage 2 of plan-receivers.md)
// ============================================================

func TestCheckMethodPointerRecv() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Point struct { x int; y int }\n")
	cb = buf.WriteStr(cb, "func (p *Point) X() int { return p.x }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodValueRecv() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Counter struct { n int }\n")
	cb = buf.WriteStr(cb, "func (c Counter) Get() int { return c.n }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodManagedRecv() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Node struct { val int }\n")
	cb = buf.WriteStr(cb, "func (n @Node) Val() int { return n.val }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodOnNamedPrimitive() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Celsius int\n")
	cb = buf.WriteStr(cb, "func (c Celsius) Zero() bool { return false }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodOnAliasIsError() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type MyInt = int\n")
	cb = buf.WriteStr(cb, "func (m MyInt) Get() int { return 0 }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

func TestCheckMethodOnBuiltinIsError() testing.TestResult {
	var src *[]const char = "package \"test\"\nfunc (i int) Foo() int { return 0 }\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckMethodDuplicateIsError() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Point struct { x int }\n")
	cb = buf.WriteStr(cb, "func (p *Point) X() int { return p.x }\n")
	cb = buf.WriteStr(cb, "func (p *Point) X() int { return 0 }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Free function and method with the same name are allowed: methods
// live in per-type method sets, not the package symbol table.
func TestCheckMethodAndFreeFunctionSameNameOK() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Point struct { x int }\n")
	cb = buf.WriteStr(cb, "func (p *Point) Foo() int { return p.x }\n")
	cb = buf.WriteStr(cb, "func Foo() int { return 42 }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Two methods with the same name on different types are allowed.
func TestCheckMethodSameNameDifferentTypesOK() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type A struct { x int }\n")
	cb = buf.WriteStr(cb, "type B struct { y int }\n")
	cb = buf.WriteStr(cb, "func (a *A) Get() int { return a.x }\n")
	cb = buf.WriteStr(cb, "func (b *B) Get() int { return b.y }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// The receiver name must be visible inside the method body.
func TestCheckMethodBodySeesReceiver() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Point struct { x int; y int }\n")
	cb = buf.WriteStr(cb, "func (p *Point) Sum() int { return p.x + p.y }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Method bodies type-check normally; an int-vs-bool mismatch is reported.
func TestCheckMethodBodyTypeError() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Point struct { x int }\n")
	cb = buf.WriteStr(cb, "func (p *Point) X() bool { return p.x }\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}
