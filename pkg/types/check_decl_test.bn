package "pkg/types"

import "pkg/buf"
import "pkg/builtins/testing"

// Tests that exercise the simple-decl-kind machinery in
// check_decl.bn: var, const, type/group, plus undefined-name
// detection.  Function- and method-decl tests live in
// check_decl_func_test.bn.

func TestCheckVarDecl() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x int = 42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckVarDeclTypeMismatch() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x bool = 42\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckStringVar() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x @[]const char = \"hello\"\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckUndefined() testing.TestResult {
	var src *[]const char = "package \"test\"\nvar x int = y\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckConstDecl() testing.TestResult {
	var src *[]const char = "package \"test\"\nconst x int = 42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckConstGroup() testing.TestResult {
	var src *[]const char = "package \"test\"\nconst (\n\tA int = iota\n\tB\n\tC\n)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckTypeDecl() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Point struct { X int; Y int }\n")
	cb = cb.WriteStr("func f() { var p Point; p.X = 1 }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}
