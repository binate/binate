package "pkg/types"

import "pkg/ast"
import "pkg/token"

// ============================================================
// Expression Checking
// ============================================================

// checkExpr type-checks an expression, registers its type, and returns it.
func checkExpr(c @Checker, e @ast.Expr) @Type {
	if e == nil {
		return TypVoid()
	}

	var t @Type = checkExprInner(c, e)
	e.ResolvedTypeID = registerExprType(c, t)
	return t
}

// checkExprInner dispatches expression checking by expression kind.
func checkExprInner(c @Checker, e @ast.Expr) @Type {
	if e.Kind == ast.EXPR_IDENT {
		return checkIdent(c, e)
	}
	if e.Kind == ast.EXPR_INT_LIT {
		return TypUntypedInt()
	}
	if e.Kind == ast.EXPR_FLOAT_LIT {
		return TypUntypedFloat()
	}
	if e.Kind == ast.EXPR_STRING_LIT {
		return StringLitNaturalType(e.Name)
	}
	if e.Kind == ast.EXPR_CHAR_LIT {
		return TypChar()
	}
	if e.Kind == ast.EXPR_BOOL_LIT {
		return TypUntypedBool()
	}
	if e.Kind == ast.EXPR_NIL_LIT {
		return TypNil()
	}
	if e.Kind == ast.EXPR_BINARY {
		return checkBinaryExpr(c, e)
	}
	if e.Kind == ast.EXPR_UNARY {
		return checkUnaryExpr(c, e)
	}
	if e.Kind == ast.EXPR_CALL {
		return checkCallExpr(c, e)
	}
	if e.Kind == ast.EXPR_INDEX {
		return checkIndexExpr(c, e)
	}
	if e.Kind == ast.EXPR_SLICE {
		return checkSliceExpr(c, e)
	}
	if e.Kind == ast.EXPR_SELECTOR {
		return checkSelectorExpr(c, e)
	}
	if e.Kind == ast.EXPR_COMPOSITE {
		return checkCompositeLit(c, e)
	}
	if e.Kind == ast.EXPR_BUILTIN {
		return checkBuiltinCall(c, e)
	}
	if e.Kind == ast.EXPR_FUNC_LIT {
		return checkFuncLit(c, e)
	}

	addCheckError(c, e.Pos, "unexpected expression")
	return TypVoid()
}

// checkIdent resolves an identifier to its type via scope lookup (handles iota).
// The blank identifier `_` resolves to void — it's not a defined name, and
// the surrounding context (assign/var-decl LHS) is responsible for treating
// it as a write-only sink. Reading `_` as an rvalue is still an error (no
// name in scope, but we skip the errUndefined noise for `_`).
//
// Tier 3 forward refs: when resolving outside TentativeMode, an
// identifier that looks up to a still-pending function is an
// error — its body hasn't been IR-gen'd, so any use would fail
// at runtime.  Surface a clear "function X is unresolved
// (pending: ...)" message instead of letting the runtime hit
// "extern not found" later.  Inside TentativeMode (a body-check
// pass for another decl), pending funcs are NOT errored — their
// sig is in scope, that's enough for the tentative pass.
func checkIdent(c @Checker, e @ast.Expr) @Type {
	if charEq(e.Name, "iota") && c.Iota >= 0 {
		return TypUntypedInt()
	}
	if isBlank(e.Name) {
		return TypVoid()
	}
	var sym @Symbol = Lookup(c.Scope, e.Name)
	if sym == nil {
		errUndefined(c, e.Pos, e.Name)
		return TypVoid()
	}
	if !c.TentativeMode && IsPendingFunc(c, e.Name) {
		errPendingFunc(c, e.Pos, e.Name)
		// Return the real func type so cascading checks (call,
		// arity, return) don't add noise on top of the pending
		// error.  IR-gen / lowering won't run because the
		// surrounding stmt-list / decl errored.
		return sym.Type
	}
	return sym.Type
}

// errPendingFunc reports a "function X is unresolved
// (pending: ...)" type error with the still-missing names
// pulled from the pending entry.
func errPendingFunc(c @Checker, pos token.Pos, name *[]const char) {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("function ")
	cb = cb.WriteStr(name)
	cb = cb.WriteStr(" is unresolved (pending: ")
	var pd @PendingDecl = lookupPending(c, name)
	if pd != nil {
		for i := 0; i < len(pd.MissingNames); i++ {
			if i > 0 { cb = cb.WriteStr(", ") }
			cb = cb.WriteStr(pd.MissingNames[i])
		}
	}
	cb = cb.WriteStr(")")
	addCheckError(c, pos, cb.Bytes())
}

// lookupPending returns the PendingDecl for `name` from
// c.Pending, or nil if not parked.
func lookupPending(c @Checker, name *[]const char) @PendingDecl {
	for i := 0; i < len(c.Pending); i++ {
		var pd @PendingDecl = c.Pending[i]
		if pd.Decl.Kind != ast.DECL_FUNC { continue }
		if pd.Decl.Recv != nil { continue }
		if charEq(pd.Decl.Name, name) { return pd }
	}
	return nil
}

// isBlank reports whether name is the blank identifier ("_").
func isBlank(name *[]const char) bool {
	return len(name) == 1 && name[0] == '_'
}

// checkBinaryExpr type-checks a binary expression (both operands and the operator).
func checkBinaryExpr(c @Checker, e @ast.Expr) @Type {
	var lt @Type = checkExpr(c, e.X)
	var rt @Type = checkExpr(c, e.Y)
	return checkBinaryOp(c, e.Pos, e.Op, lt, rt)
}

// checkBinaryOp validates a binary operator against its operand types and returns the result type.
func checkBinaryOp(c @Checker, pos token.Pos, op int, lt @Type, rt @Type) @Type {
	// Arithmetic
	if op == cast(int, token.PLUS) || op == cast(int, token.MINUS) ||
		op == cast(int, token.STAR) || op == cast(int, token.SLASH) ||
		op == cast(int, token.PERCENT) {
		return checkArithOp(c, pos, op, lt, rt)
	}
	// Bitwise
	if op == cast(int, token.AMP) || op == cast(int, token.PIPE) ||
		op == cast(int, token.CARET) || op == cast(int, token.SHL) ||
		op == cast(int, token.SHR) {
		if !lt.IsInteger() || !rt.IsInteger() {
			addCheckError(c, pos, "bitwise op requires integer operands")
			return TypVoid()
		}
		return commonType(c, pos, lt, rt)
	}
	// Comparison
	if op == cast(int, token.EQ) || op == cast(int, token.NEQ) ||
		op == cast(int, token.LT) || op == cast(int, token.GT) ||
		op == cast(int, token.LEQ) || op == cast(int, token.GEQ) {
		if !lt.AssignableTo(rt) && !rt.AssignableTo(lt) {
			errTypeMismatch(c, pos, lt, rt)
		}
		return TypUntypedBool()
	}
	// Logical
	if op == cast(int, token.LAND) || op == cast(int, token.LOR) {
		if !lt.IsBool() || !rt.IsBool() {
			addCheckError(c, pos, "logical op requires bool operands")
		}
		return TypUntypedBool()
	}
	addCheckError(c, pos, "invalid binary operator")
	return TypVoid()
}

// checkArithOp validates an arithmetic operator. The `%` operator is
// integer-only; other arithmetic ops accept ints or floats but not a
// mix. Binate has no string `+` operator (claude-notes.md:334).
func checkArithOp(c @Checker, pos token.Pos, op int, lt @Type, rt @Type) @Type {
	if op == cast(int, token.PERCENT) {
		if !lt.IsInteger() || !rt.IsInteger() {
			addCheckError(c, pos, "operator % requires integer operands")
			return TypVoid()
		}
		return commonType(c, pos, lt, rt)
	}
	if !lt.IsNumeric() || !rt.IsNumeric() {
		addCheckError(c, pos, "arithmetic op requires numeric operands")
		return TypVoid()
	}
	// Reject mixing int and float without an explicit cast.
	if lt.IsInteger() && rt.IsFloat() {
		addCheckError(c, pos, "cannot mix int and float without cast")
		return TypVoid()
	}
	if lt.IsFloat() && rt.IsInteger() {
		addCheckError(c, pos, "cannot mix int and float without cast")
		return TypVoid()
	}
	return commonType(c, pos, lt, rt)
}

// checkUnaryExpr type-checks a unary expression (-, !, ~, *, &).
func checkUnaryExpr(c @Checker, e @ast.Expr) @Type {
	var xt @Type = checkExpr(c, e.X)
	if e.Op == cast(int, token.MINUS) {
		if !xt.IsNumeric() {
			addCheckError(c, e.Pos, "unary - requires numeric operand")
		}
		return xt
	}
	if e.Op == cast(int, token.NOT) {
		if !xt.IsBool() {
			addCheckError(c, e.Pos, "unary ! requires bool operand")
		}
		return TypUntypedBool()
	}
	if e.Op == cast(int, token.TILDE) {
		if !xt.IsInteger() {
			addCheckError(c, e.Pos, "unary ~ requires integer operand")
		}
		return xt
	}
	if e.Op == cast(int, token.STAR) {
		// Dereference
		var elem @Type = xt.PointerElem()
		if elem == nil {
			addCheckError(c, e.Pos, "cannot dereference non-pointer")
			return TypVoid()
		}
		return elem
	}
	if e.Op == cast(int, token.AMP) {
		// Address-of
		return MakePointerType(xt)
	}
	addCheckError(c, e.Pos, "invalid unary operator")
	return TypVoid()
}

// checkCallExpr type-checks a function call, validating argument count and types.
//
// Method calls (`obj.M(args)`) are detected first when the callee is a
// selector expression — see tryMethodCall in check_method.bn. If it
// returns nil, e is not a method call and we fall back to the regular
// function-call path. (Stage 3 of plan-receivers.md.)
func checkCallExpr(c @Checker, e @ast.Expr) @Type {
	if e.X != nil && e.X.Kind == ast.EXPR_SELECTOR {
		var mtype @Type = tryMethodCall(c, e)
		if mtype != nil {
			return mtype
		}
	}

	var fnType @Type = checkExpr(c, e.X)
	if fnType == nil ||
		(fnType.Kind != TYP_FUNC &&
		 fnType.Kind != TYP_FUNC_VALUE &&
		 fnType.Kind != TYP_MANAGED_FUNC_VALUE) {
		addCheckError(c, e.X.Pos, "cannot call non-function")
		return TypVoid()
	}

	// Variadic builtins have empty param lists — just check args
	var isVariadic bool = len(fnType.Params) == 0
	var numParams int = len(fnType.Params)
	var numResults int = len(fnType.Results)
	var numArgs int = len(e.Args)

	if numParams == 0 && numArgs > 0 {
		for i := 0; i < numArgs; i++ {
			checkExpr(c, e.Args[i])
		}
	} else if numArgs != numParams {
		addCheckError(c, e.Pos, "wrong number of arguments")
	} else {
		for i := 0; i < numArgs; i++ {
			var at @Type = checkExpr(c, e.Args[i])
			if !at.AssignableTo(fnType.Params[i].Type) {
				errCannotAssign(c, e.Args[i].Pos, at, fnType.Params[i].Type)
			}
		}
	}

	if numResults == 0 {
		return TypVoid()
	}
	if numResults == 1 {
		return fnType.Results[0]
	}
	// Multiple returns — return the FuncType for multi-assign detection
	return fnType
}

// checkIndexExpr type-checks an index expression (slice, array, pointer, or string indexing).
func checkIndexExpr(c @Checker, e @ast.Expr) @Type {
	var xt @Type = checkExpr(c, e.X)
	var idxType @Type = checkExpr(c, e.Y)
	if !idxType.IsInteger() {
		addCheckError(c, e.Y.Pos, "index must be integer")
	}

	xt = xt.ResolveAlias()
	if xt != nil && xt.Kind == TYP_CONST {
		xt = xt.Elem.ResolveAlias()
	}
	if xt == nil {
		return TypVoid()
	}
	if xt.Kind == TYP_SLICE || xt.Kind == TYP_MANAGED_SLICE || xt.Kind == TYP_ARRAY {
		return xt.Elem
	}
	if xt.Kind == TYP_POINTER {
		return xt.Elem
	}
	addCheckError(c, e.X.Pos, "cannot index this type")
	return TypVoid()
}

// checkSliceExpr type-checks a slice expression (x[lo:hi]).
func checkSliceExpr(c @Checker, e @ast.Expr) @Type {
	var xt @Type = checkExpr(c, e.X)
	// Z = lo, Y = hi in the AST
	if e.Z != nil {
		var lt @Type = checkExpr(c, e.Z)
		if !lt.IsInteger() {
			addCheckError(c, e.Z.Pos, "slice index must be integer")
		}
	}
	if e.Y != nil {
		var ht @Type = checkExpr(c, e.Y)
		if !ht.IsInteger() {
			addCheckError(c, e.Y.Pos, "slice index must be integer")
		}
	}

	xt = xt.ResolveAlias()
	if xt == nil {
		return TypVoid()
	}
	if xt.Kind == TYP_SLICE || xt.Kind == TYP_MANAGED_SLICE {
		return xt
	}
	if xt.Kind == TYP_ARRAY {
		return MakeSliceType(xt.Elem)
	}
	addCheckError(c, e.X.Pos, "cannot slice this type")
	return TypVoid()
}

// checkSelectorExpr type-checks a selector (x.Name), handling package access and struct fields.
func checkSelectorExpr(c @Checker, e @ast.Expr) @Type {
	// Check for package-qualified access: pkg.Name
	if e.X != nil && e.X.Kind == ast.EXPR_IDENT {
		var sym @Symbol = Lookup(c.Scope, e.X.Name)
		if sym != nil && sym.Kind == SYM_PKG {
			var pkgScope @Scope = lookupPackage(c, sym.PkgPath)
			if pkgScope == nil {
				errUndefined(c, e.X.Pos, e.X.Name)
				return TypVoid()
			}
			var member @Symbol = Lookup(pkgScope, e.Name)
			if member == nil {
				errUndefined(c, e.Pos, e.Name)
				return TypVoid()
			}
			return member.Type
		}
		// Method expression: T.M where T is a named type. The result
		// is a function value whose signature includes the method's
		// receiver as the first parameter (per the method's declared
		// receiver kind — value, *T, or @T). A.6 of plan-function-
		// values.md.
		if sym != nil && sym.Kind == SYM_TYPE {
			var t @Type = sym.Type
			var m @Method = LookupMethod(t, e.Name)
			if m == nil {
				errUndefined(c, e.Pos, e.Name)
				return TypVoid()
			}
			// m.FuncType already has the receiver baked in as Params[0].
			return MakeFuncValueType(m.FuncType.Params, m.FuncType.Results)
		}
	}

	var xt @Type = checkExpr(c, e.X)

	// Auto-dereference pointers
	var elem @Type = xt.PointerElem()
	if elem != nil {
		xt = elem
	}

	// Track whether the access path was const. Writing through a
	// const access path is rejected at the assign site; the way we
	// signal that is by propagating const onto the returned field
	// type so that `checkAssignStmt` can observe outer-const on the
	// LHS and reject.
	var pathConst bool = false
	xt = xt.ResolveAlias()
	if xt != nil && xt.Kind == TYP_CONST {
		pathConst = true
		xt = xt.Elem.ResolveAlias()
	}
	if xt == nil {
		return TypVoid()
	}

	// Struct field access
	if xt.Kind == TYP_STRUCT {
		var f @Field = xt.FieldByName(e.Name)
		if f == nil {
			errUndefined(c, e.Pos, e.Name)
			return TypVoid()
		}
		if pathConst { return MakeConstType(f.Type) }
		return f.Type
	}
	if xt.Kind == TYP_NAMED && xt.Underlying != nil {
		if xt.Underlying.Kind == TYP_STRUCT {
			var f @Field = xt.Underlying.FieldByName(e.Name)
			if f == nil {
				errUndefined(c, e.Pos, e.Name)
				return TypVoid()
			}
			if pathConst { return MakeConstType(f.Type) }
			return f.Type
		}
	}

	addCheckError(c, e.Pos, "cannot access field on this type")
	return TypVoid()
}

// checkCompositeLit type-checks a composite literal (struct, array,
// or managed-slice).
func checkCompositeLit(c @Checker, e @ast.Expr) @Type {
	var typ @Type = resolveTypeExpr(c, e.TypeRef)
	var xt @Type = typ.ResolveAlias()

	if xt != nil && xt.Kind == TYP_STRUCT {
		checkStructLit(c, e, xt)
	}
	if xt != nil && xt.Kind == TYP_ARRAY {
		checkArrayLit(c, e, xt)
	}
	if xt != nil && xt.Kind == TYP_MANAGED_SLICE {
		checkSliceLit(c, e, xt)
	}
	if xt != nil && xt.Kind == TYP_SLICE {
		// Raw-slice composite literal: `*[]const T{...}` is
		// allowed (rodata or stack backing); `*[]T{...}` (non-
		// const element) is rejected — no sound mutable backing.
		var unused @Type
		var elemIsConst bool
		unused, elemIsConst = elemHasConst(xt.Elem)
		if !elemIsConst {
			addCheckError(c, e.Pos,
				"raw-slice composite literal requires const elements; use *[]const T{...} or @[]T{...}")
		} else {
			checkSliceLit(c, e, xt)
		}
	}
	if xt != nil && xt.Kind == TYP_NAMED && xt.Underlying != nil {
		if xt.Underlying.Kind == TYP_STRUCT {
			checkStructLit(c, e, xt.Underlying)
		}
	}

	return typ
}

// checkSliceLit validates managed-slice literal elements against
// the slice's element type. (Raw slice literals are not supported
// — the parser doesn't even produce them today; if it ever does,
// the rule per the plan is: rejected unless elements are const.)
func checkSliceLit(c @Checker, e @ast.Expr, st @Type) {
	var elemTyp @Type = st.Elem
	if elemTyp == nil { return }
	for i := 0; i < len(e.Elems); i++ {
		var vt @Type = checkExpr(c, e.Elems[i].Value)
		if !vt.AssignableTo(elemTyp) {
			errCannotAssign(c, e.Elems[i].Value.Pos, vt, elemTyp)
		}
	}
}

// checkStructLit validates struct literal elements against the struct's field types.
func checkStructLit(c @Checker, e @ast.Expr, st @Type) {
	for i := 0; i < len(e.Elems); i++ {
		var el @ast.Element = e.Elems[i]
		if el.Key != nil {
			var f @Field = st.FieldByName(el.Key.Name)
			if f == nil {
				errUndefined(c, el.Key.Pos, el.Key.Name)
				continue
			}
			var vt @Type = checkExpr(c, el.Value)
			if !vt.AssignableTo(f.Type) {
				errCannotAssign(c, el.Value.Pos, vt, f.Type)
			}
		} else {
			checkExpr(c, el.Value)
		}
	}
}

// checkArrayLit validates array literal elements against the array's element type.
func checkArrayLit(c @Checker, e @ast.Expr, at @Type) {
	for i := 0; i < len(e.Elems); i++ {
		var vt @Type = checkExpr(c, e.Elems[i].Value)
		if !vt.AssignableTo(at.Elem) {
			errCannotAssign(c, e.Elems[i].Value.Pos, vt, at.Elem)
		}
	}
}

