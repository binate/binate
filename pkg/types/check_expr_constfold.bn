package "pkg/types"

import "pkg/ast"
import "pkg/token"

// Constant folding for arithmetic and bitwise binary ops on
// untyped-int literals.  Both folders run before the regular
// commonType resolution in checkBinaryOp / checkArithOp, so the
// resulting untyped-int Type carries the folded value through to
// the AssignableTo fit-check at the assignment site.  Per
// claude-notes.md § "Integer literal value range and constant-
// expression arithmetic — DECIDED 2026-05-15".
//
// Implementation compromise: the folders use host-int arithmetic
// restricted to a 31-bit-magnitude window for operands, so the
// math is bootstrap-safe under the Go interpreter (which can't
// sequence uint64 ops at the int64/uint64 boundary).  Wider
// operands and the /, %, full bignum cases stay unfolded; they'll
// land when bignum gains bootstrap-safe Add/Sub/Mul/Div.

// foldIntArith performs constant folding for `+ - *` on two
// integer operands when both carry HasLitVal.  The folded value
// becomes the new untyped-int literal — `var x uint8 = 1000 -
// 1000` accepts (final 0 fits) and `var x uint8 = 200 + 100`
// rejects (final 300 doesn't).  / and % are deferred (div-by-zero
// and sign-semantics) so they fall through unfolded.
func foldIntArith(c @Checker, pos token.Pos, op int,
		lt @Type, rt @Type) @Type {
	if lt == nil || rt == nil { return commonType(c, pos, lt, rt) }
	if lt.Kind != TYP_UNTYPED_INT || rt.Kind != TYP_UNTYPED_INT {
		return commonType(c, pos, lt, rt)
	}
	if !lt.HasLitVal || !rt.HasLitVal {
		return commonType(c, pos, lt, rt)
	}
	// 31-bit magnitude window — operands beyond it fall through
	// unfolded.
	if (lt.LitMag >> 31) != 0 || (rt.LitMag >> 31) != 0 {
		return TypUntypedInt()
	}
	var av int = cast(int, lt.LitMag)
	if lt.LitSign { av = 0 - av }
	var bv int = cast(int, rt.LitMag)
	if rt.LitSign { bv = 0 - bv }
	var rv int
	if op == cast(int, token.PLUS) {
		rv = av + bv
	} else if op == cast(int, token.MINUS) {
		rv = av - bv
	} else if op == cast(int, token.STAR) {
		rv = av * bv
	} else {
		// /, %, anything else — defer to the unfolded path.
		return TypUntypedInt()
	}
	var rSign bool = false
	var rMag uint64 = 0
	if rv < 0 {
		rSign = true
		rMag = cast(uint64, 0 - rv)
	} else {
		rMag = cast(uint64, rv)
	}
	var t @Type = make(Type)
	t.Kind = TYP_UNTYPED_INT
	t.Name = TypUntypedInt().Name
	t.HasLitVal = true
	t.LitMag = rMag
	t.LitSign = rSign
	return t
}

// foldIntBitwise performs constant folding for `& | ^ << >>` on
// two integer operands when both carry literal values.  Only
// non-negative operands fold — bitwise ops on signed bit patterns
// depend on a width that's only fixed at the assignment site, and
// the spec leaves their semantics to the typed level.
//
// SHL / SHR are capped at shift amount <= 31 so the result stays
// well within int64 (avoiding bootstrap-Go's int64-boundary
// issues); larger shifts fall through unfolded.
func foldIntBitwise(c @Checker, pos token.Pos, op int,
		lt @Type, rt @Type) @Type {
	if lt == nil || rt == nil { return commonType(c, pos, lt, rt) }
	if lt.Kind != TYP_UNTYPED_INT || rt.Kind != TYP_UNTYPED_INT {
		return commonType(c, pos, lt, rt)
	}
	if !lt.HasLitVal || !rt.HasLitVal {
		return commonType(c, pos, lt, rt)
	}
	if lt.LitSign || rt.LitSign {
		return TypUntypedInt()
	}
	if (lt.LitMag >> 31) != 0 || (rt.LitMag >> 31) != 0 {
		return TypUntypedInt()
	}
	var a uint64 = lt.LitMag
	var b uint64 = rt.LitMag
	var r uint64
	if op == cast(int, token.AMP) {
		r = a & b
	} else if op == cast(int, token.PIPE) {
		r = a | b
	} else if op == cast(int, token.CARET) {
		r = a ^ b
	} else if op == cast(int, token.SHL) {
		if (b >> 5) != 0 {
			return TypUntypedInt()
		}
		r = a << b
	} else if op == cast(int, token.SHR) {
		if (b >> 5) != 0 {
			return TypUntypedInt()
		}
		r = a >> b
	} else {
		return TypUntypedInt()
	}
	var t @Type = make(Type)
	t.Kind = TYP_UNTYPED_INT
	t.Name = TypUntypedInt().Name
	t.HasLitVal = true
	t.LitMag = r
	t.LitSign = false
	return t
}
