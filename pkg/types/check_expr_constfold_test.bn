package "pkg/types"

import "pkg/builtin/testing"

// Tests for check_expr_constfold.bn — fold + - * and & | ^ << >>
// at type-check time so the literal-fits-target check at the
// assignment site sees the final value.  These exercise the
// end-to-end happy and rejection paths via checkSrc; conformance
// 421 / 420 pin the same shapes through the full compile pipeline.

func TestConstFoldArithSubCancels() testing.TestResult {
	// 1000 - 1000 = 0 fits uint8 even though `1000` alone doesn't.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 1000 - 1000\n")
	return expectNoErrors(c)
}

func TestConstFoldArithAddFits() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 100 + 100\n")
	return expectNoErrors(c)
}

func TestConstFoldArithMulFits() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 5 * 50\n")
	return expectNoErrors(c)
}

func TestConstFoldArithAddOverflowsTarget() testing.TestResult {
	// 200 + 100 = 300 doesn't fit uint8 [0, 255].
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 200 + 100\n")
	return expectError(c)
}

func TestConstFoldArithSignedNegBoundary() testing.TestResult {
	// 64 + 64 - 128 = 0 — int8 boundary case, fits.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x int8 = 64 + 64 - 128\n")
	return expectNoErrors(c)
}

func TestConstFoldBitwiseAnd() testing.TestResult {
	// 0xF0 & 0x0F = 0 fits any unsigned target.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 0xF0 & 0x0F\n")
	return expectNoErrors(c)
}

func TestConstFoldBitwiseOrFits() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 0xF0 | 0x0F\n")
	return expectNoErrors(c)
}

func TestConstFoldBitwiseShlFits() testing.TestResult {
	// 1 << 7 = 128 fits uint8.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 1 << 7\n")
	return expectNoErrors(c)
}

func TestConstFoldBitwiseShlOverflowsTarget() testing.TestResult {
	// 1 << 8 = 256 doesn't fit uint8.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 1 << 8\n")
	return expectError(c)
}

func TestConstFoldBitwiseShrFits() testing.TestResult {
	// 0x80 >> 3 = 16 fits uint8.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 0x80 >> 3\n")
	return expectNoErrors(c)
}

func TestConstFoldDivFits() testing.TestResult {
	// 200 / 4 = 50 fits uint8.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 200 / 4\n")
	return expectNoErrors(c)
}

func TestConstFoldDivByZero() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x int = 10 / 0\n")
	return expectError(c)
}

func TestConstFoldModFits() testing.TestResult {
	// 256 % 100 = 56 fits uint8.
	var c @Checker = checkSrc(
		"package \"test\"\nvar x uint8 = 256 % 100\n")
	return expectNoErrors(c)
}

func TestConstFoldModByZero() testing.TestResult {
	var c @Checker = checkSrc(
		"package \"test\"\nvar x int = 10 % 0\n")
	return expectError(c)
}
