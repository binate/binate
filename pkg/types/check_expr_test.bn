package "pkg/types"

import "pkg/buf"
import "pkg/builtin/testing"

// ============================================================
// Expression Checking Tests
// ============================================================

func TestCheckBinaryExpr() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x int = 1 + 2\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckBoolExpr() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x bool = true && false\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckComparison() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x bool = 1 < 2\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckUnaryNeg() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x int = -42\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckUnaryNot() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x bool = !true\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// ============================================================
// Float Expression Tests
// ============================================================

func TestCheckFloatLit() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x float64 = 3.14\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloat32Lit() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x float32 = 3.14\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatDefaultInferred() testing.TestResult {
	// Without an explicit type, an untyped float literal should default
	// to float64 — and then be usable as float64.
	var src *[]char = "package \"test\"\nvar x = 3.14\nvar y float64 = x\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatArith() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "var a float64 = 1.0 + 2.0\n")
	cb = buf.WriteStr(cb, "var b float64 = 3.0 - 1.0\n")
	cb = buf.WriteStr(cb, "var c float64 = 2.0 * 3.0\n")
	cb = buf.WriteStr(cb, "var d float64 = 6.0 / 2.0\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatCompare() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "var a bool = 1.0 < 2.0\n")
	cb = buf.WriteStr(cb, "var b bool = 1.0 == 1.0\n")
	cb = buf.WriteStr(cb, "var d bool = 3.0 >= 2.5\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatNegate() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x float64 = -3.14\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckFloatCast() testing.TestResult {
	// int -> float, float -> int, float32 <-> float64.
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "var i int = 5\n")
	cb = buf.WriteStr(cb, "var f float64 = cast(float64, i)\n")
	cb = buf.WriteStr(cb, "var g float32 = cast(float32, f)\n")
	cb = buf.WriteStr(cb, "var j int = cast(int, f)\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Negative: mixing int and float without an explicit cast must error.
func TestCheckRejectIntPlusFloat() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x float64 = 1 + 2.0\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Negative: `%` on floats is a type error.
func TestCheckRejectFloatRem() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x float64 = 3.0 % 1.5\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Negative: bitwise operators on floats are a type error.
func TestCheckRejectFloatBitwise() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x float64 = 1.5 & 2.0\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Negative: assigning a float to an int variable without cast is an error.
func TestCheckRejectFloatToInt() testing.TestResult {
	var src *[]char = "package \"test\"\nvar f float64 = 1.5\nvar i int = f\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Negative: assigning an int to a float variable without cast is an error
// when the int is a typed variable (not an untyped literal).
func TestCheckRejectIntToFloat() testing.TestResult {
	var src *[]char = "package \"test\"\nvar i int = 5\nvar f float64 = i\n"
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Float identifier lookup from universe scope.
func TestFloatInUniverseScope() testing.TestResult {
	var src *[]char = "package \"test\"\ntype MyFloat float64\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// ============================================================
// const type modifier — Stage 0 end-to-end (parse + type check)
// ============================================================

// `var x const int = 42` — const wrapping a primitive.
func TestCheckConstInt() testing.TestResult {
	var src *[]char = "package \"test\"\nfunc main() { var x const int = 42; _ = x }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// `var p *const int = ...` — pointer to const int.
func TestCheckPointerToConst() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var x int = 5\n")
	cb = buf.WriteStr(cb, "  var p *const int = &x\n")
	cb = buf.WriteStr(cb, "  _ = p\n")
	cb = buf.WriteStr(cb, "}\n")
	var c @Checker = checkSrc(buf.Bytes(cb))
	return expectNoErrors(c)
}

// `var s *[]const int = arr[:]` — raw slice of const int.
func TestCheckConstSliceElem() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var a [3]int\n")
	cb = buf.WriteStr(cb, "  var s *[]const int = a[:]\n")
	cb = buf.WriteStr(cb, "  _ = s\n")
	cb = buf.WriteStr(cb, "}\n")
	var c @Checker = checkSrc(buf.Bytes(cb))
	return expectNoErrors(c)
}

// Stage 0 permissive: assigning `const int` to `int` is still
// allowed. Stage 1 will tighten this.
func TestCheckConstToNonConstPermissive() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var x const int = 1\n")
	cb = buf.WriteStr(cb, "  var y int = x\n")
	cb = buf.WriteStr(cb, "  _ = y\n")
	cb = buf.WriteStr(cb, "}\n")
	var c @Checker = checkSrc(buf.Bytes(cb))
	return expectNoErrors(c)
}

// const parameter type.
func TestCheckConstParam() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func f(p *const int) int { return *p }\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var x int = 5\n")
	cb = buf.WriteStr(cb, "  var y int = f(&x)\n")
	cb = buf.WriteStr(cb, "  _ = y\n")
	cb = buf.WriteStr(cb, "}\n")
	var c @Checker = checkSrc(buf.Bytes(cb))
	return expectNoErrors(c)
}

// ============================================================
// unsafe_index tests
// ============================================================

func TestCheckUnsafeIndexSlice() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var s *[]int\n")
	cb = buf.WriteStr(cb, "  var x int = unsafe_index(s, 0)\n")
	cb = buf.WriteStr(cb, "  _ = x\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckUnsafeIndexArray() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var a [4]int\n")
	cb = buf.WriteStr(cb, "  var x int = unsafe_index(a, 2)\n")
	cb = buf.WriteStr(cb, "  _ = x\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Non-integer index rejected.
func TestCheckUnsafeIndexNonIntIndex() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var s *[]int\n")
	cb = buf.WriteStr(cb, "  var x int = unsafe_index(s, true)\n")
	cb = buf.WriteStr(cb, "  _ = x\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Non-indexable collection rejected.
func TestCheckUnsafeIndexBadColl() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var n int = 5\n")
	cb = buf.WriteStr(cb, "  var x int = unsafe_index(n, 0)\n")
	cb = buf.WriteStr(cb, "  _ = x\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Wrong arg count rejected.
func TestCheckUnsafeIndexArity() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func main() {\n")
	cb = buf.WriteStr(cb, "  var s *[]int\n")
	cb = buf.WriteStr(cb, "  var x int = unsafe_index(s)\n")
	cb = buf.WriteStr(cb, "  _ = x\n")
	cb = buf.WriteStr(cb, "}\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// sizeof / alignof tests
// ============================================================

func TestCheckSizeofBasic() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x uint = sizeof(int)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckAlignofBasic() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x uint = alignof(float64)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// sizeof of a composite type (slice) — the value is the size of the
// slice header, not the referenced data.
func TestCheckSizeofSlice() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x uint = sizeof(*[]int)\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// sizeof returns `uint`, which is assignable to other int-family
// targets only via explicit cast (no implicit uint→int flow).
func TestCheckSizeofIntCoercion() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x int = cast(int, sizeof(int))\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// ============================================================
// Blank identifier `_` tests
// ============================================================

// `_ = expr` as a statement discards the value; no error.
func TestBlankAssign() testing.TestResult {
	var src *[]char = "package \"test\"\nfunc main() { _ = 42 }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// `var _ T = expr` is a valid declaration that binds no name.
func TestBlankVarDecl() testing.TestResult {
	var src *[]char = "package \"test\"\nfunc main() { var _ int = 42 }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// `var _ = expr` infers a type but still binds no name.
func TestBlankVarDeclInferred() testing.TestResult {
	var src *[]char = "package \"test\"\nfunc main() { var _ = 42 }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Reading `_` as an rvalue doesn't emit "undefined: _" but also
// doesn't resolve to a useful value — `_` is write-only. The checker
// accepts the use without an error.
func TestBlankReadNoUndefinedError() testing.TestResult {
	var src *[]char = "package \"test\"\nfunc f(x int) int { return x }\nfunc main() { f(_) }\n"
	var c @Checker = checkSrc(src)
	// We expect no "undefined: _" error. There may be other errors
	// (void can't be assigned to int), but specifically checking no
	// undefined message would require inspecting the error list.
	// For simplicity, just verify the checker doesn't crash.
	var _ @Checker = c
	return ""
}

// Multi-return discard: `_, y := f()` keeps y, ignores the first.
func TestBlankShortVarMultiReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func pair() (int, bool) { return 1, true }\n")
	cb = buf.WriteStr(cb, "func main() { _, y := pair(); if y { return } }\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Multi-assign discard: `_, z = f()` keeps z, ignores the first.
func TestBlankMultiAssign() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "func pair() (int, int) { return 1, 2 }\n")
	cb = buf.WriteStr(cb, "func main() { var z int = 0; _, z = pair(); z = z + 1 }\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckSelectorUndefined() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Point struct { X int }\n")
	cb = buf.WriteStr(cb, "func f() { var p Point; p.Z = 1 }\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectError(c)
}

func TestCheckPointerDeref() testing.TestResult {
	var src *[]char = "package \"test\"\nfunc f() { var p *int; var x int = *p }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckSliceIndex() testing.TestResult {
	var src *[]char = "package \"test\"\nfunc f() { var s *[]int; var x int = s[0] }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckMakeBuiltin() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Foo struct { X int }\n")
	cb = buf.WriteStr(cb, "func f() { var p @Foo = make(Foo) }\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckLenBuiltin() testing.TestResult {
	var src *[]char = "package \"test\"\nfunc f() { var s *[]int; var n int = len(s) }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckCastBuiltin() testing.TestResult {
	var src *[]char = "package \"test\"\nfunc f() { var x int = cast(int, 42) }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckCompositeLit() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, "package \"test\"\n")
	cb = buf.WriteStr(cb, "type Point struct { X int; Y int }\n")
	cb = buf.WriteStr(cb, "func f() { var p Point = Point{X: 1, Y: 2} }\n")
	var src *[]char = buf.Bytes(cb)
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckMakeSliceBuiltin() testing.TestResult {
	var src *[]char = "package \"test\"\nfunc f() { var s @[]int = make_slice(int, 1); s[0] = 1 }\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckStringConcat() testing.TestResult {
	var src *[]char = "package \"test\"\nvar x string = \"hello\" + \" world\"\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}
