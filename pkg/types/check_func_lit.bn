package "pkg/types"

import "pkg/ast"

// Function literal type-checking. Slice A.7 of plan-function-values.
//
// `func(<params>) <results> { <body> }` in expression position
// evaluates to a function value (`*func(...)` raw form). Phase 1
// restriction: literals must NOT capture enclosing-function locals
// — only package-level decls, the literal's own params, and locals
// declared inside the literal are visible. Phase 2 will lift this
// when capture analysis lands.
//
// Capture rejection is enforced by checking the body in a scope
// whose parent is the package scope (not the calling context's
// scope). Any reference to an enclosing function/block local will
// fail to resolve and surface as `undefined: X`.

// checkFuncLit type-checks a function literal expression and returns
// its function-value type.
func checkFuncLit(c @Checker, e @ast.Expr) @Type {
	var d @ast.Decl = e.DeclRef
	if d == nil {
		return TypVoid()
	}

	var ft @Type = resolveFuncDeclType(c, d)
	if ft == nil {
		return TypVoid()
	}

	// Save state: we'll replace the scope and FuncRet for the body.
	var savedScope @Scope = c.Scope
	var savedFuncRet @[]@Type = c.FuncRet

	// Body scope parented at the package scope, skipping enclosing
	// function/block scopes — captures are unsupported in Phase 1.
	if c.PackageScope != nil {
		c.Scope = NewScope(c.PackageScope)
	} else {
		// Fallback for direct-source contexts (e.g. unit tests that
		// don't go through CheckPackage). pushScope nests on the
		// current scope, so this preserves whatever lookups already
		// work — capture rejection is best-effort here.
		pushScope(c)
	}

	// Define params in the body scope.
	for i := 0; i < len(ft.Params); i++ {
		defineVar(c.Scope, ft.Params[i].Name, ft.Params[i].Type)
	}

	c.FuncRet = ft.Results

	if d.Body != nil {
		checkBlockStmt(c, d.Body)
	}

	// Missing-return check: a literal with declared results must
	// terminate on every path (mirrors checkFuncDecl).
	if len(ft.Results) > 0 && d.Body != nil {
		if !stmtTerminates(d.Body) {
			errMissingReturn(c, d.Pos, "<func literal>")
		}
	}

	c.Scope = savedScope
	c.FuncRet = savedFuncRet

	return MakeFuncValueType(ft.Params, ft.Results)
}
