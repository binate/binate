package "pkg/types"

import "pkg/buf"
import "pkg/builtin/testing"

// Tests for checkFuncLit (Slice A.7 of plan-function-values).
// Type-check-only — IR-gen for function literals lands in A.7.b.

// Non-capturing function literal type-checks cleanly.
func TestCheckFuncLitNonCapturing() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var f *func(int) int = func(x int) int { return x * 2 }\n")
	cb = cb.WriteStr("  _ = f\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Function literal with multi-return signature.
func TestCheckFuncLitMultiReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var f *func(int) (int, int) = func(x int) (int, int) { return x, x }\n")
	cb = cb.WriteStr("  _ = f\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Function literal can reference package-level decls.
func TestCheckFuncLitReferencesPackageScope() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func double(x int) int { return x * 2 }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var f *func(int) int = func(x int) int { return double(x) + 1 }\n")
	cb = cb.WriteStr("  _ = f\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Capture rejection: referencing an enclosing-function local fails to
// resolve, surfacing as `undefined: <name>`. Phase 1 restriction;
// Phase 2 closures lift this.
func TestCheckFuncLitRejectsCapture() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var x int = 10\n")
	cb = cb.WriteStr("  var f *func(int) int = func(y int) int { return x + y }\n")
	cb = cb.WriteStr("  _ = f\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Capture rejection through a nested block.
func TestCheckFuncLitRejectsNestedCapture() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var x int = 10\n")
	cb = cb.WriteStr("  if x > 0 {\n")
	cb = cb.WriteStr("    var f *func() int = func() int { return x }\n")
	cb = cb.WriteStr("    _ = f\n")
	cb = cb.WriteStr("  }\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Function literal can reference its own params and locals.
func TestCheckFuncLitOwnLocals() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var f *func(int) int = func(x int) int {\n")
	cb = cb.WriteStr("    var doubled int = x * 2\n")
	cb = cb.WriteStr("    return doubled\n")
	cb = cb.WriteStr("  }\n")
	cb = cb.WriteStr("  _ = f\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Missing-return on a literal that declares a result is reported.
func TestCheckFuncLitMissingReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var f *func(int) int = func(x int) int {\n")
	cb = cb.WriteStr("    var _ int = x\n")
	cb = cb.WriteStr("  }\n")
	cb = cb.WriteStr("  _ = f\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}
