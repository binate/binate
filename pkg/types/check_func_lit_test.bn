package "pkg/types"

import "pkg/ast"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/parser"

// checkSrcReturningFile mirrors checkSrc (in types_test.bn) but
// also returns the parsed File so capture-recording tests can
// walk the AST to locate the function-literal's synthetic Decl.
func checkSrcReturningFile(src *[]const char) (@Checker, @ast.File) {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.Check(file)
	return c, file
}

// findFirstFuncLit walks the parsed File's top-level Decls (and
// their function bodies) looking for the first EXPR_FUNC_LIT and
// returns the synthetic Decl attached via DeclRef.  Returns nil
// if no literal is found.
func findFirstFuncLit(file @ast.File) @ast.Decl {
	if file == nil { return nil }
	for i := 0; i < len(file.Decls); i++ {
		var d @ast.Decl = file.Decls[i]
		if d == nil || d.Body == nil { continue }
		var r @ast.Decl = findFuncLitInStmt(d.Body)
		if r != nil { return r }
	}
	return nil
}

// findFuncLitInStmt recursively walks a Stmt subtree for the
// first EXPR_FUNC_LIT.  Covers all variant fields used by if /
// for / switch / block / decl-stmt so literals nested inside
// control flow are reachable.
func findFuncLitInStmt(s @ast.Stmt) @ast.Decl {
	if s == nil { return nil }
	for i := 0; i < len(s.Stmts); i++ {
		var r @ast.Decl = findFuncLitInStmt(s.Stmts[i])
		if r != nil { return r }
	}
	for i := 0; i < len(s.Exprs); i++ {
		var r @ast.Decl = findFuncLitInExpr(s.Exprs[i])
		if r != nil { return r }
	}
	for i := 0; i < len(s.Exprs2); i++ {
		var r @ast.Decl = findFuncLitInExpr(s.Exprs2[i])
		if r != nil { return r }
	}
	if s.X != nil {
		var r @ast.Decl = findFuncLitInExpr(s.X)
		if r != nil { return r }
	}
	if s.Init != nil {
		var r @ast.Decl = findFuncLitInStmt(s.Init)
		if r != nil { return r }
	}
	if s.Body != nil {
		var r @ast.Decl = findFuncLitInStmt(s.Body)
		if r != nil { return r }
	}
	if s.Else != nil {
		var r @ast.Decl = findFuncLitInStmt(s.Else)
		if r != nil { return r }
	}
	if s.Post != nil {
		var r @ast.Decl = findFuncLitInStmt(s.Post)
		if r != nil { return r }
	}
	for i := 0; i < len(s.Cases); i++ {
		var cc @ast.CaseClause = s.Cases[i]
		if cc == nil { continue }
		for j := 0; j < len(cc.Body); j++ {
			var r @ast.Decl = findFuncLitInStmt(cc.Body[j])
			if r != nil { return r }
		}
	}
	if s.DeclRef != nil && s.DeclRef.Value != nil {
		var r @ast.Decl = findFuncLitInExpr(s.DeclRef.Value)
		if r != nil { return r }
	}
	return nil
}

// findFuncLitInExpr recursively walks an Expr subtree.
func findFuncLitInExpr(e @ast.Expr) @ast.Decl {
	if e == nil { return nil }
	if e.Kind == ast.EXPR_FUNC_LIT && e.DeclRef != nil {
		return e.DeclRef
	}
	if e.X != nil {
		var r @ast.Decl = findFuncLitInExpr(e.X)
		if r != nil { return r }
	}
	if e.Y != nil {
		var r @ast.Decl = findFuncLitInExpr(e.Y)
		if r != nil { return r }
	}
	if e.Z != nil {
		var r @ast.Decl = findFuncLitInExpr(e.Z)
		if r != nil { return r }
	}
	for i := 0; i < len(e.Args); i++ {
		var r @ast.Decl = findFuncLitInExpr(e.Args[i])
		if r != nil { return r }
	}
	return nil
}

// Tests for checkFuncLit (Slice A.7 of plan-function-values).
// Type-check-only — IR-gen for function literals lands in A.7.b.

// Non-capturing function literal type-checks cleanly.
func TestCheckFuncLitNonCapturing() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int { return x * 2 }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Function literal with multi-return signature.
func TestCheckFuncLitMultiReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func(int) (int, int) = func(x int) (int, int) { return x, x }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Function literal can reference package-level decls.
func TestCheckFuncLitReferencesPackageScope() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func double(x int) int { return x * 2 }\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int { return double(x) + 1 }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Capture from the enclosing function: type-checks cleanly and the
// captured name appears on the literal's Decl.Captures.  Phase 2
// B.1 (plan-function-values-phase-2.md) replaced the Phase 1
// rejection with capture analysis.
func TestCheckFuncLitCapturesEnclosingLocal() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 10\n"
		"  var f *func(int) int = func(y int) int { return x + y }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	// Find the literal's Decl and verify the capture entry.
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 1 {
		return fail("expected 1 capture, got more or fewer")
	}
	if !streq(lit.Captures[0].Name, "x") {
		return fail("expected capture name `x`")
	}
	if lit.Captures[0].Kind != ast.CAP_VAL {
		return fail("expected CAP_VAL for int capture")
	}
	return ""
}

// Capture from an outer scope, referenced from inside a nested
// block within the literal body.  The walk through nested blocks
// up to the literal body must not record a spurious local hit.
func TestCheckFuncLitCapturesThroughNestedBlock() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 10\n"
		"  if x > 0 {\n"
		"    var f *func() int = func() int { return x }\n"
		"    _ = f\n"
		"  }\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 1 {
		return fail("expected 1 capture for `x`")
	}
	if !streq(lit.Captures[0].Name, "x") {
		return fail("expected capture name `x`")
	}
	return ""
}

// Locals declared INSIDE the literal body are not captures, even
// though they're reached via a nested block.
func TestCheckFuncLitInnerLocalsAreNotCaptures() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int {\n"
		"    var y int = x * 2\n"
		"    if y > 0 { return y } else { return 0 }\n"
		"  }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 0 {
		return fail("expected no captures (only own params/locals used)")
	}
	return ""
}

// Package-level references stay non-captures — they resolve at
// PackageScope, not via any enclosing-function frame.
func TestCheckFuncLitPackageRefsAreNotCaptures() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func double(x int) int { return x * 2 }\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int { return double(x) }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 0 {
		return fail("package-level `double` should not be a capture")
	}
	return ""
}

// Managed pointer captures get CAP_MANAGED (will drive RefInc /
// RefDec emission in B.2 / B.3).
func TestCheckFuncLitCaptureKindManaged() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Box struct { N int }\n"
		"func main() {\n"
		"  var b @Box = make(Box)\n"
		"  var f *func() int = func() int { return b.N }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 1 {
		return fail("expected 1 capture `b`")
	}
	if lit.Captures[0].Kind != ast.CAP_MANAGED {
		return fail("expected CAP_MANAGED for @Box capture")
	}
	return ""
}

// Captures are deduplicated by name — referencing the same local
// twice yields one Capture entry.
func TestCheckFuncLitCaptureDedup() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var x int = 10\n"
		"  var f *func() int = func() int { return x + x + x }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker
	var file @ast.File
	c, file = checkSrcReturningFile(cb.Bytes())
	var r testing.TestResult = expectNoErrors(c)
	if len(r) != 0 { return r }
	var lit @ast.Decl = findFirstFuncLit(file)
	if lit == nil { return fail("no function literal found") }
	if len(lit.Captures) != 1 {
		return fail("expected 1 dedup'd capture for `x`")
	}
	return ""
}

// Function literal can reference its own params and locals.
func TestCheckFuncLitOwnLocals() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int {\n"
		"    var doubled int = x * 2\n"
		"    return doubled\n"
		"  }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Missing-return on a literal that declares a result is reported.
func TestCheckFuncLitMissingReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() {\n"
		"  var f *func(int) int = func(x int) int {\n"
		"    var _ int = x\n"
		"  }\n"
		"  _ = f\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}
