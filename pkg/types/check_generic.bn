package "pkg/types"

import "pkg/ast"
import "pkg/token"

// Generic-instantiation type checking.  Slice 2b of
// plan-generics.md: when `name[args...]` resolves to a generic
// function symbol, substitute the type-args into the function's
// signature and return the instantiated FUNC type.  No
// instantiation cache yet — Slice 4 (IR-gen monomorphization)
// is what needs cache identity for emit-once-per-shape behavior.

// instantiateGenericFunc substitutes e.Args (parsed as Expr nodes
// with type-arg meaning — see typeArgFromExpr) into a generic
// FUNC type's Params and Results.  Returns the instantiated FUNC
// type or TypVoid() on error.
func instantiateGenericFunc(c @Checker, e @ast.Expr, ft @Type) @Type {
	if len(e.Args) != len(ft.TypeParams) {
		addCheckError(c, e.Pos,
			"wrong number of type arguments to generic function")
		return TypVoid()
	}
	var argTypes @[]@Type
	for i := 0; i < len(e.Args); i++ {
		var t @Type = typeArgFromExpr(c, e.Args[i])
		if t == nil { t = TypVoid() }
		argTypes = appendTypePtr(argTypes, t)
	}
	var newParams @[]@Param
	for i := 0; i < len(ft.Params); i++ {
		var p @Param = make(Param)
		p.Name = ft.Params[i].Name
		p.Type = substituteTypeParams(ft.Params[i].Type, argTypes)
		newParams = appendParamPtr(newParams, p)
	}
	var newResults @[]@Type
	for i := 0; i < len(ft.Results); i++ {
		newResults = appendTypePtr(newResults,
			substituteTypeParams(ft.Results[i], argTypes))
	}
	return MakeFuncType(newParams, newResults)
}

// typeArgFromExpr interprets an Expr-shape parse node as a type
// expression.  The parser parses `f[int, *Point]`'s bracketed
// args as Exprs (the syntactic shape is ambiguous with value
// indexing), so we convert here.
//
// Slice 2b accepts: EXPR_IDENT (named-type lookup) and
// EXPR_UNARY(STAR, X) (raw-pointer-to-type).  More elaborate
// type-arg forms (managed, slice, generic instantiation as
// type-arg) land in later slices as they become useful.
func typeArgFromExpr(c @Checker, e @ast.Expr) @Type {
	if e == nil { return TypVoid() }
	if e.Kind == ast.EXPR_IDENT {
		var sym @Symbol = c.Scope.Lookup(e.Name)
		if sym == nil {
			errUndefined(c, e.Pos, e.Name)
			return TypVoid()
		}
		if sym.Kind != SYM_TYPE && sym.Kind != SYM_INTERFACE {
			errNotAType(c, e.Pos, e.Name)
			return TypVoid()
		}
		return sym.Type
	}
	if e.Kind == ast.EXPR_UNARY && e.Op == cast(int, token.STAR) {
		var inner @Type = typeArgFromExpr(c, e.X)
		return MakePointerType(inner)
	}
	addCheckError(c, e.Pos,
		"unsupported type-argument form (use a named type or *T)")
	return TypVoid()
}

// substituteTypeParams walks t and replaces TYP_TYPE_PARAM nodes
// with the args[TpIndex] entry.  Composite types (pointer, slice,
// array, etc.) are rebuilt with the substituted element type.
// Other kinds are returned unchanged.
//
// Assumes every TYP_TYPE_PARAM encountered is owned by the
// generic decl being instantiated — i.e., its TpIndex is a valid
// index into args.  This is true for FUNC types produced by
// resolveFuncDeclType, which only introduces TYP_TYPE_PARAMs from
// its own AST decl.
func substituteTypeParams(t @Type, args @[]@Type) @Type {
	if t == nil { return nil }
	if t.Kind == TYP_TYPE_PARAM {
		if t.TpIndex >= 0 && t.TpIndex < len(args) {
			return args[t.TpIndex]
		}
		return t
	}
	if t.Kind == TYP_POINTER {
		return MakePointerType(substituteTypeParams(t.Elem, args))
	}
	if t.Kind == TYP_MANAGED_PTR {
		return MakeManagedPtrType(substituteTypeParams(t.Elem, args))
	}
	if t.Kind == TYP_SLICE {
		return MakeSliceType(substituteTypeParams(t.Elem, args))
	}
	if t.Kind == TYP_MANAGED_SLICE {
		return MakeManagedSliceType(substituteTypeParams(t.Elem, args))
	}
	if t.Kind == TYP_ARRAY {
		return MakeArrayType(substituteTypeParams(t.Elem, args), t.ArrayLen)
	}
	return t
}
