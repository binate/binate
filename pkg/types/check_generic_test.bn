package "pkg/types"

import "pkg/buf"
import "pkg/builtin/testing"

// Tests for generic-instantiation type checking — Slice 2b of
// plan-generics.md.  These exercise the call path
// `f[T1, ...](args)`: head resolves to a generic FUNC symbol,
// brackets carry type-args, instantiateGenericFunc substitutes
// type params with concrete @Types, the resulting FUNC type
// drives the caller's arg type-checking.
//
// Slice-1 parser test files (parse_func_test.bn,
// parse_expr_test.bn) cover the syntactic shape.  Slice-2a's
// generic-decl body checks live in check_decl_func_test.bn.

// Basic instantiation with a single primitive type arg.
func TestCheckGenericInstantiateIdentInt() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func id[T any](x T) T { return x }\n"
		"func main() { var y int = id[int](5) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Two type-params, one passed as result, one ignored.
func TestCheckGenericInstantiateTwoParams() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func pickFirst[T any, U any](x T, y U) T { return x }\n"
		"func main() { var z int = pickFirst[int, bool](1, true) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Pointer type arg: `id[*int](&x)`.
func TestCheckGenericInstantiatePointerTypeArg() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func id[T any](x T) T { return x }\n"
		"func main() { var x int; var p *int = id[*int](&x) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Wrong number of type args (one expected, two given) errors.
func TestCheckGenericInstantiateWrongArity() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func id[T any](x T) T { return x }\n"
		"func main() { var y int = id[int, bool](5) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Argument-type mismatch after substitution: `id[int]` expects an
// int, supplying a bool rejects.
func TestCheckGenericInstantiateArgTypeMismatch() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func id[T any](x T) T { return x }\n"
		"func main() { var y int = id[int](true) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Unknown type-name in the brackets — `id[unknownThing](5)` —
// surfaces as an undefined error from typeArgFromExpr's scope
// lookup.
func TestCheckGenericInstantiateUnknownTypeArg() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func id[T any](x T) T { return x }\n"
		"func main() { var y int = id[Bogus](5) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Brackets applied to a non-generic head (a non-function name)
// fall through to value-indexing.  Multi-arg form errors with
// "requires a generic function head".
func TestCheckBracketsOnNonGenericHeadMultiArg() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func main() { var s *[]int; var x int = s[0, 1] }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// substituteTypeParams — direct unit tests on each composite kind
// ============================================================
//
// End-to-end source paths only exercise TYP_TYPE_PARAM directly
// and TYP_POINTER via `*T`.  Managed pointer / slice / managed-
// slice / array don't have ergonomic source forms reachable from
// instantiateGenericFunc (you can't write `id[@int]` etc. today),
// so we exercise the substitution walk by building @Type trees
// directly.

// Helper: build a TYP_TYPE_PARAM with index 0 and a dummy owner.
// Owner identity doesn't matter for substituteTypeParams — it
// indexes purely by TpIndex.
func mkTpZero() @Type {
	var owner *uint8 = nil
	return MakeTypeParamType("T", owner, 0, nil)
}

func TestSubstituteTypeParamsBare() testing.TestResult {
	var args @[]@Type = make_slice(@Type, 1)
	args[0] = TypInt()
	var result @Type = substituteTypeParams(mkTpZero(), args)
	if result != TypInt() {
		return fail("substituteTypeParams should return TypInt() for T→int")
	}
	return ""
}

func TestSubstituteTypeParamsPointer() testing.TestResult {
	var args @[]@Type = make_slice(@Type, 1)
	args[0] = TypInt()
	var t @Type = MakePointerType(mkTpZero())
	var result @Type = substituteTypeParams(t, args)
	if result == nil || result.Kind != TYP_POINTER {
		return fail("expected TYP_POINTER result")
	}
	if result.Elem != TypInt() {
		return fail("expected *int after T→int")
	}
	return ""
}

func TestSubstituteTypeParamsManagedPtr() testing.TestResult {
	var args @[]@Type = make_slice(@Type, 1)
	args[0] = TypInt()
	var t @Type = MakeManagedPtrType(mkTpZero())
	var result @Type = substituteTypeParams(t, args)
	if result == nil || result.Kind != TYP_MANAGED_PTR {
		return fail("expected TYP_MANAGED_PTR result")
	}
	if result.Elem != TypInt() {
		return fail("expected @int after T→int")
	}
	return ""
}

func TestSubstituteTypeParamsSlice() testing.TestResult {
	var args @[]@Type = make_slice(@Type, 1)
	args[0] = TypInt()
	var t @Type = MakeSliceType(mkTpZero())
	var result @Type = substituteTypeParams(t, args)
	if result == nil || result.Kind != TYP_SLICE {
		return fail("expected TYP_SLICE result")
	}
	if result.Elem != TypInt() {
		return fail("expected *[]int after T→int")
	}
	return ""
}

func TestSubstituteTypeParamsManagedSlice() testing.TestResult {
	var args @[]@Type = make_slice(@Type, 1)
	args[0] = TypInt()
	var t @Type = MakeManagedSliceType(mkTpZero())
	var result @Type = substituteTypeParams(t, args)
	if result == nil || result.Kind != TYP_MANAGED_SLICE {
		return fail("expected TYP_MANAGED_SLICE result")
	}
	if result.Elem != TypInt() {
		return fail("expected @[]int after T→int")
	}
	return ""
}

func TestSubstituteTypeParamsArray() testing.TestResult {
	var args @[]@Type = make_slice(@Type, 1)
	args[0] = TypInt()
	var t @Type = MakeArrayType(mkTpZero(), 4)
	var result @Type = substituteTypeParams(t, args)
	if result == nil || result.Kind != TYP_ARRAY {
		return fail("expected TYP_ARRAY result")
	}
	if result.Elem != TypInt() {
		return fail("expected [4]int element after T→int")
	}
	if result.ArrayLen != 4 {
		return fail("expected ArrayLen preserved")
	}
	return ""
}

// Pass-through: substitution on a non-composite, non-TYP_TYPE_PARAM
// type returns the input unchanged.
func TestSubstituteTypeParamsPassThrough() testing.TestResult {
	var args @[]@Type = make_slice(@Type, 1)
	args[0] = TypInt()
	if substituteTypeParams(TypBool(), args) != TypBool() {
		return fail("expected TypBool() pass-through")
	}
	return ""
}

// ============================================================
// typeArgFromExpr — rejection paths
// ============================================================

// `id[1](5)` — int literal as type arg — should error with the
// "unsupported type-argument form" message from typeArgFromExpr's
// fallthrough.
func TestCheckGenericTypeArgIntLiteralRejected() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func id[T any](x T) T { return x }\n"
		"func main() { var y int = id[1](5) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// `id[!x](5)` — unary `!` is a value op, not a type op — should
// land in the catch-all rejection.
func TestCheckGenericTypeArgUnsupportedUnaryRejected() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func id[T any](x T) T { return x }\n"
		"func main() { var b bool = true; var y int = id[!b](5) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// ============================================================
// Slice 3 — constraint satisfaction + constraint-method dispatch
// ============================================================

// Constraint = an interface name.  Body calls a constraint
// method; instantiation site supplies a type that has an `impl T
// : I` declaration.
func TestCheckGenericInterfaceConstraintSatisfied() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Foo struct { X int }\n"
		"interface I { M() int }\n"
		"impl Foo : I\n"
		"func (f Foo) M() int { return f.X }\n"
		"func use[T I](t T) int { return t.M() }\n"
		"func main() { var f Foo; var n int = use[Foo](f) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Instantiation with a type that has NO impl for the constraint
// interface — error.
func TestCheckGenericConstraintNotSatisfied() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface I { M() int }\n"
		"func use[T I](t T) int { return t.M() }\n"
		// int has no impl for I in this source — instantiation
		// should report the constraint miss.
		"func main() { var n int = use[int](5) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Calling a method on T that the constraint does NOT declare —
// error (no method M on T).
func TestCheckGenericConstraintMethodNotInIface() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"interface I { M() int }\n"
		// `t.Unknown()` is not in I's method set — should error.
		"func use[T I](t T) int { return t.Unknown() }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Unconstrained type-param (`any`): no method calls allowed on T
// at all.  `t.M()` errors with no-method.
func TestCheckGenericAnyForbidsMethodCalls() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"func use[T any](t T) int { return t.M() }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Constraint method whose signature returns Self — substitution
// threads T through, so calling on T : I returns T (assignable
// to a T-typed var).
func TestCheckGenericConstraintMethodSelfReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Foo struct { X int }\n"
		"interface I { Clone() Self }\n"
		"impl Foo : I\n"
		"func (f Foo) Clone() Foo { return f }\n"
		// In use, t : T and t.Clone() is Self → T.  Returning the
		// Clone result as T is well-typed.
		"func use[T I](t T) T { return t.Clone() }\n"
		"func main() { var f Foo; var g Foo = use[Foo](f) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Self in a PARAM type — Comparable's canonical shape.
// `Compare(other Self) int` on T : Comparable reads as
// `Compare(other T) int` inside the body; calling with another T
// type-checks.
func TestCheckGenericConstraintMethodSelfParam() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Foo struct { X int }\n"
		"interface Cmp { Compare(other Self) int }\n"
		"impl Foo : Cmp\n"
		"func (f Foo) Compare(other Foo) int { return 0 }\n"
		"func use[T Cmp](a T, b T) int { return a.Compare(b) }\n"
		"func main() {\n"
		"	var f1 Foo\n"
		"	var f2 Foo\n"
		"	var n int = use[Foo](f1, f2)\n"
		"}\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

// Self-in-param mismatch — `a.Compare(otherType)` errors because
// after substitution Self → T, the param expects T, not something
// else.
func TestCheckGenericConstraintMethodSelfParamMismatch() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Foo struct { X int }\n"
		"interface Cmp { Compare(other Self) int }\n"
		"impl Foo : Cmp\n"
		"func (f Foo) Compare(other Foo) int { return 0 }\n"
		// Passing a bool to a T-typed param should fail.
		"func bad[T Cmp](a T) int { return a.Compare(true) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectError(c)
}

// Constraint = an interface that extends another.  Methods from
// the parent are reachable on T : Child via lookupFullIfaceMethod.
func TestCheckGenericConstraintInterfaceExtension() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Foo struct { X int }\n"
		"interface Base { Tag() int }\n"
		"interface Child : Base { Extra() int }\n"
		"impl Foo : Child\n"
		"func (f Foo) Tag() int { return 1 }\n"
		"func (f Foo) Extra() int { return 2 }\n"
		// use[T Child] calls Tag (parent method) — must resolve.
		"func use[T Child](t T) int { return t.Tag() }\n"
		"func main() { var f Foo; var n int = use[Foo](f) }\n")
	var src *[]const char = cb.Bytes()
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}
