package "pkg/types"

import "pkg/ast"
import "pkg/buf"
import "pkg/token"

// Interface extension (embedding) — parent resolution, validation,
// and full-method-set walking.  Plan: plan-interface-embedding.md.
//
// Interfaces may extend one or more other interfaces with the
// syntax `interface X : P1, P2 { ... }`.  The new interface's
// method set is the recursive concatenation of each parent's full
// method set plus the interface's own methods.  Cycles are
// statically impossible because parents are resolved at decl time
// (no pre-registration of interfaces); self-extension and
// forward-reference cycles surface as "undefined interface".  Two
// remaining validation steps live here:
//   - duplicate parents listed in the same `:` clause
//   - same-name methods with different signatures across the
//     ancestor closure (or between an ancestor and the interface
//     itself).

// resolveInterfaceExtension resolves each parent named in
// d.Interfaces, validates it (must be an interface; no duplicates),
// stashes it on iface.Parents, and checks for method-name conflicts
// across the resulting ancestor closure.  Errors are added to c;
// the function fills iface.Parents with whatever resolved cleanly
// so downstream impl checks still see something usable.
func resolveInterfaceExtension(c @Checker, d @ast.Decl,
		iface @Type) {
	if d == nil || iface == nil {
		return
	}
	if len(d.Interfaces) == 0 {
		return
	}

	var parents @[]@Type
	for i := 0; i < len(d.Interfaces); i++ {
		var ref @ast.TypeExpr = d.Interfaces[i]
		if ref == nil { continue }
		var p @Type = resolveTypeExprAllowInterface(c, ref)
		if p == nil {
			// resolveTypeExprAllowInterface has already reported
			// "undefined" via its own path.
			continue
		}
		if p.Kind != TYP_INTERFACE {
			var cb buf.CharBuf = buf.New()
			cb = cb.WriteStr(
				"interface extension target must be an interface, got ")
			cb = cb.WriteStr(p.TypeName())
			addCheckError(c, ref.Pos, cb.Bytes())
			continue
		}
		if containsTypePtr(parents, p) {
			var cb buf.CharBuf = buf.New()
			cb = cb.WriteStr("duplicate parent interface `")
			cb = cb.WriteStr(p.Name)
			cb = cb.WriteStr("` in interface ")
			cb = cb.WriteStr(d.Name)
			addCheckError(c, ref.Pos, cb.Bytes())
			continue
		}
		parents = appendTypePtr(parents, p)
	}
	iface.Parents = parents

	checkInterfaceMethodConflicts(c, d, iface)
}

// containsTypePtr reports whether ts contains the same Type
// pointer as t (identity, not structural equality).
func containsTypePtr(ts @[]@Type, t @Type) bool {
	for i := 0; i < len(ts); i++ {
		if ts[i] == t {
			return true
		}
	}
	return false
}

// checkInterfaceMethodConflicts walks the ancestor closure plus own
// methods of iface and reports same-name methods with non-matching
// signatures.  Same-name same-signature is allowed (diamond
// inheritance through a common ancestor is harmless).
func checkInterfaceMethodConflicts(c @Checker, d @ast.Decl,
		iface @Type) {
	var seen @[]@Method
	for i := 0; i < len(iface.Parents); i++ {
		seen = mergeIfaceMethods(c, d.Pos, iface, seen,
			iface.Parents[i])
	}
	for i := 0; i < len(iface.Methods); i++ {
		seen = appendIfaceMethodWithConflictCheck(c, d.Pos, iface,
			seen, iface.Methods[i])
	}
}

// mergeIfaceMethods walks parent's full method set (own +
// ancestors, recursive) and merges each method into `seen`,
// reporting any same-name signature mismatch through c.
func mergeIfaceMethods(c @Checker, pos token.Pos, iface @Type,
		seen @[]@Method, parent @Type) @[]@Method {
	if parent == nil || parent.Kind != TYP_INTERFACE {
		return seen
	}
	for i := 0; i < len(parent.Parents); i++ {
		seen = mergeIfaceMethods(c, pos, iface, seen,
			parent.Parents[i])
	}
	for i := 0; i < len(parent.Methods); i++ {
		seen = appendIfaceMethodWithConflictCheck(c, pos, iface,
			seen, parent.Methods[i])
	}
	return seen
}

// appendIfaceMethodWithConflictCheck adds m to seen if no entry
// with the same name exists; otherwise verifies the existing
// entry's signature matches m's and emits an error if not.
func appendIfaceMethodWithConflictCheck(c @Checker, pos token.Pos,
		iface @Type, seen @[]@Method, m @Method) @[]@Method {
	if m == nil { return seen }
	for i := 0; i < len(seen); i++ {
		if charEq(seen[i].Name, m.Name) {
			if !seen[i].FuncType.Identical(m.FuncType) {
				var cb buf.CharBuf = buf.New()
				cb = cb.WriteStr("conflicting signatures for method `")
				cb = cb.WriteStr(m.Name)
				cb = cb.WriteStr("` in interface ")
				cb = cb.WriteStr(iface.Name)
				cb = cb.WriteStr(" (inherited from multiple parents)")
				addCheckError(c, pos, cb.Bytes())
			}
			return seen
		}
	}
	return appendMethod(seen, m)
}

// ifaceFullMethods returns the deduped method set for iface in
// the order:
//   for each parent (declaration order):
//     parent's full methods (recursive, preorder)
//   own methods
// Methods seen earlier in the walk take precedence (same-name
// duplicates from later positions are skipped).  This matches the
// vtable layout in plan-interface-embedding.md § "Vtable layout":
// `[any-block][P1 full vtable][P2 full vtable][own]`.  Signature
// conflicts are caught at decl time by
// checkInterfaceMethodConflicts; here we just dedup.
func ifaceFullMethods(iface @Type) @[]@Method {
	if iface == nil || iface.Kind != TYP_INTERFACE {
		return iface.Methods
	}
	var out @[]@Method
	for i := 0; i < len(iface.Parents); i++ {
		out = appendUniqueMethods(out,
			ifaceFullMethods(iface.Parents[i]))
	}
	out = appendUniqueMethods(out, iface.Methods)
	return out
}

// appendUniqueMethods appends each method in src to dst, skipping
// entries whose Name already appears in dst.
func appendUniqueMethods(dst @[]@Method, src @[]@Method) @[]@Method {
	for i := 0; i < len(src); i++ {
		var m @Method = src[i]
		if m == nil { continue }
		var found bool = false
		for j := 0; j < len(dst); j++ {
			if charEq(dst[j].Name, m.Name) {
				found = true
				break
			}
		}
		if !found {
			dst = appendMethod(dst, m)
		}
	}
	return dst
}
