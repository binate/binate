// Slice 2.2 satisfaction: receiver-kind smoothing — `impl *T : I`
// is satisfied by a method declared on T (value receiver) per the
// safe-direction rule (caller can pass *T's deref as a value).
func TestCheckImplSmoothingValueOnPtr() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t T) foo() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Slice 2.2 satisfaction: receiver-kind smoothing — `impl T : I`
// is NOT satisfied by a method declared on @T (raw can't promote
// to managed; T can't either).
func TestCheckImplNoSmoothingValueToManaged() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t @T) foo() { }\n")
	cb = cb.WriteStr("impl T : I\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Slice 2.2 satisfaction: an empty interface is trivially satisfied.
func TestCheckImplEmptyInterface() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Empty { }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
