package "pkg/types"

import "pkg/buf"
import "pkg/builtin/testing"

// Tests for impl declaration type-checking — collection
// (collectImplDecl, Slice 2.1) plus satisfaction (checkAllImpls
// Satisfaction, Slice 2.2) of plan-interface-syntax-revision.md.
// Each "impl T : Iface" is paired with method definitions that
// satisfy the interface; the negative tests omit / mis-shape those
// methods to exercise the satisfaction-error paths.

func TestCheckImplValueReceiver() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Stringer { toString() *[]const char }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t T) toString() *[]const char { return \"\" }\n")
	cb = cb.WriteStr("impl T : Stringer\n")
	var c @Checker = checkSrc(cb.Bytes())
	if len(CheckerErrors(c)) > 0 {
		return "unexpected errors"
	}
	if len(c.Impls) != 1 { return "expected 1 impl" }
	var rec @Impl = c.Impls[0]
	if rec.RecvType == nil { return "RecvType is nil" }
	if rec.RecvType.Kind != TYP_NAMED {
		return "value receiver should resolve to TYP_NAMED"
	}
	if len(rec.Interfaces) != 1 {
		return "expected 1 interface"
	}
	if rec.Interfaces[0].Kind != TYP_INTERFACE {
		return "interface entry should be TYP_INTERFACE"
	}
	return ""
}

func TestCheckImplRawPtrReceiver() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Writer { write() }\n")
	cb = cb.WriteStr("type Buf struct { n int }\n")
	cb = cb.WriteStr("func (b *Buf) write() { }\n")
	cb = cb.WriteStr("impl *Buf : Writer\n")
	var c @Checker = checkSrc(cb.Bytes())
	if len(CheckerErrors(c)) > 0 {
		return "unexpected errors"
	}
	if len(c.Impls) != 1 { return "expected 1 impl" }
	if c.Impls[0].RecvType.Kind != TYP_POINTER {
		return "RecvType should be TYP_POINTER"
	}
	return ""
}

func TestCheckImplManagedReceiver() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface R { release() }\n")
	cb = cb.WriteStr("type Obj struct { x int }\n")
	cb = cb.WriteStr("func (o @Obj) release() { }\n")
	cb = cb.WriteStr("impl @Obj : R\n")
	var c @Checker = checkSrc(cb.Bytes())
	if len(CheckerErrors(c)) > 0 {
		return "unexpected errors"
	}
	if c.Impls[0].RecvType.Kind != TYP_MANAGED_PTR {
		return "RecvType should be TYP_MANAGED_PTR"
	}
	return ""
}

func TestCheckImplConstRawPtrReceiver() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface S { snap() }\n")
	cb = cb.WriteStr("type V struct { x int }\n")
	cb = cb.WriteStr("func (v *const V) snap() { }\n")
	cb = cb.WriteStr("impl *const V : S\n")
	var c @Checker = checkSrc(cb.Bytes())
	if len(CheckerErrors(c)) > 0 {
		return "unexpected errors"
	}
	var rt @Type = c.Impls[0].RecvType
	if rt.Kind != TYP_POINTER { return "outer should be TYP_POINTER" }
	if rt.Elem == nil || rt.Elem.Kind != TYP_CONST {
		return "inner should be TYP_CONST"
	}
	return ""
}

func TestCheckImplMultipleInterfaces() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Reader { read() int }\n")
	cb = cb.WriteStr("interface Writer { write() }\n")
	cb = cb.WriteStr("type Pipe struct { x int }\n")
	cb = cb.WriteStr("func (p *Pipe) read() int { return 0 }\n")
	cb = cb.WriteStr("func (p *Pipe) write() { }\n")
	cb = cb.WriteStr("impl *Pipe : Reader, Writer\n")
	var c @Checker = checkSrc(cb.Bytes())
	if len(CheckerErrors(c)) > 0 {
		return "unexpected errors"
	}
	if len(c.Impls[0].Interfaces) != 2 {
		return "expected 2 interfaces"
	}
	return ""
}

// Non-interface name in the interface list must error.
func TestCheckImplNotAnInterface() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("type U struct { y int }\n")
	cb = cb.WriteStr("impl T : U\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Undefined interface name must error.
func TestCheckImplUndefinedInterface() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("impl T : NonExistent\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Slice 2.2 satisfaction: missing method must error.
func TestCheckImplMissingMethod() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("impl T : I\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Slice 2.2 satisfaction: method present but signature mismatch.
func TestCheckImplMethodSigMismatch() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo(x int) }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t T) foo(s bool) { }\n")
	cb = cb.WriteStr("impl T : I\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Slice 2.2 satisfaction: receiver-kind smoothing — `impl *T : I`
// is satisfied by a method declared on T (value receiver) per the
// safe-direction rule (caller can pass *T's deref as a value).
func TestCheckImplSmoothingValueOnPtr() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t T) foo() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Slice 2.2 satisfaction: receiver-kind smoothing — `impl T : I`
// is NOT satisfied by a method declared on @T (raw can't promote
// to managed; T can't either).
func TestCheckImplNoSmoothingValueToManaged() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t @T) foo() { }\n")
	cb = cb.WriteStr("impl T : I\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Slice 2.2 satisfaction: an empty interface is trivially satisfied.
func TestCheckImplEmptyInterface() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Empty { }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("impl T : Empty\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}
