// Slice 2.3b assignability: `*T → @Iface` rejected — raw pointer
// can't promote to managed (no refcount header to RefInc).
func TestCheckIfaceRejectRawToManaged() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv @I = &t\n")
	cb = cb.WriteStr("\t_ = iv\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Slice 2.3a-2 assignability: smoothing — `impl T : I` with a
// value receiver should be reachable from `*T` (deref to value).
func TestCheckIfaceAssignSmoothingValue() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t T) foo() { }\n")
	cb = cb.WriteStr("impl T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv *I = &t\n")
	cb = cb.WriteStr("\t_ = iv\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}
