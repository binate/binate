// Slice 2.3a-2 assignability: `*T → *Iface` accepted when an impl
// connects T to Iface with a reachable receiver kind.
func TestCheckIfaceAssignFromRawPtr() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv *I = &t\n")
	cb = cb.WriteStr("\t_ = iv\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Slice 2.3a-2 assignability: `T → *Iface` rejected (no implicit
// address-of at construction; user must write `&t`).
func TestCheckIfaceRejectValueAssign() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv *I = t\n")
	cb = cb.WriteStr("\t_ = iv\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Slice 2.3a-2 assignability: `*T → *Iface` rejected when no impl
// connects T to that interface — even if the methods happen to
// match. Explicit-impl model: structural matching alone isn't
// enough.
func TestCheckIfaceRejectNoImpl() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() { }\n")
	// no `impl *T : I`
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv *I = &t\n")
	cb = cb.WriteStr("\t_ = iv\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Slice 2.3a-2 assignability: `@T → *Iface` accepted (managed-as-
// raw — managed pointers can be used wherever a raw pointer fits).
func TestCheckIfaceAssignFromManagedPtr() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t @T = make(T)\n")
	cb = cb.WriteStr("\tvar iv *I = t\n")
	cb = cb.WriteStr("\t_ = iv\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Slice 2.3a-3 dispatch: calling a method declared on the
// interface through an interface value type-checks. The method
// lookup happens against the interface's method set, NOT the
// receiver's named-type method set — confirms tryMethodCall's
// interface-routing path.
func TestCheckIfaceDispatchAccepted() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() int }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() int { return 0 }\n")
	cb = cb.WriteStr("impl *T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv *I = &t\n")
	cb = cb.WriteStr("\tvar r int = iv.foo()\n")
	cb = cb.WriteStr("\t_ = r\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Slice 2.3a-3 dispatch: calling a method NOT in the interface's
// method set is an error, even when the receiver type itself has
// a same-named method. Keeps interface dispatch nominal.
func TestCheckIfaceDispatchRejectsExtraMethod() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() { }\n")
	cb = cb.WriteStr("func (t *T) bar() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv *I = &t\n")
	cb = cb.WriteStr("\tiv.bar()\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Slice 2.4: interface alias resolves to the same TYP_INTERFACE as
// its target — `impl T : Hi` is valid when Hi aliases Greeter and
// T satisfies Greeter's methods.
func TestCheckInterfaceAlias() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Greeter { greet() }\n")
	cb = cb.WriteStr("interface Hi = Greeter\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) greet() { }\n")
	cb = cb.WriteStr("impl *T : Hi\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Slice 2.4: alias target must be an interface — `interface X = T`
// where T is a struct must error.
func TestCheckInterfaceAliasNonInterface() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("interface X = T\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Slice 2.3b assignability: `@T → @Iface` accepted when an impl
// connects T to Iface with a reachable receiver kind.
func TestCheckIfaceAssignManagedToManaged() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t @T = make(T)\n")
	cb = cb.WriteStr("\tvar iv @I = t\n")
	cb = cb.WriteStr("\t_ = iv\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Slice 2.3b assignability: `*T → @Iface` rejected — raw pointer
// can't promote to managed (no refcount header to RefInc).
func TestCheckIfaceRejectRawToManaged() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) foo() { }\n")
	cb = cb.WriteStr("impl *T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv @I = &t\n")
	cb = cb.WriteStr("\t_ = iv\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Slice 2.3a-2 assignability: smoothing — `impl T : I` with a
// value receiver should be reachable from `*T` (deref to value).
func TestCheckIfaceAssignSmoothingValue() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface I { foo() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t T) foo() { }\n")
	cb = cb.WriteStr("impl T : I\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar iv *I = &t\n")
	cb = cb.WriteStr("\t_ = iv\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// ============================================================
// Slice E.2: impls of extended interfaces — full method set
// (own + inherited) must be satisfied by the receiver type.
// ============================================================

// Receiver covers both inherited and own methods → clean.
func TestCheckImplExtendedInterfaceAllMethodsPresent() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Closer { Close() }\n")
	cb = cb.WriteStr("interface RC : Closer { Read() int }\n")
	cb = cb.WriteStr("type File struct { fd int }\n")
	cb = cb.WriteStr("func (f *File) Close() { }\n")
	cb = cb.WriteStr("func (f *File) Read() int { return 0 }\n")
	cb = cb.WriteStr("impl *File : RC\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Receiver has own method but is missing an inherited one → error.
func TestCheckImplExtendedInterfaceMissingInheritedMethod() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Closer { Close() }\n")
	cb = cb.WriteStr("interface RC : Closer { Read() int }\n")
	cb = cb.WriteStr("type File struct { fd int }\n")
	cb = cb.WriteStr("func (f *File) Read() int { return 0 }\n")
	// Missing Close — inherited from Closer.
	cb = cb.WriteStr("impl *File : RC\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Diamond: deep ancestor's method must be required.
func TestCheckImplExtendedInterfaceDeepInheritance() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Top { Top() }\n")
	cb = cb.WriteStr("interface A : Top {}\n")
	cb = cb.WriteStr("interface B : A {}\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) Top() { }\n")
	cb = cb.WriteStr("impl *T : B\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// ============================================================
// Slice E.4 part 2: `*Child → *Parent` / `@Child → @Parent`
// upcast assignment.  The type checker accepts iface-value sources
// when the source's interface is a descendant of the dest's.
// ============================================================

func TestCheckIfaceUpcastRawToRaw() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Closer { Close() }\n")
	cb = cb.WriteStr("interface RC : Closer { Read() int }\n")
	cb = cb.WriteStr("type F struct { x int }\n")
	cb = cb.WriteStr("func (f *F) Close() { }\n")
	cb = cb.WriteStr("func (f *F) Read() int { return 0 }\n")
	cb = cb.WriteStr("impl *F : RC\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar f F\n")
	cb = cb.WriteStr("\tvar rc *RC = &f\n")
	cb = cb.WriteStr("\tvar c *Closer = rc\n")
	cb = cb.WriteStr("\t_ = c\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckIfaceUpcastManagedToManaged() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Closer { Close() }\n")
	cb = cb.WriteStr("interface RC : Closer { Read() int }\n")
	cb = cb.WriteStr("type F struct { x int }\n")
	cb = cb.WriteStr("func (f @F) Close() { }\n")
	cb = cb.WriteStr("func (f @F) Read() int { return 0 }\n")
	cb = cb.WriteStr("impl @F : RC\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar f @F = make(F)\n")
	cb = cb.WriteStr("\tvar rc @RC = f\n")
	cb = cb.WriteStr("\tvar c @Closer = rc\n")
	cb = cb.WriteStr("\t_ = c\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Deep upcast: `*GrandChild → *GrandParent` via a transitive
// ancestor relation also works.
func TestCheckIfaceUpcastDeep() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Top { Top() }\n")
	cb = cb.WriteStr("interface Mid : Top {}\n")
	cb = cb.WriteStr("interface Bot : Mid {}\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) Top() { }\n")
	cb = cb.WriteStr("impl *T : Bot\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar b *Bot = &t\n")
	cb = cb.WriteStr("\tvar top *Top = b\n")
	cb = cb.WriteStr("\t_ = top\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Sibling interfaces (no ancestor relation) cannot upcast to each
// other even though they happen to be in the same hierarchy.
func TestCheckIfaceUpcastSiblingRejected() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface A { fa() }\n")
	cb = cb.WriteStr("interface B { fb() }\n")
	cb = cb.WriteStr("type T struct { x int }\n")
	cb = cb.WriteStr("func (t *T) fa() { }\n")
	cb = cb.WriteStr("func (t *T) fb() { }\n")
	cb = cb.WriteStr("impl *T : A, B\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar t T\n")
	cb = cb.WriteStr("\tvar a *A = &t\n")
	cb = cb.WriteStr("\tvar b *B = a\n")  // A → B has no extension link
	cb = cb.WriteStr("\t_ = b\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Wrong-direction (parent → child) is also rejected: a *Parent
// value isn't necessarily a *Child (the *Parent could have been
// built from a type that implements Parent but not Child).
func TestCheckIfaceUpcastWrongDirectionRejected() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Closer { Close() }\n")
	cb = cb.WriteStr("interface RC : Closer { Read() int }\n")
	cb = cb.WriteStr("type F struct { x int }\n")
	cb = cb.WriteStr("func (f *F) Close() { }\n")
	cb = cb.WriteStr("func (f *F) Read() int { return 0 }\n")
	cb = cb.WriteStr("impl *F : RC\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar f F\n")
	cb = cb.WriteStr("\tvar c *Closer = &f\n")
	cb = cb.WriteStr("\tvar rc *RC = c\n")  // Closer → RC is not safe
	cb = cb.WriteStr("\t_ = rc\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// `*Child → @Parent` is rejected for the same reason `*T → @Iface`
// is: cannot invent a refcount on a raw value.
func TestCheckIfaceUpcastRawToManagedRejected() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Closer { Close() }\n")
	cb = cb.WriteStr("interface RC : Closer { Read() int }\n")
	cb = cb.WriteStr("type F struct { x int }\n")
	cb = cb.WriteStr("func (f *F) Close() { }\n")
	cb = cb.WriteStr("func (f *F) Read() int { return 0 }\n")
	cb = cb.WriteStr("impl *F : RC\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar f F\n")
	cb = cb.WriteStr("\tvar rc *RC = &f\n")
	cb = cb.WriteStr("\tvar c @Closer = rc\n")  // raw → managed
	cb = cb.WriteStr("\t_ = c\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// `@Child → *Parent` is the managed-as-raw upcast — mirrors the
// existing `@T → *T` decay (managed acts as raw data ptr; caller
// keeps the original alive for the duration of the borrow).
func TestCheckIfaceUpcastManagedToRaw() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Closer { Close() }\n")
	cb = cb.WriteStr("interface RC : Closer { Read() int }\n")
	cb = cb.WriteStr("type F struct { x int }\n")
	cb = cb.WriteStr("func (f @F) Close() { }\n")
	cb = cb.WriteStr("func (f @F) Read() int { return 0 }\n")
	cb = cb.WriteStr("impl @F : RC\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("\tvar f @F = make(F)\n")
	cb = cb.WriteStr("\tvar rc @RC = f\n")
	cb = cb.WriteStr("\tvar c *Closer = rc\n")  // managed → raw
	cb = cb.WriteStr("\t_ = c\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}
