package "pkg/types"

import "pkg/buf"
import "pkg/builtin/testing"

// Tests for interface declaration type-checking
// (collectInterfaceDecl in check_interface.bn). Phase 1 of
// plan-interface-syntax-revision.md only validates the declaration
// shape — bare interface names aren't yet usable as type
// expressions, so these tests stop at "interface symbol is defined
// with the right method set."

func TestCheckInterfaceEmpty() testing.TestResult {
	var src *[]const char =
		"package \"test\"\ninterface Empty {\n}\n"
	var c @Checker = checkSrc(src)
	return expectNoErrors(c)
}

func TestCheckInterfaceSingleMethod() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Stringer {\n")
	cb = cb.WriteStr("\ttoString() *[]const char\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckInterfaceMultiMethod() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Comparator {\n")
	cb = cb.WriteStr("\tcompare(a int, b int) int\n")
	cb = cb.WriteStr("\tequal(a int, b int) bool\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckInterfaceMultiReturn() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface MR {\n")
	cb = cb.WriteStr("\tpair() (int, int)\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckInterfaceDuplicateMethod() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Bad {\n")
	cb = cb.WriteStr("\tdoIt() int\n")
	cb = cb.WriteStr("\tdoIt(x int) int\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Verify the interface symbol is registered in the checker scope
// with the right Type kind and method count. Uses checkSrcResolved
// so the file's scope persists through the test (checkSrc pops it).
func TestCheckInterfaceSymbolDefined() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("interface Two {\n")
	cb = cb.WriteStr("\ta() int\n")
	cb = cb.WriteStr("\tb() bool\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrcResolved(cb.Bytes())
	if len(CheckerErrors(c)) > 0 {
		return "unexpected errors"
	}
	var sym @Symbol = Lookup(c.Scope, "Two")
	if sym == nil { return "Two not in scope" }
	if sym.Kind != SYM_INTERFACE {
		return "Two symbol kind != SYM_INTERFACE"
	}
	if sym.Type == nil { return "Two has nil Type" }
	if sym.Type.Kind != TYP_INTERFACE {
		return "Two.Type.Kind != TYP_INTERFACE"
	}
	if len(sym.Type.Methods) != 2 {
		return "Two.Type.Methods should have 2 entries"
	}
	return ""
}
