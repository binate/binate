package "pkg/types"

import "pkg/buf"
import "pkg/builtin/testing"

// ============================================================
// Method calls (Stage 3 of plan-receivers.md)
//
// These tests exercise tryMethodCall and the receiver-smoothing rules
// in receiverShape / receiverAssignable.
// ============================================================

func TestCheckMethodCallPointerOnPointer() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Point struct { x int }\n")
	cb = cb.WriteStr("func (p *Point) X() int { return p.x }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var pp *Point = nil\n")
	cb = cb.WriteStr("  var v int = pp.X()\n")
	cb = cb.WriteStr("  println(v)\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodCallValueOnValue() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Counter struct { n int }\n")
	cb = cb.WriteStr("func (c Counter) Get() int { return c.n }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var ctr Counter\n")
	cb = cb.WriteStr("  var v int = ctr.Get()\n")
	cb = cb.WriteStr("  println(v)\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// @T receiver expression on @T method.
func TestCheckMethodCallManagedOnManaged() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Node struct { val int }\n")
	cb = cb.WriteStr("func (n @Node) Val() int { return n.val }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var n @Node = make(Node)\n")
	cb = cb.WriteStr("  var v int = n.Val()\n")
	cb = cb.WriteStr("  println(v)\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// @T receiver expression on *T method (managed → raw smoothing).
func TestCheckMethodCallManagedOnPointer() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Node struct { val int }\n")
	cb = cb.WriteStr("func (n *Node) Val() int { return n.val }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var n @Node = make(Node)\n")
	cb = cb.WriteStr("  var v int = n.Val()\n")
	cb = cb.WriteStr("  println(v)\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// *T receiver expression on T method (auto-deref to value).
func TestCheckMethodCallPointerOnValue() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Counter struct { n int }\n")
	cb = cb.WriteStr("func (c Counter) Get() int { return c.n }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var pp *Counter = nil\n")
	cb = cb.WriteStr("  var v int = pp.Get()\n")
	cb = cb.WriteStr("  println(v)\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Argument count mismatch is reported.
func TestCheckMethodCallWrongArgCount() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Point struct { x int }\n")
	cb = cb.WriteStr("func (p *Point) Set(v int) { p.x = v }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var pp *Point = nil\n")
	cb = cb.WriteStr("  pp.Set()\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Method call on a type with no such method is an error.
func TestCheckMethodCallUnknownMethod() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Point struct { x int }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var pp *Point = nil\n")
	cb = cb.WriteStr("  pp.MissingMethod()\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// *T receiver expression cannot satisfy @T method (no implicit raw → managed).
func TestCheckMethodCallPointerOnManagedRejected() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type Node struct { val int }\n")
	cb = cb.WriteStr("func (n @Node) Val() int { return n.val }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var pp *Node = nil\n")
	cb = cb.WriteStr("  pp.Val()\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Two methods on different types with the same name resolve by receiver type.
func TestCheckMethodCallDispatchByType() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr("package \"test\"\n")
	cb = cb.WriteStr("type A struct { v int }\n")
	cb = cb.WriteStr("type B struct { v bool }\n")
	cb = cb.WriteStr("func (a *A) Get() int { return a.v }\n")
	cb = cb.WriteStr("func (b *B) Get() bool { return b.v }\n")
	cb = cb.WriteStr("func main() {\n")
	cb = cb.WriteStr("  var pa *A = nil\n")
	cb = cb.WriteStr("  var pb *B = nil\n")
	cb = cb.WriteStr("  var x int = pa.Get()\n")
	cb = cb.WriteStr("  var y bool = pb.Get()\n")
	cb = cb.WriteStr("  println(x); println(y)\n")
	cb = cb.WriteStr("}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}
