package "pkg/types"

import "pkg/buf"
import "pkg/builtin/testing"

// ============================================================
// Method calls (Stage 3 of plan-receivers.md)
//
// These tests exercise tryMethodCall and the receiver-smoothing rules
// in receiverShape / receiverAssignable.
// ============================================================

func TestCheckMethodCallPointerOnPointer() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Point struct { x int }\n"
		"func (p *Point) X() int { return p.x }\n"
		"func main() {\n"
		"  var pp *Point = nil\n"
		"  var v int = pp.X()\n"
		"  println(v)\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

func TestCheckMethodCallValueOnValue() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Counter struct { n int }\n"
		"func (c Counter) Get() int { return c.n }\n"
		"func main() {\n"
		"  var ctr Counter\n"
		"  var v int = ctr.Get()\n"
		"  println(v)\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// @T receiver expression on @T method.
func TestCheckMethodCallManagedOnManaged() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Node struct { val int }\n"
		"func (n @Node) Val() int { return n.val }\n"
		"func main() {\n"
		"  var n @Node = make(Node)\n"
		"  var v int = n.Val()\n"
		"  println(v)\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// @T receiver expression on *T method (managed → raw smoothing).
func TestCheckMethodCallManagedOnPointer() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Node struct { val int }\n"
		"func (n *Node) Val() int { return n.val }\n"
		"func main() {\n"
		"  var n @Node = make(Node)\n"
		"  var v int = n.Val()\n"
		"  println(v)\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// *T receiver expression on T method (auto-deref to value).
func TestCheckMethodCallPointerOnValue() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Counter struct { n int }\n"
		"func (c Counter) Get() int { return c.n }\n"
		"func main() {\n"
		"  var pp *Counter = nil\n"
		"  var v int = pp.Get()\n"
		"  println(v)\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}

// Argument count mismatch is reported.
func TestCheckMethodCallWrongArgCount() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Point struct { x int }\n"
		"func (p *Point) Set(v int) { p.x = v }\n"
		"func main() {\n"
		"  var pp *Point = nil\n"
		"  pp.Set()\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Method call on a type with no such method is an error.
func TestCheckMethodCallUnknownMethod() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Point struct { x int }\n"
		"func main() {\n"
		"  var pp *Point = nil\n"
		"  pp.MissingMethod()\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// *T receiver expression cannot satisfy @T method (no implicit raw → managed).
func TestCheckMethodCallPointerOnManagedRejected() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type Node struct { val int }\n"
		"func (n @Node) Val() int { return n.val }\n"
		"func main() {\n"
		"  var pp *Node = nil\n"
		"  pp.Val()\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectError(c)
}

// Two methods on different types with the same name resolve by receiver type.
func TestCheckMethodCallDispatchByType() testing.TestResult {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteStr(
		"package \"test\"\n"
		"type A struct { v int }\n"
		"type B struct { v bool }\n"
		"func (a *A) Get() int { return a.v }\n"
		"func (b *B) Get() bool { return b.v }\n"
		"func main() {\n"
		"  var pa *A = nil\n"
		"  var pb *B = nil\n"
		"  var x int = pa.Get()\n"
		"  var y bool = pb.Get()\n"
		"  println(x); println(y)\n"
		"}\n")
	var c @Checker = checkSrc(cb.Bytes())
	return expectNoErrors(c)
}
