package "pkg/types"

import "pkg/ast"

// Tier 3 forward references — pending-decl plumbing.  Kept in
// its own file because the substrate is a discrete subsystem
// (queue mutation + retry mechanics + a couple of small
// predicates) and pulling it out keeps checker.bn under the
// file-length cap.  The TentativeMode error-routing in
// errUndefined / addCheckError stays in checker.bn alongside
// the rest of the error reporters; everything else is here.

// migrateTentativeErrors moves any errors captured in
// TentativeMode from c.TentativeErrors into c.Errors, then
// clears TentativeErrors.  Called when no missing names were
// captured — meaning the errors are genuinely the user's, not
// cascade noise from forward refs.
func migrateTentativeErrors(c @Checker) {
	for i := 0; i < len(c.TentativeErrors); i++ {
		c.Errors = appendCheckError(c.Errors, c.TentativeErrors[i])
	}
	var emptyTentErrs @[]CheckError
	c.TentativeErrors = emptyTentErrs
}

// parkPendingDecl appends a {decl, missing-names} record to
// c.Pending.  Caller (CheckDeclInScope) does this after a
// tentative body check found undefined names but no other
// errors.
func parkPendingDecl(c @Checker, d @ast.Decl,
		missing @[]@[]char) {
	var pd @PendingDecl = make(PendingDecl)
	pd.Decl = d
	pd.MissingNames = missing
	c.Pending = appendPendingDecl(c.Pending, pd)
}

// appendPendingDecl returns a new slice with `pd` appended.
func appendPendingDecl(s @[]@PendingDecl, pd @PendingDecl) @[]@PendingDecl {
	var n int = len(s)
	var ns @[]@PendingDecl = make_slice(@PendingDecl, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = pd
	return ns
}

// IsDeclPending reports whether the most recent
// CheckDeclInScope call parked its decl.  Equivalent to
// `len(c.TentativeMissing) > 0`.  REPL driver gate for
// "skip IR-gen, print parked-message".
func (c @Checker) IsDeclPending() bool {
	return len(c.TentativeMissing) > 0
}

// RetryPendingDecls re-runs the body check (in TentativeMode)
// on every entry of c.Pending.  Returns the decls that now
// resolve cleanly so the REPL driver can IR-gen and lower
// them.  Decls still missing names stay parked.
func (c @Checker) RetryPendingDecls() @[]@ast.Decl {
	var resolved @[]@ast.Decl
	if len(c.Pending) == 0 { return resolved }
	var stillPending @[]@PendingDecl
	for i := 0; i < len(c.Pending); i++ {
		var pd @PendingDecl = c.Pending[i]
		var single @[]@ast.Decl = make_slice(@ast.Decl, 1)
		single[0] = pd.Decl
		var emptyMissing @[]@[]char
		c.TentativeMissing = emptyMissing
		var emptyTentErrs @[]CheckError
		c.TentativeErrors = emptyTentErrs
		c.TentativeMode = true
		checkDecls(c, single)
		c.TentativeMode = false
		if len(c.TentativeMissing) == 0 {
			// Body now resolves cleanly enough to leave
			// tentative mode.  Any TentativeErrors are real
			// errors (post-resolution type mismatches, etc.)
			// — surface them and treat the decl as "resolved
			// but error-bearing" by not adding to resolved
			// (caller wouldn't IR-gen a real-error decl).
			migrateTentativeErrors(c)
			resolved = appendDeclSlice(resolved, pd.Decl)
		} else {
			pd.MissingNames = c.TentativeMissing
			stillPending = appendPendingDecl(stillPending, pd)
		}
	}
	c.Pending = stillPending
	var emptyMissing2 @[]@[]char
	c.TentativeMissing = emptyMissing2
	return resolved
}

// appendDeclSlice returns a new slice with `d` appended.
func appendDeclSlice(s @[]@ast.Decl, d @ast.Decl) @[]@ast.Decl {
	var n int = len(s)
	var ns @[]@ast.Decl = make_slice(@ast.Decl, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = d
	return ns
}

// IsPendingFunc reports whether `name` is currently parked in
// the checker's pending queue (a func whose body couldn't be
// fully checked because it referenced names that weren't
// bound).  Use-site call paths can surface a clear error
// rather than letting a parked symbol's stale type propagate.
func (c @Checker) IsPendingFunc(name *[]const char) bool {
	for i := 0; i < len(c.Pending); i++ {
		var pd @PendingDecl = c.Pending[i]
		if pd.Decl.Kind != ast.DECL_FUNC { continue }
		if pd.Decl.Recv != nil { continue }
		if charEq(pd.Decl.Name, name) { return true }
	}
	return false
}

