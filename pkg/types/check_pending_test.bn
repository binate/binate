package "pkg/types"

import "pkg/ast"
import "pkg/builtin/testing"
import "pkg/parser"

// Tests for the Tier 3 pending-decl substrate in
// check_pending.bn (parkPendingDecl, RetryPendingDecls,
// IsDeclPending, IsPendingDecl, migrateTentativeErrors) plus
// the TentativeMode error-routing in
// errUndefined / addCheckError that lives in checker.bn.

// TestPendingForwardRefParks verifies that a func decl whose
// body references an undefined name is parked on c.Pending
// (not reported as an error) and that IsDeclPending reflects it.
func TestPendingForwardRefParks() testing.TestResult {
	var src *[]const char =
		"func f() int { return g() + 1 }"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no user-visible errors")
	}
	if !c.IsDeclPending() {
		return fail("expected IsDeclPending to be true")
	}
	if !c.IsPendingDecl("f") {
		return fail("expected IsPendingDecl(f) to be true")
	}
	if c.Scope.Lookup("f") == nil {
		return fail("f's sig must still be in scope")
	}
	return ""
}

// TestPendingResolvedAfterDep verifies that defining the
// missing name triggers RetryPendingDecls to report f as
// resolved.
func TestPendingResolvedAfterDep() testing.TestResult {
	var c @Checker = NewChecker()

	var fSrc *[]const char = "func f() int { return g() + 1 }"
	var pf @parser.Parser = parser.New(toBytes(fSrc), "<repl>")
	var fd @ast.Decl = pf.ParseTopLevelDecl()
	c.CheckDeclInScope(fd)
	if !c.IsPendingDecl("f") {
		return fail("setup: f should park initially")
	}

	var gSrc *[]const char = "func g() int { return 41 }"
	var pg @parser.Parser = parser.New(toBytes(gSrc), "<repl>")
	var gd @ast.Decl = pg.ParseTopLevelDecl()
	c.CheckDeclInScope(gd)
	if c.IsDeclPending() {
		return fail("g should not park")
	}

	var resolved @[]@ast.Decl = c.RetryPendingDecls()
	if len(resolved) != 1 {
		return fail("expected exactly one resolved decl")
	}
	if !charEq(resolved[0].Name, "f") {
		return fail("expected f in resolved")
	}
	if c.IsPendingDecl("f") {
		return fail("f should no longer be pending after retry")
	}
	return ""
}

// TestPendingUseSiteError verifies that calling a still-pending
// function from non-tentative-mode code surfaces a clear
// "function X is unresolved" error rather than letting the
// runtime hit "extern not found".
func TestPendingUseSiteError() testing.TestResult {
	var c @Checker = NewChecker()

	var fSrc *[]const char = "func f() int { return g() }"
	var pf @parser.Parser = parser.New(toBytes(fSrc), "<repl>")
	var fd @ast.Decl = pf.ParseTopLevelDecl()
	c.CheckDeclInScope(fd)
	if !c.IsPendingDecl("f") {
		return fail("setup: f should park")
	}

	// Use f from a stmt-list context.
	var stmtSrc *[]const char = "f()"
	var pst @parser.Parser = parser.New(toBytes(stmtSrc), "<repl>")
	var ss @[]@ast.Stmt = pst.ParseStmtList()
	var beforeErrs int = len(c.CheckerErrors())
	c.CheckStmtListInScope(ss)
	if len(c.CheckerErrors()) <= beforeErrs {
		return fail("expected an error from calling pending f")
	}
	return ""
}

// TestPendingTentativeBodyHidesCascade verifies that errors
// downstream of an undefined name (e.g., "cannot call non-
// function") are suppressed when the body's tentative check
// captures the missing name.  Without this, the user sees
// noise like "f parked AND cannot call non-function" when only
// the parking is meaningful.
func TestPendingTentativeBodyHidesCascade() testing.TestResult {
	var src *[]const char =
		"func f() int { return g() + 1 }"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	// No errors should reach the user — the cascading errors
	// (cannot call non-function, arithmetic op requires
	// numeric) are noise from the missing name.
	if len(c.CheckerErrors()) != 0 {
		return fail("cascading errors should be hidden when parked")
	}
	return ""
}

// TestPendingVarParks verifies Stage 1: a typed var whose
// initializer references an undefined name parks rather than
// erroring.  The symbol stays in scope (so use sites can see
// it), but use sites surface "variable X is unresolved".
func TestPendingVarParks() testing.TestResult {
	var src *[]const char =
		"var x int = g() + 1"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no user-visible errors for parked var")
	}
	if !c.IsDeclPending() {
		return fail("expected IsDeclPending to be true")
	}
	if !c.IsPendingDecl("x") {
		return fail("expected IsPendingDecl(x) to be true")
	}
	// Typed var's symbol enters scope in collectDecls (pass 1).
	if c.Scope.Lookup("x") == nil {
		return fail("typed var x's symbol must still be in scope")
	}
	return ""
}

