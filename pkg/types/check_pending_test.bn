// TestPendingVarResolves verifies that defining the missing
// initializer dependency triggers RetryPendingDecls to report
// the var as resolved.
func TestPendingVarResolves() testing.TestResult {
	var c @Checker = NewChecker()

	var vSrc *[]const char = "var x int = g() + 1"
	var pv @parser.Parser = parser.New(toBytes(vSrc), "<repl>")
	var vd @ast.Decl = pv.ParseTopLevelDecl()
	c.CheckDeclInScope(vd)
	if !c.IsPendingDecl("x") {
		return fail("setup: x should park initially")
	}

	var gSrc *[]const char = "func g() int { return 41 }"
	var pg @parser.Parser = parser.New(toBytes(gSrc), "<repl>")
	var gd @ast.Decl = pg.ParseTopLevelDecl()
	c.CheckDeclInScope(gd)

	var resolved @[]@ast.Decl = c.RetryPendingDecls()
	if len(resolved) != 1 {
		return fail("expected exactly one resolved decl")
	}
	if !charEq(resolved[0].Name, "x") {
		return fail("expected x in resolved")
	}
	if c.IsPendingDecl("x") {
		return fail("x should no longer be pending after retry")
	}
	return ""
}

// TestPendingConstGroupPerMember verifies Stage 1 (c) of
// plan-repl-tier3-pending-types.md: a const group is per-member
// — each const inside the group parks independently.  A
// member that resolves cleanly (`A int = 1`) lands; a member
// whose value references an undefined name (`B int = M + 1`)
// parks alone.  Groups are syntactic sugar with no semantic
// effect.
func TestPendingConstGroupPerMember() testing.TestResult {
	var src *[]const char =
		"const (\n  A int = 1\n  B int = M + 1\n)"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }
	if d.Kind != ast.DECL_GROUP {
		return fail("expected DECL_GROUP")
	}

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no user-visible errors")
	}
	if !c.IsDeclPending() {
		return fail("expected IsDeclPending true (B parked)")
	}
	// Only B should park.  A's clean resolution shouldn't be
	// derailed by B's missing dep.
	if c.IsPendingDecl("A") {
		return fail("A should NOT be pending — its value resolves cleanly")
	}
	if !c.IsPendingDecl("B") {
		return fail("B should be pending — references undefined M")
	}
	// Exactly one PendingDecl was appended during this call.
	if len(c.Pending) - c.PendingMark != 1 {
		return fail("expected one freshly-parked decl (B)")
	}
	// And A's symbol is in scope (collectDecls pass 1 + clean
	// pass 2 defined it).
	if c.Scope.Lookup("A") == nil {
		return fail("A's symbol must be in scope after clean check")
	}
	return ""
}

// TestTypeIsPendingDefaultsFalse verifies that the new
// Type.IsPending field (Stage 2 (a) prep) defaults to false on
// every Type-construction entry point so existing code paths
// behave identically to before.
func TestTypeIsPendingDefaultsFalse() testing.TestResult {
	if TypInt().IsPending { return fail("TypInt should not be pending") }
	if TypChar().IsPending { return fail("TypChar should not be pending") }
	var n @Type = MakeNamedType("Foo")
	if n.IsPending { return fail("freshly-made named type should not be pending") }
	var s @Type = MakeSliceType(TypInt())
	if s.IsPending { return fail("MakeSliceType should not set IsPending") }
	var ms @Type = MakeManagedSliceType(TypInt())
	if ms.IsPending { return fail("MakeManagedSliceType should not set IsPending") }
	return ""
}

// TestCapturePendingDepInTentativeMode verifies the new
// capturePendingDep helper captures into TentativeMissing
// when tentative mode is set, and dedups against existing
// entries.
func TestCapturePendingDepInTentativeMode() testing.TestResult {
	var c @Checker = NewChecker()
	c.TentativeMode = true

	capturePendingDep(c, "Bag")
	if len(c.TentativeMissing) != 1 {
		return fail("expected one captured name")
	}
	if !charEq(c.TentativeMissing[0], "Bag") {
		return fail("expected 'Bag' in TentativeMissing")
	}
	// Second capture of same name: dedup.
	capturePendingDep(c, "Bag")
	if len(c.TentativeMissing) != 1 {
		return fail("expected dedup; second capture of same name should be no-op")
	}
	// Different name: appends.
	capturePendingDep(c, "Other")
	if len(c.TentativeMissing) != 2 {
		return fail("expected two captured names after distinct call")
	}
	return ""
}

// TestCapturePendingDepOutsideTentativeIsNoop verifies the
// helper does nothing when TentativeMode is unset — capture
// only makes sense as part of an in-progress tentative check.
func TestCapturePendingDepOutsideTentativeIsNoop() testing.TestResult {
	var c @Checker = NewChecker()
	// TentativeMode defaults to false.
	capturePendingDep(c, "Bag")
	if len(c.TentativeMissing) != 0 {
		return fail("capturePendingDep should be a no-op outside TentativeMode")
	}
	return ""
}

// TestPendingStructTypeParks verifies Stage 2 (b): a struct
// type decl whose field type references an undefined name
// parks rather than firing immediately.  The placeholder
// stays in scope with IsPending=true.
func TestPendingStructTypeParks() testing.TestResult {
	var src *[]const char = "type T struct { F Bag }"
	var p @parser.Parser = parser.New(toBytes(src), "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no user-visible errors for parked type")
	}
	if !c.IsDeclPending() {
		return fail("expected IsDeclPending to be true")
	}
	if !c.IsPendingDecl("T") {
		return fail("expected IsPendingDecl(T) to be true")
	}
	// T's placeholder is in scope; Underlying was cleared by
	// checkDeclTypeTentative so retry can re-resolve.
	var sym @Symbol = c.Scope.Lookup("T")
	if sym == nil { return fail("T's placeholder must be in scope") }
	if !sym.Type.IsPending {
		return fail("T's Type.IsPending must be set")
	}
	if sym.Type.Underlying != nil {
		return fail("T's Underlying should be cleared while parked")
	}
	return ""
}

// TestPendingStructTypeResolves verifies that the missing
// dependency arriving resolves T and clears IsPending.
func TestPendingStructTypeResolves() testing.TestResult {
	var c @Checker = NewChecker()

	var tSrc *[]const char = "type T struct { F Bag }"
	var pt @parser.Parser = parser.New(toBytes(tSrc), "<repl>")
	var td @ast.Decl = pt.ParseTopLevelDecl()
	c.CheckDeclInScope(td)
	if !c.IsPendingDecl("T") {
		return fail("setup: T should park initially")
	}

	var bSrc *[]const char = "type Bag struct { N int }"
	var pb @parser.Parser = parser.New(toBytes(bSrc), "<repl>")
	var bd @ast.Decl = pb.ParseTopLevelDecl()
	c.CheckDeclInScope(bd)

	var resolved @[]@ast.Decl = c.RetryPendingDecls()
	if len(resolved) != 1 {
		return fail("expected exactly one resolved decl")
	}
	if !charEq(resolved[0].Name, "T") {
		return fail("expected T in resolved")
	}
	if c.IsPendingDecl("T") {
		return fail("T should no longer be pending after retry")
	}
	var sym @Symbol = c.Scope.Lookup("T")
	if sym.Type.IsPending {
		return fail("T's Type.IsPending must be cleared after resolve")
	}
	if sym.Type.Underlying == nil {
		return fail("T's Underlying must be populated after resolve")
	}
	return ""
}

// TestPendingTypeUseSitePropagates verifies Stage 2 (c): a
// var decl whose typed-var TypeRef references a pending type
// captures the pending dependency and parks too.  Without
// the capturePendingIfSized check, the var would land with
// type=pending-placeholder and use sites would crash or get
// garbage layout.
func TestPendingTypeUseSitePropagates() testing.TestResult {
	var c @Checker = NewChecker()

	var tSrc *[]const char = "type T struct { F Bag }"
	var pt @parser.Parser = parser.New(toBytes(tSrc), "<repl>")
	var td @ast.Decl = pt.ParseTopLevelDecl()
	c.CheckDeclInScope(td)
	if !c.IsPendingDecl("T") {
		return fail("setup: T should park")
	}

	var vSrc *[]const char = "var x T"
	var pv @parser.Parser = parser.New(toBytes(vSrc), "<repl>")
	var vd @ast.Decl = pv.ParseTopLevelDecl()
	c.CheckDeclInScope(vd)
	if !c.IsPendingDecl("x") {
		return fail("expected x to park (T is pending)")
	}
	return ""
}

// TestPendingAliasResolves verifies the alias forward-ref
// case: `type R = SomeUndefined` parks rather than firing,
// resolves cleanly when SomeUndefined arrives.  Covered by
// the same DECL_TYPE tentative dispatch; the result symbol
// changes Kind from TYP_NAMED (placeholder) to TYP_ALIAS
// once collectTypeDecl's alias branch runs cleanly.
func TestPendingAliasResolves() testing.TestResult {
	var c @Checker = NewChecker()

	var rSrc *[]const char = "type R = Bag"
	var pr @parser.Parser = parser.New(toBytes(rSrc), "<repl>")
	var rd @ast.Decl = pr.ParseTopLevelDecl()
	c.CheckDeclInScope(rd)
	if !c.IsPendingDecl("R") {
		return fail("setup: alias R should park (Bag undefined)")
	}

	var bSrc *[]const char = "type Bag struct { N int }"
	var pb @parser.Parser = parser.New(toBytes(bSrc), "<repl>")
	var bd @ast.Decl = pb.ParseTopLevelDecl()
	c.CheckDeclInScope(bd)

	var resolved @[]@ast.Decl = c.RetryPendingDecls()
	if len(resolved) != 1 {
		return fail("expected R to resolve when Bag arrives")
	}
	if c.IsPendingDecl("R") {
		return fail("R should no longer be pending")
	}
	return ""
}

// TestPendingNamedNonStructResolves verifies the named-non-
// struct forward-ref case: `type Celsius UndefinedInt`.
func TestPendingNamedNonStructResolves() testing.TestResult {
	var c @Checker = NewChecker()

	var cSrc *[]const char = "type Celsius Heat"
	var pc @parser.Parser = parser.New(toBytes(cSrc), "<repl>")
	var cd @ast.Decl = pc.ParseTopLevelDecl()
	c.CheckDeclInScope(cd)
	if !c.IsPendingDecl("Celsius") {
		return fail("setup: named-non-struct should park (Heat undefined)")
	}

	var hSrc *[]const char = "type Heat int"
	var ph @parser.Parser = parser.New(toBytes(hSrc), "<repl>")
	var hd @ast.Decl = ph.ParseTopLevelDecl()
	c.CheckDeclInScope(hd)

	var resolved @[]@ast.Decl = c.RetryPendingDecls()
	if len(resolved) != 1 {
		return fail("expected Celsius to resolve")
	}
	return ""
}

// TestPendingTypeReferenceUseDoesNotPark verifies the per-
// caller sized-vs-reference distinction: `var p *T` (raw
// pointer to T) doesn't park even if T is pending, because
// the pointer wrapper is size-stable regardless of T's
// layout.  Same for `@T`, `[]T`, `@[]T`.
func TestPendingTypeReferenceUseDoesNotPark() testing.TestResult {
	var c @Checker = NewChecker()

	// Park T first.
	var tSrc *[]const char = "type T struct { F Bag }"
	var pt @parser.Parser = parser.New(toBytes(tSrc), "<repl>")
	var td @ast.Decl = pt.ParseTopLevelDecl()
	c.CheckDeclInScope(td)
	if !c.IsPendingDecl("T") {
		return fail("setup: T should park")
	}

	// `var p *T` — raw pointer, reference use, should NOT park.
	var pSrc *[]const char = "var p *T"
	var pp @parser.Parser = parser.New(toBytes(pSrc), "<repl>")
	var pd @ast.Decl = pp.ParseTopLevelDecl()
	c.CheckDeclInScope(pd)
	if c.IsPendingDecl("p") {
		return fail("var p *T should NOT park (reference use of pending T)")
	}
	return ""
}

// TestPendingTypeMutualRecursionViaPointersResolves verifies
// the canonical mutually-recursive struct pair where each
// references the other through a managed pointer: both decls
// initially park (A waits on B, B's check captures A's pending
// state via field), but the placeholder + IsPending model
// lets both resolve cleanly via the retry loop.
func TestPendingTypeMutualRecursionViaPointersResolves() testing.TestResult {
	var c @Checker = NewChecker()

	var aSrc *[]const char = "type A struct { Next @B }"
	var pa @parser.Parser = parser.New(toBytes(aSrc), "<repl>")
	var ad @ast.Decl = pa.ParseTopLevelDecl()
	c.CheckDeclInScope(ad)
	if !c.IsPendingDecl("A") {
		return fail("setup: A should park waiting on B")
	}

	var bSrc *[]const char = "type B struct { Next @A }"
	var pb @parser.Parser = parser.New(toBytes(bSrc), "<repl>")
	var bd @ast.Decl = pb.ParseTopLevelDecl()
	c.CheckDeclInScope(bd)

	// B's check resolves cleanly (A is in scope as placeholder,
	// @A is reference-use so doesn't propagate pending), so B
	// doesn't park.  Now retryPending should retry A — B is in
	// scope, @B is reference-use, so A resolves.
	var resolved @[]@ast.Decl = c.RetryPendingDecls()
	if len(resolved) != 1 {
		return fail("expected A to resolve after B arrives")
	}
	if !charEq(resolved[0].Name, "A") {
		return fail("expected A in resolved")
	}
	if c.IsPendingDecl("A") || c.IsPendingDecl("B") {
		return fail("neither A nor B should be pending after retry")
	}
	return ""
}

// TestPendingTypeFuncSigParksFunc verifies use-site
// propagation through func sig: `func f(x T)` where T is
// pending parks f waiting on T.  Wired via resolveFuncDeclType.
func TestPendingTypeFuncSigParksFunc() testing.TestResult {
	var c @Checker = NewChecker()

	var tSrc *[]const char = "type T struct { F Bag }"
	var pt @parser.Parser = parser.New(toBytes(tSrc), "<repl>")
	var td @ast.Decl = pt.ParseTopLevelDecl()
	c.CheckDeclInScope(td)
	if !c.IsPendingDecl("T") {
		return fail("setup: T should park")
	}

	var fSrc *[]const char = "func f(x T) int { return 0 }"
	var pf @parser.Parser = parser.New(toBytes(fSrc), "<repl>")
	var fd @ast.Decl = pf.ParseTopLevelDecl()
	c.CheckDeclInScope(fd)
	if !c.IsPendingDecl("f") {
		return fail("expected f to park (sig references pending T)")
	}
	return ""
}

// TestPendingConstGroupRespectsIotaOnRetry verifies that a
// group member parked at position N has its iota value
// restored to N when retry succeeds.  Without this, a retry'd
// const-with-iota would compute the wrong value.
func TestPendingConstGroupRespectsIotaOnRetry() testing.TestResult {
	var c @Checker = NewChecker()

	// B sits at position 1; its value references undefined M
	// plus iota.  When M resolves to 10, B should evaluate as
	// 10 + 1 = 11, not 10 + 0 (which it would be if retry
	// ran with c.Iota = 0).
	var src *[]const char =
		"const (\n  A int = iota\n  B int = M + iota\n)"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	c.CheckDeclInScope(d)
	if !c.IsPendingDecl("B") {
		return fail("setup: B should park")
	}
	// Find B's PendingDecl and check IotaIdx.
	var foundIotaIdx int = -1
	for i := 0; i < len(c.Pending); i++ {
		if charEq(c.Pending[i].Decl.Name, "B") {
			foundIotaIdx = c.Pending[i].IotaIdx
		}
	}
	if foundIotaIdx != 1 {
		return fail("expected B's IotaIdx to be 1")
	}

	// Resolve M.
	var mSrc *[]const char = "const M int = 10"
	var pm @parser.Parser = parser.New(toBytes(mSrc), "<repl>")
	var md @ast.Decl = pm.ParseTopLevelDecl()
	c.CheckDeclInScope(md)

	var resolved @[]@ast.Decl = c.RetryPendingDecls()
	if len(resolved) != 1 {
		return fail("expected B to resolve")
	}
	return ""
}

// TestPendingVarUseSiteError verifies that reading a still-
// pending var from non-tentative code surfaces "variable X is
// unresolved" rather than letting the parked symbol's stale
// type propagate without warning.
func TestPendingVarUseSiteError() testing.TestResult {
	var c @Checker = NewChecker()

	var vSrc *[]const char = "var x int = g() + 1"
	var pv @parser.Parser = parser.New(toBytes(vSrc), "<repl>")
	var vd @ast.Decl = pv.ParseTopLevelDecl()
	c.CheckDeclInScope(vd)
	if !c.IsPendingDecl("x") {
		return fail("setup: x should park")
	}

	var stmtSrc *[]const char = "println(x)"
	var pst @parser.Parser = parser.New(toBytes(stmtSrc), "<repl>")
	var ss @[]@ast.Stmt = pst.ParseStmtList()
	var beforeErrs int = len(c.CheckerErrors())
	c.CheckStmtListInScope(ss)
	if len(c.CheckerErrors()) <= beforeErrs {
		return fail("expected an error from reading pending x")
	}
	return ""
}
