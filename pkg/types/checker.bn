package "pkg/types"

import "pkg/ast"
import "pkg/buf"
import "pkg/slices"
import "pkg/token"

// ============================================================
// Checker
// ============================================================

// NewChecker creates a new type checker with predeclared types in scope.
func NewChecker() @Checker {
	var c @Checker = make(Checker)
	c.Iota = -1
	c.Scope = universeScope()
	c.ExprTypes = make_slice(@Type, 256)
	// Reserve index 0 as "unresolved" (Expr.ResolvedTypeID zero-inits to 0).
	c.NumExprTypes = 1
	return c
}

// CheckerErrors returns the list of type errors accumulated during checking.
func (c @Checker) CheckerErrors() @[]CheckError {
	return c.Errors
}

// ExprType returns the resolved type for an expression by its ResolvedTypeID (nil if unresolved).
func (c @Checker) ExprType(id int) @Type {
	if id <= 0 || id >= c.NumExprTypes {
		return nil
	}
	return c.ExprTypes[id]
}

// registerExprType stores a type in the registry and returns its ID.
func registerExprType(c @Checker, t @Type) int {
	var id int = c.NumExprTypes
	if id >= len(c.ExprTypes) {
		var newCap int = len(c.ExprTypes) * 2
		var newArr @[]@Type = make_slice(@Type, newCap)
		for i := 0; i < id; i++ {
			newArr[i] = c.ExprTypes[i]
		}
		c.ExprTypes = newArr
	}
	c.ExprTypes[id] = t
	c.NumExprTypes = id + 1
	return id
}


// ============================================================
// Universe Scope
// ============================================================

// universeScope creates the top-level scope containing all predeclared
// types, constants, and builtins.
func universeScope() @Scope {
	ensureInit()
	var s @Scope = NewScope(nil)

	defineType(s, "bool", TypBool())
	defineType(s, "char", TypChar())
	defineType(s, "int", TypInt())
	defineType(s, "int8", TypInt8())
	defineType(s, "int16", TypInt16())
	defineType(s, "int32", TypInt32())
	defineType(s, "int64", TypInt64())
	defineType(s, "uint", TypUint())
	defineType(s, "uint8", TypUint8())
	defineType(s, "uint16", TypUint16())
	defineType(s, "uint32", TypUint32())
	defineType(s, "uint64", TypUint64())
	defineType(s, "float32", TypFloat32())
	defineType(s, "float64", TypFloat64())
	defineType(s, "byte", TypByte())

	// `any` is the implicit universal interface (per
	// plan-interface-syntax-revision.md § 6).  Empty method set,
	// so every type satisfies it; usable spellings are `*any` and
	// `@any`.  Bare `any` as a type expression is rejected by
	// resolveTypeExpr, except in the generic-constraint position
	// where `any` means "no constraint" (see
	// resolveTypeParamConstraint's name-based fast path).
	var emptyPkg @[]char
	var anyName @[]char = "any"
	var anyIface @Type = MakeInterfaceType(emptyPkg, anyName)
	defineInterface(s, anyName, anyIface)

	defineConst(s, "true", TypUntypedBool())
	defineConst(s, "false", TypUntypedBool())
	defineConst(s, "nil", TypNil())

	// Builtin functions — variadic, checked specially
	var emptyParams @[]@Param
	var emptyResults @[]@Type
	var variadicType @Type = MakeFuncType(emptyParams, emptyResults)
	defineFunc(s, "print", variadicType)
	defineFunc(s, "println", variadicType)
	defineFunc(s, "panic", variadicType)

	return s
}

// defineType adds a type symbol to the scope.
func defineType(s @Scope, name @[]char, t @Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_TYPE
	s.Define(sym)
}

// defineConst adds a constant symbol to the scope.
func defineConst(s @Scope, name @[]char, t @Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_CONST
	s.Define(sym)
}

// defineFunc adds a function symbol to the scope.
func defineFunc(s @Scope, name @[]char, t @Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_FUNC
	s.Define(sym)
}

// defineVar adds a variable symbol to the scope.
func defineVar(s @Scope, name @[]char, t @Type) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Type = t
	sym.Kind = SYM_VAR
	s.Define(sym)
}

// definePkg adds a package symbol to the scope, mapping the local name to its import path.
func definePkg(s @Scope, name @[]char, path @[]char) {
	var sym @Symbol = make(Symbol)
	sym.Name = name
	sym.Kind = SYM_PKG
	sym.PkgPath = path
	s.Define(sym)
}

// ============================================================
// Package Management
// ============================================================

// lookupPackage returns the scope for a registered package, or nil if not found.
func lookupPackage(c @Checker, path *[]const char) @Scope {
	for i := 0; i < len(c.Packages); i++ {
		if charEq(c.Packages[i].Path, path) {
			return c.Packages[i].Scope
		}
	}
	return nil
}

// registerPackage associates a package path with its scope, updating if already registered.
func registerPackage(c @Checker, path @[]char, scope @Scope) {
	// Check if already registered
	for i := 0; i < len(c.Packages); i++ {
		if charEq(c.Packages[i].Path, path) {
			c.Packages[i].Scope = scope
			return
		}
	}
	var entry @PkgEntry = make(PkgEntry)
	entry.Path = path
	entry.Scope = scope
	c.Packages = slices.Append[@PkgEntry](c.Packages, entry)
}

// LoadPackageInterface registers a package scope from a parsed .bni file.
func (c @Checker) LoadPackageInterface(path @[]char, bni @ast.File) {
	if lookupPackage(c, path) != nil {
		return
	}
	var prevPkg @[]char = WithPkgShort(lastPathSegment(path))
	var scope @Scope = buildScopeFromFile(c, bni)
	RestorePkgShort(prevPkg)
	registerPackage(c, path, scope)
}

// CheckPackage type-checks a package's implementation files.
func (c @Checker) CheckPackage(path @[]char, merged @ast.File) {
	var savedScope @Scope = c.Scope
	var savedFuncRet @[]@Type = c.FuncRet
	var savedPackageScope @Scope = c.PackageScope
	var prevChecker @Checker = WithChecker(c)
	var prevPkg @[]char = WithPkgShort(lastPathSegment(path))
	var savedAllowUniverseRecv bool = c.AllowUniverseRecv
	c.AllowUniverseRecv = isCarveOutPackage(path)

	pushScope(c)
	c.PackageScope = c.Scope

	// Import .bni declarations into implementation scope
	var bniScope @Scope = lookupPackage(c, path)
	if bniScope != nil {
		for i := 0; i < len(bniScope.Syms); i++ {
			var sym @Symbol = make(Symbol)
			sym.Name = bniScope.Syms[i].Name
			sym.Type = bniScope.Syms[i].Type
			sym.Kind = bniScope.Syms[i].Kind
			sym.PkgPath = bniScope.Syms[i].PkgPath
			c.Scope.Define(sym)
		}
	}

	// Register imports
	registerImports(c, merged)

	// Pass 1: collect declarations
	collectDecls(c, merged.Decls)

	// Pass 1.5: validate impl satisfaction (every impl's receiver
	// covers each named interface's method set with sig-compatible
	// methods and reachable receiver kinds — Slice 2.2 of plan-
	// interface-syntax-revision.md).
	checkAllImplsSatisfaction(c)

	// Pass 2: check bodies
	checkDecls(c, merged.Decls)

	// If no .bni, register implementation scope
	if lookupPackage(c, path) == nil {
		registerPackage(c, path, c.Scope)
	}

	c.Scope = savedScope
	c.FuncRet = savedFuncRet
	c.PackageScope = savedPackageScope
	c.AllowUniverseRecv = savedAllowUniverseRecv
	RestorePkgShort(prevPkg)
	RestoreChecker(prevChecker)
}

// Check type-checks a source file (single-file mode).
func (c @Checker) Check(file @ast.File) {
	var savedPackageScope @Scope = c.PackageScope
	var prevChecker @Checker = WithChecker(c)
	var prevPkg @[]char = WithPkgShort(file.PkgName)
	var savedAllowUniverseRecv bool = c.AllowUniverseRecv
	c.AllowUniverseRecv = isCarveOutPackage(file.PkgName)
	pushScope(c)
	c.PackageScope = c.Scope
	registerImports(c, file)
	collectDecls(c, file.Decls)
	checkAllImplsSatisfaction(c)
	checkDecls(c, file.Decls)
	popScope(c)
	c.PackageScope = savedPackageScope
	c.AllowUniverseRecv = savedAllowUniverseRecv
	RestorePkgShort(prevPkg)
	RestoreChecker(prevChecker)
}

// isCarveOutPackage reports whether `name` (the package path
// from `package "..."` or the path argument to CheckPackage)
// is the stdlib carve-out package — the one place methods can
// be declared on universe primitives (`int`, `bool`, etc.).
// `name` may come from file.PkgName (raw, includes the
// surrounding quotes from the source) or from a CheckPackage
// path argument (already-stripped); strip defensively.
// See plan-primitives-impl-interfaces.md.
func isCarveOutPackage(name *[]const char) bool {
	if len(name) == 0 { return false }
	var stripped @[]char = stripQuotes(buf.CopyStr(name))
	return charEq(stripped, "pkg/builtins/lang")
}

// CheckMainPersistent type-checks a main source file like Check but
// leaves the file's scope (imports + decls) installed on c.Scope
// when it returns.  REPL entry point: the loaded file's symbols
// must remain visible to prompt entries for the duration of the
// session, so the scope is intentionally not popped.
func (c @Checker) CheckMainPersistent(file @ast.File) {
	WithChecker(c)
	pushScope(c)
	c.PackageScope = c.Scope
	registerImports(c, file)
	collectDecls(c, file.Decls)
	checkAllImplsSatisfaction(c)
	checkDecls(c, file.Decls)
	// Intentionally do NOT popScope — the REPL session keeps using
	// this scope for subsequent CheckExprInScope / CheckStmtListInScope
	// calls. c.PackageScope is intentionally retained to match —
	// function literals at the prompt skip into this same scope.
}

// CheckDeclInScope type-checks a single top-level declaration
// against the checker's current scope (c.Scope) — registers the
// decl's symbol(s) in c.Scope persistently and checks any
// associated body / initializer.  REPL entry point for Tier 2:
// the declared name remains visible to subsequent prompt
// entries.  Errors are appended to c.Errors.
//
// Sets c.AllowRedef while running the inner passes so a
// previously-defined symbol can be redefined (compatible-sig
// replace or incompatible-sig shadow) without firing the
// .bni-vs-.bn signature mismatch check, whose error wording
// ("X: .bni declares N") would be misleading at the prompt.
// The flag is restored on exit so non-REPL callers (if any)
// keep the strict behavior.
//
// Mechanically: wraps `d` in a one-element slice and runs the
// existing collectDecls + checkDecls passes.  collectDecls adds
// the symbol to c.Scope (no push/pop); checkDecls inspects the
// body in a temporary inner scope.
//
// Tier 3 forward refs: the body / initializer check (the
// `checkDecls` half) runs with TentativeMode set for DECL_FUNC,
// DECL_VAR, DECL_CONST, and the members of a DECL_GROUP.  Any
// "undefined: <name>" errors are captured into
// c.TentativeMissing instead of surfacing.  If TentativeMissing
// is non-empty after the body check AND no other errors fired,
// the decl is parked on c.Pending for later retry.
//
// For DECL_VAR / DECL_CONST the "body" is the initializer
// expression; otherwise the flow is identical to DECL_FUNC.
// Untyped vars / consts whose initializer parks won't have
// their symbol entered in scope until the initializer resolves
// (no type to define them with); subsequent use-site refs
// surface as "undefined: X" rather than "variable X is
// unresolved".  Acceptable first-cut limitation — users
// usually spell the type explicitly for forward-ref initializer
// patterns anyway.
//
// DECL_GROUP is handled per-member (Stage 1 (c) of plan-repl-
// tier3-pending-types.md): each const inside the group runs
// its own tentative check, parks individually if its value
// references undefined names, or lands cleanly otherwise.
// Groups are syntactic sugar with no semantic effect.  iota
// is tracked positionally — a parked member records its
// position via parkPendingDeclMember so retry restores the
// right iota value.
//
// Other decl kinds (DECL_TYPE, DECL_INTERFACE, DECL_IMPL) keep
// strict checking — pending types are out of scope for this
// stage; see plan-repl-tier3-pending-types.md Stage 2.
//
// Param/result types (the sig) are checked in collectDecls,
// which always runs in non-tentative mode — sig types must
// resolve at decl time, otherwise the func can't enter scope
// with a usable type.  Same for typed vars / consts: the
// TypeRef resolves strictly in collectDecls; only the
// initializer is tentative.
func (c @Checker) CheckDeclInScope(d @ast.Decl) {
	var prevAllowRedef bool = c.AllowRedef
	c.AllowRedef = true
	var emptyMissing @[]@[]char
	c.TentativeMissing = emptyMissing
	var emptyTentErrs @[]CheckError
	c.TentativeErrors = emptyTentErrs
	// Snapshot Pending so IsDeclPending() and the driver can
	// see which decls parked during THIS call (vs. accumulated
	// from earlier prompt entries).
	c.PendingMark = len(c.Pending)
	var single @[]@ast.Decl = make_slice(@ast.Decl, 1)
	single[0] = d
	// DECL_TYPE: type resolution happens in pass 1 (collectTypeDecl)
	// — pass 2 / checkDecls is a no-op for types.  Stage 2 of plan-
	// repl-tier3-pending-types.md routes the resolution through
	// TentativeMode so a struct / alias / named-non-struct whose
	// referenced types aren't yet bound parks instead of firing
	// "undefined: X".  preRegisterTypeNames runs first to install
	// the placeholder symbol; checkDeclTypeTentative then fills it
	// (or parks).
	if d.Kind == ast.DECL_TYPE {
		preRegisterTypeNames(c, single)
		checkDeclTypeTentative(c, d)
		c.AllowRedef = prevAllowRedef
		return
	}
	// Pass 1: signature / non-body checks.  Always strict; sig
	// types missing → real error.
	collectDecls(c, single)
	// Pass 2: body / initializer checks.
	if d.Kind == ast.DECL_GROUP {
		checkGroupDeclTentative(c, d)
	} else if isParkableKind(d.Kind) {
		c.TentativeMode = true
		// DECL_FUNC sig audit: pending types in the receiver /
		// params / results park f, so calling f isn't allowed
		// until the sig fully resolves.  Pass 2 (checkFuncDecl)
		// only inspects the body, so without this captureFunc-
		// SigPendingDeps call a func whose sig references a
		// pending type wouldn't park.  Per Stage 2 (d) of plan-
		// repl-tier3-pending-types.md.
		if d.Kind == ast.DECL_FUNC {
			captureFuncSigPendingDeps(c, d)
		}
		checkDecls(c, single)
		c.TentativeMode = false
		if len(c.TentativeMissing) > 0 {
			// Park: the missing names are why; the captured
			// cascading errors are noise.  Discard them.
			parkPendingDecl(c, d, c.TentativeMissing)
		} else {
			// No missing names — any captured errors are real
			// (a type mismatch unrelated to forward refs).
			// Migrate them so the user sees them.
			migrateTentativeErrors(c)
		}
	} else {
		checkDecls(c, single)
	}
	c.AllowRedef = prevAllowRedef
}

// CheckExprInScope type-checks a single expression against the
// checker's current scope (c.Scope).  REPL entry point for
// immediate-mode bare expressions.  A child scope is pushed so any
// transient bindings do not leak to the enclosing scope.  Returns the
// resolved type of the expression; errors are appended to c.Errors.
func (c @Checker) CheckExprInScope(e @ast.Expr) @Type {
	pushScope(c)
	var t @Type = checkExpr(c, e)
	popScope(c)
	return t
}

// CheckStmtListInScope type-checks a list of statements against the
// checker's current scope (c.Scope).  REPL entry point for
// immediate-mode bare statement lists.  A child scope is pushed so
// any local declarations introduced by the statements do not leak to
// the enclosing scope.  Errors are appended to c.Errors.
func (c @Checker) CheckStmtListInScope(ss @[]@ast.Stmt) {
	pushScope(c)
	for i := 0; i < len(ss); i++ {
		checkStmt(c, ss[i])
	}
	popScope(c)
}


// RegisterReplImport defines a package symbol in the REPL
// session scope after a mid-session `import` prompt entry.
// The package's scope must already be registered (via
// LoadPackageInterface / CheckPackage from the loader-side
// import path).  Errors if the package isn't registered.
// Per Tier 5 of plan-repl.md.
//
// `alias` is the user-typed alias (empty for the default — the
// last segment of `path`); the caller is responsible for
// computing the empty-alias default via the parser-side
// `ImportSpec.Alias` and `lastPathSegment(path)` together.
func (c @Checker) RegisterReplImport(alias @[]char,
		path @[]char) bool {
	if lookupPackage(c, path) == nil { return false }
	definePkg(c.Scope, alias, path)
	return true
}

// registerImports processes a file's import declarations, defining
// package symbols in the current scope.
func registerImports(c @Checker, file @ast.File) {
	for i := 0; i < len(file.Imports); i++ {
		var imp @ast.ImportSpec = file.Imports[i]
		var path @[]char = stripQuotes(imp.Path)
		var name @[]char = imp.Alias
		if len(name) == 0 {
			name = lastPathSegment(path)
		}
		if lookupPackage(c, path) == nil {
			addCheckError(c, imp.Pos, "unknown package")
			continue
		}
		definePkg(c.Scope, name, path)
	}
}

// ============================================================
// Scope Helpers
// ============================================================

// pushScope enters a new nested scope.
func pushScope(c @Checker) {
	c.Scope = NewScope(c.Scope)
}

// popScope exits the current scope, returning to its parent.
func popScope(c @Checker) {
	c.Scope = c.Scope.Parent
}
