package "pkg/types"

import "pkg/ast"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/parser"


func TestNewChecker() testing.TestResult {
	var c @Checker = NewChecker()
	if c == nil { return fail("NewChecker returned nil") }
	if c.Scope == nil { return fail("expected universe scope") }
	return ""
}

func TestCheckerErrorsEmpty() testing.TestResult {
	var c @Checker = NewChecker()
	var errs @[]CheckError = c.CheckerErrors()
	if len(errs) != 0 { return fail("new checker should have no errors") }
	return ""
}

func TestUniverseScope() testing.TestResult {
	var s @Scope = universeScope()
	if s == nil { return fail("universe scope is nil") }
	// Should contain built-in types: int, bool, char, etc.
	var intSym @Symbol = s.Lookup("int")
	if intSym == nil { return fail("int not in universe scope") }
	var boolSym @Symbol = s.Lookup("bool")
	if boolSym == nil { return fail("bool not in universe scope") }
	return ""
}

func TestDefineAndLookup() testing.TestResult {
	var s @Scope = NewScope(nil)
	defineVar(s, buf.CopyStr("x"), TypInt())
	var sym @Symbol = s.Lookup("x")
	if sym == nil { return fail("x not found after define") }
	if sym.Type == nil { return fail("x type is nil") }
	if sym.Type.Kind != TYP_INT { return fail("x should be int") }
	return ""
}

func TestScopeNesting() testing.TestResult {
	var outer @Scope = NewScope(nil)
	defineVar(outer, buf.CopyStr("a"), TypInt())
	var inner @Scope = NewScope(outer)
	defineVar(inner, buf.CopyStr("b"), TypBool())
	// Inner should see both a and b
	if inner.Lookup("a") == nil { return fail("a not visible in inner") }
	if inner.Lookup("b") == nil { return fail("b not visible in inner") }
	// Outer should only see a
	if outer.Lookup("a") == nil { return fail("a not in outer") }
	if outer.Lookup("b") != nil { return fail("b should not be in outer") }
	return ""
}

// ============================================================
// REPL entry-point tests
// ============================================================

// replParseExpr is a small helper to parse a single expression from
// a string, used by the REPL entry-point tests below.
func replParseExpr(src *[]const char) @ast.Expr {
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	return p.ParseExpr()
}

// replParseStmtList parses a stmt list from a string.
func replParseStmtList(src *[]const char) @[]@ast.Stmt {
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	return p.ParseStmtList()
}

// TestCheckExprInScopeBasic checks a simple binary expression and
// verifies the inferred type is int.
func TestCheckExprInScopeBasic() testing.TestResult {
	var e @ast.Expr = replParseExpr("1 + 2")
	var c @Checker = NewChecker()
	var t @Type = c.CheckExprInScope(e)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no errors for 1+2")
	}
	if t == nil { return fail("expected non-nil type") }
	// Untyped int literal expressions resolve to int (TYP_INT or
	// TYP_UNTYPED_INT depending on context); accept either.
	if t.Kind != TYP_INT && t.Kind != TYP_UNTYPED_INT {
		return fail("expected int-like type")
	}
	return ""
}

// TestCheckExprInScopeUndefined verifies an undefined identifier
// surfaces as an error rather than crashing.
func TestCheckExprInScopeUndefined() testing.TestResult {
	var e @ast.Expr = replParseExpr("undefined_name")
	var c @Checker = NewChecker()
	c.CheckExprInScope(e)
	if len(c.CheckerErrors()) == 0 {
		return fail("expected an error for undefined name")
	}
	return ""
}

// TestCheckStmtListInScopeBasic checks a small statement list with a
// var decl and a follow-up assignment.
func TestCheckStmtListInScopeBasic() testing.TestResult {
	var ss @[]@ast.Stmt = replParseStmtList("var x int = 5; x = x + 1")
	var c @Checker = NewChecker()
	c.CheckStmtListInScope(ss)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no errors")
	}
	return ""
}

// TestCheckStmtListInScopeNoLeak verifies that local var decls in the
// stmt list do not leak into c.Scope after the call returns.
func TestCheckStmtListInScopeNoLeak() testing.TestResult {
	var ss @[]@ast.Stmt = replParseStmtList("var temp int = 5")
	var c @Checker = NewChecker()
	c.CheckStmtListInScope(ss)
	// After the call, `temp` must not be visible in c.Scope.
	if c.Scope.Lookup("temp") != nil {
		return fail("local var leaked into outer scope")
	}
	return ""
}

// TestCheckDeclInScope verifies that a single func decl typed at
// the prompt registers in c.Scope persistently and that the body
// is checked.
func TestCheckDeclInScope() testing.TestResult {
	var src *[]const char = "func double(x int) int { return x * 2 }"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no errors on `func double(x int) int`")
	}
	if c.Scope.Lookup("double") == nil {
		return fail("double not visible in c.Scope after CheckDeclInScope")
	}
	return ""
}

// TestCheckDeclInScopeBadBody verifies that a func decl whose body
// has a type error surfaces an error (and doesn't silently accept).
func TestCheckDeclInScopeBadBody() testing.TestResult {
	var src *[]const char = "func bad() int { return \"not an int\" }"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) == 0 {
		return fail("expected an error for body-type mismatch")
	}
	return ""
}

// TestCheckDeclInScopeConst verifies that a single typed const
// decl typed at the prompt registers a Const symbol in c.Scope.
func TestCheckDeclInScopeConst() testing.TestResult {
	var src *[]const char = "const K int = 42"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no errors on `const K int = 42`")
	}
	if c.Scope.Lookup("K") == nil {
		return fail("K not visible in c.Scope after CheckDeclInScope")
	}
	return ""
}

// TestCheckDeclInScopeConstGroup verifies that a grouped const
// block (single-line form) registers each member persistently.
func TestCheckDeclInScopeConstGroup() testing.TestResult {
	var src *[]const char = "const ( A = 10; B = 20 )"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no errors on grouped const")
	}
	if c.Scope.Lookup("A") == nil { return fail("A not in scope") }
	if c.Scope.Lookup("B") == nil { return fail("B not in scope") }
	return ""
}

// TestCheckDeclInScopeVar verifies that a single typed var decl
// typed at the prompt registers a Var symbol in c.Scope.
func TestCheckDeclInScopeVar() testing.TestResult {
	var src *[]const char = "var counter int"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "<repl>")
	var d @ast.Decl = p.ParseTopLevelDecl()
	if d == nil { return fail("ParseTopLevelDecl returned nil") }

	var c @Checker = NewChecker()
	c.CheckDeclInScope(d)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no errors on `var counter int`")
	}
	if c.Scope.Lookup("counter") == nil {
		return fail("counter not visible in c.Scope after CheckDeclInScope")
	}
	return ""
}

// TestCheckMainPersistentLeavesScope verifies that decls from a
// main file are visible in c.Scope after CheckMainPersistent
// returns — the property the REPL relies on.
//
// Tier 3 pending-decl tests live in check_pending_test.bn.


func TestCheckMainPersistentLeavesScope() testing.TestResult {
	var src *[]const char =
		"package \"test\"\nfunc helper() int { return 7 }\n"
	var b @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(b, "test.bn")
	var f @ast.File = p.ParseFile()
	var c @Checker = NewChecker()
	c.CheckMainPersistent(f)
	if len(c.CheckerErrors()) != 0 {
		return fail("expected no checker errors")
	}
	if c.Scope.Lookup("helper") == nil {
		return fail("helper not visible in c.Scope after CheckMainPersistent")
	}
	return ""
}
