package "pkg/types"

import "pkg/ast"
import "pkg/buf"

// ============================================================
// Type Resolution
// ============================================================
//
// Converts AST type expressions (`ast.TypeExpr`) into resolved
// `Type` values. Used by the checker (decl/expr/stmt) to bind
// source-level type syntax to the package's symbol scope.

// resolveTypeExpr resolves an AST type expression into a Type.
func resolveTypeExpr(c @Checker, te @ast.TypeExpr) @Type {
	if te == nil {
		return TypVoid()
	}

	if te.Kind == ast.TEXPR_NAMED {
		return resolveNamedTypeExpr(c, te)
	}
	if te.Kind == ast.TEXPR_POINTER {
		return MakePointerType(resolveTypeExpr(c, te.Base))
	}
	if te.Kind == ast.TEXPR_MANAGED {
		return MakeManagedPtrType(resolveTypeExpr(c, te.Base))
	}
	if te.Kind == ast.TEXPR_MANAGED_SLICE {
		return MakeManagedSliceType(resolveTypeExpr(c, te.Base))
	}
	if te.Kind == ast.TEXPR_SLICE {
		return MakeSliceType(resolveTypeExpr(c, te.Base))
	}
	if te.Kind == ast.TEXPR_ARRAY {
		var length int = evalConstInt(c, te.Len)
		return MakeArrayType(resolveTypeExpr(c, te.Base), length)
	}
	if te.Kind == ast.TEXPR_STRUCT {
		return resolveStructType(c, te)
	}
	if te.Kind == ast.TEXPR_PAREN {
		return resolveTypeExpr(c, te.Base)
	}
	if te.Kind == ast.TEXPR_CONST {
		return MakeConstType(resolveTypeExpr(c, te.Base))
	}
	if te.Kind == ast.TEXPR_FUNC_VALUE {
		return resolveFuncValueType(c, te, false)
	}
	if te.Kind == ast.TEXPR_MANAGED_FUNC_VALUE {
		return resolveFuncValueType(c, te, true)
	}
	addCheckError(c, te.Pos, "invalid type expression")
	return TypVoid()
}

// resolveFuncValueType converts a TEXPR_FUNC_VALUE / TEXPR_MANAGED_FUNC_VALUE
// AST node into the corresponding TYP_FUNC_VALUE / TYP_MANAGED_FUNC_VALUE
// Type. Parameters in the source are anonymous (types only); we still
// build Param structs for them with empty names so downstream code
// (signature comparison, vtable type generation) can treat them
// uniformly with named parameters from regular function declarations.
func resolveFuncValueType(c @Checker, te @ast.TypeExpr,
		managed bool) @Type {
	var params @[]@Param
	for i := 0; i < len(te.ParamTypes); i++ {
		var typ @Type = resolveTypeExpr(c, te.ParamTypes[i])
		var p @Param = make(Param)
		p.Type = typ
		params = appendParamPtr(params, p)
	}
	var results @[]@Type
	for i := 0; i < len(te.ResultTypes); i++ {
		var typ @Type = resolveTypeExpr(c, te.ResultTypes[i])
		results = appendTypePtr(results, typ)
	}
	if managed {
		return MakeManagedFuncValueType(params, results)
	}
	return MakeFuncValueType(params, results)
}

// resolveNamedTypeExpr resolves a named type reference, including qualified (pkg.Type) names.
func resolveNamedTypeExpr(c @Checker, te @ast.TypeExpr) @Type {
	if len(te.Pkg) > 0 {
		// Qualified type: pkg.Type
		var sym @Symbol = Lookup(c.Scope, te.Pkg)
		if sym == nil || sym.Kind != SYM_PKG {
			errUndefined(c, te.Pos, te.Pkg)
			return TypVoid()
		}
		var pkgScope @Scope = lookupPackage(c, sym.PkgPath)
		if pkgScope == nil {
			errUndefined(c, te.Pos, te.Pkg)
			return TypVoid()
		}
		var member @Symbol = Lookup(pkgScope, te.Name)
		if member == nil {
			errUndefined(c, te.Pos, te.Name)
			return TypVoid()
		}
		return member.Type
	}
	var sym @Symbol = Lookup(c.Scope, te.Name)
	if sym == nil {
		errUndefined(c, te.Pos, te.Name)
		return TypVoid()
	}
	if sym.Kind != SYM_TYPE {
		errNotAType(c, te.Pos, te.Name)
		return TypVoid()
	}
	return sym.Type
}

// resolveStructType resolves a struct type expression, building the field list.
func resolveStructType(c @Checker, te @ast.TypeExpr) @Type {
	var fields @[]@Field
	for i := 0; i < len(te.Fields); i++ {
		var fd @ast.FieldDecl = te.Fields[i]
		var typ @Type = resolveTypeExpr(c, fd.Type)
		var f @Field = make(Field)
		f.Name = fd.Name
		f.Type = typ
		fields = appendFieldPtr(fields, f)
	}
	return MakeStructType("", fields)
}

// resolveFuncDeclType resolves a function declaration's parameter and
// return types into a func type.
func resolveFuncDeclType(c @Checker, d @ast.Decl) @Type {
	// Check for duplicate parameter names
	for i := 0; i < len(d.Params); i++ {
		for j := 0; j < i; j++ {
			if charEq(d.Params[i].Name, d.Params[j].Name) {
				var cb buf.CharBuf = buf.New()
				cb = cb.WriteStr("duplicate parameter name: ")
				cb = cb.WriteStr(d.Params[i].Name)
				addCheckError(c, d.Pos, cb.Bytes())
			}
		}
	}
	var params @[]@Param
	for i := 0; i < len(d.Params); i++ {
		var pd @ast.ParamDecl = d.Params[i]
		var typ @Type = resolveTypeExpr(c, pd.Type)
		var p @Param = make(Param)
		p.Name = pd.Name
		p.Type = typ
		params = appendParamPtr(params, p)
	}
	var results @[]@Type
	for i := 0; i < len(d.Results); i++ {
		results = appendTypePtr(results, resolveTypeExpr(c, d.Results[i]))
	}
	return MakeFuncType(params, results)
}
