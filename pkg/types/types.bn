package "pkg/types"

import "pkg/buf"

// ============================================================
// Predeclared Type Singletons
// ============================================================

var predeclaredInt @Type
var predeclaredInt8 @Type
var predeclaredInt16 @Type
var predeclaredInt32 @Type
var predeclaredInt64 @Type
var predeclaredUint @Type
var predeclaredUint8 @Type
var predeclaredUint16 @Type
var predeclaredUint32 @Type
var predeclaredUint64 @Type
var predeclaredFloat32 @Type
var predeclaredFloat64 @Type
var predeclaredBool @Type
var predeclaredString @Type
var predeclaredVoid @Type
var predeclaredNil @Type
var predeclaredUntypedInt @Type
var predeclaredUntypedFloat @Type
var predeclaredUntypedBool @Type

var typesInitialized bool

// ensureInit lazily initializes all predeclared type singletons on first use.
func ensureInit() {
	if typesInitialized {
		return
	}
	typesInitialized = true

	predeclaredInt = makeIntType("int", 64, true)
	predeclaredInt8 = makeIntType("int8", 8, true)
	predeclaredInt16 = makeIntType("int16", 16, true)
	predeclaredInt32 = makeIntType("int32", 32, true)
	predeclaredInt64 = makeIntType("int64", 64, true)
	predeclaredUint = makeIntType("uint", 64, false)
	predeclaredUint8 = makeIntType("uint8", 8, false)
	predeclaredUint16 = makeIntType("uint16", 16, false)
	predeclaredUint32 = makeIntType("uint32", 32, false)
	predeclaredUint64 = makeIntType("uint64", 64, false)
	predeclaredFloat32 = makeFloatType("float32", 32)
	predeclaredFloat64 = makeFloatType("float64", 64)

	predeclaredBool = make(Type)
	predeclaredBool.Kind = TYP_BOOL
	predeclaredBool.Name = "bool"

	predeclaredString = make(Type)
	predeclaredString.Kind = TYP_STRING
	predeclaredString.Name = "string"

	predeclaredVoid = make(Type)
	predeclaredVoid.Kind = TYP_VOID
	predeclaredVoid.Name = "void"

	predeclaredNil = make(Type)
	predeclaredNil.Kind = TYP_NIL
	predeclaredNil.Name = "nil"

	predeclaredUntypedInt = make(Type)
	predeclaredUntypedInt.Kind = TYP_UNTYPED_INT
	predeclaredUntypedInt.Name = "untyped int"

	predeclaredUntypedFloat = make(Type)
	predeclaredUntypedFloat.Kind = TYP_UNTYPED_FLOAT
	predeclaredUntypedFloat.Name = "untyped float"

	predeclaredUntypedBool = make(Type)
	predeclaredUntypedBool.Kind = TYP_UNTYPED_BOOL
	predeclaredUntypedBool.Name = "untyped bool"
}

// makeIntType creates a predeclared integer type with the given name, bit width, and signedness.
func makeIntType(name @[]char, width int, signed bool) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_INT
	t.Name = name
	t.Width = width
	t.Signed = signed
	return t
}

// makeFloatType creates a predeclared floating-point type with the given name and bit width.
func makeFloatType(name @[]char, width int) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_FLOAT
	t.Name = name
	t.Width = width
	return t
}

func TypInt() @Type      { ensureInit(); return predeclaredInt }
func TypInt8() @Type     { ensureInit(); return predeclaredInt8 }
func TypInt16() @Type    { ensureInit(); return predeclaredInt16 }
func TypInt32() @Type    { ensureInit(); return predeclaredInt32 }
func TypInt64() @Type    { ensureInit(); return predeclaredInt64 }
func TypUint() @Type     { ensureInit(); return predeclaredUint }
func TypUint8() @Type    { ensureInit(); return predeclaredUint8 }
func TypUint16() @Type   { ensureInit(); return predeclaredUint16 }
func TypUint32() @Type   { ensureInit(); return predeclaredUint32 }
func TypUint64() @Type   { ensureInit(); return predeclaredUint64 }
func TypFloat32() @Type  { ensureInit(); return predeclaredFloat32 }
func TypFloat64() @Type  { ensureInit(); return predeclaredFloat64 }
func TypBool() @Type     { ensureInit(); return predeclaredBool }
func TypChar() @Type     { ensureInit(); return predeclaredUint8 }
func TypByte() @Type     { ensureInit(); return predeclaredUint8 }
func TypString() @Type   { ensureInit(); return predeclaredString }
func TypVoid() @Type     { ensureInit(); return predeclaredVoid }
func TypNil() @Type      { ensureInit(); return predeclaredNil }
func TypUntypedInt() @Type   { ensureInit(); return predeclaredUntypedInt }
func TypUntypedFloat() @Type { ensureInit(); return predeclaredUntypedFloat }
func TypUntypedBool() @Type  { ensureInit(); return predeclaredUntypedBool }

// ============================================================
// Type Construction
// ============================================================

// MakePointerType creates a raw pointer type (*elem).
func MakePointerType(elem @Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_POINTER
	t.Elem = elem
	return t
}

// MakeManagedPtrType creates a managed pointer type (@elem).
func MakeManagedPtrType(elem @Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_MANAGED_PTR
	t.Elem = elem
	return t
}

// MakeSliceType creates a raw slice type (*[]elem).
func MakeSliceType(elem @Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_SLICE
	t.Elem = elem
	return t
}

// MakeManagedSliceType creates a managed-slice type (@[]elem).
func MakeManagedSliceType(elem @Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_MANAGED_SLICE
	t.Elem = elem
	return t
}

// MakeArrayType creates an array type ([length]elem).
func MakeArrayType(elem @Type, length int) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_ARRAY
	t.Elem = elem
	t.ArrayLen = length
	return t
}

// MakeStructType creates a struct type with the given name and fields.
func MakeStructType(name @[]char, fields @[]@Field) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_STRUCT
	t.Name = name
	t.Fields = fields
	return t
}

// MakeFuncType creates a function type with the given parameters and return types.
func MakeFuncType(params @[]@Param, results @[]@Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_FUNC
	t.Params = params
	t.Results = results
	return t
}

// MakeNamedType creates a named (distinct) type with no underlying type set yet.
func MakeNamedType(name @[]char) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_NAMED
	t.Name = name
	return t
}

// MakeAliasType creates a type alias that resolves to target.
func MakeAliasType(name @[]char, target @Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_ALIAS
	t.Name = name
	t.Target = target
	return t
}

// MakeConstType wraps `inner` with the `const` type modifier.
// The result has the same size/align as `inner` — const is purely
// a semantic flag about modifiability through this access path.
// Collapses `const (const T)` into a single `const T` to keep the
// representation canonical.
func MakeConstType(inner @Type) @Type {
	if inner != nil && inner.Kind == TYP_CONST {
		return inner
	}
	var t @Type = make(Type)
	t.Kind = TYP_CONST
	t.Elem = inner
	return t
}

// IsConst reports whether t has the const modifier at its
// outermost level (after stripping aliases).
func IsConst(t @Type) bool {
	t = ResolveAlias(t)
	if t == nil { return false }
	return t.Kind == TYP_CONST
}

// StripConst returns the inner type, peeling one const wrapper.
// Returns t unchanged if t is not const at the outermost level.
// Does NOT recurse: `*const int` stripped is still `*const int`
// (the outer is TYP_POINTER, not TYP_CONST).
func StripConst(t @Type) @Type {
	if t == nil { return nil }
	if t.Kind == TYP_CONST { return t.Elem }
	return t
}

// ============================================================
// Type Queries
// ============================================================

// TypeName returns a human-readable name for the type.
func TypeName(t @Type) @[]char {
	if t == nil {
		return "nil"
	}
	if len(t.Name) > 0 {
		return t.Name
	}
	if t.Kind == TYP_POINTER {
		var cb buf.CharBuf = buf.New()
		cb = buf.WriteByte(cb, '*')
		cb = buf.WriteStr(cb, TypeName(t.Elem))
		return buf.Bytes(cb)
	}
	if t.Kind == TYP_MANAGED_PTR {
		var cb buf.CharBuf = buf.New()
		cb = buf.WriteByte(cb, '@')
		cb = buf.WriteStr(cb, TypeName(t.Elem))
		return buf.Bytes(cb)
	}
	if t.Kind == TYP_SLICE {
		var cb buf.CharBuf = buf.New()
		cb = buf.WriteStr(cb, "*[]")
		cb = buf.WriteStr(cb, TypeName(t.Elem))
		return buf.Bytes(cb)
	}
	if t.Kind == TYP_MANAGED_SLICE {
		var cb buf.CharBuf = buf.New()
		cb = buf.WriteStr(cb, "@[]")
		cb = buf.WriteStr(cb, TypeName(t.Elem))
		return buf.Bytes(cb)
	}
	if t.Kind == TYP_ARRAY {
		return "[...]"
	}
	if t.Kind == TYP_FUNC {
		return "func(...)"
	}
	if t.Kind == TYP_CONST {
		var cb buf.CharBuf = buf.New()
		cb = buf.WriteStr(cb, "const ")
		cb = buf.WriteStr(cb, TypeName(t.Elem))
		return buf.Bytes(cb)
	}
	return "<unknown>"
}

// ResolveAlias follows alias chains and returns the underlying non-alias type.
func ResolveAlias(t @Type) @Type {
	for t != nil && t.Kind == TYP_ALIAS {
		t = t.Target
	}
	return t
}

// resolveAliasAndConst follows both alias and const wrappers to get
// at the "shape" of a type — useful in predicates like IsInteger,
// IsSlice, etc. where `const T` should answer the same as `T`.
// Does NOT recurse into pointer/slice element types.
func resolveAliasAndConst(t @Type) @Type {
	for t != nil {
		if t.Kind == TYP_ALIAS {
			t = t.Target
		} else if t.Kind == TYP_CONST {
			t = t.Elem
		} else {
			return t
		}
	}
	return t
}

// IsInteger reports whether t is an integer type (including untyped int and named integer types).
func IsInteger(t @Type) bool {
	t = resolveAliasAndConst(t)
	if t == nil {
		return false
	}
	if t.Kind == TYP_INT || t.Kind == TYP_UNTYPED_INT {
		return true
	}
	if t.Kind == TYP_NAMED && t.Underlying != nil {
		return t.Underlying.Kind == TYP_INT
	}
	return false
}

// IsFloat reports whether t is a floating-point type (including untyped
// float and named float types).
func IsFloat(t @Type) bool {
	t = resolveAliasAndConst(t)
	if t == nil {
		return false
	}
	if t.Kind == TYP_FLOAT || t.Kind == TYP_UNTYPED_FLOAT {
		return true
	}
	if t.Kind == TYP_NAMED && t.Underlying != nil {
		return t.Underlying.Kind == TYP_FLOAT
	}
	return false
}

// IsNumeric reports whether t is a numeric type (integer or float).
func IsNumeric(t @Type) bool {
	return IsInteger(t) || IsFloat(t)
}

// IsBool reports whether t is a boolean type (including untyped bool).
func IsBool(t @Type) bool {
	t = resolveAliasAndConst(t)
	if t == nil {
		return false
	}
	return t.Kind == TYP_BOOL || t.Kind == TYP_UNTYPED_BOOL
}

// IsPointer reports whether t is a pointer type (raw or managed).
func IsPointer(t @Type) bool {
	t = resolveAliasAndConst(t)
	if t == nil {
		return false
	}
	return t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR
}

// IsSlice reports whether t is a slice type (raw or managed).
func IsSlice(t @Type) bool {
	t = resolveAliasAndConst(t)
	if t == nil {
		return false
	}
	return t.Kind == TYP_SLICE || t.Kind == TYP_MANAGED_SLICE
}

// IsNillable reports whether t can be assigned nil (true for pointer types).
func IsNillable(t @Type) bool {
	return IsPointer(t)
}

// SliceElem returns the element type of a slice or managed-slice, or nil if t is not a slice.
func SliceElem(t @Type) @Type {
	t = resolveAliasAndConst(t)
	if t == nil {
		return nil
	}
	if t.Kind == TYP_SLICE || t.Kind == TYP_MANAGED_SLICE {
		return t.Elem
	}
	return nil
}

// PointerElem returns the element type of a pointer or managed pointer, or nil if not a pointer.
func PointerElem(t @Type) @Type {
	t = resolveAliasAndConst(t)
	if t == nil {
		return nil
	}
	if t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR {
		return t.Elem
	}
	return nil
}

// Identical reports whether types a and b are structurally identical.
// Stage 0 of the const rollout: const wrappers are transparent here —
// `const T` and `T` are identical. Stage 1 will keep transparency in
// this predicate but reject const-drop at assignment sites in
// `AssignableTo` specifically.
func Identical(a @Type, b @Type) bool {
	a = resolveAliasAndConst(a)
	b = resolveAliasAndConst(b)
	if a == nil && b == nil {
		return true
	}
	if a == nil || b == nil {
		return false
	}
	if a.Kind != b.Kind {
		return false
	}
	if a.Kind == TYP_POINTER || a.Kind == TYP_MANAGED_PTR ||
			a.Kind == TYP_SLICE || a.Kind == TYP_MANAGED_SLICE {
		return Identical(a.Elem, b.Elem)
	}
	if a.Kind == TYP_ARRAY {
		return a.ArrayLen == b.ArrayLen && Identical(a.Elem, b.Elem)
	}
	if a.Kind == TYP_STRUCT {
		// Named structs: identical iff same name
		if len(a.Name) > 0 || len(b.Name) > 0 {
			return charEq(a.Name, b.Name)
		}
		// Anonymous structs: structural equivalence (names + types in order)
		if len(a.Fields) != len(b.Fields) {
			return false
		}
		for i := 0; i < len(a.Fields); i++ {
			if !charEq(a.Fields[i].Name, b.Fields[i].Name) {
				return false
			}
			if !Identical(a.Fields[i].Type, b.Fields[i].Type) {
				return false
			}
		}
		return true
	}
	if a.Kind == TYP_FUNC {
		if len(a.Params) != len(b.Params) || len(a.Results) != len(b.Results) {
			return false
		}
		for i := 0; i < len(a.Params); i++ {
			if !Identical(a.Params[i].Type, b.Params[i].Type) {
				return false
			}
		}
		for i := 0; i < len(a.Results); i++ {
			if !Identical(a.Results[i], b.Results[i]) {
				return false
			}
		}
		return true
	}
	// For INT, BOOL, STRING, VOID, NIL, UNTYPED_*, NAMED — match by kind and name
	if a.Kind == TYP_INT {
		return a.Width == b.Width && a.Signed == b.Signed
	}
	if a.Kind == TYP_FLOAT {
		return a.Width == b.Width
	}
	if a.Kind == TYP_NAMED {
		return charEq(a.Name, b.Name)
	}
	// BOOL, STRING, VOID, NIL, UNTYPED_INT, UNTYPED_BOOL — same kind is enough
	return true
}

// AssignableTo reports whether a value of type src can be assigned to type dst.
func AssignableTo(src @Type, dst @Type) bool {
	if Identical(src, dst) {
		return true
	}

	// Untyped constants assignable to their concrete counterparts
	if src != nil && src.Kind == TYP_UNTYPED_INT {
		return IsInteger(dst)
	}
	if src != nil && src.Kind == TYP_UNTYPED_FLOAT {
		return IsFloat(dst)
	}
	if src != nil && src.Kind == TYP_UNTYPED_BOOL {
		return IsBool(dst)
	}

	// nil assignable to nillable types
	if src != nil && src.Kind == TYP_NIL {
		return IsNillable(dst)
	}

	// @T → *T (managed to raw pointer)
	if src != nil && dst != nil && src.Kind == TYP_MANAGED_PTR && dst.Kind == TYP_POINTER {
		return Identical(src.Elem, dst.Elem)
	}

	// @[]T → *[]T (managed to raw slice)
	if src != nil && dst != nil && src.Kind == TYP_MANAGED_SLICE && dst.Kind == TYP_SLICE {
		return Identical(src.Elem, dst.Elem)
	}

	// string ↔ *[]char / @[]char interchangeability
	ensureInit()
	var charSlice @Type = MakeSliceType(predeclaredUint8)
	var managedCharSlice @Type = MakeManagedSliceType(predeclaredUint8)
	if src != nil && src.Kind == TYP_STRING {
		if Identical(dst, charSlice) || Identical(dst, managedCharSlice) {
			return true
		}
	}
	if dst != nil && dst.Kind == TYP_STRING {
		if Identical(src, charSlice) || Identical(src, managedCharSlice) {
			return true
		}
	}

	return false
}

// FieldByName returns the field with the given name, or nil.
func FieldByName(t @Type, name *[]char) @Field {
	if t == nil {
		return nil
	}
	for i := 0; i < len(t.Fields); i++ {
		if charEq(t.Fields[i].Name, name) {
			return t.Fields[i]
		}
	}
	return nil
}

// NeedsDestruction reports whether values of type t require cleanup when
// their containing managed allocation is freed. This is true for:
//   - @T (managed pointers) — always
//   - @[]T (managed-slices) — always
//   - struct types with any field that needs destruction
//   - [N]T arrays where T needs destruction
func NeedsDestruction(t @Type) bool {
	if t == nil { return false }
	t = ResolveAlias(t)
	if t.Kind == TYP_NAMED && t.Underlying != nil {
		return NeedsDestruction(t.Underlying)
	}
	if t.Kind == TYP_MANAGED_PTR { return true }
	if t.Kind == TYP_MANAGED_SLICE { return true }
	if t.Kind == TYP_STRUCT {
		for i := 0; i < len(t.Fields); i++ {
			if NeedsDestruction(t.Fields[i].Type) {
				return true
			}
		}
		return false
	}
	if t.Kind == TYP_ARRAY {
		return NeedsDestruction(t.Elem)
	}
	return false
}

