package "pkg/types"

import "pkg/buf"

// ============================================================
// Predeclared Type Singletons
// ============================================================

// Each predeclared* var is a singleton @Type instance for one of the
// language's built-in types. The Typ* accessors below return them and
// guarantee ensureInit() has run, so callers don't have to. Singletons
// are referenced by identity throughout the type checker (e.g.
// `t == TypBool()`), so we never construct duplicates.

// predeclaredInt is the singleton @Type for `int` (target word-sized signed).
var predeclaredInt @Type
// predeclaredInt8 is the singleton @Type for `int8`.
var predeclaredInt8 @Type
// predeclaredInt16 is the singleton @Type for `int16`.
var predeclaredInt16 @Type
// predeclaredInt32 is the singleton @Type for `int32`.
var predeclaredInt32 @Type
// predeclaredInt64 is the singleton @Type for `int64`.
var predeclaredInt64 @Type
// predeclaredUint is the singleton @Type for `uint` (target word-sized unsigned).
var predeclaredUint @Type
// predeclaredUint8 is the singleton @Type for `uint8`. Also serves as `char` and `byte`.
var predeclaredUint8 @Type
// predeclaredUint16 is the singleton @Type for `uint16`.
var predeclaredUint16 @Type
// predeclaredUint32 is the singleton @Type for `uint32`.
var predeclaredUint32 @Type
// predeclaredUint64 is the singleton @Type for `uint64`.
var predeclaredUint64 @Type
// predeclaredFloat32 is the singleton @Type for `float32`.
var predeclaredFloat32 @Type
// predeclaredFloat64 is the singleton @Type for `float64`.
var predeclaredFloat64 @Type
// predeclaredBool is the singleton @Type for `bool`.
var predeclaredBool @Type
// predeclaredVoid is the singleton @Type representing no result type.
var predeclaredVoid @Type
// predeclaredNil is the singleton @Type for the literal `nil` (assignable to any nullable type).
var predeclaredNil @Type
// predeclaredUntypedInt is the singleton @Type for an integer literal whose type is not yet fixed.
var predeclaredUntypedInt @Type
// predeclaredUntypedFloat is the singleton @Type for a float literal whose type is not yet fixed.
var predeclaredUntypedFloat @Type
// predeclaredUntypedBool is the singleton @Type for an untyped boolean
// (e.g., result of a comparison).
var predeclaredUntypedBool @Type

// typesInitialized guards the lazy ensureInit() call so the singletons
// are constructed exactly once across the lifetime of the process.
var typesInitialized bool

// ensureInit lazily initializes all predeclared type singletons on first use.
func ensureInit() {
	if typesInitialized {
		return
	}
	typesInitialized = true

	predeclaredInt = makeIntType("int", 64, true)
	predeclaredInt8 = makeIntType("int8", 8, true)
	predeclaredInt16 = makeIntType("int16", 16, true)
	predeclaredInt32 = makeIntType("int32", 32, true)
	predeclaredInt64 = makeIntType("int64", 64, true)
	predeclaredUint = makeIntType("uint", 64, false)
	predeclaredUint8 = makeIntType("uint8", 8, false)
	predeclaredUint16 = makeIntType("uint16", 16, false)
	predeclaredUint32 = makeIntType("uint32", 32, false)
	predeclaredUint64 = makeIntType("uint64", 64, false)
	predeclaredFloat32 = makeFloatType("float32", 32)
	predeclaredFloat64 = makeFloatType("float64", 64)

	predeclaredBool = make(Type)
	predeclaredBool.Kind = TYP_BOOL
	predeclaredBool.Name = "bool"

	predeclaredVoid = make(Type)
	predeclaredVoid.Kind = TYP_VOID
	predeclaredVoid.Name = "void"

	predeclaredNil = make(Type)
	predeclaredNil.Kind = TYP_NIL
	predeclaredNil.Name = "nil"

	predeclaredUntypedInt = make(Type)
	predeclaredUntypedInt.Kind = TYP_UNTYPED_INT
	predeclaredUntypedInt.Name = "untyped int"

	predeclaredUntypedFloat = make(Type)
	predeclaredUntypedFloat.Kind = TYP_UNTYPED_FLOAT
	predeclaredUntypedFloat.Name = "untyped float"

	predeclaredUntypedBool = make(Type)
	predeclaredUntypedBool.Kind = TYP_UNTYPED_BOOL
	predeclaredUntypedBool.Name = "untyped bool"
}

// makeIntType creates a predeclared integer type with the given name, bit width, and signedness.
func makeIntType(name @[]char, width int, signed bool) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_INT
	t.Name = name
	t.Width = width
	t.Signed = signed
	return t
}

// makeFloatType creates a predeclared floating-point type with the given name and bit width.
func makeFloatType(name @[]char, width int) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_FLOAT
	t.Name = name
	t.Width = width
	return t
}

// Each Typ* accessor returns the predeclared singleton for the named
// type, calling ensureInit() so callers don't have to manage init order.
// The returned @Type is the unique instance — compare by identity.
//
// Note: TypChar and TypByte both return the uint8 singleton — `char` and
// `byte` are aliases of uint8 in Binate.

// TypInt returns the predeclared `int` singleton (target word-sized signed).
func TypInt() @Type      { ensureInit(); return predeclaredInt }
// TypInt8 returns the predeclared `int8` singleton.
func TypInt8() @Type     { ensureInit(); return predeclaredInt8 }
// TypInt16 returns the predeclared `int16` singleton.
func TypInt16() @Type    { ensureInit(); return predeclaredInt16 }
// TypInt32 returns the predeclared `int32` singleton.
func TypInt32() @Type    { ensureInit(); return predeclaredInt32 }
// TypInt64 returns the predeclared `int64` singleton.
func TypInt64() @Type    { ensureInit(); return predeclaredInt64 }
// TypUint returns the predeclared `uint` singleton (target word-sized unsigned).
func TypUint() @Type     { ensureInit(); return predeclaredUint }
// TypUint8 returns the predeclared `uint8` singleton (also returned by TypChar/TypByte).
func TypUint8() @Type    { ensureInit(); return predeclaredUint8 }
// TypUint16 returns the predeclared `uint16` singleton.
func TypUint16() @Type   { ensureInit(); return predeclaredUint16 }
// TypUint32 returns the predeclared `uint32` singleton.
func TypUint32() @Type   { ensureInit(); return predeclaredUint32 }
// TypUint64 returns the predeclared `uint64` singleton.
func TypUint64() @Type   { ensureInit(); return predeclaredUint64 }
// TypFloat32 returns the predeclared `float32` singleton.
func TypFloat32() @Type  { ensureInit(); return predeclaredFloat32 }
// TypFloat64 returns the predeclared `float64` singleton.
func TypFloat64() @Type  { ensureInit(); return predeclaredFloat64 }
// TypBool returns the predeclared `bool` singleton.
func TypBool() @Type     { ensureInit(); return predeclaredBool }
// TypChar returns the predeclared `char` type. `char` is uint8 in Binate;
// this returns the same singleton as TypUint8 / TypByte by design.
func TypChar() @Type     { ensureInit(); return predeclaredUint8 }
// TypByte returns the predeclared `byte` type. `byte` is uint8 in Binate;
// this returns the same singleton as TypUint8 / TypChar by design.
func TypByte() @Type     { ensureInit(); return predeclaredUint8 }
// TypVoid returns the predeclared no-result-type singleton (used for
// function results that yield no value).
func TypVoid() @Type     { ensureInit(); return predeclaredVoid }
// TypNil returns the predeclared singleton for the literal `nil`.
// Assignable to any nullable type during type checking.
func TypNil() @Type      { ensureInit(); return predeclaredNil }
// TypUntypedInt returns the predeclared singleton for an integer literal
// whose concrete type has not yet been fixed by context.
func TypUntypedInt() @Type   { ensureInit(); return predeclaredUntypedInt }
// TypUntypedFloat returns the predeclared singleton for a float literal
// whose concrete type has not yet been fixed by context.
func TypUntypedFloat() @Type { ensureInit(); return predeclaredUntypedFloat }
// TypUntypedBool returns the predeclared singleton for an untyped
// boolean (e.g., the result of a comparison before context fixes it).
func TypUntypedBool() @Type  { ensureInit(); return predeclaredUntypedBool }

// ============================================================
// Type Construction
// ============================================================

// MakePointerType creates a raw pointer type (*elem).
func MakePointerType(elem @Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_POINTER
	t.Elem = elem
	return t
}

// MakeManagedPtrType creates a managed pointer type (@elem).
func MakeManagedPtrType(elem @Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_MANAGED_PTR
	t.Elem = elem
	return t
}

// MakeSliceType creates a raw slice type (*[]elem).
func MakeSliceType(elem @Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_SLICE
	t.Elem = elem
	return t
}

// MakeManagedSliceType creates a managed-slice type (@[]elem).
func MakeManagedSliceType(elem @Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_MANAGED_SLICE
	t.Elem = elem
	return t
}

// MakeArrayType creates an array type ([length]elem).
func MakeArrayType(elem @Type, length int) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_ARRAY
	t.Elem = elem
	t.ArrayLen = length
	return t
}

// MakeStructType creates a struct type with the given name and fields.
func MakeStructType(name @[]char, fields @[]@Field) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_STRUCT
	t.Name = name
	t.Fields = fields
	return t
}

// MakeFuncType creates a function type with the given parameters and return types.
func MakeFuncType(params @[]@Param, results @[]@Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_FUNC
	t.Params = params
	t.Results = results
	return t
}

// MakeFuncValueType creates a raw function-value type (*func(args) ret).
// 2-word {vtable, data} layout (16 bytes); vtable selection happens
// downstream during IR-gen / codegen.
func MakeFuncValueType(params @[]@Param, results @[]@Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_FUNC_VALUE
	t.Params = params
	t.Results = results
	return t
}

// MakeManagedFuncValueType creates a managed function-value type
// (@func(args) ret). Same layout as MakeFuncValueType; the data
// pointer is refcounted.
func MakeManagedFuncValueType(params @[]@Param, results @[]@Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_MANAGED_FUNC_VALUE
	t.Params = params
	t.Results = results
	return t
}

// MakeNamedType creates a named (distinct) type with no underlying type set yet.
func MakeNamedType(name @[]char) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_NAMED
	t.Name = name
	return t
}

// MakeAliasType creates a type alias that resolves to target.
func MakeAliasType(name @[]char, target @Type) @Type {
	var t @Type = make(Type)
	t.Kind = TYP_ALIAS
	t.Name = name
	t.Target = target
	return t
}

// ============================================================
// Methods (registered on named types)
// ============================================================

// MakeMethod constructs a Method record. FuncType must include the
// receiver as Params[0].
func MakeMethod(name @[]char, recvType @Type, funcType @Type) @Method {
	var m @Method = make(Method)
	m.Name = name
	m.RecvType = recvType
	m.FuncType = funcType
	return m
}

// AddMethod appends m to the named type t's method set. Returns false
// (without modifying t) if a method with the same name is already
// present, so callers can report duplicate-decl errors.
func AddMethod(t @Type, m @Method) bool {
	if t == nil || t.Kind != TYP_NAMED || m == nil {
		return false
	}
	for i := 0; i < len(t.Methods); i++ {
		if charEq(t.Methods[i].Name, m.Name) {
			return false
		}
	}
	t.Methods = appendMethod(t.Methods, m)
	return true
}

// LookupMethod returns the method named `name` on the named type t, or
// nil if no such method is registered. Returns nil for non-named types.
func LookupMethod(t @Type, name *[]const char) @Method {
	if t == nil || t.Kind != TYP_NAMED {
		return nil
	}
	for i := 0; i < len(t.Methods); i++ {
		if charEq(t.Methods[i].Name, name) {
			return t.Methods[i]
		}
	}
	return nil
}

// ReceiverBaseNamed unwraps a receiver type's outer pointer/managed/const
// wrappers and returns the underlying named type, or nil if the receiver
// is not (a wrapper around) a named type.
func ReceiverBaseNamed(t @Type) @Type {
	if t == nil {
		return nil
	}
	if t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR || t.Kind == TYP_CONST {
		return ReceiverBaseNamed(t.Elem)
	}
	if t.Kind == TYP_NAMED {
		return t
	}
	return nil
}

// appendMethod appends m to ms and returns the new slice.
func appendMethod(ms @[]@Method, m @Method) @[]@Method {
	var n int = len(ms)
	var out @[]@Method = make_slice(@Method, n+1)
	for i := 0; i < n; i++ {
		out[i] = ms[i]
	}
	out[n] = m
	return out
}
