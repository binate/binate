package "pkg/types"

import "pkg/ast"

// Append helpers for the typed slice collections used by the
// type-checker — methods, impls, AST-decl pointers (generic
// registries), char-slice pointers (pkg-pairings parallel to
// the generic registries), and the GenericInstantiation cache.
// Split out of types.bn to keep that file under the file-length
// soft cap; the helpers are pure data-shape boilerplate with no
// dependency on the type-checker's logic.

// appendMethod appends m to ms and returns the new slice.
func appendMethod(ms @[]@Method, m @Method) @[]@Method {
	var n int = len(ms)
	var out @[]@Method = make_slice(@Method, n+1)
	for i := 0; i < n; i++ {
		out[i] = ms[i]
	}
	out[n] = m
	return out
}

// appendImpl appends i to s and returns the new slice.
func appendImpl(s @[]@Impl, i @Impl) @[]@Impl {
	var n int = len(s)
	var out @[]@Impl = make_slice(@Impl, n+1)
	for k := 0; k < n; k++ {
		out[k] = s[k]
	}
	out[n] = i
	return out
}

// appendDeclPtr appends an AST decl pointer to a managed slice.
// Used by the generic-type-decl registry in Slice 5b.
func appendDeclPtr(s @[]@ast.Decl, v @ast.Decl) @[]@ast.Decl {
	var n int = len(s)
	var out @[]@ast.Decl = make_slice(@ast.Decl, n+1)
	for k := 0; k < n; k++ {
		out[k] = s[k]
	}
	out[n] = v
	return out
}

// appendCharSlicePtr appends a char-slice to a managed slice of
// char-slices.  Slice 7 of plan-generics.md uses this to keep
// per-decl pkg short-names parallel to the GenericTypeDecls /
// GenericIfaceDecls registries.
func appendCharSlicePtr(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var out @[]@[]char = make_slice(@[]char, n+1)
	for k := 0; k < n; k++ {
		out[k] = s[k]
	}
	out[n] = v
	return out
}

// appendGenericInstantiation appends a GenericInstantiation cache
// entry.  Used by the type-checker's per-(decl, args) cache so
// repeated `List[int]` references share a single @Type.
func appendGenericInstantiation(s @[]@GenericInstantiation,
		v @GenericInstantiation) @[]@GenericInstantiation {
	var n int = len(s)
	var out @[]@GenericInstantiation =
		make_slice(@GenericInstantiation, n+1)
	for k := 0; k < n; k++ {
		out[k] = s[k]
	}
	out[n] = v
	return out
}
