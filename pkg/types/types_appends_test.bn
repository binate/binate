package "pkg/types"

import "pkg/builtin/testing"

// Tests for the slice-append helpers in types_appends.bn.  The
// helpers are pure data-shape boilerplate but the tests pin
// the length / element-preservation invariants so a future
// refactor (e.g., switching to a growable helper) can be
// validated against fixed expectations.

func TestAppendCharSlicePtrEmpty() testing.TestResult {
	var s @[]@[]char
	var v @[]char
	var out @[]@[]char = appendCharSlicePtr(s, v)
	if len(out) != 1 {
		return "appending to empty should yield length 1"
	}
	return ""
}

func TestAppendCharSlicePtrPreservesOrder() testing.TestResult {
	var s @[]@[]char
	var a @[]char = "a"
	var b @[]char = "b"
	s = appendCharSlicePtr(s, a)
	s = appendCharSlicePtr(s, b)
	if len(s) != 2 { return "expected 2 entries" }
	if !charsEqualOptC(s[0], "a") { return "entry 0 should be a" }
	if !charsEqualOptC(s[1], "b") { return "entry 1 should be b" }
	return ""
}

// charsEqualOptC mirrors pkg/ir's helper for nil-tolerant
// char-slice equality; defined locally to keep this test file
// self-contained.
func charsEqualOptC(a @[]char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
