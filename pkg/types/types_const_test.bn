package "pkg/types"

import "pkg/builtin/testing"

// Tests specifically for the const-assignability rules exported
// from types_const.bn. The MakeConstType / IsConst / StripConst
// predicates themselves are covered in types_test.bn; these
// tests exercise the widening / narrowing policy enforced by
// `AssignableTo` + `dropsConst`.

// AssignableTo allows widening T → const T for a value type.
func TestAssignableWidenValue() testing.TestResult {
	if !AssignableTo(TypInt(), MakeConstType(TypInt())) {
		return fail("int → const int should be assignable")
	}
	return ""
}

// AssignableTo allows const T → T (outer-const drop) for a value type.
// This is a value copy — the const handle is unaffected.
func TestAssignableOuterConstValueCopyOut() testing.TestResult {
	if !AssignableTo(MakeConstType(TypInt()), TypInt()) {
		return fail("const int → int (value copy) should be assignable")
	}
	return ""
}

// AssignableTo allows *T → *const T (add const to element — widening).
func TestAssignableAddElemConst() testing.TestResult {
	var pInt @Type = MakePointerType(TypInt())
	var pConstInt @Type = MakePointerType(MakeConstType(TypInt()))
	if !AssignableTo(pInt, pConstInt) {
		return fail("*int → *const int should be assignable")
	}
	return ""
}

// AssignableTo rejects *const T → *T (element-level const drop).
func TestRejectDropElemConst() testing.TestResult {
	var pInt @Type = MakePointerType(TypInt())
	var pConstInt @Type = MakePointerType(MakeConstType(TypInt()))
	if AssignableTo(pConstInt, pInt) {
		return fail("*const int → *int should NOT be assignable")
	}
	return ""
}

// AssignableTo rejects element const drop on slices; widening OK.
func TestRejectDropSliceElemConst() testing.TestResult {
	var sInt @Type = MakeSliceType(TypInt())
	var sConstInt @Type = MakeSliceType(MakeConstType(TypInt()))
	if AssignableTo(sConstInt, sInt) {
		return fail("*[]const int → *[]int should NOT be assignable")
	}
	if !AssignableTo(sInt, sConstInt) {
		return fail("*[]int → *[]const int should be assignable")
	}
	return ""
}

// ============================================================
// Stage 2a: string-literal → slice target rules
// ============================================================

// string → *[]char is the ratchet: rejected. A mutable raw borrow
// of rodata has no correct lowering.
func TestRejectStringToRawCharSlice() testing.TestResult {
	if AssignableTo(TypString(), MakeSliceType(TypChar())) {
		return fail("string → *[]char should NOT be assignable")
	}
	return ""
}

// string → *[]const char: zero-copy borrow, allowed.
func TestAllowStringToConstRawCharSlice() testing.TestResult {
	var dst @Type = MakeSliceType(MakeConstType(TypChar()))
	if !AssignableTo(TypString(), dst) {
		return fail("string → *[]const char should be assignable")
	}
	return ""
}

// string → @[]char: implicit-copy path, allowed at the type level.
func TestAllowStringToManagedCharSlice() testing.TestResult {
	var dst @Type = MakeManagedSliceType(TypChar())
	if !AssignableTo(TypString(), dst) {
		return fail("string → @[]char should be assignable")
	}
	return ""
}

// string → @[]const char: zero-copy managed borrow, allowed.
func TestAllowStringToConstManagedCharSlice() testing.TestResult {
	var dst @Type = MakeManagedSliceType(MakeConstType(TypChar()))
	if !AssignableTo(TypString(), dst) {
		return fail("string → @[]const char should be assignable")
	}
	return ""
}

// string → *[]int (non-char element) is rejected — the string
// interchangeability rule only fires for char/uint8 elements.
func TestRejectStringToNonCharSlice() testing.TestResult {
	if AssignableTo(TypString(), MakeSliceType(TypInt())) {
		return fail("string → *[]int should NOT be assignable")
	}
	if AssignableTo(TypString(), MakeManagedSliceType(TypInt())) {
		return fail("string → @[]int should NOT be assignable")
	}
	return ""
}

// string → non-slice type is rejected.
func TestRejectStringToNonSlice() testing.TestResult {
	if AssignableTo(TypString(), TypInt()) {
		return fail("string → int should NOT be assignable")
	}
	if AssignableTo(TypString(), MakePointerType(TypChar())) {
		return fail("string → *char should NOT be assignable")
	}
	return ""
}

// Outer const on the destination is transparent — *[]const char
// wrapped in one more const layer is still a valid target.
func TestAllowStringToOuterConstSliceTarget() testing.TestResult {
	var inner @Type = MakeSliceType(MakeConstType(TypChar()))
	var outer @Type = MakeConstType(inner)
	if !AssignableTo(TypString(), outer) {
		return fail("string → const *[]const char should be assignable")
	}
	return ""
}
