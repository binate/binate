package "pkg/types"

import "pkg/buf"

// currentChecker is the Checker the type-system queries route
// through for context-dependent answers — at present, just
// interface-value assignability (which has to scan c.Impls to find
// a matching impl for *T / @T → *Iface). Set by the Check* entry
// points via WithChecker. Cleared on exit so tests that call
// AssignableTo standalone aren't surprised by stale impl state.
var currentChecker @Checker

// WithChecker installs c as the active checker for the duration
// of the caller's pass. Returns the prior checker, which the
// caller must pass to RestoreChecker on exit. Keeps the global
// re-entrant across nested checks (e.g., REPL inside a regular
// compile).
func WithChecker(c @Checker) @Checker {
	var prev @Checker = currentChecker
	currentChecker = c
	return prev
}

// RestoreChecker reinstalls the previously-active checker (the
// return value from a matching WithChecker call). Use in defer-
// style pairing.
func RestoreChecker(prev @Checker) {
	currentChecker = prev
}

// ============================================================
// Type Queries
// ============================================================

// TypeName returns a human-readable name for the type.
func TypeName(t @Type) @[]char {
	if t == nil {
		return "nil"
	}
	if len(t.Name) > 0 {
		return t.Name
	}
	if t.Kind == TYP_POINTER {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteByte('*')
		cb = cb.WriteStr(TypeName(t.Elem))
		return cb.Bytes()
	}
	if t.Kind == TYP_MANAGED_PTR {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteByte('@')
		cb = cb.WriteStr(TypeName(t.Elem))
		return cb.Bytes()
	}
	if t.Kind == TYP_SLICE {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("*[]")
		cb = cb.WriteStr(TypeName(t.Elem))
		return cb.Bytes()
	}
	if t.Kind == TYP_MANAGED_SLICE {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("@[]")
		cb = cb.WriteStr(TypeName(t.Elem))
		return cb.Bytes()
	}
	if t.Kind == TYP_ARRAY {
		return "[...]"
	}
	if t.Kind == TYP_FUNC {
		return "func(...)"
	}
	if t.Kind == TYP_CONST {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("const ")
		cb = cb.WriteStr(TypeName(t.Elem))
		return cb.Bytes()
	}
	return "<unknown>"
}

// ResolveAlias follows alias chains and returns the underlying non-alias type.
func ResolveAlias(t @Type) @Type {
	for t != nil && t.Kind == TYP_ALIAS {
		t = t.Target
	}
	return t
}

// IsInteger reports whether t is an integer type (including untyped int and named integer types).
func (t @Type) IsInteger() bool {
	t = resolveAliasAndConst(t)
	if t == nil {
		return false
	}
	if t.Kind == TYP_INT || t.Kind == TYP_UNTYPED_INT {
		return true
	}
	if t.Kind == TYP_NAMED && t.Underlying != nil {
		return t.Underlying.Kind == TYP_INT
	}
	return false
}

// IsInteger is the free-function shim for the @Type.IsInteger method.
// Kept for backwards compatibility during migration; new callers should
// use the method form.
func IsInteger(t @Type) bool { return t.IsInteger() }

// IsFloat reports whether t is a floating-point type (including untyped
// float and named float types).
func IsFloat(t @Type) bool {
	t = resolveAliasAndConst(t)
	if t == nil {
		return false
	}
	if t.Kind == TYP_FLOAT || t.Kind == TYP_UNTYPED_FLOAT {
		return true
	}
	if t.Kind == TYP_NAMED && t.Underlying != nil {
		return t.Underlying.Kind == TYP_FLOAT
	}
	return false
}

// IsNumeric reports whether t is a numeric type (integer or float).
func IsNumeric(t @Type) bool {
	return t.IsInteger() || IsFloat(t)
}

// IsBool reports whether t is a boolean type (including untyped bool).
func (t @Type) IsBool() bool {
	t = resolveAliasAndConst(t)
	if t == nil {
		return false
	}
	return t.Kind == TYP_BOOL || t.Kind == TYP_UNTYPED_BOOL
}

// IsBool is the free-function shim for the @Type.IsBool method.
func IsBool(t @Type) bool { return t.IsBool() }

// IsPointer reports whether t is a pointer type (raw or managed).
func (t @Type) IsPointer() bool {
	t = resolveAliasAndConst(t)
	if t == nil {
		return false
	}
	return t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR
}

// IsPointer is the free-function shim for the @Type.IsPointer method.
func IsPointer(t @Type) bool { return t.IsPointer() }

// IsSlice reports whether t is a slice type (raw or managed).
func (t @Type) IsSlice() bool {
	t = resolveAliasAndConst(t)
	if t == nil {
		return false
	}
	return t.Kind == TYP_SLICE || t.Kind == TYP_MANAGED_SLICE
}

// IsSlice is the free-function shim for the @Type.IsSlice method.
func IsSlice(t @Type) bool { return t.IsSlice() }

// IsNillable reports whether t can be assigned nil. True for pointer
// types and function-value types (raw or managed). Function values
// have a 2-word {vtable, data} layout, but a nil function value is a
// meaningful state — both halves zero — and the assignment is
// accepted (slices, by contrast, reject nil-assignment and use bare-
// decl zero-init instead).
func (t @Type) IsNillable() bool {
	if t.IsPointer() { return true }
	t = resolveAliasAndConst(t)
	if t == nil { return false }
	return t.Kind == TYP_FUNC_VALUE ||
		t.Kind == TYP_MANAGED_FUNC_VALUE
}

// IsNillable is the free-function shim for the @Type.IsNillable method.
func IsNillable(t @Type) bool { return t.IsNillable() }

// funcSignaturesMatch reports whether a TYP_FUNC and a TYP_FUNC_VALUE
// (or TYP_MANAGED_FUNC_VALUE) have identical signatures: same number
// of params with identical types, and same number of results with
// identical types. Param names are ignored — function-value types
// have anonymous params anyway.
func funcSignaturesMatch(fn @Type, fv @Type) bool {
	if fn == nil || fv == nil { return false }
	if len(fn.Params) != len(fv.Params) { return false }
	if len(fn.Results) != len(fv.Results) { return false }
	for i := 0; i < len(fn.Params); i++ {
		if !Identical(fn.Params[i].Type, fv.Params[i].Type) {
			return false
		}
	}
	for i := 0; i < len(fn.Results); i++ {
		if !Identical(fn.Results[i], fv.Results[i]) {
			return false
		}
	}
	return true
}

// SliceElem returns the element type of a slice or managed-slice, or nil if t is not a slice.
func SliceElem(t @Type) @Type {
	t = resolveAliasAndConst(t)
	if t == nil {
		return nil
	}
	if t.Kind == TYP_SLICE || t.Kind == TYP_MANAGED_SLICE {
		return t.Elem
	}
	return nil
}

// PointerElem returns the element type of a pointer or managed pointer, or nil if not a pointer.
func PointerElem(t @Type) @Type {
	t = resolveAliasAndConst(t)
	if t == nil {
		return nil
	}
	if t.Kind == TYP_POINTER || t.Kind == TYP_MANAGED_PTR {
		return t.Elem
	}
	return nil
}

// Identical reports whether types a and b are structurally identical.
// Stage 0 of the const rollout: const wrappers are transparent here —
// `const T` and `T` are identical. Stage 1 will keep transparency in
// this predicate but reject const-drop at assignment sites in
// `AssignableTo` specifically.
func Identical(a @Type, b @Type) bool {
	a = resolveAliasAndConst(a)
	b = resolveAliasAndConst(b)
	if a == nil && b == nil {
		return true
	}
	if a == nil || b == nil {
		return false
	}
	if a.Kind != b.Kind {
		return false
	}
	if a.Kind == TYP_POINTER || a.Kind == TYP_MANAGED_PTR ||
			a.Kind == TYP_SLICE || a.Kind == TYP_MANAGED_SLICE {
		return Identical(a.Elem, b.Elem)
	}
	if a.Kind == TYP_ARRAY {
		return a.ArrayLen == b.ArrayLen && Identical(a.Elem, b.Elem)
	}
	if a.Kind == TYP_STRUCT {
		// Named structs: identical iff same name
		if len(a.Name) > 0 || len(b.Name) > 0 {
			return charEq(a.Name, b.Name)
		}
		// Anonymous structs: structural equivalence (names + types in order)
		if len(a.Fields) != len(b.Fields) {
			return false
		}
		for i := 0; i < len(a.Fields); i++ {
			if !charEq(a.Fields[i].Name, b.Fields[i].Name) {
				return false
			}
			if !Identical(a.Fields[i].Type, b.Fields[i].Type) {
				return false
			}
		}
		return true
	}
	if a.Kind == TYP_FUNC {
		if len(a.Params) != len(b.Params) || len(a.Results) != len(b.Results) {
			return false
		}
		for i := 0; i < len(a.Params); i++ {
			if !Identical(a.Params[i].Type, b.Params[i].Type) {
				return false
			}
		}
		for i := 0; i < len(a.Results); i++ {
			if !Identical(a.Results[i], b.Results[i]) {
				return false
			}
		}
		return true
	}
	// For INT, BOOL, STRING, VOID, NIL, UNTYPED_*, NAMED — match by kind and name
	if a.Kind == TYP_INT {
		return a.Width == b.Width && a.Signed == b.Signed
	}
	if a.Kind == TYP_FLOAT {
		return a.Width == b.Width
	}
	if a.Kind == TYP_NAMED {
		return charEq(a.Name, b.Name)
	}
	// BOOL, STRING, VOID, NIL, UNTYPED_INT, UNTYPED_BOOL — same kind is enough
	return true
}

// AssignableTo reports whether a value of type src can be assigned to type dst.
// Const rule (Stage 1): widening is allowed (`T → const T`), narrowing is not
// (`const T → T` requires an explicit `cast`). Const-drop is detected
// structurally at any position — e.g., `*const T → *T` is rejected because
// the pointer's element type loses const.
func AssignableTo(src @Type, dst @Type) bool {
	// String literal natural type → array target with matching length.
	// Checked before the generic Identical+dropsConst path because
	// `[N]const char → [N]char` is structurally identical (mod const)
	// but drops element-level const — which would otherwise be rejected.
	// The drop is safe here because arrays are value-copied, so the
	// destination is a fresh independent array. Slice/raw-slice targets
	// are handled later (those decay paths don't intersect Identical).
	ensureInit()
	if isStringLitNaturalType(src) && isStringWritableArrayTarget(dst) &&
			arrayLengthsMatch(src, dst) {
		return true
	}

	if Identical(src, dst) {
		// `Identical` is const-transparent, so types that differ only
		// in const at some position still match here. Reject if the
		// difference is a narrowing (const present in src but not in
		// the corresponding dst position).
		if dropsConst(src, dst) {
			return false
		}
		return true
	}

	// Untyped constants assignable to their concrete counterparts
	if src != nil && src.Kind == TYP_UNTYPED_INT {
		return dst.IsInteger()
	}
	if src != nil && src.Kind == TYP_UNTYPED_FLOAT {
		return IsFloat(dst)
	}
	if src != nil && src.Kind == TYP_UNTYPED_BOOL {
		return dst.IsBool()
	}

	// nil assignable to nillable types
	if src != nil && src.Kind == TYP_NIL {
		return dst.IsNillable()
	}

	// Named function reference → function-value type (raw or managed).
	// `var f *func(int) int = add` where `add` is a top-level
	// function. Signature match: identical param types and result
	// types. The TYP_FUNC has params with Names; the function-value
	// type's params are anonymous — compare types only.
	if src != nil && dst != nil && src.Kind == TYP_FUNC &&
		(dst.Kind == TYP_FUNC_VALUE ||
			dst.Kind == TYP_MANAGED_FUNC_VALUE) {
		return funcSignaturesMatch(src, dst)
	}

	// @T → *T (managed to raw pointer). Element must match with no
	// const drop at element level.
	if src != nil && dst != nil && src.Kind == TYP_MANAGED_PTR && dst.Kind == TYP_POINTER {
		return Identical(src.Elem, dst.Elem) && !dropsConst(src.Elem, dst.Elem)
	}

	// @[]T → *[]T (managed to raw slice). Same element-const check.
	if src != nil && dst != nil && src.Kind == TYP_MANAGED_SLICE && dst.Kind == TYP_SLICE {
		return Identical(src.Elem, dst.Elem) && !dropsConst(src.Elem, dst.Elem)
	}

	// String literal natural type → slice / array (Stage 2c default-flip):
	// EXPR_STRING_LIT has natural type [N]const char (see string_lit.bn).
	// The same rules apply to any structurally-equivalent value.
	//   [N]const char → *[]const char    : zero-copy raw-slice borrow
	//   [N]const char → @[]const char    : zero-copy managed-slice borrow
	//   [N]const char → @[]char          : literal-init allocate+copy
	//   [N]const char → *[]char          : REJECTED — raw slice with mutable
	//                                       view of rodata is unsound
	//   [N]const char → [M]const char (M==N) : array copy, no const drop
	//   [N]const char → [M]char (M==N)       : array copy with outer
	//                                       element-const drop (safe — the
	//                                       array is value-copied, not aliased)
	if isStringLitNaturalType(src) && isStringWritableSliceTarget(dst) {
		return true
	}

	// *T / @T → *Iface (raw interface value): the source is some
	// pointer-shaped value whose underlying named type has an impl
	// for the interface. Per plan-interface-syntax-revision.md
	// "Construction-site conversions — explicit only": value `T` is
	// rejected (caller must write `&t`); `*T` matches if some impl's
	// receiver is reachable via safe smoothing; `@T` works through
	// the existing managed-as-raw path. Lookup walks
	// currentChecker.Impls.
	if dst != nil && dst.Kind == TYP_INTERFACE_VALUE {
		return canAssignToRawInterfaceValue(src, dst)
	}

	// @T → @Iface (managed interface value): only managed sources
	// are admitted — raw `*T` cannot promote to `@Iface` (would
	// invent a refcount on something that has none). The matched
	// impl's receiver kind must be reachable from `@T` via
	// receiverAssignable. Per plan-interface-syntax-revision.md
	// "Construction-site conversions — explicit only" (Slice 2.3b).
	if dst != nil && dst.Kind == TYP_INTERFACE_VALUE_MANAGED {
		return canAssignToManagedInterfaceValue(src, dst)
	}

	return false
}

// canAssignToRawInterfaceValue returns true if a source of type
// src can be implicitly assigned to a raw interface-value type
// (*Iface). Requires (a) src is a pointer-shaped value (T value
// rejected per the plan), and (b) currentChecker has an Impl
// record whose receiver is reachable from src and whose interface
// list includes dst.Elem.
func canAssignToRawInterfaceValue(src @Type, dst @Type) bool {
	if currentChecker == nil { return false }
	if dst == nil || dst.Kind != TYP_INTERFACE_VALUE { return false }
	var iface @Type = dst.Elem
	if iface == nil { return false }
	var srcResolved @Type = ResolveAlias(src)
	if srcResolved == nil { return false }
	if srcResolved.Kind != TYP_POINTER &&
		srcResolved.Kind != TYP_MANAGED_PTR {
		return false
	}
	for i := 0; i < len(currentChecker.Impls); i++ {
		var rec @Impl = currentChecker.Impls[i]
		if rec == nil { continue }
		if !implCoversInterface(rec, iface) { continue }
		if receiverAssignable(src, rec.RecvType) {
			return true
		}
	}
	return false
}

// canAssignToManagedInterfaceValue returns true if a source of
// type src can be implicitly assigned to a managed interface-value
// type (@Iface). Only @T sources are admitted (raw `*T` cannot
// promote to @Iface — there's no refcount header to RefInc); the
// matched impl's receiver must be reachable from @T via receiver
// Assignable. Slice 2.3b of plan-interface-syntax-revision.md.
func canAssignToManagedInterfaceValue(src @Type, dst @Type) bool {
	if currentChecker == nil { return false }
	if dst == nil ||
		dst.Kind != TYP_INTERFACE_VALUE_MANAGED { return false }
	var iface @Type = dst.Elem
	if iface == nil { return false }
	var srcResolved @Type = ResolveAlias(src)
	if srcResolved == nil { return false }
	if srcResolved.Kind != TYP_MANAGED_PTR { return false }
	for i := 0; i < len(currentChecker.Impls); i++ {
		var rec @Impl = currentChecker.Impls[i]
		if rec == nil { continue }
		if !implCoversInterface(rec, iface) { continue }
		if receiverAssignable(src, rec.RecvType) {
			return true
		}
	}
	return false
}

// implCoversInterface returns true if the impl's interface list
// includes the given interface (matched by name — interfaces are
// nominal and same-name within a package implies same interface).
func implCoversInterface(rec @Impl, iface @Type) bool {
	if rec == nil || iface == nil { return false }
	for i := 0; i < len(rec.Interfaces); i++ {
		var entry @Type = rec.Interfaces[i]
		if entry == nil { continue }
		if charEq(entry.Name, iface.Name) { return true }
	}
	return false
}

// arrayLengthsMatch reports whether src and dst are both array types
// (after peeling outer const/alias) with equal ArrayLen.
func arrayLengthsMatch(src @Type, dst @Type) bool {
	src = peelOuterConstAndAlias(src)
	dst = peelOuterConstAndAlias(dst)
	if src == nil || dst == nil { return false }
	if src.Kind != TYP_ARRAY || dst.Kind != TYP_ARRAY { return false }
	return src.ArrayLen == dst.ArrayLen
}

// FieldByName returns the field with the given name, or nil.
func FieldByName(t @Type, name *[]const char) @Field {
	if t == nil {
		return nil
	}
	for i := 0; i < len(t.Fields); i++ {
		if charEq(t.Fields[i].Name, name) {
			return t.Fields[i]
		}
	}
	return nil
}

// NeedsDestruction reports whether values of type t require cleanup when
// their containing managed allocation is freed. This is true for:
//   - @T (managed pointers) — always
//   - @[]T (managed-slices) — always
//   - struct types with any field that needs destruction
//   - [N]T arrays where T needs destruction
func NeedsDestruction(t @Type) bool {
	if t == nil { return false }
	t = ResolveAlias(t)
	if t.Kind == TYP_NAMED && t.Underlying != nil {
		return NeedsDestruction(t.Underlying)
	}
	if t.Kind == TYP_MANAGED_PTR { return true }
	if t.Kind == TYP_MANAGED_SLICE { return true }
	if t.Kind == TYP_STRUCT {
		for i := 0; i < len(t.Fields); i++ {
			if NeedsDestruction(t.Fields[i].Type) {
				return true
			}
		}
		return false
	}
	if t.Kind == TYP_ARRAY {
		return NeedsDestruction(t.Elem)
	}
	return false
}
