package "pkg/types"

import "pkg/builtin/testing"

// Tests for the predicates and assignability rules in types_query.bn.
// Helpers `fail` and `streq` are defined in types_test.bn (sibling file).

// ============================================================
// Type Query Tests
// ============================================================

func TestIsInteger() testing.TestResult {
	if !TypInt().IsInteger() { return fail("int should be integer") }
	if !TypInt32().IsInteger() { return fail("int32 should be integer") }
	if !TypUint64().IsInteger() { return fail("uint64 should be integer") }
	if !TypUntypedInt().IsInteger() { return fail("untyped int should be integer") }
	if TypBool().IsInteger() { return fail("bool should not be integer") }
	return ""
}

func TestIsBool() testing.TestResult {
	if !TypBool().IsBool() { return fail("bool should be bool") }
	if !TypUntypedBool().IsBool() { return fail("untyped bool should be bool") }
	if TypInt().IsBool() { return fail("int should not be bool") }
	return ""
}

func TestIsPointer() testing.TestResult {
	if !MakePointerType(TypInt()).IsPointer() { return fail("*int should be pointer") }
	if !MakeManagedPtrType(TypInt()).IsPointer() { return fail("@int should be pointer") }
	if TypInt().IsPointer() { return fail("int should not be pointer") }
	return ""
}

func TestIsSlice() testing.TestResult {
	if !MakeSliceType(TypInt()).IsSlice() { return fail("*[]int should be slice") }
	if !MakeManagedSliceType(TypInt()).IsSlice() { return fail("@[]int should be slice") }
	if TypInt().IsSlice() { return fail("int should not be slice") }
	return ""
}

func TestIsNillable() testing.TestResult {
	if !MakePointerType(TypInt()).IsNillable() { return fail("*int should be nillable") }
	if !MakeManagedPtrType(TypInt()).IsNillable() { return fail("@int should be nillable") }
	if MakeSliceType(TypInt()).IsNillable() { return fail("*[]int should not be nillable") }
	if MakeManagedSliceType(TypInt()).IsNillable() { return fail("@[]int should not be nillable") }
	if TypInt().IsNillable() { return fail("int should not be nillable") }
	return ""
}

func TestSliceElem() testing.TestResult {
	var s @Type = MakeSliceType(TypInt())
	var e @Type = SliceElem(s)
	if !Identical(e, TypInt()) { return fail("slice elem wrong") }
	if !(SliceElem(TypInt()) == nil) { return fail("non-slice should return nil") }
	return ""
}

func TestPointerElem() testing.TestResult {
	var p @Type = MakePointerType(TypBool())
	var e @Type = PointerElem(p)
	if !Identical(e, TypBool()) { return fail("pointer elem wrong") }
	if !(PointerElem(TypInt()) == nil) { return fail("non-pointer should return nil") }
	return ""
}

func TestIdentical() testing.TestResult {
	if !Identical(TypInt(), TypInt()) { return fail("int == int") }
	if Identical(TypInt(), TypBool()) { return fail("int != bool") }
	if !Identical(MakePointerType(TypInt()), MakePointerType(TypInt())) { return fail("*int == *int") }
	if Identical(MakePointerType(TypInt()), MakePointerType(TypBool())) {
		return fail("*int != *bool")
	}
	if !Identical(MakeSliceType(TypInt()), MakeSliceType(TypInt())) { return fail("*[]int == *[]int") }
	if !Identical(MakeArrayType(TypInt(), 5), MakeArrayType(TypInt(), 5)) {
		return fail("[5]int == [5]int")
	}
	if Identical(MakeArrayType(TypInt(), 5), MakeArrayType(TypInt(), 10)) {
		return fail("[5]int != [10]int")
	}
	return ""
}

func TestIdenticalAnonymousStructs() testing.TestResult {
	// Same fields → identical
	var f1 @Field = make(Field)
	f1.Name = "X"
	f1.Type = TypInt()
	var f2 @Field = make(Field)
	f2.Name = "Y"
	f2.Type = TypBool()
	var fieldsA @[]@Field = make_slice(@Field, 2)
	fieldsA[0] = f1
	fieldsA[1] = f2
	var a @Type = MakeStructType("", fieldsA)

	var g1 @Field = make(Field)
	g1.Name = "X"
	g1.Type = TypInt()
	var g2 @Field = make(Field)
	g2.Name = "Y"
	g2.Type = TypBool()
	var fieldsB @[]@Field = make_slice(@Field, 2)
	fieldsB[0] = g1
	fieldsB[1] = g2
	var b @Type = MakeStructType("", fieldsB)

	if !Identical(a, b) { return fail("same anon structs should be identical") }

	// Different field names → not identical
	var h1 @Field = make(Field)
	h1.Name = "A"
	h1.Type = TypInt()
	var h2 @Field = make(Field)
	h2.Name = "B"
	h2.Type = TypBool()
	var fieldsC @[]@Field = make_slice(@Field, 2)
	fieldsC[0] = h1
	fieldsC[1] = h2
	var c @Type = MakeStructType("", fieldsC)
	if Identical(a, c) { return fail("different field names should not be identical") }

	// Named structs → not structurally equal
	var named1 @Type = MakeStructType("Foo", fieldsA)
	var named2 @Type = MakeStructType("Bar", fieldsB)
	if Identical(named1, named2) { return fail("different named structs should not be identical") }

	return ""
}

func TestAssignableTo() testing.TestResult {
	// Same types
	if !AssignableTo(TypInt(), TypInt()) { return fail("int to int") }
	// Untyped int to int
	if !AssignableTo(TypUntypedInt(), TypInt()) { return fail("untyped int to int") }
	if !AssignableTo(TypUntypedInt(), TypInt32()) { return fail("untyped int to int32") }
	// Untyped bool to bool
	if !AssignableTo(TypUntypedBool(), TypBool()) { return fail("untyped bool to bool") }
	// nil to pointer
	if !AssignableTo(TypNil(), MakePointerType(TypInt())) { return fail("nil to *int") }
	// nil to slice — NOT allowed
	if AssignableTo(TypNil(), MakeSliceType(TypInt())) { return fail("nil to *[]int should fail") }
	if AssignableTo(TypNil(), MakeManagedSliceType(TypInt())) {
		return fail("nil to @[]int should fail")
	}
	// Managed to raw pointer
	if !AssignableTo(MakeManagedPtrType(TypInt()), MakePointerType(TypInt())) {
		return fail("@int to *int")
	}
	// String literal natural type ([N]const char) → *[]char is rejected
	// (Stage 2a — mutable raw borrow of rodata is unsound). Use
	// *[]const char instead.
	var natStr @Type = MakeArrayType(MakeConstType(TypChar()), 5)
	if AssignableTo(natStr, MakeSliceType(TypChar())) {
		return fail("[5]const char to *[]char should NOT be assignable")
	}
	// [N]const char → *[]const char (zero-copy raw-slice borrow, allowed).
	if !AssignableTo(natStr, MakeSliceType(MakeConstType(TypChar()))) {
		return fail("[5]const char to *[]const char")
	}
	// [N]const char → @[]const char (zero-copy managed borrow, allowed).
	if !AssignableTo(natStr, MakeManagedSliceType(MakeConstType(TypChar()))) {
		return fail("[5]const char to @[]const char")
	}
	// [N]const char → @[]char (literal-init copy at codegen time, allowed).
	if !AssignableTo(natStr, MakeManagedSliceType(TypChar())) {
		return fail("[5]const char to @[]char")
	}
	// @[]T → *[]T (managed to raw slice).
	if !AssignableTo(MakeManagedSliceType(TypInt()), MakeSliceType(TypInt())) {
		return fail("@[]int to *[]int")
	}
	// Not assignable
	if AssignableTo(TypInt(), TypBool()) { return fail("int to bool should fail") }

	// Function reference → function-value type. Same signature: assignable.
	var fnParams @[]@Param = make_slice(@Param, 1)
	var fnP0 @Param = make(Param)
	fnP0.Type = TypInt()
	fnParams[0] = fnP0
	var fnResults @[]@Type = make_slice(@Type, 1)
	fnResults[0] = TypInt()
	var fn @Type = MakeFuncType(fnParams, fnResults)
	var fv @Type = MakeFuncValueType(fnParams, fnResults)
	if !AssignableTo(fn, fv) {
		return fail("func(int) int → *func(int) int (matching sig)")
	}
	var fvm @Type = MakeManagedFuncValueType(fnParams, fnResults)
	if !AssignableTo(fn, fvm) {
		return fail("func(int) int → @func(int) int")
	}
	// Mismatched signature: return type differs.
	var fvBoolResult @[]@Type = make_slice(@Type, 1)
	fvBoolResult[0] = TypBool()
	var fvMismatch @Type = MakeFuncValueType(fnParams, fvBoolResult)
	if AssignableTo(fn, fvMismatch) {
		return fail("func(int) int → *func(int) bool should fail")
	}
	// Mismatched signature: param count differs.
	var fnNoParams @[]@Param
	var fvDiffParams @Type = MakeFuncValueType(fnNoParams, fnResults)
	if AssignableTo(fn, fvDiffParams) {
		return fail("func(int) int → *func() int should fail")
	}
	return ""
}

func TestResolveAlias() testing.TestResult {
	var target @Type = TypInt()
	var alias @Type = MakeAliasType("MyInt", target)
	var resolved @Type = ResolveAlias(alias)
	if !Identical(resolved, target) { return fail("alias should resolve to target") }
	// Non-alias passthrough
	var plain @Type = TypBool()
	if !Identical(ResolveAlias(plain), plain) { return fail("non-alias should pass through") }
	return ""
}

func TestTypeName() testing.TestResult {
	if !streq(TypeName(TypInt()), "int") { return fail("int name") }
	if !streq(TypeName(TypBool()), "bool") { return fail("bool name") }
	if !streq(TypeName(MakePointerType(TypInt())), "*int") { return fail("*int name") }
	if !streq(TypeName(MakeManagedPtrType(TypInt())), "@int") { return fail("@int name") }
	if !streq(TypeName(MakeSliceType(TypInt())), "*[]int") { return fail("*[]int name") }
	if !streq(TypeName(nil), "nil") { return fail("nil name") }
	return ""
}
