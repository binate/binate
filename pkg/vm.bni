// Package vm implements a bytecode interpreter that executes IR-derived
// bytecode. Refcounting correctness is inherited from the compiler's IR gen.
package "pkg/vm"

import "pkg/ir"

// ============================================================
// Bytecode opcodes
// ============================================================

const (
	BC_NOP int = iota

	// Constants
	BC_LOAD_IMM       // Dst = Imm
	BC_LOAD_STR       // Dst = ptr to string constant (as managed-slice)
	BC_STRING_COPY_MS // Dst = fresh @[]char managed-slice copy of string Imm
	BC_STRING_COPY_ARR // Dst = ptr to fresh stack buffer of size Aux,
	                  //  zero-padded, with string Imm bytes copied in

	// Arithmetic
	BC_ADD             // Dst = Src1 + Src2
	BC_SUB             // Dst = Src1 - Src2
	BC_MUL             // Dst = Src1 * Src2
	BC_DIV             // Dst = Src1 / Src2 (signed)
	BC_UDIV            // Dst = Src1 / Src2 (unsigned)
	BC_REM             // Dst = Src1 % Src2 (signed)
	BC_UREM            // Dst = Src1 % Src2 (unsigned)

	// Floating-point arithmetic (float64; operands bit-cast through
	// int registers). float32 is narrowed/widened at memory boundaries
	// so arithmetic is always done at float64 precision.
	BC_FADD            // Dst = bit_cast(float64, Src1) + bit_cast(float64, Src2)
	BC_FSUB            // Dst = ...
	BC_FMUL            // Dst = ...
	BC_FDIV            // Dst = ...

	// Bitwise
	BC_AND             // Dst = Src1 & Src2
	BC_OR              // Dst = Src1 | Src2
	BC_XOR             // Dst = Src1 ^ Src2
	BC_SHL             // Dst = Src1 << Src2
	BC_SHR             // Dst = Src1 >> Src2 (arithmetic)
	BC_LSHR            // Dst = Src1 >> Src2 (logical)

	// Comparison (result is 0 or 1)
	BC_EQ              // Dst = Src1 == Src2
	BC_NE              // Dst = Src1 != Src2
	BC_SLT             // Dst = Src1 < Src2 (signed)
	BC_SLE             // Dst = Src1 <= Src2 (signed)
	BC_SGT             // Dst = Src1 > Src2 (signed)
	BC_SGE             // Dst = Src1 >= Src2 (signed)
	BC_ULT             // Dst = Src1 < Src2 (unsigned)
	BC_ULE             // Dst = Src1 <= Src2 (unsigned)
	BC_UGT             // Dst = Src1 > Src2 (unsigned)
	BC_UGE             // Dst = Src1 >= Src2 (unsigned)

	// Floating-point comparison (float64; ordered predicates — NaN → 0)
	BC_FEQ             // Dst = bit_cast(float64, Src1) == bit_cast(float64, Src2)
	BC_FNE             // Dst = ...
	BC_FLT             // Dst = ...
	BC_FLE             // Dst = ...
	BC_FGT             // Dst = ...
	BC_FGE             // Dst = ...

	// Unary
	BC_NEG             // Dst = -Src1
	BC_NOT             // Dst = !Src1 (logical)
	BC_BITNOT          // Dst = ~Src1
	BC_FNEG            // Dst = bit-cast of -bit_cast(float64, Src1)

	// Memory
	BC_STACK_ALLOC     // Dst = FrameBase + Imm (stack offset)
	BC_LOAD8           // Dst = *(uint8*)Src1 (zero-extended)
	BC_LOAD64          // Dst = *(int64*)Src1
	BC_STORE8          // *(uint8*)Src1 = (uint8)Src2
	BC_STORE64         // *(int64*)Src1 = Src2
	BC_MEMCPY          // memcpy(Src1, Src2, Imm)
	BC_MEMSET          // memset(Src1, 0, Imm)
	BC_FIELD_PTR       // Dst = Src1 + Imm (field byte offset)
	BC_ELEM_PTR        // Dst = Src1 + Src2 * Imm (element byte offset)

	// Control flow
	BC_JUMP            // PC = Aux
	BC_BRANCH          // if Src1 != 0: PC = Imm; else: PC = Aux
	BC_CALL            // Dst = call FuncID(args...) — Aux = func index
	BC_CALL_EXTERN     // Dst = call extern — Aux = extern index
	BC_CALL_INDIRECT   // Dst = call (fnIdx - 1)(args...). Src1 = reg
	                   //   holding 1-based VM function index, Src2 =
	                   //   callArgBase, Imm = arg count. fn_ptr in
	                   //   indirect-call IR maps to a VM function index.
	BC_RETURN          // return Src1 (or void if Dst == -1)
	BC_MOV             // Dst = Src1 (register copy, from phi resolution)

	// Managed memory
	BC_REFINC          // rt.RefInc(Src1) (call form, lowered from OP_REFCOUNT_INC)
	BC_REFINC_INLINE   // inline RefInc(Src1): nil-check + load/add/store
	                   // on the header at Src1-16. Lowered from OP_REFINC.
	BC_REFDEC          // rt.RefDec(Src1, Src2=dtor)
	BC_ALLOC           // Dst = rt.Alloc(Imm)
	BC_BOX             // Dst = rt.Box(Src1, Imm=size)
	BC_MAKE_SLICE      // Dst = rt.MakeManagedSlice(Imm=elemSize, Src1=length)
	BC_NIL_CHECK       // panic if Src1 == 0
	BC_BOUNDS_CHECK    // panic if Src1 < 0 || Src1 >= Src2
	BC_FUNC_ADDR       // Dst = address of function (for dtors)
	BC_FUNC_VALUE      // Dst = stack address of a fresh 16-byte
	                   //   {vtable_addr, closure_rec_addr} pair.
	                   //   Aux = name index in VMFunc.Names. The
	                   //   vtable + closure record are lazily
	                   //   allocated on first execution. See
	                   //   plan-function-values.md "VM-mode vtables".

	// Conversions
	BC_TRUNC8          // Dst = (uint8)Src1
	BC_SEXT            // Dst = sign-extend Src1 from Imm bits
	BC_ZEXT            // Dst = zero-extend Src1 from Imm bits
	BC_SITOF           // Dst = bit_cast(int, float64(cast(int, Src1)))
	BC_FTOSI           // Dst = int64 truncation of bit_cast(float64, Src1)
	BC_F32TOSI         // Dst = int64 truncation of float32 bits in low 4 bytes of Src1
	// Float-width conversions. VM registers carry IEEE bits in their
	// declared type's width — float32 in low 4 bytes (zero-extended),
	// float64 in 8 bytes — so a width change needs real conversion,
	// not a no-op move.
	BC_F64_TO_F32      // Dst = float32 IEEE bits (in low 4 bytes) of bit_cast(float64, Src1)
	BC_F32_TO_F64      // Dst = float64 bits of float32 in low 4 bytes of Src1

	// Struct
	BC_EXTRACT         // Dst = *(int64*)(Src1 + Imm*8) — extract field from aggregate

	BC_NUM_OPS
)

// ============================================================
// Bytecode instruction
// ============================================================

type BCInstr struct {
	Op   int     // opcode
	Dst  int     // destination register (-1 for void)
	Src1 int     // first source register
	Src2 int     // second source register
	Imm  int     // immediate value
	Aux  int     // auxiliary (jump target, func ID, name index, etc.)
}

// No managed fields in BCInstr — function/builtin names are stored
// in VMFunc.Names and referenced by index via Aux.

// ============================================================
// Compiled function
// ============================================================

type VMFunc struct {
	Name      @[]char
	Code      @[]BCInstr     // bytecode
	Names     @[]@[]char     // name table (for call/builtin targets)
	// Vtable / VMClosureRec: lazily-allocated 16-byte heap blocks
	// used when this function is taken as a function value. Both 0
	// until the first BC_FUNC_VALUE for this function executes.
	// Vtable layout: {dtor, call} — Phase 1 has dtor=0 and call=0
	// (placeholder); Phase 3 will fill `call` with a per-signature
	// trampoline (see explorations/plan-function-values.md "VM-mode
	// vtables — interop-compatible from Phase 1").
	// VMClosureRec layout: {vm_func_idx, captured_ctx} — Phase 1
	// always has captured_ctx=0; Phase 2 uses it for closures.
	Vtable        int
	VMClosureRec  int
	// CallCache: parallel to Names; per-call-site memoized result of
	// LookupFunc(vm, Names[i]).  -2 = unresolved (not yet looked up),
	// -1 = extern (not a VM function), >=0 = vm.Funcs index.  Filled
	// lazily on first execution of each call site.  A future REPL that
	// mutates vm.Funcs must invalidate this cache (full flush, or
	// targeted -1 reset on append; see notes-profiling-bni).
	CallCache @[]int
	Strings   @[]@[]char     // string constants (per-module, shared across
	                         // all VMFuncs lowered from the same module)
	NumRegs   int            // register slots needed
	FrameSize int            // stack frame size (bytes)
	NumParams int            // number of parameters
	NumResults int           // number of results
	// For multi-return: per-result byte sizes and offsets
	// in the packed anonymous result struct, plus a parallel
	// "is this a multi-word value" flag. The flag matters even
	// when size is 8 (e.g. struct{int}), because for any
	// multi-word type lowerLoad returns the alloca *pointer*
	// (not the bytes), so packing must MEMCPY through that
	// pointer instead of treating it as a scalar word.
	ResultSizes     @[]int
	ResultOffsets   @[]int
	ResultMultiWord @[]bool
}

// ============================================================
// VM state
// ============================================================

type VM struct {
	Funcs       @[]@VMFunc   // function table
	Stack       *uint8       // stack memory base
	StackSize   int          // total stack size
	SP          int          // current stack pointer
	Globals     *uint8       // global variable area
	GlobalsSize int          // globals area size
	Strings     @[]@[]char   // string constants (proper managed-slices)
}

// ============================================================
// Public API
// ============================================================

// NewVM creates a new VM with the given stack size.
func NewVM(stackSize int) @VM

// LowerModule converts an IR module to bytecode functions and adds them to the VM.
func LowerModule(vm @VM, m @ir.Module)

// LowerOneFunc lowers a single IR function to a VMFunc and appends
// it to vm.Funcs.  REPL entry point.  Caller must have AddFunc'd f
// into m and previously called LowerModule(vm, m).
func LowerOneFunc(vm @VM, m @ir.Module, f @ir.Func) @VMFunc

// CallFunc calls a function by name with the given arguments.
func CallFunc(vm @VM, name *[]const char, args @[]int) int

// CallByVMFunc executes a VMFunc directly, skipping LookupFunc.
// REPL entry point: invokes the synthetic __repl_n func returned by
// LowerOneFunc without a name lookup.
func CallByVMFunc(vm @VM, vmf @VMFunc, args @[]int) int

// LookupFunc returns the index of a function by name, or -1.
func LookupFunc(vm @VM, name *[]const char) int
