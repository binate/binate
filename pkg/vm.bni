// Package vm implements a bytecode interpreter that executes IR-derived
// bytecode. Refcounting correctness is inherited from the compiler's IR gen.
package "pkg/vm"

import "pkg/ir"

// ============================================================
// Bytecode opcodes
// ============================================================

const (
	BC_NOP int = iota

	// Constants
	BC_LOAD_IMM       // Dst = Imm
	BC_LOAD_STR       // Dst = ptr to string constant (as managed-slice)
	BC_STRING_COPY_MS // Dst = fresh @[]char managed-slice copy of string Imm
	BC_STRING_COPY_ARR // Dst = ptr to fresh stack buffer of size Aux,
	                  //  zero-padded, with string Imm bytes copied in

	// Arithmetic
	BC_ADD             // Dst = Src1 + Src2
	BC_SUB             // Dst = Src1 - Src2
	BC_MUL             // Dst = Src1 * Src2
	BC_DIV             // Dst = Src1 / Src2 (signed)
	BC_UDIV            // Dst = Src1 / Src2 (unsigned)
	BC_REM             // Dst = Src1 % Src2 (signed)
	BC_UREM            // Dst = Src1 % Src2 (unsigned)

	// Floating-point arithmetic (float64; operands bit-cast through
	// int registers). float32 is narrowed/widened at memory boundaries
	// so arithmetic is always done at float64 precision.
	BC_FADD            // Dst = bit_cast(float64, Src1) + bit_cast(float64, Src2)
	BC_FSUB            // Dst = ...
	BC_FMUL            // Dst = ...
	BC_FDIV            // Dst = ...

	// Bitwise
	BC_AND             // Dst = Src1 & Src2
	BC_OR              // Dst = Src1 | Src2
	BC_XOR             // Dst = Src1 ^ Src2
	BC_SHL             // Dst = Src1 << Src2
	BC_SHR             // Dst = Src1 >> Src2 (arithmetic)
	BC_LSHR            // Dst = Src1 >> Src2 (logical)

	// Comparison (result is 0 or 1)
	BC_EQ              // Dst = Src1 == Src2
	BC_NE              // Dst = Src1 != Src2
	BC_SLT             // Dst = Src1 < Src2 (signed)
	BC_SLE             // Dst = Src1 <= Src2 (signed)
	BC_SGT             // Dst = Src1 > Src2 (signed)
	BC_SGE             // Dst = Src1 >= Src2 (signed)
	BC_ULT             // Dst = Src1 < Src2 (unsigned)
	BC_ULE             // Dst = Src1 <= Src2 (unsigned)
	BC_UGT             // Dst = Src1 > Src2 (unsigned)
	BC_UGE             // Dst = Src1 >= Src2 (unsigned)

	// Floating-point comparison (float64; ordered predicates — NaN → 0)
	BC_FEQ             // Dst = bit_cast(float64, Src1) == bit_cast(float64, Src2)
	BC_FNE             // Dst = ...
	BC_FLT             // Dst = ...
	BC_FLE             // Dst = ...
	BC_FGT             // Dst = ...
	BC_FGE             // Dst = ...

	// Unary
	BC_NEG             // Dst = -Src1
	BC_NOT             // Dst = !Src1 (logical)
	BC_BITNOT          // Dst = ~Src1
	BC_FNEG            // Dst = bit-cast of -bit_cast(float64, Src1)

	// Memory
	BC_STACK_ALLOC     // Dst = FrameBase + Imm (stack offset)
	BC_LOAD8           // Dst = *(uint8*)Src1 (zero-extended)
	BC_LOAD64          // Dst = *(int64*)Src1
	BC_STORE8          // *(uint8*)Src1 = (uint8)Src2
	BC_STORE64         // *(int64*)Src1 = Src2
	BC_MEMCPY          // memcpy(Src1, Src2, Imm)
	BC_MEMSET          // memset(Src1, 0, Imm)
	BC_FIELD_PTR       // Dst = Src1 + Imm (field byte offset)
	BC_ELEM_PTR        // Dst = Src1 + Src2 * Imm (element byte offset)

	// Control flow
	BC_JUMP            // PC = Aux
	BC_BRANCH          // if Src1 != 0: PC = Imm; else: PC = Aux
	BC_CALL            // Dst = call FuncID(args...) — Aux = func index
	BC_CALL_EXTERN     // Dst = call extern — Aux = extern index
	BC_CALL_INDIRECT   // Dst = call (fnIdx - 1)(args...). Src1 = reg
	                   //   holding 1-based VM function index, Src2 =
	                   //   callArgBase, Imm = arg count. fn_ptr in
	                   //   indirect-call IR maps to a VM function index.
	BC_RETURN          // return Src1 (or void if Dst == -1)
	BC_RETURN64        // return the (Src1, Src1+1) pair — int64/uint64/
	                   // float64 single-return on a host whose word
	                   // is < 8 bytes (Layer 2 step 2b).
	BC_MOV             // Dst = Src1 (register copy, from phi resolution)

	// 64-bit (register-pair) ops — emitted only when REG_SLOT < 8 (a
	// host whose word can't hold a 64-bit value in one slot).  A
	// 64-bit operand/dest is a register pair: base slot = low 32
	// bits, base+1 = high 32 bits.  Handled by execOp64; the bit-math
	// uses splitInt64 / joinInt64.  See
	// explorations/plan-vm-64bit-on-32bit.md (Layer 2 step 3).
	BC_LOAD_IMM64      // (Dst, Dst+1) = (Imm:low, Aux:high)
	BC_MOV64           // (Dst, Dst+1) = (Src1, Src1+1); int64↔float64 bitcast
	// Casts between a single slot and a pair.  Widens read a single
	// slot; narrows write a single slot.
	BC_WIDEN64_S       // Dst-pair = sign-extend(regs[Src1])
	BC_WIDEN64_U       // Dst-pair = zero-extend(regs[Src1])
	BC_NARROW64        // regs[Dst] = Src1-pair's low slot
	// Unary 64-bit ops.
	BC_NEG64           // Dst-pair = -(Src1-pair)
	BC_BITNOT64        // Dst-pair = Src1-pair ^ -1
	// Pair memory ops: load/store 8 bytes (two 32-bit words) at the
	// host address in regs[Src1].  The existing BC_LOAD64/STORE64 use
	// *int indexing, which is one VM word — only 4 bytes on a 32-bit
	// host — so they cannot move a 64-bit value across memory there.
	// These variants index through *uint32 (always 4 bytes per
	// element) so they portably read/write 8 bytes as (lo, hi).
	BC_LOAD64_PAIR     // (Dst, Dst+1) = read 8 bytes at regs[Src1]
	BC_STORE64_PAIR    // write (Src2, Src2+1) pair as 8 bytes at regs[Src1]
	BC_ADD64           // Dst-pair = Src1-pair + Src2-pair
	BC_SUB64           // Dst-pair = Src1-pair - Src2-pair
	BC_MUL64           // Dst-pair = Src1-pair * Src2-pair
	BC_DIV64           // signed
	BC_UDIV64          // unsigned
	BC_REM64           // signed
	BC_UREM64          // unsigned
	BC_AND64
	BC_OR64
	BC_XOR64
	// Shifts: Src1 is a pair (the value); Src2 is read as a single
	// slot (the count's low word — counts are small).
	BC_SHL64
	BC_SHR64           // arithmetic (signed)
	BC_LSHR64          // logical (unsigned)
	// Compares read two pairs and write a 0/1 bool to Dst (one slot).
	BC_EQ64
	BC_NE64
	BC_SLT64
	BC_SLE64
	BC_SGT64
	BC_SGE64
	BC_ULT64
	BC_ULE64
	BC_UGT64
	BC_UGE64
	// Float64 register-pair ops: same pair pattern as the integer
	// BC_*64 family, but the joined int64 bits ride through float64
	// for the compute.  Unary, arithmetic, and ordered compares
	// (Dst is a single bool slot for the compares, a pair for the
	// rest).  Emitted only when REG_SLOT < 8 — on a 64-bit host,
	// float64 fits one slot and the existing BC_F* ops handle it.
	BC_FNEG64
	BC_FADD64
	BC_FSUB64
	BC_FMUL64
	BC_FDIV64
	BC_FEQ64
	BC_FNE64
	BC_FLT64
	BC_FLE64
	BC_FGT64
	BC_FGE64

	// Managed memory
	BC_REFINC_INLINE   // inline RefInc(Src1): nil-check + load/add/store
	                   // on the header at Src1-16. Lowered from OP_REFINC.
	BC_REFDEC_INLINE_FAST // inline RefDec(Src1, Src2=dtor): nil-check +
	                   // load/sub/store on header at Src1-16. On zero,
	                   // calls rt.Free (no-dtor case) or dispatches the
	                   // dtor iteratively. Lowered from OP_REFDEC.
	BC_ALLOC           // Dst = rt.Alloc(Imm)
	BC_BOX             // Dst = rt.Box(Src1, Imm=size)
	BC_MAKE_SLICE      // Dst = rt.MakeManagedSlice(Imm=elemSize, Src1=length)
	BC_NIL_CHECK       // panic if Src1 == 0
	BC_BOUNDS_CHECK    // panic if Src1 < 0 || Src1 >= Src2
	BC_FUNC_HANDLE     // Dst = *uint8 pointing at a 16-byte
	                   //   {vtable_ptr, data_ptr} handle.  Sourced
	                   //   from the executing vm's Externs registry
	                   //   (binding.HandleAddr — a managed copy of
	                   //   the registrant's handle) when the function
	                   //   is registered, or lazily heap-allocated on
	                   //   the VMFunc's Handle field for vm-local-only
	                   //   functions.  See plan-uniform-native-fnptrs.md
	                   //   Phase 4.
	BC_FUNC_VALUE      // Dst = stack address of a fresh 16-byte
	                   //   {vtable_addr, closure_rec_addr} pair.
	                   //   Aux = name index in VMFunc.Names. The
	                   //   vtable + closure record are lazily
	                   //   allocated on first execution. See
	                   //   plan-function-values.md "VM-mode vtables".
	BC_CALL_FUNC_VALUE // Dst = call f(args). Src1 = register holding
	                   //   the function value's stack address (16-byte
	                   //   {vtable_addr, closure_rec_addr}). Src2 =
	                   //   callArgBase. Imm = arg count. Within-VM
	                   //   dispatch short-circuits the trampoline:
	                   //   reads closure_rec[0] (vm_func_idx) directly
	                   //   and execFuncs into the VM. See plan-function-
	                   //   values.md "VM-mode vtables — Phase 1".
	BC_IFACE_VALUE     // Dst = stack address of a fresh 16-byte
	                   //   {data_ptr, vtable_addr} interface value.
	                   //   Src1 = register holding the data pointer
	                   //   (the source's *T / @T cast through int).
	                   //   Aux = name index for the vtable identifier
	                   //   (e.g., "<recvType>.<iface>"); the VM
	                   //   lazily allocates a vtable record holding
	                   //   the impl method's VM function indices on
	                   //   first execution. Slice 2.3c of plan-
	                   //   interface-syntax-revision.md.
	BC_CALL_IFACE_METHOD // Dst = result of iv.method(args). Src1 =
	                   //   register holding the interface value's
	                   //   stack address. Src2 = callArgBase. Imm =
	                   //   arg count. Aux = method index (slot in the
	                   //   interface's method-declaration order).
	                   //   Reads (data_ptr, vtable_addr) from the iv
	                   //   slot, indexes into the vtable, and calls
	                   //   the impl method via execFunc with data_ptr
	                   //   prepended to the user args.
	BC_IFACE_DTOR      // Dst = vt.Methods[0] (the receiver type's
	                   //   dtor as a 1-based VM func index, or 0 if
	                   //   the type has no dtor). Src1 = register
	                   //   holding the interface value's stack
	                   //   address; the handler reads iv[1] as the
	                   //   vtable index. Used by @Iface scope-exit
	                   //   cleanup — the int feeds straight into
	                   //   BC_REFDEC_INLINE_FAST's Src2 dtor slot.
	                   //   Slice 2.5b of plan-interface-syntax-
	                   //   revision.md.
	BC_IFACE_UPCAST    // Dst = stack address of a fresh iv with
	                   //   the same data ptr as Src1's iv and a
	                   //   vtable swapped to the target interface's
	                   //   (R, target) vtable.  Src1 = register
	                   //   holding the source iv's stack address.
	                   //   Aux = name index for the combined
	                   //   `<src_iface_pkg>__<src_iface_name>|<tgt_iface_pkg>__<tgt_iface_name>`
	                   //   suffixes.  Handler reads the source
	                   //   vtable's mangled name, swaps the iface
	                   //   suffix to the target's, looks the result
	                   //   up in vm.IfaceVtables.  Slice E.4 part
	                   //   2b of plan-interface-embedding.md.

	// Conversions
	BC_TRUNC8          // Dst = (uint8)Src1 (zero-fills upper bits)
	BC_TRUNC32         // Dst = (uint32)Src1 (zero-fills upper bits)
	BC_SEXT            // Dst = sign-extend Src1 from Imm bits
	BC_ZEXT            // Dst = zero-extend Src1 from Imm bits
	BC_SITOF           // Dst = bit_cast(int, float64(cast(int, Src1)))
	BC_FTOSI           // Dst = int64 truncation of bit_cast(float64, Src1)
	BC_F32TOSI         // Dst = int64 truncation of float32 bits in low 4 bytes of Src1
	// Float-width conversions. VM registers carry IEEE bits in their
	// declared type's width — float32 in low 4 bytes (zero-extended),
	// float64 in 8 bytes — so a width change needs real conversion,
	// not a no-op move.
	BC_F64_TO_F32      // Dst = float32 IEEE bits (in low 4 bytes) of bit_cast(float64, Src1)
	BC_F32_TO_F64      // Dst = float64 bits of float32 in low 4 bytes of Src1

	// Struct
	BC_EXTRACT         // Dst = *(int64*)(Src1 + Imm*8) — extract field from aggregate

	// Lifetime
	BC_SP_RESTORE      // vm.SP = frameStart + frame.totalSize.
	                   //   No operands. Lowered from OP_SP_RESTORE.
	                   //   Reclaims vm.Stack temporaries pushed during
	                   //   the just-ended statement (aggregate return
	                   //   copy-backs, BC_MAKE_SLICE / BC_STRING_COPY*
	                   //   / BC_FUNC_VALUE pushes). IR-gen emits at
	                   //   end-of-statement only when the statement
	                   //   contains a vm.SP-growing op, so scalar-only
	                   //   statements pay no per-iteration cost.

	BC_NUM_OPS
)

// ============================================================
// Bytecode instruction
// ============================================================

type BCInstr struct {
	Op   int     // opcode
	Dst  int     // destination register (-1 for void)
	Src1 int     // first source register
	Src2 int     // second source register
	Imm  int     // immediate value
	Aux  int     // auxiliary (jump target, func ID, name index, etc.)
}

// No managed fields in BCInstr — function/builtin names are stored
// in VMFunc.Names and referenced by index via Aux.

// ============================================================
// Compiled function
// ============================================================

// VMFuncVtable is the heap-allocated function-value vtable for a
// VMFunc taken as a function value.  Field layout matches the
// statically-emitted vtable bnc produces for compiled functions:
//   - Dtor: 0 for non-capturing; will hold a destructor func ptr
//     for capturing closures (Phase 2 of plan-function-values).
//   - Call: the per-function shim address (compiled native fn)
//     OR a universal trampoline address (TrampolineScalar /
//     TrampolineAggregate) when constructed by BC_FUNC_VALUE
//     Path B for a bytecode-only function.
// Heap-allocated and referenced from a VMFunc managed field so
// its lifetime ties to the VMFunc — no leak on VMFunc death.
type VMFuncVtable struct {
	Dtor int
	Call int
}

// VMFuncHandle is the heap-allocated {vtable_ptr, data_ptr} block
// returned by BC_FUNC_HANDLE for bytecode-only functions.  Layout
// matches the static `@__handle.F` symbol bnc emits for natively-
// compiled functions, so consumers (`_call_free_fn` / `_call_dtor`
// via OP_CALL_HANDLE) dispatch uniformly through both kinds.
// Heap-allocated and referenced from a VMFunc managed field so its
// lifetime ties to the VMFunc.
type VMFuncHandle struct {
	VtableAddr int
	DataAddr   int
}

// VMClosureRec is the heap-allocated closure record carried by a
// VMFunc-derived function value.  The universal trampolines
// (TrampolineScalar / TrampolineAggregate) read it as their
// `data` argument and dispatch via `execFunc(Vm, FnIdx-1, args)`.
//   - Kind: discriminates VM closure records from other
//     compiler-emitted closure data shapes; always set to
//     `rt.DATA_KIND_VM_CLOSURE_REC`.
//   - Vm:   `bit_cast(int, @VM)` — the VM to dispatch into.
//   - FnIdx: 1-based function index in `Vm.Funcs`.  0 reserved.
//   - Captured: captured-context pointer for closures (Phase 2);
//     0 in Phase 1.
// Heap-allocated and referenced from a VMFunc managed field so
// its lifetime ties to the VMFunc — no leak on VMFunc death.
type VMClosureRec struct {
	Kind     int
	Vm       int
	FnIdx    int
	Captured int
}

type VMFunc struct {
	Name      @[]char
	Code      @[]BCInstr     // bytecode
	Names     @[]@[]char     // name table (for call/builtin targets)
	// Vtable / ClosureRec / Handle: lazily-allocated heap blocks
	// used when this function is taken as a function value.  All
	// nil until the first BC_FUNC_VALUE / BC_FUNC_HANDLE executes.
	// Managed so VMFunc's auto-emitted dtor refdecs them on death.
	// Handle is the {VtableAddr=&Vtable, DataAddr=&ClosureRec} pair
	// that BC_FUNC_HANDLE returns the address of for a vm-local
	// function — matches the static `@__handle.F` shape so dispatch
	// is uniform across natively-compiled and bytecode-only
	// functions.  Phase 4 of plan-uniform-native-fnptrs.md.
	Vtable     @VMFuncVtable
	ClosureRec @VMClosureRec
	Handle     @VMFuncHandle
	// CallCache: parallel to Names; per-call-site memoized result of
	// LookupFunc(vm, Names[i]).  -2 = unresolved (not yet looked up),
	// -1 = extern (not a VM function), >=0 = vm.Funcs index.  Filled
	// lazily on first execution of each call site.  A future REPL that
	// mutates vm.Funcs must invalidate this cache (full flush, or
	// targeted -1 reset on append; see notes-profiling-bni).
	CallCache @[]int
	Strings   @[]@[]char     // string constants (per-module, shared across
	                         // all VMFuncs lowered from the same module)
	NumRegs   int            // register slots needed
	FrameSize int            // stack frame size (bytes)
	NumParams int            // number of parameters
	// NumParamSlots is the number of register slots the parameters
	// occupy.  On a 64-bit host it equals NumParams (one slot per
	// param); on a host whose word is < 8 bytes, an int64/uint64/
	// float64 param occupies a register pair, so the slot count can
	// exceed the param count.  Set by lower_func from
	// argSlots(p.Typ).
	NumParamSlots int
	NumResults int           // number of results
	// For multi-return: per-result byte sizes and offsets
	// in the packed anonymous result struct, plus a parallel
	// "is this a multi-word value" flag. The flag matters even
	// when size is 8 (e.g. struct{int}), because for any
	// multi-word type lowerLoad returns the alloca *pointer*
	// (not the bytes), so packing must MEMCPY through that
	// pointer instead of treating it as a scalar word.
	ResultSizes     @[]int
	ResultOffsets   @[]int
	ResultMultiWord @[]bool

	// IsClosure / NumCaptureParams / CaptureOffsets back the B.2
	// capturing-literal path (plan-function-values-phase-2.md).
	// IsClosure=true marks the VMFunc as a capturing function
	// literal whose first NumCaptureParams params are captures
	// (prepended at IR-gen time).  CaptureOffsets is the byte
	// offset of each capture inside the closure struct laid out at
	// the construction site — the BC_CALL_FUNC_VALUE
	// DATA_KIND_COMPILED_CLOSURE branch uses these to copy capture
	// values from the struct into the callee's leading regs before
	// the user args.  Empty for non-closure VMFuncs.
	IsClosure        bool
	NumCaptureParams int
	CaptureOffsets   @[]int
}

// ============================================================
// VM state
// ============================================================

type VM struct {
	Funcs       @[]@VMFunc   // function table
	Stack       *uint8       // stack memory base
	StackSize   int          // total stack size
	SP          int          // current stack pointer
	Globals     *uint8       // global variable area
	GlobalsSize int          // globals area size
	Strings     @[]@[]char   // string constants (proper managed-slices)

	// Name → vm.Funcs idx hash (open-addressing, linear probing).
	// Kept in sync by LowerModule / LowerOneFunc.  Used by
	// LookupFunc for O(1) callee resolution; also enables eager
	// CallCache fill at lowering time, which is the substrate the
	// Tier 4 shadow path needs (per-call-site resolution must be
	// frozen at lowering time so an old caller keeps its old
	// callee even after a same-named func gets shadowed).
	//
	// Capacity is always a power of two so `& IndexMask` replaces
	// modulo.  IndexBuckets is lazy-initialized on first insert.
	IndexBuckets @[]FuncIndexEntry
	IndexCount   int   // populated entries
	IndexMask    int   // capacity - 1; 0 before lazy init

	// Externs registry: name → {vtable, data} of a compiled-side
	// function value.  When BC_CALL fails to resolve a name in
	// vm.Funcs, execExtern checks this registry; if found, it
	// dispatches via the always-shim convention through
	// rt._call_shim_scalar — the same path bytecode-side function-
	// value calls take in dispatchCompiledFuncValue.  Registration
	// happens once at VM init via RegisterExtern; the legacy hand-
	// coded execExtern switch remains for residual cases (multi-
	// word returns, refcount-surgical bootstrap.Args / ReadDir).
	Externs @[]ExternBinding

	// IfaceVtables: per-(impl, interface) vtable records. Each
	// entry is a heap-allocated array of 1-based VM function
	// indices in the interface's method-declaration order. Set up
	// by LowerModule from m.Impls. BC_IFACE_VALUE references a
	// vtable by index into this slice (the index is encoded as
	// Aux on the bytecode instruction). BC_CALL_IFACE_METHOD reads
	// the vtable address from the iv slot and indexes into it at
	// the method slot to recover the VM function index. See plan-
	// interface-syntax-revision.md (Slice 2.3c).
	IfaceVtables @[]@IfaceVtable
}

// IfaceVtable holds the runtime-resolved VM function indices for a
// single (impl, interface) pair. The Methods slice is in the
// interface's method-declaration order; each entry is a 1-based
// VM function index (0 = not found, treated as a fatal at dispatch
// time). Name is the mangled `__ivt.<...>` form used by IR-gen so
// VM lower can find a vtable by name when lowering OP_IFACE_VALUE.
type IfaceVtable struct {
	Name    @[]char
	Methods @[]int
}

// FuncIndexEntry: one slot in the VM's name→idx hash.  An empty
// slot has Name == nil (or len(Name) == 0).
type FuncIndexEntry struct {
	Name @[]char
	Idx  int
}

// ExternBinding: name → compiled-side function value, populated by
// RegisterExtern.  The 16-byte function value's two words are stored
// inline so the binding owns its own copy (the user's source fv may
// be a stack local — copying decouples its lifetime from the VM's).
// VtableAddr's `call` slot is the per-function shim; DataAddr is
// null for non-capturing function refs.
//
// ResultSize encodes the return-type shape:
//   - 0 (void) or ≤ 8 bytes (scalar/pointer): scalar dispatch via
//     rt._call_shim_scalar — vtable.call is `<ret>(i8*, args...)*`.
//   - > 8 bytes (aggregate: slice / managed-slice / multi-word
//     struct): aggregate dispatch via rt._call_shim_aggregate —
//     vtable.call is `void(i8* retbuf, i8* data, args...)*` and
//     dispatchExternBinding allocates retbuf of ResultSize bytes
//     before calling.
type ExternBinding struct {
	Name       @[]char
	VtableAddr int
	DataAddr   int
	ResultSize int
	// HandleAddr is the binding's owned copy of the registered
	// function's 16-byte {VtableAddr, DataAddr} function-value
	// handle.  Populated by RegisterExtern from the caller's
	// `_func_handle(F)` argument (which may be a static
	// `@__handle.F` global in native or a heap allocation on
	// VMFunc.Handle in bytecode); RegisterExtern copies the two
	// words into a fresh managed allocation so the binding's
	// lifetime is independent of the caller's source.
	// BC_FUNC_HANDLE casts this managed pointer to int and returns
	// it — the resulting *uint8 points at a uniformly-shaped handle
	// across all vm-nesting depths.  nil if the registrant didn't
	// supply one (e.g. legacy tests).
	HandleAddr @VMFuncHandle
}

// ============================================================
// Public API
// ============================================================

// NewVM creates a new VM with the given stack size.
func NewVM(stackSize int) @VM

// TrampolineScalar is the cross-mode dispatch trampoline for VM-side
// function values with scalar return. Compiled code reaches it
// through vtable.call after constructing or receiving a VM-side
// function value. Reads the VMClosureRec from `data` (which carries
// both the VM handle and the vm_func_idx), packs the user args into
// argv, and calls execFunc on that VM. The fixed 7-arg shape is
// intentional — see plan-function-values-phase-3.md (Slice 3.2).
// Not normally called directly; BC_FUNC_VALUE wires its address into
// vtable.call.
func TrampolineScalar(data *uint8,
		a0 int, a1 int, a2 int, a3 int,
		a4 int, a5 int, a6 int) int

// TrampolineAggregate is the aggregate-return counterpart of
// TrampolineScalar — vtable.call slot for VM-side function values
// whose return type is multi-word (slice / managed-slice / multi-
// word struct).  Convention matches the aggregate-shim shape:
// caller allocates retbuf, trampoline dispatches into the bytecode
// VMFunc and memcpys ResultSizes[0] bytes from execFunc's returned
// address into retbuf.  See pkg/vm/vm.bn for the body.
func TrampolineAggregate(retbuf *uint8, data *uint8,
		a0 int, a1 int, a2 int, a3 int,
		a4 int, a5 int, a6 int)

// LowerModule converts an IR module to bytecode functions and adds them to the VM.
func (vm @VM) LowerModule(m @ir.Module)

// LowerOneFunc lowers a single IR function to a VMFunc and appends
// it to vm.Funcs.  REPL entry point.  Caller must have AddFunc'd f
// into m and previously called LowerModule(vm, m).
func (vm @VM) LowerOneFunc(m @ir.Module, f @ir.Func) @VMFunc

// LowerOneFuncShadow lowers a single IR function to a VMFunc and
// always APPENDS to vm.Funcs (never replaces).  REPL entry point
// for Tier 4 shadow path: incompatible-signature redefinition
// keeps the OLD VMFunc reachable at its existing idx for any
// caller whose CallCache already resolved that callee.  The
// funcIndex is re-pointed to the new idx so fresh lowerings
// resolve to the new VMFunc.
func (vm @VM) LowerOneFuncShadow(m @ir.Module, f @ir.Func) @VMFunc

// MaterializeOneGlobal allocates storage for a single newly-declared
// global and appends it to the VM's per-name global tables.  REPL
// entry point for `var` decls typed at the prompt.  Storage is
// zero-initialized; like the file-load path, declared initializers
// are not applied (the user can assign in a follow-up prompt entry).
func MaterializeOneGlobal(g @ir.Global)

// CallFunc calls a function by name with the given arguments.
func (vm @VM) CallFunc(name *[]const char, args @[]int) int

// CallByVMFunc executes a VMFunc directly, skipping LookupFunc.
// REPL entry point: invokes the synthetic __repl_n func returned by
// LowerOneFunc without a name lookup.
func (vm @VM) CallByVMFunc(vmf @VMFunc, args @[]int) int

// LookupFunc returns the index of a function by name, or -1.
func (vm @VM) LookupFunc(name *[]const char) int

// RegisterExtern binds a name to a compiled-side function value.
// fvAddr must point at a 16-byte {vtable, data} struct (a Phase-1
// non-capturing function value, typically obtained via
// `var fv *func(...) ... = someFunc; bit_cast(*uint8, &fv)`).
// The 16 bytes are copied into the binding so the user's source
// fv may go out of scope after registration.  Re-registering an
// existing name overwrites it.
//
// resultSize tells dispatchExternBinding which shim convention to
// use.  Pass 0 for void return; 8 (or any ≤ 8) for scalar/pointer;
// > 8 for aggregate returns (slices, managed-slices, multi-word
// structs).  The aggregate path allocates a retbuf of resultSize
// bytes on vm.Stack before calling rt._call_shim_aggregate.
//
// At BC_CALL time, when LookupFunc returns no VM function, the
// registry is consulted.  Hits dispatch through the appropriate
// shim convention (scalar via rt._call_shim_scalar, aggregate via
// rt._call_shim_aggregate) — same path as dispatchCompiledFuncValue.
func (vm @VM) RegisterExtern(name *[]const char, fvAddr *uint8,
	resultSize int, rawFnAddr int)

// LookupExtern returns the index of a registered extern by name,
// or -1.  Diagnostic / wired into execExtern's dispatcher.
func (vm @VM) LookupExtern(name *[]const char) int

// RegisterStandardExterns binds the standard host-package functions
// (pkg/rt, pkg/libc, simple pkg/bootstrap) into vm's extern registry
// — the scalar-return / pointer-arg signatures that the always-shim
// convention can dispatch.  Living here (rather than each consumer
// rolling its own list) keeps registrations consistent across
// cmd/bni's runtime VM and pkg/vm's unit-test VMs.  See
// pkg/vm/extern_register_std.bn for the binding list and exclusions.
func RegisterStandardExterns(vmInst @VM)
