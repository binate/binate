package "pkg/vm"

import "pkg/rt"

// scalarResult is the conventional ResultSize for scalar/pointer/void
// returns — the dispatcher's ≤ 8 branch.  Aggregate (multi-word)
// returns pass their byte size explicitly: 32 for managed-slice
// (rt.MakeManagedSlice, bootstrap.Args / ReadDir results), 16 for raw
// slice or function value, etc.
const scalarResult int = 8

// RegisterStandardExterns binds the host-package functions that
// pkg/vm itself can route through the registry — those whose targets
// have a Binate-side `.bn` body (pkg/rt's runtime), so the Phase-1
// OP_FUNC_VALUE construction can resolve them via LookupFunc.
//
// Pure C externs (pkg/libc.* and the C-shaped pkg/bootstrap.*
// surface — Close, Exit, Open, Read, Write, Stat, Args, ReadDir,
// Exec) are NOT registered here: their function values can only be
// constructed in NATIVE code (compiled cmd/bni main), not in
// bytecode — BC_FUNC_VALUE requires the target to exist as a
// VMFunc, and these have no `.bn` body.  Native call sites
// (cmd/bni's `registerStandardExterns`) layer the
// pure-extern registrations on top of this helper.
//
// NOT registered at any layer (still hand-coded in vm_extern.bn):
//   - bootstrap.Open / Read / Write / Stat / Exec — slice/multi-word
//     args (the scalar shim's int-args shape can't unpack them).
//   - bootstrap.Args / ReadDir — multi-word aggregate returns BUT
//     also do RefInc-surgery; migration to the aggregate-shim path
//     is tracked under the rt.MakeManagedSlice work as it makes the
//     surgery unnecessary (the shim's SSA value has no scope-cleanup
//     RefDec, so the +1 from the native call flows cleanly to the
//     bytecode caller's local).
func RegisterStandardExterns(vmInst @VM) {
	registerRtExterns(vmInst)
}

// registerRtExterns binds pkg/rt's bytecode-friendly surface into
// the registry.  All entries here have a Binate `.bn` body, so
// BC_FUNC_VALUE construction succeeds in either native or bytecode
// dispatch context.
func registerRtExterns(vmInst @VM) {
	var rtAlloc *func(int) *uint8 = rt.Alloc
	RegisterExtern(vmInst, "rt.Alloc",
		bit_cast(*uint8, &rtAlloc), scalarResult)
	var rtFree *func(*uint8) = rt.Free
	RegisterExtern(vmInst, "rt.Free",
		bit_cast(*uint8, &rtFree), scalarResult)
	var rtRefInc *func(*uint8) = rt.RefInc
	RegisterExtern(vmInst, "rt.RefInc",
		bit_cast(*uint8, &rtRefInc), scalarResult)
	var rtRefDec *func(*uint8, *uint8) = rt.RefDec
	RegisterExtern(vmInst, "rt.RefDec",
		bit_cast(*uint8, &rtRefDec), scalarResult)
	var rtRefcount *func(*uint8) int = rt.Refcount
	RegisterExtern(vmInst, "rt.Refcount",
		bit_cast(*uint8, &rtRefcount), scalarResult)
	var rtBoundsCheck *func(int, int) = rt.BoundsCheck
	RegisterExtern(vmInst, "rt.BoundsCheck",
		bit_cast(*uint8, &rtBoundsCheck), scalarResult)
	var rtBox *func(*uint8, int) *uint8 = rt.Box
	RegisterExtern(vmInst, "rt.Box",
		bit_cast(*uint8, &rtBox), scalarResult)
	var rtRawAlloc *func(int) *uint8 = rt.RawAlloc
	RegisterExtern(vmInst, "rt.RawAlloc",
		bit_cast(*uint8, &rtRawAlloc), scalarResult)
	var rtRawAllocZero *func(int) *uint8 = rt.RawAllocZero
	RegisterExtern(vmInst, "rt.RawAllocZero",
		bit_cast(*uint8, &rtRawAllocZero), scalarResult)
	var rtRawFree *func(*uint8) = rt.RawFree
	RegisterExtern(vmInst, "rt.RawFree",
		bit_cast(*uint8, &rtRawFree), scalarResult)
	var rtMemZero *func(*uint8, int) = rt.MemZero
	RegisterExtern(vmInst, "rt.MemZero",
		bit_cast(*uint8, &rtMemZero), scalarResult)
	var rtMemCopy *func(*uint8, *const uint8, int) = rt.MemCopy
	RegisterExtern(vmInst, "rt.MemCopy",
		bit_cast(*uint8, &rtMemCopy), scalarResult)
	var rtBoundsFail *func(int, int) = rt.BoundsFail
	RegisterExtern(vmInst, "rt.BoundsFail",
		bit_cast(*uint8, &rtBoundsFail), scalarResult)

	// rt.MakeManagedSlice (aggregate-return) is intentionally NOT
	// registered here.  In cmd/bni's actual runtime, pkg/rt is
	// loaded as bytecode, so BC_CALL "rt.MakeManagedSlice" resolves
	// directly (LookupFunc finds it) and never reaches the
	// registry.  In bytecode-test mode (compileAndRun), BC_FUNC_VALUE
	// on rt.MakeManagedSlice would build a function value pointing
	// at vm.TrampolineScalar — which can't handle aggregate returns.
	// Migrating it would need TrampolineAggregate (per
	// plan-function-values-phase-3.md, Slice 3.2's deferred
	// per-return-shape work).  The hand-coded arm in vm_extern.bn
	// remains as the fallback for any path that does reach the
	// registry-less extern dispatch.
}
