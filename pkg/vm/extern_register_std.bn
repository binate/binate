package "pkg/vm"

import "pkg/bootstrap"
import "pkg/libc"
import "pkg/rt"

// scalarResult is the conventional ResultSize for scalar/pointer/void
// returns — the dispatcher's ≤ 8 branch.  Aggregate (multi-word)
// returns pass their byte size explicitly: 32 for managed-slice
// (rt.MakeManagedSlice, bootstrap.Args / ReadDir results), 16 for raw
// slice or function value, etc.
const scalarResult int = 8

// RegisterStandardExterns binds the host-package functions every
// pkg/vm-using host needs: pkg/rt's runtime, pkg/libc's pure-C
// surface, and pkg/bootstrap's C-shaped surface (including the
// slice-arg / aggregate-return entries that flow through the
// registry via emit_funcvals.bn's aggregate-arg + sret-aware
// shim machinery).
//
// BC_FUNC_VALUE construction on every name here works in either
// native or bytecode dispatch contexts because execFuncRefOp's
// registry-fallback (vm_exec_funcref.bn) consults vm.Externs on
// LookupFunc miss.
//
// cmd/bni's main may layer further registrations (e.g.,
// progArgsAfterDash overriding bootstrap.Args).
func RegisterStandardExterns(vmInst @VM) {
	registerRtExterns(vmInst)
	registerLibcExterns(vmInst)
	registerBootstrapExterns(vmInst)
	registerVmTrampolines(vmInst)
}

// registerVmTrampolines binds the universal cross-mode dispatch
// trampolines (TrampolineScalar / TrampolineAggregate) into the
// registry.  Their `vtable.call` slot needs to hold the
// trampoline's NATIVE FUNCTION address — NOT its per-function
// shim — because the shim convention strips the implicit `data`
// parameter before calling the underlying function (correct for
// ordinary captured closures, but the trampolines need `data` as
// their closure-record argument; stripping it routes the user's
// first arg into the slot the trampoline expects the closure
// record at).  See `explorations/plan-uniform-native-fnptrs.md`.
//
// Two paths to populate the binding correctly depending on
// whether registerVmTrampolines runs natively or as bytecode:
//
//   (a) Native — `_raw_func_addr` resolves to the function
//       symbol; we hand-build the binding directly with that
//       address.
//   (b) Bytecode — `_raw_func_addr` lowers to BC_FUNC_ADDR which
//       returns a 1-based vm idx (wrong), so we instead use the
//       standard `var ts *func(...) = TrampolineScalar;
//       RegisterExtern(...)` form.  At bytecode level that goes
//       through BC_FUNC_VALUE's Path B, which reads the
//       executing vm's Externs registry — already populated by
//       the outermost native startup via (a).  Net effect: the
//       same native address propagates downward via the standard
//       Externs-copy mechanism libc.* uses.
//
// We dispatch on the magnitude of `_raw_func_addr` — real code-
// segment addresses are way above any plausible vm.Funcs index,
// so the test cleanly separates the two cases.  Native is the
// case that needs the hand-built override; bytecode skips that
// step and relies on the standard registration's Path B output.
func registerVmTrampolines(vmInst @VM) {
	// Path (b) — bytecode-safe registration that Path B reads
	// through.  Also runs at native, where it puts a shim-based
	// binding in place that the subsequent override below fixes.
	var ts *func(*uint8, int, int, int, int, int, int, int) int =
		TrampolineScalar
	vmInst.RegisterExtern("vm.TrampolineScalar",
		bit_cast(*uint8, &ts), scalarResult,
		bit_cast(int, _raw_func_addr(TrampolineScalar)))
	var ta *func(*uint8, *uint8,
		int, int, int, int, int, int, int) = TrampolineAggregate
	vmInst.RegisterExtern("vm.TrampolineAggregate",
		bit_cast(*uint8, &ta), scalarResult,
		bit_cast(int, _raw_func_addr(TrampolineAggregate)))

	// Phase 4 removed the hand-built override that was needed
	// before bnc started emitting __vt.<trampoline>.call directly
	// at the function symbol (bypassing __shim) — see
	// isUniversalTrampoline in pkg/codegen/emit_funcvals.bn.  The
	// standard registration above now produces a correct binding
	// whose vtable.call slot is &TrampolineScalar / &TrampolineAggregate
	// (the actual functions, NOT __shim.* which would strip the
	// data argument the trampolines need as their closure record).
}

// registerRtExterns binds pkg/rt's bytecode-friendly surface into
// the registry.  All entries here have a Binate `.bn` body, so
// BC_FUNC_VALUE construction succeeds in either native or bytecode
// dispatch context.
func registerRtExterns(vmInst @VM) {
	var rtAlloc *func(int) *uint8 = rt.Alloc
	vmInst.RegisterExtern("rt.Alloc", bit_cast(*uint8, &rtAlloc),
		scalarResult, bit_cast(int, _raw_func_addr(rt.Alloc)))
	var rtFree *func(*uint8) = rt.Free
	vmInst.RegisterExtern("rt.Free", bit_cast(*uint8, &rtFree),
		scalarResult, bit_cast(int, _raw_func_addr(rt.Free)))
	var rtRefInc *func(*uint8) = rt.RefInc
	vmInst.RegisterExtern("rt.RefInc", bit_cast(*uint8, &rtRefInc),
		scalarResult, bit_cast(int, _raw_func_addr(rt.RefInc)))
	var rtRefDec *func(*uint8, *uint8) = rt.RefDec
	vmInst.RegisterExtern("rt.RefDec", bit_cast(*uint8, &rtRefDec),
		scalarResult, bit_cast(int, _raw_func_addr(rt.RefDec)))
	var rtRefcount *func(*uint8) int = rt.Refcount
	vmInst.RegisterExtern("rt.Refcount", bit_cast(*uint8, &rtRefcount),
		scalarResult, bit_cast(int, _raw_func_addr(rt.Refcount)))
	var rtBoundsCheck *func(int, int) = rt.BoundsCheck
	vmInst.RegisterExtern("rt.BoundsCheck", bit_cast(*uint8, &rtBoundsCheck),
		scalarResult, bit_cast(int, _raw_func_addr(rt.BoundsCheck)))
	var rtBox *func(*uint8, int) *uint8 = rt.Box
	vmInst.RegisterExtern("rt.Box", bit_cast(*uint8, &rtBox),
		scalarResult, bit_cast(int, _raw_func_addr(rt.Box)))
	var rtRawAlloc *func(int) *uint8 = rt.RawAlloc
	vmInst.RegisterExtern("rt.RawAlloc", bit_cast(*uint8, &rtRawAlloc),
		scalarResult, bit_cast(int, _raw_func_addr(rt.RawAlloc)))
	var rtRawAllocZero *func(int) *uint8 = rt.RawAllocZero
	vmInst.RegisterExtern("rt.RawAllocZero", bit_cast(*uint8, &rtRawAllocZero),
		scalarResult, bit_cast(int, _raw_func_addr(rt.RawAllocZero)))
	var rtRawFree *func(*uint8) = rt.RawFree
	vmInst.RegisterExtern("rt.RawFree", bit_cast(*uint8, &rtRawFree),
		scalarResult, bit_cast(int, _raw_func_addr(rt.RawFree)))
	var rtMemZero *func(*uint8, int) = rt.MemZero
	vmInst.RegisterExtern("rt.MemZero", bit_cast(*uint8, &rtMemZero),
		scalarResult, bit_cast(int, _raw_func_addr(rt.MemZero)))
	var rtMemCopy *func(*uint8, *const uint8, int) = rt.MemCopy
	vmInst.RegisterExtern("rt.MemCopy", bit_cast(*uint8, &rtMemCopy),
		scalarResult, bit_cast(int, _raw_func_addr(rt.MemCopy)))
	var rtBoundsFail *func(int, int) = rt.BoundsFail
	vmInst.RegisterExtern("rt.BoundsFail", bit_cast(*uint8, &rtBoundsFail),
		scalarResult, bit_cast(int, _raw_func_addr(rt.BoundsFail)))

	// Aggregate-return: rt.MakeManagedSlice returns a 32-byte
	// rt.ManagedSlice struct.  Routed through the aggregate-shim
	// path: in compiled mode, vtable.call points at the per-function
	// __shim.bn_rt__MakeManagedSlice (retbuf-style) emitted by
	// emit_funcvals.bn; in bytecode mode (when this helper itself
	// runs as bytecode in an outer VM), BC_FUNC_VALUE picks
	// TrampolineAggregate based on the VMFunc's ResultMultiWord
	// shape.  Either way, dispatchExternBinding's aggregate path
	// allocates retbuf, calls the shim, and returns the retbuf
	// address as the bytecode caller's aggregate-return value.
	var rtMS *func(int, int) rt.ManagedSlice = rt.MakeManagedSlice
	vmInst.RegisterExtern("rt.MakeManagedSlice", bit_cast(*uint8, &rtMS),
		32, bit_cast(int, _raw_func_addr(rt.MakeManagedSlice)))
}

// registerLibcExterns binds pkg/libc's pure-C surface.  All scalar
// returns (libc is C-shaped: int / pointer args and returns).
func registerLibcExterns(vmInst @VM) {
	var libcMalloc *func(int) *uint8 = libc.Malloc
	vmInst.RegisterExtern("libc.Malloc", bit_cast(*uint8, &libcMalloc),
		scalarResult, bit_cast(int, _raw_func_addr(libc.Malloc)))
	var libcCalloc *func(int, int) *uint8 = libc.Calloc
	vmInst.RegisterExtern("libc.Calloc", bit_cast(*uint8, &libcCalloc),
		scalarResult, bit_cast(int, _raw_func_addr(libc.Calloc)))
	var libcFree *func(*uint8) = libc.Free
	vmInst.RegisterExtern("libc.Free", bit_cast(*uint8, &libcFree),
		scalarResult, bit_cast(int, _raw_func_addr(libc.Free)))
	var libcMemset *func(*uint8, int, int) = libc.Memset
	vmInst.RegisterExtern("libc.Memset", bit_cast(*uint8, &libcMemset),
		scalarResult, bit_cast(int, _raw_func_addr(libc.Memset)))
	var libcMemcpy *func(*uint8, *const uint8, int) = libc.Memcpy
	vmInst.RegisterExtern("libc.Memcpy", bit_cast(*uint8, &libcMemcpy),
		scalarResult, bit_cast(int, _raw_func_addr(libc.Memcpy)))
	var libcExit *func(int) = libc.Exit
	vmInst.RegisterExtern("libc.Exit", bit_cast(*uint8, &libcExit),
		scalarResult, bit_cast(int, _raw_func_addr(libc.Exit)))
}

// registerBootstrapExterns binds pkg/bootstrap's C-shaped surface.
// Mix of scalar (Close, Exit, Open, Read, Write, Stat, Exec) and
// aggregate-return (Args, ReadDir → @[]@[]char = 32 bytes).  Slice-
// arg entries flow through the aggregate-arg shim convention
// (emit_funcvals.bn — `i8*` + dereference); aggregate-return entries
// flow through the sret-aware shim path (also emit_funcvals.bn).
func registerBootstrapExterns(vmInst @VM) {
	var btClose *func(int) int = bootstrap.Close
	vmInst.RegisterExtern("bootstrap.Close", bit_cast(*uint8, &btClose),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Close)))
	var btExit *func(int) = bootstrap.Exit
	vmInst.RegisterExtern("bootstrap.Exit", bit_cast(*uint8, &btExit),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Exit)))
	var btOpen *func(*[]const char, int) int = bootstrap.Open
	vmInst.RegisterExtern("bootstrap.Open", bit_cast(*uint8, &btOpen),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Open)))
	var btRead *func(int, *[]uint8) int = bootstrap.Read
	vmInst.RegisterExtern("bootstrap.Read", bit_cast(*uint8, &btRead),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Read)))
	var btWrite *func(int, *[]const uint8) int = bootstrap.Write
	vmInst.RegisterExtern("bootstrap.Write", bit_cast(*uint8, &btWrite),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Write)))
	var btStat *func(*[]const char) int = bootstrap.Stat
	vmInst.RegisterExtern("bootstrap.Stat", bit_cast(*uint8, &btStat),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Stat)))
	var btExec *func(*[]const char, *[]@[]char) int = bootstrap.Exec
	vmInst.RegisterExtern("bootstrap.Exec", bit_cast(*uint8, &btExec),
		scalarResult, bit_cast(int, _raw_func_addr(bootstrap.Exec)))
	var btArgs *func() @[]@[]char = bootstrap.Args
	vmInst.RegisterExtern("bootstrap.Args", bit_cast(*uint8, &btArgs),
		32, bit_cast(int, _raw_func_addr(bootstrap.Args)))
	var btReadDir *func(*[]const char) @[]@[]char = bootstrap.ReadDir
	vmInst.RegisterExtern("bootstrap.ReadDir", bit_cast(*uint8, &btReadDir),
		32, bit_cast(int, _raw_func_addr(bootstrap.ReadDir)))
}
