package "pkg/vm"

import "pkg/rt"

// RegisterStandardExterns binds the host-package functions that
// pkg/vm itself can route through the registry — those whose targets
// have a Binate-side `.bn` body (pkg/rt's runtime), so the Phase-1
// OP_FUNC_VALUE construction can resolve them via LookupFunc.
//
// Pure C externs (pkg/libc.* and the C-shaped pkg/bootstrap.*
// surface — Close, Exit, Open, Read, Write, Stat, Args, ReadDir,
// Exec) are NOT registered here: their function values can only be
// constructed in NATIVE code (compiled cmd/bni main), not in
// bytecode — BC_FUNC_VALUE requires the target to exist as a
// VMFunc, and these have no `.bn` body.  Native call sites
// (cmd/bni's `registerStandardExterns`) layer the
// pure-extern registrations on top of this helper.
//
// NOT registered at any layer (still hand-coded in vm_extern.bn):
//   - rt.MakeManagedSlice — multi-word return pushed onto vm.Stack.
//   - bootstrap.Open / Read / Write / Stat / Exec — slice/multi-word
//     args (the scalar shim's int-args shape can't unpack them).
//   - bootstrap.Args / ReadDir — multi-word return + RefInc surgery.
func RegisterStandardExterns(vmInst @VM) {
	registerRtExterns(vmInst)
}

// registerRtExterns binds pkg/rt's bytecode-friendly surface into
// the registry.  All entries here have a Binate `.bn` body, so
// BC_FUNC_VALUE construction succeeds in either native or bytecode
// dispatch context.
func registerRtExterns(vmInst @VM) {
	var rtAlloc *func(int) *uint8 = rt.Alloc
	RegisterExtern(vmInst, "rt.Alloc", bit_cast(*uint8, &rtAlloc))
	var rtFree *func(*uint8) = rt.Free
	RegisterExtern(vmInst, "rt.Free", bit_cast(*uint8, &rtFree))
	var rtRefInc *func(*uint8) = rt.RefInc
	RegisterExtern(vmInst, "rt.RefInc", bit_cast(*uint8, &rtRefInc))
	var rtRefDec *func(*uint8, *uint8) = rt.RefDec
	RegisterExtern(vmInst, "rt.RefDec", bit_cast(*uint8, &rtRefDec))
	var rtRefcount *func(*uint8) int = rt.Refcount
	RegisterExtern(vmInst, "rt.Refcount",
		bit_cast(*uint8, &rtRefcount))
	var rtBoundsCheck *func(int, int) = rt.BoundsCheck
	RegisterExtern(vmInst, "rt.BoundsCheck",
		bit_cast(*uint8, &rtBoundsCheck))
	var rtBox *func(*uint8, int) *uint8 = rt.Box
	RegisterExtern(vmInst, "rt.Box", bit_cast(*uint8, &rtBox))
	var rtRawAlloc *func(int) *uint8 = rt.RawAlloc
	RegisterExtern(vmInst, "rt.RawAlloc",
		bit_cast(*uint8, &rtRawAlloc))
	var rtRawAllocZero *func(int) *uint8 = rt.RawAllocZero
	RegisterExtern(vmInst, "rt.RawAllocZero",
		bit_cast(*uint8, &rtRawAllocZero))
	var rtRawFree *func(*uint8) = rt.RawFree
	RegisterExtern(vmInst, "rt.RawFree",
		bit_cast(*uint8, &rtRawFree))
	var rtMemZero *func(*uint8, int) = rt.MemZero
	RegisterExtern(vmInst, "rt.MemZero",
		bit_cast(*uint8, &rtMemZero))
	var rtMemCopy *func(*uint8, *const uint8, int) = rt.MemCopy
	RegisterExtern(vmInst, "rt.MemCopy",
		bit_cast(*uint8, &rtMemCopy))
	var rtBoundsFail *func(int, int) = rt.BoundsFail
	RegisterExtern(vmInst, "rt.BoundsFail",
		bit_cast(*uint8, &rtBoundsFail))
}

