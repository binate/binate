package "pkg/vm"

import "pkg/builtin/testing"

// Smoke test for RegisterStandardExterns.  Verifies that a freshly-
// created VM has no externs, and that calling
// RegisterStandardExterns adds bindings for the rt.* names the
// helper covers.  We don't enumerate every binding here — that
// would couple this test to the helper's binding list.  Instead we
// spot-check a representative sample (rt.Alloc, rt.Free, rt.Refcount)
// to ensure the helper actually populates the registry.
//
// End-to-end dispatch (registry → dispatchExternBinding →
// rt._call_shim_scalar → real callee) is verified by the conformance
// suite, which runs user programs that call rt externs through this
// path.

func TestRegisterStandardExternsPopulatesRegistry() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	if len(vm.Externs) != 0 {
		return "fresh VM should have empty Externs"
	}
	RegisterStandardExterns(vm)
	if len(vm.Externs) == 0 {
		return "RegisterStandardExterns added no bindings"
	}
	if vm.LookupExtern("rt.Alloc") < 0 {
		return "rt.Alloc not registered"
	}
	if vm.LookupExtern("rt.Free") < 0 {
		return "rt.Free not registered"
	}
	if vm.LookupExtern("rt.Refcount") < 0 {
		return "rt.Refcount not registered"
	}
	if vm.LookupExtern("not.a.real.extern") >= 0 {
		return "unrelated name found in registry"
	}
	return ""
}

// Verifies registration is idempotent — calling
// RegisterStandardExterns twice doesn't grow the registry.
// Re-registration overwrites in place (per RegisterExtern's contract).
func TestRegisterStandardExternsIdempotent() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	RegisterStandardExterns(vm)
	var nFirst int = len(vm.Externs)
	RegisterStandardExterns(vm)
	var nSecond int = len(vm.Externs)
	if nFirst != nSecond {
		return "second call grew the registry"
	}
	return ""
}
