package "pkg/vm"

import "pkg/builtins/testing"

// fakeFV mirrors the wire layout of a 16-byte function value
// {vtable, data} for the registry-mechanics tests.  The registry
// code only needs the bytes at fvAddr — it never dereferences
// vtable or data here.
type fakeFV struct {
	Vt   int
	Data int
}

// Unit coverage for the extern registry's bookkeeping paths.
// Exercises RegisterExtern + LookupExtern + replacement without
// going through full dispatch (dispatchExternBinding requires a
// real per-function shim and is verified end-to-end by conformance
// once registered externs replace their hand-coded execExtern arms).

func TestExternRegistryEmptyLookup() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	if vm.LookupExtern("anything") != -1 {
		return "empty registry must return -1"
	}
	if len(vm.Externs) != 0 {
		return "Externs should start empty"
	}
	return ""
}

func TestExternRegistryRegisterAndLookup() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	// Synthesize a 16-byte {vtable, data} pair via a 2-int
	// struct.  The registry only needs the bytes — it doesn't
	// dereference vtable/data here, so dummy values are fine.
	var fv fakeFV
	fv.Vt = 0xCAFE
	fv.Data = 0xBABE
	vm.RegisterExtern("rt.Test", bit_cast(*uint8, &fv), 8, 0)

	if len(vm.Externs) != 1 {
		return "post-register: len(Externs) != 1"
	}
	if len(vm.Externs[0].Name) != 7 {
		return "stored Name has wrong length"
	}
	if vm.Externs[0].Name[0] != 'r' {
		return "Name[0] != 'r'"
	}
	if vm.Externs[0].Name[6] != 't' {
		return "Name[6] != 't'"
	}
	var idx int = vm.LookupExtern("rt.Test")
	if idx != 0 {
		return "first registration should be at idx 0"
	}
	if vm.Externs[idx].VtableAddr != 0xCAFE {
		return "VtableAddr not stored"
	}
	if vm.Externs[idx].DataAddr != 0xBABE {
		return "DataAddr not stored"
	}
	if vm.LookupExtern("missing") != -1 {
		return "missing name must return -1"
	}
	return ""
}

func TestExternRegistryReplace() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	var fv1 fakeFV
	fv1.Vt = 100
	fv1.Data = 200
	vm.RegisterExtern("x", bit_cast(*uint8, &fv1), 8, 0)

	var fv2 fakeFV
	fv2.Vt = 300
	fv2.Data = 400
	vm.RegisterExtern("x", bit_cast(*uint8, &fv2), 8, 0)

	if len(vm.Externs) != 1 {
		return "replace must not grow the registry"
	}
	if vm.Externs[0].VtableAddr != 300 {
		return "replace didn't update VtableAddr"
	}
	if vm.Externs[0].DataAddr != 400 {
		return "replace didn't update DataAddr"
	}
	return ""
}

// fakeHandle mirrors a 16-byte {VtableAddr, DataAddr} function-value
// handle.  Used to exercise RegisterExtern's HandleAddr copy path —
// pre-#31 RawFnAddr stored the input handle's address as a raw int,
// so a mutation to the source handle was observable through the
// binding.  Post-#31 the binding owns a fresh managed VMFuncHandle,
// so the binding's copy is decoupled from the source.
type fakeHandle struct {
	Vt   int
	Data int
}

// TestExternRegistryHandleAddrIsOwnedCopy pins the post-#31 semantics
// of ExternBinding.HandleAddr: RegisterExtern allocates a fresh
// managed VMFuncHandle and copies the input handle's two words into
// it.  Mutating the source handle after registration must NOT change
// what the binding sees — that's the property that converts the
// latent use-after-free of pre-#31 into a binding-owned, refcount-
// tracked allocation.
func TestExternRegistryHandleAddrIsOwnedCopy() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	var fv fakeFV
	fv.Vt = 1; fv.Data = 2
	var srcHandle fakeHandle
	srcHandle.Vt = 0xC0DE
	srcHandle.Data = 0xDEAD
	vm.RegisterExtern("h.test", bit_cast(*uint8, &fv), 8,
		bit_cast(int, &srcHandle))
	// Mutate the source handle.  Pre-#31 (raw-int RawFnAddr) the
	// binding would observe these new bytes; post-#31 (managed
	// HandleAddr copy) it must not.
	srcHandle.Vt = 0
	srcHandle.Data = 0
	var idx int = vm.LookupExtern("h.test")
	if idx < 0 { return "h.test should be registered" }
	var h @VMFuncHandle = vm.Externs[idx].HandleAddr
	if h == nil {
		return "HandleAddr should be non-nil after registering with a handle"
	}
	if h.VtableAddr != 0xC0DE {
		return "HandleAddr.VtableAddr should be the copy of the original source, not the mutated source"
	}
	if h.DataAddr != 0xDEAD {
		return "HandleAddr.DataAddr should be the copy of the original source"
	}
	return ""
}

// TestExternRegistryHandleAddrNilWhenAbsent pins that
// RegisterExtern(rawFnAddr=0) leaves HandleAddr nil — legacy callers
// (and tests like TestExternRegistryRegisterAndLookup above that
// don't care about the handle) shouldn't end up with a heap
// allocation they didn't ask for.
func TestExternRegistryHandleAddrNilWhenAbsent() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	var fv fakeFV
	fv.Vt = 1; fv.Data = 2
	vm.RegisterExtern("noh.test", bit_cast(*uint8, &fv), 8, 0)
	var idx int = vm.LookupExtern("noh.test")
	if idx < 0 { return "noh.test should be registered" }
	if vm.Externs[idx].HandleAddr != nil {
		return "HandleAddr should stay nil when rawFnAddr is 0"
	}
	return ""
}

func TestExternRegistryMultipleEntries() testing.TestResult {
	var vm @VM = NewVM(64 * 1024)
	var fvA fakeFV
	fvA.Vt = 1; fvA.Data = 2
	var fvB fakeFV
	fvB.Vt = 3; fvB.Data = 4
	var fvC fakeFV
	fvC.Vt = 5; fvC.Data = 6
	vm.RegisterExtern("alpha", bit_cast(*uint8, &fvA), 8, 0)
	vm.RegisterExtern("beta", bit_cast(*uint8, &fvB), 8, 0)
	vm.RegisterExtern("gamma", bit_cast(*uint8, &fvC), 8, 0)

	if len(vm.Externs) != 3 {
		return "three registrations should produce three entries"
	}
	if vm.LookupExtern("alpha") != 0 { return "alpha idx wrong" }
	if vm.LookupExtern("beta") != 1 { return "beta idx wrong" }
	if vm.LookupExtern("gamma") != 2 { return "gamma idx wrong" }
	if vm.Externs[1].VtableAddr != 3 {
		return "beta vtable wrong"
	}
	return ""
}
