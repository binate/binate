package "pkg/vm"

// Open-addressing hash mapping qualified function names to
// `vm.Funcs` indices.  Linear probing.  Capacity is always a power
// of two; bucket index is computed by masking the hash with
// `IndexMask = capacity - 1`.
//
// Lazy-initialized on first insert (zero-valued VM has empty
// Buckets / Mask=0 / Count=0).  Resized at 75% load to keep
// worst-case probe length bounded.
//
// Insert semantics: replace if name already present (so REPL
// redefinition does the right thing without separate
// add-or-update entry points).
//
// Hash: djb2.  Cheap, well-distributed for the short qualified
// names that callee resolution sees ("pkg.Func", "T.Method").

// initialFuncIndexCap is the starting bucket count for a freshly
// initialized func index — power of two; large enough that small
// programs never resize.
const initialFuncIndexCap int = 256

// hashName returns a djb2 hash of `name`.  Sign of the result is
// not meaningful; callers mask with `IndexMask` to get a bucket.
func hashName(name *[]const char) int {
	var h int = 5381
	for i := 0; i < len(name); i++ {
		h = h * 33 + cast(int, name[i])
	}
	return h
}

// nameEq reports whether two char slices contain identical bytes.
func nameEq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// funcIndexLookup returns the VMFuncs index for `name`, or -1 if
// not present.  O(1) amortized.
//
// Empty slot marker is `len(Name) == 0` (real qualified names are
// always non-empty); managed-slices don't compare to nil.
func funcIndexLookup(vm @VM, name *[]const char) int {
	if vm.IndexMask == 0 { return -1 }
	var h int = hashName(name)
	var bucket int = h & vm.IndexMask
	var probes int = 0
	for probes <= vm.IndexMask {
		var pos int = (bucket + probes) & vm.IndexMask
		var e FuncIndexEntry = vm.IndexBuckets[pos]
		if len(e.Name) == 0 {
			return -1
		}
		if nameEq(e.Name, name) {
			return e.Idx
		}
		probes = probes + 1
	}
	return -1
}

// funcIndexSet records `name -> vmIdx`, replacing any existing
// mapping.  Lazy-initializes the bucket table on first call;
// resizes at 75% load.
func funcIndexSet(vm @VM, name @[]char, vmIdx int) {
	if vm.IndexMask == 0 {
		vm.IndexBuckets = make_slice(FuncIndexEntry, initialFuncIndexCap)
		vm.IndexMask = initialFuncIndexCap - 1
	}
	funcIndexSetInternal(vm.IndexBuckets, vm.IndexMask, name, vmIdx, vm)
	// Resize at 75% load: count*4 > capacity*3.
	if vm.IndexCount * 4 > (vm.IndexMask + 1) * 3 {
		funcIndexResize(vm)
	}
}

// funcIndexSetInternal performs one insert into the given Buckets
// slice with the given Mask.  Bumps vm.IndexCount on a fresh
// insert (no bump on replace).  Caller is responsible for resize
// decisions.
func funcIndexSetInternal(buckets @[]FuncIndexEntry, mask int,
		name @[]char, vmIdx int, vm @VM) {
	var h int = hashName(name)
	var bucket int = h & mask
	var probes int = 0
	for probes <= mask {
		var pos int = (bucket + probes) & mask
		if len(buckets[pos].Name) == 0 {
			buckets[pos].Name = name
			buckets[pos].Idx = vmIdx
			vm.IndexCount = vm.IndexCount + 1
			return
		}
		if nameEq(buckets[pos].Name, name) {
			// Replace existing — Idx update only, Count unchanged.
			buckets[pos].Idx = vmIdx
			return
		}
		probes = probes + 1
	}
	// Unreachable if resize is triggered at 75% load.
}

// funcIndexResize doubles the bucket capacity and rehashes every
// populated entry.  O(N) — called rarely (logarithmic in inserts).
func funcIndexResize(vm @VM) {
	var oldBuckets @[]FuncIndexEntry = vm.IndexBuckets
	var newCap int = (vm.IndexMask + 1) * 2
	vm.IndexBuckets = make_slice(FuncIndexEntry, newCap)
	vm.IndexMask = newCap - 1
	vm.IndexCount = 0
	for i := 0; i < len(oldBuckets); i++ {
		var e FuncIndexEntry = oldBuckets[i]
		if len(e.Name) > 0 {
			funcIndexSetInternal(vm.IndexBuckets, vm.IndexMask,
				e.Name, e.Idx, vm)
		}
	}
}
