package "pkg/vm"

import "pkg/ir"
import "pkg/types"
import "pkg/buf"
import "pkg/rt"

// LowerModule converts all functions in an IR module to bytecode.
func LowerModule(vm @VM, m @ir.Module) {
	// Finalize string constants
	if len(m.Strings) == 0 {
		ir.FinalizeStrings(m)
	}

	// Materialize string constants as managed-slice headers.
	materializeStrings(vm, m.Strings)
	curStrings = m.Strings

	// Allocate globals: each global gets c_malloc'd memory.
	materializeGlobals(m.Globals)

	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if f.IsExtern { continue }
		var vmf @VMFunc = lowerFunc(f)
		vm.Funcs = appendVMFunc(vm.Funcs, vmf)
	}
}

// materializeStrings creates managed-slice headers for all string constants.
func materializeStrings(vm @VM, strings []ir.StringConst) {
	var n int = len(strings)
	if n == 0 { return }
	vm.Strings = make_slice(int, n)
	for i := 0; i < n; i++ {
		var slen int = strings[i].Len
		// Allocate string data (immortal, not ref-counted)
		var data *uint8 = rt.c_malloc(slen)
		// Copy string bytes
		var src []char = strings[i].Data
		for j := 0; j < slen; j++ {
			data[j] = cast(uint8, src[j])
		}
		// Allocate 4-word managed-slice header
		var hdr *int = bit_cast(*int, rt.c_malloc(32))
		hdr[0] = bit_cast(int, data)   // data ptr
		hdr[1] = slen                   // len
		hdr[2] = 0                      // refptr = null (immortal)
		hdr[3] = slen                   // backing_len
		vm.Strings[i] = bit_cast(int, hdr)
	}
}

// Module-level state used during lowering.
var curNames @[]@[]char
var curStrings []ir.StringConst
var globalNames @[]@[]char
var globalAddrs @[]int

// addName appends a name to curNames and returns its index.
func addName(name @[]char) int {
	var idx int = len(curNames)
	curNames = appendNameStr(curNames, name)
	return idx
}

// appendNameStr returns a new slice with v appended.
func appendNameStr(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// materializeGlobals allocates memory for each global variable.
func materializeGlobals(globals []@ir.Global) {
	var n int = len(globals)
	globalNames = make_slice(@[]char, n)
	globalAddrs = make_slice(int, n)
	for i := 0; i < n; i++ {
		var size int = types.SizeOf(globals[i].Typ)
		if size < 8 { size = 8 }
		var ptr *uint8 = rt.c_malloc(size)
		rt.c_memset(ptr, 0, size)
		globalNames[i] = globals[i].Name
		globalAddrs[i] = bit_cast(int, ptr)
	}
}

// lookupGlobalAddr returns the address of a global variable, or 0.
func lookupGlobalAddr(name []char) int {
	for i := 0; i < len(globalNames); i++ {
		if streq2(globalNames[i], name) { return globalAddrs[i] }
	}
	return 0
}

// streq2 returns true if raw slices a and b have identical contents.
func streq2(a []char, b []char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// lowerFunc converts one IR function to a VMFunc with bytecode.
func lowerFunc(f @ir.Func) @VMFunc {
	var vmf @VMFunc = make(VMFunc)
	vmf.Name = f.Name
	vmf.NumParams = len(f.Params)
	vmf.NumResults = len(f.Results)

	curNames = make_slice(@[]char, 0)

	// Reserve extra registers for call arg packing and globals.
	var maxArgs int = findMaxCallArgs(f)
	var callArgBase int = f.NextID
	// One extra register for global address temporaries
	var globalReg int = f.NextID + maxArgs
	vmf.NumRegs = f.NextID + maxArgs + 1

	// First pass: compute stack frame layout (alloca offsets)
	var frameOffset int = 0
	var allocaOffsets @[]int = make_slice(int, f.NextID)
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op == ir.OP_ALLOC && instr.TypeArg != nil {
				var size int = types.SizeOf(instr.TypeArg)
				// Align to 8 bytes
				frameOffset = (frameOffset + 7) / 8 * 8
				allocaOffsets[instr.ID] = frameOffset
				frameOffset = frameOffset + size
			}
		}
	}
	vmf.FrameSize = frameOffset

	// Second pass: compute block offsets (label → bytecode index)
	// We need to know how many bytecodes each block produces.
	// Do a dry run to count, then a real emit pass.
	var blockOffsets @[]int = make_slice(int, len(f.Blocks))
	var totalInstrs int = 0
	for i := 0; i < len(f.Blocks); i++ {
		blockOffsets[i] = totalInstrs
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op == ir.OP_PHI {
				// Phi nodes don't emit directly — copies are inserted in predecessors
				continue
			}
			totalInstrs = totalInstrs + 1
			// Calls and multi-return emit extra MOVs
			if instr.Op == ir.OP_CALL ||
				instr.Op == ir.OP_CALL_BUILTIN ||
				(instr.Op == ir.OP_RETURN &&
					len(instr.Args) > 1) {
				totalInstrs = totalInstrs + len(instr.Args)
			}
			// Global refs emit extra LOAD_IMM
			for k := 0; k < len(instr.Args); k++ {
				if instr.Args[k] != nil &&
					instr.Args[k].ID == -1 &&
					len(instr.Args[k].StrVal) > 0 {
					totalInstrs = totalInstrs + 1
				}
			}
		}
		// Count phi copies that predecessors need to insert
		// (handled in third pass)
	}

	// Add space for phi copies (conservative: count all phi entries)
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == ir.OP_PHI {
				totalInstrs = totalInstrs + len(blk.Instrs[j].Phis)
			}
		}
	}

	// Third pass: emit bytecode
	var code @[]BCInstr = make_slice(BCInstr, totalInstrs)
	var codeIdx int = 0

	// Collect phi copies per block (inserted before terminator)
	// phiCopies[blockIdx] = list of (dst, src) pairs
	for i := 0; i < len(f.Blocks); i++ {
		blockOffsets[i] = codeIdx
		var blk @ir.Block = f.Blocks[i]

		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]

			if instr.Op == ir.OP_PHI {
				continue // handled by predecessor insertion
			}

			// Before terminators, insert phi copies for successor blocks
			if ir.IsTerminator(instr) {
				codeIdx = insertPhiCopies(f, code, codeIdx, blk, instr)
			}

			// Fix up global references: if any arg has ID=-1
			// and StrVal set, emit BC_LOAD_IMM for the global
			// address and patch the arg's ID to globalReg.
			for k := 0; k < len(instr.Args); k++ {
				if instr.Args[k] != nil &&
					instr.Args[k].ID == -1 &&
					len(instr.Args[k].StrVal) > 0 {
					var addr int = lookupGlobalAddr(
						instr.Args[k].StrVal)
					var loadImm BCInstr
					loadImm.Op = BC_LOAD_IMM
					loadImm.Dst = globalReg
					loadImm.Imm = addr
					code[codeIdx] = loadImm
					codeIdx = codeIdx + 1
					instr.Args[k].ID = globalReg
				}
			}

			// For calls and multi-return, insert MOVs to pack
			// args into consecutive registers.
			if instr.Op == ir.OP_CALL ||
				instr.Op == ir.OP_CALL_BUILTIN ||
				(instr.Op == ir.OP_RETURN &&
					len(instr.Args) > 1) {
				for k := 0; k < len(instr.Args); k++ {
					var mov BCInstr
					mov.Op = BC_MOV
					mov.Dst = callArgBase + k
					mov.Src1 = instr.Args[k].ID
					code[codeIdx] = mov
					codeIdx = codeIdx + 1
				}
			}
			var bc BCInstr = lowerInstr(instr,
				allocaOffsets, blockOffsets, f,
				callArgBase)
			code[codeIdx] = bc
			codeIdx = codeIdx + 1
		}
	}

	vmf.Code = code[:codeIdx]
	vmf.Names = curNames
	return vmf
}

// insertPhiCopies inserts MOV instructions for phi nodes in
// successor blocks.
func insertPhiCopies(f @ir.Func, code @[]BCInstr, codeIdx int,
	curBlock @ir.Block, terminator @ir.Instr) int {
	// Find successor blocks
	if terminator.Block1 != nil {
		codeIdx = insertPhiCopiesForSucc(f, code, codeIdx, curBlock, terminator.Block1)
	}
	if terminator.Block2 != nil {
		codeIdx = insertPhiCopiesForSucc(f, code, codeIdx, curBlock, terminator.Block2)
	}
	return codeIdx
}

// insertPhiCopiesForSucc emits MOV for each phi in succBlock
// that has curBlock as predecessor.
func insertPhiCopiesForSucc(f @ir.Func, code @[]BCInstr,
	codeIdx int, curBlock @ir.Block,
	succBlock @ir.Block) int {
	for i := 0; i < len(succBlock.Instrs); i++ {
		var instr @ir.Instr = succBlock.Instrs[i]
		if instr.Op != ir.OP_PHI { break }
		// Find the phi entry for curBlock
		for j := 0; j < len(instr.Phis); j++ {
			if instr.Phis[j].Block == curBlock {
				var bc BCInstr
				bc.Op = BC_MOV
				bc.Dst = instr.ID
				bc.Src1 = instr.Phis[j].Val.ID
				code[codeIdx] = bc
				codeIdx = codeIdx + 1
			}
		}
	}
	return codeIdx
}

// lowerInstr converts one IR instruction to one bytecode instruction.
func lowerInstr(instr @ir.Instr, allocaOffsets []int,
	blockOffsets []int, f @ir.Func,
	callArgBase int) BCInstr {
	var bc BCInstr
	bc.Dst = instr.ID

	// Constants
	if instr.Op == ir.OP_CONST_INT {
		bc.Op = BC_LOAD_IMM
		bc.Imm = instr.IntVal
		return bc
	}
	if instr.Op == ir.OP_CONST_BOOL {
		bc.Op = BC_LOAD_IMM
		if instr.BoolVal { bc.Imm = 1 } else { bc.Imm = 0 }
		return bc
	}
	if instr.Op == ir.OP_CONST_NIL {
		bc.Op = BC_LOAD_IMM
		bc.Imm = 0
		return bc
	}
	if instr.Op == ir.OP_CONST_STRING {
		bc.Op = BC_LOAD_STR
		bc.Imm = ir.FindStringID(curStrings, instr.StrVal)
		return bc
	}

	// Arithmetic — binary ops: Dst = Src1 op Src2
	if instr.Op == ir.OP_ADD || instr.Op == ir.OP_SUB ||
		instr.Op == ir.OP_MUL || instr.Op == ir.OP_DIV ||
		instr.Op == ir.OP_REM || instr.Op == ir.OP_AND ||
		instr.Op == ir.OP_OR || instr.Op == ir.OP_XOR ||
		instr.Op == ir.OP_SHL || instr.Op == ir.OP_SHR {
		bc.Op = lowerBinOp(instr.Op)
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// Comparison — binary ops: Dst = Src1 cmp Src2
	if instr.Op == ir.OP_EQ || instr.Op == ir.OP_NE ||
		instr.Op == ir.OP_LT || instr.Op == ir.OP_LE ||
		instr.Op == ir.OP_GT || instr.Op == ir.OP_GE {
		bc.Op = lowerCmpOp(instr.Op)
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// Unary
	if instr.Op == ir.OP_NEG { bc.Op = BC_NEG; bc.Src1 = instr.Args[0].ID; return bc }
	if instr.Op == ir.OP_NOT { bc.Op = BC_NOT; bc.Src1 = instr.Args[0].ID; return bc }
	if instr.Op == ir.OP_BITNOT { bc.Op = BC_BITNOT; bc.Src1 = instr.Args[0].ID; return bc }

	// Memory
	if instr.Op == ir.OP_ALLOC {
		bc.Op = BC_STACK_ALLOC
		bc.Imm = allocaOffsets[instr.ID]
		return bc
	}
	if instr.Op == ir.OP_LOAD {
		// Struct loads: in the VM, struct values are always
		// pointers to stack memory, so "load struct" is a MOV.
		if instr.Typ != nil &&
			instr.Typ.Kind == types.TYP_STRUCT {
			bc.Op = BC_MOV
			bc.Src1 = instr.Args[0].ID
			return bc
		}
		// Managed-slice loads: 4 words, kept as pointer.
		if instr.Typ != nil &&
			instr.Typ.Kind == types.TYP_MANAGED_SLICE {
			bc.Op = BC_MOV
			bc.Src1 = instr.Args[0].ID
			return bc
		}
		var loadSize int = 8
		if instr.Typ != nil && instr.Typ.Width == 8 {
			loadSize = 1
		}
		if instr.Typ != nil &&
			instr.Typ.Kind == types.TYP_BOOL {
			loadSize = 1
		}
		if loadSize == 1 {
			bc.Op = BC_LOAD8
		} else {
			bc.Op = BC_LOAD64
		}
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_STORE {
		var valTyp @types.Type = instr.Args[1].Typ
		// Struct/managed-slice stores: memcpy the multi-word value
		if valTyp != nil &&
			valTyp.Kind == types.TYP_STRUCT {
			bc.Op = BC_MEMCPY
			bc.Src1 = instr.Args[0].ID
			bc.Src2 = instr.Args[1].ID
			bc.Imm = types.SizeOf(valTyp)
			bc.Dst = -1
			return bc
		}
		if valTyp != nil &&
			valTyp.Kind == types.TYP_MANAGED_SLICE {
			bc.Op = BC_MEMCPY
			bc.Src1 = instr.Args[0].ID
			bc.Src2 = instr.Args[1].ID
			bc.Imm = types.SizeOf(valTyp)
			bc.Dst = -1
			return bc
		}
		var storeSize int = 8
		if valTyp != nil && valTyp.Width == 8 {
			storeSize = 1
		}
		if valTyp != nil &&
			valTyp.Kind == types.TYP_BOOL {
			storeSize = 1
		}
		if storeSize == 1 {
			bc.Op = BC_STORE8
		} else {
			bc.Op = BC_STORE64
		}
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}
	if instr.Op == ir.OP_GET_FIELD_PTR {
		bc.Op = BC_FIELD_PTR
		bc.Src1 = instr.Args[0].ID
		// Get struct type from either TypeArg (alloca) or
		// Args[0].Typ.Elem (pointer-to-struct from field ptr)
		var structTyp @types.Type = instr.Args[0].TypeArg
		if structTyp == nil && instr.Args[0].Typ != nil {
			structTyp = instr.Args[0].Typ.Elem
		}
		if structTyp != nil {
			bc.Imm = types.FieldOffset(structTyp, instr.Index)
		}
		return bc
	}
	if instr.Op == ir.OP_GET_ELEM_PTR {
		bc.Op = BC_ELEM_PTR
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		if instr.Typ != nil && instr.Typ.Elem != nil {
			bc.Imm = types.SizeOf(instr.Typ.Elem)
		} else {
			bc.Imm = 8
		}
		return bc
	}

	// Control flow
	if instr.Op == ir.OP_JUMP {
		bc.Op = BC_JUMP
		bc.Dst = -1
		bc.Aux = findBlockOffset(f, instr.Block1, blockOffsets)
		return bc
	}
	if instr.Op == ir.OP_BRANCH {
		bc.Op = BC_BRANCH
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Imm = findBlockOffset(f, instr.Block1, blockOffsets)
		bc.Aux = findBlockOffset(f, instr.Block2, blockOffsets)
		return bc
	}
	if instr.Op == ir.OP_RETURN {
		bc.Op = BC_RETURN
		if len(instr.Args) == 0 {
			bc.Dst = -1
		} else if len(instr.Args) == 1 {
			bc.Dst = 0 // signal: has return value
			bc.Src1 = instr.Args[0].ID
		} else {
			// Multi-return: Src1 = callArgBase (packed by
			// emit loop), Imm = count
			bc.Dst = len(instr.Args)
			bc.Src1 = callArgBase
			bc.Imm = len(instr.Args)
		}
		return bc
	}

	// Managed memory
	if instr.Op == ir.OP_REFCOUNT_INC {
		bc.Op = BC_REFINC
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_REFCOUNT_DEC {
		bc.Op = BC_REFDEC
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = -1  // -1 means null dtor
		if len(instr.Args) > 1 {
			bc.Src2 = instr.Args[1].ID
		}
		return bc
	}
	if instr.Op == ir.OP_BOX {
		bc.Op = BC_BOX
		bc.Src1 = instr.Args[0].ID
		if instr.TypeArg != nil {
			bc.Imm = types.SizeOf(instr.TypeArg)
		} else if instr.Typ != nil && instr.Typ.Elem != nil {
			bc.Imm = types.SizeOf(instr.Typ.Elem)
		} else if instr.Args[0].TypeArg != nil {
			bc.Imm = types.SizeOf(instr.Args[0].TypeArg)
		} else {
			bc.Imm = 8
		}
		return bc
	}
	if instr.Op == ir.OP_MAKE {
		bc.Op = BC_ALLOC
		if instr.TypeArg != nil {
			bc.Imm = types.SizeOf(instr.TypeArg)
		} else {
			bc.Imm = 8
		}
		return bc
	}
	if instr.Op == ir.OP_MAKE_SLICE {
		bc.Op = BC_MAKE_SLICE
		bc.Src1 = instr.Args[0].ID
		if instr.TypeArg != nil {
			bc.Imm = types.SizeOf(instr.TypeArg)
		} else {
			bc.Imm = 8
		}
		return bc
	}
	if instr.Op == ir.OP_DEREF {
		bc.Op = BC_LOAD64
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_NIL_CHECK {
		bc.Op = BC_NIL_CHECK
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_BOUNDS_CHECK {
		bc.Op = BC_BOUNDS_CHECK
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// Conversions
	if instr.Op == ir.OP_CAST {
		// Simple width conversion
		if instr.TypeArg != nil && instr.TypeArg.Width == 8 {
			bc.Op = BC_TRUNC8
		} else {
			bc.Op = BC_MOV // same-size cast
		}
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_BIT_CAST {
		bc.Op = BC_MOV
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_MANAGED_TO_RAW {
		// Extract first 2 words from managed-slice
		// For now, just copy the pointer (the managed-slice starts with raw slice layout)
		bc.Op = BC_MOV
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_STRING_TO_CHARS {
		// String → []char or @[]char: load the managed-slice header pointer
		// from the string table. The source arg is the OP_CONST_STRING whose
		// StrVal lets us find the string ID.
		bc.Op = BC_LOAD_STR
		bc.Imm = ir.FindStringID(curStrings, instr.Args[0].StrVal)
		// BC_LOAD_STR loads raw data ptr, but STRING_TO_CHARS needs the
		// managed-slice header ptr. Use Aux=1 to signal "load header ptr".
		bc.Aux = 1
		return bc
	}
	if instr.Op == ir.OP_STRING_TO_ARRAY {
		// String → [N]char array: copy bytes to stack. For now, treat as MOV.
		bc.Op = BC_MOV
		bc.Src1 = instr.Args[0].ID
		return bc
	}

	if instr.Op == ir.OP_EXTRACT {
		bc.Op = BC_EXTRACT
		bc.Src1 = instr.Args[0].ID
		bc.Imm = instr.Index
		return bc
	}

	if instr.Op == ir.OP_FUNC_ADDR {
		bc.Op = BC_FUNC_ADDR
		bc.Aux = addName(instr.StrVal)
		return bc
	}

	if instr.Op == ir.OP_STRUCT_LIT {
		// For now, treat as NOP — struct lit construction is done via stores
		bc.Op = BC_NOP
		bc.Dst = -1
		return bc
	}

	if instr.Op == ir.OP_UNREACHABLE {
		bc.Op = BC_NOP
		bc.Dst = -1
		return bc
	}
	if instr.Op == ir.OP_PANIC {
		bc.Op = BC_NOP // TODO: implement panic
		bc.Dst = -1
		return bc
	}

	// Calls — args already packed into consecutive registers
	// at callArgBase by the emit loop.
	if instr.Op == ir.OP_CALL {
		bc.Op = BC_CALL
		bc.Imm = len(instr.Args)
		bc.Src1 = callArgBase
		bc.Aux = addName(instr.StrVal)
		return bc
	}
	if instr.Op == ir.OP_CALL_BUILTIN {
		bc.Op = BC_CALL_BUILTIN
		bc.Imm = len(instr.Args)
		bc.Src1 = callArgBase
		bc.Aux = addName(instr.StrVal)
		return bc
	}

	// Default: NOP with warning
	bc.Op = BC_NOP
	bc.Dst = -1
	return bc
}

// lowerBinOp maps an IR binary arithmetic op to a bytecode opcode.
func lowerBinOp(op int) int {
	if op == ir.OP_ADD { return BC_ADD }
	if op == ir.OP_SUB { return BC_SUB }
	if op == ir.OP_MUL { return BC_MUL }
	if op == ir.OP_DIV { return BC_DIV }
	if op == ir.OP_REM { return BC_REM }
	if op == ir.OP_AND { return BC_AND }
	if op == ir.OP_OR  { return BC_OR }
	if op == ir.OP_XOR { return BC_XOR }
	if op == ir.OP_SHL { return BC_SHL }
	if op == ir.OP_SHR { return BC_SHR }
	return BC_NOP
}

// lowerCmpOp maps an IR comparison op to a bytecode opcode.
func lowerCmpOp(op int) int {
	if op == ir.OP_EQ { return BC_EQ }
	if op == ir.OP_NE { return BC_NE }
	if op == ir.OP_LT { return BC_SLT }
	if op == ir.OP_LE { return BC_SLE }
	if op == ir.OP_GT { return BC_SGT }
	if op == ir.OP_GE { return BC_SGE }
	return BC_NOP
}

// findMaxCallArgs returns the maximum number of arguments in any
// call or multi-return instruction within the function.
func findMaxCallArgs(f @ir.Func) int {
	var max int = 0
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			var n int = 0
			if instr.Op == ir.OP_CALL ||
				instr.Op == ir.OP_CALL_BUILTIN {
				n = len(instr.Args)
			}
			if instr.Op == ir.OP_RETURN &&
				len(instr.Args) > 1 {
				n = len(instr.Args)
			}
			if n > max { max = n }
		}
	}
	return max
}

// findBlockOffset returns the bytecode index for a target block.
func findBlockOffset(f @ir.Func, target @ir.Block,
	blockOffsets []int) int {
	for i := 0; i < len(f.Blocks); i++ {
		if f.Blocks[i] == target {
			return blockOffsets[i]
		}
	}
	return 0
}

// Append helper
func appendVMFunc(s @[]@VMFunc, v @VMFunc) @[]@VMFunc {
	var n int = len(s)
	var ns @[]@VMFunc = make_slice(@VMFunc, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}
