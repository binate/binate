package "pkg/vm"

import "pkg/buf"
import "pkg/ir"
import "pkg/mangle"
import "pkg/types"

// LowerOneFuncShadow lowers a single IR function to a VMFunc and
// always APPENDS it to vm.Funcs (never replaces, even when a
// VMFunc with the same qualified name already exists).  REPL
// entry point for Tier 4 shadow: incompatible-signature
// redefinition keeps the OLD VMFunc reachable at its existing
// idx for any caller whose CallCache already resolved that
// callee — those callers continue calling the old shape.
//
// The funcIndex is updated to point at the NEW (later) idx, so
// fresh lowerings (eager-fill at lowering time) resolve to the
// new VMFunc.  Old callers, whose CallCache was eager-filled at
// THEIR lowering time, hold the OLD idx and stay routed to the
// old VMFunc — exactly the shadow semantic.
//
// Preconditions match LowerOneFunc.  Returns the new VMFunc, or
// nil if `f` is extern.
func LowerOneFuncShadow(vm @VM, m @ir.Module, f @ir.Func) @VMFunc {
	if f.IsExtern { return nil }
	ir.FinalizeStrings(m)
	moduleStrings = materializeModuleStrings(m.Strings)
	curStrings = m.Strings
	var vmf @VMFunc = lowerFunc(f)
	var newIdx int = len(vm.Funcs)
	vm.Funcs = appendVMFunc(vm.Funcs, vmf)
	// Re-point the funcIndex at the new idx; old idx stays in
	// vm.Funcs as a callable shadowed entry.
	funcIndexSet(vm, vmf.Name, newIdx)
	eagerFillCallCache(vm, vmf)
	return vmf
}

// LowerOneFunc lowers a single IR function to a VMFunc and
// installs it in vm.Funcs.  REPL entry point: per-function analog
// of LowerModule's inner loop.
//
// Install semantics:
//   - If vm.Funcs already has an entry with the same qualified
//     name, replace it in place (Tier 4 redefinition: same idx,
//     so the existing per-call-site CallCache stays valid).
//   - Otherwise append (Tier 1 / 2 first-time lower).
//
// In both cases, the name→idx hash on the VM is updated
// accordingly so subsequent LookupFunc calls resolve in O(1).
//
// Preconditions:
//   - LowerModule(vm, m) was previously called for `m` so the
//     module-level VM state (modulePkgName, materialized globals)
//     is set up.
//   - Caller has already AddFunc'd `f` into `m` so string
//     collection can see it.
//
// Returns the installed VMFunc, or nil if `f` is extern (nothing
// lowered).
func LowerOneFunc(vm @VM, m @ir.Module, f @ir.Func) @VMFunc {
	if f.IsExtern { return nil }
	// Re-collect strings: existing IDs are stable (encounter
	// order), new strings get appended IDs.  Re-materialize
	// moduleStrings so the new VMFunc's BC_LOAD_STR references
	// have a fresh @[]@[]char to share via vmf.Strings.
	ir.FinalizeStrings(m)
	moduleStrings = materializeModuleStrings(m.Strings)
	curStrings = m.Strings
	var vmf @VMFunc = lowerFunc(f)
	var existing int = funcIndexLookup(vm, vmf.Name)
	var isFreshName bool = false
	if existing >= 0 {
		vm.Funcs[existing] = vmf
		// Hash entry already maps name → existing; no update.
	} else {
		var newIdx int = len(vm.Funcs)
		vm.Funcs = appendVMFunc(vm.Funcs, vmf)
		funcIndexSet(vm, vmf.Name, newIdx)
		isFreshName = true
	}
	// Eager-fill CallCache against the now-current funcIndex so
	// per-call-site resolution is frozen at lowering time (the
	// substrate the Tier 4 shadow path relies on).
	eagerFillCallCache(vm, vmf)
	// Tier 3 forward references: if this is the first time
	// `vmf.Name` enters funcIndex, any earlier-lowered VMFunc
	// that referenced this name (and got -1 cached, since the
	// name was unknown then) needs its cache upgraded to the
	// real idx.  Tier 4 shadow correctness preserved — only
	// -1 entries are touched, real cached indices stay put.
	if isFreshName {
		backfillExternCachesForName(vm, vmf.Name)
	}
	return vmf
}

// eagerFillCallCache replaces every -2 entry in vmf.CallCache with
// the result of looking up the corresponding name on `vm` right
// now (-1 if the name isn't a VM function).  Called after a
// VMFunc is registered in the per-VM funcIndex so that all the
// VMFuncs it references are resolvable.
//
// Why eager: per-call-site lazy fill (the historical default)
// resolves on first execution.  That timing is fine for the
// non-REPL world where vm.Funcs never changes after load, but
// it's wrong for the Tier 4 shadow path: an old caller whose
// CallCache slot is still -2 when its callee gets shadowed would
// pick up the new (incompatible) callee on its next execution.
// Eager fill freezes the binding at lowering time, which is the
// semantic the language design pins down.
func eagerFillCallCache(vm @VM, vmf @VMFunc) {
	for i := 0; i < len(vmf.CallCache); i++ {
		if vmf.CallCache[i] == -2 {
			vmf.CallCache[i] = funcIndexLookup(vm, vmf.Names[i])
		}
	}
}

// backfillExternCachesForName walks every VMFunc in vm.Funcs and
// converts any CallCache slot that's currently -1 (cached as
// "extern, unknown to the VM") AND whose Names[i] equals
// `name` into the now-correct funcIndex entry.
//
// Why: Tier 3 forward references mean a caller can be lowered
// before its callee.  At that lower-time, eagerFillCallCache
// caches -1 for the unknown name (extern fallback path).  When
// the callee later lowers, those -1 entries need to be
// upgraded to the new idx — otherwise the old caller's
// BC_CALL hits the extern path and fails.
//
// Tier 4 shadow correctness is preserved: this only upgrades
// -1 (= "no real func known") slots; existing >=0 caches
// (real func indices, including those for now-shadowed
// callees) are left untouched.
func backfillExternCachesForName(vm @VM, name *[]const char) {
	var newIdx int = funcIndexLookup(vm, name)
	if newIdx < 0 { return }
	for f := 0; f < len(vm.Funcs); f++ {
		var caller @VMFunc = vm.Funcs[f]
		for i := 0; i < len(caller.CallCache); i++ {
			if caller.CallCache[i] != -1 { continue }
			if streq(caller.Names[i], name) {
				caller.CallCache[i] = newIdx
			}
		}
	}
}

// LowerModule converts all functions in an IR module to bytecode.
func LowerModule(vm @VM, m @ir.Module) {
	// Finalize string constants
	if len(m.Strings) == 0 {
		ir.FinalizeStrings(m)
	}

	// Materialize string constants as managed-slice headers.
	// Keep a per-module strings slice in moduleStrings so each
	// VMFunc lowered from this module can reference it; earlier
	// modules' strings are preserved in their own VMFuncs. (Old
	// behavior overwrote vm.Strings each LowerModule call, which
	// invalidated BC_LOAD_STR indices baked into earlier modules'
	// functions — e.g. pkg/token's TypeName would return pkg/lexer
	// strings after pkg/lexer was lowered.)
	moduleStrings = materializeModuleStrings(m.Strings)
	curStrings = m.Strings

	// Derive short package name from m.Name (e.g., `"pkg/asm"` → "asm").
	// Used to qualify function names so multiple packages can define
	// same-named functions without colliding in the VM's function table.
	modulePkgName = mangle.PkgShortNameFromModule(m.Name)

	// Allocate globals: each global gets c_malloc'd memory.
	materializeGlobals(m.Globals)

	// Two-pass to support cross-references between funcs lowered in
	// the same module: pass 1 lowers and registers every VMFunc on
	// vm.Funcs / the funcIndex; pass 2 eager-fills CallCaches now
	// that all names are known.  A single pass would leave any
	// forward call within the module resolving to -1 (extern) at
	// fill time, then either crashing or routing through the
	// extern path at execution.
	var firstNewIdx int = len(vm.Funcs)
	for i := 0; i < len(m.Funcs); i++ {
		var f @ir.Func = m.Funcs[i]
		if f.IsExtern { continue }
		var vmf @VMFunc = lowerFunc(f)
		var newIdx int = len(vm.Funcs)
		vm.Funcs = appendVMFunc(vm.Funcs, vmf)
		funcIndexSet(vm, vmf.Name, newIdx)
	}
	for i := firstNewIdx; i < len(vm.Funcs); i++ {
		eagerFillCallCache(vm, vm.Funcs[i])
	}
	// Slice 2.3c of plan-interface-syntax-revision.md: register a
	// VM-side vtable per (impl, interface) pair. Each vtable holds
	// 1-based VM function indices in the interface's method-
	// declaration order. Runs after eagerFillCallCache so all
	// methods are registered and resolvable by name.
	lowerImplVtables(vm, m)
}

// lowerImplVtables walks m.Impls and appends one IfaceVtable to
// vm.IfaceVtables per impl. Each method name (already qualified
// `<pkgShort>.<recvType>.<methodName>` by IR-gen) is resolved to
// a 1-based VM function index. Slice 2.3c of plan-interface-
// syntax-revision.md.
func lowerImplVtables(vm @VM, m @ir.Module) {
	for i := 0; i < len(m.Impls); i++ {
		var info @ir.ImplInfo = m.Impls[i]
		if info == nil { continue }
		var vt @IfaceVtable = make(IfaceVtable)
		vt.Name = implVtableName(info)
		vt.Methods = make_slice(int, len(info.MethodFuncs))
		for j := 0; j < len(info.MethodFuncs); j++ {
			var idx int = LookupFunc(vm, info.MethodFuncs[j])
			vt.Methods[j] = idx + 1
		}
		vm.IfaceVtables = appendIfaceVtable(vm.IfaceVtables, vt)
	}
}

// implVtableName builds the same mangled identifier that IR-gen
// stores on OP_IFACE_VALUE (e.g.,
// "__ivt.bn_<pkg>__<recvType>__<iface>"). The VM uses this as the
// key when BC_IFACE_VALUE looks up the right vtable record.
func implVtableName(info @ir.ImplInfo) @[]char {
	var b buf.CharBuf = buf.New()
	b = b.WriteStr("__ivt.bn_")
	b = b.WriteStr(modulePkgName)
	b = b.WriteStr("__")
	b = b.WriteStr(info.RecvTypeName)
	b = b.WriteStr("__")
	b = b.WriteStr(info.IfaceName)
	return b.Bytes()
}

// findIfaceVtable returns the 0-based index of the vtable in
// vm.IfaceVtables matching `name`, or -1 if not found.
func findIfaceVtable(vm @VM, name @[]char) int {
	for i := 0; i < len(vm.IfaceVtables); i++ {
		if streq2(vm.IfaceVtables[i].Name, name) {
			return i
		}
	}
	return -1
}

// appendIfaceVtable appends v to s and returns the new slice.
func appendIfaceVtable(s @[]@IfaceVtable, v @IfaceVtable) @[]@IfaceVtable {
	var n int = len(s)
	var out @[]@IfaceVtable = make_slice(@IfaceVtable, n+1)
	for i := 0; i < n; i++ { out[i] = s[i] }
	out[n] = v
	return out
}

// qualifyCallName returns the fully-qualified function name for a call
// target. Thin wrapper around mangle.QualifyName that plugs in the
// current module's short package name.
func qualifyCallName(name @[]char) @[]char {
	return mangle.QualifyName(modulePkgName, name)
}

// lowerFunc converts one IR function to a VMFunc with bytecode.
func lowerFunc(f @ir.Func) @VMFunc {
	var vmf @VMFunc = make(VMFunc)
	// f.Name is the canonical fully-qualified form; pass it through
	// qualifyCallName which is a no-op for dotted names but stays
	// defensive against any not-yet-qualified Func arrivals.
	vmf.Name = qualifyCallName(f.Name)
	vmf.NumParams = len(f.Params)
	vmf.NumResults = len(f.Results)

	// Compute per-result sizes and offsets.  Populated for both
	// single-result and multi-return functions: BC_RETURN's
	// multi-return packing reads ResultOffsets, while
	// BC_FUNC_VALUE's vtable construction reads ResultMultiWord
	// to pick TrampolineScalar vs TrampolineAggregate, and
	// TrampolineAggregate itself reads ResultSizes[0] to know
	// how many bytes to memcpy from the bytecode-returned address
	// into the caller's retbuf.  Layout matches IR's
	// makeMultiReturnStructType: each field is aligned to its
	// natural alignment.
	if len(f.Results) >= 1 {
		vmf.ResultSizes = make_slice(int, len(f.Results))
		vmf.ResultOffsets = make_slice(int, len(f.Results))
		vmf.ResultMultiWord = make_slice(bool, len(f.Results))
		var off int = 0
		for i := 0; i < len(f.Results); i++ {
			var t @types.Type = f.Results[i]
			var align int = types.AlignOf(t)
			if align > 1 {
				off = (off + align - 1) / align * align
			}
			vmf.ResultOffsets[i] = off
			vmf.ResultSizes[i] = types.SizeOf(t)
			vmf.ResultMultiWord[i] = isMultiWordField(t)
			off = off + vmf.ResultSizes[i]
		}
	}

	curNames = make_slice(@[]char, 0)

	// Reserve extra registers for call arg packing and globals.
	var maxArgs int = findMaxCallArgs(f)
	var callArgBase int = f.NextID
	// One extra register for global address temporaries
	var globalReg int = f.NextID + maxArgs
	vmf.NumRegs = f.NextID + maxArgs + 1

	// First pass: compute stack frame layout (alloca offsets)
	var frameOffset int = 0
	var allocaOffsets @[]int = make_slice(int, f.NextID)
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op == ir.OP_ALLOC && instr.TypeArg != nil {
				var size int = types.SizeOf(instr.TypeArg)
				// Align to 8 bytes
				frameOffset = (frameOffset + 7) / 8 * 8
				allocaOffsets[instr.ID] = frameOffset
				frameOffset = frameOffset + size
			}
		}
	}
	vmf.FrameSize = frameOffset

	// Second pass: compute block offsets (label → bytecode index)
	// We need to know how many bytecodes each block produces.
	// Do a dry run to count, then a real emit pass.
	var blockOffsets @[]int = make_slice(int, len(f.Blocks))
	var totalInstrs int = 0
	for i := 0; i < len(f.Blocks); i++ {
		blockOffsets[i] = totalInstrs
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			if instr.Op == ir.OP_PHI {
				// Phi nodes don't emit directly — copies are inserted in predecessors
				continue
			}
			totalInstrs = totalInstrs + 1
			// Calls and multi-return emit extra MOVs
			if instr.Op == ir.OP_CALL ||
				(instr.Op == ir.OP_RETURN &&
					len(instr.Args) > 1) {
				totalInstrs = totalInstrs + len(instr.Args)
			}
			// OP_CALL_INDIRECT: fn_ptr is Args[0] and is read from
			// its register at execution; only Args[1..] need MOVs
			// to the contiguous callArgBase region.
			if instr.Op == ir.OP_CALL_INDIRECT {
				totalInstrs = totalInstrs + len(instr.Args) - 1
			}
			// OP_CALL_FUNC_VALUE: Args[0] is the function value's
			// register (read at execution); Args[1..] need MOVs to
			// callArgBase like OP_CALL_INDIRECT.
			if instr.Op == ir.OP_CALL_FUNC_VALUE {
				totalInstrs = totalInstrs + len(instr.Args) - 1
			}
			// OP_CALL_IFACE_METHOD: Args[0] is the interface
			// value's register; Args[1..] need MOVs.
			if instr.Op == ir.OP_CALL_IFACE_METHOD {
				totalInstrs = totalInstrs + len(instr.Args) - 1
			}
			// Global refs emit extra LOAD_IMM (one per occurrence).
			// Detection uses Instr.IsGlobalRef (set by lookupVar's
			// global-fallback path). Must NOT use a name-based
			// heuristic: a local alloca whose variable name happens
			// to collide with a global (e.g. a parameter named
			// `target` in a package that also declares
			// `var target TargetInfo`) would otherwise be routed to
			// the global's storage. Must match the third-pass
			// condition exactly so block offsets agree.
			for k := 0; k < len(instr.Args); k++ {
				if instr.Args[k] != nil &&
					instr.Args[k].IsGlobalRef &&
					lookupGlobalAddr(instr.Args[k].StrVal) != 0 {
					totalInstrs = totalInstrs + 1
				}
			}
		}
	}

	// Add space for phi copies (conservative: count all phi entries)
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			if blk.Instrs[j].Op == ir.OP_PHI {
				totalInstrs = totalInstrs + len(blk.Instrs[j].Phis)
			}
		}
	}

	// Third pass: emit bytecode
	var code @[]BCInstr = make_slice(BCInstr, totalInstrs)
	var codeIdx int = 0

	// Collect phi copies per block (inserted before terminator)
	// phiCopies[blockIdx] = list of (dst, src) pairs
	for i := 0; i < len(f.Blocks); i++ {
		blockOffsets[i] = codeIdx
		var blk @ir.Block = f.Blocks[i]

		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]

			if instr.Op == ir.OP_PHI {
				continue // handled by predecessor insertion
			}

			// Before terminators, insert phi copies for successor blocks
			if ir.IsTerminator(instr) {
				codeIdx = insertPhiCopies(f, code, codeIdx, blk, instr)
			}

			// Fix up global references: IR generation may share
			// the same pseudo-global-ref @Instr across multiple
			// uses (e.g. load-old-then-store-new of a global
			// managed slice). Detect via IsGlobalRef (set by
			// lookupVar) — name-based detection would falsely
			// match local allocas whose variable name collides
			// with a global. Emit LOAD_IMM per use — globalReg
			// may have been clobbered between uses.
			for k := 0; k < len(instr.Args); k++ {
				if instr.Args[k] != nil &&
					instr.Args[k].IsGlobalRef {
					var addr int = lookupGlobalAddr(
						instr.Args[k].StrVal)
					if addr == 0 { continue }
					var loadImm BCInstr
					loadImm.Op = BC_LOAD_IMM
					loadImm.Dst = globalReg
					loadImm.Imm = addr
					code[codeIdx] = loadImm
					codeIdx = codeIdx + 1
					instr.Args[k].ID = globalReg
				}
			}

			// For calls and multi-return, insert MOVs to pack
			// args into consecutive registers.
			if instr.Op == ir.OP_CALL ||
				(instr.Op == ir.OP_RETURN &&
					len(instr.Args) > 1) {
				for k := 0; k < len(instr.Args); k++ {
					var mov BCInstr
					mov.Op = BC_MOV
					mov.Dst = callArgBase + k
					mov.Src1 = instr.Args[k].ID
					code[codeIdx] = mov
					codeIdx = codeIdx + 1
				}
			}
			// OP_CALL_INDIRECT: pack only Args[1..] (Args[0] is fn_ptr,
			// passed via its own register). OP_CALL_FUNC_VALUE and
			// OP_CALL_IFACE_METHOD share the same arg-packing shape.
			if instr.Op == ir.OP_CALL_INDIRECT ||
				instr.Op == ir.OP_CALL_FUNC_VALUE ||
				instr.Op == ir.OP_CALL_IFACE_METHOD {
				for k := 1; k < len(instr.Args); k++ {
					var mov BCInstr
					mov.Op = BC_MOV
					mov.Dst = callArgBase + (k - 1)
					mov.Src1 = instr.Args[k].ID
					code[codeIdx] = mov
					codeIdx = codeIdx + 1
				}
			}
			var bc BCInstr = lowerInstr(instr,
				allocaOffsets, blockOffsets, f,
				callArgBase)
			code[codeIdx] = bc
			codeIdx = codeIdx + 1
		}
	}

	vmf.Code = code[:codeIdx]
	vmf.Names = curNames
	vmf.CallCache = make_slice(int, len(curNames))
	for i := 0; i < len(curNames); i++ {
		vmf.CallCache[i] = -2
	}
	vmf.Strings = moduleStrings
	return vmf
}

// insertPhiCopies inserts MOV instructions for phi nodes in
// successor blocks.
func insertPhiCopies(f @ir.Func, code @[]BCInstr, codeIdx int,
	curBlock @ir.Block, terminator @ir.Instr) int {
	// Find successor blocks
	if terminator.Block1 != nil {
		codeIdx = insertPhiCopiesForSucc(f, code, codeIdx, curBlock, terminator.Block1)
	}
	if terminator.Block2 != nil {
		codeIdx = insertPhiCopiesForSucc(f, code, codeIdx, curBlock, terminator.Block2)
	}
	return codeIdx
}

// insertPhiCopiesForSucc emits MOV for each phi in succBlock
// that has curBlock as predecessor.
func insertPhiCopiesForSucc(f @ir.Func, code @[]BCInstr,
	codeIdx int, curBlock @ir.Block,
	succBlock @ir.Block) int {
	for i := 0; i < len(succBlock.Instrs); i++ {
		var instr @ir.Instr = succBlock.Instrs[i]
		if instr.Op != ir.OP_PHI { break }
		// Find the phi entry for curBlock
		for j := 0; j < len(instr.Phis); j++ {
			if instr.Phis[j].Block == curBlock {
				var bc BCInstr
				bc.Op = BC_MOV
				bc.Dst = instr.ID
				bc.Src1 = instr.Phis[j].Val.ID
				code[codeIdx] = bc
				codeIdx = codeIdx + 1
			}
		}
	}
	return codeIdx
}

// findMaxCallArgs returns the maximum number of arguments in any
// call or multi-return instruction within the function.
func findMaxCallArgs(f @ir.Func) int {
	var max int = 0
	for i := 0; i < len(f.Blocks); i++ {
		var blk @ir.Block = f.Blocks[i]
		for j := 0; j < len(blk.Instrs); j++ {
			var instr @ir.Instr = blk.Instrs[j]
			var n int = 0
			if instr.Op == ir.OP_CALL {
				n = len(instr.Args)
			}
			if instr.Op == ir.OP_CALL_INDIRECT {
				n = len(instr.Args) - 1
			}
			if instr.Op == ir.OP_CALL_FUNC_VALUE {
				n = len(instr.Args) - 1
			}
			if instr.Op == ir.OP_CALL_IFACE_METHOD {
				n = len(instr.Args) - 1
			}
			if instr.Op == ir.OP_RETURN &&
				len(instr.Args) > 1 {
				n = len(instr.Args)
			}
			if n > max { max = n }
		}
	}
	return max
}

// findBlockOffset returns the bytecode index for a target block.
func findBlockOffset(f @ir.Func, target @ir.Block,
	blockOffsets *[]int) int {
	for i := 0; i < len(f.Blocks); i++ {
		if f.Blocks[i] == target {
			return blockOffsets[i]
		}
	}
	return 0
}

// Append helper
func appendVMFunc(s @[]@VMFunc, v @VMFunc) @[]@VMFunc {
	var n int = len(s)
	var ns @[]@VMFunc = make_slice(@VMFunc, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}
