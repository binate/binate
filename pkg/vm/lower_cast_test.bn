package "pkg/vm"

import "pkg/builtin/testing"

// Tests for OP_CAST lowering (lower_cast.bn).  Source-driven via
// lowerFromSource (from lower_test.bn) so the int↔float bytecode
// flavor selection is exercised through the real type-checker /
// lowering pipeline rather than a hand-rolled IR.

// Integer → float64 lowers to BC_SITOF.
func TestLowerCastIntToFloat64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float64 {\n")
	src = concatStr(src, "  return cast(float64, 5)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_SITOF { return "" }
	}
	return "expected BC_SITOF"
}

// float64 → int lowers to BC_FTOSI (not BC_F32TOSI — float64 src is
// 64-bit-wide on the source side).
func TestLowerCastFloat64ToInt() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x float64 = 5.0\n")
	src = concatStr(src, "  return cast(int, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_FTOSI { return "" }
	}
	return "expected BC_FTOSI"
}

// Width-narrowing int → uint8 lowers to BC_TRUNC8 — masks to 8 bits
// at the destination.
func TestLowerCastIntToUint8() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var b uint8 = cast(uint8, 300)\n")
	src = concatStr(src, "  return cast(int, b)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_TRUNC8 { return "" }
	}
	return "expected BC_TRUNC8"
}

// int32 → int64 widening must sign-extend (BC_SEXT with Imm=32) so
// that an int32 holding 0xFFFFFFFF widens to int64 = -1, not
// 4294967295.  This is the bug TestWiden64SignedVsUnsigned exposed
// when the -int unit-test runner first started working: lowering
// previously emitted BC_MOV for single-slot int width changes, which
// preserved the source's stored bits unchanged regardless of sign.
func TestLowerCastInt32SignExtendsToInt64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var n int32 = cast(int32, -1)\n")
	src = concatStr(src, "  var w int64 = cast(int64, n)\n")
	src = concatStr(src, "  if w == cast(int64, -1) { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 {
		return "int32(-1) should sign-extend to int64(-1)"
	}
	return ""
}

// uint32 → uint64 must zero-extend (BC_ZEXT with Imm=32) so a uint32
// holding 0xFFFFFFFF widens to uint64 = 4294967295, NOT -1.  The
// signed-vs-unsigned widening choice keys off the source's sign.
func TestLowerCastUint32ZeroExtendsToUint64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var n uint32 = cast(uint32, 4294967295)\n")
	src = concatStr(src, "  var w uint64 = cast(uint64, n)\n")
	src = concatStr(src, "  if w == cast(uint64, 4294967295) { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 {
		return "uint32(max) should zero-extend to uint64(max), not sign-extend to -1"
	}
	return ""
}

// Same-width float64 → float64 (e.g. through an untyped intermediate)
// lowers to BC_MOV — the bitcast path falls through every
// width-conversion branch and lands on the default register copy.
func TestLowerCastFloat64ToFloat64() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() float64 {\n")
	src = concatStr(src, "  var x float64 = 2.5\n")
	src = concatStr(src, "  return cast(float64, x)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	// Just confirm lowering didn't produce a width-conversion op:
	// BC_F64_TO_F32 / BC_F32_TO_F64 would indicate a misfired
	// width-change path.
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		var op int = vm.Funcs[0].Code[i].Op
		if op == BC_F64_TO_F32 || op == BC_F32_TO_F64 {
			return "same-width float64 cast must not emit a width conv"
		}
	}
	return ""
}
