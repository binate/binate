package "pkg/vm"

import "pkg/ir"
import "pkg/types"

// lowerInstr converts one IR instruction to one bytecode instruction.
func lowerInstr(instr @ir.Instr, allocaOffsets *[]int,
	blockOffsets *[]int, f @ir.Func,
	callArgBase int) BCInstr {
	var bc BCInstr
	bc.Dst = instr.ID

	// Constants
	if instr.Op == ir.OP_CONST_INT {
		bc.Op = BC_LOAD_IMM
		bc.Imm = instr.IntVal
		return bc
	}
	if instr.Op == ir.OP_CONST_BOOL {
		bc.Op = BC_LOAD_IMM
		if instr.BoolVal { bc.Imm = 1 } else { bc.Imm = 0 }
		return bc
	}
	if instr.Op == ir.OP_CONST_NIL {
		bc.Op = BC_LOAD_IMM
		bc.Imm = 0
		return bc
	}
	if instr.Op == ir.OP_CONST_STRING {
		bc.Op = BC_LOAD_STR
		bc.Imm = ir.FindStringID(curStrings, instr.StrVal)
		return bc
	}
	if instr.Op == ir.OP_CONST_FLOAT {
		// Parse the raw literal text to a float64, then bit-cast to
		// an int so it fits the BC_LOAD_IMM immediate slot.
		bc.Op = BC_LOAD_IMM
		bc.Imm = bit_cast(int, parseFloatLit(instr.StrVal))
		return bc
	}

	// Arithmetic — binary ops: Dst = Src1 op Src2
	if instr.Op == ir.OP_ADD || instr.Op == ir.OP_SUB ||
		instr.Op == ir.OP_MUL || instr.Op == ir.OP_DIV ||
		instr.Op == ir.OP_REM || instr.Op == ir.OP_AND ||
		instr.Op == ir.OP_OR || instr.Op == ir.OP_XOR ||
		instr.Op == ir.OP_SHL || instr.Op == ir.OP_SHR {
		bc.Op = lowerBinOp(instr)
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// Comparison — binary ops: Dst = Src1 cmp Src2
	if instr.Op == ir.OP_EQ || instr.Op == ir.OP_NE ||
		instr.Op == ir.OP_LT || instr.Op == ir.OP_LE ||
		instr.Op == ir.OP_GT || instr.Op == ir.OP_GE {
		bc.Op = lowerCmpOp(instr)
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// Unary
	if instr.Op == ir.OP_NEG {
		if instr.Typ != nil && types.IsFloat(instr.Typ) {
			bc.Op = BC_FNEG
		} else {
			bc.Op = BC_NEG
		}
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_NOT {
		bc.Op = BC_NOT
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_BITNOT {
		bc.Op = BC_BITNOT
		bc.Src1 = instr.Args[0].ID
		return bc
	}

	// Logical AND/OR (non-short-circuit in this context)
	if instr.Op == ir.OP_LAND {
		bc.Op = BC_AND
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}
	if instr.Op == ir.OP_LOR {
		bc.Op = BC_OR
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// --- Memory ---

	if instr.Op == ir.OP_ALLOC {
		bc.Op = BC_STACK_ALLOC
		bc.Imm = allocaOffsets[instr.ID]
		return bc
	}
	if instr.Op == ir.OP_LOAD {
		return lowerLoad(instr, bc)
	}
	if instr.Op == ir.OP_STORE {
		return lowerStore(instr, bc)
	}
	if instr.Op == ir.OP_GET_FIELD_PTR {
		return lowerGetFieldPtr(instr, bc)
	}
	if instr.Op == ir.OP_GET_ELEM_PTR {
		bc.Op = BC_ELEM_PTR
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		if instr.Typ != nil && instr.Typ.Elem != nil {
			bc.Imm = types.SizeOf(instr.Typ.Elem)
		} else {
			bc.Imm = 8
		}
		return bc
	}

	// --- Control flow ---

	if instr.Op == ir.OP_JUMP {
		bc.Op = BC_JUMP
		bc.Dst = -1
		bc.Aux = findBlockOffset(
			f, instr.Block1, blockOffsets)
		return bc
	}
	if instr.Op == ir.OP_BRANCH {
		bc.Op = BC_BRANCH
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Imm = findBlockOffset(
			f, instr.Block1, blockOffsets)
		bc.Aux = findBlockOffset(
			f, instr.Block2, blockOffsets)
		return bc
	}
	if instr.Op == ir.OP_RETURN {
		return lowerReturn(instr, bc, callArgBase)
	}

	// --- Managed memory ---

	if instr.Op == ir.OP_REFCOUNT_INC {
		bc.Op = BC_REFINC
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_REFINC {
		// Fused inline-RefInc bytecode: one dispatch handles the
		// nil-check + header load/add/store. Single dispatch is
		// the dominant VM win over lowering to ~5 primitive ops.
		bc.Op = BC_REFINC_INLINE
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_REFCOUNT_DEC {
		bc.Op = BC_REFDEC
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = -1  // -1 means null dtor
		if len(instr.Args) > 1 {
			bc.Src2 = instr.Args[1].ID
		}
		return bc
	}
	if instr.Op == ir.OP_BOX {
		return lowerBox(instr, bc)
	}
	if instr.Op == ir.OP_MAKE {
		bc.Op = BC_ALLOC
		if instr.TypeArg != nil {
			bc.Imm = types.SizeOf(instr.TypeArg)
		} else {
			bc.Imm = 8
		}
		return bc
	}
	if instr.Op == ir.OP_MAKE_SLICE {
		bc.Op = BC_MAKE_SLICE
		bc.Src1 = instr.Args[0].ID
		if instr.TypeArg != nil {
			bc.Imm = types.SizeOf(instr.TypeArg)
		} else {
			bc.Imm = 8
		}
		return bc
	}
	if instr.Op == ir.OP_DEREF {
		bc.Op = BC_LOAD64
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_NIL_CHECK {
		bc.Op = BC_NIL_CHECK
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_BOUNDS_CHECK {
		bc.Op = BC_BOUNDS_CHECK
		bc.Dst = -1
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = instr.Args[1].ID
		return bc
	}

	// --- Conversions ---

	if instr.Op == ir.OP_CAST {
		var srcTyp @types.Type = instr.Args[0].Typ
		var dstTyp @types.Type = instr.TypeArg
		var srcIsFloat bool = srcTyp != nil &&
			(srcTyp.Kind == types.TYP_FLOAT ||
				srcTyp.Kind == types.TYP_UNTYPED_FLOAT)
		var dstIsFloat bool = dstTyp != nil &&
			(dstTyp.Kind == types.TYP_FLOAT ||
				dstTyp.Kind == types.TYP_UNTYPED_FLOAT)
		// VM register form for floats: the IEEE bits in the type's
		// declared width — float64 in 8 bytes, float32 in low 4
		// bytes (zero-extended). Untyped-float literals start at
		// float64 precision (BC_LOAD_IMM stores the parsed float64
		// bit pattern), so for cast-emission purposes we treat them
		// as 64-bit on the source side.
		var srcW int = 64
		if srcTyp != nil && srcTyp.Kind == types.TYP_FLOAT &&
				srcTyp.Width > 0 {
			srcW = srcTyp.Width
		}
		var dstW int = 64
		if dstTyp != nil && dstTyp.Kind == types.TYP_FLOAT &&
				dstTyp.Width > 0 {
			dstW = dstTyp.Width
		}
		if !srcIsFloat && dstIsFloat {
			// Integer → float. BC_SITOF lands at float64; if dst is
			// float32 we narrow afterwards. Today narrowing-int-to-
			// f32 isn't exercised; emit the simple form and let
			// future work add a fused BC_SITOF32 if needed.
			bc.Op = BC_SITOF
		} else if srcIsFloat && !dstIsFloat {
			if srcW == 32 {
				bc.Op = BC_F32TOSI
			} else {
				bc.Op = BC_FTOSI
			}
		} else if srcIsFloat && dstIsFloat {
			if srcW == 64 && dstW == 32 {
				bc.Op = BC_F64_TO_F32
			} else if srcW == 32 && dstW == 64 {
				bc.Op = BC_F32_TO_F64
			} else {
				bc.Op = BC_MOV
			}
		} else if dstTyp != nil && dstTyp.Width == 8 {
			bc.Op = BC_TRUNC8
		} else {
			bc.Op = BC_MOV
		}
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_BIT_CAST {
		bc.Op = BC_MOV
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_MANAGED_TO_RAW {
		bc.Op = BC_MOV
		bc.Src1 = instr.Args[0].ID
		return bc
	}
	if instr.Op == ir.OP_RODATA_ARRAY {
		// Phase 3.2b: copy bytes into a fresh stack buffer of size N
		// (the destination array length), zero-padded. Returns a
		// pointer to the buffer; the subsequent OP_STORE on the array
		// alloca memcpys the bytes into place.
		bc.Op = BC_STRING_COPY_ARR
		bc.Imm = ir.FindStringID(curStrings, instr.StrVal)
		var arrLen int = 0
		if instr.Typ != nil && instr.Typ.Kind == types.TYP_ARRAY {
			arrLen = instr.Typ.ArrayLen
		}
		bc.Aux = arrLen
		return bc
	}

	// Phase 3: rodata composite-literal ops. Both produce a slice
	// header pointing into rodata. Reuse BC_LOAD_STR — the VM's
	// %BnManagedSlice prefix `{data, len, ...}` is also valid as
	// a 2-word `*[]const T` (consumer reads only fields 0 and 1).
	if instr.Op == ir.OP_RODATA_MSLICE ||
			instr.Op == ir.OP_RODATA_SLICE {
		bc.Op = BC_LOAD_STR
		bc.Imm = ir.FindStringID(curStrings, instr.StrVal)
		bc.Aux = 1 // load header pointer (data + len + ...)
		return bc
	}
	if instr.Op == ir.OP_RODATA_MSLICE_COPY {
		bc.Op = BC_STRING_COPY_MS
		bc.Imm = ir.FindStringID(curStrings, instr.StrVal)
		return bc
	}

	// --- Struct/Extract ---

	if instr.Op == ir.OP_EXTRACT {
		bc.Op = BC_EXTRACT
		bc.Src1 = instr.Args[0].ID
		var srcTyp @types.Type = instr.Args[0].Typ
		if srcTyp != nil {
			srcTyp = resolveToStruct(srcTyp)
		}
		if srcTyp != nil &&
			srcTyp.Kind == types.TYP_STRUCT {
			// Anonymous multi-return struct or named struct.
			// Use byte offset and detect multi-word fields.
			bc.Imm = types.FieldOffset(srcTyp, instr.Index)
			if instr.Index < len(srcTyp.Fields) {
				var ft @types.Type =
					srcTyp.Fields[instr.Index].Type
				if isMultiWordField(ft) {
					bc.Aux = 1 // pointer mode
				}
			}
		} else {
			// Legacy: word-indexed (managed-slice fields)
			bc.Imm = instr.Index
			bc.Aux = 2
		}
		return bc
	}
	if instr.Op == ir.OP_FUNC_ADDR {
		bc.Op = BC_FUNC_ADDR
		bc.Aux = addName(qualifyCallName(instr.StrVal))
		return bc
	}
	if instr.Op == ir.OP_FUNC_VALUE {
		bc.Op = BC_FUNC_VALUE
		bc.Aux = addName(qualifyCallName(instr.StrVal))
		return bc
	}
	if instr.Op == ir.OP_STRUCT_LIT {
		bc.Op = BC_NOP
		bc.Dst = -1
		return bc
	}
	if instr.Op == ir.OP_UNREACHABLE {
		bc.Op = BC_NOP
		bc.Dst = -1
		return bc
	}
	if instr.Op == ir.OP_PANIC {
		bc.Op = BC_NOP // TODO: implement panic
		bc.Dst = -1
		return bc
	}

	// --- Calls ---

	if instr.Op == ir.OP_CALL {
		bc.Op = BC_CALL
		bc.Imm = len(instr.Args)
		bc.Src1 = callArgBase
		bc.Aux = addName(qualifyCallName(instr.StrVal))
		return bc
	}
	if instr.Op == ir.OP_CALL_INDIRECT {
		// Args[0] = fn_ptr (1-based VM function index in this register);
		// Args[1..] are pre-packed into [callArgBase, callArgBase+N-1].
		bc.Op = BC_CALL_INDIRECT
		bc.Src1 = instr.Args[0].ID
		bc.Src2 = callArgBase
		bc.Imm = len(instr.Args) - 1
		return bc
	}
	// Default: NOP with warning
	bc.Op = BC_NOP
	bc.Dst = -1
	return bc
}

// --- Helper functions ---

// lowerReturn handles OP_RETURN for void, single, and multi-return.
//
// For single return, bc.Aux encodes the byte count to copy back if
// retVal points into the callee's stack region. Aggregate types
// (struct/array/slice/managed-slice) live in the callee's frame and
// must be copied to caller space; otherwise the BC_RETURN pop would
// leak the entire callee frame on every call (see vm.bn BC_RETURN
// for the runtime side). Scalars/pointers fit in a register; Aux=0
// signals "no copy needed".
func lowerReturn(instr @ir.Instr, bc BCInstr,
	callArgBase int) BCInstr {
	bc.Op = BC_RETURN
	if len(instr.Args) == 0 {
		bc.Dst = -1
	} else if len(instr.Args) == 1 {
		bc.Dst = 0
		bc.Src1 = instr.Args[0].ID
		var argTyp @types.Type = instr.Args[0].Typ
		if isMultiWordField(argTyp) {
			bc.Aux = types.SizeOf(argTyp)
		}
	} else {
		bc.Dst = len(instr.Args)
		bc.Src1 = callArgBase
		bc.Imm = len(instr.Args)
	}
	return bc
}

// lowerBox handles OP_BOX with proper size resolution.
func lowerBox(instr @ir.Instr, bc BCInstr) BCInstr {
	bc.Op = BC_BOX
	bc.Src1 = instr.Args[0].ID
	if instr.TypeArg != nil {
		bc.Imm = types.SizeOf(instr.TypeArg)
	} else if instr.Typ != nil && instr.Typ.Elem != nil {
		bc.Imm = types.SizeOf(instr.Typ.Elem)
	} else if instr.Args[0].TypeArg != nil {
		bc.Imm = types.SizeOf(instr.Args[0].TypeArg)
	} else {
		bc.Imm = 8
	}
	return bc
}

// isMultiWordField returns true if a type is a multi-word value
// stored as a pointer in VM registers (struct, slice, managed-slice,
// array). Used to decide if EXTRACT should return a pointer vs load.
func isMultiWordField(t @types.Type) bool {
	if t == nil { return false }
	t = types.ResolveAlias(t)
	if t.Kind == types.TYP_NAMED && t.Underlying != nil {
		t = t.Underlying
	}
	if t.Kind == types.TYP_STRUCT { return true }
	if t.Kind == types.TYP_SLICE { return true }
	if t.Kind == types.TYP_MANAGED_SLICE { return true }
	if t.Kind == types.TYP_ARRAY { return true }
	return false
}

// resolveToStruct resolves a type through aliases, named types,
// and Underlying pointers to find the concrete struct (or slice)
// type with fields. Returns the original type if already concrete.
func resolveToStruct(t @types.Type) @types.Type {
	// Try ResolveAlias first
	t = types.ResolveAlias(t)
	// Resolve TYP_NAMED via Underlying
	for t != nil && t.Kind == types.TYP_NAMED {
		if t.Underlying != nil {
			t = t.Underlying
		} else if len(t.Fields) > 0 {
			// Named type has fields directly
			return t
		} else {
			break
		}
	}
	return t
}

// lowerBinOp maps an IR binary arithmetic op to a bytecode opcode.
// Floating-point operands dispatch to the BC_F* opcode family.
func lowerBinOp(instr @ir.Instr) int {
	var isFloat bool = instr.Typ != nil && types.IsFloat(instr.Typ)
	if instr.Op == ir.OP_ADD {
		if isFloat { return BC_FADD }
		return BC_ADD
	}
	if instr.Op == ir.OP_SUB {
		if isFloat { return BC_FSUB }
		return BC_SUB
	}
	if instr.Op == ir.OP_MUL {
		if isFloat { return BC_FMUL }
		return BC_MUL
	}
	if instr.Op == ir.OP_DIV {
		if isFloat { return BC_FDIV }
		return BC_DIV
	}
	if instr.Op == ir.OP_REM { return BC_REM }
	if instr.Op == ir.OP_AND { return BC_AND }
	if instr.Op == ir.OP_OR  { return BC_OR }
	if instr.Op == ir.OP_XOR { return BC_XOR }
	if instr.Op == ir.OP_SHL { return BC_SHL }
	if instr.Op == ir.OP_SHR { return BC_SHR }
	return BC_NOP
}

// lowerCmpOp maps an IR comparison op to a bytecode opcode.
// Floating-point operand types dispatch to BC_F* comparison opcodes.
func lowerCmpOp(instr @ir.Instr) int {
	var isFloat bool = false
	if len(instr.Args) > 0 && instr.Args[0].Typ != nil {
		isFloat = types.IsFloat(instr.Args[0].Typ)
	}
	if instr.Op == ir.OP_EQ {
		if isFloat { return BC_FEQ }
		return BC_EQ
	}
	if instr.Op == ir.OP_NE {
		if isFloat { return BC_FNE }
		return BC_NE
	}
	if instr.Op == ir.OP_LT {
		if isFloat { return BC_FLT }
		return BC_SLT
	}
	if instr.Op == ir.OP_LE {
		if isFloat { return BC_FLE }
		return BC_SLE
	}
	if instr.Op == ir.OP_GT {
		if isFloat { return BC_FGT }
		return BC_SGT
	}
	if instr.Op == ir.OP_GE {
		if isFloat { return BC_FGE }
		return BC_SGE
	}
	return BC_NOP
}
