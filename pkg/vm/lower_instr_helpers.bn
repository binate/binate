package "pkg/vm"

import "pkg/ir"
import "pkg/types"

// Per-op handlers and op-map helpers extracted from lower_instr.bn.
// lowerInstr in lower_instr.bn calls into these:
//
//   - lowerReturn / lowerBox: per-op lowering helpers, too complex
//     for an inline arm in lowerInstr's dispatch.
//   - lowerBinOp / lowerCmpOp: IR-op → BC-op mapping tables.
//   - isMultiWordField / resolveToStruct: struct-shape queries used
//     by lowerReturn and the OP_EXTRACT arm.

// --- Helper functions ---

// lowerReturn handles OP_RETURN for void, single, and multi-return.
//
// For single return, bc.Aux encodes the byte count to copy back if
// retVal points into the callee's stack region. Aggregate types
// (struct/array/slice/managed-slice) live in the callee's frame and
// must be copied to caller space; otherwise the BC_RETURN pop would
// leak the entire callee frame on every call (see vm.bn BC_RETURN
// for the runtime side). Scalars/pointers fit in a register; Aux=0
// signals "no copy needed".
func lowerReturn(instr @ir.Instr, bc BCInstr,
	callArgBase int) BCInstr {
	bc.Op = BC_RETURN
	if len(instr.Args) == 0 {
		bc.Dst = -1
	} else if len(instr.Args) == 1 {
		bc.Dst = 0
		bc.Src1 = instr.Args[0].ID
		var argTyp @types.Type = instr.Args[0].Typ
		if isMultiWordField(argTyp) {
			bc.Aux = argTyp.SizeOf()
		}
	} else {
		bc.Dst = len(instr.Args)
		bc.Src1 = callArgBase
		bc.Imm = len(instr.Args)
	}
	return bc
}

// lowerBox handles OP_BOX with proper size resolution.
func lowerBox(instr @ir.Instr, bc BCInstr) BCInstr {
	bc.Op = BC_BOX
	bc.Src1 = instr.Args[0].ID
	if instr.TypeArg != nil {
		bc.Imm = instr.TypeArg.SizeOf()
	} else if instr.Typ != nil && instr.Typ.Elem != nil {
		bc.Imm = instr.Typ.Elem.SizeOf()
	} else if instr.Args[0].TypeArg != nil {
		bc.Imm = instr.Args[0].TypeArg.SizeOf()
	} else {
		bc.Imm = 8
	}
	return bc
}

// isMultiWordField returns true if a type is a multi-word value
// stored as a pointer in VM registers (struct, slice, managed-slice,
// array). Used to decide if EXTRACT should return a pointer vs load.
func isMultiWordField(t @types.Type) bool {
	if t == nil { return false }
	t = t.ResolveAlias()
	if t.Kind == types.TYP_NAMED && t.Underlying != nil {
		t = t.Underlying
	}
	if t.Kind == types.TYP_STRUCT { return true }
	if t.Kind == types.TYP_SLICE { return true }
	if t.Kind == types.TYP_MANAGED_SLICE { return true }
	if t.Kind == types.TYP_ARRAY { return true }
	return false
}

// resolveToStruct resolves a type through aliases, named types,
// and Underlying pointers to find the concrete struct (or slice)
// type with fields. Returns the original type if already concrete.
func resolveToStruct(t @types.Type) @types.Type {
	// Try ResolveAlias first
	t = t.ResolveAlias()
	// Resolve TYP_NAMED via Underlying
	for t != nil && t.Kind == types.TYP_NAMED {
		if t.Underlying != nil {
			t = t.Underlying
		} else if len(t.Fields) > 0 {
			// Named type has fields directly
			return t
		} else {
			break
		}
	}
	return t
}

// lowerBinOp maps an IR binary arithmetic op to a bytecode opcode.
// Floating-point operands dispatch to the BC_F* family.  Integer
// 64-bit-scalar results on a host whose word is < 8 bytes dispatch to
// the BC_*64 (register-pair) family — see Layer 2 step 3.  (A float64
// pair on 32-bit would need BC_F*64 ops, which are not yet added;
// such programs currently fall through to the non-pair path on that
// host.)
func lowerBinOp(instr @ir.Instr) int {
	var isFloat bool = instr.Typ != nil && instr.Typ.IsFloat()
	// Unsigned-integer DIV / REM need their own opcodes: signed
	// `/` and `%` on uint values with the high bit set give wrong
	// results (e.g. uint64Max / 7 evaluated signed is 0).
	var isUnsigned bool = instr.Typ != nil &&
		instr.Typ.IsInteger() && !instr.Typ.Signed
	var isIntPair bool = !isFloat && is64BitScalar(instr.Typ) &&
		REG_SLOT < 8
	if instr.Op == ir.OP_ADD {
		if isIntPair { return BC_ADD64 }
		if isFloat { return BC_FADD }
		return BC_ADD
	}
	if instr.Op == ir.OP_SUB {
		if isIntPair { return BC_SUB64 }
		if isFloat { return BC_FSUB }
		return BC_SUB
	}
	if instr.Op == ir.OP_MUL {
		if isIntPair { return BC_MUL64 }
		if isFloat { return BC_FMUL }
		return BC_MUL
	}
	if instr.Op == ir.OP_DIV {
		if isIntPair {
			if isUnsigned { return BC_UDIV64 }
			return BC_DIV64
		}
		if isFloat { return BC_FDIV }
		if isUnsigned { return BC_UDIV }
		return BC_DIV
	}
	if instr.Op == ir.OP_REM {
		if isIntPair {
			if isUnsigned { return BC_UREM64 }
			return BC_REM64
		}
		if isUnsigned { return BC_UREM }
		return BC_REM
	}
	if instr.Op == ir.OP_AND {
		if isIntPair { return BC_AND64 }
		return BC_AND
	}
	if instr.Op == ir.OP_OR {
		if isIntPair { return BC_OR64 }
		return BC_OR
	}
	if instr.Op == ir.OP_XOR {
		if isIntPair { return BC_XOR64 }
		return BC_XOR
	}
	if instr.Op == ir.OP_SHL {
		if isIntPair { return BC_SHL64 }
		return BC_SHL
	}
	if instr.Op == ir.OP_SHR {
		if isIntPair {
			if isUnsigned { return BC_LSHR64 }
			return BC_SHR64
		}
		if isUnsigned { return BC_LSHR }
		return BC_SHR
	}
	return BC_NOP
}

// lowerCmpOp maps an IR comparison op to a bytecode opcode.
// Floating-point operand types dispatch to BC_F* comparison opcodes;
// unsigned-integer types dispatch to BC_U* (otherwise the executor's
// signed `<` / `>` on the register's int representation gives wrong
// results for uint values with the high bit set).
func lowerCmpOp(instr @ir.Instr) int {
	var isFloat bool = false
	var isUnsigned bool = false
	var isIntPair bool = false
	if len(instr.Args) > 0 && instr.Args[0].Typ != nil {
		var t @types.Type = instr.Args[0].Typ
		isFloat = t.IsFloat()
		isUnsigned = t.IsInteger() && !t.Signed
		isIntPair = !isFloat && is64BitScalar(t) && REG_SLOT < 8
	}
	if instr.Op == ir.OP_EQ {
		if isIntPair { return BC_EQ64 }
		if isFloat { return BC_FEQ }
		return BC_EQ
	}
	if instr.Op == ir.OP_NE {
		if isIntPair { return BC_NE64 }
		if isFloat { return BC_FNE }
		return BC_NE
	}
	if instr.Op == ir.OP_LT {
		if isIntPair {
			if isUnsigned { return BC_ULT64 }
			return BC_SLT64
		}
		if isFloat { return BC_FLT }
		if isUnsigned { return BC_ULT }
		return BC_SLT
	}
	if instr.Op == ir.OP_LE {
		if isIntPair {
			if isUnsigned { return BC_ULE64 }
			return BC_SLE64
		}
		if isFloat { return BC_FLE }
		if isUnsigned { return BC_ULE }
		return BC_SLE
	}
	if instr.Op == ir.OP_GT {
		if isIntPair {
			if isUnsigned { return BC_UGT64 }
			return BC_SGT64
		}
		if isFloat { return BC_FGT }
		if isUnsigned { return BC_UGT }
		return BC_SGT
	}
	if instr.Op == ir.OP_GE {
		if isIntPair {
			if isUnsigned { return BC_UGE64 }
			return BC_SGE64
		}
		if isFloat { return BC_FGE }
		if isUnsigned { return BC_UGE }
		return BC_SGE
	}
	return BC_NOP
}
