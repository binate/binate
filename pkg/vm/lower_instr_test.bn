package "pkg/vm"

import "pkg/builtin/testing"
import "pkg/ir"

// Tests for instruction-level lowering (lower_instr.bn).
// Uses lowerFromSource and concatStr from lower_test.bn.

func TestLowerArithOpcodes() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  return 3 + 4 * 5 - 2\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasAdd bool = false
	var hasMul bool = false
	var hasSub bool = false
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		var op int = vm.Funcs[0].Code[i].Op
		if op == BC_ADD { hasAdd = true }
		if op == BC_MUL { hasMul = true }
		if op == BC_SUB { hasSub = true }
	}
	if !hasAdd { return "expected BC_ADD" }
	if !hasMul { return "expected BC_MUL" }
	if !hasSub { return "expected BC_SUB" }
	return ""
}

func TestLowerCompareOpcodes() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x int = 5\n")
	src = concatStr(src, "  if x > 3 { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasCmp bool = false
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_SGT {
			hasCmp = true
		}
	}
	if !hasCmp { return "expected BC_SGT" }
	return ""
}

func TestLowerMemoryOps() testing.TestResult {
	// Check that struct field access generates FIELD_PTR
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "type P struct { X int; Y int }\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var p P\n")
	src = concatStr(src, "  p.X = 1\n")
	src = concatStr(src, "  return p.X\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasFieldPtr bool = false
	var hasStackAlloc bool = false
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_FIELD_PTR {
			hasFieldPtr = true
		}
		if vm.Funcs[0].Code[i].Op == BC_STACK_ALLOC {
			hasStackAlloc = true
		}
	}
	if !hasStackAlloc { return "expected BC_STACK_ALLOC" }
	if !hasFieldPtr { return "expected BC_FIELD_PTR" }
	return ""
}

func TestLowerCallArgPacking() testing.TestResult {
	// Calls should emit MOV instructions to pack args
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func add(a int, b int) int {\n")
	src = concatStr(src, "  return a + b\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  return add(10, 20)\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	// Find main's BC_CALL and verify MOVs precede it
	var mainIdx int = -1
	for i := 0; i < len(vm.Funcs); i++ {
		if streq(vm.Funcs[i].Name, "test.main") {
			mainIdx = i
		}
	}
	if mainIdx < 0 { return "main not found" }
	var callIdx int = -1
	for i := 0; i < len(vm.Funcs[mainIdx].Code); i++ {
		if vm.Funcs[mainIdx].Code[i].Op == BC_CALL {
			callIdx = i
		}
	}
	if callIdx < 0 { return "expected BC_CALL" }
	// Should have MOVs before the call for arg packing
	if callIdx < 2 { return "expected MOVs before BC_CALL" }
	if vm.Funcs[mainIdx].Code[callIdx-1].Op != BC_MOV &&
		vm.Funcs[mainIdx].Code[callIdx-2].Op != BC_MOV {
		return "expected MOV for arg packing"
	}
	return ""
}

func TestLowerRefcountOps() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var p @int = make(int)\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var hasAlloc bool = false
	var hasRefDec bool = false
	for i := 0; i < len(vm.Funcs[0].Code); i++ {
		if vm.Funcs[0].Code[i].Op == BC_ALLOC {
			hasAlloc = true
		}
		if vm.Funcs[0].Code[i].Op == BC_REFDEC {
			hasRefDec = true
		}
	}
	if !hasAlloc { return "expected BC_ALLOC" }
	if !hasRefDec { return "expected BC_REFDEC" }
	return ""
}
