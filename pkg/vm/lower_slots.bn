package "pkg/vm"

import "pkg/ir"
import "pkg/types"

// Register-slot allocation for the bytecode VM.  A VM register slot is
// one host word (REG_SLOT bytes).  A 64-bit scalar value that does not
// fit one slot — i.e. on a host whose word is smaller than 8 bytes —
// occupies a pair of consecutive slots.  See
// explorations/plan-vm-64bit-on-32bit.md (Layer 2).

// is64BitScalar reports whether a register holding a value of type t
// needs 64 bits — t is a 64-bit scalar (int64 / uint64 / float64).
// A pointer, a narrower integer, host-width `int` (32-bit on a 32-bit
// target), and float32 all fit one host-word slot, so they are not
// wide.  Aggregates never live in a register directly (a register
// holds a pointer to them), so they are not considered here.
func is64BitScalar(t @types.Type) bool {
	if t == nil { return false }
	if t.Kind == types.TYP_INT && t.Width == 64 { return true }
	if t.Kind == types.TYP_FLOAT && t.Width == 64 { return true }
	// Untyped float literals default to float64 — IR-gen emits them
	// with Typ = TypUntypedFloat (no Width set), so a plain
	// Kind+Width check misses them.  Treat them as 64-bit so the
	// slot allocator reserves a pair (and lowering emits the pair-
	// aware BC_LOAD_IMM64).  Untyped int is NOT included here:
	// untyped int defaults to host-`int`, which is 32-bit on a 32-bit
	// target — not pair-wide.
	if t.Kind == types.TYP_UNTYPED_FLOAT { return true }
	return false
}

// buildSlotMap assigns each register (indexed by its old register
// number) a base slot.  A register flagged wide reserves two
// consecutive slots; every other register reserves one.  Returns the
// per-register base-slot table and the total slot count.
//
// Pure (no IR / host dependency) so the slot arithmetic — the part
// where an off-by-one silently corrupts the 32-bit frame — is
// unit-testable on any host by passing the wide-flags directly.  The
// live caller derives the flags from the IR func and REG_SLOT, and on
// a 64-bit host passes all-false (identity mapping).
func buildSlotMap(wide *[]bool) (@[]int, int) {
	var n int = len(wide)
	var slotOf @[]int = make_slice(int, n)
	var slot int = 0
	for i := 0; i < n; i++ {
		slotOf[i] = slot
		if wide[i] {
			slot = slot + 2
		} else {
			slot = slot + 1
		}
	}
	return slotOf, slot
}

// splitInt64 splits a 64-bit value into its low and high 32-bit
// halves, each returned as a host `int` bit pattern (a half with its
// bit 31 set reads back as a negative int32 on a 32-bit host — that
// is fine, joinInt64 reinterprets via uint32).  A 64-bit value lives
// in a VM register pair (base slot = low, base+1 = high) on a host
// whose word is < 8 bytes; this packs a constant into that pair.
func splitInt64(v int64) (int, int) {
	var lo int = cast(int, v & cast(int64, 0xFFFFFFFF))
	var hi int = cast(int, (v >> cast(int64, 32)) & cast(int64, 0xFFFFFFFF))
	return lo, hi
}

// joinInt64 reassembles a 64-bit value from its low/high 32-bit
// halves.  Each half is zero-extended through uint32 first, so a
// high-bit-set low half does not sign-pollute the upper 32 bits — the
// subtle step that, if dropped, silently corrupts 64-bit values only
// on a 32-bit host.
func joinInt64(lo int, hi int) int64 {
	return cast(int64, cast(uint32, lo)) |
		(cast(int64, cast(uint32, hi)) << cast(int64, 32))
}

// argSlots returns the number of register slots a value of type t
// occupies when packed into the call-arg region (or, equivalently,
// the number of slots a same-typed param occupies in the callee's
// register file): 2 for a 64-bit scalar on a host whose word is <
// 8 bytes, 1 otherwise.  Used both for sizing the call-arg region
// and for packed-arg ↔ packed-slot accounting in BC_CALL.
func argSlots(t @types.Type) int {
	if is64BitScalar(t) && REG_SLOT < 8 {
		return 2
	}
	return 1
}

// remapRegisters rewrites every instruction's register fields through
// the id→slot map (in place).  Src1 and Src2 hold a register (or -1)
// at every emission site, as does Dst — with one audited exception:
// BC_RETURN / BC_RETURN64 both use Dst as a shape code (-1 / 0 /
// arg-count, set by lowerReturn), not a register, so it is left
// intact.  Arg counts ride in Imm and names/targets in Aux, neither
// of which is remapped.
//
// Concentrating the remap here (rather than wrapping each of the ~50
// register-id emission sites) keeps it auditable: a missed wrap would
// be invisible on a 64-bit host, where slotOf is the identity.  The
// "registers except BC_RETURN*.Dst" invariant must hold as opcodes
// are added — TestRemapRegisters pins the exception.
func remapRegisters(code @[]BCInstr, slotOf *[]int) {
	for i := 0; i < len(code); i++ {
		var bc BCInstr = code[i]
		if bc.Op != BC_RETURN && bc.Op != BC_RETURN64 &&
				bc.Dst >= 0 {
			bc.Dst = slotOf[bc.Dst]
		}
		if bc.Src1 >= 0 {
			bc.Src1 = slotOf[bc.Src1]
		}
		if bc.Src2 >= 0 {
			bc.Src2 = slotOf[bc.Src2]
		}
		code[i] = bc
	}
}

// regWidths builds the per-register wide-flags for func f's register
// space [0, numRegs).  A register is wide when it holds a 64-bit
// scalar value AND the host word (wordSize bytes) cannot hold it in
// one slot.  Register indices are IR value ids: params occupy the low
// ids and instruction results take the rest, both carrying the value
// type.  Returns all-false when wordSize >= 8 (a 64-bit host needs no
// pairs — int64 fits one slot).
//
// Extra registers at/after f.NextID (call-arg packing, globalReg) are
// left narrow here; 64-bit call args are handled by step 2b.
func regWidths(f @ir.Func, numRegs int, wordSize int) @[]bool {
	var wide @[]bool = make_slice(bool, numRegs)
	if wordSize >= 8 {
		return wide
	}
	for i := 0; i < len(f.Params); i++ {
		var p @ir.Param = f.Params[i]
		if p.ID >= 0 && p.ID < numRegs && is64BitScalar(p.Typ) {
			wide[p.ID] = true
		}
	}
	for b := 0; b < len(f.Blocks); b++ {
		var blk @ir.Block = f.Blocks[b]
		for j := 0; j < len(blk.Instrs); j++ {
			var ins @ir.Instr = blk.Instrs[j]
			if ins.ID >= 0 && ins.ID < numRegs &&
					is64BitScalar(ins.Typ) {
				wide[ins.ID] = true
			}
		}
	}
	return wide
}
