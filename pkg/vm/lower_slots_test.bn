package "pkg/vm"

import "pkg/builtin/testing"
import "pkg/types"

// With no wide registers (e.g. on a 64-bit host, where int64 fits one
// slot), the slot map is the identity and slot count == register count.
func TestBuildSlotMapIdentityWhenNoneWide() testing.TestResult {
	var wide @[]bool = make_slice(bool, 4)
	var slotOf @[]int
	var n int
	slotOf, n = buildSlotMap(wide)
	if n != 4 { return "expected 4 slots" }
	for i := 0; i < 4; i++ {
		if slotOf[i] != i { return "expected identity slot map" }
	}
	return ""
}

// A wide register reserves two consecutive slots, shifting every
// later register up by one per preceding wide register.
func TestBuildSlotMapPairsReserveTwoSlots() testing.TestResult {
	// registers: r0 narrow, r1 wide, r2 narrow, r3 wide
	var wide @[]bool = make_slice(bool, 4)
	wide[1] = true
	wide[3] = true
	var slotOf @[]int
	var n int
	slotOf, n = buildSlotMap(wide)
	if slotOf[0] != 0 { return "r0 -> slot 0" }
	if slotOf[1] != 1 { return "r1 -> slot 1" }
	if slotOf[2] != 3 { return "r2 -> slot 3 (after r1's pair)" }
	if slotOf[3] != 4 { return "r3 -> slot 4" }
	if n != 6 { return "expected 6 slots total (two pairs)" }
	return ""
}

func TestIs64BitScalarIntAndFloat() testing.TestResult {
	if !is64BitScalar(types.TypInt64()) { return "int64 is 64-bit" }
	if !is64BitScalar(types.TypUint64()) { return "uint64 is 64-bit" }
	if !is64BitScalar(types.TypFloat64()) { return "float64 is 64-bit" }
	return ""
}

// int32 / uint32 / float32 / pointers fit one host-word slot.
func TestIs64BitScalarNarrowTypes() testing.TestResult {
	if is64BitScalar(types.TypInt32()) { return "int32 is not 64-bit" }
	if is64BitScalar(types.TypUint32()) { return "uint32 is not 64-bit" }
	if is64BitScalar(types.TypFloat32()) { return "float32 is not 64-bit" }
	if is64BitScalar(nil) { return "nil is not 64-bit" }
	return ""
}
