package "pkg/vm"

import "pkg/ir"
import "pkg/ast"
import "pkg/parser"
import "pkg/types"
import "pkg/buf"
import "pkg/builtin/testing"

func lowerFromSource(src []char) @VM {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = parser.ParseFile(p)
	var c @types.Checker = types.NewChecker()
	types.Check(c, file)
	var m @ir.Module = ir.GenModule(file)
	var vm @VM = NewVM(1024 * 1024)
	LowerModule(vm, m)
	return vm
}

func TestLowerSimpleFunc() testing.TestResult {
	var vm @VM = lowerFromSource("package \"test\"\nfunc main() int { return 42 }\n")
	if len(vm.Funcs) != 1 { return "expected 1 function" }
	if len(vm.Funcs[0].Code) == 0 { return "expected non-empty bytecode" }
	if !streq(vm.Funcs[0].Name, "test.main") { return "expected func name 'test.main'" }
	return ""
}

func TestLowerRegisters() testing.TestResult {
	// A function with variables should have enough registers
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a int = 1\n")
	src = concatStr(src, "  var b int = 2\n")
	src = concatStr(src, "  return a + b\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	if vm.Funcs[0].NumRegs < 3 { return "expected at least 3 registers" }
	return ""
}

func TestLowerMultipleFuncs() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func add(a int, b int) int { return a + b }\n")
	src = concatStr(src, "func main() int { return add(1, 2) }\n")
	var vm @VM = lowerFromSource(src)
	if len(vm.Funcs) != 2 { return "expected 2 functions" }
	// Check that the call function has a name in its name table
	var mainIdx int = -1
	for i := 0; i < len(vm.Funcs); i++ {
		if streq(vm.Funcs[i].Name, "test.main") { mainIdx = i }
	}
	if mainIdx < 0 { return "main not found" }
	if len(vm.Funcs[mainIdx].Names) == 0 { return "expected non-empty name table for main" }
	return ""
}

func TestLowerFrameSize() testing.TestResult {
	// A function with a struct variable should have frame space
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "type Pair struct { A int; B int }\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var p Pair\n")
	src = concatStr(src, "  p.A = 1\n")
	src = concatStr(src, "  return p.A\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	if vm.Funcs[0].FrameSize < 16 { return "expected frame size >= 16 for struct" }
	return ""
}

func TestLowerStringConstants() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() { println(\"hello\") }\n")
	var vm @VM = lowerFromSource(src)
	if len(vm.Funcs[0].Strings) == 0 { return "expected string constants" }
	return ""
}

// TestLowerMultipleModulesStringIsolation guards against a bug
// where the VM kept a single shared Strings slice that got
// overwritten each time LowerModule was called, so BC_LOAD_STR
// indices baked into earlier modules' functions ended up reading
// later modules' strings at runtime.
func TestLowerMultipleModulesStringIsolation() testing.TestResult {
	var vm @VM = NewVM(1024 * 1024)

	// Module A has "mod-a-str" at some index.
	var srcA @[]char
	srcA = concatStr(srcA, "package \"mod_a\"\n")
	srcA = concatStr(srcA, "func A() { println(\"mod-a-str\") }\n")
	var mA @ir.Module = genModule(srcA)
	LowerModule(vm, mA)
	var funcsAfterA int = len(vm.Funcs)

	// Module B has MORE string constants, so if they overwrote A's
	// strings, A's BC_LOAD_STR index would point into B's table.
	var srcB @[]char
	srcB = concatStr(srcB, "package \"mod_b\"\n")
	srcB = concatStr(srcB, "func B() { println(\"b1\"); println(\"b2\"); println(\"b3\") }\n")
	var mB @ir.Module = genModule(srcB)
	LowerModule(vm, mB)

	if funcsAfterA < 1 { return "expected at least one function from module A" }
	// Find A's function and verify its Strings slice still has mod-a-str.
	var aStrings @[]@[]char = vm.Funcs[funcsAfterA - 1].Strings
	if len(aStrings) == 0 { return "A's Strings lost" }
	var found bool = false
	for i := 0; i < len(aStrings); i++ {
		if streq(aStrings[i], "mod-a-str") { found = true }
	}
	if !found { return "A's Strings no longer contains 'mod-a-str'" }
	return ""
}

// TestLowerGlobalRefSharedAcrossUses guards against a bug where
// IR generation shares a single pseudo-global-ref @Instr across
// a load-old-then-store-new sequence (e.g. `g = make_slice(...)`
// which loads the old value to RefDec its backing, then stores
// the new value). The VM's first pass counted one BC_LOAD_IMM
// per occurrence but the third pass deduplicated on the shared
// @Instr's already-patched ID, so first-pass block offsets
// disagreed with third-pass actual offsets — JUMP/BRANCH
// targets pointed one past where they should.
//
// After the fix, emissions match counts: every JUMP target must
// land on the first instruction of its block, not one past it.
// Concretely: the loop's post-block back-jump must target a
// BC_LOAD64 (loading the loop variable), not the subsequent
// BC_LOAD_IMM that loads the constant 3.
func TestLowerGlobalRefSharedAcrossUses() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "var gBuf @[]uint8\n")
	src = concatStr(src, "func setup() {\n")
	src = concatStr(src, "  gBuf = make_slice(uint8, 5)\n")
	src = concatStr(src, "  for i := 0; i < 3; i++ {}\n")
	src = concatStr(src, "}\n")
	var vm @VM = lowerFromSource(src)
	var setupIdx int = -1
	for i := 0; i < len(vm.Funcs); i++ {
		if streq(vm.Funcs[i].Name, "test.setup") { setupIdx = i }
	}
	if setupIdx < 0 { return "test.setup not found" }
	var code @[]BCInstr = vm.Funcs[setupIdx].Code
	// Find the back-edge JUMP (the one whose Aux points to an
	// earlier pc — that's the post-increment → cond edge).
	var backEdgeTarget int = -1
	for i := 0; i < len(code); i++ {
		if code[i].Op == BC_JUMP && code[i].Aux < i {
			backEdgeTarget = code[i].Aux
		}
	}
	if backEdgeTarget < 0 {
		return "no back-edge JUMP found"
	}
	// The back-edge lands on cond block's first instruction,
	// which loads the loop variable from its stack slot.
	if code[backEdgeTarget].Op != BC_LOAD64 {
		return "back-edge target is not BC_LOAD64 (off-by-one)"
	}
	return ""
}

// genModule parses and IR-gens without building a VM.
func genModule(src []char) @ir.Module {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = parser.ParseFile(p)
	var c @types.Checker = types.NewChecker()
	types.Check(c, file)
	return ir.GenModule(file)
}

func TestLowerBranchBlock() testing.TestResult {
	// Verify lowering handles branches correctly: jump targets resolve
	// to valid bytecode indices.
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func pick(cond int) int {\n")
	src = concatStr(src, "  if cond > 0 { return 1 }\n")
	src = concatStr(src, "  return 2\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int { return pick(1) }\n")
	var vm @VM = lowerFromSource(src)
	var pickIdx int = -1
	for i := 0; i < len(vm.Funcs); i++ {
		if streq(vm.Funcs[i].Name, "test.pick") { pickIdx = i }
	}
	if pickIdx < 0 { return "pick not found" }
	// Should have a BRANCH instruction with valid targets
	var hasBranch bool = false
	var codeLen int = len(vm.Funcs[pickIdx].Code)
	for i := 0; i < codeLen; i++ {
		var instr BCInstr = vm.Funcs[pickIdx].Code[i]
		if instr.Op == BC_BRANCH {
			hasBranch = true
			if instr.Imm < 0 || instr.Imm >= codeLen {
				return "BRANCH true target out of range"
			}
			if instr.Aux < 0 || instr.Aux >= codeLen {
				return "BRANCH false target out of range"
			}
		}
	}
	if !hasBranch { return "expected BRANCH instruction" }
	return ""
}

func TestLowerExternsSkipped() testing.TestResult {
	// Extern functions should not produce bytecode
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int { return 1 }\n")
	var vm @VM = lowerFromSource(src)
	// All lowered functions should be non-extern
	for i := 0; i < len(vm.Funcs); i++ {
		if len(vm.Funcs[i].Code) == 0 {
			return "found function with no code"
		}
	}
	return ""
}

func TestLowerParams() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func add(a int, b int, c int) int { return a + b + c }\n")
	src = concatStr(src, "func main() int { return add(1, 2, 3) }\n")
	var vm @VM = lowerFromSource(src)
	var addIdx int = -1
	for i := 0; i < len(vm.Funcs); i++ {
		if streq(vm.Funcs[i].Name, "test.add") { addIdx = i }
	}
	if addIdx < 0 { return "add not found" }
	if vm.Funcs[addIdx].NumParams != 3 { return "expected 3 params" }
	return ""
}
