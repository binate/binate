package "pkg/vm"

import "pkg/builtin/testing"

// parseFloatLit unit tests: verify the helper produces the right
// value for common literal forms. Exact-bit comparison is used for
// simple values (0.0, 1.0, 0.5, 1000.0, 250.0); for non-representable
// decimals (3.14, 1e-1) we bracket the expected value with tolerances
// wider than the accumulation error.
func TestParseFloatLitZero() testing.TestResult {
	if parseFloatLit("0") != 0.0 { return "parse 0" }
	return ""
}

func TestParseFloatLitOne() testing.TestResult {
	if parseFloatLit("1.0") != 1.0 { return "parse 1.0" }
	return ""
}

func TestParseFloatLitFraction() testing.TestResult {
	if parseFloatLit("0.5") != 0.5 { return "parse 0.5" }
	return ""
}

func TestParseFloatLitPi() testing.TestResult {
	if parseFloatLit("3.14") < 3.139 { return "parse 3.14 low" }
	if parseFloatLit("3.14") > 3.141 { return "parse 3.14 high" }
	return ""
}

func TestParseFloatLitExponent() testing.TestResult {
	if parseFloatLit("1e3") != 1000.0 { return "parse 1e3" }
	if parseFloatLit("2.5e2") != 250.0 { return "parse 2.5e2" }
	return ""
}

func TestParseFloatLitNegativeExponent() testing.TestResult {
	if parseFloatLit("1e-1") < 0.09 { return "parse 1e-1 low" }
	if parseFloatLit("1e-1") > 0.11 { return "parse 1e-1 high" }
	return ""
}

func TestParseFloatLitEmpty() testing.TestResult {
	if parseFloatLit("") != 0.0 { return "parse empty" }
	return ""
}

func TestParseFloatLitLeadingSign() testing.TestResult {
	if parseFloatLit("-2.5") != -2.5 { return "parse -2.5" }
	if parseFloatLit("+2.5") != 2.5 { return "parse +2.5" }
	return ""
}
