package "pkg/vm"

import "pkg/builtins/testing"

// Focused unit-level reproducer for a refcount bug in struct-literal
// initialization with a managed-slice field, when the result is stored
// into a managed-slice element on a managed-pointer field.  Discovered
// while writing pkg/vm.RegisterExtern — see claude-todo.md.
//
// Pattern (failing):
//   var nc @[]char = make_slice(char, len(name))
//   for i := 0; i < len(name); i++ { nc[i] = ... }
//   var b S = S{Name: nc, X: 0, Y: 0}            // struct literal
//   var ns @[]S = make_slice(S, n + 1)
//   ns[n] = b
//   v.Items = ns
//
// After return, v.Items[n].Name has correct length but zero bytes —
// the backing was freed because the struct-literal-into-slice copy
// chain dropped a RefInc somewhere.  Field-assignment form
// (`var b S; b.Name = nc; b.X = 0`) was fixed by an earlier compiler
// patch (TestRepro_StructWithManagedSliceFieldAppend in
// vm_extern_test.bn covers that variant); the struct-literal form is
// the parallel hole.

type ReproItem struct {
	Name @[]char
	X    int
	Y    int
}

type ReproHolder struct {
	Items @[]ReproItem
}

// reproAppend mirrors RegisterExtern's grow pattern: build a struct
// literal with a freshly-allocated managed-slice field, append into a
// growing slice on a managed-pointer field.
func reproAppend(h @ReproHolder, c char) {
	var nc @[]char = make_slice(char, 1)
	nc[0] = c
	var item ReproItem = ReproItem{Name: nc, X: 1, Y: 2}
	var ns @[]ReproItem =
		make_slice(ReproItem, len(h.Items) + 1)
	for i := 0; i < len(h.Items); i++ {
		ns[i] = h.Items[i]
	}
	ns[len(h.Items)] = item
	h.Items = ns
}

func TestStructLitWithMSliceFieldRefcountBug() testing.TestResult {
	var h @ReproHolder = make(ReproHolder)
	reproAppend(h, 'A')
	if len(h.Items) != 1 {
		return "len(h.Items) != 1"
	}
	if len(h.Items[0].Name) != 1 {
		return "len(h.Items[0].Name) != 1"
	}
	if h.Items[0].Name[0] != 'A' {
		return "h.Items[0].Name[0] is not 'A' — backing was freed"
	}
	return ""
}
