package "pkg/vm"

import "pkg/rt"

// NewVM allocates a VM with a zero-initialized stack of the given byte size.
func NewVM(stackSize int) @VM {
	var vm @VM = make(VM)
	vm.Stack = rt.c_malloc(stackSize)
	rt.c_memset(vm.Stack, 0, stackSize)
	vm.StackSize = stackSize
	vm.SP = 0
	return vm
}

// LookupFunc returns the index of a function in vm.Funcs by name, or -1.
// Falls back to matching the unqualified suffix (after the last '.').
func LookupFunc(vm @VM, name []char) int {
	for i := 0; i < len(vm.Funcs); i++ {
		if streq(vm.Funcs[i].Name, name) {
			return i
		}
	}
	// Try unqualified: "pkg.Func" → "Func"
	var dotIdx int = -1
	for i := 0; i < len(name); i++ {
		if name[i] == '.' { dotIdx = i }
	}
	if dotIdx >= 0 {
		var suffix []char = name[dotIdx+1:]
		for i := 0; i < len(vm.Funcs); i++ {
			if streq(vm.Funcs[i].Name, suffix) {
				return i
			}
		}
	}
	return -1
}

// CallFunc looks up a function by name and executes it. Aborts if not found.
func CallFunc(vm @VM, name []char, args @[]int) int {
	var idx int = LookupFunc(vm, name)
	if idx < 0 {
		print("vm: function not found: ")
		println(name)
		rt.c_exit(1)
	}
	return execFunc(vm, idx, args)
}

// execFunc pushes a frame and runs a function.
func execFunc(vm @VM, funcIdx int, args @[]int) int {
	var f @VMFunc = vm.Funcs[funcIdx]

	// Allocate register file
	var regs *int = bit_cast(*int, rt.c_malloc(f.NumRegs * 8))
	rt.c_memset(bit_cast(*uint8, regs), 0, f.NumRegs * 8)

	// Allocate stack frame
	var savedSP int = vm.SP
	var frameBase *uint8 = bit_cast(*uint8, bit_cast(int, vm.Stack) + vm.SP)
	if f.FrameSize > 0 {
		if vm.SP + f.FrameSize > vm.StackSize {
			println("vm: stack overflow")
			rt.c_exit(1)
		}
		rt.c_memset(frameBase, 0, f.FrameSize)
		vm.SP = vm.SP + f.FrameSize
	}

	// Copy arguments into parameter registers
	for i := 0; i < len(args) && i < f.NumParams; i++ {
		regs[i] = args[i]
	}

	// Allocate multi-return buffer on caller's stack if needed
	var retBuf *uint8 = nil
	if f.NumResults > 1 {
		retBuf = bit_cast(*uint8,
			bit_cast(int, vm.Stack) + vm.SP)
		vm.SP = vm.SP + f.NumResults * 8
	}

	// Execute
	var result int = execLoop(vm, f, regs, frameBase, retBuf)

	// If result points into callee's stack region (frameBase to
	// current SP), copy the data to caller's stack before popping.
	// This handles struct and managed-slice returns whose data
	// lives on the callee's stack (including BC_MAKE_SLICE areas).
	var stackBase int = bit_cast(int, vm.Stack)
	var calleeLo int = stackBase + savedSP
	var calleeHi int = stackBase + vm.SP
	if result >= calleeLo && result < calleeHi {
		var dataSize int = calleeHi - result
		if dataSize > 64 { dataSize = 64 }
		// Copy to caller's stack
		var dst *uint8 = bit_cast(*uint8, calleeLo)
		rt.c_memcpy(dst,
			bit_cast(*uint8, result), dataSize)
		result = calleeLo
		savedSP = savedSP + dataSize
	}

	// Pop callee frame
	vm.SP = savedSP
	if retBuf != nil {
		vm.SP = vm.SP + f.NumResults * 8
	}
	rt.c_free(bit_cast(*uint8, regs))

	return result
}

// execLoop is the main bytecode dispatch loop. retBuf is caller-
// provided space for multi-return values (nil for single/void).
func execLoop(vm @VM, f @VMFunc, regs *int,
	frameBase *uint8, retBuf *uint8) int {
	var code @[]BCInstr = f.Code
	var pc int = 0
	var numInstrs int = len(code)

	for pc < numInstrs {
		var instr BCInstr = code[pc]
		pc = pc + 1

		if instr.Op == BC_NOP {
			continue
		}

		if instr.Op == BC_LOAD_IMM {
			regs[instr.Dst] = instr.Imm
			continue
		}

		if instr.Op == BC_LOAD_STR {
			// Copy the @[]char from vm.Strings onto the VM
			// stack. copyStringToStack returns the stack
			// pointer to the 4-word managed-slice header.
			var msPtr int = copyStringToStack(
				vm, vm.Strings[instr.Imm])
			if instr.Aux == 1 {
				regs[instr.Dst] = msPtr
			} else {
				// Raw data pointer (word 0)
				var p *int = bit_cast(*int, msPtr)
				regs[instr.Dst] = p[0]
			}
			continue
		}

		if instr.Op == BC_MOV {
			regs[instr.Dst] = regs[instr.Src1]
			continue
		}

		// Arithmetic
		if instr.Op == BC_ADD {
			regs[instr.Dst] = regs[instr.Src1] + regs[instr.Src2]
			continue
		}
		if instr.Op == BC_SUB {
			regs[instr.Dst] = regs[instr.Src1] - regs[instr.Src2]
			continue
		}
		if instr.Op == BC_MUL {
			regs[instr.Dst] = regs[instr.Src1] * regs[instr.Src2]
			continue
		}
		if instr.Op == BC_DIV {
			regs[instr.Dst] = regs[instr.Src1] / regs[instr.Src2]
			continue
		}
		if instr.Op == BC_REM {
			regs[instr.Dst] = regs[instr.Src1] % regs[instr.Src2]
			continue
		}

		// Bitwise
		if instr.Op == BC_AND {
			regs[instr.Dst] = regs[instr.Src1] & regs[instr.Src2]
			continue
		}
		if instr.Op == BC_OR {
			regs[instr.Dst] = regs[instr.Src1] | regs[instr.Src2]
			continue
		}
		if instr.Op == BC_XOR {
			regs[instr.Dst] = regs[instr.Src1] ^ regs[instr.Src2]
			continue
		}
		if instr.Op == BC_SHL {
			regs[instr.Dst] = regs[instr.Src1] << regs[instr.Src2]
			continue
		}
		if instr.Op == BC_SHR {
			regs[instr.Dst] = regs[instr.Src1] >> regs[instr.Src2]
			continue
		}

		// Comparison
		if instr.Op == BC_EQ {
			if regs[instr.Src1] == regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_NE {
			if regs[instr.Src1] != regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SLT {
			if regs[instr.Src1] < regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SLE {
			if regs[instr.Src1] <= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SGT {
			if regs[instr.Src1] > regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SGE {
			if regs[instr.Src1] >= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}

		// Unary
		if instr.Op == BC_NEG {
			regs[instr.Dst] = 0 - regs[instr.Src1]
			continue
		}
		if instr.Op == BC_NOT {
			if regs[instr.Src1] == 0 { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_BITNOT {
			regs[instr.Dst] = regs[instr.Src1] ^ -1
			continue
		}

		// Memory
		if instr.Op == BC_STACK_ALLOC {
			regs[instr.Dst] = bit_cast(int, frameBase) + instr.Imm
			continue
		}
		if instr.Op == BC_LOAD64 {
			var p *int = bit_cast(*int, regs[instr.Src1])
			regs[instr.Dst] = p[0]
			continue
		}
		if instr.Op == BC_STORE64 {
			var p *int = bit_cast(*int, regs[instr.Src1])
			p[0] = regs[instr.Src2]
			continue
		}
		if instr.Op == BC_LOAD8 {
			var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
			if instr.Imm <= 1 {
				// 1-byte load (zero-extended)
				regs[instr.Dst] = cast(int, p[0])
			} else {
				// Sub-word load (2 or 4 bytes, little-endian)
				var val int = 0
				for i := instr.Imm - 1; i >= 0; i-- {
					val = (val << 8) | cast(int, p[i])
				}
				regs[instr.Dst] = val
			}
			continue
		}
		if instr.Op == BC_STORE8 {
			var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
			if instr.Imm <= 1 {
				// 1-byte store
				p[0] = cast(uint8, regs[instr.Src2])
			} else {
				// Sub-word store (2 or 4 bytes)
				var val int = regs[instr.Src2]
				for i := 0; i < instr.Imm; i++ {
					p[i] = cast(uint8, val & 255)
					val = val >> 8
				}
			}
			continue
		}
		if instr.Op == BC_MEMCPY {
			rt.c_memcpy(bit_cast(*uint8, regs[instr.Src1]),
				bit_cast(*uint8, regs[instr.Src2]), instr.Imm)
			continue
		}
		if instr.Op == BC_MEMSET {
			rt.c_memset(bit_cast(*uint8, regs[instr.Src1]), 0, instr.Imm)
			continue
		}
		if instr.Op == BC_FIELD_PTR {
			regs[instr.Dst] = regs[instr.Src1] + instr.Imm
			continue
		}
		if instr.Op == BC_ELEM_PTR {
			regs[instr.Dst] = regs[instr.Src1] + regs[instr.Src2] * instr.Imm
			continue
		}
		if instr.Op == BC_EXTRACT {
			var p *int = bit_cast(*int, regs[instr.Src1])
			regs[instr.Dst] = p[instr.Imm]
			continue
		}

		// Control flow
		if instr.Op == BC_JUMP {
			pc = instr.Aux
			continue
		}
		if instr.Op == BC_BRANCH {
			if regs[instr.Src1] != 0 {
				pc = instr.Imm
			} else {
				pc = instr.Aux
			}
			continue
		}
		if instr.Op == BC_RETURN {
			if instr.Dst == -1 { return 0 }
			if instr.Dst == 0 { return regs[instr.Src1] }
			// Multi-return: pack values into caller-provided
			// result space (retBuf).
			var count int = instr.Imm
			var dst *int = bit_cast(*int, retBuf)
			for i := 0; i < count; i++ {
				dst[i] = regs[instr.Src1 + i]
			}
			return bit_cast(int, retBuf)
		}

		// Function calls
		if instr.Op == BC_CALL {
			var callArgs @[]int = make_slice(int, instr.Imm)
			for i := 0; i < instr.Imm; i++ {
				callArgs[i] = regs[instr.Src1 + i]
			}
			var callName []char = f.Names[instr.Aux]
			var funcIdx int = LookupFunc(vm, callName)
			if funcIdx >= 0 {
				var result int = execFunc(vm, funcIdx,
					callArgs)
				if instr.Dst >= 0 {
					regs[instr.Dst] = result
				}
			} else {
				// Try extern dispatch
				var result int = execExtern(vm,
					callName, callArgs, instr)
				if instr.Dst >= 0 {
					regs[instr.Dst] = result
				}
			}
			continue
		}

		if instr.Op == BC_CALL_BUILTIN {
			execBuiltin(vm, f, regs, instr)
			continue
		}

		// Managed memory
		if instr.Op == BC_REFINC {
			rt.RefInc(bit_cast(*uint8, regs[instr.Src1]))
			continue
		}
		if instr.Op == BC_REFDEC {
			var ptr *uint8 = bit_cast(*uint8, regs[instr.Src1])
			if ptr == nil { continue }
			var dtorIdx int = 0
			if instr.Src2 >= 0 {
				dtorIdx = regs[instr.Src2]
			}
			if dtorIdx == 0 {
				// No dtor — use rt.RefDec directly
				rt.RefDec(ptr, nil)
			} else {
				// Has dtor — do refcount manually so we
				// can call dtor through the VM
				vmRefDec(vm, ptr, dtorIdx)
			}
			continue
		}
		if instr.Op == BC_ALLOC {
			regs[instr.Dst] = bit_cast(int, rt.Alloc(instr.Imm))
			continue
		}
		if instr.Op == BC_BOX {
			regs[instr.Dst] = bit_cast(int,
				rt.Box(bit_cast(*uint8, regs[instr.Src1]),
					instr.Imm))
			continue
		}
		if instr.Op == BC_NIL_CHECK {
			if regs[instr.Src1] == 0 {
				println("vm: nil pointer dereference")
				rt.c_exit(1)
			}
			continue
		}
		if instr.Op == BC_BOUNDS_CHECK {
			rt.BoundsCheck(regs[instr.Src1], regs[instr.Src2])
			continue
		}
		if instr.Op == BC_MAKE_SLICE {
			var ms rt.ManagedSlice = rt.MakeManagedSlice(instr.Imm, regs[instr.Src1])
			// Store the 4-word managed-slice on the stack, return pointer
			var msAddr *uint8 = bit_cast(*uint8, bit_cast(int, vm.Stack) + vm.SP)
			vm.SP = vm.SP + 32
			var dst *int = bit_cast(*int, msAddr)
			dst[0] = bit_cast(int, ms.Data)
			dst[1] = ms.Len
			dst[2] = bit_cast(int, ms.Refptr)
			dst[3] = ms.BackingLen
			regs[instr.Dst] = bit_cast(int, msAddr)
			continue
		}

		if instr.Op == BC_FUNC_ADDR {
			// Store 1-based function index for use as dtor
			var name []char = f.Names[instr.Aux]
			var idx int = LookupFunc(vm, name)
			if idx < 0 {
				print("vm: dtor function not found: ")
				println(name)
				rt.c_exit(1)
			}
			regs[instr.Dst] = idx + 1 // 1-based
			continue
		}

		if instr.Op == BC_TRUNC8 {
			regs[instr.Dst] = regs[instr.Src1] & 255
			continue
		}

		// Fallback
		print("vm: unhandled opcode ")
		println(instr.Op)
		rt.c_exit(1)
	}

	return 0
}

// copyStringToStack copies a @[]char managed-slice onto the VM
// stack and returns the stack pointer. The managed-slice is stored
// as a 4-word header: {data, len, refptr, backing_len}.
func copyStringToStack(vm @VM, s @[]char) int {
	var addr int = bit_cast(int, vm.Stack) + vm.SP
	vm.SP = vm.SP + 32
	// Write the managed-slice fields to the stack.
	// s is passed by value, so the compiled code has the
	// 4 words on its own stack — we use memcpy to transfer.
	rt.c_memcpy(bit_cast(*uint8, addr),
		bit_cast(*uint8, &s), 32)
	return addr
}

// streq returns true if two char slices have identical content.
func streq(a []char, b []char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
