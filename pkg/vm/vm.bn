package "pkg/vm"

import "pkg/rt"

// REG_SLOT is the size in bytes of one VM register slot — the host
// word size.  Registers hold host-word values (pointers, `int`); a
// 64-bit value on a 32-bit host spans two adjacent slots (see
// explorations/plan-vm-64bit-on-32bit.md).  Frame layout math sizes
// the register area as NumRegs * REG_SLOT, so register-slot stride
// equals the `regs *int` access stride on every host.
const REG_SLOT int = cast(int, sizeof(int))

// MANAGED_HDR is the size in bytes of pkg/rt's managed-allocation
// header — `sizeof(rt.ManagedHeader)`.  Declared locally as a
// sibling of REG_SLOT / FRAME_HDR because current bnc doesn't
// const-fold cross-package `sizeof(rt.X)` at the use site (the
// inline BC_REFINC_INLINE / BC_REFDEC_INLINE_FAST handlers reach
// the header via `ptr - MANAGED_HDR`, which needs a same-package
// const).  16 on LP64, 8 on a 32-bit host.  Stays in lockstep
// with rt.ManagedHeader's layout — bump the formula here if the
// struct changes.
const MANAGED_HDR int = cast(int, sizeof(rt.ManagedHeader))

// Frame header size: 6 words (savedPC, savedFuncIdx,
// savedRegsOff, savedSP, callerDst, freeOnPop), each one host word.
//
// freeOnPop carries a managed-pointer payload that BC_RETURN
// rt.Free's after popping the frame. Used by the iterative dtor
// dispatch in BC_REFDEC_INLINE_FAST: instead of recursing through
// execFunc → execLoop (which grows the host stack per dtor cascade
// level), BC_REFDEC_INLINE_FAST pushes a frame for the dtor like
// BC_CALL does and stashes the ptr-to-free here. The dtor runs in
// the same execLoop iteration; on return, the pop frees the
// payload. 0 = no action.
const FRAME_HDR int = 6 * REG_SLOT

// NewVM allocates a VM with a zero-initialized stack.
func NewVM(stackSize int) @VM {
	var vm @VM = make(VM)
	vm.Stack = rt.RawAlloc(stackSize)
	rt.MemZero(vm.Stack, stackSize)
	vm.StackSize = stackSize
	vm.SP = 0
	return vm
}

// TrampolineScalar is a generic ABI-aware bridge: compiled code
// calls it through a VM-side function value's vtable.call slot,
// passing data as the first arg and user args in subsequent
// register slots per AAPCS. The trampoline reads the VM handle
// and vm_func_idx from data, packs the user args into argv, and
// dispatches via execFunc.
//
// Variadic-style register reading: the trampoline accepts a fixed
// 7-arg shape (a0..a6). Callers bitcast vtable.call to their
// function value's actual signature (typically narrower) and call
// with whatever args they have. Per AAPCS, register args land in
// X1..X7 deterministically; the trampoline reads only the first
// f.NumParams of them (execFunc uses len(args) and f.NumParams to
// limit the copy). Args beyond the caller's actual count are
// uninitialized but unread — sound on AAPCS, equivalent to how
// variadic C functions work.
//
// Bootstrap-subset constraint: scalars + pointers + bools only,
// no floats, no aggregates pass through. ≤7 user args. Broader
// signatures need a different shape (additional V-register
// trampoline or the always-pack convention) — out of scope here.
//
// Used by VM-side function values constructed in BC_FUNC_VALUE;
// see vm_exec_helpers.bn.
func TrampolineScalar(data *uint8,
		a0 int, a1 int, a2 int, a3 int,
		a4 int, a5 int, a6 int) int {
	if data == nil {
		println("vm: TrampolineScalar called with nil data")
		rt.Exit(1)
	}
	var rec *int = bit_cast(*int, data)
	if rec[0] != rt.DATA_KIND_VM_CLOSURE_REC {
		println("vm: TrampolineScalar: data is not a VM closure record")
		rt.Exit(1)
	}
	var vmAddr int = rec[1]
	if vmAddr == 0 {
		println("vm: TrampolineScalar: closure record has nil VM handle")
		rt.Exit(1)
	}
	var vm @VM = bit_cast(@VM, vmAddr)
	var fnIdx int = rec[2] - 1
	if fnIdx < 0 || fnIdx >= len(vm.Funcs) {
		println("vm: TrampolineScalar: vm_func_idx out of range")
		rt.Exit(1)
	}
	var argv @[]int = make_slice(int, 7)
	argv[0] = a0; argv[1] = a1; argv[2] = a2; argv[3] = a3
	argv[4] = a4; argv[5] = a5; argv[6] = a6
	return execFunc(vm, fnIdx, argv)
}

// TrampolineAggregate is the aggregate-return counterpart of
// TrampolineScalar.  Compiled code calls it through a VM-side
// function value's vtable.call slot when the function value's
// return type is multi-word (slice / managed-slice / multi-word
// struct).
//
// Convention: matches the aggregate-shim shape (`void(i8* retbuf,
// i8* data, args...)`).  The retbuf is a caller-allocated buffer
// of the function's return-type size; the trampoline writes the
// VM-side bytecode function's result there and returns void.
//
// Implementation: the bytecode VMFunc's BC_RETURN packs aggregate
// returns onto vm.Stack and returns the address.  This trampoline
// dispatches via execFunc, gets the resulting address, and
// memcpys ResultSizes[0] bytes (taken from the VMFunc's metadata)
// into retbuf.
//
// Used by VM-side function values whose return type is aggregate;
// vtable.call selection happens in BC_FUNC_VALUE (vm_exec_helpers.bn).
func TrampolineAggregate(retbuf *uint8, data *uint8,
		a0 int, a1 int, a2 int, a3 int,
		a4 int, a5 int, a6 int) {
	if data == nil {
		println("vm: TrampolineAggregate called with nil data")
		rt.Exit(1)
	}
	var rec *int = bit_cast(*int, data)
	if rec[0] != rt.DATA_KIND_VM_CLOSURE_REC {
		println("vm: TrampolineAggregate: data is not a VM closure record")
		rt.Exit(1)
	}
	var vmAddr int = rec[1]
	if vmAddr == 0 {
		println("vm: TrampolineAggregate: closure record has nil VM handle")
		rt.Exit(1)
	}
	var vm @VM = bit_cast(@VM, vmAddr)
	var fnIdx int = rec[2] - 1
	if fnIdx < 0 || fnIdx >= len(vm.Funcs) {
		println("vm: TrampolineAggregate: vm_func_idx out of range")
		rt.Exit(1)
	}
	var f @VMFunc = vm.Funcs[fnIdx]
	if len(f.ResultSizes) != 1 {
		println("vm: TrampolineAggregate: aggregate return must be single-result")
		rt.Exit(1)
	}
	var argv @[]int = make_slice(int, 7)
	argv[0] = a0; argv[1] = a1; argv[2] = a2; argv[3] = a3
	argv[4] = a4; argv[5] = a5; argv[6] = a6
	var resultAddr int = execFunc(vm, fnIdx, argv)
	rt.MemCopy(retbuf, bit_cast(*const uint8, resultAddr),
		f.ResultSizes[0])
}

// LookupFunc returns the index of a function by name, or -1.
// Uses strict exact match: names are qualified at lowering time
// (see qualifyCallName in lower.bn), so callers must use the
// fully-qualified form (e.g. "asm.New", "main.main").  O(1) via
// the per-VM name→idx hash (`vm.IndexBuckets`); the hash is kept
// in sync by `LowerModule` and `LowerOneFunc` whenever a VMFunc
// enters or replaces an entry in `vm.Funcs`.
func (vm @VM) LookupFunc(name *[]const char) int {
	return funcIndexLookup(vm, name)
}

// CallFunc looks up a function by name and executes it.
func (vm @VM) CallFunc(name *[]const char, args @[]int) int {
	var idx int = vm.LookupFunc(name)
	if idx < 0 {
		print("vm: function not found: ")
		println(name)
		rt.Exit(1)
	}
	return execFunc(vm, idx, args)
}

// CallByVMFunc executes a previously-lowered VMFunc directly,
// skipping the LookupFunc-by-name path.  REPL entry point: after
// LowerOneFunc returns the synthetic __repl_n func, the prompt
// invokes it without going through the named-lookup path.  Args
// are 1-word integer values; for void functions pass an empty
// slice and ignore the return.  Returns 0 if vmf is not present
// in vm.Funcs (defensive — shouldn't happen if it was just
// lowered into this VM).
func (vm @VM) CallByVMFunc(vmf @VMFunc, args @[]int) int {
	for i := 0; i < len(vm.Funcs); i++ {
		if vm.Funcs[i] == vmf {
			return execFunc(vm, i, args)
		}
	}
	return 0
}

// pushFrame allocates a call frame on the VM stack and returns
// the offset of the register area.
func pushFrame(vm @VM, f @VMFunc, savedPC int,
	savedFuncIdx int, savedRegsOff int,
	savedSP int, callerDst int) int {
	var frameStart int = vm.SP
	var totalSize int = FRAME_HDR + f.NumRegs * REG_SLOT +
		f.FrameSize
	if vm.SP + totalSize > vm.StackSize {
		println("vm: stack overflow")
		rt.Exit(1)
	}
	// Write header
	var hdr *int = stackPtr(vm, frameStart)
	hdr[0] = savedPC
	hdr[1] = savedFuncIdx
	hdr[2] = savedRegsOff
	hdr[3] = savedSP
	hdr[4] = callerDst
	hdr[5] = 0  // freeOnPop default (no action)
	// Zero registers and allocas
	var regsOff int = frameStart + FRAME_HDR
	rt.MemZero(bit_cast(*uint8, stackPtr(vm, regsOff)),
		f.NumRegs * REG_SLOT + f.FrameSize)
	vm.SP = frameStart + totalSize
	return regsOff
}

// stackPtr returns a *int at the given offset into vm.Stack.
func stackPtr(vm @VM, off int) *int {
	return bit_cast(*int, bit_cast(int, vm.Stack) + off)
}

// pushManagedSlice copies 32 bytes from src onto the VM stack.
func pushManagedSlice(vm @VM, src *uint8) int {
	var addr int = bit_cast(int, vm.Stack) + vm.SP
	vm.SP = vm.SP + 32
	rt.MemCopy(bit_cast(*uint8, addr), src, 32)
	return addr
}

// streq returns true if two char slices have identical content.
func streq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// RegisterExtern binds a name to a compiled-side function value.
// Reads the 16-byte {vtable, data} pair at fvAddr, copies it into a
// fresh ExternBinding, and appends to vm.Externs.  Re-registration
// of an existing name overwrites the prior binding (no list growth)
// — supports late-binding patterns at startup without leaking
// duplicate entries.
//
// resultSize selects the dispatch path: ≤ 8 for scalar/void (uses
// rt._call_shim_scalar with int return), > 8 for aggregate (uses
// rt._call_shim_aggregate with retbuf allocation).
//
// The Name field stores its own managed-slice copy of the input
// name so the registry's lifetime is independent of the caller's
// string source.
func (vm @VM) RegisterExtern(name *[]const char, fvAddr *uint8,
		resultSize int, rawFnAddr int) {
	if fvAddr == nil {
		println("vm: RegisterExtern: nil fvAddr")
		rt.Exit(1)
	}
	var fv *int = bit_cast(*int, fvAddr)
	var vtableAddr int = fv[0]
	var dataAddr int = fv[1]
	// Build a managed copy of the caller's function-value handle so
	// the binding owns it: even if the source was a static
	// `@__handle.F` global (native registrants) we end up with a
	// uniform heap allocation, and if the source was a heap handle
	// from a VMFunc the binding's lifetime is decoupled from the
	// originating VMFunc.  rawFnAddr == 0 → leave HandleAddr nil
	// (legacy callers that didn't supply a handle).
	var handleCopy @VMFuncHandle
	if rawFnAddr != 0 {
		handleCopy = make(VMFuncHandle)
		var srcHandle *int = bit_cast(*int, rawFnAddr)
		handleCopy.VtableAddr = srcHandle[0]
		handleCopy.DataAddr = srcHandle[1]
	}
	// Replace if name already registered.
	for i := 0; i < len(vm.Externs); i++ {
		if streq(vm.Externs[i].Name, name) {
			vm.Externs[i].VtableAddr = vtableAddr
			vm.Externs[i].DataAddr = dataAddr
			vm.Externs[i].ResultSize = resultSize
			vm.Externs[i].HandleAddr = handleCopy
			return
		}
	}
	// Append new binding.  Copy the bytes byte-by-byte into a
	// fresh @[]char the binding owns, so the registry's lifetime
	// is decoupled from the caller's source.
	var nameCopy @[]char = make_slice(char, len(name))
	for i := 0; i < len(name); i++ {
		nameCopy[i] = cast(char, name[i])
	}
	var binding ExternBinding = ExternBinding{
		Name: nameCopy,
		VtableAddr: vtableAddr,
		DataAddr: dataAddr,
		ResultSize: resultSize,
		HandleAddr: handleCopy,
	}
	var newExterns @[]ExternBinding =
		make_slice(ExternBinding, len(vm.Externs) + 1)
	for i := 0; i < len(vm.Externs); i++ {
		newExterns[i] = vm.Externs[i]
	}
	newExterns[len(vm.Externs)] = binding
	vm.Externs = newExterns
}

// LookupExtern returns the index of a registered extern by name,
// or -1.  O(N) scan; N is small (~30 standard externs).
func (vm @VM) LookupExtern(name *[]const char) int {
	for i := 0; i < len(vm.Externs); i++ {
		if streq(vm.Externs[i].Name, name) {
			return i
		}
	}
	return -1
}
