package "pkg/vm"

import "pkg/rt"
import "pkg/bootstrap"
import "pkg/buf"

// NewVM allocates a VM with a zero-initialized stack of the given byte size.
func NewVM(stackSize int) @VM {
	var vm @VM = make(VM)
	vm.Stack = rt.c_malloc(stackSize)
	rt.c_memset(vm.Stack, 0, stackSize)
	vm.StackSize = stackSize
	vm.SP = 0
	return vm
}

// LookupFunc returns the index of a function in vm.Funcs by name, or -1.
// Falls back to matching the unqualified suffix (after the last '.').
func LookupFunc(vm @VM, name []char) int {
	for i := 0; i < len(vm.Funcs); i++ {
		if streq(vm.Funcs[i].Name, name) {
			return i
		}
	}
	// Try unqualified: "pkg.Func" → "Func"
	var dotIdx int = -1
	for i := 0; i < len(name); i++ {
		if name[i] == '.' { dotIdx = i }
	}
	if dotIdx >= 0 {
		var suffix []char = name[dotIdx+1:]
		for i := 0; i < len(vm.Funcs); i++ {
			if streq(vm.Funcs[i].Name, suffix) {
				return i
			}
		}
	}
	return -1
}

// CallFunc looks up a function by name and executes it. Aborts if not found.
func CallFunc(vm @VM, name []char, args @[]int) int {
	var idx int = LookupFunc(vm, name)
	if idx < 0 {
		print("vm: function not found: ")
		println(name)
		rt.c_exit(1)
	}
	return execFunc(vm, idx, args)
}

// execFunc pushes a frame and runs a function.
func execFunc(vm @VM, funcIdx int, args @[]int) int {
	var f @VMFunc = vm.Funcs[funcIdx]

	// Allocate register file
	var regs *int = bit_cast(*int, rt.c_malloc(f.NumRegs * 8))
	rt.c_memset(bit_cast(*uint8, regs), 0, f.NumRegs * 8)

	// Allocate stack frame
	var savedSP int = vm.SP
	var frameBase *uint8 = bit_cast(*uint8, bit_cast(int, vm.Stack) + vm.SP)
	if f.FrameSize > 0 {
		if vm.SP + f.FrameSize > vm.StackSize {
			println("vm: stack overflow")
			rt.c_exit(1)
		}
		rt.c_memset(frameBase, 0, f.FrameSize)
		vm.SP = vm.SP + f.FrameSize
	}

	// Copy arguments into parameter registers
	for i := 0; i < len(args) && i < f.NumParams; i++ {
		regs[i] = args[i]
	}

	// Allocate multi-return buffer on caller's stack if needed
	var retBuf *uint8 = nil
	if f.NumResults > 1 {
		retBuf = bit_cast(*uint8,
			bit_cast(int, vm.Stack) + vm.SP)
		vm.SP = vm.SP + f.NumResults * 8
	}

	// Execute
	var result int = execLoop(vm, f, regs, frameBase, retBuf)

	// Pop callee frame (but NOT multi-return buffer — it's
	// above savedSP and the caller still needs it)
	vm.SP = savedSP
	if retBuf != nil {
		vm.SP = vm.SP + f.NumResults * 8
	}
	rt.c_free(bit_cast(*uint8, regs))

	return result
}

// execLoop is the main bytecode dispatch loop. retBuf is caller-
// provided space for multi-return values (nil for single/void).
func execLoop(vm @VM, f @VMFunc, regs *int,
	frameBase *uint8, retBuf *uint8) int {
	var code @[]BCInstr = f.Code
	var pc int = 0
	var numInstrs int = len(code)

	for pc < numInstrs {
		var instr BCInstr = code[pc]
		pc = pc + 1

		if instr.Op == BC_NOP {
			continue
		}

		if instr.Op == BC_LOAD_IMM {
			regs[instr.Dst] = instr.Imm
			continue
		}

		if instr.Op == BC_LOAD_STR {
			if instr.Aux == 1 {
				// Load managed-slice header pointer (for STRING_TO_CHARS)
				regs[instr.Dst] = vm.Strings[instr.Imm]
			} else {
				// Load raw data pointer (for CONST_STRING)
				var hdr *int = bit_cast(*int, vm.Strings[instr.Imm])
				regs[instr.Dst] = hdr[0]
			}
			continue
		}

		if instr.Op == BC_MOV {
			regs[instr.Dst] = regs[instr.Src1]
			continue
		}

		// Arithmetic
		if instr.Op == BC_ADD {
			regs[instr.Dst] = regs[instr.Src1] + regs[instr.Src2]
			continue
		}
		if instr.Op == BC_SUB {
			regs[instr.Dst] = regs[instr.Src1] - regs[instr.Src2]
			continue
		}
		if instr.Op == BC_MUL {
			regs[instr.Dst] = regs[instr.Src1] * regs[instr.Src2]
			continue
		}
		if instr.Op == BC_DIV {
			regs[instr.Dst] = regs[instr.Src1] / regs[instr.Src2]
			continue
		}
		if instr.Op == BC_REM {
			regs[instr.Dst] = regs[instr.Src1] % regs[instr.Src2]
			continue
		}

		// Bitwise
		if instr.Op == BC_AND {
			regs[instr.Dst] = regs[instr.Src1] & regs[instr.Src2]
			continue
		}
		if instr.Op == BC_OR {
			regs[instr.Dst] = regs[instr.Src1] | regs[instr.Src2]
			continue
		}
		if instr.Op == BC_XOR {
			regs[instr.Dst] = regs[instr.Src1] ^ regs[instr.Src2]
			continue
		}
		if instr.Op == BC_SHL {
			regs[instr.Dst] = regs[instr.Src1] << regs[instr.Src2]
			continue
		}
		if instr.Op == BC_SHR {
			regs[instr.Dst] = regs[instr.Src1] >> regs[instr.Src2]
			continue
		}

		// Comparison
		if instr.Op == BC_EQ {
			if regs[instr.Src1] == regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_NE {
			if regs[instr.Src1] != regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SLT {
			if regs[instr.Src1] < regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SLE {
			if regs[instr.Src1] <= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SGT {
			if regs[instr.Src1] > regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SGE {
			if regs[instr.Src1] >= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}

		// Unary
		if instr.Op == BC_NEG {
			regs[instr.Dst] = 0 - regs[instr.Src1]
			continue
		}
		if instr.Op == BC_NOT {
			if regs[instr.Src1] == 0 { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_BITNOT {
			regs[instr.Dst] = regs[instr.Src1] ^ -1
			continue
		}

		// Memory
		if instr.Op == BC_STACK_ALLOC {
			regs[instr.Dst] = bit_cast(int, frameBase) + instr.Imm
			continue
		}
		if instr.Op == BC_LOAD64 {
			var p *int = bit_cast(*int, regs[instr.Src1])
			regs[instr.Dst] = p[0]
			continue
		}
		if instr.Op == BC_STORE64 {
			var p *int = bit_cast(*int, regs[instr.Src1])
			p[0] = regs[instr.Src2]
			continue
		}
		if instr.Op == BC_LOAD8 {
			var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
			regs[instr.Dst] = cast(int, p[0])
			continue
		}
		if instr.Op == BC_STORE8 {
			var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
			p[0] = cast(uint8, regs[instr.Src2])
			continue
		}
		if instr.Op == BC_MEMCPY {
			rt.c_memcpy(bit_cast(*uint8, regs[instr.Src1]),
				bit_cast(*uint8, regs[instr.Src2]), instr.Imm)
			continue
		}
		if instr.Op == BC_MEMSET {
			rt.c_memset(bit_cast(*uint8, regs[instr.Src1]), 0, instr.Imm)
			continue
		}
		if instr.Op == BC_FIELD_PTR {
			regs[instr.Dst] = regs[instr.Src1] + instr.Imm
			continue
		}
		if instr.Op == BC_ELEM_PTR {
			regs[instr.Dst] = regs[instr.Src1] + regs[instr.Src2] * instr.Imm
			continue
		}
		if instr.Op == BC_EXTRACT {
			var p *int = bit_cast(*int, regs[instr.Src1])
			regs[instr.Dst] = p[instr.Imm]
			continue
		}

		// Control flow
		if instr.Op == BC_JUMP {
			pc = instr.Aux
			continue
		}
		if instr.Op == BC_BRANCH {
			if regs[instr.Src1] != 0 {
				pc = instr.Imm
			} else {
				pc = instr.Aux
			}
			continue
		}
		if instr.Op == BC_RETURN {
			if instr.Dst == -1 { return 0 }
			if instr.Dst == 0 { return regs[instr.Src1] }
			// Multi-return: pack values into caller-provided
			// result space (retBuf).
			var count int = instr.Imm
			var dst *int = bit_cast(*int, retBuf)
			for i := 0; i < count; i++ {
				dst[i] = regs[instr.Src1 + i]
			}
			return bit_cast(int, retBuf)
		}

		// Function calls
		if instr.Op == BC_CALL {
			var callArgs @[]int = make_slice(int, instr.Imm)
			for i := 0; i < instr.Imm; i++ {
				callArgs[i] = regs[instr.Src1 + i]
			}
			var callName []char = f.Names[instr.Aux]
			var funcIdx int = LookupFunc(vm, callName)
			if funcIdx >= 0 {
				var result int = execFunc(vm, funcIdx,
					callArgs)
				if instr.Dst >= 0 {
					regs[instr.Dst] = result
				}
			} else {
				// Try extern dispatch
				var result int = execExtern(vm,
					callName, callArgs, instr)
				if instr.Dst >= 0 {
					regs[instr.Dst] = result
				}
			}
			continue
		}

		if instr.Op == BC_CALL_BUILTIN {
			execBuiltin(vm, f, regs, instr)
			continue
		}

		// Managed memory
		if instr.Op == BC_REFINC {
			rt.RefInc(bit_cast(*uint8, regs[instr.Src1]))
			continue
		}
		if instr.Op == BC_REFDEC {
			var ptr *uint8 = bit_cast(*uint8, regs[instr.Src1])
			if ptr == nil { continue }
			var dtorIdx int = 0
			if instr.Src2 >= 0 {
				dtorIdx = regs[instr.Src2]
			}
			if dtorIdx == 0 {
				// No dtor — use rt.RefDec directly
				rt.RefDec(ptr, nil)
			} else {
				// Has dtor — do refcount manually so we
				// can call dtor through the VM
				vmRefDec(vm, ptr, dtorIdx)
			}
			continue
		}
		if instr.Op == BC_ALLOC {
			regs[instr.Dst] = bit_cast(int, rt.Alloc(instr.Imm))
			continue
		}
		if instr.Op == BC_BOX {
			regs[instr.Dst] = bit_cast(int,
				rt.Box(bit_cast(*uint8, regs[instr.Src1]),
					instr.Imm))
			continue
		}
		if instr.Op == BC_NIL_CHECK {
			if regs[instr.Src1] == 0 {
				println("vm: nil pointer dereference")
				rt.c_exit(1)
			}
			continue
		}
		if instr.Op == BC_BOUNDS_CHECK {
			rt.BoundsCheck(regs[instr.Src1], regs[instr.Src2])
			continue
		}
		if instr.Op == BC_MAKE_SLICE {
			var ms rt.ManagedSlice = rt.MakeManagedSlice(instr.Imm, regs[instr.Src1])
			// Store the 4-word managed-slice on the stack, return pointer
			var msAddr *uint8 = bit_cast(*uint8, bit_cast(int, vm.Stack) + vm.SP)
			vm.SP = vm.SP + 32
			var dst *int = bit_cast(*int, msAddr)
			dst[0] = bit_cast(int, ms.Data)
			dst[1] = ms.Len
			dst[2] = bit_cast(int, ms.Refptr)
			dst[3] = ms.BackingLen
			regs[instr.Dst] = bit_cast(int, msAddr)
			continue
		}

		if instr.Op == BC_FUNC_ADDR {
			// Store 1-based function index for use as dtor
			var name []char = f.Names[instr.Aux]
			var idx int = LookupFunc(vm, name)
			if idx < 0 {
				print("vm: dtor function not found: ")
				println(name)
				rt.c_exit(1)
			}
			regs[instr.Dst] = idx + 1 // 1-based
			continue
		}

		if instr.Op == BC_TRUNC8 {
			regs[instr.Dst] = regs[instr.Src1] & 255
			continue
		}

		// Fallback
		print("vm: unhandled opcode ")
		println(instr.Op)
		rt.c_exit(1)
	}

	return 0
}

// execBuiltin handles builtin calls (println, print, len, etc.)
func execBuiltin(vm @VM, f @VMFunc, regs *int, instr BCInstr) {
	var name []char = f.Names[instr.Aux]
	if streq(name, "print_int") || streq(name, "bn_print_int") {
		var cb buf.CharBuf = buf.New()
		cb = buf.WriteInt(cb, regs[instr.Src1])
		var s @[]char = buf.Bytes(cb)
		writeStr(s)
		return
	}
	if streq(name, "print_bool") || streq(name, "bn_print_bool") {
		if regs[instr.Src1] != 0 {
			writeStr("true")
		} else {
			writeStr("false")
		}
		return
	}
	if streq(name, "print_newline") || streq(name, "bn_print_newline") {
		writeStr("\n")
		return
	}
	if streq(name, "print_string") || streq(name, "bn_print_string") {
		var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
		var slen int = regs[instr.Src1 + 1]
		writeBytes(p, slen)
		return
	}
	if streq(name, "print_chars") || streq(name, "bn_print_chars") {
		var addr *int = bit_cast(*int, regs[instr.Src1])
		var dataPtr *uint8 = bit_cast(*uint8, addr[0])
		var slen int = addr[1]
		writeBytes(dataPtr, slen)
		return
	}
	if streq(name, "exit") || streq(name, "bn_exit") {
		rt.c_exit(regs[instr.Src1])
		return
	}
	// Unknown builtin — try as a VM function
	var funcIdx int = LookupFunc(vm, name)
	if funcIdx >= 0 {
		var callArgs @[]int = make_slice(int, instr.Imm)
		for i := 0; i < instr.Imm; i++ {
			callArgs[i] = regs[instr.Src1 + i]
		}
		var result int = execFunc(vm, funcIdx, callArgs)
		if instr.Dst >= 0 {
			regs[instr.Dst] = result
		}
		return
	}
	print("vm: unhandled builtin '")
	print(name)
	println("'")
	rt.c_exit(1)
}

// vmRefDec decrements refcount and calls dtor via VM if it hits 0.
// dtorIdx is a 1-based VM function index (from BC_FUNC_ADDR).
func vmRefDec(vm @VM, ptr *uint8, dtorIdx int) {
	if ptr == nil { return }
	var h *int = bit_cast(*int, bit_cast(int, ptr) - 16)
	h[0] = h[0] - 1
	if h[0] == 0 {
		// Call destructor through VM
		var funcIdx int = dtorIdx - 1 // convert to 0-based
		var args @[]int = make_slice(int, 1)
		args[0] = bit_cast(int, ptr)
		execFunc(vm, funcIdx, args)
		// Free the allocation
		rt.Free(ptr)
	}
}

// execExtern dispatches calls to compiled extern functions
// (pkg/rt, pkg/bootstrap, C externs).
func execExtern(vm @VM, name []char, args @[]int,
	instr BCInstr) int {
	// pkg/rt functions
	if streq(name, "bn_rt__Alloc") {
		return bit_cast(int, rt.Alloc(args[0]))
	}
	if streq(name, "bn_rt__Free") {
		rt.Free(bit_cast(*uint8, args[0]))
		return 0
	}
	if streq(name, "bn_rt__RefInc") {
		rt.RefInc(bit_cast(*uint8, args[0]))
		return 0
	}
	if streq(name, "bn_rt__RefDec") {
		rt.RefDec(bit_cast(*uint8, args[0]),
			bit_cast(*uint8, args[1]))
		return 0
	}
	if streq(name, "bn_rt__Refcount") {
		return rt.Refcount(bit_cast(*uint8, args[0]))
	}
	if streq(name, "bn_rt__BoundsCheck") {
		rt.BoundsCheck(args[0], args[1])
		return 0
	}
	if streq(name, "bn_rt__Box") {
		return bit_cast(int,
			rt.Box(bit_cast(*uint8, args[0]), args[1]))
	}
	if streq(name, "bn_rt__MakeManagedSlice") {
		var ms rt.ManagedSlice = rt.MakeManagedSlice(
			args[0], args[1])
		// Pack into stack
		var msAddr *uint8 = bit_cast(*uint8,
			bit_cast(int, vm.Stack) + vm.SP)
		vm.SP = vm.SP + 32
		var dst *int = bit_cast(*int, msAddr)
		dst[0] = bit_cast(int, ms.Data)
		dst[1] = ms.Len
		dst[2] = bit_cast(int, ms.Refptr)
		dst[3] = ms.BackingLen
		return bit_cast(int, msAddr)
	}
	// C externs
	if streq(name, "bn_rt__c_malloc") {
		return bit_cast(int, rt.c_malloc(args[0]))
	}
	if streq(name, "bn_rt__c_free") {
		rt.c_free(bit_cast(*uint8, args[0]))
		return 0
	}
	if streq(name, "bn_rt__c_memset") {
		rt.c_memset(bit_cast(*uint8, args[0]),
			args[1], args[2])
		return 0
	}
	if streq(name, "bn_rt__c_memcpy") {
		rt.c_memcpy(bit_cast(*uint8, args[0]),
			bit_cast(*uint8, args[1]), args[2])
		return 0
	}
	if streq(name, "bn_rt__c_exit") {
		rt.c_exit(args[0])
		return 0
	}
	if streq(name, "bn_rt__c_bounds_fail") {
		rt.c_bounds_fail(args[0], args[1])
		return 0
	}
	// pkg/bootstrap functions
	// Note: slice args are passed as pointers to 2-word headers
	if streq(name, "bn_bootstrap__Open") {
		var path []char = readSliceChar(
			bit_cast(*int, args[0]))
		return bootstrap.Open(path, args[1])
	}
	if streq(name, "bn_bootstrap__Close") {
		bootstrap.Close(args[0])
		return 0
	}
	if streq(name, "bn_bootstrap__Read") {
		var b []uint8 = readSliceU8(
			bit_cast(*int, args[1]))
		return bootstrap.Read(args[0], b)
	}
	if streq(name, "bn_bootstrap__Write") {
		var b []uint8 = readSliceU8(
			bit_cast(*int, args[1]))
		return bootstrap.Write(args[0], b)
	}
	if streq(name, "bn_bootstrap__Exit") {
		bootstrap.Exit(args[0])
		return 0
	}
	if streq(name, "bn_bootstrap__Args") {
		// TODO: implement Args() forwarding
		return 0
	}
	print("vm: extern not found: ")
	println(name)
	rt.c_exit(1)
	return 0
}

// writeStr writes a char slice to stdout.
func writeStr(s []char) {
	for i := 0; i < len(s); i++ {
		var ch [1]uint8
		ch[0] = cast(uint8, s[i])
		bootstrap.Write(1, ch[:])
	}
}

// writeBytes writes n bytes from p to stdout.
func writeBytes(p *uint8, n int) {
	for i := 0; i < n; i++ {
		var ch [1]uint8
		ch[0] = p[i]
		bootstrap.Write(1, ch[:])
	}
}

// readSliceChar reads a []char from a 2-word block at ptr.
func readSliceChar(ptr *int) []char {
	var p *uint8 = bit_cast(*uint8, ptr[0])
	var n int = ptr[1]
	// Construct the slice by writing to a stack alloca
	// and bitcasting the alloca pointer
	var hdr [2]int
	hdr[0] = ptr[0]
	hdr[1] = ptr[1]
	return *bit_cast(*[]char, &hdr[0])
}

// readSliceU8 reads a []uint8 from a 2-word block at ptr.
func readSliceU8(ptr *int) []uint8 {
	var hdr [2]int
	hdr[0] = ptr[0]
	hdr[1] = ptr[1]
	return *bit_cast(*[]uint8, &hdr[0])
}

// streq returns true if two char slices have identical content.
func streq(a []char, b []char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
