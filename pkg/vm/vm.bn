package "pkg/vm"

import "pkg/rt"

// Frame header size: 6 words (savedPC, savedFuncIdx,
// savedRegsOff, savedSP, callerDst, freeOnPop).
//
// freeOnPop carries a managed-pointer payload that BC_RETURN
// rt.Free's after popping the frame. Used by the iterative dtor
// dispatch in BC_REFDEC: instead of recursing through
// vmRefDec → execFunc → execLoop (which grows the host stack
// per dtor cascade level), BC_REFDEC pushes a frame for the dtor
// like BC_CALL does and stashes the ptr-to-free here. The dtor
// runs in the same execLoop iteration; on return, the pop frees
// the payload. 0 = no action.
const FRAME_HDR int = 48

// NewVM allocates a VM with a zero-initialized stack.
func NewVM(stackSize int) @VM {
	var vm @VM = make(VM)
	vm.Stack = rt.RawAlloc(stackSize)
	rt.MemZero(vm.Stack, stackSize)
	vm.StackSize = stackSize
	vm.SP = 0
	return vm
}

// LookupFunc returns the index of a function by name, or -1.
// Uses strict exact match: names are qualified at lowering time
// (see qualifyCallName in lower.bn), so callers must use the
// fully-qualified form (e.g. "asm.New", "main.main").
func LookupFunc(vm @VM, name *[]const char) int {
	for i := 0; i < len(vm.Funcs); i++ {
		if streq(vm.Funcs[i].Name, name) {
			return i
		}
	}
	return -1
}

// CallFunc looks up a function by name and executes it.
func CallFunc(vm @VM, name *[]const char, args @[]int) int {
	var idx int = LookupFunc(vm, name)
	if idx < 0 {
		print("vm: function not found: ")
		println(name)
		rt.Exit(1)
	}
	return execFunc(vm, idx, args)
}

// CallByVMFunc executes a previously-lowered VMFunc directly,
// skipping the LookupFunc-by-name path.  REPL entry point: after
// LowerOneFunc returns the synthetic __repl_n func, the prompt
// invokes it without going through the named-lookup path.  Args
// are 1-word integer values; for void functions pass an empty
// slice and ignore the return.  Returns 0 if vmf is not present
// in vm.Funcs (defensive — shouldn't happen if it was just
// lowered into this VM).
func CallByVMFunc(vm @VM, vmf @VMFunc, args @[]int) int {
	for i := 0; i < len(vm.Funcs); i++ {
		if vm.Funcs[i] == vmf {
			return execFunc(vm, i, args)
		}
	}
	return 0
}

// pushFrame allocates a call frame on the VM stack and returns
// the offset of the register area.
func pushFrame(vm @VM, f @VMFunc, savedPC int,
	savedFuncIdx int, savedRegsOff int,
	savedSP int, callerDst int) int {
	var frameStart int = vm.SP
	var totalSize int = FRAME_HDR + f.NumRegs * 8 +
		f.FrameSize
	if vm.SP + totalSize > vm.StackSize {
		println("vm: stack overflow")
		rt.Exit(1)
	}
	// Write header
	var hdr *int = stackPtr(vm, frameStart)
	hdr[0] = savedPC
	hdr[1] = savedFuncIdx
	hdr[2] = savedRegsOff
	hdr[3] = savedSP
	hdr[4] = callerDst
	hdr[5] = 0  // freeOnPop default (no action)
	// Zero registers and allocas
	var regsOff int = frameStart + FRAME_HDR
	rt.MemZero(bit_cast(*uint8, stackPtr(vm, regsOff)),
		f.NumRegs * 8 + f.FrameSize)
	vm.SP = frameStart + totalSize
	return regsOff
}

// stackPtr returns a *int at the given offset into vm.Stack.
func stackPtr(vm @VM, off int) *int {
	return bit_cast(*int, bit_cast(int, vm.Stack) + off)
}

// pushManagedSlice copies 32 bytes from src onto the VM stack.
func pushManagedSlice(vm @VM, src *uint8) int {
	var addr int = bit_cast(int, vm.Stack) + vm.SP
	vm.SP = vm.SP + 32
	rt.MemCopy(bit_cast(*uint8, addr), src, 32)
	return addr
}

// streq returns true if two char slices have identical content.
func streq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
