package "pkg/vm"

import "pkg/rt"

// execFunc enters the VM for a function call. This is the entry
// point from compiled code (CallFunc, execExtern's rt.CallDtor arm).
// Pushes an initial frame and runs the iterative dispatch loop.
func execFunc(vm @VM, funcIdx int, args @[]int) int {
	var f @VMFunc = vm.Funcs[funcIdx]
	var savedSP int = vm.SP

	// Push frame: header + registers + allocas
	var regsOff int = pushFrame(vm, f, -1, -1, 0, 0, -1)

	// Copy arguments into parameter registers
	var regs *int = stackPtr(vm, regsOff)
	for i := 0; i < len(args) && i < f.NumParams; i++ {
		regs[i] = args[i]
	}

	var result int = execLoop(vm, funcIdx, regsOff)

	// If result points into callee's stack region, copy it
	// to caller space before popping.
	var sbase int = bit_cast(int, vm.Stack)
	if result >= sbase + savedSP && result < sbase + vm.SP {
		var sz int = sbase + vm.SP - result
		if sz > 64 { sz = 64 }
		rt.MemCopy(bit_cast(*uint8, sbase + savedSP),
			bit_cast(*uint8, result), sz)
		result = sbase + savedSP
		savedSP = savedSP + sz
	}

	vm.SP = savedSP
	return result
}

// execLoop is the iterative bytecode dispatch loop. It handles
// BC_CALL by pushing frames on the VM stack (no native recursion).
// BC_RETURN pops frames. Returns when the initial frame returns.
func execLoop(vm @VM, funcIdx int, regsOff int) int {
	var f @VMFunc = vm.Funcs[funcIdx]
	var code @[]BCInstr = f.Code
	var regs *int = stackPtr(vm, regsOff)
	var frameBase *uint8 = bit_cast(*uint8,
		bit_cast(int, vm.Stack) + regsOff + f.NumRegs * 8)
	var pc int = 0
	// Hoisted: BC_CALL extern's per-call args buffer. Allocated
	// ONCE at function entry with generous capacity; reused across
	// every extern call in this execLoop invocation. Required for
	// host-stack-leak avoidance: declaring or make_slice'ing this
	// inside the BC_CALL branch caused bnc to emit the @[]int
	// header alloca (and the make_slice temp) in that branch's
	// basic block, leaking 32 bytes of host stack per extern call
	// — only released on execLoop return. For boot-comp-int-int
	// this triggered host stack overflow after ~218s on any
	// non-trivial run. Capacity 64 covers any plausible extern
	// signature; if a call somehow exceeds it, BC_CALL handler
	// panics (loud failure beats silent corruption).
	var callArgs @[]int = make_slice(int, 64)

	for {
		var instr BCInstr = code[pc]
		pc = pc + 1

		if instr.Op == BC_NOP { continue }

		if instr.Op == BC_LOAD_IMM {
			regs[instr.Dst] = instr.Imm
			continue
		}
		if instr.Op == BC_LOAD_STR {
			var str @[]char = f.Strings[instr.Imm]
			var msPtr int = pushManagedSlice(vm,
				bit_cast(*uint8, &str))
			if instr.Aux == 1 {
				regs[instr.Dst] = msPtr
			} else {
				var p *int = bit_cast(*int, msPtr)
				regs[instr.Dst] = p[0]
			}
			continue
		}
		if instr.Op == BC_STRING_COPY_MS {
			// Stage 2b: allocate a fresh managed-slice copy of the
			// literal. Refcount 1; independent of rodata.
			var str @[]char = f.Strings[instr.Imm]
			var strHdr int = pushManagedSlice(vm,
				bit_cast(*uint8, &str))
			var hdrP *int = bit_cast(*int, strHdr)
			var srcPtr int = hdrP[0]
			var strLen int = hdrP[1]
			var ms rt.ManagedSlice = rt.MakeManagedSlice(1, strLen)
			if strLen > 0 {
				rt.MemCopy(ms.Data,
					bit_cast(*uint8, srcPtr), strLen)
			}
			var msAddr *int = stackPtr(vm, vm.SP)
			vm.SP = vm.SP + 32
			msAddr[0] = bit_cast(int, ms.Data)
			msAddr[1] = ms.Len
			msAddr[2] = bit_cast(int, ms.Refptr)
			msAddr[3] = ms.BackingLen
			regs[instr.Dst] = bit_cast(int, msAddr)
			continue
		}
		if instr.Op == BC_STRING_COPY_ARR {
			// Stage 2c Phase 1: copy a string literal into a fresh
			// stack buffer of size Aux, zero-padded. Returns pointer
			// to the buffer; OP_STORE memcpys it into the target alloca.
			var str @[]char = f.Strings[instr.Imm]
			var strHdr int = pushManagedSlice(vm,
				bit_cast(*uint8, &str))
			var hdrP *int = bit_cast(*int, strHdr)
			var srcPtr int = hdrP[0]
			var strLen int = hdrP[1]
			var arrLen int = instr.Aux
			var bufAddr int = bit_cast(int, vm.Stack) + vm.SP
			vm.SP = vm.SP + arrLen
			rt.MemZero(bit_cast(*uint8, bufAddr), arrLen)
			var copyLen int = strLen
			if copyLen > arrLen { copyLen = arrLen }
			if copyLen > 0 {
				rt.MemCopy(bit_cast(*uint8, bufAddr),
					bit_cast(*uint8, srcPtr), copyLen)
			}
			regs[instr.Dst] = bufAddr
			continue
		}
		if instr.Op == BC_MOV {
			regs[instr.Dst] = regs[instr.Src1]
			continue
		}

		// --- Arithmetic ---
		if instr.Op == BC_ADD { regs[instr.Dst] = regs[instr.Src1] + regs[instr.Src2]; continue }
		if instr.Op == BC_SUB { regs[instr.Dst] = regs[instr.Src1] - regs[instr.Src2]; continue }
		if instr.Op == BC_MUL { regs[instr.Dst] = regs[instr.Src1] * regs[instr.Src2]; continue }
		if instr.Op == BC_DIV { regs[instr.Dst] = regs[instr.Src1] / regs[instr.Src2]; continue }
		if instr.Op == BC_REM { regs[instr.Dst] = regs[instr.Src1] % regs[instr.Src2]; continue }
		if instr.Op == BC_AND { regs[instr.Dst] = regs[instr.Src1] & regs[instr.Src2]; continue }
		if instr.Op == BC_OR  { regs[instr.Dst] = regs[instr.Src1] | regs[instr.Src2]; continue }
		if instr.Op == BC_XOR { regs[instr.Dst] = regs[instr.Src1] ^ regs[instr.Src2]; continue }
		if instr.Op == BC_SHL { regs[instr.Dst] = regs[instr.Src1] << regs[instr.Src2]; continue }
		if instr.Op == BC_SHR { regs[instr.Dst] = regs[instr.Src1] >> regs[instr.Src2]; continue }

		// --- Floating-point arithmetic (float64 only) ---
		if instr.Op == BC_FADD {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			regs[instr.Dst] = bit_cast(int, a + b)
			continue
		}
		if instr.Op == BC_FSUB {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			regs[instr.Dst] = bit_cast(int, a - b)
			continue
		}
		if instr.Op == BC_FMUL {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			regs[instr.Dst] = bit_cast(int, a * b)
			continue
		}
		if instr.Op == BC_FDIV {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			regs[instr.Dst] = bit_cast(int, a / b)
			continue
		}

		// --- Comparison ---
		if instr.Op == BC_EQ {
			if regs[instr.Src1] == regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_NE {
			if regs[instr.Src1] != regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SLT {
			if regs[instr.Src1] < regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SLE {
			if regs[instr.Src1] <= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SGT {
			if regs[instr.Src1] > regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SGE {
			if regs[instr.Src1] >= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}

		// --- Floating-point comparison (ordered predicates) ---
		if instr.Op == BC_FEQ {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			if a == b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_FNE {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			if a != b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_FLT {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			if a < b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_FLE {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			if a <= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_FGT {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			if a > b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_FGE {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			if a >= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}

		// --- Unary ---
		if instr.Op == BC_NEG {
			regs[instr.Dst] = 0 - regs[instr.Src1]
			continue
		}
		if instr.Op == BC_NOT {
			if regs[instr.Src1] == 0 { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_BITNOT {
			regs[instr.Dst] = regs[instr.Src1] ^ -1
			continue
		}
		if instr.Op == BC_FNEG {
			var x float64 = bit_cast(float64, regs[instr.Src1])
			regs[instr.Dst] = bit_cast(int, 0.0 - x)
			continue
		}

		// --- Memory ---
		if instr.Op == BC_STACK_ALLOC {
			regs[instr.Dst] = bit_cast(int, frameBase) + instr.Imm
			continue
		}
		if instr.Op == BC_LOAD64 {
			var p *int = bit_cast(*int, regs[instr.Src1])
			regs[instr.Dst] = p[0]
			continue
		}
		if instr.Op == BC_STORE64 {
			var p *int = bit_cast(*int, regs[instr.Src1])
			p[0] = regs[instr.Src2]
			continue
		}
		if instr.Op == BC_LOAD8 {
			var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
			if instr.Imm <= 1 { regs[instr.Dst] = cast(int, p[0]) } else {
				var val int = 0
				for i := instr.Imm - 1; i >= 0; i-- { val = (val << 8) | cast(int, p[i]) }
				regs[instr.Dst] = val
			}
			continue
		}
		if instr.Op == BC_STORE8 {
			var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
			if instr.Imm <= 1 { p[0] = cast(uint8, regs[instr.Src2]) } else {
				var val int = regs[instr.Src2]
				for i := 0; i < instr.Imm; i++ { p[i] = cast(uint8, val & 255); val = val >> 8 }
			}
			continue
		}
		if instr.Op == BC_MEMCPY {
			rt.MemCopy(bit_cast(*uint8, regs[instr.Src1]),
				bit_cast(*uint8, regs[instr.Src2]),
				instr.Imm)
			continue
		}
		if instr.Op == BC_MEMSET {
			rt.MemZero(bit_cast(*uint8, regs[instr.Src1]),
				instr.Imm)
			continue
		}
		if instr.Op == BC_FIELD_PTR {
			regs[instr.Dst] = regs[instr.Src1] + instr.Imm
			continue
		}
		if instr.Op == BC_ELEM_PTR {
			regs[instr.Dst] = regs[instr.Src1] +
				regs[instr.Src2] * instr.Imm
			continue
		}
		if instr.Op == BC_EXTRACT {
			// Imm = byte offset (or word index in legacy mode)
			// Aux = 0: load 1 word at offset
			// Aux = 1: return pointer (offset arithmetic only)
			// Aux = 2: legacy word-indexed load (Imm * 8)
			if instr.Aux == 1 {
				regs[instr.Dst] = regs[instr.Src1] +
					instr.Imm
			} else if instr.Aux == 2 {
				var p *int = bit_cast(*int,
					regs[instr.Src1])
				regs[instr.Dst] = p[instr.Imm]
			} else {
				var p *int = bit_cast(*int,
					regs[instr.Src1] + instr.Imm)
				regs[instr.Dst] = p[0]
			}
			continue
		}

		// --- Control flow ---
		if instr.Op == BC_JUMP { pc = instr.Aux; continue }
		if instr.Op == BC_BRANCH {
			if regs[instr.Src1] != 0 { pc = instr.Imm } else { pc = instr.Aux }
			continue
		}

		if instr.Op == BC_RETURN {
			var retVal int = 0
			var copySize int = 0
			if instr.Dst == 0 {
				retVal = regs[instr.Src1]
				// Aggregate single-return: bytes to copy back
				// (set by lowerReturn). 0 for scalars/pointers.
				copySize = instr.Aux
			} else if instr.Dst > 0 {
				// Multi-return: pack values inline at proper
				// offsets matching the anonymous struct layout
				// (from f.ResultSizes/Offsets). Struct values
				// are MEMCPY'd by size; scalars get one word.
				var sbase int = bit_cast(int, vm.Stack)
				var dstBase int = sbase + vm.SP
				var totalSize int = 0
				for i := 0; i < instr.Imm; i++ {
					var sz int = f.ResultSizes[i]
					var off int = f.ResultOffsets[i]
					var srcVal int = regs[instr.Src1 + i]
					// For multi-word types srcVal is a pointer
					// (lowerLoad returns the alloca pointer for
					// struct/slice/array). Use MEMCPY regardless
					// of size — a struct{int} has sz=8 but srcVal
					// still holds a pointer to it, not the bytes.
					if f.ResultMultiWord[i] {
						rt.MemCopy(
							bit_cast(*uint8,
								dstBase + off),
							bit_cast(*uint8, srcVal),
							sz)
					} else {
						var p *int = bit_cast(*int,
							dstBase + off)
						p[0] = srcVal
					}
					if off + sz > totalSize {
						totalSize = off + sz
					}
				}
				// Align total size to 8
				totalSize = (totalSize + 7) / 8 * 8
				vm.SP = vm.SP + totalSize
				retVal = dstBase
				copySize = totalSize
			}
			// Read frame header (just before registers)
			var hdr *int = stackPtr(vm, regsOff - FRAME_HDR)
			if hdr[0] == -1 {
				// Top-level frame: return to execFunc
				return retVal
			}
			// Pop frame: restore caller state
			var callerPC int = hdr[0]
			var callerFuncIdx int = hdr[1]
			var callerRegsOff int = hdr[2]
			var callerSP int = hdr[3]
			var callerDst int = hdr[4]
			// freeOnPop: set by BC_REFDEC's iterative dispatch when
			// it pushes a dtor frame. After we restore caller state
			// below, rt.Free this payload — completing the
			// "decrement → run dtor → free" sequence without host
			// recursion. 0 = no action.
			var freeOnPop int = hdr[5]
			// If retVal points into the callee's region (a struct
			// alloca, packed multi-return, or managed-slice
			// header), we must copy it back to caller space so
			// the callee's frame can be popped cleanly. Without
			// this copy, callerSP would have to be bumped to
			// vm.SP, leaking the entire callee frame on every
			// call — a tight loop blows the stack quickly.
			// Mirrors execFunc's same logic for the entry frame.
			var sbase int = bit_cast(int, vm.Stack)
			if copySize > 0 &&
				retVal >= sbase + callerSP &&
				retVal < sbase + vm.SP {
				rt.MemCopy(
					bit_cast(*uint8, sbase + callerSP),
					bit_cast(*uint8, retVal),
					copySize)
				retVal = sbase + callerSP
				callerSP = callerSP + copySize
			}
			vm.SP = callerSP
			// Restore caller context
			funcIdx = callerFuncIdx
			f = vm.Funcs[funcIdx]
			code = f.Code
			regsOff = callerRegsOff
			regs = stackPtr(vm, regsOff)
			frameBase = bit_cast(*uint8,
				bit_cast(int, vm.Stack) + regsOff +
					f.NumRegs * 8)
			pc = callerPC
			if callerDst >= 0 {
				regs[callerDst] = retVal
			}
			if freeOnPop != 0 {
				rt.Free(bit_cast(*uint8, freeOnPop))
			}
			continue
		}

		// --- Function calls ---
		if instr.Op == BC_CALL {
			var calleeFuncIdx int = f.CallCache[instr.Aux]
			if calleeFuncIdx == -2 {
				calleeFuncIdx = LookupFunc(vm,
					f.Names[instr.Aux])
				f.CallCache[instr.Aux] = calleeFuncIdx
			}
			if calleeFuncIdx < 0 {
				var callName @[]char = f.Names[instr.Aux]
				// Extern call: reuse the hoisted callArgs buffer.
				if instr.Imm > len(callArgs) {
					println("vm: extern call has too many args")
					rt.Exit(1)
				}
				for i := 0; i < instr.Imm; i++ {
					callArgs[i] = regs[instr.Src1 + i]
				}
				var result int = execExtern(vm,
					callName, callArgs, instr)
				if instr.Dst >= 0 {
					regs[instr.Dst] = result
				}
				continue
			}
			// VM function call: push frame, switch context
			var calleeFunc @VMFunc = vm.Funcs[calleeFuncIdx]
			var newRegsOff int = pushFrame(vm, calleeFunc,
				pc, funcIdx, regsOff, vm.SP, instr.Dst)
			// Copy args to callee params
			var newRegs *int = stackPtr(vm, newRegsOff)
			for i := 0; i < instr.Imm &&
				i < calleeFunc.NumParams; i++ {
				newRegs[i] = regs[instr.Src1 + i]
			}
			// Switch to callee
			funcIdx = calleeFuncIdx
			f = calleeFunc
			code = f.Code
			regsOff = newRegsOff
			regs = newRegs
			frameBase = bit_cast(*uint8,
				bit_cast(int, vm.Stack) + newRegsOff +
					f.NumRegs * 8)
			pc = 0
			continue
		}

		if instr.Op == BC_CALL_INDIRECT {
			// fn_ptr (Src1 register) is a 1-based VM function index;
			// args at [Src2 .. Src2+Imm-1]; result into Dst (or Dst<0
			// for void). Externs are not reachable through indirect
			// calls — fn_ptr always points at a VM function.
			var fnIdx int = regs[instr.Src1]
			if fnIdx == 0 {
				println("vm: indirect call through nil function pointer")
				rt.Exit(1)
			}
			var calleeFuncIdx int = fnIdx - 1
			if calleeFuncIdx < 0 ||
				calleeFuncIdx >= len(vm.Funcs) {
				println("vm: indirect call: function index out of range")
				rt.Exit(1)
			}
			var calleeFunc @VMFunc =
				vm.Funcs[calleeFuncIdx]
			var newRegsOff int = pushFrame(vm, calleeFunc,
				pc, funcIdx, regsOff, vm.SP, instr.Dst)
			var newRegs *int = stackPtr(vm, newRegsOff)
			for i := 0; i < instr.Imm &&
				i < calleeFunc.NumParams; i++ {
				newRegs[i] = regs[instr.Src2 + i]
			}
			funcIdx = calleeFuncIdx
			f = calleeFunc
			code = f.Code
			regsOff = newRegsOff
			regs = newRegs
			frameBase = bit_cast(*uint8,
				bit_cast(int, vm.Stack) + newRegsOff +
					f.NumRegs * 8)
			pc = 0
			continue
		}

		// --- Managed memory ---
		if instr.Op == BC_REFINC { rt.RefInc(bit_cast(*uint8, regs[instr.Src1])); continue }
		if instr.Op == BC_REFDEC {
			var ptr *uint8 = bit_cast(*uint8, regs[instr.Src1])
			if ptr == nil { continue }
			var dtorIdx int = 0
			if instr.Src2 >= 0 { dtorIdx = regs[instr.Src2] }
			if dtorIdx == 0 {
				// No dtor: native fast path, doesn't recurse into VM.
				rt.RefDec(ptr, nil)
				continue
			}
			// Decrement refcount inline (vmRefDec previously did this).
			var hd *int = bit_cast(*int,
				bit_cast(int, ptr) - 16)
			hd[0] = hd[0] - 1
			if hd[0] != 0 { continue }
			// Refcount hit 0: dispatch the dtor as an iterative VM
			// call (mirrors BC_CALL), instead of recursing through
			// execFunc on the host stack. The dtor's frame stashes
			// the ptr-to-free in freeOnPop; BC_RETURN's pop will
			// rt.Free it after restoring caller state. This keeps
			// host stack flat across dtor cascades.
			var dtorFunc @VMFunc = vm.Funcs[dtorIdx - 1]
			var newRegsOff int = pushFrame(vm, dtorFunc, pc,
				funcIdx, regsOff, vm.SP, -1)
			var newHdr *int = stackPtr(vm,
				newRegsOff - FRAME_HDR)
			newHdr[5] = bit_cast(int, ptr)
			var newRegs *int = stackPtr(vm, newRegsOff)
			newRegs[0] = bit_cast(int, ptr)
			funcIdx = dtorIdx - 1
			f = dtorFunc
			code = f.Code
			regsOff = newRegsOff
			regs = newRegs
			frameBase = bit_cast(*uint8,
				bit_cast(int, vm.Stack) + newRegsOff +
					f.NumRegs * 8)
			pc = 0
			continue
		}
		if instr.Op == BC_ALLOC {
			regs[instr.Dst] = bit_cast(int,
				rt.Alloc(instr.Imm))
			continue
		}
		if instr.Op == BC_BOX {
			regs[instr.Dst] = bit_cast(int,
				rt.Box(bit_cast(*uint8, regs[instr.Src1]),
					instr.Imm))
			continue
		}
		if instr.Op == BC_NIL_CHECK {
			if regs[instr.Src1] == 0 { println("vm: nil pointer dereference"); rt.Exit(1) }
			continue
		}
		if instr.Op == BC_BOUNDS_CHECK { rt.BoundsCheck(regs[instr.Src1], regs[instr.Src2]); continue }
		if instr.Op == BC_MAKE_SLICE {
			var ms rt.ManagedSlice = rt.MakeManagedSlice(instr.Imm, regs[instr.Src1])
			var msAddr *int = stackPtr(vm, vm.SP)
			vm.SP = vm.SP + 32
			msAddr[0] = bit_cast(int, ms.Data)
			msAddr[1] = ms.Len
			msAddr[2] = bit_cast(int, ms.Refptr)
			msAddr[3] = ms.BackingLen
			regs[instr.Dst] = bit_cast(int, msAddr)
			continue
		}
		if instr.Op == BC_FUNC_ADDR {
			var idx int = f.CallCache[instr.Aux]
			if idx == -2 {
				idx = LookupFunc(vm, f.Names[instr.Aux])
				f.CallCache[instr.Aux] = idx
			}
			if idx < 0 {
				var name @[]char = f.Names[instr.Aux]
				print("vm: dtor not found: "); println(name); rt.Exit(1)
			}
			regs[instr.Dst] = idx + 1
			continue
		}
		if instr.Op == BC_FUNC_VALUE {
			// Function-value construction. Look up the target
			// function (caching the index on the call site for
			// repeated executions), lazily allocate its vtable +
			// VM closure record on first use, and copy the 16-byte
			// {vtable_addr, closure_rec_addr} pair into a fresh
			// stack slot.
			//
			// Phase 1: vtable.call is left as 0 (placeholder).
			// Phase 3 will populate it with a per-signature
			// trampoline so cross-mode dispatch works. See
			// explorations/plan-function-values.md "VM-mode
			// vtables — interop-compatible from Phase 1".
			var idx int = f.CallCache[instr.Aux]
			if idx == -2 {
				idx = LookupFunc(vm, f.Names[instr.Aux])
				f.CallCache[instr.Aux] = idx
			}
			if idx < 0 {
				var name @[]char = f.Names[instr.Aux]
				print("vm: function not found: "); println(name)
				rt.Exit(1)
			}
			var callee @VMFunc = vm.Funcs[idx]
			if callee.Vtable == 0 {
				var vtPtr *uint8 = rt.RawAlloc(16)
				rt.MemZero(vtPtr, 16)
				// dtor=0 (no captured ctx); call=0 (Phase 1 placeholder).
				callee.Vtable = bit_cast(int, vtPtr)
			}
			if callee.VMClosureRec == 0 {
				var rec *int = bit_cast(*int, rt.RawAlloc(16))
				rt.MemZero(bit_cast(*uint8, rec), 16)
				rec[0] = idx + 1   // 1-based VM function index
				rec[1] = 0         // captured_ctx (Phase 1: none)
				callee.VMClosureRec = bit_cast(int, rec)
			}
			// Build the function value in a fresh 16-byte stack
			// slot at SP. SP grows by 16; the slot's address is
			// the result.
			var fvAddr *int = stackPtr(vm, vm.SP)
			var fvAddrInt int = bit_cast(int, vm.Stack) + vm.SP
			vm.SP = vm.SP + 16
			fvAddr[0] = callee.Vtable
			fvAddr[1] = callee.VMClosureRec
			regs[instr.Dst] = fvAddrInt
			continue
		}
		if instr.Op == BC_TRUNC8 { regs[instr.Dst] = regs[instr.Src1] & 255; continue }
		if instr.Op == BC_SITOF {
			// Signed int → float64. Src1 is the int value in register
			// form; coerce through the native `int` width (which is
			// what the VM registers are) and let the cast produce the
			// float.
			var i int = regs[instr.Src1]
			regs[instr.Dst] = bit_cast(int, cast(float64, i))
			continue
		}
		if instr.Op == BC_FTOSI {
			// float64 → signed int. Truncates toward zero (Binate's
			// cast semantics).
			var f float64 = bit_cast(float64, regs[instr.Src1])
			regs[instr.Dst] = cast(int, f)
			continue
		}
		if instr.Op == BC_F32TOSI {
			// float32 (IEEE bits in low 4 bytes of Src1) → signed int.
			var u32 uint32 = cast(uint32, regs[instr.Src1])
			var f32 float32 = bit_cast(float32, u32)
			regs[instr.Dst] = cast(int, f32)
			continue
		}
		if instr.Op == BC_F64_TO_F32 {
			// Narrow float64 → float32. Result is the float32 IEEE
			// bits in the low 4 bytes (zero-extended via uint32).
			var f64 float64 = bit_cast(float64, regs[instr.Src1])
			var f32 float32 = cast(float32, f64)
			var u32 uint32 = bit_cast(uint32, f32)
			regs[instr.Dst] = cast(int, u32)
			continue
		}
		if instr.Op == BC_F32_TO_F64 {
			// Widen float32 (low 4 bytes of Src1) → float64.
			var u32 uint32 = cast(uint32, regs[instr.Src1])
			var f32 float32 = bit_cast(float32, u32)
			var f64 float64 = cast(float64, f32)
			regs[instr.Dst] = bit_cast(int, f64)
			continue
		}

		print("vm: unhandled opcode ")
		println(instr.Op)
		rt.Exit(1)
	}
	return 0
}
