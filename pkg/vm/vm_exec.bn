package "pkg/vm"

import "pkg/bootstrap"
import "pkg/rt"

// execFunc and the non-control-flow opcode helpers
// (execStringOp / execFuncRefOp / execNumericCast)
// live in vm_exec_helpers.bn. This file holds execLoop, the
// iterative dispatch loop whose remaining handlers all touch
// the loop-local control state (pc, funcIdx, f, code, regsOff,
// regs, frameBase, freeOnPop) and so can't be hoisted out into
// helper functions without invasive in/out-pointer plumbing.

// execLoop is the iterative bytecode dispatch loop. It handles
// BC_CALL by pushing frames on the VM stack (no native recursion).
// BC_RETURN pops frames. Returns when the initial frame returns.
func execLoop(vm @VM, funcIdx int, regsOff int) int {
	var f @VMFunc = vm.Funcs[funcIdx]
	var code @[]BCInstr = f.Code
	var regs *int = stackPtr(vm, regsOff)
	var frameBase *uint8 = bit_cast(*uint8,
		bit_cast(int, vm.Stack) + regsOff + f.NumRegs * 8)
	var pc int = 0
	// Hoisted: BC_CALL extern's per-call args buffer. Allocated
	// ONCE at function entry with generous capacity; reused across
	// every extern call in this execLoop invocation. Required for
	// host-stack-leak avoidance: declaring or make_slice'ing this
	// inside the BC_CALL branch caused bnc to emit the @[]int
	// header alloca (and the make_slice temp) in that branch's
	// basic block, leaking 32 bytes of host stack per extern call
	// — only released on execLoop return. For boot-comp-int-int
	// this triggered host stack overflow after ~218s on any
	// non-trivial run. Capacity 64 covers any plausible extern
	// signature; if a call somehow exceeds it, BC_CALL handler
	// panics (loud failure beats silent corruption).
	var callArgs @[]int = make_slice(int, 64)

	for {
		var instr BCInstr = code[pc]
		pc = pc + 1

		if instr.Op == BC_NOP { continue }

		if instr.Op == BC_LOAD_IMM {
			regs[instr.Dst] = instr.Imm
			continue
		}
		if execStringOp(vm, f, regs, instr) { continue }
		if instr.Op == BC_MOV {
			regs[instr.Dst] = regs[instr.Src1]
			continue
		}

		// --- Arithmetic ---
		if instr.Op == BC_ADD { regs[instr.Dst] = regs[instr.Src1] + regs[instr.Src2]; continue }
		if instr.Op == BC_SUB { regs[instr.Dst] = regs[instr.Src1] - regs[instr.Src2]; continue }
		if instr.Op == BC_MUL { regs[instr.Dst] = regs[instr.Src1] * regs[instr.Src2]; continue }
		if instr.Op == BC_DIV { regs[instr.Dst] = regs[instr.Src1] / regs[instr.Src2]; continue }
		if instr.Op == BC_REM { regs[instr.Dst] = regs[instr.Src1] % regs[instr.Src2]; continue }
		if instr.Op == BC_AND { regs[instr.Dst] = regs[instr.Src1] & regs[instr.Src2]; continue }
		if instr.Op == BC_OR  { regs[instr.Dst] = regs[instr.Src1] | regs[instr.Src2]; continue }
		if instr.Op == BC_XOR { regs[instr.Dst] = regs[instr.Src1] ^ regs[instr.Src2]; continue }
		if instr.Op == BC_SHL { regs[instr.Dst] = regs[instr.Src1] << regs[instr.Src2]; continue }
		if instr.Op == BC_SHR { regs[instr.Dst] = regs[instr.Src1] >> regs[instr.Src2]; continue }

		// --- Floating-point arithmetic (float64 only) ---
		if instr.Op == BC_FADD {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			regs[instr.Dst] = bit_cast(int, a + b)
			continue
		}
		if instr.Op == BC_FSUB {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			regs[instr.Dst] = bit_cast(int, a - b)
			continue
		}
		if instr.Op == BC_FMUL {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			regs[instr.Dst] = bit_cast(int, a * b)
			continue
		}
		if instr.Op == BC_FDIV {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			regs[instr.Dst] = bit_cast(int, a / b)
			continue
		}

		// --- Comparison ---
		if instr.Op == BC_EQ {
			if regs[instr.Src1] == regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_NE {
			if regs[instr.Src1] != regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SLT {
			if regs[instr.Src1] < regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SLE {
			if regs[instr.Src1] <= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SGT {
			if regs[instr.Src1] > regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_SGE {
			if regs[instr.Src1] >= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}

		// --- Floating-point comparison (ordered predicates) ---
		if instr.Op == BC_FEQ {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			if a == b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_FNE {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			if a != b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_FLT {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			if a < b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_FLE {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			if a <= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_FGT {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			if a > b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_FGE {
			var a float64 = bit_cast(float64, regs[instr.Src1])
			var b float64 = bit_cast(float64, regs[instr.Src2])
			if a >= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}

		// --- Unary ---
		if instr.Op == BC_NEG {
			regs[instr.Dst] = 0 - regs[instr.Src1]
			continue
		}
		if instr.Op == BC_NOT {
			if regs[instr.Src1] == 0 { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
			continue
		}
		if instr.Op == BC_BITNOT {
			regs[instr.Dst] = regs[instr.Src1] ^ -1
			continue
		}
		if instr.Op == BC_FNEG {
			var x float64 = bit_cast(float64, regs[instr.Src1])
			regs[instr.Dst] = bit_cast(int, 0.0 - x)
			continue
		}

		// --- Memory ---
		if instr.Op == BC_STACK_ALLOC {
			regs[instr.Dst] = bit_cast(int, frameBase) + instr.Imm
			continue
		}
		if instr.Op == BC_LOAD64 {
			var p *int = bit_cast(*int, regs[instr.Src1])
			regs[instr.Dst] = p[0]
			continue
		}
		if instr.Op == BC_STORE64 {
			var p *int = bit_cast(*int, regs[instr.Src1])
			p[0] = regs[instr.Src2]
			continue
		}
		if instr.Op == BC_LOAD8 {
			var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
			if instr.Imm <= 1 { regs[instr.Dst] = cast(int, p[0]) } else {
				var val int = 0
				for i := instr.Imm - 1; i >= 0; i-- { val = (val << 8) | cast(int, p[i]) }
				regs[instr.Dst] = val
			}
			continue
		}
		if instr.Op == BC_STORE8 {
			var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
			if instr.Imm <= 1 { p[0] = cast(uint8, regs[instr.Src2]) } else {
				var val int = regs[instr.Src2]
				for i := 0; i < instr.Imm; i++ { p[i] = cast(uint8, val & 255); val = val >> 8 }
			}
			continue
		}
		if instr.Op == BC_MEMCPY {
			rt.MemCopy(bit_cast(*uint8, regs[instr.Src1]),
				bit_cast(*uint8, regs[instr.Src2]),
				instr.Imm)
			continue
		}
		if instr.Op == BC_MEMSET {
			rt.MemZero(bit_cast(*uint8, regs[instr.Src1]),
				instr.Imm)
			continue
		}
		if instr.Op == BC_FIELD_PTR {
			regs[instr.Dst] = regs[instr.Src1] + instr.Imm
			continue
		}
		if instr.Op == BC_ELEM_PTR {
			regs[instr.Dst] = regs[instr.Src1] +
				regs[instr.Src2] * instr.Imm
			continue
		}
		if instr.Op == BC_EXTRACT {
			// Imm = byte offset (or word index in legacy mode)
			// Aux = 0: load 1 word at offset
			// Aux = 1: return pointer (offset arithmetic only)
			// Aux = 2: legacy word-indexed load (Imm * 8)
			if instr.Aux == 1 {
				regs[instr.Dst] = regs[instr.Src1] +
					instr.Imm
			} else if instr.Aux == 2 {
				var p *int = bit_cast(*int,
					regs[instr.Src1])
				regs[instr.Dst] = p[instr.Imm]
			} else {
				var p *int = bit_cast(*int,
					regs[instr.Src1] + instr.Imm)
				regs[instr.Dst] = p[0]
			}
			continue
		}

		// --- Control flow ---
		if instr.Op == BC_JUMP { pc = instr.Aux; continue }
		if instr.Op == BC_BRANCH {
			if regs[instr.Src1] != 0 { pc = instr.Imm } else { pc = instr.Aux }
			continue
		}

		if instr.Op == BC_RETURN {
			var retVal int = 0
			var copySize int = 0
			if instr.Dst == 0 {
				retVal = regs[instr.Src1]
				// Aggregate single-return: bytes to copy back
				// (set by lowerReturn). 0 for scalars/pointers.
				copySize = instr.Aux
			} else if instr.Dst > 0 {
				// Multi-return: pack values inline at proper
				// offsets matching the anonymous struct layout
				// (from f.ResultSizes/Offsets). Struct values
				// are MEMCPY'd by size; scalars get one word.
				var sbase int = bit_cast(int, vm.Stack)
				var dstBase int = sbase + vm.SP
				var totalSize int = 0
				for i := 0; i < instr.Imm; i++ {
					var sz int = f.ResultSizes[i]
					var off int = f.ResultOffsets[i]
					var srcVal int = regs[instr.Src1 + i]
					// For multi-word types srcVal is a pointer
					// (lowerLoad returns the alloca pointer for
					// struct/slice/array). Use MEMCPY regardless
					// of size — a struct{int} has sz=8 but srcVal
					// still holds a pointer to it, not the bytes.
					if f.ResultMultiWord[i] {
						rt.MemCopy(
							bit_cast(*uint8,
								dstBase + off),
							bit_cast(*uint8, srcVal),
							sz)
					} else {
						var p *int = bit_cast(*int,
							dstBase + off)
						p[0] = srcVal
					}
					if off + sz > totalSize {
						totalSize = off + sz
					}
				}
				// Align total size to 8
				totalSize = (totalSize + 7) / 8 * 8
				vm.SP = vm.SP + totalSize
				retVal = dstBase
				copySize = totalSize
			}
			// Read frame header (just before registers)
			var hdr *int = stackPtr(vm, regsOff - FRAME_HDR)
			if hdr[0] == -1 {
				// Top-level frame: return to execFunc
				return retVal
			}
			// Pop frame: restore caller state
			var callerPC int = hdr[0]
			var callerFuncIdx int = hdr[1]
			var callerRegsOff int = hdr[2]
			var callerSP int = hdr[3]
			var callerDst int = hdr[4]
			// freeOnPop: set by BC_REFDEC_INLINE_FAST's iterative
			// dispatch when it pushes a dtor frame. After we restore
			// caller state below, rt.Free this payload — completing
			// the "decrement → run dtor → free" sequence without
			// host recursion. 0 = no action.
			var freeOnPop int = hdr[5]
			// If retVal points into the callee's region (a struct
			// alloca, packed multi-return, or managed-slice
			// header), we must copy it back to caller space so
			// the callee's frame can be popped cleanly. Without
			// this copy, callerSP would have to be bumped to
			// vm.SP, leaking the entire callee frame on every
			// call — a tight loop blows the stack quickly.
			// Mirrors execFunc's same logic for the entry frame.
			var sbase int = bit_cast(int, vm.Stack)
			if copySize > 0 &&
				retVal >= sbase + callerSP &&
				retVal < sbase + vm.SP {
				rt.MemCopy(
					bit_cast(*uint8, sbase + callerSP),
					bit_cast(*uint8, retVal),
					copySize)
				retVal = sbase + callerSP
				callerSP = callerSP + copySize
			}
			vm.SP = callerSP
			// Restore caller context
			funcIdx = callerFuncIdx
			f = vm.Funcs[funcIdx]
			code = f.Code
			regsOff = callerRegsOff
			regs = stackPtr(vm, regsOff)
			frameBase = bit_cast(*uint8,
				bit_cast(int, vm.Stack) + regsOff +
					f.NumRegs * 8)
			pc = callerPC
			if callerDst >= 0 {
				regs[callerDst] = retVal
			}
			if freeOnPop != 0 {
				rt.Free(bit_cast(*uint8, freeOnPop))
			}
			continue
		}

		// --- Function calls ---
		if instr.Op == BC_CALL {
			var calleeFuncIdx int = f.CallCache[instr.Aux]
			if calleeFuncIdx == -2 {
				calleeFuncIdx = LookupFunc(vm,
					f.Names[instr.Aux])
				f.CallCache[instr.Aux] = calleeFuncIdx
			}
			if calleeFuncIdx < 0 {
				var callName @[]char = f.Names[instr.Aux]
				// Extern call: reuse the hoisted callArgs buffer.
				if instr.Imm > len(callArgs) {
					println("vm: extern call has too many args")
					rt.Exit(1)
				}
				for i := 0; i < instr.Imm; i++ {
					callArgs[i] = regs[instr.Src1 + i]
				}
				var result int = execExtern(vm,
					callName, callArgs, instr)
				if instr.Dst >= 0 {
					regs[instr.Dst] = result
				}
				continue
			}
			// VM function call: push frame, switch context
			var calleeFunc @VMFunc = vm.Funcs[calleeFuncIdx]
			var newRegsOff int = pushFrame(vm, calleeFunc,
				pc, funcIdx, regsOff, vm.SP, instr.Dst)
			// Copy args to callee params
			var newRegs *int = stackPtr(vm, newRegsOff)
			for i := 0; i < instr.Imm &&
				i < calleeFunc.NumParams; i++ {
				newRegs[i] = regs[instr.Src1 + i]
			}
			// Switch to callee
			funcIdx = calleeFuncIdx
			f = calleeFunc
			code = f.Code
			regsOff = newRegsOff
			regs = newRegs
			frameBase = bit_cast(*uint8,
				bit_cast(int, vm.Stack) + newRegsOff +
					f.NumRegs * 8)
			pc = 0
			continue
		}

		if instr.Op == BC_CALL_INDIRECT {
			// fn_ptr (Src1 register) is normally a 1-based VM function
			// index; args at [Src2 .. Src2+Imm-1]. Cross-mode interop:
			// when fnIdx falls outside [1, len(vm.Funcs)], it's a
			// NATIVE function pointer stored by compiled code (the
			// classic case: h[1] = native RawFree address from a
			// native rt.Alloc, later RefDec'd from bytecode in the
			// boot-comp-int-int chain). For single-arg
			// `func(*uint8)` callbacks (the _call_free_fn /
			// _call_dtor signature) we dispatch via
			// `rt._call_free_fn`, whose lowering in the natively-
			// compiled VM is OP_CALL_INDIRECT against the native
			// pointer — i.e. a real native indirect call. Broader
			// cross-mode dispatch with arbitrary signatures is
			// Phase 3 of plan-function-values.md; that's why other
			// argument counts still error out here.
			var fnIdx int = regs[instr.Src1]
			if fnIdx == 0 {
				println("vm: indirect call through nil function pointer")
				rt.Exit(1)
			}
			var calleeFuncIdx int = fnIdx - 1
			if calleeFuncIdx < 0 ||
				calleeFuncIdx >= len(vm.Funcs) {
				if instr.Imm == 1 {
					var nativeFn *uint8 =
						bit_cast(*uint8, fnIdx)
					var arg *uint8 =
						bit_cast(*uint8, regs[instr.Src2])
					rt._call_free_fn(nativeFn, arg)
					continue
				}
				print("vm: indirect call: function index out of range; fnIdx=")
				print(bootstrap.Itoa(fnIdx))
				print(" len(vm.Funcs)=")
				print(bootstrap.Itoa(len(vm.Funcs)))
				print(" caller=")
				println(f.Name)
				rt.Exit(1)
			}
			var calleeFunc @VMFunc =
				vm.Funcs[calleeFuncIdx]
			var newRegsOff int = pushFrame(vm, calleeFunc,
				pc, funcIdx, regsOff, vm.SP, instr.Dst)
			var newRegs *int = stackPtr(vm, newRegsOff)
			for i := 0; i < instr.Imm &&
				i < calleeFunc.NumParams; i++ {
				newRegs[i] = regs[instr.Src2 + i]
			}
			funcIdx = calleeFuncIdx
			f = calleeFunc
			code = f.Code
			regsOff = newRegsOff
			regs = newRegs
			frameBase = bit_cast(*uint8,
				bit_cast(int, vm.Stack) + newRegsOff +
					f.NumRegs * 8)
			pc = 0
			continue
		}

		if instr.Op == BC_CALL_FUNC_VALUE {
			// Function-value call. The function value's address (16-
			// byte {vtable_addr, data_addr}) is in regs[Src1]. For
			// VM-side function values, data points at a VMClosureRec
			// `{ kind, vm_func_idx, captured_ctx }`. We short-circuit
			// the trampoline: check kind, read vm_func_idx, and
			// dispatch via execFunc. The kind discriminator
			// distinguishes VM closure records from compiled-side
			// data shapes (Phase 2 / cross-mode handling lands in
			// Slice 3.3 — see plan-function-values-phase-3.md).
			var fvAddr int = regs[instr.Src1]
			if fvAddr == 0 {
				println("vm: call through nil function value")
				rt.Exit(1)
			}
			var fv *int = bit_cast(*int, fvAddr)
			var closureRecAddr int = fv[1]
			if closureRecAddr == 0 {
				// data == null: compiled-side non-capturing function
				// value reached from bytecode. Cross-mode dispatch
				// via vtable.call lands in Slice 3.3; until then
				// this is an error path.
				println("vm: function value's data is nil (cross-mode dispatch not yet supported — Slice 3.3)")
				rt.Exit(1)
			}
			var closureRec *int = bit_cast(*int, closureRecAddr)
			var dataKind int = closureRec[0]
			if dataKind != rt.DATA_KIND_VM_CLOSURE_REC {
				print("vm: unsupported function-value data kind: ")
				print(bootstrap.Itoa(dataKind))
				println(" (Slice 3.3 will add cross-mode dispatch)")
				rt.Exit(1)
			}
			// VMClosureRec layout: { kind, vm_handle, vm_func_idx,
			// captured_ctx }. The vm_handle (offset 1) is for the
			// cross-mode trampoline; same-mode dispatch uses
			// vm_func_idx (offset 2) directly.
			var fnIdx int = closureRec[2]
			if fnIdx == 0 {
				println("vm: function value's vm_func_idx is 0")
				rt.Exit(1)
			}
			var calleeFuncIdx int = fnIdx - 1
			if calleeFuncIdx < 0 ||
				calleeFuncIdx >= len(vm.Funcs) {
				println("vm: function-value call: idx out of range")
				rt.Exit(1)
			}
			var calleeFunc @VMFunc =
				vm.Funcs[calleeFuncIdx]
			var newRegsOff int = pushFrame(vm, calleeFunc,
				pc, funcIdx, regsOff, vm.SP, instr.Dst)
			var newRegs *int = stackPtr(vm, newRegsOff)
			for i := 0; i < instr.Imm &&
				i < calleeFunc.NumParams; i++ {
				newRegs[i] = regs[instr.Src2 + i]
			}
			funcIdx = calleeFuncIdx
			f = calleeFunc
			code = f.Code
			regsOff = newRegsOff
			regs = newRegs
			frameBase = bit_cast(*uint8,
				bit_cast(int, vm.Stack) + newRegsOff +
					f.NumRegs * 8)
			pc = 0
			continue
		}

		// --- Managed memory ---
		// BC_REFINC_INLINE / BC_ALLOC / BC_BOX / BC_NIL_CHECK /
		// BC_BOUNDS_CHECK / BC_MAKE_SLICE all dispatch through
		// execManagedMemoryOp; they don't touch loop-local control
		// state and so live in vm_exec_helpers.bn.
		if execManagedMemoryOp(vm, regs, instr) { continue }
		if instr.Op == BC_REFDEC_INLINE_FAST {
			// Inline-fast-path RefDec: nil-check + decrement always
			// inline (no rt.RefDec call). Slow path: rt.Free for
			// no-dtor, iterative dtor dispatch otherwise (flat-
			// stack — pushes the dtor frame on the VM stack and
			// stashes the ptr in freeOnPop, so BC_RETURN's pop
			// frees it after the dtor runs without recursing
			// through the host stack).
			var ptr *uint8 = bit_cast(*uint8, regs[instr.Src1])
			if ptr == nil { continue }
			var hd *int = bit_cast(*int,
				bit_cast(int, ptr) - 16)
			hd[0] = hd[0] - 1
			if hd[0] != 0 { continue }
			// Refcount hit 0.
			var dtorIdx int = 0
			if instr.Src2 >= 0 { dtorIdx = regs[instr.Src2] }
			if dtorIdx == 0 {
				// No dtor: ZeroRefDestroy(ptr, null) ≡ rt.Free(ptr).
				rt.Free(ptr)
				continue
			}
			// Has dtor: iterative dispatch.
			var dtorFunc @VMFunc = vm.Funcs[dtorIdx - 1]
			var newRegsOff int = pushFrame(vm, dtorFunc, pc,
				funcIdx, regsOff, vm.SP, -1)
			var newHdr *int = stackPtr(vm,
				newRegsOff - FRAME_HDR)
			newHdr[5] = bit_cast(int, ptr)
			var newRegs *int = stackPtr(vm, newRegsOff)
			newRegs[0] = bit_cast(int, ptr)
			funcIdx = dtorIdx - 1
			f = dtorFunc
			code = f.Code
			regsOff = newRegsOff
			regs = newRegs
			frameBase = bit_cast(*uint8,
				bit_cast(int, vm.Stack) + newRegsOff +
					f.NumRegs * 8)
			pc = 0
			continue
		}
		if execFuncRefOp(vm, f, regs, instr) { continue }
		if execNumericCast(regs, instr) { continue }

		print("vm: unhandled opcode ")
		println(instr.Op)
		rt.Exit(1)
	}
	return 0
}
