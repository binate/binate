package "pkg/vm"

// 64-bit (register-pair) op handlers, used only when REG_SLOT < 8 (a
// host whose word can't hold a 64-bit value in one slot).  A 64-bit
// operand/dest occupies a register pair: base slot = low 32 bits,
// base+1 = high 32 bits.  See explorations/plan-vm-64bit-on-32bit.md
// (Layer 2 step 3).
//
// The computation is factored into pure evalArith64 / evalCmp64 (int64
// in/out) so it is directly unit-testable on any host — compileAndRun
// can't reach these on a 64-bit host, where lowering keeps int64 in a
// single slot.  execOp64 is thin glue: join the source pairs, compute,
// split the result back (relying on the tested splitInt64/joinInt64).

// evalArith64 computes a 64-bit arithmetic / bitwise result.  Returns
// (result, true) when op is one it handles, (0, false) otherwise.
func evalArith64(op int, a int64, b int64) (int64, bool) {
	if op == BC_ADD64 { return a + b, true }
	if op == BC_SUB64 { return a - b, true }
	if op == BC_MUL64 { return a * b, true }
	if op == BC_DIV64 { return a / b, true }
	if op == BC_REM64 { return a % b, true }
	if op == BC_UDIV64 {
		return cast(int64, cast(uint64, a) / cast(uint64, b)), true
	}
	if op == BC_UREM64 {
		return cast(int64, cast(uint64, a) % cast(uint64, b)), true
	}
	if op == BC_AND64 { return a & b, true }
	if op == BC_OR64 { return a | b, true }
	if op == BC_XOR64 { return a ^ b, true }
	return cast(int64, 0), false
}

// widen64Signed sign-extends a 32-bit pattern (carried in the low 32
// bits of a host-`int` register) to int64.  Truncates through int32
// first so the result models a 32-bit-target widening regardless of
// the host word width — on a 64-bit host, where `int` is 64-bit, a
// plain `cast(int64, v)` would be the identity (incorrect: would not
// sign-extend a stored int32 bit pattern), but the int32 truncation
// drops the host's extra high bits before sign-extension.
func widen64Signed(v int) int64 {
	return cast(int64, cast(int32, v))
}

// widen64Unsigned zero-extends a 32-bit pattern to int64.  Truncates
// through uint32 first so the high bits of v (on a 64-bit host) are
// dropped before zero-extension.
func widen64Unsigned(v int) int64 {
	return cast(int64, cast(uint32, v))
}

// evalShift64 computes a 64-bit shift.  The count is masked to 0..63
// (a shift ≥ the width is otherwise undefined).  BC_SHR64 is
// arithmetic (sign-propagating); BC_LSHR64 is logical (reinterprets
// through uint64 so it shifts in zeros).
func evalShift64(op int, a int64, count int) (int64, bool) {
	var c int64 = cast(int64, count) & cast(int64, 63)
	if op == BC_SHL64 { return a << c, true }
	if op == BC_SHR64 { return a >> c, true }
	if op == BC_LSHR64 {
		return cast(int64, cast(uint64, a) >> cast(uint64, c)), true
	}
	return cast(int64, 0), false
}

// evalCmp64 computes a 64-bit comparison.  Returns (result, true) when
// op is a comparison it handles, (false, false) otherwise.  The
// unsigned forms reinterpret through uint64 so values with bit 63 set
// sort as large positives, not negatives.
func evalCmp64(op int, a int64, b int64) (bool, bool) {
	if op == BC_EQ64 { return a == b, true }
	if op == BC_NE64 { return a != b, true }
	if op == BC_SLT64 { return a < b, true }
	if op == BC_SLE64 { return a <= b, true }
	if op == BC_SGT64 { return a > b, true }
	if op == BC_SGE64 { return a >= b, true }
	if op == BC_ULT64 { return cast(uint64, a) < cast(uint64, b), true }
	if op == BC_ULE64 { return cast(uint64, a) <= cast(uint64, b), true }
	if op == BC_UGT64 { return cast(uint64, a) > cast(uint64, b), true }
	if op == BC_UGE64 { return cast(uint64, a) >= cast(uint64, b), true }
	return false, false
}

// execOp64 dispatches the BC_*64 (register-pair) ops.  Returns true if
// handled (caller `continue`s), false otherwise (caller falls through
// to the next dispatch family).
func execOp64(regs *int, instr BCInstr) bool {
	// The BC_*64 ops are a contiguous enum block; bail early for
	// anything else so the unconditional pair reads below never touch
	// a non-pair operand.
	if instr.Op < BC_LOAD_IMM64 || instr.Op > BC_UGE64 {
		return false
	}
	if instr.Op == BC_LOAD_IMM64 {
		regs[instr.Dst] = instr.Imm
		regs[instr.Dst + 1] = instr.Aux
		return true
	}
	if instr.Op == BC_MOV64 {
		regs[instr.Dst] = regs[instr.Src1]
		regs[instr.Dst + 1] = regs[instr.Src1 + 1]
		return true
	}
	// Cast NARROW takes the pair's low slot; WIDEN_S/U produce a pair
	// from a single-slot src.  Src1 is a single slot for the widens
	// (no pair to join), so handle these before the join-both-pairs
	// path below.
	if instr.Op == BC_NARROW64 {
		regs[instr.Dst] = regs[instr.Src1]
		return true
	}
	if instr.Op == BC_WIDEN64_S || instr.Op == BC_WIDEN64_U {
		var w int64
		if instr.Op == BC_WIDEN64_S {
			w = widen64Signed(regs[instr.Src1])
		} else {
			w = widen64Unsigned(regs[instr.Src1])
		}
		var wlo int
		var whi int
		wlo, whi = splitInt64(w)
		regs[instr.Dst] = wlo
		regs[instr.Dst + 1] = whi
		return true
	}
	// Pair memory ops: index through *uint32 (always 4 bytes per
	// element) so the load/store moves 8 bytes regardless of host
	// word size — *int indexing would be just 4 bytes on a 32-bit
	// host and miss the high half of a target int64.  Target byte
	// order is little-endian (arm32-linux), so p[0] is the low word
	// and p[1] the high.
	if instr.Op == BC_LOAD64_PAIR {
		var p *uint32 = bit_cast(*uint32, regs[instr.Src1])
		regs[instr.Dst] = cast(int, p[0])
		regs[instr.Dst + 1] = cast(int, p[1])
		return true
	}
	if instr.Op == BC_STORE64_PAIR {
		var p *uint32 = bit_cast(*uint32, regs[instr.Src1])
		p[0] = cast(uint32, regs[instr.Src2])
		p[1] = cast(uint32, regs[instr.Src2 + 1])
		return true
	}
	// Shifts: the shift count is a small value living in Src2's low
	// slot (whether the count's IR type is int or int64), so read it
	// as a single slot rather than joining a pair.
	if instr.Op == BC_SHL64 || instr.Op == BC_SHR64 ||
			instr.Op == BC_LSHR64 {
		var val int64 = joinInt64(regs[instr.Src1], regs[instr.Src1 + 1])
		var sr int64
		var sok bool
		sr, sok = evalShift64(instr.Op, val, regs[instr.Src2])
		if sok {
			var slo int
			var shi int
			slo, shi = splitInt64(sr)
			regs[instr.Dst] = slo
			regs[instr.Dst + 1] = shi
			return true
		}
	}
	var a int64 = joinInt64(regs[instr.Src1], regs[instr.Src1 + 1])
	var b int64 = joinInt64(regs[instr.Src2], regs[instr.Src2 + 1])
	var r int64
	var ok bool
	r, ok = evalArith64(instr.Op, a, b)
	if ok {
		var lo int
		var hi int
		lo, hi = splitInt64(r)
		regs[instr.Dst] = lo
		regs[instr.Dst + 1] = hi
		return true
	}
	var cmp bool
	var cok bool
	cmp, cok = evalCmp64(instr.Op, a, b)
	if cok {
		if cmp {
			regs[instr.Dst] = 1
		} else {
			regs[instr.Dst] = 0
		}
		return true
	}
	return false
}
