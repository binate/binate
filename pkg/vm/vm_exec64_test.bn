package "pkg/vm"

import "pkg/builtin/testing"

// Coverage for the pure 64-bit op computation (evalArith64 /
// evalCmp64).  execOp64's glue (join src pairs → eval → split to dst)
// rests on these plus the tested splitInt64/joinInt64, and is
// exercised end-to-end by the int64-on-arm32 conformance test.

func TestEvalArith64() testing.TestResult {
	var big int64 = cast(int64, 1) << cast(int64, 40) // > 2^32
	var r int64
	var ok bool
	r, ok = evalArith64(BC_ADD64, big, cast(int64, 5))
	if !ok || r != big + cast(int64, 5) { return "ADD64" }
	r, ok = evalArith64(BC_SUB64, big, cast(int64, 5))
	if !ok || r != big - cast(int64, 5) { return "SUB64" }
	r, ok = evalArith64(BC_MUL64, cast(int64, 3000000000), cast(int64, 3))
	if !ok || r != cast(int64, 9000000000) { return "MUL64 past 2^32" }
	r, ok = evalArith64(BC_AND64, big, big)
	if !ok || r != big { return "AND64" }
	// not an arith op
	r, ok = evalArith64(BC_EQ64, big, big)
	if ok { return "evalArith64 must reject a compare op" }
	return ""
}

// Unsigned division/remainder must treat a bit-63-set operand as a
// large positive, not a negative (where signed / would give 0).
func TestEvalArith64Unsigned() testing.TestResult {
	var hi int64 = cast(int64, -1) // 0xFFFFFFFFFFFFFFFF as uint64 = max
	var r int64
	var ok bool
	r, ok = evalArith64(BC_UDIV64, hi, cast(int64, 7))
	if !ok { return "UDIV64 not handled" }
	if r != cast(int64, cast(uint64, hi) / cast(uint64, 7)) {
		return "UDIV64 should divide as unsigned"
	}
	// signed DIV64 of the same bit pattern (-1 / 7) is 0 — confirms
	// the unsigned path differs.
	r, ok = evalArith64(BC_DIV64, hi, cast(int64, 7))
	if r != cast(int64, 0) { return "signed DIV64(-1,7) should be 0" }
	return ""
}

// widen64Signed and widen64Unsigned diverge precisely on a
// bit-31-set input: signed sign-extends (the result is negative),
// unsigned zero-extends.  This is the case where dropping the
// distinction silently corrupts widened values on a 32-bit host.
func TestWiden64SignedVsUnsigned() testing.TestResult {
	// 0xFFFFFFFF: bit 31 set; as int32 it's -1, as uint32 it's max.
	var x int = cast(int, cast(uint32, 0xFFFFFFFF))
	if widen64Signed(x) != cast(int64, -1) {
		return "widen64Signed should sign-extend to -1"
	}
	if widen64Unsigned(x) != cast(int64, 0xFFFFFFFF) {
		return "widen64Unsigned should zero-extend to 0xFFFFFFFF"
	}
	// Small positive: both agree.
	if widen64Signed(42) != cast(int64, 42) { return "S(42) != 42" }
	if widen64Unsigned(42) != cast(int64, 42) { return "U(42) != 42" }
	return ""
}

// Shifts span the 32-bit boundary (so the pair representation
// matters) and distinguish arithmetic (BC_SHR64, sign-propagating)
// from logical (BC_LSHR64, zero-filling) right shifts.
func TestEvalShift64() testing.TestResult {
	var r int64
	var ok bool
	// 1 << 40 lands entirely in the high word.
	r, ok = evalShift64(BC_SHL64, cast(int64, 1), 40)
	if !ok || r != cast(int64, 1) << cast(int64, 40) { return "SHL64 by 40" }
	// arithmetic >> of a negative keeps the sign.
	r, ok = evalShift64(BC_SHR64, cast(int64, -1), 8)
	if !ok || r != cast(int64, -1) { return "SHR64 of -1 stays -1 (arith)" }
	// logical >> of -1 (=u64 max) by 8 shifts in zeros.
	r, ok = evalShift64(BC_LSHR64, cast(int64, -1), 8)
	if !ok || r != cast(int64, cast(uint64, cast(int64, -1)) >> cast(uint64, 8)) {
		return "LSHR64 must zero-fill"
	}
	r, ok = evalShift64(BC_ADD64, cast(int64, 1), 1)
	if ok { return "evalShift64 must reject a non-shift op" }
	return ""
}

func TestEvalCmp64() testing.TestResult {
	var big int64 = cast(int64, 1) << cast(int64, 40)
	var c bool
	var ok bool
	c, ok = evalCmp64(BC_SLT64, cast(int64, 5), big)
	if !ok || !c { return "5 <s big" }
	c, ok = evalCmp64(BC_EQ64, big, big)
	if !ok || !c { return "big ==  big" }
	// signed vs unsigned on a bit-63-set value: -1 <s 1 but -1 >u 1.
	c, ok = evalCmp64(BC_SLT64, cast(int64, -1), cast(int64, 1))
	if !ok || !c { return "-1 <s 1" }
	c, ok = evalCmp64(BC_ULT64, cast(int64, -1), cast(int64, 1))
	if !ok || c { return "-1 (=max u64) is NOT <u 1" }
	// not a compare op
	c, ok = evalCmp64(BC_ADD64, big, big)
	if ok { return "evalCmp64 must reject an arith op" }
	return ""
}
