package "pkg/vm"

import "pkg/bootstrap"
import "pkg/rt"

// Func-ref / function-value bytecode dispatch (BC_FUNC_HANDLE,
// BC_FUNC_VALUE, plus the cross-mode call shims). Split out of
// vm_exec_helpers.bn so that file stays under the soft length cap.
// execLoop in vm_exec.bn still calls execFuncRefOp directly; the
// move is text-only.

// execFuncRefOp dispatches BC_FUNC_HANDLE / BC_FUNC_VALUE. These
// read the call-site name cache and may lazily allocate a vtable +
// VM closure record on the heap — but they don't touch execLoop's
// control flow.
func execFuncRefOp(vm @VM, f @VMFunc, regs *int, instr BCInstr) bool {
	if instr.Op == BC_FUNC_HANDLE {
		// Phase 4: return *uint8 pointing at a 16-byte {vtable_ptr,
		// data_ptr} handle — same shape as native `@__handle.F`.
		// Two sources:
		//   1. Externs registry (the function is registered via
		//      RegisterExtern with a handle pointer; the binding
		//      owns a managed copy in HandleAddr) — propagated
		//      through nested vms by Externs-copy.
		//   2. Lazy heap-alloc on the VMFunc.Handle field for vm-
		//      local-only functions; the universal trampoline reads
		//      the closure record to dispatch via execFunc.
		var name @[]char = f.Names[instr.Aux]
		var eIdx int = vm.LookupExtern(name)
		if eIdx >= 0 && vm.Externs[eIdx].HandleAddr != nil {
			regs[instr.Dst] =
				bit_cast(int, vm.Externs[eIdx].HandleAddr)
			return true
		}
		var idx int = f.CallCache[instr.Aux]
		if idx == -2 {
			idx = vm.LookupFunc(name)
			f.CallCache[instr.Aux] = idx
		}
		if idx < 0 {
			print("vm: function not found: "); println(name); rt.Exit(1)
		}
		var callee @VMFunc = vm.Funcs[idx]
		ensureHandle(vm, callee, idx)
		regs[instr.Dst] = bit_cast(int, callee.Handle)
		return true
	}
	if instr.Op == BC_FUNC_VALUE {
		// Function-value construction. Look up the target
		// function (caching the index on the call site for
		// repeated executions), lazily allocate its vtable +
		// VM closure record on first use, and copy the 16-byte
		// {vtable_addr, closure_rec_addr} pair into a fresh
		// stack slot.
		//
		// Phase 1: vtable.call is left as 0 (placeholder).
		// Phase 3 will populate it with a per-signature
		// trampoline so cross-mode dispatch works. See
		// explorations/plan-function-values.md "VM-mode
		// vtables — interop-compatible from Phase 1".
		var idx int = f.CallCache[instr.Aux]
		if idx == -2 {
			idx = vm.LookupFunc(f.Names[instr.Aux])
			f.CallCache[instr.Aux] = idx
		}
		if idx < 0 {
			// LookupFunc miss: fall back to the executing VM's
			// vm.Externs registry.  Hosts (cmd/bni's main, test
			// drivers) populate the registry with bindings whose
			// VtableAddr already points at the right __vt — for
			// pure-C externs (libc.*, the C-shaped pkg/bootstrap
			// surface) this is the only construction path
			// available because they have no `.bn` body to
			// resolve via LookupFunc.  Each layer's host
			// registers into the next layer's VM before that
			// layer's main runs, so this dispatch works at
			// arbitrary recursion depth (cmd/bni-on-cmd/bni etc.).
			var name @[]char = f.Names[instr.Aux]
			var eIdx int = vm.LookupExtern(name)
			if eIdx >= 0 {
				var binding ExternBinding = vm.Externs[eIdx]
				var fvAddr *int = stackPtr(vm, vm.SP)
				var fvAddrInt int =
					bit_cast(int, vm.Stack) + vm.SP
				vm.SP = vm.SP + 16
				fvAddr[0] = binding.VtableAddr
				fvAddr[1] = binding.DataAddr
				regs[instr.Dst] = fvAddrInt
				return true
			}
			print("vm: function not found: "); println(name)
			rt.Exit(1)
		}
		var callee @VMFunc = vm.Funcs[idx]
		ensureHandle(vm, callee, idx)
		// Build the function value in a fresh 16-byte stack
		// slot at SP. SP grows by 16; the slot's address is
		// the result.
		var fvAddr *int = stackPtr(vm, vm.SP)
		var fvAddrInt int = bit_cast(int, vm.Stack) + vm.SP
		vm.SP = vm.SP + 16
		fvAddr[0] = bit_cast(int, callee.Vtable)
		// Data slot:
		//   - non-capturing (Src1 == -1): use the cached
		//     per-callee ClosureRec (Phase 1, shared identity).
		//   - capturing (Src1 != -1): allocate a fresh
		//     COMPILED_CLOSURE record on the VM stack pointing
		//     at the alloca'd closure struct in regs[Src1].
		if instr.Src1 == -1 {
			fvAddr[1] = bit_cast(int, callee.ClosureRec)
		} else {
			// Capturing closure: the data slot must survive the
			// statement-end SP_RESTORE that wipes vm.SP back to
			// frame_end.  A stack-allocated rec at SP would be
			// overwritten by the next statement's pushes (e.g.
			// BC_STRING_COPY_MS in a following println).  Heap-
			// allocate via rt.Alloc — 32 bytes per closure
			// construction; the rec is never freed (small leak,
			// acceptable for B.2 *func — B.3 @func will hook this
			// into the closure's refcount lifecycle).
			var captureStructAddr int = regs[instr.Src1]
			var recPtr *uint8 = rt.Alloc(32)
			var rec *int = bit_cast(*int, recPtr)
			rec[0] = rt.DATA_KIND_COMPILED_CLOSURE
			rec[1] = bit_cast(int, vm)
			rec[2] = idx + 1
			rec[3] = captureStructAddr
			fvAddr[1] = bit_cast(int, recPtr)
		}
		regs[instr.Dst] = fvAddrInt
		return true
	}
	if execIfaceOp(vm, f, regs, instr) { return true }
	return false
}

// ensureHandle lazy-populates callee.Vtable, callee.ClosureRec, and
// callee.Handle so BC_FUNC_HANDLE / BC_FUNC_VALUE can return stable
// references without per-call allocation.  All three fields are
// managed (refcounted) so VMFunc's auto-emitted dtor releases them
// on VMFunc death.  The vtable's call slot points at the universal
// trampoline whose native address is reachable from the executing
// vm's Externs registry.  TrampolineAggregate is picked when the
// callee returns a single multi-word value; the self-reference
// override handles the trampolines themselves so they don't recurse.
// Phase 4 of plan-uniform-native-fnptrs.md.
func ensureHandle(vm @VM, callee @VMFunc, idx int) {
	if callee.Vtable == nil {
		var trampolineName *[]const char = "pkg/vm.TrampolineScalar"
		if len(callee.ResultMultiWord) == 1 &&
				callee.ResultMultiWord[0] {
			trampolineName = "pkg/vm.TrampolineAggregate"
		}
		if streq(callee.Name, "pkg/vm.TrampolineScalar") {
			trampolineName = "pkg/vm.TrampolineScalar"
		}
		if streq(callee.Name, "pkg/vm.TrampolineAggregate") {
			trampolineName = "pkg/vm.TrampolineAggregate"
		}
		var tIdx int = vm.LookupExtern(trampolineName)
		if tIdx < 0 {
			print("vm: ensureHandle: trampoline not registered: ")
			println(trampolineName)
			rt.Exit(1)
		}
		var tVtable *int = bit_cast(*int,
			vm.Externs[tIdx].VtableAddr)
		var vt @VMFuncVtable = make(VMFuncVtable)
		vt.Dtor = 0
		vt.Call = tVtable[1]
		callee.Vtable = vt
	}
	if callee.ClosureRec == nil {
		var rec @VMClosureRec = make(VMClosureRec)
		rec.Kind = rt.DATA_KIND_VM_CLOSURE_REC
		rec.Vm = bit_cast(int, vm)
		rec.FnIdx = idx + 1
		rec.Captured = 0
		callee.ClosureRec = rec
	}
	if callee.Handle == nil {
		var h @VMFuncHandle = make(VMFuncHandle)
		h.VtableAddr = bit_cast(int, callee.Vtable)
		h.DataAddr = bit_cast(int, callee.ClosureRec)
		callee.Handle = h
	}
}

// dispatchNativeIndirect dispatches BC_CALL_INDIRECT against a native
// fn pointer.  After Phase 4 of plan-uniform-native-fnptrs.md, the
// only IR-magic callers reaching BC_CALL_INDIRECT are
// `_call_shim_scalar` / `_call_shim_aggregate` — both pass a native
// pointer (a per-function __shim address), never a vm idx, so the
// caller already knows it's a native call.  Imm encodes the shim
// shape (8 = scalar / 7-arg, 9 = aggregate / retbuf-style); unknown
// shapes return false so the caller can diagnose.
func dispatchNativeIndirect(regs *int, instr BCInstr, fnIdx int) bool {
	var nativeFn *uint8 = bit_cast(*uint8, fnIdx)
	if instr.Imm == 8 {
		// rt._call_shim_scalar(fn, data, a0..a6) shape — the
		// always-shim convention from
		// plan-function-values-phase-3.md (Slice 3.1).  Dispatches
		// any compiled-side function value (and any registered
		// extern via dispatchExternBinding) to its per-function
		// shim.  When this path runs natively (e.g. from a bytecode
		// program executed by cmd/bni's native execLoop), the
		// rt._call_shim_scalar IR-magic call lowers to OP_CALL_INDIRECT
		// → real native indirect call to the shim.  When this same
		// dispatch runs as bytecode (a nested-VM scenario where
		// pkg/vm itself is bytecode in the outer VM), the bytecode
		// rt._call_shim_scalar emits BC_CALL_INDIRECT against the
		// shim address, which re-enters this very arm — ultimately
		// the outer native execLoop runs the actual call.
		var data *uint8 = bit_cast(*uint8, regs[instr.Src2])
		var a0 int = regs[instr.Src2 + 1]
		var a1 int = regs[instr.Src2 + 2]
		var a2 int = regs[instr.Src2 + 3]
		var a3 int = regs[instr.Src2 + 4]
		var a4 int = regs[instr.Src2 + 5]
		var a5 int = regs[instr.Src2 + 6]
		var a6 int = regs[instr.Src2 + 7]
		var result int = rt._call_shim_scalar(nativeFn, data,
			a0, a1, a2, a3, a4, a5, a6)
		if instr.Dst >= 0 {
			regs[instr.Dst] = result
		}
		return true
	}
	if instr.Imm == 9 {
		// rt._call_shim_aggregate(fn, retbuf, data, a0..a6) shape —
		// the retbuf-style aggregate counterpart.  Dispatches
		// aggregate-return function values (slices, managed-slices,
		// multi-word structs) through their retbuf-style shim.  The
		// caller (dispatchExternBinding's aggregate path, or compiled
		// emitCallFuncValue's aggregate branch) has already alloca'd
		// retbuf and writes the aggregate result there; the shim
		// returns void.  Same nested-bytecode soundness rationale as
		// the Imm==8 arm above.
		var retbuf *uint8 = bit_cast(*uint8, regs[instr.Src2])
		var data *uint8 = bit_cast(*uint8, regs[instr.Src2 + 1])
		var a0 int = regs[instr.Src2 + 2]
		var a1 int = regs[instr.Src2 + 3]
		var a2 int = regs[instr.Src2 + 4]
		var a3 int = regs[instr.Src2 + 5]
		var a4 int = regs[instr.Src2 + 6]
		var a5 int = regs[instr.Src2 + 7]
		var a6 int = regs[instr.Src2 + 8]
		rt._call_shim_aggregate(nativeFn, retbuf, data,
			a0, a1, a2, a3, a4, a5, a6)
		// instr.Dst is -1 for the void return; nothing to store.
		return true
	}
	return false
}

// dispatchCompiledFuncValue handles the cross-mode arm of
// BC_CALL_FUNC_VALUE: compiled-side function value (data == null)
// reached from bytecode. Reads vtable.call (the per-function shim,
// always-shim convention) and dispatches via rt._call_shim_scalar
// — its lowering in the natively-compiled VM is OP_CALL_INDIRECT
// against the native pointer. The fixed 7-int-arg shape mirrors
// vm.TrampolineScalar's variadic-style register-bank reading.
//
// fv points at the function value's 16-byte {vtable_addr,
// data_addr} struct on vm.Stack; data_addr is null on entry (the
// caller already branched on it). regs and instr are the
// bytecode call site's register bank and BCInstr.
func dispatchCompiledFuncValue(fv *int, regs *int, instr BCInstr) {
	var vtableAddr int = fv[0]
	if vtableAddr == 0 {
		println("vm: function value has nil vtable")
		rt.Exit(1)
	}
	var vtable *int = bit_cast(*int, vtableAddr)
	var callPtr int = vtable[1]
	if callPtr == 0 {
		println("vm: function value's vtable.call is nil")
		rt.Exit(1)
	}
	var fnPtr *uint8 = bit_cast(*uint8, callPtr)
	var dataPtr *uint8 = nil
	var nArgs int = instr.Imm
	var a0 int = 0
	var a1 int = 0
	var a2 int = 0
	var a3 int = 0
	var a4 int = 0
	var a5 int = 0
	var a6 int = 0
	if nArgs > 0 { a0 = regs[instr.Src2 + 0] }
	if nArgs > 1 { a1 = regs[instr.Src2 + 1] }
	if nArgs > 2 { a2 = regs[instr.Src2 + 2] }
	if nArgs > 3 { a3 = regs[instr.Src2 + 3] }
	if nArgs > 4 { a4 = regs[instr.Src2 + 4] }
	if nArgs > 5 { a5 = regs[instr.Src2 + 5] }
	if nArgs > 6 { a6 = regs[instr.Src2 + 6] }
	var result int = rt._call_shim_scalar(fnPtr, dataPtr,
		a0, a1, a2, a3, a4, a5, a6)
	if instr.Dst >= 0 {
		regs[instr.Dst] = result
	}
}
