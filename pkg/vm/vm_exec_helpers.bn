package "pkg/vm"

import "pkg/rt"

// execFunc enters the VM for a function call. This is the entry
// point from compiled code (CallFunc, execExtern's rt.CallDtor arm).
// Pushes an initial frame and runs the iterative dispatch loop.
func execFunc(vm @VM, funcIdx int, args @[]int) int {
	var f @VMFunc = vm.Funcs[funcIdx]
	var savedSP int = vm.SP

	// Push frame: header + registers + allocas
	var regsOff int = pushFrame(vm, f, -1, -1, 0, 0, -1)

	// Copy arguments into parameter registers
	var regs *int = stackPtr(vm, regsOff)
	for i := 0; i < len(args) && i < f.NumParams; i++ {
		regs[i] = args[i]
	}

	var result int = execLoop(vm, funcIdx, regsOff)

	// If result points into callee's stack region, copy it
	// to caller space before popping.
	var sbase int = bit_cast(int, vm.Stack)
	if result >= sbase + savedSP && result < sbase + vm.SP {
		var sz int = sbase + vm.SP - result
		if sz > 64 { sz = 64 }
		rt.MemCopy(bit_cast(*uint8, sbase + savedSP),
			bit_cast(*uint8, result), sz)
		result = sbase + savedSP
		savedSP = savedSP + sz
	}

	vm.SP = savedSP
	return result
}

// execStringOp dispatches BC_LOAD_STR / BC_STRING_COPY_MS /
// BC_STRING_COPY_ARR. These don't touch execLoop's control-flow
// state (pc, funcIdx, frameBase) — they only read instr / f /
// regs and push managed-slice headers / array buffers onto vm.SP.
// Returns true if instr.Op was one of these and the dispatch was
// handled; false otherwise so execLoop falls through to the next
// arm.
func execStringOp(vm @VM, f @VMFunc, regs *int, instr BCInstr) bool {
	if instr.Op == BC_LOAD_STR {
		// Return a stable pointer directly to the i-th
		// managed-slice header inside f.Strings's backing
		// (which is alive for the lifetime of the VMFunc /
		// module). Previously we copied the header onto
		// vm.SP per call — that turned `for { f("foo") }`-
		// style loops into vm.Stack overflows at ~262K
		// iterations because pushManagedSlice never popped.
		//
		// f.Strings is a 4-word managed slice: {data, len,
		// refptr, backingLen}. The `data` field (first
		// word) points at an array of @[]char headers (32
		// bytes each). Hand-compute the offset because
		// Binate's `&slice[i]` is currently restricted to
		// slice-of-struct in genIndexPtr.
		var stringsField *int = bit_cast(*int, &f.Strings)
		var dataPtr int = stringsField[0]
		var hdrPtr int = dataPtr + instr.Imm * 32
		if instr.Aux == 1 {
			regs[instr.Dst] = hdrPtr
		} else {
			var p *int = bit_cast(*int, hdrPtr)
			regs[instr.Dst] = p[0]
		}
		return true
	}
	if instr.Op == BC_STRING_COPY_MS {
		// Stage 2b: allocate a fresh managed-slice copy of the
		// literal. Refcount 1; independent of rodata.
		var str @[]char = f.Strings[instr.Imm]
		var strHdr int = pushManagedSlice(vm,
			bit_cast(*uint8, &str))
		var hdrP *int = bit_cast(*int, strHdr)
		var srcPtr int = hdrP[0]
		var strLen int = hdrP[1]
		var ms rt.ManagedSlice = rt.MakeManagedSlice(1, strLen)
		if strLen > 0 {
			rt.MemCopy(ms.Data,
				bit_cast(*uint8, srcPtr), strLen)
		}
		var msAddr *int = stackPtr(vm, vm.SP)
		vm.SP = vm.SP + 32
		msAddr[0] = bit_cast(int, ms.Data)
		msAddr[1] = ms.Len
		msAddr[2] = bit_cast(int, ms.Refptr)
		msAddr[3] = ms.BackingLen
		regs[instr.Dst] = bit_cast(int, msAddr)
		return true
	}
	if instr.Op == BC_STRING_COPY_ARR {
		// Stage 2c Phase 1: copy a string literal into a fresh
		// stack buffer of size Aux, zero-padded. Returns pointer
		// to the buffer; OP_STORE memcpys it into the target alloca.
		var str @[]char = f.Strings[instr.Imm]
		var strHdr int = pushManagedSlice(vm,
			bit_cast(*uint8, &str))
		var hdrP *int = bit_cast(*int, strHdr)
		var srcPtr int = hdrP[0]
		var strLen int = hdrP[1]
		var arrLen int = instr.Aux
		var bufAddr int = bit_cast(int, vm.Stack) + vm.SP
		vm.SP = vm.SP + arrLen
		rt.MemZero(bit_cast(*uint8, bufAddr), arrLen)
		var copyLen int = strLen
		if copyLen > arrLen { copyLen = arrLen }
		if copyLen > 0 {
			rt.MemCopy(bit_cast(*uint8, bufAddr),
				bit_cast(*uint8, srcPtr), copyLen)
		}
		regs[instr.Dst] = bufAddr
		return true
	}
	return false
}

// execFuncRefOp dispatches BC_FUNC_ADDR / BC_FUNC_VALUE. These
// read the call-site name cache and may lazily allocate a vtable +
// VM closure record on the heap — but they don't touch execLoop's
// control flow.
func execFuncRefOp(vm @VM, f @VMFunc, regs *int, instr BCInstr) bool {
	if instr.Op == BC_FUNC_ADDR {
		var idx int = f.CallCache[instr.Aux]
		if idx == -2 {
			idx = LookupFunc(vm, f.Names[instr.Aux])
			f.CallCache[instr.Aux] = idx
		}
		if idx < 0 {
			var name @[]char = f.Names[instr.Aux]
			print("vm: dtor not found: "); println(name); rt.Exit(1)
		}
		regs[instr.Dst] = idx + 1
		return true
	}
	if instr.Op == BC_FUNC_VALUE {
		// Function-value construction. Look up the target
		// function (caching the index on the call site for
		// repeated executions), lazily allocate its vtable +
		// VM closure record on first use, and copy the 16-byte
		// {vtable_addr, closure_rec_addr} pair into a fresh
		// stack slot.
		//
		// Phase 1: vtable.call is left as 0 (placeholder).
		// Phase 3 will populate it with a per-signature
		// trampoline so cross-mode dispatch works. See
		// explorations/plan-function-values.md "VM-mode
		// vtables — interop-compatible from Phase 1".
		var idx int = f.CallCache[instr.Aux]
		if idx == -2 {
			idx = LookupFunc(vm, f.Names[instr.Aux])
			f.CallCache[instr.Aux] = idx
		}
		if idx < 0 {
			var name @[]char = f.Names[instr.Aux]
			print("vm: function not found: "); println(name)
			rt.Exit(1)
		}
		var callee @VMFunc = vm.Funcs[idx]
		if callee.Vtable == 0 {
			// Vtable layout (16 bytes): {dtor, call}.
			//   dtor = 0 — non-capturing has no captured ctx
			//     to clean up; Phase 2 will populate this for
			//     capturing closures.
			//   call = address of TrampolineScalar — generic
			//     ABI-aware bridge that decodes its incoming
			//     register bank using sig info from `data` and
			//     dispatches into the current VM (Slice 3.2 of
			//     plan-function-values-phase-3.md). Compiled
			//     code reaching this vtable.call gets cross-
			//     mode dispatch automatically. Same-mode VM
			//     dispatch (BC_CALL_FUNC_VALUE) short-circuits
			//     via the closure record's vm_func_idx and
			//     never invokes the trampoline — see vm_exec.bn.
			var vtPtr *int = bit_cast(*int, rt.RawAlloc(16))
			rt.MemZero(bit_cast(*uint8, vtPtr), 16)
			vtPtr[0] = 0
			vtPtr[1] = bit_cast(int, _raw_func_addr(TrampolineScalar))
			callee.Vtable = bit_cast(int, vtPtr)
		}
		if callee.VMClosureRec == 0 {
			// VMClosureRec layout (32 bytes): { kind, vm_handle,
			// vm_func_idx, captured_ctx_or_nil }. The kind field
			// discriminates VM closure records from other Phase-3
			// data shapes (compiled-side captured closure structs,
			// etc.); the vm_handle is what the cross-mode
			// trampoline (TrampolineScalar) dispatches into.
			// Storing the VM in the record (vs a global) keeps
			// each function value self-contained and lets multiple
			// VMs coexist without ordering concerns. See
			// `plan-function-values-phase-3.md` (Slice 3.2).
			var rec *int = bit_cast(*int, rt.RawAlloc(32))
			rt.MemZero(bit_cast(*uint8, rec), 32)
			rec[0] = rt.DATA_KIND_VM_CLOSURE_REC
			rec[1] = bit_cast(int, vm)
			rec[2] = idx + 1   // 1-based VM function index
			rec[3] = 0         // captured_ctx (Phase 1: none)
			callee.VMClosureRec = bit_cast(int, rec)
		}
		// Build the function value in a fresh 16-byte stack
		// slot at SP. SP grows by 16; the slot's address is
		// the result.
		var fvAddr *int = stackPtr(vm, vm.SP)
		var fvAddrInt int = bit_cast(int, vm.Stack) + vm.SP
		vm.SP = vm.SP + 16
		fvAddr[0] = callee.Vtable
		fvAddr[1] = callee.VMClosureRec
		regs[instr.Dst] = fvAddrInt
		return true
	}
	return false
}

// dispatchNativeIndirect handles the cross-mode arm of
// BC_CALL_INDIRECT: when fnIdx isn't a valid VM index, treat it as
// a native function pointer stored by compiled code (e.g. native
// rt.Alloc storing RawFree's address in h[1], later RefDec'd from
// bytecode). Dispatches via rt._call_free_fn — its lowering in the
// natively-compiled VM is OP_CALL_INDIRECT against the native
// pointer. Currently only the single-arg `func(*uint8)` shape
// (Imm==1) is handled; other signatures fall through to the
// caller's diagnostic. Returns true if dispatched.
func dispatchNativeIndirect(regs *int, instr BCInstr, fnIdx int) bool {
	var nativeFn *uint8 = bit_cast(*uint8, fnIdx)
	if instr.Imm == 1 {
		// rt._call_free_fn(freeFn, ptr) shape — single-arg
		// func(*uint8) used by RefDec's free-fn dispatch.
		var arg *uint8 = bit_cast(*uint8, regs[instr.Src2])
		rt._call_free_fn(nativeFn, arg)
		return true
	}
	if instr.Imm == 8 {
		// rt._call_shim_scalar(fn, data, a0..a6) shape — the
		// always-shim convention from
		// plan-function-values-phase-3.md (Slice 3.1).  Dispatches
		// any compiled-side function value (and any registered
		// extern via dispatchExternBinding) to its per-function
		// shim.  When this path runs natively (e.g. from a bytecode
		// program executed by cmd/bni's native execLoop), the
		// rt._call_shim_scalar IR-magic call lowers to OP_CALL_INDIRECT
		// → real native indirect call to the shim.  When this same
		// dispatch runs as bytecode (a nested-VM scenario where
		// pkg/vm itself is bytecode in the outer VM), the bytecode
		// rt._call_shim_scalar emits BC_CALL_INDIRECT against the
		// shim address, which re-enters this very arm — ultimately
		// the outer native execLoop runs the actual call.
		var data *uint8 = bit_cast(*uint8, regs[instr.Src2])
		var a0 int = regs[instr.Src2 + 1]
		var a1 int = regs[instr.Src2 + 2]
		var a2 int = regs[instr.Src2 + 3]
		var a3 int = regs[instr.Src2 + 4]
		var a4 int = regs[instr.Src2 + 5]
		var a5 int = regs[instr.Src2 + 6]
		var a6 int = regs[instr.Src2 + 7]
		var result int = rt._call_shim_scalar(nativeFn, data,
			a0, a1, a2, a3, a4, a5, a6)
		if instr.Dst >= 0 {
			regs[instr.Dst] = result
		}
		return true
	}
	return false
}

// dispatchCompiledFuncValue handles the cross-mode arm of
// BC_CALL_FUNC_VALUE: compiled-side function value (data == null)
// reached from bytecode. Reads vtable.call (the per-function shim,
// always-shim convention) and dispatches via rt._call_shim_scalar
// — its lowering in the natively-compiled VM is OP_CALL_INDIRECT
// against the native pointer. The fixed 7-int-arg shape mirrors
// vm.TrampolineScalar's variadic-style register-bank reading.
//
// fv points at the function value's 16-byte {vtable_addr,
// data_addr} struct on vm.Stack; data_addr is null on entry (the
// caller already branched on it). regs and instr are the
// bytecode call site's register bank and BCInstr.
func dispatchCompiledFuncValue(fv *int, regs *int, instr BCInstr) {
	var vtableAddr int = fv[0]
	if vtableAddr == 0 {
		println("vm: function value has nil vtable")
		rt.Exit(1)
	}
	var vtable *int = bit_cast(*int, vtableAddr)
	var callPtr int = vtable[1]
	if callPtr == 0 {
		println("vm: function value's vtable.call is nil")
		rt.Exit(1)
	}
	var fnPtr *uint8 = bit_cast(*uint8, callPtr)
	var dataPtr *uint8 = nil
	var nArgs int = instr.Imm
	var a0 int = 0
	var a1 int = 0
	var a2 int = 0
	var a3 int = 0
	var a4 int = 0
	var a5 int = 0
	var a6 int = 0
	if nArgs > 0 { a0 = regs[instr.Src2 + 0] }
	if nArgs > 1 { a1 = regs[instr.Src2 + 1] }
	if nArgs > 2 { a2 = regs[instr.Src2 + 2] }
	if nArgs > 3 { a3 = regs[instr.Src2 + 3] }
	if nArgs > 4 { a4 = regs[instr.Src2 + 4] }
	if nArgs > 5 { a5 = regs[instr.Src2 + 5] }
	if nArgs > 6 { a6 = regs[instr.Src2 + 6] }
	var result int = rt._call_shim_scalar(fnPtr, dataPtr,
		a0, a1, a2, a3, a4, a5, a6)
	if instr.Dst >= 0 {
		regs[instr.Dst] = result
	}
}

// execNumericCast dispatches the numeric narrowing / int-float casts
// (BC_TRUNC8, BC_SITOF, BC_FTOSI, BC_F32TOSI, BC_F64_TO_F32,
// BC_F32_TO_F64). Pure register-to-register; no side effects.
func execNumericCast(regs *int, instr BCInstr) bool {
	if instr.Op == BC_TRUNC8 { regs[instr.Dst] = regs[instr.Src1] & 255; return true }
	if instr.Op == BC_SITOF {
		// Signed int → float64. Src1 is the int value in register
		// form; coerce through the native `int` width (which is
		// what the VM registers are) and let the cast produce the
		// float.
		var i int = regs[instr.Src1]
		regs[instr.Dst] = bit_cast(int, cast(float64, i))
		return true
	}
	if instr.Op == BC_FTOSI {
		// float64 → signed int. Truncates toward zero (Binate's
		// cast semantics).
		var f float64 = bit_cast(float64, regs[instr.Src1])
		regs[instr.Dst] = cast(int, f)
		return true
	}
	if instr.Op == BC_F32TOSI {
		// float32 (IEEE bits in low 4 bytes of Src1) → signed int.
		var u32 uint32 = cast(uint32, regs[instr.Src1])
		var f32 float32 = bit_cast(float32, u32)
		regs[instr.Dst] = cast(int, f32)
		return true
	}
	if instr.Op == BC_F64_TO_F32 {
		// Narrow float64 → float32. Result is the float32 IEEE
		// bits in the low 4 bytes (zero-extended via uint32).
		var f64 float64 = bit_cast(float64, regs[instr.Src1])
		var f32 float32 = cast(float32, f64)
		var u32 uint32 = bit_cast(uint32, f32)
		regs[instr.Dst] = cast(int, u32)
		return true
	}
	if instr.Op == BC_F32_TO_F64 {
		// Widen float32 (low 4 bytes of Src1) → float64.
		var u32 uint32 = cast(uint32, regs[instr.Src1])
		var f32 float32 = bit_cast(float32, u32)
		var f64 float64 = cast(float64, f32)
		regs[instr.Dst] = bit_cast(int, f64)
		return true
	}
	return false
}

// execManagedMemoryOp dispatches the managed-memory bytecodes that
// don't update execLoop's control flow: BC_REFINC_INLINE, BC_ALLOC,
// BC_BOX, BC_NIL_CHECK, BC_BOUNDS_CHECK, BC_MAKE_SLICE. Each reads
// regs / instr, may push 32 bytes onto vm.SP (BC_MAKE_SLICE) or
// fail loudly on a runtime check; none of them push or pop a frame.
// Returns true if instr.Op was one of these and was handled; false
// otherwise so execLoop falls through. Mirrors execStringOp /
// execFuncRefOp in shape.
//
// BC_REFDEC_INLINE_FAST is NOT covered here: its slow path pushes a
// dtor frame on the VM stack and updates execLoop's funcIdx / pc /
// frameBase, so it can't be hoisted without invasive in/out-pointer
// plumbing. It stays inline in execLoop.
func execManagedMemoryOp(vm @VM, regs *int, instr BCInstr) bool {
	if instr.Op == BC_REFINC_INLINE {
		var ptr *uint8 = bit_cast(*uint8, regs[instr.Src1])
		if ptr == nil { return true }
		var hd *int = bit_cast(*int,
			bit_cast(int, ptr) - 16)
		hd[0] = hd[0] + 1
		return true
	}
	if instr.Op == BC_ALLOC {
		regs[instr.Dst] = bit_cast(int,
			rt.Alloc(instr.Imm))
		return true
	}
	if instr.Op == BC_BOX {
		regs[instr.Dst] = bit_cast(int,
			rt.Box(bit_cast(*uint8, regs[instr.Src1]),
				instr.Imm))
		return true
	}
	if instr.Op == BC_NIL_CHECK {
		if regs[instr.Src1] == 0 {
			println("vm: nil pointer dereference")
			rt.Exit(1)
		}
		return true
	}
	if instr.Op == BC_BOUNDS_CHECK {
		rt.BoundsCheck(regs[instr.Src1], regs[instr.Src2])
		return true
	}
	if instr.Op == BC_MAKE_SLICE {
		var ms rt.ManagedSlice = rt.MakeManagedSlice(instr.Imm, regs[instr.Src1])
		var msAddr *int = stackPtr(vm, vm.SP)
		vm.SP = vm.SP + 32
		msAddr[0] = bit_cast(int, ms.Data)
		msAddr[1] = ms.Len
		msAddr[2] = bit_cast(int, ms.Refptr)
		msAddr[3] = ms.BackingLen
		regs[instr.Dst] = bit_cast(int, msAddr)
		return true
	}
	return false
}

// execMemoryOp dispatches the per-instruction memory ops:
// BC_STACK_ALLOC, BC_LOAD64, BC_STORE64, BC_LOAD8, BC_STORE8,
// BC_MEMCPY, BC_MEMSET, BC_FIELD_PTR, BC_ELEM_PTR, BC_EXTRACT.
// All non-control-flow: just touch regs and addresses (BC_STACK_ALLOC
// also reads frameBase). Returns true if instr.Op was one of these.
func execMemoryOp(regs *int, frameBase *uint8, instr BCInstr) bool {
	if instr.Op == BC_STACK_ALLOC {
		regs[instr.Dst] = bit_cast(int, frameBase) + instr.Imm
		return true
	}
	if instr.Op == BC_LOAD64 {
		var p *int = bit_cast(*int, regs[instr.Src1])
		regs[instr.Dst] = p[0]
		return true
	}
	if instr.Op == BC_STORE64 {
		var p *int = bit_cast(*int, regs[instr.Src1])
		p[0] = regs[instr.Src2]
		return true
	}
	if instr.Op == BC_LOAD8 {
		var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
		if instr.Imm <= 1 { regs[instr.Dst] = cast(int, p[0]) } else {
			var val int = 0
			for i := instr.Imm - 1; i >= 0; i-- { val = (val << 8) | cast(int, p[i]) }
			regs[instr.Dst] = val
		}
		return true
	}
	if instr.Op == BC_STORE8 {
		var p *uint8 = bit_cast(*uint8, regs[instr.Src1])
		if instr.Imm <= 1 { p[0] = cast(uint8, regs[instr.Src2]) } else {
			var val int = regs[instr.Src2]
			for i := 0; i < instr.Imm; i++ { p[i] = cast(uint8, val & 255); val = val >> 8 }
		}
		return true
	}
	if instr.Op == BC_MEMCPY {
		rt.MemCopy(bit_cast(*uint8, regs[instr.Src1]),
			bit_cast(*uint8, regs[instr.Src2]),
			instr.Imm)
		return true
	}
	if instr.Op == BC_MEMSET {
		rt.MemZero(bit_cast(*uint8, regs[instr.Src1]),
			instr.Imm)
		return true
	}
	if instr.Op == BC_FIELD_PTR {
		regs[instr.Dst] = regs[instr.Src1] + instr.Imm
		return true
	}
	if instr.Op == BC_ELEM_PTR {
		regs[instr.Dst] = regs[instr.Src1] +
			regs[instr.Src2] * instr.Imm
		return true
	}
	if instr.Op == BC_EXTRACT {
		// Imm = byte offset (or word index in legacy mode)
		// Aux = 0: load 1 word at offset
		// Aux = 1: return pointer (offset arithmetic only)
		// Aux = 2: legacy word-indexed load (Imm * 8)
		if instr.Aux == 1 {
			regs[instr.Dst] = regs[instr.Src1] +
				instr.Imm
		} else if instr.Aux == 2 {
			var p *int = bit_cast(*int,
				regs[instr.Src1])
			regs[instr.Dst] = p[instr.Imm]
		} else {
			var p *int = bit_cast(*int,
				regs[instr.Src1] + instr.Imm)
			regs[instr.Dst] = p[0]
		}
		return true
	}
	return false
}
