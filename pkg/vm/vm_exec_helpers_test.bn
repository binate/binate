package "pkg/vm"

import "pkg/builtin/testing"
import "pkg/rt"

// Coverage for vm_exec_helpers.bn: execFunc (the entry point) and
// the non-control-flow opcode helpers execStringOp / execFuncRefOp /
// execNumericCast / execManagedMemoryOp. Numeric-cast has the
// cleanest unit-test surface — the two end-to-end programs below
// exercise BC_FTOSI (and the BC_SITOF round-trip via
// TestVMFloatIntConversion). execFunc itself is exercised by every
// compileAndRun test in vm_test.bn / vm_exec_test.bn; execStringOp
// / execFuncRefOp / the BC_REFINC_INLINE arm of execManagedMemoryOp
// are covered end-to-end via the conformance suite and by
// TestExecRefIncRefDecInline in lower_instr_test.bn.
// `compileAndRun` and `concatStr` helpers live in vm_test.bn.

// Sentinel + probe function for TestRefDecCrossModeDispatch.
// Top-level so bnc emits a real `__handle` and per-function shim
// for the probe — the test reaches them via _func_handle and
// hand-feeds them into refDecCrossModeDispatch.
var refDecCrossModeProbeFlag int = 0

func refDecCrossModeProbe(ptr *uint8) {
	refDecCrossModeProbeFlag = 1
}

// TestRefDecCrossModeDispatch drives the cross-mode arm of
// BC_REFDEC_INLINE_FAST's slow path — refDecCrossModeDispatch in
// vm_exec_helpers.bn — directly, without going through the bytecode
// loop.  Builds a function-value handle for a probe function and
// hands its vtable + data straight to the helper; the probe flips a
// sentinel so we can confirm the shim was actually invoked, then
// rt.Free runs on a fresh rt.Alloc payload so the cleanup half of
// the helper also executes against a valid allocation.
//
// In native (`builder-comp`) the handle's data is NULL — the
// classic cross-mode "compiled-side dtor with no captured ctx"
// shape this arm exists to handle.  In bytecode modes the handle's
// data carries a VMClosureRec, so the helper still dispatches via
// rt._call_shim_scalar(TrampolineScalar, VMClosureRec, ptr, …),
// which runs probe through execFunc.  Either way the sentinel
// flips, and the test pins the integration end-to-end.
func TestRefDecCrossModeDispatch() testing.TestResult {
	refDecCrossModeProbeFlag = 0
	var handle *uint8 = _func_handle(refDecCrossModeProbe)
	if handle == nil {
		return "expected non-nil handle for refDecCrossModeProbe"
	}
	var handlePtr *int = bit_cast(*int, handle)
	var vtableAddr int = handlePtr[0]
	var dataAddr int = handlePtr[1]
	if vtableAddr == 0 {
		return "expected non-zero handle.vtable"
	}
	// Fresh rt.Alloc so the helper's trailing rt.Free has a valid
	// managed allocation to release.  Size doesn't matter — probe
	// ignores the bytes.
	var payload *uint8 = rt.Alloc(8)
	if payload == nil {
		return "rt.Alloc(8) returned nil"
	}
	refDecCrossModeDispatch(vtableAddr, dataAddr, payload)
	if refDecCrossModeProbeFlag != 1 {
		return "probe did not run — cross-mode shim dispatch missed"
	}
	return ""
}

// Parse a float literal and cast to int: 3.75 → 3 (trunc toward zero).
// Exercises execNumericCast's BC_FTOSI arm.
func TestVMFloatLitAndCast() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x float64 = 3.75\n")
	src = concatStr(src, "  return cast(int, x)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 3 { return "expected 3" }
	return ""
}

// Round-trip int → float64 → int. Exercises execNumericCast's
// BC_SITOF (going in) and BC_FTOSI (coming back).
func TestVMFloatIntConversion() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var i int = 7\n")
	src = concatStr(src, "  var f float64 = cast(float64, i)\n")
	src = concatStr(src, "  return cast(int, f)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 7 { return "expected 7" }
	return ""
}

// make_slice goes through BC_MAKE_SLICE → execManagedMemoryOp →
// rt.MakeManagedSlice + push the 4-word header onto vm.SP. The
// returned managed-slice's len field must round-trip back to
// `len(s)`. A regression in execManagedMemoryOp's MAKE_SLICE arm
// (e.g. swapped header words, wrong vm.SP advance) shows up as a
// wrong len here.
func TestVMMakeSliceLen() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var s @[]int = make_slice(int, 5)\n")
	src = concatStr(src, "  return len(s)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 5 { return "expected 5" }
	return ""
}

// box(struct{...}) takes a struct value and returns a managed
// pointer to a freshly-allocated copy. Goes through BC_BOX →
// execManagedMemoryOp → rt.Box. Reading a field through the
// managed pointer auto-derefs and must return the boxed value.
func TestVMBoxRoundTrip() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "type Pt struct { v int }\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var p @Pt = box(Pt{v: 42})\n")
	src = concatStr(src, "  return p.v\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 42 { return "expected 42" }
	return ""
}
