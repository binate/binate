package "pkg/vm"

// Pure register-only bytecode handlers — arithmetic, comparison,
// and unary ops that read/write `regs` but don't touch execLoop's
// control state (pc, funcIdx, f, code, regsOff, frameBase,
// freeOnPop). Hoisted out of vm_exec.bn so the execLoop dispatch
// stays focused on control-flow handlers and the file stays under
// the file-length cap. Memory ops live in execMemoryOp in
// vm_exec_helpers.bn (a separate extraction).
//
// Each helper returns true if the dispatch was handled (caller
// `continue`s) and false otherwise (caller falls through).

// execArithOp handles integer arithmetic (BC_ADD..BC_SHR) and
// float64 arithmetic (BC_FADD..BC_FDIV). All ops read two
// register operands and write one register destination.
func execArithOp(regs *int, instr BCInstr) bool {
	if instr.Op == BC_ADD { regs[instr.Dst] = regs[instr.Src1] + regs[instr.Src2]; return true }
	if instr.Op == BC_SUB { regs[instr.Dst] = regs[instr.Src1] - regs[instr.Src2]; return true }
	if instr.Op == BC_MUL { regs[instr.Dst] = regs[instr.Src1] * regs[instr.Src2]; return true }
	if instr.Op == BC_DIV { regs[instr.Dst] = regs[instr.Src1] / regs[instr.Src2]; return true }
	if instr.Op == BC_REM { regs[instr.Dst] = regs[instr.Src1] % regs[instr.Src2]; return true }
	if instr.Op == BC_AND { regs[instr.Dst] = regs[instr.Src1] & regs[instr.Src2]; return true }
	if instr.Op == BC_OR  { regs[instr.Dst] = regs[instr.Src1] | regs[instr.Src2]; return true }
	if instr.Op == BC_XOR { regs[instr.Dst] = regs[instr.Src1] ^ regs[instr.Src2]; return true }
	if instr.Op == BC_SHL { regs[instr.Dst] = regs[instr.Src1] << regs[instr.Src2]; return true }
	if instr.Op == BC_SHR { regs[instr.Dst] = regs[instr.Src1] >> regs[instr.Src2]; return true }

	// Float64 arithmetic. Operands bit-cast through int registers;
	// arithmetic is always at float64 precision.
	if instr.Op == BC_FADD {
		var a float64 = bit_cast(float64, regs[instr.Src1])
		var b float64 = bit_cast(float64, regs[instr.Src2])
		regs[instr.Dst] = bit_cast(int, a + b)
		return true
	}
	if instr.Op == BC_FSUB {
		var a float64 = bit_cast(float64, regs[instr.Src1])
		var b float64 = bit_cast(float64, regs[instr.Src2])
		regs[instr.Dst] = bit_cast(int, a - b)
		return true
	}
	if instr.Op == BC_FMUL {
		var a float64 = bit_cast(float64, regs[instr.Src1])
		var b float64 = bit_cast(float64, regs[instr.Src2])
		regs[instr.Dst] = bit_cast(int, a * b)
		return true
	}
	if instr.Op == BC_FDIV {
		var a float64 = bit_cast(float64, regs[instr.Src1])
		var b float64 = bit_cast(float64, regs[instr.Src2])
		regs[instr.Dst] = bit_cast(int, a / b)
		return true
	}
	return false
}

// execCmpOp handles integer comparison (BC_EQ..BC_SGE) and
// float64 comparison (BC_FEQ..BC_FGE). Result is 0 or 1 in the
// destination register.
func execCmpOp(regs *int, instr BCInstr) bool {
	if instr.Op == BC_EQ {
		if regs[instr.Src1] == regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	if instr.Op == BC_NE {
		if regs[instr.Src1] != regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	if instr.Op == BC_SLT {
		if regs[instr.Src1] < regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	if instr.Op == BC_SLE {
		if regs[instr.Src1] <= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	if instr.Op == BC_SGT {
		if regs[instr.Src1] > regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	if instr.Op == BC_SGE {
		if regs[instr.Src1] >= regs[instr.Src2] { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}

	// Float64 comparison: ordered predicates — NaN → 0.
	if instr.Op == BC_FEQ {
		var a float64 = bit_cast(float64, regs[instr.Src1])
		var b float64 = bit_cast(float64, regs[instr.Src2])
		if a == b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	if instr.Op == BC_FNE {
		var a float64 = bit_cast(float64, regs[instr.Src1])
		var b float64 = bit_cast(float64, regs[instr.Src2])
		if a != b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	if instr.Op == BC_FLT {
		var a float64 = bit_cast(float64, regs[instr.Src1])
		var b float64 = bit_cast(float64, regs[instr.Src2])
		if a < b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	if instr.Op == BC_FLE {
		var a float64 = bit_cast(float64, regs[instr.Src1])
		var b float64 = bit_cast(float64, regs[instr.Src2])
		if a <= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	if instr.Op == BC_FGT {
		var a float64 = bit_cast(float64, regs[instr.Src1])
		var b float64 = bit_cast(float64, regs[instr.Src2])
		if a > b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	if instr.Op == BC_FGE {
		var a float64 = bit_cast(float64, regs[instr.Src1])
		var b float64 = bit_cast(float64, regs[instr.Src2])
		if a >= b { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	return false
}

// execUnaryOp handles unary arithmetic / logical ops (BC_NEG,
// BC_NOT, BC_BITNOT) and float negation (BC_FNEG).
func execUnaryOp(regs *int, instr BCInstr) bool {
	if instr.Op == BC_NEG {
		regs[instr.Dst] = 0 - regs[instr.Src1]
		return true
	}
	if instr.Op == BC_NOT {
		if regs[instr.Src1] == 0 { regs[instr.Dst] = 1 } else { regs[instr.Dst] = 0 }
		return true
	}
	if instr.Op == BC_BITNOT {
		regs[instr.Dst] = regs[instr.Src1] ^ -1
		return true
	}
	if instr.Op == BC_FNEG {
		var x float64 = bit_cast(float64, regs[instr.Src1])
		regs[instr.Dst] = bit_cast(int, 0.0 - x)
		return true
	}
	return false
}

