package "pkg/vm"

import "pkg/builtin/testing"

// Opcode-focused execLoop tests: arithmetic, comparison, float,
// bitwise, shift, unary, and the LOAD8/STORE8 path via bool.
// Higher-level integration tests (control flow, calls, recursion,
// managed types, slices, arrays) are in vm_test.bn alongside the
// shared `compileAndRun` / `concatStr` helpers.

func TestArithmetic() testing.TestResult {
	var result int = compileAndRun("package \"test\"\nfunc main() int { return 3 + 4 * 5 }\n")
	if result != 23 { return "expected 23" }
	return ""
}

// ============================================================
// Float tests — main returns an int derived from a float so the
// existing compileAndRun infrastructure can check results.
// ============================================================

// Parse a float literal and cast to int: 3.75 → 3 (trunc toward zero).
func TestVMFloatLitAndCast() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x float64 = 3.75\n")
	src = concatStr(src, "  return cast(int, x)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 3 { return "expected 3" }
	return ""
}

// Float addition: 1.5 + 2.25 = 3.75 → cast(int) = 3.
func TestVMFloatAdd() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x float64 = 1.5 + 2.25\n")
	src = concatStr(src, "  return cast(int, x)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 3 { return "expected 3" }
	return ""
}

// Float multiplication: 2.5 * 4.0 = 10.0 → 10.
func TestVMFloatMul() testing.TestResult {
	var src @[]char
