	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 10 { return "expected 10" }
	return ""
}

// Float division: 10.0 / 4.0 = 2.5 → 2.
func TestVMFloatDiv() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x float64 = 10.0 / 4.0\n")
