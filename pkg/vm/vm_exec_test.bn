// Unary negation: -3.5 → cast(int) = -3.
func TestVMFloatNeg() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x float64 = -3.5\n")
	src = concatStr(src, "  return cast(int, x)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != -3 { return "expected -3" }
	return ""
}

// Float comparison produces a bool. Use `if` to branch on it, then
// return a distinguishable int.
func TestVMFloatCmp() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  if 1.5 < 2.5 { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 { return "expected 1" }
	return ""
}

// Float equality round-trip: equal values compare equal.
func TestVMFloatEq() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a float64 = 1.25 + 1.25\n")
	src = concatStr(src, "  if a == 2.5 { return 42 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 42 { return "expected 42" }
	return ""
}

// int → float → int: 5 / 2.0 = 2.5 → 2.
func TestVMFloatIntConversion() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var i int = 5\n")
	src = concatStr(src, "  var f float64 = cast(float64, i)\n")
	src = concatStr(src, "  var g float64 = f / 2.0\n")
	src = concatStr(src, "  return cast(int, g)\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 2 { return "expected 2" }
	return ""
}

func TestBitwiseOps() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a int = 0xFF\n")
	src = concatStr(src, "  var b int = 0x0F\n")
	src = concatStr(src, "  var r int = 0\n")
	src = concatStr(src, "  r = r + (a & b)\n")         // 0x0F = 15
	src = concatStr(src, "  r = r + (a | b) * 100\n")    // 0xFF = 255 * 100
	src = concatStr(src, "  r = r + (a ^ b) * 10000\n")  // 0xF0 = 240 * 10000
	src = concatStr(src, "  return r\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	// 15 + 25500 + 2400000 = 2425515
	if result != 2425515 { return "expected 2425515" }
	return ""
}

func TestShiftOps() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x int = 1\n")
	src = concatStr(src, "  var left int = x << 8\n")   // 256
	src = concatStr(src, "  var right int = left >> 4\n") // 16
	src = concatStr(src, "  return left + right\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 272 { return "expected 272" }
	return ""
}

func TestUnaryOps() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x int = 5\n")
	src = concatStr(src, "  var neg int = -x\n")
	src = concatStr(src, "  var t bool = true\n")
	src = concatStr(src, "  if !t { return 0 }\n")
	src = concatStr(src, "  return neg + 10\n") // -5 + 10 = 5
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 5 { return "expected 5" }
	return ""
}

func TestComparisons() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func check(a int, b int) int {\n")
	src = concatStr(src, "  var r int = 0\n")
	src = concatStr(src, "  if a == b { r = r + 1 }\n")
	src = concatStr(src, "  if a != b { r = r + 10 }\n")
	src = concatStr(src, "  if a < b { r = r + 100 }\n")
	src = concatStr(src, "  if a <= b { r = r + 1000 }\n")
	src = concatStr(src, "  if a > b { r = r + 10000 }\n")
	src = concatStr(src, "  if a >= b { r = r + 100000 }\n")
	src = concatStr(src, "  return r\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  return check(3, 5) + check(5, 5) * 1000000\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	// check(3,5): != + < + <= = 10+100+1000 = 1110
	// check(5,5): == + <= + >= = 1+1000+100000 = 101001
	// 1110 + 101001*1000000 = 1110 + 101001000000
	if result != 101001001110 { return "expected 101001001110" }
	return ""
}

func TestModAndDiv() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  return 17 / 5 * 100 + 17 % 5\n") // 3*100 + 2 = 302
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 302 { return "expected 302" }
	return ""
}

func TestBoolVar() testing.TestResult {
	// Tests LOAD8/STORE8 (bool is 1-byte)
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var a bool = true\n")
	src = concatStr(src, "  var b bool = false\n")
	src = concatStr(src, "  if a && !b { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 { return "expected 1" }
	return ""
}
