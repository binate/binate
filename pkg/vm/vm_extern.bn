package "pkg/vm"

import "pkg/bootstrap"
import "pkg/rt"

// vmRefDec decrements refcount and calls dtor via VM if it hits 0.
// dtorIdx is a 1-based VM function index (from BC_FUNC_ADDR).
func vmRefDec(vm @VM, ptr *uint8, dtorIdx int) {
	if ptr == nil { return }
	var h *int = bit_cast(*int, bit_cast(int, ptr) - 16)
	h[0] = h[0] - 1
	if h[0] == 0 {
		// Call destructor through VM
		var funcIdx int = dtorIdx - 1 // convert to 0-based
		var args @[]int = make_slice(int, 1)
		args[0] = bit_cast(int, ptr)
		execFunc(vm, funcIdx, args)
		// Free the allocation
		rt.Free(ptr)
	}
}

// execExtern dispatches calls to compiled extern functions
// (pkg/rt, pkg/bootstrap, C externs).
func execExtern(vm @VM, name *[]const char, args @[]int,
	instr BCInstr) int {
	// pkg/rt functions
	if streq(name, "bn_rt__Alloc") ||
		streq(name, "rt.Alloc") {
		return bit_cast(int, rt.Alloc(args[0]))
	}
	if streq(name, "bn_rt__Free") ||
		streq(name, "rt.Free") {
		rt.Free(bit_cast(*uint8, args[0]))
		return 0
	}
	if streq(name, "bn_rt__RefInc") ||
		streq(name, "rt.RefInc") {
		rt.RefInc(bit_cast(*uint8, args[0]))
		return 0
	}
	if streq(name, "bn_rt__RefDec") ||
		streq(name, "rt.RefDec") {
		rt.RefDec(bit_cast(*uint8, args[0]),
			bit_cast(*uint8, args[1]))
		return 0
	}
	if streq(name, "bn_rt__Refcount") ||
		streq(name, "rt.Refcount") {
		return rt.Refcount(bit_cast(*uint8, args[0]))
	}
	if streq(name, "bn_rt__BoundsCheck") ||
		streq(name, "rt.BoundsCheck") {
		rt.BoundsCheck(args[0], args[1])
		return 0
	}
	if streq(name, "bn_rt__Box") ||
		streq(name, "rt.Box") {
		return bit_cast(int,
			rt.Box(bit_cast(*uint8, args[0]), args[1]))
	}
	if streq(name, "bn_rt__MakeManagedSlice") ||
		streq(name, "rt.MakeManagedSlice") {
		var ms rt.ManagedSlice = rt.MakeManagedSlice(
			args[0], args[1])
		var msAddr *uint8 = bit_cast(*uint8,
			bit_cast(int, vm.Stack) + vm.SP)
		vm.SP = vm.SP + 32
		var dst *int = bit_cast(*int, msAddr)
		dst[0] = bit_cast(int, ms.Data)
		dst[1] = ms.Len
		dst[2] = bit_cast(int, ms.Refptr)
		dst[3] = ms.BackingLen
		return bit_cast(int, msAddr)
	}
	// pkg/rt raw-memory wrappers (preferred) and the legacy c_*
	// names (for compiled bytecode that hasn't migrated yet).
	// All arms route through the public wrappers so this dispatch
	// doesn't depend on rt.c_* visibility.
	if streq(name, "bn_rt__Malloc") ||
		streq(name, "rt.Malloc") ||
		streq(name, "c_malloc") ||
		streq(name, "bn_rt__c_malloc") ||
		streq(name, "rt.c_malloc") {
		return bit_cast(int, rt.Malloc(args[0]))
	}
	if streq(name, "bn_rt__Calloc") ||
		streq(name, "rt.Calloc") ||
		streq(name, "c_calloc") ||
		streq(name, "bn_rt__c_calloc") ||
		streq(name, "rt.c_calloc") {
		return bit_cast(int,
			rt.Calloc(args[0], args[1]))
	}
	if streq(name, "bn_rt__CFree") ||
		streq(name, "rt.CFree") ||
		streq(name, "c_free") ||
		streq(name, "bn_rt__c_free") ||
		streq(name, "rt.c_free") {
		rt.CFree(bit_cast(*uint8, args[0]))
		return 0
	}
	if streq(name, "bn_rt__Memset") ||
		streq(name, "rt.Memset") ||
		streq(name, "c_memset") ||
		streq(name, "bn_rt__c_memset") ||
		streq(name, "rt.c_memset") {
		rt.Memset(bit_cast(*uint8, args[0]),
			args[1], args[2])
		return 0
	}
	if streq(name, "bn_rt__Memcpy") ||
		streq(name, "rt.Memcpy") ||
		streq(name, "c_memcpy") ||
		streq(name, "bn_rt__c_memcpy") ||
		streq(name, "rt.c_memcpy") {
		rt.Memcpy(bit_cast(*uint8, args[0]),
			bit_cast(*uint8, args[1]), args[2])
		return 0
	}
	if streq(name, "c_exit") ||
		streq(name, "bn_rt__c_exit") ||
		streq(name, "rt.c_exit") {
		rt.Exit(args[0])
		return 0
	}
	if streq(name, "bn_rt__BoundsFail") ||
		streq(name, "rt.BoundsFail") ||
		streq(name, "c_bounds_fail") ||
		streq(name, "bn_rt__c_bounds_fail") ||
		streq(name, "rt.c_bounds_fail") {
		rt.BoundsFail(args[0], args[1])
		return 0
	}
	if streq(name, "bn_rt__CallDtor") ||
		streq(name, "rt.CallDtor") ||
		streq(name, "c_call_dtor") ||
		streq(name, "bn_rt__c_call_dtor") ||
		streq(name, "rt.c_call_dtor") {
		var funcIdx int = args[0] - 1
		if funcIdx >= 0 {
			var dtorArgs @[]int = make_slice(int, 1)
			dtorArgs[0] = args[1]
			execFunc(vm, funcIdx, dtorArgs)
		}
		return 0
	}
	// pkg/bootstrap functions
	if streq(name, "bn_bootstrap__Open") ||
		streq(name, "bootstrap.Open") {
		// args[0] = ptr to *[]const char on VM stack (layout-
		// compatible with BnSlice), args[1] = flags
		var path *(*[]const char) = bit_cast(*(*[]const char), args[0])
		return bootstrap.Open(*path, args[1])
	}
	if streq(name, "bn_bootstrap__Close") ||
		streq(name, "bootstrap.Close") {
		bootstrap.Close(args[0])
		return 0
	}
	if streq(name, "bn_bootstrap__Read") ||
		streq(name, "bootstrap.Read") {
		var b *(*[]uint8) = bit_cast(*(*[]uint8), args[1])
		return bootstrap.Read(args[0], *b)
	}
	if streq(name, "bn_bootstrap__Write") ||
		streq(name, "bootstrap.Write") {
		var b *(*[]uint8) = bit_cast(*(*[]uint8), args[1])
		return bootstrap.Write(args[0], *b)
	}
	if streq(name, "bn_bootstrap__Exit") ||
		streq(name, "bootstrap.Exit") {
		bootstrap.Exit(args[0])
		return 0
	}
	// bootstrap.Itoa and bootstrap.Concat are now pure-Binate
	// (defined in pkg/bootstrap/bootstrap.bn). VM dispatches them
	// through the normal BC_CALL path; no execExtern arms needed.
	if streq(name, "bn_bootstrap__Stat") ||
		streq(name, "bootstrap.Stat") {
		var path *(*[]const char) = bit_cast(*(*[]const char), args[0])
		return bootstrap.Stat(*path)
	}
	if streq(name, "bn_bootstrap__Args") ||
		streq(name, "bootstrap.Args") {
		var result @[]@[]char = bootstrap.Args()
		// Pre-RefInc so result's scope-cleanup dtor (which RefDecs
		// the outer backing AND each inner @[]char's backing) leaves
		// every allocation alive for the VM caller.
		var outerHdr *int = bit_cast(*int, &result)
		rt.RefInc(bit_cast(*uint8, outerHdr[2]))  // outer backing
		// Walk the inline-element array to RefInc each inner backing.
		// Each @[]char header is 4 words (32 bytes); refptr is word 2.
		var n int = len(result)
		var dataPtr *int = bit_cast(*int, outerHdr[0])
		for i := 0; i < n; i++ {
			rt.RefInc(bit_cast(*uint8, dataPtr[i * 4 + 2]))
		}
		var addr int = pushManagedSlice(vm,
			bit_cast(*uint8, &result))
		return addr
	}
	if streq(name, "bn_bootstrap__ReadDir") ||
		streq(name, "bootstrap.ReadDir") {
		// args[0] = *[]const char (path)
		var path *(*[]const char) = bit_cast(*(*[]const char), args[0])
		var result @[]@[]char = bootstrap.ReadDir(*path)
		// Pre-RefInc so result's scope-cleanup dtor (which RefDecs
		// the outer backing AND each inner @[]char's backing) leaves
		// every allocation alive for the VM caller. Same pattern as
		// bootstrap.Args above.
		var outerHdr *int = bit_cast(*int, &result)
		rt.RefInc(bit_cast(*uint8, outerHdr[2]))  // outer backing
		var n int = len(result)
		var dataPtr *int = bit_cast(*int, outerHdr[0])
		for i := 0; i < n; i++ {
			rt.RefInc(bit_cast(*uint8, dataPtr[i * 4 + 2]))
		}
		var addr int = pushManagedSlice(vm,
			bit_cast(*uint8, &result))
		return addr
	}
	if streq(name, "bn_bootstrap__Exec") ||
		streq(name, "bootstrap.Exec") {
		// args[0] = *[]const char (program), args[1] = *[]@[]char (argv)
		var prog *(*[]const char) = bit_cast(*(*[]const char), args[0])
		var argv *(*[]@[]char) = bit_cast(*(*[]@[]char), args[1])
		return bootstrap.Exec(*prog, *argv)
	}
	print("vm: extern not found: ")
	println(name)
	rt.Exit(1)
	return 0
}

