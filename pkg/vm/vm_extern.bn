package "pkg/vm"

import "pkg/rt"

// dispatchExternBinding routes a registered extern call through the
// compiled-side function value's vtable.call (the per-function shim),
// packing args into the always-shim convention's fixed 7-int register
// bank.  Mirrors dispatchCompiledFuncValue (vm_exec_helpers.bn).
//
// Branches on b.ResultSize:
//   - ≤ 8: scalar dispatch via rt._call_shim_scalar.  Result returns
//     in X0; caller writes to instr.Dst.
//   - > 8: aggregate dispatch via rt._call_shim_aggregate.  Allocates
//     a retbuf of ResultSize bytes on vm.Stack, passes its address as
//     the shim's first argument, returns the retbuf address (the
//     bytecode caller's aggregate-return convention).
//
// Works in both native and bytecode dispatch contexts: when run
// natively, the rt._call_shim_* helpers lower to direct LLVM
// indirect calls to the shim; when run as bytecode (a nested-VM
// scenario where pkg/vm itself runs as bytecode in an outer VM),
// the bytecode emits BC_CALL_INDIRECT, which the outer native
// execLoop's BC_CALL_INDIRECT handler dispatches via
// dispatchNativeIndirect's Imm==8 / Imm==9 arms.
func dispatchExternBinding(vm @VM, b ExternBinding, args @[]int) int {
	if b.VtableAddr == 0 {
		println("vm: registered extern has nil vtable")
		rt.Exit(1)
	}
	var vtable *int = bit_cast(*int, b.VtableAddr)
	var callPtr int = vtable[1]
	if callPtr == 0 {
		println("vm: registered extern has nil vtable.call")
		rt.Exit(1)
	}
	var fnPtr *uint8 = bit_cast(*uint8, callPtr)
	var dataPtr *uint8 = bit_cast(*uint8, b.DataAddr)
	var nArgs int = len(args)
	var a0 int = 0
	var a1 int = 0
	var a2 int = 0
	var a3 int = 0
	var a4 int = 0
	var a5 int = 0
	var a6 int = 0
	if nArgs > 0 { a0 = args[0] }
	if nArgs > 1 { a1 = args[1] }
	if nArgs > 2 { a2 = args[2] }
	if nArgs > 3 { a3 = args[3] }
	if nArgs > 4 { a4 = args[4] }
	if nArgs > 5 { a5 = args[5] }
	if nArgs > 6 { a6 = args[6] }
	if b.ResultSize > 8 {
		// Aggregate path: allocate retbuf on vm.Stack, call shim,
		// return retbuf address.  Bytecode caller's aggregate-
		// return convention reads the multi-word value from there.
		var retbuf *uint8 = bit_cast(*uint8,
			bit_cast(int, vm.Stack) + vm.SP)
		vm.SP = vm.SP + b.ResultSize
		rt._call_shim_aggregate(fnPtr, retbuf, dataPtr,
			a0, a1, a2, a3, a4, a5, a6)
		return bit_cast(int, retbuf)
	}
	return rt._call_shim_scalar(fnPtr, dataPtr,
		a0, a1, a2, a3, a4, a5, a6)
}

// execExtern dispatches an extern call by looking the name up in
// the executing VM's Externs registry (populated at VM-init time
// via RegisterExtern, typically through RegisterStandardExterns +
// cmd/bni's registerPureCExterns).  On hit, routes through
// dispatchExternBinding (which calls the per-function shim via
// rt._call_shim_*); on miss, aborts with a diagnostic.
func execExtern(vm @VM, name *[]const char, args @[]int,
	instr BCInstr) int {
	var bindIdx int = vm.LookupExtern(name)
	if bindIdx >= 0 {
		return dispatchExternBinding(vm, vm.Externs[bindIdx], args)
	}
	print("vm: extern not found: ")
	println(name)
	rt.Exit(1)
	return 0
}
