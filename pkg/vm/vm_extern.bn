package "pkg/vm"

import "pkg/bootstrap"
import "pkg/libc"
import "pkg/rt"

// dispatchExternBinding routes a registered extern call through the
// compiled-side function value's vtable.call (the per-function shim),
// packing args into the always-shim convention's fixed 7-int register
// bank.  Mirrors dispatchCompiledFuncValue (vm_exec_helpers.bn) — same
// rt._call_shim_scalar path; the only difference is args come from
// the VM's argv int[] rather than regs[Src2 + i].
//
// Works in both native and bytecode dispatch contexts: when run
// natively, rt._call_shim_scalar lowers to a direct LLVM indirect
// call to the shim; when run as bytecode (a nested-VM scenario where
// pkg/vm itself runs as bytecode in an outer VM), the bytecode
// rt._call_shim_scalar emits BC_CALL_INDIRECT against the shim
// address, which the outer native execLoop's BC_CALL_INDIRECT handler
// dispatches via dispatchNativeIndirect's Imm==8 arm.
func dispatchExternBinding(b ExternBinding, args @[]int) int {
	if b.VtableAddr == 0 {
		println("vm: registered extern has nil vtable")
		rt.Exit(1)
	}
	var vtable *int = bit_cast(*int, b.VtableAddr)
	var callPtr int = vtable[1]
	if callPtr == 0 {
		println("vm: registered extern has nil vtable.call")
		rt.Exit(1)
	}
	var fnPtr *uint8 = bit_cast(*uint8, callPtr)
	var dataPtr *uint8 = bit_cast(*uint8, b.DataAddr)
	var nArgs int = len(args)
	var a0 int = 0
	var a1 int = 0
	var a2 int = 0
	var a3 int = 0
	var a4 int = 0
	var a5 int = 0
	var a6 int = 0
	if nArgs > 0 { a0 = args[0] }
	if nArgs > 1 { a1 = args[1] }
	if nArgs > 2 { a2 = args[2] }
	if nArgs > 3 { a3 = args[3] }
	if nArgs > 4 { a4 = args[4] }
	if nArgs > 5 { a5 = args[5] }
	if nArgs > 6 { a6 = args[6] }
	return rt._call_shim_scalar(fnPtr, dataPtr,
		a0, a1, a2, a3, a4, a5, a6)
}

// execExtern dispatches calls to compiled extern functions
// (pkg/rt, pkg/bootstrap, C externs).
//
// First consults the vm.Externs registry (populated via
// RegisterExtern at VM-init time, typically through
// RegisterStandardExterns).  Hits dispatch through the always-shim
// convention via rt._call_shim_scalar — the same path
// dispatchCompiledFuncValue uses for bytecode→compiled function-value
// calls.  The legacy hand-coded arms below remain for residual cases
// the registry can't yet handle:
//   - rt.MakeManagedSlice — multi-word (32-byte) aggregate return
//     pushed onto vm.Stack.  Needs an aggregate-shim shape.
//   - bootstrap.Open / Read / Write / Stat / Exec — slice/multi-word
//     args (the scalar-shim's int-args shape can't unpack them).
//   - bootstrap.Args / ReadDir — multi-word return + RefInc surgery.
//   - pkg/libc.* and bootstrap.Close / Exit — pure C externs (no
//     `.bn` body).  BC_FUNC_VALUE on these fails LookupFunc, so the
//     RegisterExtern call site can't construct a function value
//     when running as bytecode (only natively).  Migrating these
//     needs either a BC_FUNC_VALUE fallback to LookupExtern or a
//     parallel "register-by-shim-addr" API.
func execExtern(vm @VM, name *[]const char, args @[]int,
	instr BCInstr) int {
	var bindIdx int = LookupExtern(vm, name)
	if bindIdx >= 0 {
		return dispatchExternBinding(vm.Externs[bindIdx], args)
	}
	// pkg/libc — pure C externs reached when pkg/rt's bytecode
	// runs in the VM and emits BC_CALL_EXTERN against libc.*.
	if streq(name, "libc.Malloc") {
		return bit_cast(int, libc.Malloc(args[0]))
	}
	if streq(name, "libc.Calloc") {
		return bit_cast(int, libc.Calloc(args[0], args[1]))
	}
	if streq(name, "libc.Free") {
		libc.Free(bit_cast(*uint8, args[0]))
		return 0
	}
	if streq(name, "libc.Memset") {
		libc.Memset(bit_cast(*uint8, args[0]),
			args[1], args[2])
		return 0
	}
	if streq(name, "libc.Memcpy") {
		libc.Memcpy(bit_cast(*uint8, args[0]),
			bit_cast(*const uint8, args[1]), args[2])
		return 0
	}
	if streq(name, "libc.Exit") {
		libc.Exit(args[0])
		return 0
	}
	if streq(name, "bootstrap.Close") {
		return bootstrap.Close(args[0])
	}
	if streq(name, "bootstrap.Exit") {
		bootstrap.Exit(args[0])
		return 0
	}
	if streq(name, "rt.MakeManagedSlice") {
		var ms rt.ManagedSlice = rt.MakeManagedSlice(
			args[0], args[1])
		var msAddr *uint8 = bit_cast(*uint8,
			bit_cast(int, vm.Stack) + vm.SP)
		vm.SP = vm.SP + 32
		var dst *int = bit_cast(*int, msAddr)
		dst[0] = bit_cast(int, ms.Data)
		dst[1] = ms.Len
		dst[2] = bit_cast(int, ms.Refptr)
		dst[3] = ms.BackingLen
		return bit_cast(int, msAddr)
	}
	if streq(name, "bootstrap.Open") {
		// args[0] = ptr to *[]const char on VM stack (layout-
		// compatible with BnSlice), args[1] = flags
		var path *(*[]const char) = bit_cast(*(*[]const char), args[0])
		return bootstrap.Open(*path, args[1])
	}
	if streq(name, "bootstrap.Read") {
		var b *(*[]uint8) = bit_cast(*(*[]uint8), args[1])
		return bootstrap.Read(args[0], *b)
	}
	if streq(name, "bootstrap.Write") {
		var b *(*[]uint8) = bit_cast(*(*[]uint8), args[1])
		return bootstrap.Write(args[0], *b)
	}
	if streq(name, "bootstrap.Stat") {
		var path *(*[]const char) = bit_cast(*(*[]const char), args[0])
		return bootstrap.Stat(*path)
	}
	if streq(name, "bootstrap.Args") {
		var result @[]@[]char = bootstrap.Args()
		// Pre-RefInc so result's scope-cleanup dtor (which RefDecs
		// the outer backing AND each inner @[]char's backing) leaves
		// every allocation alive for the VM caller.
		var outerHdr *int = bit_cast(*int, &result)
		rt.RefInc(bit_cast(*uint8, outerHdr[2]))  // outer backing
		// Walk the inline-element array to RefInc each inner backing.
		// Each @[]char header is 4 words (32 bytes); refptr is word 2.
		var n int = len(result)
		var dataPtr *int = bit_cast(*int, outerHdr[0])
		for i := 0; i < n; i++ {
			rt.RefInc(bit_cast(*uint8, dataPtr[i * 4 + 2]))
		}
		var addr int = pushManagedSlice(vm,
			bit_cast(*uint8, &result))
		return addr
	}
	if streq(name, "bootstrap.ReadDir") {
		var path *(*[]const char) = bit_cast(*(*[]const char), args[0])
		var result @[]@[]char = bootstrap.ReadDir(*path)
		// Pre-RefInc — same pattern as bootstrap.Args above.
		var outerHdr *int = bit_cast(*int, &result)
		rt.RefInc(bit_cast(*uint8, outerHdr[2]))  // outer backing
		var n int = len(result)
		var dataPtr *int = bit_cast(*int, outerHdr[0])
		for i := 0; i < n; i++ {
			rt.RefInc(bit_cast(*uint8, dataPtr[i * 4 + 2]))
		}
		var addr int = pushManagedSlice(vm,
			bit_cast(*uint8, &result))
		return addr
	}
	if streq(name, "bootstrap.Exec") {
		var prog *(*[]const char) = bit_cast(*(*[]const char), args[0])
		var argv *(*[]@[]char) = bit_cast(*(*[]@[]char), args[1])
		return bootstrap.Exec(*prog, *argv)
	}
	print("vm: extern not found: ")
	println(name)
	rt.Exit(1)
	return 0
}
