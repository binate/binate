package "pkg/vm"

import "pkg/ir"
import "pkg/ast"
import "pkg/parser"
import "pkg/types"
import "pkg/buf"
import "pkg/builtin/testing"

func toBytes(s []char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

func compileAndRun(src []char) int {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = parser.ParseFile(p)

	var c @types.Checker = types.NewChecker()
	types.Check(c, file)

	var m @ir.Module = ir.GenModule(file)

	var vm @VM = NewVM(1024 * 1024)
	LowerModule(vm, m)

	var idx int = LookupFunc(vm, "main")
	if idx < 0 { return -1 }
	var noArgs @[]int
	return execFunc(vm, idx, noArgs)
}

func TestSimpleReturn() testing.TestResult {
	var result int = compileAndRun("package \"test\"\nfunc main() int { return 42 }\n")
	if result != 42 { return "expected 42" }
	return ""
}

func TestArithmetic() testing.TestResult {
	var result int = compileAndRun("package \"test\"\nfunc main() int { return 3 + 4 * 5 }\n")
	if result != 23 { return "expected 23" }
	return ""
}

func TestVariable() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x int = 10\n")
	src = concatStr(src, "  var y int = 20\n")
	src = concatStr(src, "  return x + y\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 30 { return "expected 30" }
	return ""
}

func TestIfElse() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x int = 5\n")
	src = concatStr(src, "  if x > 3 { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 { return "expected 1" }
	return ""
}

func TestForLoop() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var sum int = 0\n")
	src = concatStr(src, "  for i := 0; i < 10; i++ {\n")
	src = concatStr(src, "    sum = sum + i\n")
	src = concatStr(src, "  }\n")
	src = concatStr(src, "  return sum\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 45 { return "expected 45" }
	return ""
}

func TestFuncCall() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func add(a int, b int) int { return a + b }\n")
	src = concatStr(src, "func main() int { return add(10, 32) }\n")
	var result int = compileAndRun(src)
	if result != 42 { return "expected 42" }
	return ""
}

func TestNestedCalls() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func double(x int) int { return x * 2 }\n")
	src = concatStr(src, "func triple(x int) int { return x * 3 }\n")
	src = concatStr(src, "func main() int { return double(triple(7)) }\n")
	var result int = compileAndRun(src)
	if result != 42 { return "expected 42" }
	return ""
}

func TestBooleans() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var t bool = true\n")
	src = concatStr(src, "  var f bool = false\n")
	src = concatStr(src, "  if t { return 1 }\n")
	src = concatStr(src, "  return 0\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 1 { return "expected 1" }
	return ""
}

func TestEarlyReturn() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func abs(x int) int {\n")
	src = concatStr(src, "  if x < 0 { return 0 - x }\n")
	src = concatStr(src, "  return x\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int { return abs(-5) + abs(3) }\n")
	var result int = compileAndRun(src)
	if result != 8 { return "expected 8" }
	return ""
}

func TestRecursion() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func fib(n int) int {\n")
	src = concatStr(src, "  if n <= 1 { return n }\n")
	src = concatStr(src, "  return fib(n-1) + fib(n-2)\n")
	src = concatStr(src, "}\n")
	src = concatStr(src, "func main() int { return fib(10) }\n")
	var result int = compileAndRun(src)
	if result != 55 { return "expected 55" }
	return ""
}

// TestGlobalVar — TODO: requires global variable support in VM
// func TestGlobalVar() testing.TestResult { ... }

func TestManagedPtr() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "type Point struct { X int; Y int }\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var p @Point = make(Point)\n")
	src = concatStr(src, "  p.X = 10\n")
	src = concatStr(src, "  p.Y = 20\n")
	src = concatStr(src, "  return p.X + p.Y\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 30 { return "expected 30" }
	return ""
}

func concatStr(a @[]char, b []char) @[]char {
	var cb buf.CharBuf = buf.New()
	if len(a) > 0 { cb = buf.WriteStr(cb, a) }
	cb = buf.WriteStr(cb, b)
	return buf.Bytes(cb)
}
