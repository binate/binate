package "pkg/vm"

import "pkg/ir"
import "pkg/ast"
import "pkg/parser"
import "pkg/types"
import "pkg/buf"
import "pkg/builtin/testing"

func toBytes(s []char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

func compileAndRun(src []char) int {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = parser.ParseFile(p)

	var c @types.Checker = types.NewChecker()
	types.Check(c, file)

	var m @ir.Module = ir.GenModule(file)

	var vm @VM = NewVM(1024 * 1024)
	LowerModule(vm, m)

	var idx int = LookupFunc(vm, "main")
	if idx < 0 { return -1 }
	var noArgs @[]int
	return execFunc(vm, idx, noArgs)
}

func TestSimpleReturn() testing.TestResult {
	var result int = compileAndRun("package \"test\"\nfunc main() int { return 42 }\n")
	if result != 42 { return "expected 42" }
	return ""
}

func TestArithmetic() testing.TestResult {
	var result int = compileAndRun("package \"test\"\nfunc main() int { return 3 + 4 * 5 }\n")
	if result != 23 { return "expected 23" }
	return ""
}

func TestVariable() testing.TestResult {
	var src @[]char
	src = concatStr(src, "package \"test\"\n")
	src = concatStr(src, "func main() int {\n")
	src = concatStr(src, "  var x int = 10\n")
	src = concatStr(src, "  var y int = 20\n")
	src = concatStr(src, "  return x + y\n")
	src = concatStr(src, "}\n")
	var result int = compileAndRun(src)
	if result != 30 { return "expected 30" }
	return ""
}

