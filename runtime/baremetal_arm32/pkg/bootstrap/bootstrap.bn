package "pkg/bootstrap"

import "pkg/semihost"

// Bare-metal ARM32 implementation of `pkg/bootstrap`.  Selected
// when bnc is invoked with `--target arm32-baremetal` plus
// `--impl-path runtime/baremetal_arm32` (the v1 path-mechanism
// override — see plan-arm32-bare-metal.md).
//
// Format helpers (formatInt, formatInt64, formatBool, formatFloat,
// Itoa, Concat) are duplicated verbatim from the libc-host
// implementation — they're pure Binate, target-agnostic.  TODO:
// extract these into a separate package (pkg/format?) so both
// targets share rather than duplicate.
//
// I/O surface (Open / Read / Write / Close / Stat / ReadDir / Exit
// / Args / Exec): the libc-host build resolves these to
// binate_runtime.c's `bn_bootstrap__*` symbols at link time; on
// bare-metal there's no host OS, so we provide Binate stubs
// instead.  Current stubs are placeholders — Write pretends
// success, Exit infinite-loops.  Subsequent v1 chunks will swap in
// real semihosting calls (SVC #0xab + SYS_WRITE0 / SYS_EXIT_EXTENDED)
// once the crt0 / linker-script wiring lands.

// formatInt writes the decimal representation of v into buf and
// returns the number of bytes written. Caller MUST pass a buffer
// of at least 20 bytes — this function does not bounds-check.
// (int64 max is 19 digits + sign sign.)
//
// Used by the print/println builtin's IR-gen lowering: it allocs a
// stack [20]uint8, calls formatInt, then writes the resulting
// prefix via bootstrap.Write.
func formatInt(v int, buf *[]uint8) int {
	if v == 0 {
		buf[0] = cast(uint8, '0')
		return 1
	}
	var negative bool = false
	if v < 0 {
		negative = true
		v = 0 - v
	}
	// Reverse-write digits into a temp.
	var digits [20]uint8
	var count int = 0
	for v > 0 {
		digits[count] = cast(uint8, v % 10 + cast(int, '0'))
		v = v / 10
		count = count + 1
	}
	var pos int = 0
	if negative {
		buf[pos] = cast(uint8, '-')
		pos = pos + 1
	}
	for i := count - 1; i >= 0; i-- {
		buf[pos] = digits[i]
		pos = pos + 1
	}
	return pos
}

// formatInt64 is the int64 counterpart of formatInt, needed by
// formatFloat on 32-bit targets where IEEE-754 mantissas exceed
// the host `int` width.  Identical logic, parameter widened to
// int64.
func formatInt64(v int64, buf *[]uint8) int {
	if v == 0 {
		buf[0] = cast(uint8, '0')
		return 1
	}
	var negative bool = false
	if v < 0 {
		negative = true
		v = 0 - v
	}
	var digits [20]uint8
	var count int = 0
	for v > 0 {
		digits[count] = cast(uint8, cast(int, v % 10) + cast(int, '0'))
		v = v / 10
		count = count + 1
	}
	var pos int = 0
	if negative {
		buf[pos] = cast(uint8, '-')
		pos = pos + 1
	}
	for i := count - 1; i >= 0; i-- {
		buf[pos] = digits[i]
		pos = pos + 1
	}
	return pos
}

// formatBool writes "true" or "false" into buf and returns the
// number of bytes written. Caller MUST pass a buffer of at least
// 5 bytes — this function does not bounds-check.
func formatBool(v bool, buf *[]uint8) int {
	if v {
		buf[0] = cast(uint8, 't')
		buf[1] = cast(uint8, 'r')
		buf[2] = cast(uint8, 'u')
		buf[3] = cast(uint8, 'e')
		return 4
	}
	buf[0] = cast(uint8, 'f')
	buf[1] = cast(uint8, 'a')
	buf[2] = cast(uint8, 'l')
	buf[3] = cast(uint8, 's')
	buf[4] = cast(uint8, 'e')
	return 5
}

// formatFloat writes a human-readable representation of v into buf
// and returns the number of bytes written. Caller MUST pass a
// buffer of at least 32 bytes — this function does not
// bounds-check.
//
// Bootstrap-grade: not %g-compatible. See bni for the full spec.
// Strategy: fixed-point "integer.6digits" for normal-magnitude
// values; exact mantissa*2^exponent fallback for very large
// (|v| ≥ 2^53) or very small (0 < |v| < ~1e-6, biased exp < 1003)
// values where fixed-point would lose information.
func formatFloat(v float64, buf *[]uint8) int {
	// IEEE-754 double has a 64-bit layout (1 sign + 11 exp + 52 mant)
	// that doesn't fit in a 32-bit Binate `int` under arm32-linux —
	// use int64 explicitly for the bit-level reasoning.  The mantissa
	// value (up to 2^53 - 1) is also too wide for int32.
	var bits int64 = bit_cast(int64, v)
	var sign int64 = (bits >> 63) & 1
	var exp int64 = (bits >> 52) & 2047                   // 0x7FF
	var mant int64 = bits & 4503599627370495              // 0xFFFFFFFFFFFFF (52 bits)

	// NaN: exp == 0x7FF, mant != 0
	if exp == 2047 && mant != 0 {
		buf[0] = cast(uint8, 'N')
		buf[1] = cast(uint8, 'a')
		buf[2] = cast(uint8, 'N')
		return 3
	}
	// ±Inf: exp == 0x7FF, mant == 0
	if exp == 2047 {
		var pos int = 0
		if sign != 0 {
			buf[pos] = cast(uint8, '-')
		} else {
			buf[pos] = cast(uint8, '+')
		}
		pos = pos + 1
		buf[pos] = cast(uint8, 'I')
		buf[pos + 1] = cast(uint8, 'n')
		buf[pos + 2] = cast(uint8, 'f')
		return pos + 3
	}
	// ±0: exp == 0 and mant == 0
	if exp == 0 && mant == 0 {
		buf[0] = cast(uint8, '0')
		buf[1] = cast(uint8, '.')
		buf[2] = cast(uint8, '0')
		buf[3] = cast(uint8, '0')
		buf[4] = cast(uint8, '0')
		buf[5] = cast(uint8, '0')
		buf[6] = cast(uint8, '0')
		buf[7] = cast(uint8, '0')
		return 8
	}

	// Decide: fixed-point or mantissa*2^exponent fallback?
	// |v| ≥ 2^53 → no longer representable as exact int (biased exp ≥ 1076).
	// 0 < |v| < ~1e-6 (biased exp < 1003) → would print as "0.000000".
	// Denormals (exp == 0) are well below 1e-6, so always fallback.
	var useMantExp bool = false
	if exp >= 1076 { useMantExp = true }
	if exp < 1003 { useMantExp = true }

	if useMantExp {
		// Build the exact (mantissa, exponent) representation.
		// Normal: mantissa = (1 << 52) | mant, exponent = exp - 1023 - 52
		// Denormal (exp == 0): mantissa = mant, exponent = -1074
		// mantissa is 53 bits wide so must stay int64; exponent fits
		// int but the arithmetic is on int64 here for uniformity.
		var mantissa int64
		var exponent int64
		if exp == 0 {
			mantissa = mant
			exponent = -1074
		} else {
			mantissa = (1 << 52) | mant
			exponent = exp - 1075
		}
		var pos int = 0
		if sign != 0 {
			buf[pos] = cast(uint8, '-')
			pos = pos + 1
		}
		pos = pos + formatInt64(mantissa, buf[pos:])
		buf[pos] = cast(uint8, '*')
		pos = pos + 1
		buf[pos] = cast(uint8, '2')
		pos = pos + 1
		buf[pos] = cast(uint8, '^')
		pos = pos + 1
		// formatInt64 handles negative exponents (writes '-').
		pos = pos + formatInt64(exponent, buf[pos:])
		return pos
	}

	// Fixed-point: <sign?><integer>.<6-digit fraction, truncated>
	var pos int = 0
	if sign != 0 {
		buf[pos] = cast(uint8, '-')
		pos = pos + 1
		v = 0.0 - v
	}
	var intPart int = cast(int, v)
	pos = pos + formatInt(intPart, buf[pos:])
	buf[pos] = cast(uint8, '.')
	pos = pos + 1
	// Fractional: (v - intPart) * 1e6, truncated to int. Yields
	// 0..999999 for any value in fixed-point range.
	var frac float64 = v - cast(float64, intPart)
	var fracInt int = cast(int, frac * 1000000.0)
	var divisor int = 100000
	for i := 0; i < 6; i++ {
		var d int = (fracInt / divisor) % 10
		buf[pos] = cast(uint8, d + cast(int, '0'))
		pos = pos + 1
		divisor = divisor / 10
	}
	return pos
}

// Itoa returns a fresh managed-slice with the decimal
// representation of v. Uses the same digit-extraction approach as
// formatInt but allocates the result instead of writing into a
// caller-provided buffer.
func Itoa(v int) @[]char {
	if v == 0 {
		var s @[]char = make_slice(char, 1)
		s[0] = '0'
		return s
	}
	var negative bool = false
	if v < 0 {
		negative = true
		v = 0 - v
	}
	// Count digits.
	var temp int = v
	var nDigits int = 0
	for temp > 0 {
		temp = temp / 10
		nDigits = nDigits + 1
	}
	var totalLen int = nDigits
	if negative { totalLen = totalLen + 1 }
	var s @[]char = make_slice(char, totalLen)
	// Write digits in reverse from the end.
	var pos int = totalLen - 1
	var rem int = v
	for rem > 0 {
		s[pos] = cast(char, rem % 10 + cast(int, '0'))
		pos = pos - 1
		rem = rem / 10
	}
	if negative { s[0] = '-' }
	return s
}

// Concat returns a fresh managed-slice containing a followed by b.
func Concat(a *[]const char, b *[]const char) @[]char {
	var lenA int = len(a)
	var lenB int = len(b)
	var s @[]char = make_slice(char, lenA + lenB)
	for i := 0; i < lenA; i++ {
		s[i] = a[i]
	}
	for i := 0; i < lenB; i++ {
		s[lenA + i] = b[i]
	}
	return s
}

// ============================================================
// I/O surface stubs.  Placeholders — will be replaced with real
// semihosting calls in a subsequent v1 chunk.
// ============================================================

// Open: no filesystem on bare-metal — always fails.
func Open(path *[]const char, flags int) int {
	return -1
}

// Read: no filesystem on bare-metal — always returns 0 bytes.
func Read(fd int, buf *[]uint8) int {
	return 0
}

// Write outputs the byte buffer to the debug console via
// semihosting SYS_WRITEC, one byte at a time.  `fd` is ignored —
// the host has a single console handle.  Returns the buffer
// length (no partial-write failure mode in this transport;
// SYS_WRITEC has no error path).
func Write(fd int, buf *[]const uint8) int {
	var n int = len(buf)
	for i := 0; i < n; i++ {
		semihost.SemihostWriteChar(cast(char, buf[i]))
	}
	return n
}

// Close: no filesystem on bare-metal — always succeeds (no-op).
func Close(fd int) int {
	return 0
}

// ReadDir: no filesystem on bare-metal — always returns empty.
func ReadDir(path *[]const char) @[]@[]char {
	var empty @[]@[]char
	return empty
}

// Stat: no filesystem on bare-metal — always reports "not found".
func Stat(path *[]const char) int {
	return 0
}

// Exit terminates the program via the semihosting SYS_EXIT_EXTENDED
// host call (see runtime/baremetal_arm32/semihost.s).  Releases
// the QEMU VM with the supplied exit status; on real hardware the
// host debugger handles the request (if attached) — otherwise the
// asm stub's trailing infinite loop holds the CPU.
func Exit(code int) {
	semihost.SemihostExit(code)
	// SemihostExit doesn't return, but the Binate type checker
	// wants every code path of a void function to either reach
	// the end of the body or return.  An infinite loop here
	// makes the control-flow analysis happy and is a defensive
	// fallback if the host ever fails to honor SYS_EXIT_EXTENDED.
	for {
		// spin
	}
}

// Args: no argv on bare-metal — always returns empty.
func Args() @[]@[]char {
	var empty @[]@[]char
	return empty
}

// Exec: no process model on bare-metal — always fails.
func Exec(program *[]const char, args *[]@[]char) int {
	return -1
}
