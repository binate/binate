// Package semihost declares the bare-metal ARM32 semihosting
// helpers implemented in runtime/baremetal_arm32/semihost.s.  The
// implementations are not Binate — they're hand-written assembly
// that issues `svc #0x123456` (ARM mode) for the QEMU / debugger
// to interpret per the semihosting ABI.
//
// Bare-metal-only: this .bni lives under runtime/baremetal_arm32/
// and is on the BniPath only when --target arm32-baremetal is
// active.  Host builds don't see it.
package "pkg/semihost"

// SemihostExit exits the program with the given exit code via
// SYS_EXIT_EXTENDED.  Does not return.  Currently implemented for
// QEMU's `virt` machine — `svc #0x123456` with r0 = 0x20 and r1
// pointing to {0x20026, code}.
func SemihostExit(code int)

// SemihostWriteChar writes one byte to the debug console via
// SYS_WRITEC.  Used by the bare-metal pkg/builtins/bootstrap.Write in a
// loop over the supplied buffer — SYS_WRITEC requires a single-
// char pointer per call, but it avoids the null-terminated-copy
// or file-handle-open overhead of SYS_WRITE0 / SYS_WRITE.
func SemihostWriteChar(c char)
