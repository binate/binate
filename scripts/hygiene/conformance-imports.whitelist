# Per-import exemptions for conformance-imports.sh.
# One `<conformance-relative-path>:<import-path>` entry per line.
# Comments start with #.
#
# Note: pkg/builtins/* (rt, lang, testing, reflect, ...) is always allowed
# for any conformance test — it does NOT need an entry here. This file is
# only for genuinely-special cases.

# 240_err_import_nonexistent.bn deliberately imports a missing package
# to verify the loader's error path; the import never resolves.
240_err_import_nonexistent.bn:pkg/does_not_exist

# 876_funcval_composite_lit_elem_pkg_mslice_ret.bn uses strconv.Itoa as a
# package-qualified function reference in a composite-literal element (the
# `pkg.Func` selector form of the func-ref-element fix).
876_funcval_composite_lit_elem_pkg_mslice_ret.bn:pkg/std/strconv

# 879_funcval_xpkg_aggregate_return.bn takes a func value of strconv.Itoa (a
# native-injected stdlib function returning a managed slice) — the cross-mode
# aggregate func-value dispatch regression guard.
879_funcval_xpkg_aggregate_return.bn:pkg/std/strconv

# 881_funcval_xpkg_struct_return.bn takes a func value of time.FromUnix (a
# native-injected stdlib function returning a 16-byte by-value struct) — the
# cross-mode aggregate-struct-return guard.
881_funcval_xpkg_struct_return.bn:pkg/std/time

# 882_funcval_xpkg_aggregate_balance.bn probes the backing refcount of a
# strconv.Itoa func-value result (the cross-mode managed-slice return balance).
882_funcval_xpkg_aggregate_balance.bn:pkg/std/strconv
# 1090_fmt_basic.bn / 1135_fmt_printf.bn are the end-to-end tests for pkg/std/fmt
# itself, so they must import it (fmt in turn pulls in std io/os/strconv/strings).
1090_fmt_basic.bn:pkg/std/fmt
1135_fmt_printf.bn:pkg/std/fmt
# 1138_fmt_stringer.bn is the end-to-end custom-formatting test: it imports fmt and
# defines a lang.Stringer type whose String() uses strconv.
1138_fmt_stringer.bn:pkg/std/fmt
1138_fmt_stringer.bn:pkg/std/strconv
# 1150_reflect_type_fields.bn is the end-to-end struct-reflection test: it imports
# fmt to print the field metadata reflect.TypeOf exposes (reflect itself is a
# pkg/builtins/* package, auto-allowed above).
1150_reflect_type_fields.bn:pkg/std/fmt
# 1157_fmt_struct_reflect.bn is the end-to-end fmt %v-of-a-struct test (P2).
1157_fmt_struct_reflect.bn:pkg/std/fmt
# 1158_fmt_struct_nested.bn is the end-to-end nested-struct recursion test (P3).
1158_fmt_struct_nested.bn:pkg/std/fmt
# 1159_fmt_struct_plusv.bn is the end-to-end %+v field-names test (P4a).
1159_fmt_struct_plusv.bn:pkg/std/fmt
# 1162_fmt_struct_aggregate.bn is the end-to-end array/slice-field test (P4b-1).
1162_fmt_struct_aggregate.bn:pkg/std/fmt
# 1163_fmt_struct_pointer.bn is the end-to-end pointer-field test (P4b-2).
1163_fmt_struct_pointer.bn:pkg/std/fmt
# 1167_fmt_struct_anon.bn is the end-to-end anonymous-struct rendering test (decision 7).
1167_fmt_struct_anon.bn:pkg/std/fmt
# 1169_fmt_int_widths.bn is the end-to-end all-integer-widths formatting test.
1169_fmt_int_widths.bn:pkg/std/fmt
# 1171_fmt_named_scalar.bn is the end-to-end named-scalar-rendering test (reflection);
# it defines a `type Money int` whose String() uses strconv (a Stringer-wins case).
1171_fmt_named_scalar.bn:pkg/std/fmt
1171_fmt_named_scalar.bn:pkg/std/strconv
# 1180_errors_is_user_error.bn is the cross-mode reproducer for the errors.Is
# VM SIGSEGV: it imports errors so a bytecode (user) Error impl is classified by
# the injected-native errors.Is (plan-iface-crossmode.md S2).
1180_errors_is_user_error.bn:pkg/std/errors
# 1190/1191/1192 are the plan-iface-crossmode.md S3 cross-mode reproducers (return
# direction, func-value sibling dispatcher, and the native iface-method dispatch
# pin) — each imports errors so a bytecode (user) Error impl crosses to injected-
# native errors code.
1190_errors_is_user_chain_return.bn:pkg/std/errors
1191_errors_is_funcval_user.bn:pkg/std/errors
1192_errors_native_iface_method.bn:pkg/std/errors
# 1196_fmt_wrapped_string.bn is the end-to-end test that fmt renders a NAMED and a
# `readonly`-qualified char-slice (the os.Args() element type) as text, not
# `%!?(unknown)` — so it imports fmt.
1196_fmt_wrapped_string.bn:pkg/std/fmt

# 1222_generic_iv_thunk_cross_pkg deliberately has pkg/a and pkg/b each build a
# mapfn.MapFn[int, int] — the point is that two packages instantiating the SAME
# stdlib generic value-receiver impl (hash.FnHasher[int] / cmp.FnEq[int]) and
# linked into one binary must not hit a duplicate `__bn_thunk_*` symbol (the
# iv-dispatch-thunk weak_odr fix).  The stdlib import IS the thing under test.
1222_generic_iv_thunk_cross_pkg/pkg/a/a.bn:pkg/std/mapfn
1222_generic_iv_thunk_cross_pkg/pkg/b/b.bn:pkg/std/mapfn
1224_const_fold_cast_int_to_float.bn:pkg/std/fmt
