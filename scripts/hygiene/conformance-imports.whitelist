# Per-import exemptions for conformance-imports.sh.
# One `<conformance-relative-path>:<import-path>` entry per line.
# Comments start with #.
#
# Note: pkg/builtins/* (rt, lang, testing, reflect, ...) and pkg/bootstrap
# are always allowed for any conformance test — they do NOT need an entry
# here. This file is only for genuinely-special cases.

# 240_err_import_nonexistent.bn deliberately imports a missing package
# to verify the loader's error path; the import never resolves.
240_err_import_nonexistent.bn:pkg/does_not_exist

# 064_bootstrap_funcs.bn now also imports pkg/binate/buf since the
# Concat helper migrated out of pkg/bootstrap (binate
# replaces-bootstrap-Concat).  Itoa is still under pkg/bootstrap.
064_bootstrap_funcs.bn:pkg/binate/buf

# 526_strconv_parse_cross_pkg.bn is the cross-package consumer for the
# Parse* family; it reports failure via @errors.Error, so it also imports
# pkg/std/errors.
526_strconv_parse_cross_pkg.bn:pkg/std/strconv
526_strconv_parse_cross_pkg.bn:pkg/std/errors

# 528_strconv_cross_pkg.bn is the deliberate cross-package consumer
# test for the first stdlib package (pkg/std/strconv is tier-1,
# bundled by default).
528_strconv_cross_pkg.bn:pkg/std/strconv
# 535 is the float-formatting counterpart (Append/FormatFloat, which pull
# in pkg/math/big transitively).
535_strconv_float_cross_pkg.bn:pkg/std/strconv

# 577_std_errors.bn is the cross-package consumer test for pkg/std/errors
# (tier-1, bundled by default) — the Error interface + New/Wrap.
577_std_errors.bn:pkg/std/errors

# 662_errors_is.bn is the cross-package consumer test for errors.Is — the
# sentinel test built on `same`, walking the Unwrap() chain.
662_errors_is.bn:pkg/std/errors
