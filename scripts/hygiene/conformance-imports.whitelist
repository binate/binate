# Per-import exemptions for conformance-imports.sh.
# One `<conformance-relative-path>:<import-path>` entry per line.
# Comments start with #.

# 240_err_import_nonexistent.bn deliberately imports a missing package
# to verify the loader's error path; the import never resolves.
240_err_import_nonexistent.bn:pkg/does_not_exist

# 411_pkg_std_stringer.bn exercises the stdlib carve-out
# (plan-primitives-impl-interfaces.md): canonical Stringer impls
# for primitives live in pkg/std and the test imports them.
411_pkg_std_stringer.bn:pkg/std

# 412_pkg_std_compare.bn / 413_err_pkg_std_iv_compare.bn
# exercise pkg/std's Comparable / Orderable / Hashable
# (plan-primitives-impl-interfaces.md Slice 2b).
412_pkg_std_compare.bn:pkg/std
413_err_pkg_std_iv_compare.bn:pkg/std

# 414_pkg_std_hash_iv.bn: iv dispatch to Hashable.Hash (no
# Self) — the positive complement to 413's Compare-rejection.
414_pkg_std_hash_iv.bn:pkg/std

# 415_pkg_std_char_byte.bn: confirms char / byte (aliases of
# uint8) inherit pkg/std's uint8 impls.
415_pkg_std_char_byte.bn:pkg/std

# 434_generic_constraint_method.bn: end-to-end constraint-method
# dispatch through a generic instantiation (plan-generics.md
# Slice 4b).  Uses pkg/std's Comparable / Hashable so the
# satisfaction-through-inheritance path (Orderable extends
# Comparable, Hashable extends Comparable) covers the
# canonical use case.
434_generic_constraint_method.bn:pkg/std

# 064_bootstrap_funcs.bn now also imports pkg/buf since the
# Concat helper migrated out of pkg/bootstrap (binate
# replaces-bootstrap-Concat).  Itoa is still under pkg/bootstrap.
064_bootstrap_funcs.bn:pkg/buf
