# Per-import exemptions for conformance-imports.sh.
# One `<conformance-relative-path>:<import-path>` entry per line.
# Comments start with #.
#
# Note: pkg/builtins/* (rt, lang, testing, reflect, ...) and pkg/bootstrap
# are always allowed for any conformance test — they do NOT need an entry
# here. This file is only for genuinely-special cases.

# 240_err_import_nonexistent.bn deliberately imports a missing package
# to verify the loader's error path; the import never resolves.
240_err_import_nonexistent.bn:pkg/does_not_exist

# 064_bootstrap_funcs.bn now also imports pkg/binate/buf since the
# Concat helper migrated out of pkg/bootstrap (binate
# replaces-bootstrap-Concat).  Itoa is still under pkg/bootstrap.
064_bootstrap_funcs.bn:pkg/binate/buf
