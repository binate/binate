# Per-import exemptions for conformance-imports.sh.
# One `<conformance-relative-path>:<import-path>` entry per line.
# Comments start with #.

# 240_err_import_nonexistent.bn deliberately imports a missing package
# to verify the loader's error path; the import never resolves.
240_err_import_nonexistent.bn:pkg/does_not_exist

# 411_pkg_std_stringer.bn exercises the stdlib carve-out
# (plan-primitives-impl-interfaces.md): canonical Stringer impls
# for primitives live in pkg/std and the test imports them.
411_pkg_std_stringer.bn:pkg/std

# 412_pkg_std_compare.bn / 413_err_pkg_std_iv_compare.bn
# exercise pkg/std's Comparable / Orderable / Hashable
# (plan-primitives-impl-interfaces.md Slice 2b).
412_pkg_std_compare.bn:pkg/std
413_err_pkg_std_iv_compare.bn:pkg/std
