# Per-import exemptions for conformance-imports.sh.
# One `<conformance-relative-path>:<import-path>` entry per line.
# Comments start with #.
#
# Note: pkg/builtins/* (rt, lang, testing, reflect, ...) and pkg/bootstrap
# are always allowed for any conformance test — they do NOT need an entry
# here. This file is only for genuinely-special cases.

# 240_err_import_nonexistent.bn deliberately imports a missing package
# to verify the loader's error path; the import never resolves.
240_err_import_nonexistent.bn:pkg/does_not_exist

# 064_bootstrap_funcs.bn now also imports pkg/binate/buf since the
# Concat helper migrated out of pkg/bootstrap (binate
# replaces-bootstrap-Concat).  Itoa is still under pkg/bootstrap.
064_bootstrap_funcs.bn:pkg/binate/buf

# 876_funcval_composite_lit_elem_pkg_mslice_ret.bn uses strconv.Itoa as a
# package-qualified function reference in a composite-literal element (the
# `pkg.Func` selector form of the func-ref-element fix).
876_funcval_composite_lit_elem_pkg_mslice_ret.bn:pkg/std/strconv

# 879_funcval_xpkg_aggregate_return.bn takes a func value of strconv.Itoa (a
# native-injected stdlib function returning a managed slice) — the cross-mode
# aggregate func-value dispatch regression guard.
879_funcval_xpkg_aggregate_return.bn:pkg/std/strconv

# 881_funcval_xpkg_struct_return.bn takes a func value of time.FromUnix (a
# native-injected stdlib function returning a 16-byte by-value struct) — the
# cross-mode aggregate-struct-return guard.
881_funcval_xpkg_struct_return.bn:pkg/std/time

# 882_funcval_xpkg_aggregate_balance.bn probes the backing refcount of a
# strconv.Itoa func-value result (the cross-mode managed-slice return balance).
882_funcval_xpkg_aggregate_balance.bn:pkg/std/strconv
# 1090_fmt_basic.bn / 1135_fmt_printf.bn are the end-to-end tests for pkg/stdx/fmt
# itself, so they must import it (fmt in turn pulls in std io/os/strconv/strings).
1090_fmt_basic.bn:pkg/stdx/fmt
1135_fmt_printf.bn:pkg/stdx/fmt
# 1138_fmt_stringer.bn is the end-to-end custom-formatting test: it imports fmt and
# defines a lang.Stringer type whose String() uses strconv.
1138_fmt_stringer.bn:pkg/stdx/fmt
1138_fmt_stringer.bn:pkg/std/strconv
# 1150_reflect_type_fields.bn is the end-to-end struct-reflection test: it imports
# fmt to print the field metadata reflect.TypeOf exposes (reflect itself is a
# pkg/builtins/* package, auto-allowed above).
1150_reflect_type_fields.bn:pkg/stdx/fmt
