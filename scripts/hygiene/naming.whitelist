# Identifiers exempt from the .bni naming-convention check.
# One `<path>:<identifier>` entry per line, relative to the binate repo root.
# Comments start with #.

# pkg/token.bni: range sentinels in const groups, intentionally lowercase
# so they can't be confused with real token kinds.
pkg/token.bni:keyword_start
pkg/token.bni:keyword_end
pkg/token.bni:builtin_start
pkg/token.bni:builtin_end

# pkg/bootstrap.bni: format helpers for the print/println builtin.
# Lowercase as a semantic hint that they're internal-to-the-builtin,
# but exported via .bni so cross-compilation-unit calls from IR-gen
# can link against them.
pkg/bootstrap.bni:formatInt
pkg/bootstrap.bni:formatInt64
pkg/bootstrap.bni:formatUint
pkg/bootstrap.bni:formatBool
pkg/bootstrap.bni:formatFloat

# pkg/rt.bni: compiler-internal magic — _call_dtor / _call_free_fn
# aren't real functions, just declaration shapes that give the type-
# checker something to validate RefDec's / Free's call sites against.
# IR-gen recognizes the symbols and emits OP_CALL_INDIRECT in place
# of OP_CALL. The leading underscore signals "do not call from
# regular Binate code."
pkg/rt.bni:_call_dtor
pkg/rt.bni:_call_free_fn

# pkg/rt.bni: compiler-internal magic for cross-mode function-value
# dispatch. _call_shim_scalar is the shape the IR-gen recognizes
# when lowering a call through a vtable's `call` slot — the
# actual shim is provided by the runtime (TrampolineScalar in VM
# mode, the equivalent compiled-side bridge in compiled mode).
# Lowercase + underscore-prefixed for the same reason as
# _call_dtor / _call_free_fn: never callable from user code.
pkg/rt.bni:_call_shim_scalar
pkg/rt.bni:_call_shim_aggregate
