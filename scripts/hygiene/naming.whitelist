# Identifiers exempt from the .bni naming-convention check.
# One `<path>:<identifier>` entry per line, relative to the binate repo root.
# Comments start with #.

# pkg/token.bni: range sentinels in const groups, intentionally lowercase
# so they can't be confused with real token kinds.
pkg/token.bni:keyword_start
pkg/token.bni:keyword_end
pkg/token.bni:builtin_start
pkg/token.bni:builtin_end

# pkg/bootstrap.bni: format helpers for the print/println builtin.
# Lowercase as a semantic hint that they're internal-to-the-builtin,
# but exported via .bni so cross-compilation-unit calls from IR-gen
# can link against them.
pkg/bootstrap.bni:formatInt
pkg/bootstrap.bni:formatBool
pkg/bootstrap.bni:formatFloat
