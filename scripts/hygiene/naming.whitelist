# Identifiers exempt from the .bni naming-convention check.
# One `<path>:<identifier>` entry per line, relative to the binate repo root.
# Comments start with #.

# pkg/binate/token.bni: range sentinels in const groups, intentionally lowercase
# so they can't be confused with real token kinds.
pkg/binate/token.bni:keyword_start
pkg/binate/token.bni:keyword_end
pkg/binate/token.bni:builtin_start
pkg/binate/token.bni:builtin_end

# ifaces/core/pkg/builtins/rt.bni: compiler-internal magic — _call_dtor / _call_free_fn
# aren't real functions, just declaration shapes that give the type-
# checker something to validate RefDec's / Free's call sites against.
# IR-gen recognizes the symbols and emits OP_CALL_INDIRECT in place
# of OP_CALL. The leading underscore signals "do not call from
# regular Binate code."
ifaces/core/pkg/builtins/rt.bni:_call_dtor
ifaces/core/pkg/builtins/rt.bni:_call_free_fn

# ifaces/core/pkg/builtins/rt.bni: compiler-internal magic for cross-mode function-value
# dispatch. _call_shim_scalar is the shape the IR-gen recognizes
# when lowering a call through a vtable's `call` slot — the
# actual shim is provided by the runtime (TrampolineScalar in VM
# mode, the equivalent compiled-side bridge in compiled mode).
# Lowercase + underscore-prefixed for the same reason as
# _call_dtor / _call_free_fn: never callable from user code.
ifaces/core/pkg/builtins/rt.bni:_call_shim_scalar
ifaces/core/pkg/builtins/rt.bni:_call_shim_scalar64
ifaces/core/pkg/builtins/rt.bni:_call_shim_aggregate

# ifaces/stdlib/pkg/std/debug.bni: compiler-internal magic — _stack_frames is
# not a linkable function, just the declaration shape IR-gen recognizes by name
# and lowers to OP_STACK_FRAMES (native FP-walk / VM stack walk).  Leading
# underscore signals "do not call from regular Binate code"; debug.Callers /
# debug.Caller are the public wrappers.
ifaces/stdlib/pkg/std/debug.bni:_stack_frames
